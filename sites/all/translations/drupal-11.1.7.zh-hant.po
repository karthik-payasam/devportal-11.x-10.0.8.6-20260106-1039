msgstr "使用者名稱 %name 過長：請不要超過 %max 個英文字母。"

msgctxt "Validation"
msgid "User name unique"
msgstr "唯一的使用者名稱"

msgid "Primary Key: Unique profile field ID."
msgstr "主要索引鍵：唯一的設定檔欄位 ID。"

msgid "Title of the field shown to the end user."
msgstr "對一般使用者顯示之欄位的標題。"

