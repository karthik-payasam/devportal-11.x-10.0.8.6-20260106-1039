msgstr "預設設定檔案不存在。"

msgid "Settings file"
msgstr "設定檔案"

msgid "The @drupal installer requires that the %default-file file must not be deleted or modified from the original download."
msgstr "@drupal 安裝程式要求不得從原始下載刪除或修改 %default-file 檔。"

msgid "The %file does not exist."
msgstr "%file檔案不存在。"

msgid "The @drupal installer requires that you create a %file as part of the installation process. Copy the %default_file file to %file. More details about installing Drupal are available in <a href=\":install_txt\">INSTALL.txt</a>."
msgstr "安裝 @drupal 過程需要建立 %file 檔案。複製 %default_file 檔案到 %file。更多安裝 Drupal 的細節請參考：<a href=\":install_txt\">INSTALL.txt</a>。"

msgid "The %file exists."
msgstr "%file檔案存在。"

msgid "The %file is not readable."
msgstr "%file無法讀取。"

msgid "@drupal requires read permissions to %file at all times. The <a href=\":handbook_url\">webhosting issues</a> documentation section offers help on this and other topics."
msgstr "@drupal 安裝過程需要 %file 的讀取權限。<a href=\":handbook_url\">伺服器疑難排解</a>文件可以提供更多協助與相關問題解答。"

msgid "The %file is not writable."
msgstr "%file檔案不可寫入。"

msgid "The @drupal installer requires write permissions to %file during the installation process. The <a href=\":handbook_url\">webhosting issues</a> documentation section offers help on this and other topics."
msgstr "@drupal 安裝過程將需要 %file 的寫入權限。<a href=\":handbook_url\">伺服器疑難排解</a>文件可以提供更多協助與相關問題解答。"

msgid "The @file is writable."
msgstr "@file檔案可以寫入。"

msgid "The @file is owned by the web server."
