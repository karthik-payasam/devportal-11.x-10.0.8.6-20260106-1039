msgid "Views Autocomplete Filters"
msgstr "Views Autocomplete Filters"

msgid "Use Autocomplete for string field filters."
msgstr "Utilizar Autocompletado para los filtros de campo de serie."

msgid "Views"
msgstr "Vistas"

msgid "Autocomplete for Combine fields filter"
msgstr "Autocompletado para combinar los campos de filtro"

msgid "Exposed"
msgstr "Expuesto"

msgid "Use Autocomplete"
msgstr "Utilizar Autocompletado"

msgid "Minimum number of characters to start filter"
msgstr "Número mínimo de caracteres para iniciar filtro"

msgid "Maximum number of items in Autocomplete"
msgstr "Número máximo de elementos en Autocompletado"

msgid "Field with autocomplete results"
msgstr "Campo con resultados de autocompletado"

msgid "Unformatted suggestion"
msgstr "Sugerencia sin formato"

msgid "Unformatted dropdown"
msgstr "Desplegable sin formato"

msgid "Suggestions depend on other filter fields"
msgstr "Las sugerencias dependen de otros campos de filtro"

msgid "Autocomplete for Search API fulltext search filter"
msgstr "Autocompletado para filtro de búsqueda de texto completo de Search API"

msgid "Autocomplete for Search API text field filter"
msgstr "Autocompletado para filtro de campo de texto de Search API"

msgid "Autocomplete for basic textfield filter"
msgstr "Autocompletado para filtro de campo de texto básico"

msgid "Field for autocomplete filter %label is not set in view %view, display %display"
msgstr "El campo para el autocompletado de filtro %label no está establecido en la vista %view, pantalla %display"

msgid "Field for autocomplete filter %label not exists in view %view, display %display"
msgstr "El campo para el autocompletado de filtro %label no existe en la vista %view, pantalla %display"

msgid "Use Autocomplete for this filter."
msgstr "Utilizar Autocompletado para este filtro."

msgid "Enter 0 for no limit."
msgstr "Escriba 0 para sin límite."

msgid "Autocomplete suggestions will be filtered by other filter fields"
msgstr "Las sugerencias de autocompletado se filtrarán por otros campos de filtro"

msgid "The selected field will be used for drop-down results of the autocompletion. In most cases it should be the same field you use for the filter, and <em>must</em> be included in the field list for the view/display in order to appear here."
msgstr "El campo seleccionado se utilizará en los resultados desplegables del rellenado automático. En la mayoría de los casos, será el mismo campo que se usa en el filtro y <em>hay</em> que incluirlo en la lista de campos de la vista/visualización para que aparezca aquí."

msgid "Use unformatted data from database for dropdown list instead of field formatter result. Value will be printed as plain text."
msgstr "Utilizar datos sin formato de la base de datos para la lista desplegable en lugar del resultado de formateador de campo. El valor se imprimirá como texto sin formato."

msgid "The same as above, but for suggestion (text appearing inside textfield when item is selected)."
msgstr "Lo mismo que arriba, pero para sugerencia (texto que aparece dentro del campo de texto cuando el elemento está seleccionado)."

msgid "Add some fields to view"
msgstr "Añadir algunos campos a la vista"

