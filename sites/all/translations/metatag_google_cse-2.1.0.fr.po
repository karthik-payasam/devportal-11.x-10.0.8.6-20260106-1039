msgid "About"
msgstr "A propos de"

msgid "Provides support for meta tags used for Google Custom Search Engine."
msgstr "Fournit la prise en charge des balises meta utilisées pour Google Custom Search Engine."

msgid "Metatag: Google Custom Search Engine (CSE)"
msgstr "Balise meta : Google Custom Search Engine (CSE)"

msgid "SEO"
msgstr "optimisation pour les moteurs de recherche"

msgid "Thumbnail"
msgstr "Image miniature"

msgid "Department"
msgstr "Département"

msgid "Content audience"
msgstr "Utilisateurs concernés par le contenu"

msgid "Document status"
msgstr "Statut du document"

msgid "google_rating"
msgstr "évaluation_google"

msgid "Google Custom Search Engine (CSE)"
msgstr "Google Custom Search Engine (CSE)"

msgid "Meta tags used to control the mobile browser experience. Some of these meta tags have been replaced by newer mobile browsers. These meta tags usually only need to be set globally, rather than per-page."
msgstr "Balises meta utilisées pour contrôler l'expérience dans le navigateur mobile. Certaines de ces balises meta ont été remplacées par des navigateurs mobiles plus récents. En général, il suffit de définir ces balises meta globalement et il n'est pas nécessaire de les définir pour chaque page."

msgid "Department tag."
msgstr "Balise de département."

msgid "Content rating"
msgstr "Classement des contenus"

msgid "Works only with numeric values."
msgstr "Fonctionne uniquement avec des valeurs numériques."

msgid "Use a url of a valid image."
msgstr "Utilisez l'URL d'une image valide."

