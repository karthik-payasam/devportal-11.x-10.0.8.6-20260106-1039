msgid "Password Policy Delay"
msgstr "Opóźnienie strategii haseł"

msgid "Sets up a password constraint to limit how soon before a password can be reset again."
msgstr "Ustawia ograniczenie hasła, aby ograniczyć czas, po którym hasło może zostać ponownie zresetowane."

msgid "Security"
msgstr "Zabezpieczenia"

msgid "Hours until next password reset may be performed."
msgstr "Godziny do możliwego następnego zresetowania hasła."

msgid ""
"Not enough time has passed\n"
"          since this password was last reset."
msgstr ""
"Od ostatniego zresetowania hasła nie upłynęło \n"
"jeszcze wystarczająco dużo czasu."

msgid "Hours until password can be reset again."
msgstr "Godziny do możliwego ponownego zresetowania hasła."

msgid "A value of 0 represents no delay"
msgstr "Wartość 0 oznacza brak opóźnienia"

msgid "The delay value must be zero or greater."
msgstr "Wartość opóźnienia musi być równa zero lub większa."

msgid "Delay in hours until password can be reset: @delay"
msgstr "Opóźnienie w godzinach, po którym hasło może zostać zresetowane: @delay"

msgid "Password Delay"
msgstr "Opóźnienie hasła"

msgid "Provide delay before password can be reset again."
msgstr "Należy wprowadzić opóźnienie, po upływie którego hasło będzie można ponownie zresetować."

msgid "You cannot reset your password until the delay has as elapsed."
msgstr "Nie można zresetować hasła, dopóki nie upłynie czas opóźnienia."

