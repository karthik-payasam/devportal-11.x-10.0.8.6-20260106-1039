msgid "Loading"
msgstr "Загрузка"

msgid "Page Load Progress"
msgstr "Прогресс загрузки страницы"

msgid "Locks the screen and adds a progress icon to indicate progress when a page takes a long time to reload."
msgstr "Блокирует экран и добавляет значок состояния, если страница загружается слишком долго."

msgid "User interface"
msgstr "Интерфейс пользователя"

msgid "Manage the behavior of Page Load Progress."
msgstr "Управление поведением состояния загрузки страницы."

msgid "Administer Page Load Progress"
msgstr "Администрирование прогресса загрузки страницы"

msgid "Use Page Load Progress"
msgstr "Использовать Прогресс загрузки страницы"

msgid "Page Load Progress settings"
msgstr "Настройки Прогресса загрузки страницы"

msgid "Time to wait before locking the screen"
msgstr "Время ожидания перед блокировкой экрана"

msgid "HTML elements which will trigger the throbber"
msgstr "Элементы HTML для активации троббера"

msgid "Lists of paths to include or exclude"
msgstr "Список путей для включения или исключения"

msgid "Negate request path condition"
msgstr "Отрицание условия пути запроса"

msgid "Use the throbber for internal links"
msgstr "Использовать троббер для внутренних ссылок"

msgid "Allow ESC key to kill the throbber"
msgstr "Разрешить закрытие троббера с помощью клавиши ESC"

msgid "Enter the time you want to wait before showing the image lock."
msgstr "Введите время ожидания перед отображением блокировки изображения."

msgid "Show immediately"
msgstr "Показать немедленно"

msgid "Show after a 1 second delay"
msgstr "Показать после 1-секундной задержки"

msgid "Show after a 3 seconds delay"
msgstr "Показать после 3-секундной задержки"

msgid "Show after a 5 seconds delay"
msgstr "Показать после 5-секундной задержки"

msgid "Visibility conditions"
msgstr "Условия видимости"

msgid "Specify pages by using their paths. Enter one path per line. The '*' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page."
msgstr "Укажите адреса страниц. Укажите по одному адресу на строку. Знак '*' означает любой набор символов после него. Например, путь %user-wildcard страницы всех пользователей. %front - главная страница."

msgid "Show for the listed pages"
msgstr "Отображать на перечисленных страницах"

msgid "Hide for the listed pages"
msgstr "Скрывать для перечисленных страниц"

msgid "The throbber won't be triggered on links opened from a modal or when the user is trying to open them in a new tab."
msgstr "Троббер не будет активироваться, если ссылки открываются из модального окна или в новой вкладке."

msgid "Under some circumstances, you may want to let your user unlock the screen manually by pressing the ESC key."
msgstr "В отдельных случаях может потребоваться разрешить пользователю разблокировать экран вручную с помощью клавиши ESC."

