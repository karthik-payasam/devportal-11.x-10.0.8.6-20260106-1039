msgstr "Upload de arquivo"

msgid "Files could not be uploaded because the destination directory %destination is not configured correctly."
msgstr "Os arquivos não puderam ser transferidos por upload porque o diretório de destino %destination não está configurado corretamente."

msgid "Some files that you are trying to upload did not pass validation. Requirements are: max file %size, allowed extensions are %extensions"
msgstr "Alguns arquivos dos quais você está tentando fazer upload não foram aprovados na validação. Os requisitos são: no máximo %size de arquivo, as extensões permitidas são %extensions"

msgid "At least one valid file should be uploaded."
msgstr "Pelo menos um arquivo válido deve ser transferido por upload."

msgid "MB"
msgstr "MB"

msgid "A space separated list of file extensions"
msgstr "Uma lista separada por espaço de extensões de arquivos"

msgid "Use client side resizing"
msgstr "Usar o redimensionamento do lado do cliente"

msgid "Requires droopzone version v4.4.0 or higher and the <a href=\"@exif\" target=\"_blank\">exif</a> library."
msgstr "Requer a versão v4.4.0 ou superior do droopzone e a biblioteca <a href=\"@exif\" target=\"_blank\">exif</a>."

msgid "Max width"
msgstr "Largura máxima"

msgid "Max height"
msgstr "Altura máxima"

msgid "Resize method"
msgstr "Método de redimensionamento"

msgid "Contain (scale)"
msgstr "Conter (escala)"

msgid "Crop"
msgstr "Corte"

msgid "Thumbnail method"
msgstr "Método de miniatura"

msgid "Invalid extension list format."
msgstr "Formato de lista de extensões inválido."

