msgid "@style style will not display without the \"@field\" setting."
msgstr "El estilo @style no se visualizará sin el parámetro \"@field\"."

msgid "About"
msgstr "Acerca de"

msgid "The <a href=\":bootstrap\">Views Bootstrap module</a> adds styles to Views to output the results of a view as several common <a href=\":components\">Twitter Bootstrap</a> components."
msgstr "El <a href=\":bootstrap\">módulo Views Bootstrap</a> añade estilos a vistas para generar el resultado de una vista como varios componentes comunes de <a href=\":components\">Twitter Bootstrap</a>."

msgid "Uses"
msgstr "Usos"

msgid "<a href=\":views\">Create a view</a> using one of the following styles:"
msgstr "<a href=\":views\">Crear una vista</a> usando uno de los estilos siguientes:"

msgid "<a href=\":docs\">Accordion</a>"
msgstr "<a href=\":docs\">Acordeón</a>"

msgid "<a href=\":docs\">Cards</a>"
msgstr "<a href=\":docs\">Tarjetas</a>"

msgid "<a href=\":docs\">Carousel</a>"
msgstr "<a href=\":docs\">Carrusel</a>"

msgid "<a href=\":docs\">Dropdown</a>"
msgstr "<a href=\":docs\">Desplegable</a>"

msgid "<a href=\":docs\">Grid</a>"
msgstr "<a href=\":docs\">Cuadrícula</a>"

msgid "<a href=\":docs\">Thumbnails</a>"
msgstr "<a href=\":docs\">Miniaturas</a>"

msgid "<a href=\":docs\">Tables</a>"
msgstr "<a href=\":docs\">Tablas</a>"

msgid "<a href=\":docs\">Tabs</a>"
msgstr "<a href=\":docs\">Pestañas</a>"

msgid "<a href=\":docs\">Media object</a>"
msgstr "<a href=\":docs\">Objeto de medios</a>"

msgid "<a href=\":docs\">List group</a>"
msgstr "<a href=\":docs\">Grupo de listas</a>"

msgid "Views Bootstrap"
msgstr "Views Bootstrap"

msgid "Views Twitter Bootstrap Components."
msgstr "Componentes de vistas de Twitter Bootstrap."

msgid "Views"
msgstr "Vistas"

msgid "The Bootstrap accordion displays content in collapsible panels (<a href=\":docs\">see documentation</a>)."
msgstr "El Acordeón Bootstrap visualiza el contenido en paneles contraíbles (<a href=\":docs\">consulte la documentación</a>)."

msgid "Panel title field"
msgstr "Campo de título de panel"

msgid "Select the field that will be used as the accordion panel titles."
msgstr "Seleccione el campo que se utilizará como títulos de panel de acordeón."

msgid "Label field"
msgstr "Campo de etiqueta"

msgid "- None -"
msgstr "- Ninguno -"

msgid "Select the field that will be used as the label."
msgstr "Seleccione el campo que se utilizará como etiqueta."

msgid "Collapse Options"
msgstr "Opciones de contracción"

msgid "All Items Closed"
msgstr "Todos los elementos cerrados"

msgid "First Item Open"
msgstr "Primer elemento abierto"

msgid "All Items Open"
msgstr "Todos los elementos abiertos"

msgid "Default panel state for collapse behavior."
msgstr "Estado de panel predeterminado para comportamiento de contracción."

msgid "Bootstrap Accordion"
msgstr "Acordeón Bootstrap"

msgid "Displays rows in a Bootstrap Accordion."
msgstr "Muestra las filas en un acordeón Bootstrap."

msgid "Card title field"
msgstr "Campo de título de tarjeta"

msgid "Select the field that will be used for the card title."
msgstr "Seleccione el campo que se utilizará para el título de la tarjeta."

msgid "Card content field"
msgstr "Campo de contenido de tarjeta"

msgid "Select the field that will be used for the card content."
msgstr "Seleccione el campo que se utilizará para el contenido de la tarjeta."

msgid "Card image field"
msgstr "Campo de imagen de tarjeta"

msgid "Select the field that will be used for the card image."
msgstr "Seleccione el campo que se utilizará para la imagen de tarjeta."

msgid "Custom card group class"
msgstr "Clase de grupo de tarjetas personalizadas"

msgid "Additional classes to provide on the card group. Separated by a space."
msgstr "Clases adicionales que proporcionar en el grupo de tarjetas. Separadas por un espacio."

msgid "Additional classes to provide on each card. Separated by a space."
msgstr "Clases adicionales que proporcionar en cada tarjeta. Separadas por un espacio."

msgid "Bootstrap Cards"
msgstr "Tarjetas del programa de arranque"

msgid "Displays rows in a Bootstrap Card Group layout"
msgstr "Muestra filas en un diseño de grupo de tarjetas de programa de arranque"

msgid "The Bootstrap carousel displays content as a slideshow (<a href=\":docs\">see documentation</a>)."
msgstr "El Carrusel Bootstrap visualiza contenido como una presentación de diapositivas (<a href=\":docs\">consulte la documentación</a>)."

msgid "<None>"
msgstr "<Ninguno>"

msgid "Interval"
msgstr "Intervalo"

msgid "The amount of time to delay between automatically cycling an item. If false, carousel will not automatically cycle."
msgstr "Tiempo de retardo que transcurre entre ciclos automáticos de un elemento. Si es false, el carrusel no se ciclará de forma automática."

msgid "Show navigation"
msgstr "Mostrar navegación"

msgid "Show indicators"
msgstr "Mostrar indicadores"

msgid "Pause on hover"
msgstr "Pausar al pasar por encima"

msgid "Pauses the cycling of the carousel on mouseenter and resumes the cycling of the carousel on mouseleave."
msgstr "Pone en pausa los ciclos del carrusel al recibir mouseenter y los reanuda al recibir mouseleave."

msgid "Wrap"
msgstr "Envolver"

msgid "The carousel should cycle continuously or have hard stops."
msgstr "El carrusel será de ciclos continuos o tendrá paradas bruscas."

msgid "Columns"
msgstr "Columnas"

msgid "The number of columns to include in the carousel."
msgstr "El número de columnas para incluir en el carrusel."

msgid "Breakpoints"
msgstr "Puntos de interrupción"

msgid "The min-width breakpoint of the multicolumn carousel."
msgstr "El punto de interrupción de anchura mínima del carrusel de varias columnas."

msgid "Extra Small"
msgstr "Diminuta"

msgid "Small"
msgstr "Pequeño"

msgid "Medium"
msgstr "Medio"

msgid "Large"
msgstr "Grande"

msgid "Display"
msgstr "Visualización"

msgid "Select by fields"
msgstr "Seleccionar por campos"

msgid "Display fields as row content"
msgstr "Mostrar campos como contenido de fila"

msgid "Displaying fields as row content will output the field rows as unformatted values within each carousel item."
msgstr "La visualización de campos como contenido de fila generará las filas de campo como valores sin formato dentro de cada elemento carrusel."

msgid "Image"
msgstr "Imagen"

msgid "Title"
msgstr "Título"

msgid "Description"
msgstr "Descripción"

msgid "Bootstrap Carousel"
msgstr "Carrusel Bootstrap"

msgid "Displays rows in a Bootstrap Carousel."
msgstr "Muestra las filas en un carrusel Bootstrap."

msgid "The Bootstrap dropdown style displays a list of links in a drop-down menu format (<a href=\":docs\">see documentation</a>)."
msgstr "El estilo Desplegable Bootstrap visualiza una lista de enlaces en un formato de menú desplegable (<a href=\":docs\">consulte la documentación</a>)."

msgid "Button text"
msgstr "Texto del botón"

msgid "Text label for the button that is the drop-down toggle."
msgstr "Etiqueta de texto para el botón que es el conmutador desplegable."

msgid "Button class"
msgstr "Clase de botón"

msgid "Classes for the button that is the drop-down toggle."
msgstr "Clases para el botón que es el conmutador desplegable."

msgid "Default"
msgstr "Por defecto"

msgid "Primary"
msgstr "Primario"

msgid "Success"
msgstr "Éxito"

msgid "Info"
msgstr "Info"

msgid "Warning"
msgstr "Advertencia"

msgid "Danger"
msgstr "Peligro"

msgid "Wrapper class"
msgstr "Clase del envoltorio"

msgid "The class to provide on the wrapper, outside the list."
msgstr "La clase a proporcionar al contenedor, fuera de la lista."

msgid "List class"
msgstr "Clase del listado"

msgid "The class to provide on the list element itself."
msgstr "La clase a proporcionar al elemento de la lista propiamente."

msgid "Bootstrap Dropdown"
msgstr "Desplegable Bootstrap"

msgid "Displays rows in a Bootstrap Dropdown."
msgstr "Visualiza filas en un Desplegable Bootstrap."

msgid "The Bootstrap grid displays content in a responsive, mobile first fluid grid (<a href=\":docs\">see documentation</a>)."
msgstr "La cuadrícula de Bootstrap visualiza contenido en una cuadrícula Mobile first fluida y adaptable (<a href=\":docs\">consulte la documentación</a>)."

msgid "Alignment"
msgstr "Alineación"

msgid "Horizontal"
msgstr "Horizontal"

msgid "Vertical"
msgstr "Vertical"

msgid ""
"Horizontal alignment will place items starting in the upper left and moving right.\n"
"      Vertical alignment will place items starting in the upper left and moving down."
msgstr ""
"La alineación horizontal colocará los elementos empezando por la parte superior izquierda y moviéndose a la derecha.\n"
"      La alineación vertical situará los elementos empezando desde arriba a la izquierda y desplazándose hacia abajo."

msgid "Default column classes"
msgstr "Clases de columna predeterminadas"

msgid "Add the default views column classes like views-col, col-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Añada las clases de columna de la vistas predeterminadas como views-col, col-1 y clearfix a la salida. Puede usar esto para reducir rápidamente la cantidad de márgenes que la vista proporciona por omisión, a costa de hacer más difícil la aplicación de CSS."

msgid "Custom column class"
msgstr "Clase de columna personalizada"

msgid "Additional classes to provide on each column. Separated by a space."
msgstr ""
"Clases adicionales a proporcionar en cada columna.\r\n"
"Separadas por un espacio."

msgid "You may use field tokens from as per the \"Replacement patterns\" used in \"Rewrite the output of this field\" for all fields."
msgstr "Puede usar tokens de campos, de acuerdo a los \"Patrones de remplazo\" que se utiliza en \"Reescribir la salida de este campo\" para todos los campos."

msgid "Default row classes"
msgstr "Clases de fila predeterminadas"

msgid "Adds the default views row classes like views-row, row-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Añade las clases vistas fila predeterminadas como vistas-fila, fila-1 y clearfix a la salida. Puede usalo para reducir rápidamente la cantidad de marcas que la vista ofrece de forma predeterminada, la desventaja es que se hace más difícil la aplicación de CSS."

msgid "Custom row class"
msgstr "Clase de fila personalizada"

msgid "Additional classes to provide on each row. Separated by a space."
msgstr "Clases adicionales a proveer en cada fila. Separadas por un espacio."

msgid "Base number of columns"
msgstr "Número base de columnas"

msgid "all"
msgstr "todo"

msgid "Choose the number of columns that views will wrap in a single row. This will be reflected in the HTML structure rendered regardless of the device size. If selecting \"all\" then use the alternative template."
msgstr "Elija el número de columnas que las vistas acomodarán en una sola fila. Esto se reflejará en la estructura HTML representada independientemente del tamaño de dispositivo. Si selecciona \"all\", utilice la plantilla alternativa."

msgid "Number of columns (col-@size)"
msgstr "Número de columnas (col-@size)"

msgid "This adds col-@size to the div."
msgstr "Esto añade col-@size al div."

msgid "Bootstrap Grid"
msgstr "Cuadrícula de Bootstrap"

msgid "Displays rows in a Bootstrap Grid layout"
msgstr "Muestra las filas en un diseño de cuadrícula Bootstrap"

msgid "The Bootstrap list group displays content in an unordered list with list group classes (<a href=\":docs\">see documentation</a>)."
msgstr "El Grupo de listas Bootstrap visualiza contenido en una lista no ordenada con clases de grupo de listas (<a href=\":docs\">consulte la documentación</a>)."

msgid "Set group field in panel heading"
msgstr "Establecer campo de grupo en cabecera de panel"

msgid "Title field"
msgstr "Campo de título"

msgid "Select the field that will be used as the title."
msgstr "Seleccione el campo que se va a usar como título."

msgid "Bootstrap List Group"
msgstr "Grupo de listas Bootstrap"

msgid "Displays rows in a Bootstrap List Group."
msgstr "Muestra las filas en un grupo de listas Bootstrap."

msgid "The Bootstrap media object displays content with an image item lead with heading and text (<a href=\":docs\">see documentation</a>)."
msgstr "El Objeto de soporte Bootstrap visualiza contenido con una delantera de elemento de imagen con cabecera y texto (<a href=\":docs\">consulte la documentación</a>)."

msgid "Heading field"
msgstr "Campo de cabecera"

msgid "Select the field that will be used as the media object heading. Exclude this field from display to prevent duplication."
msgstr "Seleccione el campo que se va a usar como cabecera de objeto de soporte. Excluya este campo de la visualización para evitar la duplicación."

msgid "Image field"
msgstr "Campo de imagen"

msgid "Select the field that will be used as the media object image. Exclude this field from display to prevent duplication."
msgstr "Seleccione el campo que se va a usar como imagen de objeto de soporte. Excluya este campo de la visualización para evitar la duplicación."

msgid "Body field"
msgstr "Campo de contenido o cuerpo"

msgid "All fields that are not excluded from display will be shown as the body."
msgstr "Todos los campos que no se excluyan de la visualización se mostrarán como cuerpo."

msgid "Image Alignment"
msgstr "Alineación de imagen"

msgid "Left"
msgstr "Izquierda"

msgid "Right"
msgstr "Derecha"

msgid "Middle"
msgstr "Enmedio"

msgid "Align the media object image left or right."
msgstr "Alinear el objeto de imagen de medio a la izquierda o a la derecha."

msgid "Bootstrap Media Object"
msgstr "Objeto de soporte Bootstrap"

msgid "Displays rows in a Bootstrap Media Object."
msgstr "Muestra las filas en objeto de soporte Bootstrap."

msgid "The Bootstrap panels displays content in a box with optional header and footer elements (<a href=\":docs\">see documentation</a>)."
msgstr "Los Paneles Bootstrap visualizan contenido en un cuadro con elementos de cabecera y pie de página opcionales (<a href=\":docs\">consulte la documentación</a>)."

msgid "Contextual class"
msgstr "Clase contextual"

msgid "<a href=\":docs\">see Bootstrap documentation</a>"
msgstr "<a href=\":docs\">consulte la documentación de Bootstrap</a>"

msgid "Select the field that will be used as the panel heading titles."
msgstr "Seleccione el campo que se utilizará como los títulos de cabecera del panel."

msgid "Panel footer field"
msgstr "Campo de pie de página"

msgid "Select the field that will be used as the panel footer."
msgstr "Seleccione el campo que se utilizará como el pie de página del panel."

msgid "Bootstrap Panels"
msgstr "Paneles Bootstrap"

msgid "Displays rows in a Bootstrap Panel."
msgstr "Visualiza filas en un panel Bootstrap."

msgid "The Bootstrap tabs displays content with tab titles linked to dynamically displayed content (<a href=\":docs\">see documentation</a>)."
msgstr "La Pestaña Bootstrap visualiza contenido con títulos de pestaña enlazados a contenido visualizado dinámicamente (<a href=\":docs\">consulte la documentación</a>)."

msgid "Tab field"
msgstr "Campo de pestaña"

msgid "Select the field that will be used as the tab."
msgstr "Seleccione el campo que se va a usar como pestaña."

msgid "Tab Type"
msgstr "Tipo de pestaña"

msgid "Tabs"
msgstr "Pestañas"

msgid "Pills"
msgstr "Píldoras"

msgid "List"
msgstr "Listado"

msgid "Position of tabs"
msgstr "Posición de las pestañas"

msgid "Tabs/pills on the top"
msgstr "Pestañas/píldoras en la parte superior"

msgid "Tabs/pills on the left"
msgstr "Pestañas/píldoras a la izquierda"

msgid "Tabs/pills on the right"
msgstr "Pestañas/píldoras a la derecha"

msgid "Tabs/pills on the bottom"
msgstr "Pestañas/píldoras en la parte inferior"

msgid "Tabs/pills justified on the top"
msgstr "Pestañas/píldoras justificadas en la parte superior"

msgid "Tabs/pills stacked"
msgstr "Pestañas/píldoras apiladas"

msgid "Fade Effect"
msgstr "Efecto de difuminación"

msgid "Add a fade in effect when tabs clicked"
msgstr "Añadir difuminación al efecto cuando se pulsan las pestañas"

msgid "Bootstrap Tabs"
msgstr "Pestañas Bootstrap"

msgid "Displays rows in Bootstrap Tabs."
msgstr "Muestra las filas en pestañas Bootstrap."

msgid "The Bootstrap table style adds default Bootstrap table classes and optional classes (<a href=\":docs\">see documentation</a>)."
msgstr "El estilo Tabla Bootstrap añade clases de tabla Bootstrap predeterminadas y clases opcionales (<a href=\":docs\">consulte la documentación</a>)."

msgid "Responsive"
msgstr "Adaptable"

msgid "To make a table scroll horizontally on small devices."
msgstr "Para hacer que una tabla se desplace horizontalmente en dispositivos pequeños."

msgid "Bootstrap styles"
msgstr "Estilos Bootstrap"

msgid "Striped"
msgstr "A franjas"

msgid "Bordered"
msgstr "Con bordes"

msgid "Hover"
msgstr "Hover"

msgid "Condensed"
msgstr "Condensado"

msgid "Caption for the table"
msgstr "Título de la tabla"

msgid "A title semantically associated with your table for increased accessibility."
msgstr "Título semánticamente asociado a la tabla para aumentar la accesibilidad."

msgid "Table details"
msgstr "Detalles de tabla"

msgid "Summary title"
msgstr "Título de resumen"

msgid "Table description"
msgstr "Descripción de la tabla"

msgid "Provide additional details about the table to increase accessibility."
msgstr "Proporcione detalles adicionales sobre la tabla para aumentar la accesibilidad."

msgid "Bootstrap Table"
msgstr "Tabla Bootstrap"

msgid "Displays rows in a Bootstrap table."
msgstr "Muestra las filas en una tabla Bootstrap."

msgid "The Bootstrap thumbnails extends the grid display with the thumbnail component to showcase linked images (<a href=\":docs\">see documentation</a>)."
msgstr "Miniaturas Bootstrap amplía la visualización de la cuadrícula con el componente de miniatura para mostrar las imágenes enlazadas (<a href=\":docs\">consulte la documentación</a>)."

msgid "Bootstrap Thumbnails"
msgstr "Miniaturas Bootstrap"

msgid "Displays rows in a Bootstrap Grid layout with thumbnails"
msgstr "Visualiza filas en una diseño de Cuadrícula de Bootstrap con miniaturas"

msgid "Previous"
msgstr "Anterior"

msgid "Next"
msgstr "Siguiente"

