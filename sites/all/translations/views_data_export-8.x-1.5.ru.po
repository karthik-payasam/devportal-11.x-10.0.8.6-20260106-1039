msgid "Batch"
msgstr "Процесс импорта"

msgid "Exports under one request. Best fit for small exports."
msgstr "Экспортирует в одном запросе. Оптимальный вариант для небольших операций экспорта. "

msgid "Exports data in sequences. Should be used when large amount of data is exported (> 2000 rows)."
msgstr "Экспортирует данные в виде нескольких последовательностей. Рекомендуется для экспорта больших объемов данных (> 2000 строк). "

msgid "The number of rows to process under a request."
msgstr "Число строк для обработки в запросе. "

msgid "The maximum amount of rows to export. 0 means unlimited."
msgstr "Максимальное число строк для экспорта. 0 означает без ограничений."

msgid "File Storage/Download Settings"
msgstr "Параметры хранения/загрузки файлов"

msgid "Filename"
msgstr "Имя файла"

msgid "The filename that will be suggested to the browser for downloading purposes. You may include replacement patterns from the list below."
msgstr "Имя файла, которое будет предложено браузеру в целях загрузки. Можно указать шаблоны замены из следующего списка. "

msgid "Store file in public files directory"
msgstr "Сохранить файл в каталоге общих файлов"

msgid "Check this if you want to store the export files in the public:// files directory instead of the private:// files directory."
msgstr "Позволяет хранить экспортированные файлы в каталоге public:// вместо каталога private://. "

msgid "<strong>The private:// file system is not configured so the exported files will be stored in the public:// files directory. Click <a href=\"@link\" target=\"_blank\">here</a> for instructions on configuring the private files in the settings.php file.</strong>"
msgstr "<strong>Поскольку файловая система private:// не настроена, экспортированные файлы будут сохраняться в каталоге public://. Щелкните <a href=\"@link\" target=\"_blank\">здесь</a>, чтобы просмотреть инструкции по настройке частных файлов в файле settings.php. </strong>"

msgid "Check this if you want to download the file immediately after it is created. Does <strong>NOT</strong> work for JSON data exports."
msgstr "Включите, чтобы загрузить файл сразу после создания. <strong>Не</strong> подходит для экспорта данных JSON. "

msgid "Check this if you want to configure a custom redirect path."
msgstr "Включите, чтобы настроить пользовательский путь перенаправления. "

msgid "Select the display to redirect to after batch finishes. If None is selected the user will be redirected to the front page."
msgstr "Выберите дисплей для перенаправления после завершения пакетной обработки. Если выбрано значение Нет, то пользователь будет перенаправлен на главную страницу. "

msgid "Enter custom path to redirect user after batch finishes."
msgstr "Введите пользовательский путь для перенаправления пользователя после завершения пакетной обработки. "

msgid "Check this if you want to include query string parameters on redirect."
msgstr "Включите, чтобы добавить параметры строки запроса при перенаправлении. "

msgid "Displays"
msgstr "Отображения"

msgid "The data export icon will be available only to the selected displays."
msgstr "Значок экспорта данных будет доступен только для выбранных дисплеев. "

msgid "Choose the facet source used to alter data export. This should be the display that this data export is attached to."
msgstr "Выберите источник фасета, применяемый для изменения экспорта данных. Укажите дисплей, с которым связан экспорт данных. "

msgid "Could not write to temporary output file for result export (@file). Check permissions."
msgstr "Не удалось записать временный файл вывода для экспорта результата (@file). Проверьте права доступа. "

msgid "Export complete. Download the file <a download href=\":download_url\"  data-download-enabled=\"false\" id=\"vde-automatic-download\">here</a>."
msgstr "Экспорт выполнен. Загрузите файл <a download href=\":download_url\"  data-download-enabled=\"false\" id=\"vde-automatic-download\">здесь</a>."

msgid "Export complete. Download the file <a download href=\":download_url\" data-download-enabled=\"true\" id=\"vde-automatic-download\">here</a> if file is not automatically downloaded."
msgstr "Экспорт выполнен. Загрузите файл <a download href=\":download_url\" data-download-enabled=\"true\" id=\"vde-automatic-download\">здесь</a>, если он не будет загружен в автоматическом режиме."

msgid "Export failed. Make sure the private file system is configured and check the error log."
msgstr "Экспорт не выполнен. Убедитесь, что настроена частная файловая система и проверьте протокол ошибок. "

msgid "Data export"
msgstr "Экспорт данных"

msgid "Export the view results to a file. Can handle very large result sets."
msgstr "Экспортировать результаты представления в файл. Поддерживается обработка очень больших наборов результатов. "

msgid "Indicates the character used to delimit fields. Defaults to a comma (<code>,</code>). For tab-separation use <code>\\t</code> characters."
msgstr "Символ, применяемый в качестве ограничителя полей. Значение по умолчанию - запятая (<code>,</code>). Для применения символов табуляции укажите значение <code>\\t</code>. "

msgid "Indicates the character used for field enclosure. Defaults to a double quote (<code>\"</code>)."
msgstr "Задает символ, применяемый для выделения полей. Значение по умолчанию - двойная кавычка (<code>\"</code>). "

msgid "Indicates the character used for escaping. Defaults to a backslash (<code>\\</code>)."
msgstr "Задает символ, применяемый для экранирования. Значение по умолчанию - обратная косая черта (<code>\\</code>)."

msgid "Strips HTML tags from CSV cell values."
msgstr "Удаляет теги HTML из значений ячеек CSV. "

msgid "Trims whitespace from beginning and end of CSV cell values."
msgstr "Удаляет пробелы, расположенные в начале и в конце значений ячеек CSV. "

msgid "Determines the encoding used for CSV cell values."
msgstr "Определяет кодировку, применяемую для ячеек CSV."

msgid "UTF-8"
msgstr "UTF-8"

msgid "Include unicode signature (<a href=\"@bom\" target=\"_blank\">BOM</a>)."
msgstr "Добавить сигнатуру Unicode (<a href=\"@bom\" target=\"_blank\">BOM</a>)."

msgid "Only use Symfony serializer->encode method"
msgstr "Использовать только метод serializer->encode Symfony"

msgid "Skips the symfony data normalize method when rendering data export to increase performance on large datasets. <strong>(Only use when not exporting nested data)</strong>"
msgstr "Пропускает метод нормализации данных symfony при экспорте данных, чтобы повысить производительность обработки больших наборов данных. <strong>(Недопустимо в случае экспорта вложенных данных)</strong>"

msgid "Configurable row output for data exports."
msgstr "Настраиваемый вывод строк для экспорта данных. "

msgid "Download @format"
msgstr "Загрузить @format"

