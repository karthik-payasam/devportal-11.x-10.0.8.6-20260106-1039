msgid "About"
msgstr "Acerca de"

msgid "Smart Trim implements a new field formatter for text fields (text, text_long, and text_with_summary, if you want to get technical) that improves upon the \"Summary or Trimmed\" formatter."
msgstr "El Recorte inteligente implementa un formateador de campo nuevo para campos de texto (text, text_long y text_with_summary si desea conocer los detalles técnicos) que mejora el formateador \"Resumen o Recortado\"."

msgid "More"
msgstr "Más"

msgid "Read more about [node:title]"
msgstr "Más información sobre [node:title]"

msgid "Smart Trim"
msgstr "Recorte inteligente"

msgid "Provides a more robust alternative to \"summary or trimmed\" textfield format"
msgstr "Proporciona una alternativa más robusta a al formato de campo de texto \"resumen o recortado\""

msgid "Fields"
msgstr "Campos"

msgid "Smart trim formatter settings"
msgstr "Valores del formateador de recorte inteligente"

msgid "Trim length"
msgstr "Recortar longitud"

msgid "Trim units"
msgstr "Unidades de recorte"

msgid "Suffix"
msgstr "Sufijo"

msgid "Wrap trimmed content"
msgstr "Acomodar contenido recortado"

msgid "Wrapped content class"
msgstr "Clase de contenido acomodada"

msgid "More link configuration"
msgstr "Más configuración de enlaces"

msgid "Display more link"
msgstr "Visualizar enlace Más"

msgid "Open link in new window"
msgstr "Abrir enlace en ventana nueva"

msgid "More link only when content is trimmed"
msgstr "Más enlaces solo cuando se recorta el contenido"

msgid "More link class"
msgstr "Clase de enlace Más"

msgid "More link text"
msgstr "Texto del enlace 'más...'"

msgid "More link aria-label value"
msgstr "Valor de aria-label de más enlaces"

msgid "Summary handler"
msgstr "Manejador de resumen"

msgid "Additional options"
msgstr "Opciones adicionales"

msgid "Strip HTML"
msgstr "Eliminar HTML"

msgid "Honor a zero trim length"
msgstr "Respetar una longitud de recorte cero"

msgid "Replace tokens before trimming"
msgstr "Sustituir tokens antes de recortar"

msgid "Characters"
msgstr "Caracteres"

msgid "Words"
msgstr "Palabras"

msgid "Summary"
msgstr "Resumen"

msgid "Use summary if present, and do not trim"
msgstr "Utilizar el resumen si está presente y no recortar"

msgid "Use summary if present, honor trim settings"
msgstr "Utilizar el resumen si está presente, respetar valores de recorte"

msgid "Do not use summary"
msgstr "No utilizar el resumen"

msgid "Wrap trimmed content?"
msgstr "¿Desea acomodar el contenido recortado?"

msgid "Adds a wrapper div to trimmed content. This option is deprecated and will be removed in Smart Trim 3.0.0. Please override the smart-trim.html.twig template file to customize output."
msgstr "Añade un div derivador al contenido recortado. Esta opción está en desuso y se eliminará en Smart Trim 3.0.0. Altere temporalmente el archivo de plantilla smart-trim.html.twig para personalizar la salida."

msgid "Wrapped content class."
msgstr "Clase de contenido recortado."

msgid "If wrapping, define the class name here."
msgstr "Si se recorta, defina aquí el nombre de clase."

msgid "<em>More</em> link"
msgstr "Enlace <em>Más</em>"

msgid "Display <em>More</em> link?"
msgstr "¿Mostrar enlace <em>Más</em>?"

msgid "Displays a link to the entity (if one exists)"
msgstr "Visualiza un enlace a la entidad (si existe una)"

msgid "Display <em>More</em> link only when content is trimmed?"
msgstr "¿Mostrar enlace <em>Más</em> solo cuando se recorta el contenido?"

msgid "Only display <em>More</em> link if content is actually trimmed."
msgstr "Solo muestra el enlace <em>Más</em> si el contenido se ha recortado realmente."

msgid "Open <em>More</em> link in new window"
msgstr "Abrir el enlace <em>Más</em> en una ventana nueva"

msgid "<em>More</em> link text"
msgstr "Texto del enlace <em>Más</em>"

msgid "If displaying <em>More</em> link, enter the text for the link. This field supports tokens."
msgstr "Si visualiza el enlace <em>Más</em>, especifique el texto del enlace. Este campo admite comodines."

msgid "<em>More</em> link aria-label"
msgstr "Enlace <em>Más</em> aria-label"

msgid "If displaying <em>More</em> link, provide additional context for screen-reader users. In most cases, the aria-label value will be announced instead of the link text. This field supports tokens."
msgstr "Si visualiza el enlace <em>Más</em>, proporcione contexto adicional para los usuarios con lectores de pantalla. En la mayoría de los casos, se anunciará el valor de aria-label en lugar del texto del enlace. Este campo admite comodines."

msgid "<em>More</em> link class"
msgstr "Clase de enlace <em>Más</em>"

msgid "If displaying <em>More</em> link, add a custom class for formatting."
msgstr "Si visualiza el enlace <em>Más</em>, añada una clase personalizada para el formato."

msgid "words"
msgstr "palabras"

msgid "characters"
msgstr "caracteres"

msgid "Suffix: %suffix"
msgstr "Sufijo: %suffix"

msgid "<em>More</em> link enabled, text: %text"
msgstr "Enlace <em>Más</em> habilitado, texto: %text"

msgid "Only display <em>More</em> link when trimmed"
msgstr "Mostrar solo el enlace <em>Más</em> cuando se recorta"

msgid "<em>More</em> link aria-label: %label"
msgstr "Enlace <em>Más</em> aria-label: %label"

msgid "<em>More</em> link class: %class"
msgstr "Clase de enlace <em>Más</em>: %class"

msgid "Smart trimmed"
msgstr "Recortado inteligentemente"

