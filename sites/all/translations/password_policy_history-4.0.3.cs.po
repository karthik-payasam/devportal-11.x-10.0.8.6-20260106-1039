msgid "Password Policy History"
msgstr "Historie zásady hesla"

msgid "Sets up a password constraint to limit repeated use of the same password."
msgstr "Nastaví omezení hesla tak, aby bylo omezeno opakované použití stejného hesla."

msgid "Security"
msgstr "Zabezpečení"

msgid "Previous passwords cannot be reused. Choose a different password."
msgstr "Předchozí hesla nelze použít znovu. Vyberte jiné heslo."

msgid "Number of passwords that will be checked in the user password update history"
msgstr "Počet hesel, která se budou kontrolovat v historii aktualizace hesla uživatele"

msgid "A value of 0 represents that the user can not repeat any of the old passwords."
msgstr "Hodnota 0 znamená, že uživatel nemůže opakovat žádné staré heslo."

msgid "The number of repeated passwords value must be zero or greater."
msgstr "Hodnota počtu opakovaných hesel musí být nula nebo větší."

msgid "Number of passwords that will be checked in the user password update history: @number-repeats"
msgstr "Počet hesel, která se budou kontrolovat v historii aktualizace hesla uživatele: @number-repeats"

msgid "Password History"
msgstr "Historie hesla"

msgid "Provide restrictions on previously used passwords."
msgstr "Zadejte omezení pro dříve použitá hesla."

msgid "You have used the same password previously and cannot."
msgstr "Stejné heslo jste již použili a nemůžete jej použít."

