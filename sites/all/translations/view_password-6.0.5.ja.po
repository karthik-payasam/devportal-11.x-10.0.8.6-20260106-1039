msgid "About"
msgstr "アバウト"

msgid "View Password module will help the user to see what password they entered."
msgstr "「パスワードの表示」モジュールでは、ユーザーが入力したパスワードを確認できます。"

msgid "Show password"
msgstr "パスワードを表示する"

msgid "Hide password"
msgstr "パスワードを非表示にする"

msgid "View Password"
msgstr "パスワードの表示"

msgid "Allows the users to see the contents of the password fields on selected forms before submission."
msgstr "送信前に、選択したフォームのパスワード・フィールドの内容をユーザーが表示できるようにします。"

msgid "View Password Settings"
msgstr "パスワードの表示の設定"

msgid "Lets you see password for the selected forms."
msgstr "選択されているフォームのパスワードを確認できます。"

msgid "Administer View password"
msgstr "パスワードの表示の管理"

msgid "Configure the View password settings."
msgstr "パスワードの表示設定を構成します。"

msgid "View password config"
msgstr "パスワードの表示の構成"

msgid "Do not want to display the password for this forms."
msgstr "このフォームのパスワードを表示しません。"

msgid "Enter the form id(s) here."
msgstr "ここにフォーム ID を入力してください。"

msgid "<p>Please enter the form id(s) by separating it with a comma (<em>make sure there are no spaces between form ids</em>). For example, the usual form ids are <code>user_login_form</code> and <code>user_register_form</code>. .</p>"
msgstr "<p>フォーム ID をコンマで区切って入力してください (<em>フォーム ID の間にスペースがないことを確認してください</em>)。 例えば、通常のフォーム ID は <code>user_login_form</code> と <code>user_register_form</code> です。</p>"

msgid "Enter the form class here."
msgstr "ここにフォーム・クラスを入力します。"

msgid "Please enter the icon span classes separated with a space."
msgstr "アイコン・スパン・クラスをスペースで区切って入力してください。"

