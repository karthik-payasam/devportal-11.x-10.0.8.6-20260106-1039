msgstr "Fecha de publicación"

msgid "The date when Scheduler will publish the @entity_type_singular"
msgstr "Fecha en la que el planificador publicará el @entity_type_singular"

msgid "Set date for unpublishing a @entity_type_singular"
msgstr "Establecer fecha de anulación de publicación de un @entity_type_singular"

msgid "The @entity_type_singular which is to have a scheduled unpublishing date set"
msgstr "@entity_type_singular que ha de tener definida una fecha de anulación de publicación planificada"

