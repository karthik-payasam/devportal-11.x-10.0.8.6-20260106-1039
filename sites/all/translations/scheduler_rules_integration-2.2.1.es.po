msgstr "@entity_type_singular que se comprueba para el tipo cuya anulación de publicación planificada se está habilitando."

msgid "@entity_type_label is scheduled for publishing"
msgstr "@entity_type_label está planificado para su publicación"

msgid "The @entity_type_singular to check for having a scheduled publishing date."
msgstr "@entity_type_singular para comprobar si hay una fecha de publicación planificada."

msgid "@entity_type_label is scheduled for unpublishing"
msgstr "@entity_type_label está planificada para su anulación de publicación"

msgid "The @entity_type_singular to check for having a scheduled unpublishing date."
msgstr "@entity_type_singular para comprobar si hay planificada una fecha de anulación de publicación."

msgid "Node type is enabled for scheduled publishing"
msgstr "El tipo de nodo está habilitado para la publicación programada"

msgid "Content (Scheduler)"
msgstr "Contenido (planificador)"

msgid "The node to check for the type being enabled for scheduled publishing."
msgstr "Nodo que se comprueba para el tipo cuya publicación planificada se habilita."

msgid "Node is scheduled for publishing"
msgstr "El nodo está planificado para la publicación"

msgid "The node to check for having a scheduled publishing date."
msgstr "Nodo cuya fecha de publicación planificada se comprueba."

msgid "Node is scheduled for unpublishing"
msgstr "El nodo está planificado para la anulación de publicación"

msgid "The node to check for having a scheduled unpublishing date."
msgstr "Nodo en el que se comprueba si hay fecha de anulación de publicación planificada."

msgid "Node type is enabled for scheduled unpublishing"
msgstr "El tipo de nodo está habilitado para la anulación de publicación programada"

msgid "The node to check for the type being enabled for scheduled unpublishing."
msgstr "Nodo que se comprueba para tipo cuya anulación de publicación se habilita."

msgid "scheduled publishing"
msgstr "publicación planificada"

msgid "scheduled unpublishing"
msgstr "anulación de publicación planificada"

msgid "@bundle_label is enabled for @activity"
msgstr "@bundle_label está habilitado para @activity"

msgid "@type settings"
msgstr "Configuración de @type"

msgid "Action %action is not valid because @activity is not enabled for %type @group. Add the condition %condition to your Reaction Rule, or enable @activity via the <a href=\"@url\">%type</a> settings."
msgstr "La acción %action no es válida porque @activity no está habilitada para %type @group. Añada la condición %condition a la regla de reacción, o habilite @activity a través de la configuración de <a href=\"@url\">%type</a>."

msgid "Action %action is not valid because @activity is not enabled for %type @group. Add the condition %condition to your Reaction Rule, or enable @activity via the %type settings."
msgstr "La acción %action no es válida porque @activity no está habilitada para %type @group. Añada la condición %condition a la regla de reacción, o habilite @activity a través de la configuración de %type."

msgid "Set date for publishing a @entity_type_singular"
msgstr "Establecer fecha de publicación de un @entity_type_singular"

msgid "@entity_type_label for scheduling"
msgstr "@entity_type_label para la planificación"

msgid "The @entity_type_singular which is to have a scheduled publishing date set"
msgstr "@entity_type_singular que ha de tener definida una fecha de publicación planificada"

