msgid "Send e-mail when content is published by Scheduler"
msgstr "Enviar email cuando el contenido es publicado por Scheduler"

msgid "'[node:title]' has been published on [site:name]"
msgstr "'[node:title]' ha sido publicado en [site:name]"

msgid "Send e-mail when content is unpublished by Scheduler"
msgstr "Enviar email cuando el contenido es retirado de publicación por Scheduler"

msgid "'[node:title]' has been unpublished on [site:name]"
msgstr "'[node:title]' ha sido publicado en [site:name]"

msgid "Node"
msgstr "Nodo"

msgid "The node for publishing via Scheduler."
msgstr "Nodo de publicación vía planificador."

msgid "Publish-on Date"
msgstr "Fecha de publicación"

msgid "The publishing date to be used by Scheduler."
msgstr "Fecha de publicación que usa el planificador."

msgid "Set scheduled publishing date"
msgstr "Establecer fecha programada de publicación"

msgid "The node for unpublishing via Scheduler."
msgstr "Nodo de anulación de publicación vía planificador."

msgid "Unpublish-on Date"
msgstr "Fecha de anulación de publicación"

msgid "The unpublishing date to be used by Scheduler."
msgstr "Fecha de anulación de publicación que usa el planificador."

msgid "Set scheduled unpublishing date"
msgstr "Establecer fecha programada de retirada de la publicación"

msgid "The scheduled node"
msgstr "Nodo planificado"

msgid "The node scheduled for publishing via Scheduler."
msgstr "Nodo planificado para publicación vía planificador."

msgid "Remove scheduled publishing date"
msgstr "Borrar fecha programada de publicación"

msgid "The node scheduled for unpublishing via Scheduler."
msgstr "Nodo planificado para anulación de publicación vía planificador."

msgid "Remove scheduled unpublishing date"
msgstr "Borrar fecha programada de retirada de la publicación"

msgid "Scheduler Rules Integration"
msgstr "Integración de reglas de planificador"

msgid "Scheduler sub-module providing conditions, actions and events for use with the Rules module."
msgstr "Submódulo de planificador que proporciona condiciones, acciones y eventos para su uso en el módulo de reglas."

msgid "Scheduler"
msgstr "Planificador (Scheduler)"

msgid "The object representing the scheduled @entity_type"
msgstr "Objeto que representa el @entity_type planificado"

msgid "After saving a new @entity_type that is scheduled for publishing"
msgstr "Después de guardar un @entity_type nuevo planificado para su publicación"

msgid "After saving a new @entity_type that is scheduled for unpublishing"
msgstr "Después de guardar un @entity_type nuevo planificado para anular su publicación"

msgid "After updating a @entity_type that is scheduled for publishing"
msgstr "Después de actualizar un @entity_type planificado para su publicación"

msgid "After updating a @entity_type that is scheduled for unpublishing"
msgstr "Después de actualizar un @entity_type planificado para anular su publicación"

msgid "After Scheduler has published a @entity_type"
msgstr "Después de que el planificador haya publicado un @entity_type"

msgid "After Scheduler has unpublished a @entity_type"
msgstr "Después de que el planificador haya anulado la publicación de un @entity_type"

msgid "@entity_type_label type is enabled for scheduled publishing"
msgstr "El tipo @entity_type_label está habilitado para la publicación planificada"

msgid "@entity_type_label"
msgstr "@entity_type_label"

msgid "The @entity_type_singular to check for the type being enabled for scheduled publishing."
msgstr "@entity_type_singular que se comprueba para el tipo cuya publicación planificada se está habilitando."

msgid "@entity_type_label type is enabled for scheduled unpublishing"
msgstr "El tipo @entity_type_label está habilitado para la anulación de publicación planificada"

