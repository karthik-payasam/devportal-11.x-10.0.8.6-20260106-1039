msgstr "@entity_type_singular cuya fecha de publicación planificada se elimina"

msgid "Remove date for unpublishing a @entity_type_singular"
msgstr "Eliminar fecha de anulación de publicación de un @entity_type_singular"

msgid "The @entity_type_singular from which to remove the scheduled unpublishing date"
msgstr "@entity_type_singular cuya fecha de anulación de publicación planificada se elimina"

