msgid "Favicons & touch icons"
msgstr "Favicon e touch icon"

msgid "A PNG image that is 60px wide by 60px high. Used with the non-Retina iPhone, iPod Touch, and Android 2.1+ devices."
msgstr "Un'immagine PNG con dimensioni 60px X 60px. Utilizzata con IPhone non Retina, iPod Touch, e dispositivi Android 2.1+."

msgid "A PNG image that is 114px wide by 114px high. Used with iPhone with @2x display running iOS <= 6."
msgstr "Un'immagine PNG con dimensioni 114px X 114px. Utilizzata con iPhone con schermo @2x con iOS <= 6."

msgid "A PNG image that is 120px wide by 120px high. Used with iPhone with @2x display running iOS >= 7."
msgstr "Un'immagine PNG con dimensioni 120px X 120px. Utilizzata con iPhone con schermo @2x con iOS >= 7."

msgid "A PNG image that is 144px wide by 144px high. Used with iPad with @2x display running iOS <= 6."
msgstr "Un'immagine PNG con dimensioni 144px X 144px. Utilizzata con iPad con schermo @2x con iOS <= 6."

msgid "A PNG image that is 152px wide by 152px high. Used with iPad with @2x display running iOS >= 7."
msgstr "Un'immagine PNG con dimensioni 152px X 152px. Utilizzata con iPad con schermo @2x con iOS >= 7."

msgid "A PNG image that is 180px wide by 180px high. Used with iPhone 6 Plus with @3x display."
msgstr "Un'immagine PNG con dimensioni 180px X 180px. Utilizzata con iPhone 6 Plus con schermo @3x."

msgid "A PNG image that is 72px wide by 72px high. Used with the iPad mini and the first- and second-generation iPad (@1x display) on iOS <= 6."
msgstr "Un'immagine PNG con dimensioni 72px X 72px. Utilizzata con iPad ed iPad di prima e seconda generazione (schermo @1x) su iOS <= 6."

msgid "A PNG image that is 76px wide by 76px high. Used with the iPad mini and the second-generation iPad (@1x display) on iOS >= 7."
msgstr "Un'immagine PNG con dimensioni 76px X 76px. Utilizzata con iPad ed iPad di seconda generazione (schermo @1x) su iOS >= 7."

msgid "A PNG image that is 57px wide by 57px high. Used with the non-Retina iPhone, iPod Touch, and Android 2.1+ devices."
msgstr "Un'immagine PNG con dimensioni 57px X 57px. Utilizzata con IPhone non Retina, iPod Touch, e dispositivi Android 2.1+."

msgid "A PNG image that is 16px wide by 16px high."
msgstr "Un'immagine PNG con dimensioni 16px X 16px."

msgid "A PNG image that is 192px wide by 192px high."
msgstr "Un'immagine PNG con dimensioni 192px X 192px."

msgid "A PNG image that is 32px wide by 32px high."
msgstr "Un'immagine PNG con dimensioni 32px X 32px."

msgid "A PNG image that is 96px wide by 96px high."
msgstr "Un'immagine PNG con dimensioni 96px X 96px."

msgid "Mask icon color"
msgstr "Colore icona maschera"

msgid "Color attribute for SVG (mask) icon in hexadecimal format, e.g. '#0000ff'. Setting it will break HTML validation. If not set macOS Safari ignores the Mask Icon entirely, making the Icon: SVG completely useless."
msgstr "Attributo del colore per l'icona SVG (maschera) in formato esadecimale, ad esempio '#0000ff'. Questa impostazione causerà il mancato funzionamento della convalida HTML. Se non impostato, macOS Safari ignora completamente l'icona maschera, rendendo l'icona: SVG completamente inutile."

msgid "Mask icon (SVG)"
msgstr "Icona maschera (SVG)"

msgid "A grayscale scalable vector graphic (SVG) file."
msgstr "Un file SVG (scalable vector graphic) in scala di grigio."

msgid "Default icon"
msgstr "Icona predefinita"

msgid "The traditional favicon, must be either a GIF, ICO, JPG/JPEG or PNG image."
msgstr "La favicon tradizionale, deve essere un'immagine GIF, ICO, JPG/JPEG o PNG."

