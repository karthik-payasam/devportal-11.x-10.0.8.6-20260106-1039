msgid "Twitter Cards"
msgstr "Twitter Cards"

msgid "A set of meta tags specially for controlling the summaries displayed when content is shared on <a href='https://twitter.com/'>Twitter</a>."
msgstr "一组专门用于控制在 <a href='https://twitter.com/'>Twitter</a> 上分享内容时显示的摘要的元标记。"

msgid "Google Play app ID"
msgstr "Google Play 应用程序标识"

msgid "iPad app ID"
msgstr "iPad 应用程序标识"

msgid "String value, should be the numeric representation of your iPad app's ID in the App Store."
msgstr "字符串值，应该是应用商店中 iPad 应用程序标识的数字表示。"

msgid "iPhone app ID"
msgstr "iPhone 应用程序标识"

msgid "String value, should be the numeric representation of your iPhone app's ID in the App Store."
msgstr "字符串值，应该是应用商店中 iPhone 应用程序标识的数字表示。"

msgid "Google Play app name"
msgstr "Google Play 应用程序名称"

msgid "The name of the app in the Google Play app store."
msgstr "Google Play 应用商店中应用程序的名称。"

msgid "iPad app name"
msgstr "iPad 应用程序名称"

msgid "The name of the iPad app."
msgstr "iPad 应用程序的名称。"

msgid "iPhone app name"
msgstr "iPhone 应用程序名称"

msgid "The name of the iPhone app."
msgstr "iPhone 应用程序的名称。"

msgid "App store country"
msgstr "应用商店国家或地区"

msgid "If your application is not available in the US App Store, you must set this value to the two-letter country code for the App Store that contains your application."
msgstr "如果您的应用程序在美国应用商店中不可用，那么必须将此值设置为包含该应用程序的应用商店的两字母国家或地区代码。"

msgid "Google Play app's custom URL scheme"
msgstr "Google Play 应用程序定制 URL 方案"

msgid "iPad app's custom URL scheme"
msgstr "iPad 应用程序定制 URL 方案"

msgid "iPhone app's custom URL scheme"
msgstr "iPhone 应用程序定制 URL 方案"

msgid "Creator's Twitter account"
msgstr "创建者的 Twitter 帐户"

msgid "The @username for the content creator / author for this page, including the @ symbol."
msgstr "此页面的内容创建者/作者的 @username，包括 @ 符号。"

msgid "Creator's Twitter account ID"
msgstr "创建者的 Twitter 帐户标识"

msgid "The numerical Twitter account ID for the content creator / author for this page."
msgstr "此页面的内容创建者/作者的数字 Twitter 帐户标识。"

msgid "Data 1"
msgstr "数据 1"

msgid "This field expects a string, and allows you to specify the types of data you want to offer (price, country, etc.)."
msgstr "此字段期望为字符串，并且允许指定想要提供的数据类型（价格、国家或地区等）。"

msgid "Data 2"
msgstr "数据 2"

msgid "Description"
msgstr "描述"

msgid "A description that concisely summarizes the content of the page, as appropriate for presentation within a Tweet. Do not re-use the title text as the description, or use this field to describe the general services provided by the website. The string will be truncated, by Twitter, at the word to 200 characters."
msgstr "简要概述页面内容且适合在 Tweet 中显示的描述。 请勿将标题文本复用为描述，或者使用此字段来描述该 Web 站点提供的常规服务。 Twitter 会将该字符串截断为 200 个字符。"

msgid "Do Not Track"
msgstr "不跟踪"

msgid "1st gallery image"
msgstr "第 1 个图库图像"

msgid "A URL to the image representing the first photo in your gallery."
msgstr "表示图库中第一张照片的图像的 URL。"

msgid "2nd gallery image"
msgstr "第 2 个图库图像"

msgid "A URL to the image representing the second photo in your gallery."
msgstr "表示图库中第二张照片的图像的 URL。"

msgid "3rd gallery image"
msgstr "第 3 个图库图像"

msgid "A URL to the image representing the third photo in your gallery."
msgstr "表示图库中第三张照片的图像的 URL。"

msgid "4th gallery image"
msgstr "第 4 个图库图像"

msgid "A URL to the image representing the fourth photo in your gallery."
msgstr "表示图库中第四张照片的图像的 URL。"

msgid "Image URL"
msgstr "图像 URL"

msgid "The URL to a unique image representing the content of the page. Do not use a generic image such as your website logo, author photo, or other image that spans multiple pages. Images larger than 120x120px will be resized and cropped square based on longest dimension. Images smaller than 60x60px will not be shown. If the 'type' is set to Photo then the image must be at least 280x150px."
msgstr "表示页面内容的唯一图像的 URL。请勿使用通用图像，例如，Web 站点徽标、作者照片或跨多个页面共享的其他图像。超过 120 像素 x 120 像素的图像将调整大小且基于最大规格进行方形裁切。将不显示小于 60 像素 x 60 像素的图像。如果将“类型”设置为“照片”，那么图像必须至少为 280 像素 x 150 像素。"

msgid "Image alternative text"
msgstr "图像备用文本"

msgid "The alternative text of the image being linked to. Limited to 420 characters."
msgstr "要链接到的图像的备用文本。 限制为 420 个字符。"

msgid "Image height"
msgstr "图像高度"

msgid "The height of the image being linked to, in pixels."
msgstr "要链接到的图像的高度（以像素为单位）。"

msgid "Image width"
msgstr "图像宽度"

msgid "The width of the image being linked to, in pixels."
msgstr "要链接到的图像的宽度（以像素为单位）。"

msgid "Label 1"
msgstr "标签 1"

msgid "This field expects a string, and you can specify values for labels such as price, items in stock, sizes, etc."
msgstr "此字段期望为字符串，您可以指定标签的值，例如，价格、库存商品和大小等"

msgid "Label 2"
msgstr "标签\t2"

msgid "Page URL"
msgstr "页面 URL"

msgid "The permalink / canonical URL of the current page."
msgstr "当前页面的永久链接/标准 URL。"

msgid "Media player URL"
msgstr "媒体播放器 URL"

msgid "The full URL for loading a media player, specifically an iframe for an embedded video rather than the URL to a page that contains a player. Required when using the Player Card type."
msgstr "用于装入媒体播放器的完整 URL，特别是嵌入式视频的 iframe，而不是包含播放器的页面的 URL。 使用“播放器卡”类型时必需。"

msgid "Media player height"
msgstr "媒体播放器高度"

msgid "The height of the media player iframe, in pixels. Required when using the Player Card type."
msgstr "媒体播放器信息帧的高度（以像素为单位）。 使用“播放器卡”类型时必需。"

msgid "MP4 media stream URL"
msgstr "MP4 媒体流 URL"

msgid "The full URL for an MP4 video (h.264) or audio (AAC) stream, takes precedence over the other media player field."
msgstr "MP4 视频 (h.264) 或音频 (AAC) 流的完整 URL 优先于其他媒体播放器字段。"

msgid "MP4 media stream MIME-type"
msgstr "MP4 媒体流 MIME 类型"

msgid "Media player width"
msgstr "媒体播放器宽度"

msgid "The width of the media player iframe, in pixels. Required when using the Player Card type."
msgstr "媒体播放器信息帧的宽度（以像素为单位）。 使用“播放器卡”类型时必需。"

msgid "Site's Twitter account"
msgstr "站点的 Twitter 帐户"

msgid "The @username for the website, which will be displayed in the Card's footer; must include the @ symbol."
msgstr "Web 站点的 @username，将在卡片页脚中显示；必须包含 @ 符号。"

msgid "Site's Twitter account ID"
msgstr "站点的 Twitter 帐户标识"

msgid "The numerical Twitter account ID for the website, which will be displayed in the Card's footer."
msgstr "Web 站点的数字 Twitter 帐户标识，将在卡片页脚中显示。"

msgid "Title"
msgstr "标题"

msgid "The page's title, which should be concise; it will be truncated at 70 characters by Twitter. This field is required unless this the 'type' field is set to 'photo'."
msgstr "页面标题，它应一目了然；Twitter 会将其截断为 70 个字符。 除非将“类型”字段设置为“照片”，否则此字段是必填字段。"

msgid "- None -"
msgstr "- 无 -"

msgid "Summary Card"
msgstr "摘要卡片"

msgid "Summary Card with large image"
msgstr "包含大图像的摘要卡片"

msgid "Photo Card"
msgstr "照片卡片"

msgid "Gallery Card"
msgstr "图库卡片"

msgid "App Card"
msgstr "应用程序卡片"

msgid "Player Card"
msgstr "播放器卡片"

msgid "Product Card"
msgstr "产品卡片"

msgid "Twitter card type"
msgstr "Twitter 卡片类型"

msgid "Notes:<ul><li>no other fields are required for a Summary card</li><li>Photo card requires the 'image' field</li><li>Media player card requires the 'title', 'description', 'media player URL', 'media player width', 'media player height' and 'image' fields,</li><li>Summary Card with Large Image card requires the 'Summary' field and the 'image' field,</li><li>Gallery Card requires all the 'Gallery Image' fields,</li><li>App Card requires the 'iPhone app ID' field, the 'iPad app ID' field and the 'Google Play app ID' field,</li><li>Product Card requires the 'description' field, the 'image' field, the 'Label 1' field, the 'Data 1' field, the 'Label 2' field and the 'Data 2' field.</li></ul>"
msgstr "注：<ul><li>“摘要”卡不需要其他字段</li><li>“照片”卡需要“图像”字段</li><li>“媒体播放器”卡需要“标题”、“描述”、“媒体播放器 URL”、“媒体播放器宽度”、“媒体播放器高度”和“图像”字段，</li><li>“带大图像的摘要卡”卡需要“摘要”字段和“图像”字段，</li><li>“图库”卡需要所有“图库图像”字段，</li><li>“应用”卡需要“iPhone 应用标识”字段、 “iPad 应用标识”字段和“Google Play 应用标识”字段，</li><li>“产品”卡需要“描述”字段、“图像”字段、“标签 1”字段、“数据 1”字段、“标签 2”字段和“数据 2”字段。</li></ul>"

