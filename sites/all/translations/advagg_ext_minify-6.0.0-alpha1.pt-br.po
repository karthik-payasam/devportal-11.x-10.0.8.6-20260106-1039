msgid "Advagg External Minification: PHP shell_exec"
msgstr "Minificação Externa do Advagg: PHP shell_exec"

msgid "PHP shell_exec is non-functional."
msgstr "O PHP shell_exec não está funcional."

msgid "Check php.ini for safemode or <a href=\"@link\" target=\"_blank\">disable_functions</a>."
msgstr "Verifique o php.ini para obter o modo de segurança ou <a href=\"@link\" target=\"_blank\">disable_functions</a>."

msgid "Enabled"
msgstr "Ativado"

msgid "AdvAgg External Minification"
msgstr "Minificação Externa do AdvAgg"

msgid "Minify Javascript and/or CSS with a command line minifier."
msgstr "Minificar Javascript e/ou CSS com um minificador de linha de comandos."

msgid "Advanced CSS/JS Aggregation"
msgstr "Agregação CSS/JS Avançada"

msgid "External Minification"
msgstr "Minificação Externa"

