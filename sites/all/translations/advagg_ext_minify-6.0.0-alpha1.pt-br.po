msgstr "Linha de comandos"

msgid "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = input file. <br /> {%IN_URL_ENC%} = url pointing to the input file that has been url encoded. <br /> {%OUT%} = output file. <br /><br />"
msgstr "{%CWD%} = \\Drupal::root() <br /> {%IN%} = o arquivo de entrada. <br /> {%IN_URL_ENC%} = a URL que aponta para o arquivo de entrada que foi codificado para a URL. <br /> {%OUT%} = o arquivo de saída. <br /><br />"

msgid "Example using the <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"
msgstr "Exemplo usando o <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "Exemplo de uso do <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"

