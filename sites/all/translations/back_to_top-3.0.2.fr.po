msgstr "Voulez-vous empêcher l'utilisation du bouton haut de page sur la page d'accueil ?"

msgid "Set the number of pixel which trigger the Back To Top button default 100"
msgstr "Définissez le nombre de pixels qui déclenchera la valeur par défaut 100 du bouton Haut de page"

msgid "Where should the Back To Top button appear?"
msgstr "Où voulez-vous placer le bouton Haut de page ?"

msgid "Bottom right"
msgstr "Bas droit"

msgid "Bottom left"
msgstr "Bas gauche"

msgid "Bottom center"
msgstr "En bas au centre"

