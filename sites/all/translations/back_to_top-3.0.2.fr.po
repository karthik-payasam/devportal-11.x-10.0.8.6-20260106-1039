msgid "Back To Top"
msgstr "Retourner en haut"

msgid "Back To Top adds a button that hovers in the bottom of your screen and allow users to smoothly scroll up the page using jQuery."
msgstr "Le bouton Haut de page au bas de l'écran permet aux utilisateurs de revenir en douceur vers le haut de la page en utilisant jQuery."

msgid "User interface"
msgstr "Interface utilisateur"

msgid "Back to Top"
msgstr "Retour en haut de Page"

msgid "Administer Back To Top settings."
msgstr "Administrer les paramètres Haut de page."

msgid "Back to top settings"
msgstr "Paramètres Haut de page"

msgid "Access Back to top settings"
msgstr "Accéder aux paramètres Haut de page"

msgid "Prevent on mobile and touch devices"
msgstr "Empêcher sur les appareils mobiles et tactiles"

msgid "Prevent on administration pages and node edit"
msgstr "Empêcher sur les pages d'administration et de modification de noeud"

msgid "Prevent on front page"
msgstr "Empêcher sur la page d'accueil"

msgid "Trigger"
msgstr "Déclencheur"

msgid "Placement"
msgstr "Emplacement"

msgid "Button text"
msgstr "Texte du bouton"

