msgid "About"
msgstr "À propos"

msgid "Secure File Upload Mime Detect"
msgstr "Détection MIME de téléchargement de fichier sécurisée"

msgid "Fileinfo extension"
msgstr "Extension Fileinfo"

msgid "Found"
msgstr "Trouvé"

msgid "Fileinfo extension not available"
msgstr "L'extension Fileinfo n'est pas disponible"

msgid "File upload secure validator module uses Fileinfo extension. It seems as if Fileinfo extension is not loaded/enabled. If you are using Windows, may be, you should uncomment php_fileinfo.dll in php.ini file."
msgstr "Le module du valideur sécurisé des téléchargements de fichier utilise l'extension Fileinfo. Il semble que l'extension Fileinfo n'ait pas été chargée/activée. Si vous utilisez Windows, essayez de supprimer la mise en commentaire de php_fileinfo.dll dans le fichier php.ini."

msgid "File Upload Secure Validator"
msgstr "Valideur sécurisé des téléchargements de fichier"

msgid "Secure Mime Detect"
msgstr "Détection Mime sécurisée"

msgid "Security"
msgstr "Sécurité"

msgid "Manage the list of MIME types equivalence groups."
msgstr "Gérer la liste des groupes d'équivalence de types MIME."

msgid "Administer File Upload Secure Validator configuration"
msgstr "Administrer la configuration du valideur sécurisé de téléchargement de fichiers"

msgid "Allow user to administer File Upload Secure Validator configuration."
msgstr "Permet à l'utilisateur d'administrer la configuration du valideur sécurisé de téléchargement de fichiers."

msgid "SettingsForm"
msgstr "SettingsForm"

msgid "MIME types equivalence groups"
msgstr "Groupes d'équivalence de types MIME"

msgid "MIME types equivalence group"
msgstr "Groupe d'équivalence de types MIME"

msgid "MIME type"
msgstr "Type MIME"

msgid "MIME types equivalence group(s)"
msgstr "Groupe(s) d'équivalence de types MIME"

msgid "A CSV-like list of MIME types groups; if two MIME types are part of the same group, then, File Upload Secure Validator will not protest."
msgstr "Liste des groupes de types MIME équivalents CSV ; si deux types MIME font partie du même groupe, le valideur sécurisé de téléchargement de fichier n'émettra pas d'objection."

msgid "Caught an InvalidArgumentException; cannot validate missing file requested as @path"
msgstr "Une exception InvalidArgument a été interceptée ; impossible de valider le fichier manquant demandé en tant que @path"

msgid "There was a problem with this file. The uploaded file is of type @extension but the real content seems to be @real_extension"
msgstr "Un problème lié à ce fichier s'est produit. Le fichier téléchargé est de type @extension, mais le contenu réel semble être de type @real_extension"

msgid "Error while uploading file: MimeTypeGuesser guessed '%mime_by_fileinfo' and fileinfo '%mime_by_filename'"
msgstr "Erreur lors du téléchargement du fichier : MimeTypeGuesser a deviné '%mime_by_fileinfo' et fileinfo '%mime_by_filename'"

