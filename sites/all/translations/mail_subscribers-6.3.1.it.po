msgstr "Inviati @current messaggi su @total."

msgid "Sent email to owners subscribing to product %product"
msgstr "E-mail inviata ai proprietari che effettuano la sottoscrizione al prodotto %product"

msgid "Sent email to members subscribing to product %product"
msgstr "E-mail inviata ai membri che effettuano la sottoscrizione al prodotto %product"

msgid "Sent email to owners subscribing to API %api"
msgstr "E-mail inviata ai proprietari che effettuano la sottoscrizione all'API %api"

msgid "Sent email to members subscribing to API %api"
msgstr "E-mail inviata ai membri che effettuano la sottoscrizione all'API %api"

msgid "Sent email to all consumer organization owners"
msgstr "E-mail inviata a tutti i proprietari delle organizzazioni consumer"

msgid "Sent email to all consumer organization members"
msgstr "E-mail inviata a tutti i membri dell'organizzazione consumer"

