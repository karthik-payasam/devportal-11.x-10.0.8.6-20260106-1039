msgid "Allowlist skipping ban: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Verbot des Überspringen der Zulassungsliste: %ip für fehlgeschlagene %type auf %form <br />Quelle: %source <br /> Benutzeragent: %browser"

msgid "Banned: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Verbannt: %ip für fehlgeschlagene %type auf %form <br />Quelle: %source <br /> Benutzeragent: %browser"

msgid "Drupal Perimeter Defence"
msgstr "Drupal Perimeter Defence"

msgid "Immediately ban hackers when they try to scan the site."
msgstr "Hacker sofort stoppen, wenn sie versuchen, die Website zu scannen."

msgid "Perimeter defence settings"
msgstr "Einstellungen für die Perimeter-Defence"

msgid "Configure the settings for Drupal Perimeter Defence."
msgstr "Konfigurieren Sie die Einstellungen für Drupal Perimeter Defence."

msgid "Bypass Perimeter Defence ban rules"
msgstr "Verbotsregeln für Umgehung von Perimeter Defence"

msgid "Allow users to bypass the rules defined by Perimeter Defence module."
msgstr "Ermöglicht Benutzern, die vom Perimeter Defence-Modul definierten Regeln zu umgehen."

msgid "Perimeter settings"
msgstr "Perimeter-Einstellungen"

msgid "Perimeter Settings"
msgstr "Perimeter-Einstellungen"

msgid "A list of regex patterns"
msgstr "Eine Liste der Regex-Muster"

msgid "A regex pattern"
msgstr "Ein Regex-Muster"

msgid "Banned: %ip for requesting %pattern <br />Source: %source <br /> User Agent: %browser"
msgstr "Gesperrt: %ip für Anforderung von %pattern <br />Quelle: %source<br /> Benutzeragent: %browser"

msgid "Perimeter will ban any user that generates \"404 - File not found\" for requesting any of the following url pattern"
msgstr "Perimeter sperrt jeden Benutzer, der \"404 - Datei nicht gefunden\" für die Anforderung eines der folgenden URL-Muster erzeugt"

msgid "Ban URL patterns"
msgstr "URL-Muster sperren"

msgid "A list of regex patterns, each pattern on a separate line"
msgstr "Eine Liste der Regex-Muster, jedes Muster in einer separaten Zeile"

