msgstr "Yoklama Tanıtıcısı"

msgid "The ID of the poll."
msgstr "Yoklamanın tanıtıcısı."

msgid "The poll author."
msgstr "Yoklama yazarı."

msgid "UUID"
msgstr "UUID"

msgid "The poll UUID."
msgstr "Yoklama UUID'si."

msgid "The poll question."
msgstr "Yoklama sorusu."

msgid "Language code"
msgstr "Dil kodu"

msgid "The poll language code."
msgstr "Yoklama dil kodu."

