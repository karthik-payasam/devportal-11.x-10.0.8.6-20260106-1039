msgstr "Yoklama seçimlerini girin."

msgid "Unlimited"
msgstr "Sınırsız"

msgid "Poll Duration"
msgstr "Yoklama Süresi"

msgid "After this period, the poll will be closed automatically."
msgstr "Bu sürenin bitiminde, anket otomatik olarak kapatılacaktır."

msgid "Allow anonymous votes"
msgstr "Anonim oylara izin ver"

msgid "A flag indicating whether anonymous users are allowed to vote."
msgstr "Anonim kullanıcıların oy vermesine izin verilip verilmediğini belirten bir işaret."

msgid "Allow cancel votes"
msgstr "Oyların iptal edilmesine izin ver"

msgid "A flag indicating whether users may cancel their vote."
msgstr "Kullanıcıların oylarını iptal edip edemeyeceğini belirten bir işaret."

msgid "Allow view results"
msgstr "Sonuçların görüntülenmesine izin ver"

msgid "A flag indicating whether users may see the results before voting."
msgstr "Kullanıcıların oy vermeden önce sonuçları görüp göremeyeceğini belirten bir işaret."

msgid "Active"
msgstr "Etkin"

msgid "A flag indicating whether the poll is active."
msgstr "Yoklamanın etkin olup olmadığını belirten bir işaret."

msgid "When the poll was created, as a Unix timestamp."
msgstr "Unix zaman damgası olarak, yoklamanın oluşturulduğu zaman."

msgid "Choice ID"
msgstr "Seçim ID'si"

msgid "Poll Choice"
msgstr "Yoklama Seçimi"

msgid "All associated votes will be deleted too. This action cannot be undone."
msgstr "Tüm ilişkili oylar da silinecek. Bu işlem geri alınamaz."

msgid "Are you sure you want to delete this poll %poll"
msgstr "Bu %poll yoklamasını silmek istediğinizden emin misiniz?"

