msgid "Changed key type from \"aes_encryption\" to \"encryption\" for existing keys."
msgstr "Se ha cambiado el tipo de clave de \"aes_encryption\" a \"encryption\" para las claves existentes."

msgid "No changes to existing keys were made because there were no keys defined with the \"aes_encryption\" key type."
msgstr "No se han hecho cambios en las claves existentes porque no hay claves definidas con el tipo de clave \"aes_encryption\"."

msgid "Added configuration dependencies on keys for existing profiles."
msgstr "Se han añadido dependencias de configuración en claves para perfiles existentes."

msgid "No changes were made because there were no profiles without a configuration dependency on their key."
msgstr "No se han realizado cambios porque no había perfiles sin una dependencia de configuración en su clave."

msgid "Encrypt"
msgstr "Cifrar"

msgid "Provides an API for two-way encryption."
msgstr "Proporciona una API para el cifrado bidireccional."

msgid "Encryption"
msgstr "Cifrado"

msgid "Add Encryption Profile"
msgstr "Añadir perfil de cifrado"

msgid "Encryption profiles"
msgstr "Perfiles de cifrado"

msgid "Manage profiles that can be used to encrypt and decrypt data."
msgstr "Gestionar perfiles que se pueden utilizar para cifrar y descifrar datos."

msgid "List"
msgstr "Listado"

msgid "Settings"
msgstr "Configuración"

msgid "Administer encryption settings"
msgstr "Administrar valores de cifrado"

msgid "Change encryption settings (does not let them view encrypted data)."
msgstr "Cambiar los valores de cifrado (no les permite ver datos cifrados)."

msgid "Add encryption profile"
msgstr "Añadir perfil de cifrado"

msgid "Edit encryption profile"
msgstr "Editar perfil de cifrado"

msgid "Delete encryption profile"
msgstr "Suprimir perfil de cifrado"

msgid "Test encryption profile"
msgstr "Probar perfil de cifrado"

msgid "Encrypt settings"
msgstr "Valores de cifrado"

msgid "Encrypt Profile"
msgstr "Perfil de cifrado"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "Etiqueta"

msgid "Encryption method selected for encryption profile"
msgstr "Método de cifrado seleccionado para el perfil de cifrado."

msgid "Encryption method configuration"
msgstr "Configuración de método de cifrado"

msgid "Key ID for encryption profile"
msgstr "ID de clave para perfil de cifrado"

msgid "Encryption method config"
msgstr "Config. de método de cifrado"

msgid "Encrypt Settings"
msgstr "Valores de cifrado"

msgid "Check profile validation status."
msgstr "Compruebe el estado de validación del perfil."

msgid "Deprecated encryption plugins allowed."
msgstr "Se permiten plug-ins de cifrado en desuso."

msgid "Encrypt commands"
msgstr "Mandatos de cifrado"

msgid "Interact with the encryption service."
msgstr "Interactuar con el servicio de cifrado."

msgid "Encryption profile \"@name\" could not be loaded."
msgstr "No se ha podido cargar el perfil de cifrado \"@name\"."

msgid "Please specify the encryption profile and the text to be encrypted"
msgstr "Especifique el perfil de cifrado y el texto que se va a cifrar"

msgid "Please specify the decryption profile and the encrypted text to be decrypted"
msgstr "Especifique el perfil de descifrado y el texto cifrado que se va a descifrar."

msgid "Please specify the encryption profile to be validated"
msgstr "Especifique el perfil de cifrado que se va a validar"

msgid "Encryption profile validates successfully."
msgstr "El perfil de cifrado se valida satisfactoriamente."

msgid "Encryption profile @profile could not be loaded."
msgstr "No se ha podido cargar el perfil de cifrado @profile."

msgid "Encryption method"
msgstr "Método de cifrado"

msgid "Key"
msgstr "Clave"

msgid "Status"
msgstr "Estado"

msgid "Error loading encryption method"
msgstr "Error al cargar el método de cifrado"

msgid "Error loading key"
msgstr "Error al cargar la clave"

msgid "The encryption plugin used in this encryption profile is deprecated."
msgstr "El plug-in de cifrado utilizado en este perfil de cifrado está en desuso."

msgid "OK"
msgstr "OK"

msgid "Test"
msgstr "Prueba"

msgid "No encryption profiles are available. <a href=\":link\">Add a profile</a>."
msgstr "No hay perfiles de cifrado disponibles. <a href=\":link\">Añadir un perfil</a>."

msgid "No encryption method selected."
msgstr "No se ha seleccionado ningún método de cifrado."

msgid "No encryption key selected."
msgstr "No se ha seleccionado ninguna clave de cifrado."

msgid "The encryption method linked to this encryption profile does not exist."
msgstr "El método de cifrado enlazado a este perfil de cifrado no existe."

msgid "The key linked to this encryption profile does not exist."
msgstr "La clave enlazada a este perfil de cifrado no existe."

msgid "The selected key cannot be used with the selected encryption method."
msgstr "La clave seleccionada no se puede utilizar con el método de cifrado seleccionado."

msgid "Encryption Profile"
msgstr "Perfil de cifrado"

msgid "Show the validation status of encryption profiles."
msgstr "Mostrar el estado de validación de los perfiles de cifrado."

msgid "On the encryption profiles overview page, automatically validate each encryption profile to check if there are problems with it. Disable when you have a lot of encryption profiles and are encountering performance issues, or if you do not want encryption keys to be loaded by the status check."
msgstr "En la página de visión general de perfiles de cifrado, valide automáticamente cada perfil de cifrado para comprobar si hay problemas con él. Inhabilite los perfiles de cifrado cuando tenga muchos y experimente problemas de rendimiento o si no desea cargar claves de cifrado por la comprobación de estado."

msgid "Allow the use of deprecated plugins."
msgstr "Permitir el uso de plug-ins en desuso."

msgid "Enable this setting to allow the use of deprecated encryption plugins in new profiles. Leave disabled to only allow their use in existing profiles"
msgstr "Habilite este valor para permitir el uso de plug-ins de cifrado en desuso en nuevos perfiles. Déjelo inhabilitado para permitir su uso solo en perfiles existentes"

msgid "Are you sure you want to delete %name?"
msgstr "¿Seguro que desea borrar %name ?"

msgid "Delete"
msgstr "Eliminar"

msgid "content @type: deleted @label."
msgstr "@type de contenido: eliminado @label."

msgid "Be extremely careful when editing an encryption profile! It may result in making data encrypted with this profile unreadable. Are you sure you want to edit this profile?"
msgstr "¡Tenga mucho cuidado al editar un perfil de cifrado! Puede ocurrir que los datos cifrados con este perfil sean ilegibles. ¿Está seguro de que desea editar este perfil?"

msgid "Label for the encryption profile."
msgstr "Etiqueta para el perfil de cifrado."

msgid "Encryption Method"
msgstr "Método de cifrado"

msgid "Select the method used for encryption"
msgstr "Seleccione el método utilizado para el cifrado"

msgid "Encryption method settings"
msgstr "Valores de método de cifrado"

msgid "Encryption Key"
msgstr "Clave de cifrado"

msgid "Edit"
msgstr "Editar"

msgid "Cancel"
msgstr "Cancelar"

msgid "Saved the %label encryption profile."
msgstr "Se ha guardado el perfil de cifrado %label."

msgid "The %label encryption profile was not saved."
msgstr "No se ha guardado el perfil de cifrado %label."

msgid "Encryption test"
msgstr "Prueba de cifrado"

msgid "Text to encrypt"
msgstr "Texto a cifrar"

msgid "Specify the text you want to encrypt with this encryption profile. The result of the encryption will be shown below."
msgstr "Especifique el texto que desea cifrar con este perfil de cifrado. El resultado del cifrado se mostrará más abajo."

msgid "Base64-encode the encrypted text."
msgstr "Codificar en Base64 el texto cifrado."

msgid "Encrypted text"
msgstr "Texto cifrado"

msgid "Decryption test"
msgstr "Prueba de descifrado"

msgid "Text to decrypt"
msgstr "Texto a descifrar"

msgid "Specify the text you want to decrypt with this encryption profile. The result of the decryption will be shown below."
msgstr "Especifique el texto que desea descifrar con este perfil de cifrado. El resultado del descifrado se mostrará más abajo."

msgid "Base64-decode the encrypted text before decrypting."
msgstr "Decodificar en Base64 el texto cifrado antes de descifrar."

msgid "Decrypt"
msgstr "Descifrar"

msgid "Decrypted text"
msgstr "Texto descifrado"

