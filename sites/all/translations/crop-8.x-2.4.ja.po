msgstr "@first、@second、およびその他 @count 個"

msgid "No crop types available. <a href=\"@link\">Add crop type</a>."
msgstr "トリミング・タイプがありません。<a href=\"@link\">トリミング・タイプを追加してください</a>。"

msgid "Entity provider @id not found."
msgstr "エンティティー・プロバイダー @id が見つかりません。"

msgid "Crop ID"
msgstr "トリミング ID"

msgid "The crop ID."
msgstr "トリミング ID。"

