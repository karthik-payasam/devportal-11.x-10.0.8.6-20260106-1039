msgstr "トリミングが属しているエンティティーの ID。"

msgid "Entity type"
msgstr "エンティティタイプ"

msgid "The type of entity crop belongs to."
msgstr "トリミングが属しているエンティティーのタイプ。"

msgid "URI"
msgstr "URI"

msgid "The URI of the image crop belongs to."
msgstr "トリミングが属しているイメージの URI。"

