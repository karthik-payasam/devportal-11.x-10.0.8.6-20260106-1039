msgid "About"
msgstr "Over"

msgid "The Admin Toolbar Search module add a search option to the toolbar for site administrative tasks."
msgstr "Met de module Zoeken beheerwerkbalk kunt u een zoekoptie toevoegen aan de werkbalk voor beheertaken voor de site."

msgid "Search"
msgstr "Zoeken"

msgid "Admin Toolbar quick search"
msgstr "Snelle zoekopdracht in werkbalk beheerder"

msgid "Admin Toolbar Search"
msgstr "Zoeken beheerwerkbalk"

msgid "Provides search of Admin Toolbar items."
msgstr "Levert een zoekbewerking voor items in de beheerwerkbalk."

msgid "Administration"
msgstr "Beheer"

msgid "Configure the Admin Toolbar Search module."
msgstr "Configureer de zoekmodule voor de beheerwerkbalk."

msgid "Use Admin Toolbar search"
msgstr "Zoeken in beheerwerkbalk gebruiken"

msgid "Admin toolbar search settings"
msgstr "Zoekinstellingen beheerwerkbalk"

msgid "Admin Toolbar Search settings"
msgstr "Instellingen voor zoeken in beheerwerkbalk"

msgid "How the search input will be displayed"
msgstr "Hoe de zoekinvoer wordt weergegeven"

msgid "@entity_type > @bundle"
msgstr "@entity_type > @bundle"

msgid "Edit"
msgstr "Bewerken"

msgid "Manage fields"
msgstr "Velden beheren"

msgid "Manage form display"
msgstr "Formulierweergave beheren"

msgid "Manage display"
msgstr "Weergave beheren"

msgid "Devel"
msgstr "Devel"

msgid "Delete"
msgstr "Verwijderen"

msgid "Menus > @menu_label"
msgstr "Menu's > @menu_label"

msgid "Menus > @menu_label > Add link"
msgstr "Menu's > @menu_label > Link toevoegen"

msgid "Menus > @menu_label > Delete"
msgstr "Menu's > @menu_label > Wissen"

msgid "Menus > @menu_label > Devel"
msgstr "Menu's > @menu_label > Devel"

msgid "Display the search input as a menu item."
msgstr "De zoekinvoer als een menuoptie weergeven."

msgid "If set, instead of displaying a text input field, it displays a menu item in the toolbar so the user has to click on it to toggle the search input."
msgstr "Als dit is ingesteld, wordt in plaats van een invoerveld voor tekst een menu-item in de werkbalk afgebeeld, zodat de gebruiker er op moet klikken om de invoer van de zoekopdracht in of uit te schakelen."

