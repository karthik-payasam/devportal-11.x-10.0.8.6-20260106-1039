msgid "Schema.org: HowTo"
msgstr "Schema.org: HowTo"

msgid "RECOMMENDED BY GOOGLE. A description of the how-to."
msgstr "RECOMENDADO POR GOOGLE. Una descripción de cómo hacerlo."

msgid "RECOMMENDED BY GOOGLE. The estimated cost of the supplies consumed when performing instructions."
msgstr "RECOMENDADO POR GOOGLE. El coste estimado de los suministros consumidos al realizar instrucciones."

msgid "Globally unique id of the how to, usually a url."
msgstr "ID exclusivo global del procedimiento, normalmente un url."

msgid "RECOMMENDED BY GOOGLE. Image of the completed how-to."
msgstr "RECOMENDADO POR GOOGLE. Imagen de las instrucciones completadas."

msgid "REQUIRED BY GOOGLE. The title of the how-to. For example, 'How to tie a tie'."
msgstr "NECESARIO PARA GOOGLE. El título de las instrucciones. Por ejemplo, 'Cómo hacer el nudo de una corbata'."

msgid "REQUIRED BY GOOGLE. An array of HowToStep elements which comprise the full instructions of the how-to."
msgstr "NECESARIO PARA GOOGLE. Una matriz de elementos HowToStep que engloban las instrucciones completas sobre instrucciones de cómo hacerlo."

msgid "RECOMMENDED BY GOOGLE. A supply consumed when performing instructions or a direction."
msgstr "RECOMENDADO POR GOOGLE. Un suministro consumido cuando se realizan instrucciones o una dirección."

msgid "RECOMMENDED BY GOOGLE. An object used (but not consumed) when performing instructions or a direction."
msgstr "RECOMENDADO POR GOOGLE. Un objeto utilizado (pero no consumido) cuando se realizan instrucciones o una dirección."

msgid "REQUIRED. The type of page."
msgstr "OBLIGATORIO. El tipo de página."

msgid "The URL of the how-to."
msgstr "El URL del procedimiento."

