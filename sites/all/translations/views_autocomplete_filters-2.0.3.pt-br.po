msgid "Views Autocomplete Filters"
msgstr "Visualizações Filtros automática"

msgid "Use Autocomplete for string field filters."
msgstr "Use filtros automática para campos de sequência."

msgid "Views"
msgstr "Views"

msgid "Autocomplete for Combine fields filter"
msgstr "Conclusão automática para Combinar campos do filtro"

msgid "Exposed"
msgstr "Exposto"

msgid "Use Autocomplete"
msgstr "Usar conclusão automática"

msgid "Minimum number of characters to start filter"
msgstr "Número mínimo de caracteres para iniciar o filtro"

msgid "Maximum number of items in Autocomplete"
msgstr "Número máximo de itens em Conclusão automática"

msgid "Field with autocomplete results"
msgstr "Campo com resultados de conclusão automática"

msgid "Unformatted suggestion"
msgstr "Sugestão Formatado"

msgid "Unformatted dropdown"
msgstr "Formatado suspensa"

msgid "Suggestions depend on other filter fields"
msgstr "Sugestões dependem de outros campos de filtro"

msgid "Autocomplete for Search API fulltext search filter"
msgstr "Conclusão automática do filtro de procura de texto completo da API Search "

msgid "Autocomplete for Search API text field filter"
msgstr "Conclusão automática para o filtro de campo de texto da API Search "

msgid "Autocomplete for basic textfield filter"
msgstr "Conclusão de filtro de texto básico"

msgid "Field for autocomplete filter %label is not set in view %view, display %display"
msgstr "O campo para o filtro de conclusão automática %label não está configurado na visualização %view, exibição %display"

msgid "Field for autocomplete filter %label not exists in view %view, display %display"
msgstr "Os campo para o filtro de conclusão automática %label não existe na visualização %view, exibição %display"

msgid "Use Autocomplete for this filter."
msgstr "Usar conclusão automática para este filtro."

msgid "Enter 0 for no limit."
msgstr "Coloque 0 para não ter limite."

msgid "Autocomplete suggestions will be filtered by other filter fields"
msgstr "As sugestões de conclusão automática serão filtradas por outros campos de filtro "

msgid "The selected field will be used for drop-down results of the autocompletion. In most cases it should be the same field you use for the filter, and <em>must</em> be included in the field list for the view/display in order to appear here."
msgstr "O campo selecionado será usado para resultados suspensos da conclusão automática. Na maioria dos casos, ele deve ser o mesmo campo que você usa para o filtro e <em>deve</em> ser incluído na lista de campos para a visualização/exibição para aparecer aqui."

msgid "Use unformatted data from database for dropdown list instead of field formatter result. Value will be printed as plain text."
msgstr "Use dados não formatados do banco de dados para lista suspensa em vez de um resultado do formatador de campo. O valor será impresso como um texto sem formatação."

msgid "The same as above, but for suggestion (text appearing inside textfield when item is selected)."
msgstr "O mesmo que acima, mas para sugestão (o texto que aparece dentro do campo de texto quando o item é selecionado)."

msgid "Add some fields to view"
msgstr "Inclua alguns campos para visualizar"

