msgid "About"
msgstr "소개"

msgid "The modules provides a configurable block that display links (icons) to your profiles on various popular networking sites."
msgstr "모듈은 다양한 인기 있는 네트워킹 사이트에서 프로파일에 대한 링크(아이콘)를 표시하는 구성 가능한 블록을 제공합니다. "

msgid "Installation"
msgstr "설치"

msgid "Install as usual, see <a href=\":documentation\">installing contributed modules</a> for further information."
msgstr "평상시와 같이 설치하고, 추가 정보는 <a href=\":documentation\">분산 모듈 설치</a>를 참조하십시오. "

msgid "The module has no special configuration. All settings are available in the block settings: /admin/structure/block."
msgstr "모듈에 특수 구성이 없습니다. 모든 설정은 블록 설정에서 사용 가능합니다. /admin/structure/block."

msgid "Included icon sets"
msgstr "아이콘 세트를 포함함"

msgid "The module contains a icon set, that the module is ready for use immediately after the installation."
msgstr "모듈에는 모듈이 설치 후에 즉시 사용할 준비가 된 아이콘 세트가 포함됩니다. "

msgid "Social Media Links Block"
msgstr "소셜 미디어 링크 블록"

msgid "The module provides a block that display links (icons) to your profiles on various social networking sites."
msgstr "모듈은 다양한 소셜 네트워킹 사이트에서 프로파일에 대한 링크(아이콘)를 표시하는 블록을 제공합니다. "

msgid "Social Media Links Field"
msgstr "소셜 미디어 링크 필드"

msgid "The module provides a field type to capture social media profiles."
msgstr "모듈은 소셜 미디어 프로파일을 캡처하기 위해 필드 유형을 제공합니다. "

msgid "Platform"
msgstr "플랫폼"

msgid "Appearance"
msgstr "모양"

msgid "Orientation"
msgstr "방향"

msgid "vertical"
msgstr "세로"

msgid "horizontal"
msgstr "가로"

msgid "Show name"
msgstr "이름 표시"

msgid "Show the platform name next to the icon."
msgstr "아이콘 옆에 플랫폼 이름을 표시합니다. "

msgid "Link attributes"
msgstr "링크 속성"

msgid "Default target"
msgstr "기본값 대상"

msgid "Remove target attribute"
msgstr "대상 속성 제거"

msgid "Open in a new browser window or tab (_blank)"
msgstr "새 브라우저 창 또는 탭에서 열기(_blank)"

msgid "Open in the current window (_self)"
msgstr "현재 창에서 열기(_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "링크가 있는 프레임의 상위인 프레임에서 열기(_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "모든 프레임을 취소하고 전체 브라우저 창에서 열기(_top)"

msgid "Default rel"
msgstr "기본값 rel"

msgid "Remove rel attribute"
msgstr "rel 속성 제거"

msgid "Set nofollow"
msgstr "nofollow 설정"

msgid "Orientation: @orientation"
msgstr "방향: @orientation"

