msgstr "o"

msgid "Select file"
msgid_plural "Select files"
msgstr[0] "Seleziona file"
msgstr[1] "Seleziona file"

msgid "Dropzone library missing"
msgstr "Libreria Dropzone assente"

msgid ""
"Dropzonejs requires the dropzone.min.js library.\n"
"        Download it (https://github.com/enyo/dropzone) and place it in the\n"
"        libraries folder (/libraries)"
msgstr ""
"Dropzonejs richiede la libreria dropzone.min.js.\n"
"        Scaricarla (https://github.com/enyo/dropzone) ed inserirla nella\n"
"        cartella delle librerie (/libraries)"

msgid "dropzonejs"
msgstr "dropzonejs"

msgid "The Drupal integration for DropzoneJS."
msgstr "Integrazione Drupal per DropzoneJS."

msgid "Media"
msgstr "Media"

msgid "Dropzone upload files"
msgstr "File di caricamento di Dropzone"

msgid "Allow uploading of files via dropzonejs."
msgstr "Consenti il caricamento dei file via dropzonejs."

msgid "DropzoneJS settings"
msgstr "Impostazioni DropzoneJS"

msgid "Upload scheme"
msgstr "Carica schema"

msgid "Transliterate names of uploaded files"
msgstr "Trascrivere i nomi dei file caricati"

msgid "Upload timeout"
msgstr "Timeout caricamento "

msgid "Drop files here to upload"
msgstr "Rilasciare i file in questo punto per caricarli"

msgid "Your browser does not support drag'n'drop file uploads."
msgstr "Il browser non supporta i caricamenti di file mediante trascinamento e rilascio."

msgid "Please use the fallback form below to upload your files like in the olden days."
msgstr "Utilizzare il modulo di failback qui di seguito per caricare i file utilizzando il metodo classico."

msgid "File is too big ({{filesize}}MiB). Max filesize: {{maxFilesize}}MiB."
msgstr "Il file è troppo grande ({{filesize}}MiB). Dimensione file massima: {{maxFilesize}}MiB."

msgid "You can't upload files of this type."
msgstr "Non è possibile caricare i file di questo tipo."

msgid "Server responded with {{statusCode}} code."
msgstr "Il server ha risposto con il codice {{statusCode}}."

msgid "Cancel upload"
msgstr "Annulla caricamento"

msgid "Are you sure you want to cancel this upload?"
msgstr "Si è sicuri di voler annullare questo caricamento?"

msgid "Remove file"
msgstr "Rimuovi file"

msgid "You can not upload any more files."
msgstr "Non è possibile caricare ulteriori file."

msgid "TB"
msgstr "TB"

msgid "GB"
msgstr "GB"

msgid "MB"
msgstr "MB"

msgid "KB"
msgstr "KB"

msgid "b"
msgstr "b"

msgid "DropzoneJS entity browser widget"
msgstr "Widget del Browser entità DropzoneJS"

msgid "DropzoneJS Entity browser widget."
msgstr "Widget del Browser entità DropzoneJS."

msgid "DropzoneJS widget configuration"
msgstr "Configurazione del widget DropzoneJS"

msgid "Submit button text"
msgstr "Testo del bottone invia"

msgid "Automatically submit selection"
msgstr "Inoltra automaticamente la selezione"

msgid "Upload location"
msgstr "Carica ubicazione"

msgid "Dropzone drag-n-drop zone text"
msgstr "Testo dell'area di trascinamento e rilascio di Dropzone"

msgid "Maximum size of files"
msgstr "Dimensione massima dei file"

msgid "Allowed file extensions"
msgstr "Estensioni file consentite"

msgid "Use clientside resize"
msgstr "Utilizza il ridimensionamento lato client"

msgid "Maximum width"
msgstr "Larghezza massima"

msgid "Maximum height"
msgstr "Altezza massima"

msgid "Resize quality"
msgstr "Qualità del ridimensionamento"

msgid "Method used for resizing"
msgstr "Metodo di ridimensionamento utilizzato"

msgid "Method used for generating the thumbnail"
msgstr "Metodo utilizzato per generare la miniatura"

msgid "Media Entity DropzoneJS widget configuration"
msgstr "Configurazione del widget Media Entity DropzoneJS"

msgid "Media type"
msgstr "Tipo media"

msgid "Media Entity DropzoneJS with edit widget configuration"
msgstr "Media Entity DropzoneJS con configurazione del widget di modifica"

msgid "Form mode"
msgstr "Modalità form"

msgid "Drop files here to upload them"
msgstr "Rilasciare i file in questo punto per caricarli"

msgid "File upload"
msgstr "Caricamento file"

msgid "Files could not be uploaded because the destination directory %destination is not configured correctly."
msgstr "I file non possono essere caricati perché la directory di destinazione %destination non è configurata correttamente."

msgid "Some files that you are trying to upload did not pass validation. Requirements are: max file %size, allowed extensions are %extensions"
msgstr "Alcuni file che si sta tentando di caricare non hanno superato la convalida. I requisiti sono: dimensione massima dei file %size, le estensioni consentite sono %extensions"

msgid "At least one valid file should be uploaded."
msgstr "È necessario caricare almeno un file valido."

msgid "A space separated list of file extensions"
msgstr "Un elenco di estensioni file, separate da spazi"

msgid "Use client side resizing"
msgstr "Utilizza il ridimensionamento lato client"

msgid "Requires droopzone version v4.4.0 or higher and the <a href=\"@exif\" target=\"_blank\">exif</a> library."
msgstr "Richiede droopzone versione v4.4.0 o successive e la libreria <a href=\"@exif\" target=\"_blank\"></a>."

msgid "Max width"
msgstr "Larghezza massima"

msgid "Max height"
msgstr "Altezza massima"

msgid "Resize method"
msgstr "Metodo di ridimensionamento"

msgid "Contain (scale)"
msgstr "Contiene (scala)"

msgid "Crop"
msgstr "Ritaglia"

msgid "Thumbnail method"
msgstr "Metodo miniatura"

msgid "Invalid extension list format."
msgstr "Formato elenco estensioni non valido."

msgid "Adds DropzoneJS upload integration."
msgstr "Aggiunge l'integrazione del caricamento DropzoneJS."

msgid "Missing requirement: in order to use this widget you have to install Inline entity form module first"
msgstr "Requisiti mancanti: per utilizzare questo widget è necessario installare innanzitutto il modulo del form dell'Entità in linea"

msgid "Edit"
msgstr "Modifica"

msgid "Media Entity DropzoneJS with edit"
msgstr "Media Entity DropzoneJS con modifica"

msgid "Adds DropzoneJS upload integration that saves Media entities and allows to edit them."
msgstr "Aggiunge l'integrazione del caricamento DropzoneJS che salva le Entità media e consente di modificarle."

msgid "The type of media entity to create from the uploaded file(s)."
msgstr "Il tipo di entità media da cui creare i file caricati."

msgid "You must @create_media_type before using this widget."
msgstr "È necessario @create_media_type prima di utilizzare questo widget."

msgid "create a media type"
msgstr "crea un tipo di supporto"

msgid "Media Entity DropzoneJS"
msgstr "Media Entity DropzoneJS"

msgid "Adds DropzoneJS upload integration that saves Media entities."
msgstr "Aggiunge l'integrazione del caricamento DropzoneJS che salva le Entità media."

msgid "For security reasons, your upload has been renamed to %filename."
msgstr "Per ragioni di  sicurezza il file che hai caricato è stato rinominato in %filename."

msgid "The specified file %name could not be uploaded."
msgstr "Il file specificato %name non può essere caricato."

msgid "The file could not be uploaded because the destination %destination is invalid."
msgstr "Il file non può essere caricato perché la destinazione  %destination non è valida."

msgid "File upload error. Could not move uploaded file."
msgstr "Errore durante il caricamento. Impossibile spostare il file caricato."

msgid "Upload error. Could not move uploaded file %file to destination %destination."
msgstr "Errore di caricamento. Impossibile spostare il file %file nella destinazione %destination."

msgid "The file could not be saved because it exceeds the maximum allowed size for uploads."
msgstr "Il file non può essere salvato perché eccede la dimensione massima consentita per gli upload."

msgid "The file could not be saved because the upload did not complete."
msgstr "Il file non può essere salvato perché il caricamento non è stato completato."

msgid "The file could not be saved. An unknown error has occurred."
msgstr "Non è possibile salvare il file. Si è verificato un errore sconosciuto."

msgid "There was a problem while processing the file named @name"
msgstr "Si è verificato un problema durante l'elaborazione del file denominato @name"

msgid "You don't have sufficent permissions to use the DropzoneJS uploader. Contact your system administrator"
msgstr "Non si dispone delle autorizzazioni necessarie per utilizzare il programma di caricamento di DropzoneJS. Contattare l'amministratore di sistema"

msgid "A maximum of @count files can be uploaded."
msgstr "È possibile caricare un massimo di @count files."

msgid "Drop file here to upload it"
msgid_plural "Drop files here to upload them"
msgstr[0] "Rilasciare il file qui per caricarlo"
msgstr[1] "Rilasciare i file in questo punto per caricarli"

