msgid "Chaos Tools Views"
msgstr "Vistas de herramientas de Chaos"

msgid "A set of improvements to the core Views code that allows for greater control over Blocks."
msgstr "Conjunto de mejoras en el código central de Vistas que ofrece un mayor control sobre los bloques."

msgid "Chaos tool suite (Experimental)"
msgstr "Suite de herramientas de Chaos (experimental)"

msgid "Items per page"
msgstr "Elementos por página"

msgid "Pager offset"
msgstr "Desplazamiento del paginador"

msgid "Pager type"
msgstr "Tipo de paginador"

msgid "Hide fields"
msgstr "Ocultar campos"

msgid "Reorder fields"
msgstr "Reordenar campos"

msgid "Configure filters"
msgstr "Configurar filtros"

msgid "Disable filters"
msgstr "Desactivar filtros"

msgid "Configure sorts"
msgstr "Configurar clasificaciones"

msgid "Allow settings"
msgstr "Permitir ajustes"

msgid "None"
msgstr "Ninguno"

msgid "For example, set this to 3 and the first 3 items will not be displayed."
msgstr "Por ejemplo, ponga 3 y los 3 primero elementos no serán mostrados."

msgid "Inherit from view"
msgstr "Heredar de vista"

msgid "Display a specified number of items"
msgstr "Mostrar un número específico de elementos"

msgid "Display all items"
msgstr "Mostrar todos los elementos"

msgid "Pager"
msgstr "Paginador"

msgid "Hide"
msgstr "Ocultar"

msgid "Label"
msgstr "Etiqueta"

msgid "Weight"
msgstr "Peso"

msgid "Weight for @title"
msgstr "Peso para @title"

msgid "Exposed filter values"
msgstr "Valores de filtro expuestos"

msgid "If a value is set for an exposed filter, it will be removed from the block display."
msgstr "Si se establece un valor para un filtro expuesto, se eliminará de la visualización de bloque."

msgid "Expose filter value to user"
msgstr "Exponer valor de filtro al usuario"

msgid "Expose this filter value to visitors? If so, the value set here will be the default."
msgstr "¿Exponer este valor de filtro a los visitantes? Si es así, el valor establecido aquí será el valor predeterminado."

msgid "Expose filter operator to user"
msgstr "Exponer operador de filtro al usuario"

msgid "Expose this filter's operator to visitors? If so, the operator set here will be the default."
msgstr "¿Desea exponer el operador de este filtro a los visitantes? Si es así, el operador establecido aquí será el valor predeterminado."

msgid "Disable filter: @handler"
msgstr "Inhabilitar filtro: @handler"

msgid "Sort ascending"
msgstr "Ordenar ascendente"

msgid "Sort descending"
msgstr "Ordenar descendente"

msgid "Order"
msgstr "Orden"

