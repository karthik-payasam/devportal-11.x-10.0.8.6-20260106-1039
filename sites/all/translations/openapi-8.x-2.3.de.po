msgid "OpenAPI"
msgstr "OpenAPI"

msgid "Connects Drupal to the OpenAPI Javascript Library"
msgstr "Verbindet Drupal mit der OpenAPI-Javascript-Bibliothek"

msgid "Available OpenAPI Documentation."
msgstr "Verfügbare OpenAPI-Dokumentation."

msgid "Access API Docs"
msgstr "Auf API-Dokumentation zugreifen"

msgid "Access documentation page for the REST API"
msgstr "Auf Dokumentation der REST--API zugreifen"

msgid "OpenAPI Schema Download"
msgstr "OpenAPI-Schema herunterladen"

msgid "OpenAPI Resources"
msgstr "OpenAPI-Ressourcen"

msgid "OpenAPI Documentation"
msgstr "OpenAPI-Dokumentation"

msgid "%label OpenApi Schema Download"
msgstr "%label OpenApi-Schema herunterladen"

msgid "The specifications provide the documentation on some of Drupal's apis following <a href=':openapi_spec'>OpenAPI (aka Swagger)</a> standards."
msgstr "Die Spezifikationen enthalten die Dokumentation einiger Drupal's apis nach <a href=':openapi_spec'>OpenAPI (aka Swagger)</a> Standards."

msgid "These json files can be used in tools such as the <a href=\":swagger_editor\">Swagger Editor</a> to provide a more detailed version of the API documentation or <a href=\":swagger_codegen\">Swagger Codegen</a> to create an api client."
msgstr "Diese Json-Dateien können in Tools wie dem <a href=\":swagger_editor\">Swagger Editor</a> verwendet werden, um eine detailliertere Version der API-Dokumentation bereitzustellen, oder <a href=\":swagger_codegen\">Swagger Codegen</a>, um einen api-Client zu erstellen."

msgid "Module"
msgstr "Modul"

msgid "Specification"
msgstr "Spezifikation"

msgid "Explore"
msgstr "Entdecken"

msgid "Please visit the <a href=':openapi_ui_link'>OpenAPI UI module</a> for information on these interfaces and to discover others."
msgstr "Bitte besuchen Sie das <a href=':openapi_ui_link'>OpenAPI UI module</a> für Informationen über diese Schnittstellen und um weitere zu entdecken."

msgid "No UI plugins available"
msgstr "Keine Plugins für die Benutzeroberfläche verfügbar"

msgid "There are no plugins available for exploring the OpenAPI documentation."
msgstr "Es sind keine Plugins zum Durchsuchen der OpenAPI-Dokumentation verfügbar."

msgid "You can install one of the below projects to view the API Specifications from with your site."
msgstr "Sie können eines der unten aufgeführten Projekte installieren, um die API-Spezifikationen von Ihrer Website aus anzuzeigen."

msgid "View/Download"
msgstr "Anzeigen/heruterladen"

msgid "Explore with %interface"
msgstr "mit %interface durchsuchen"

msgid "No UI available."
msgstr "Keine Benutzeroberfläche verfügbar."

msgid "No OpenApi generator plugins are currently available."
msgstr "Derzeit sind keine OpenApi-Generator-Plugins verfügbar."

msgid "You must enable a REST or API module which supports OpenApi Downloads, such as the <a href=\":rest_link\">Core Rest</a> and <a href=\":jsonapi_link\">JSON:API</a> modules."
msgstr "Sie müssen ein REST- oder API-Modul aktivieren, das OpenApi-Downloads unterstützt, wie z. B. die Module <a href=\":rest_link\">Core Rest</a> und <a href=\":jsonapi_link\">JSON:API</a>."

msgid "%generator OpenApi Documentation"
msgstr "%generator OpenApi-Dokumentation"

