msgstr "Het X-coördinaat van de bijsnijding."

msgid "Y coordinate"
msgstr "Y-coördinaat"

msgid "The crop's Y coordinate."
msgstr "Het Y-coördinaat van de bijsnijding."

msgid "Revision timestamp"
msgstr "Revisietijdstip"

msgid "The time that the current revision was created."
msgstr "Het tijdstip waarop de huidige revisie is aangemaakt."

msgid "Revision author ID"
msgstr "Auteurs-ID revisie"

msgid "The user ID of the author of the current revision."
msgstr "Gebruikers ID van de auteur van de huidige versie."

msgid "Revision Log"
msgstr "Revisielog"

msgid "The log entry explaining the changes in this revision."
msgstr "Het log-item waar de wijzigingen in deze revisie worden uitgelegd."

msgid "Crop"
msgstr "Bijsnijden"

msgid "Are you sure you want to delete the crop type %type?"
msgstr "Weet u zeker dat u het bijsnijdtype %type wilt wissen?"

msgid "The crop type %name has been deleted."
msgstr "Het bijsnijdtype %name is verwijderd."

msgid "Deleted crop type %name."
msgstr "Het bijsnijdtype %name is gewist."

msgid "%type is used by 1 piece of content on your site. You can not remove this content type until you have removed all of the %type content."
msgid_plural "%type is used by @count pieces of content on your site. You may not remove %type until you have removed all of the %type content."
msgstr[0] "%type wordt gebruikt door 1 stuks inhoud in de website. U kunt dit inhoudstype niet verwijderen totdat alle inhoud van %type is verwijderd."
msgstr[1] "%type wordt gebruikt door @count stukken inhoud in de website. U kunt dit inhoudstype niet verwijderen totdat alle inhoud van %type is verwijderd."

msgid "Edit %label crop type"
msgstr "Bijsnijdtype %label bewerken"

msgid "The human-readable name of this crop type. This name must be unique."
msgstr "De voor mensen begrijpelijke naam van het bijsnijdtype. De naam moet uniek zijn."

msgid "A unique machine-readable name for this crop type. It must only contain lowercase letters, numbers, and underscores."
msgstr "Een unieke machinenaam voor dit type bijsnijding. Mag uitsluitend bestaan uit kleine letters, cijfers en liggende streepjes."

msgid "Describe this crop type."
msgstr "Beschrijf dit type bijsnijding."

msgid "Set an aspect ratio <b>eg: 16:9</b> or leave this empty for arbitrary aspect ratio"
msgstr "Stel een breedte-hoogteverhouding in, <b>bijvoorbeeld 16:9</b>, of laat dit veld leeg voor willekeurige breedte-hoogteverhoudingen."

msgid "Soft limit"
msgstr "Zachte limiet"

msgid "Define crop size soft limit. Warning will be displayed if crop smaller than that is selected."
msgstr "Definieer een dynamische limiet voor bijsnijden. Er wordt een waarschuwing afgebeeld als de bijsnijding kleiner is dan de geselecteerde waarde."

msgid "Limit for width."
msgstr "Limiet voor breedte."

msgid "Limit for height."
msgstr "Limiet voor hoogte."

msgid "Hard limit"
msgstr "Harde limiet"

msgid "Define crop size hard limit. User is not allowed to make a smaller selection than defined here."
msgstr "Definieer een vaste limiet voor bijsnijden. Het is de gebruiker niet toegestaan een kleinere selectie te maken dan hier is gedefinieerd."

msgid "Limit for width"
msgstr "Limiet voor breedte"

msgid "Save crop type"
msgstr "Bijsnijdtype opslaan"

msgid "Delete crop type"
msgstr "Bijsnijdtype wissen"

msgid "The crop type %name has been updated."
msgstr "Het bijsnijdtype %name is bijgewerkt."

msgid "The crop type %name has been added."
msgstr "Het bijsnijdtype %name is toegevoegd."

msgid "View"
msgstr "Weergeven"

msgid "Added crop type %name."
msgstr "Bijsnijdtype %name toegevoegd."

msgid "File"
msgstr "Bestand"

msgid "Provides crop integration for core files."
msgstr "Biedt integratie van bijsnijdfunctie voor kernbestanden."

msgid "Provides crop integration for media."
msgstr "Verzorgt crop-integratie voor media."

msgid "Crop type to be used for the image style."
msgstr "Bijsnijdtype dat moet worden gebruikt voor afbeeldingsstijl."

msgid "- Select a Provider -"
msgstr "- Selecteer een provider -"

msgid "The name of automatic crop provider to use if crop is not set for an image."
msgstr "De naam van de automatische gewasprovider die moet worden gebruikt als het gewas niet is ingesteld voor een afbeelding."

msgid "Manual image crop failed due to misconfigured crop type on %path."
msgstr "Handmatig bijsnijden van afbeelding is mislukt als gevolg van onjuist geconfigureerd bijsnijdtype in %path."

msgid "Manual image crop failed using the %toolkit toolkit on %path (%mimetype, %width x %height)"
msgstr "Handmatig bijsnijden van afbeelding met behulp van toolkit %toolkit in %path (%mimetype, %width x %height) is mislukt."

msgid "Manual crop"
msgstr "Handmatig bijsnijden"

msgid "Applies manually provided crop to the image."
msgstr "Past de handmatig opgegeven bijsnijding toe op de afbeelding."

msgctxt "Validation"
msgid "Crop Type aspect ratio"
msgstr "Breedte-hoogteverhouding bijsnijdtype"

msgid "Invalid aspect ratio format. Should be defined in H:W form."
msgstr "Ongeldige notatie van breedte-hoogteverhouding. Moet worden gedefinieerd in de notatie U:W."

