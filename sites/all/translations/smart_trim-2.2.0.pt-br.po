msgid "About"
msgstr "Sobre"

msgid "Smart Trim implements a new field formatter for text fields (text, text_long, and text_with_summary, if you want to get technical) that improves upon the \"Summary or Trimmed\" formatter."
msgstr "O Smart Trim implementa um novo formatador de campo para campos de texto (texto, text_long e text_with_summary, para citar termos técnicos) que melhora o formatador \"Summary or Trimmed\"."

msgid "More"
msgstr "Mais"

msgid "Read more about [node:title]"
msgstr "Leia mais sobre [node:title]"

msgid "Smart Trim"
msgstr "Trim Inteligente"

msgid "Provides a more robust alternative to \"summary or trimmed\" textfield format"
msgstr "Fornece uma alternativa mais robusta ao formato de campo de texto \"summary or trimmed\""

msgid "Fields"
msgstr "Campos"

msgid "Smart trim formatter settings"
msgstr "Configurações do Formatador do Smart Trim"

msgid "Trim length"
msgstr "Tamanho do corte"

msgid "Trim units"
msgstr "Atrim unidades"

msgid "Suffix"
msgstr "Sufixo"

msgid "Wrap trimmed content"
msgstr "Agrupar conteúdo aparado"

msgid "Wrapped content class"
msgstr "Classe de conteúdo em Wrapped"

msgid "More link configuration"
msgstr "Configuração do link Mais"

msgid "Display more link"
msgstr "Exibir mais link"

msgid "Open link in new window"
msgstr "Abrir link em uma nova janela"

msgid "More link only when content is trimmed"
msgstr "Link Mais apenas quando o conteúdo é cortado"

msgid "More link class"
msgstr "Mais classe de link"

msgid "More link text"
msgstr "Texto do \"Leia mais\""

msgid "More link aria-label value"
msgstr "Valor do aria-label de mais links"

msgid "Summary handler"
msgstr "Manipulador de"

msgid "Additional options"
msgstr "Opções Adicionais"

msgid "Strip HTML"
msgstr "Remover HTML"

msgid "Honor a zero trim length"
msgstr "Honra um comprimento de corte zero"

msgid "Replace tokens before trimming"
msgstr "Substituir tokens antes do corte"

msgid "Characters"
msgstr "Caracteres"

msgid "Words"
msgstr "Palavras"

msgid "Summary"
msgstr "Resumo"

msgid "Use summary if present, and do not trim"
msgstr "Usar o resumo se estiver presente e não aparar"

msgid "Use summary if present, honor trim settings"
msgstr "Usar o resumo se estiver presente, honrar configurações de corte"

msgid "Do not use summary"
msgstr "Não usar resumo"

msgid "Wrap trimmed content?"
msgstr "Agrupar conteúdo aparado?"

msgid "Adds a wrapper div to trimmed content. This option is deprecated and will be removed in Smart Trim 3.0.0. Please override the smart-trim.html.twig template file to customize output."
msgstr "Inclui um div do wrapper para o conteúdo aparado. Essa opção foi descontinuada e será removida no Smart Trim 3.0.0. Substitua o arquivo de modelo smart-trim.html.twig para customizar a saída."

msgid "Wrapped content class."
msgstr "Classe de conteúdo em Wrapped."

msgid "If wrapping, define the class name here."
msgstr "Ao agrupar, defina o nome da classe aqui."

msgid "<em>More</em> link"
msgstr "Link <em>Mais</em>"

msgid "Display <em>More</em> link?"
msgstr "Exibir o link <em>Mais</em>?"

msgid "Displays a link to the entity (if one exists)"
msgstr "Exibe um link para a entidade (se existir)"

msgid "Display <em>More</em> link only when content is trimmed?"
msgstr "Exibir o link <em>Mais</em> apenas quando o conteúdo for cortado?"

msgid "Only display <em>More</em> link if content is actually trimmed."
msgstr "Exiba o link <em>Mais</em> apenas se o conteúdo for realmente cortado."

msgid "Open <em>More</em> link in new window"
msgstr "Abrir o link <em>Mais</em> na nova janela"

msgid "<em>More</em> link text"
msgstr "Texto do link <em>Mais</em>"

msgid "If displaying <em>More</em> link, enter the text for the link. This field supports tokens."
msgstr "Se estiver exibindo o link <em>Mais</em>, insira o texto para o link. Este campo suporta tokens."

msgid "<em>More</em> link aria-label"
msgstr "aria-label do link <em>Mais</em>"

msgid "If displaying <em>More</em> link, provide additional context for screen-reader users. In most cases, the aria-label value will be announced instead of the link text. This field supports tokens."
msgstr "Se estiver exibindo o link <em>Mais</em>, forneça contexto adicional para usuários do leitor de tela. Na maioria dos casos, o valor do aria-label será anunciado em vez do texto do link. Este campo suporta tokens."

msgid "<em>More</em> link class"
msgstr "Classe do link <em>Mais</em>"

msgid "If displaying <em>More</em> link, add a custom class for formatting."
msgstr "Se estiver exibindo o link <em>Mais</em>, inclua uma classe customizada para formatação."

msgid "words"
msgstr "palavras"

msgid "characters"
msgstr "caracteres"

msgid "Suffix: %suffix"
msgstr "Sufixo: %suffix"

msgid "<em>More</em> link enabled, text: %text"
msgstr "Link <em>Mais</em> ativado, texto: %text"

msgid "Only display <em>More</em> link when trimmed"
msgstr "Exibir o link <em>Mais</em> apenas quando cortado"

msgid "<em>More</em> link aria-label: %label"
msgstr "aria-label do link <em>Mais</em>: %label"

msgid "<em>More</em> link class: %class"
msgstr "Classe do link <em>Mais</em>: %class"

msgid "Smart trimmed"
msgstr "Smart aparado"

