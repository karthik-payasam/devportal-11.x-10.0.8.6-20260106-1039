msgid "About"
msgstr "O stronie"

msgid "DropzoneJS"
msgstr "DropzoneJS"

msgid "or"
msgstr "lub"

msgid "Select file"
msgid_plural "Select files"
msgstr[0] "Wybierz plik"
msgstr[1] "Wybierz pliki"
msgstr[2] "Wybierz pliki"

msgid "Dropzone library missing"
msgstr "Brak biblioteki Dropzone"

msgid ""
"Dropzonejs requires the dropzone.min.js library.\n"
"        Download it (https://github.com/enyo/dropzone) and place it in the\n"
"        libraries folder (/libraries)"
msgstr ""
"Biblioteka DropzoneJS wymaga biblioteki dropzone.min.js\n"
"         Pobierz ją (https://github.com/enyo/dropzone) i umieść w\n"
"        folderze bibliotek (/libraries)."

msgid "dropzonejs"
msgstr "DropzoneJS"

msgid "The Drupal integration for DropzoneJS."
msgstr "Integracja z Drupal dla DropzoneJS."

msgid "Media"
msgstr "Media"

msgid "Dropzone upload files"
msgstr "Przesyłanie plików przy użyciu biblioteki DropzoneJS"

msgid "Allow uploading of files via dropzonejs."
msgstr "Zezwól na przesyłanie plików przy użyciu biblioteki DropzoneJS."

msgid "DropzoneJS settings"
msgstr "Ustawienia biblioteki DropzoneJS"

msgid "Upload scheme"
msgstr "Schemat przesyłania"

msgid "Transliterate names of uploaded files"
msgstr "Transliteruj nazwy przesłanych plików"

msgid "Upload timeout"
msgstr "Limit czasu przesyłania"

msgid "Drop files here to upload"
msgstr "Aby przesłać pliki, upuść je tutaj"

msgid "Your browser does not support drag'n'drop file uploads."
msgstr "Przeglądarka nie obsługuje przesyłania plików poprzez przeciąganie i upuszczanie."

msgid "Please use the fallback form below to upload your files like in the olden days."
msgstr "Użyj poniższego formularza rezerwowego, aby przesłać pliki w tradycyjny sposób."

msgid "File is too big ({{filesize}}MiB). Max filesize: {{maxFilesize}}MiB."
msgstr "Plik jest zbyt duży ({{filesize}}MB). Maksymalna wielkość pliku: {{maxFilesize}}MB."

msgid "You can't upload files of this type."
msgstr "Nie można przesyłać plików tego typu."

msgid "Server responded with {{statusCode}} code."
msgstr "Serwer odpowiedział kodem {{statusCode}}."

msgid "Cancel upload"
msgstr "Anuluj przesyłanie"

msgid "Are you sure you want to cancel this upload?"
msgstr "Czy na pewno chcesz anulować to przesyłanie?"

msgid "Remove file"
msgstr "Usuń plik"

msgid "You can not upload any more files."
msgstr "Nie można przesłać więcej plików."

msgid "TB"
msgstr "TB"

msgid "GB"
msgstr "Wielka Brytania"

msgid "MB"
msgstr "MB"

msgid "KB"
msgstr "KB"

msgid "b"
msgstr "b"

msgid "DropzoneJS entity browser widget"
msgstr "Widget przeglądarki jednostek DropzoneJS"

msgid "DropzoneJS Entity browser widget."
msgstr "Widget przeglądarki jednostek DropzoneJS."

msgid "DropzoneJS widget configuration"
msgstr "Konfiguracja widgetu DropzoneJS"

msgid "Submit button text"
msgstr "Tekst na przycisku zatwierdzającym formularz"

msgid "Automatically submit selection"
msgstr "Automatycznie wysyłaj wybór"

msgid "Upload location"
msgstr "Miejsce przesyłania"

msgid "Dropzone drag-n-drop zone text"
msgstr "Tekst w strefie przeciągania i upuszczania Dropzone"

msgid "Maximum size of files"
msgstr "Maksymalna wielkość plików"

msgid "Allowed file extensions"
msgstr "Dozwolone rozszerzenia pliku"

msgid "Use clientside resize"
msgstr "Użyj zmiany wielkości po stronie klienta"

msgid "Maximum width"
msgstr "Maksymalna szerokość"

msgid "Maximum height"
msgstr "Maksymalna wysokość"

msgid "Resize quality"
msgstr "Jakość zmiany wielkości"

msgid "Method used for resizing"
msgstr "Metoda zmiany wielkości"

msgid "Method used for generating the thumbnail"
msgstr "Metoda generowania miniatury"

msgid "Media Entity DropzoneJS widget configuration"
msgstr "Konfiguracja widgetu DropzoneJS modułu Media Entity"

msgid "Media type"
msgstr "Typ mediów"

msgid "Media Entity DropzoneJS with edit widget configuration"
msgstr "Widget DropzoneJS modułu Media Entity z konfiguracją widgetu edycji"

msgid "Form mode"
msgstr "Tryb formularza"

msgid "Drop files here to upload them"
msgstr "Aby przesłać pliki, upuść je tutaj"

msgid "File upload"
msgstr "Przesyłanie plików"

msgid "Files could not be uploaded because the destination directory %destination is not configured correctly."
msgstr "Nie można przesłać plików, ponieważ katalog docelowy %destination nie jest poprawnie skonfigurowany."

msgid "Some files that you are trying to upload did not pass validation. Requirements are: max file %size, allowed extensions are %extensions"
msgstr "Niektóre pliki, które próbujesz przesłać, nie przeszły procedury sprawdzania poprawności. Wymagania: maksymalna wielkość to %size, dozwolone rozszerzenia to %extensions. "

msgid "At least one valid file should be uploaded."
msgstr "Powinien zostać przesłany co najmniej jeden poprawny plik."

msgid "A space separated list of file extensions"
msgstr "Rozdzielana spacjami lista rozszerzeń nazw plików"

msgid "Use client side resizing"
msgstr "Użyj zmiany wielkości po stronie klienta"

msgid "Requires droopzone version v4.4.0 or higher and the <a href=\"@exif\" target=\"_blank\">exif</a> library."
msgstr "Wymaga biblioteki dropzone 4.4.0 lub nowszej i biblioteki <a href=\"@exif\" target=\"_blank\">exif</a>."

msgid "Max width"
msgstr "Maks. szerokość"

msgid "Max height"
msgstr "Maksymalna wysokość"

msgid "Resize method"
msgstr "Metoda zmiany wielkości"

msgid "Contain (scale)"
msgstr "Zawiera (skala)"

msgid "Crop"
msgstr "Przytnij"

msgid "Thumbnail method"
msgstr "Metoda generowania miniatury"

msgid "Invalid extension list format."
msgstr "Niepoprawny format listy rozszerzeń."

msgid "Adds DropzoneJS upload integration."
msgstr "Dodaje integrację możliwości przesyłania przy użyciu biblioteki DropzoneJS."

msgid "Missing requirement: in order to use this widget you have to install Inline entity form module first"
msgstr "Nie spełniono wymagania: aby można było używać tego widgetu, należy wcześniej zainstalować moduł Inline Entity Form."

msgid "Edit"
msgstr "Edytuj"

msgid "Media Entity DropzoneJS with edit"
msgstr "Widget DropzoneJS modułu Media Entity z funkcją edycji"

msgid "Adds DropzoneJS upload integration that saves Media entities and allows to edit them."
msgstr "Dodaje integrację możliwości przesyłania przy użyciu biblioteki DropzoneJS, dzięki której można zapisywać jednostki multimedialne i je edytować."

msgid "The type of media entity to create from the uploaded file(s)."
msgstr "Typ jednostki multimedialnej, który ma zostać utworzony na podstawie przesłanych plików."

msgid "You must @create_media_type before using this widget."
msgstr "Zanim będzie można używać tego widgetu, @create_media_type."

msgid "create a media type"
msgstr "utwórz typ multimediów"

msgid "Media Entity DropzoneJS"
msgstr "Widget DropzoneJS modułu Media Entity"

msgid "Adds DropzoneJS upload integration that saves Media entities."
msgstr "Dodaje integrację możliwości przesyłania przy użyciu biblioteki DropzoneJS, która umożliwia zapisywanie jednostek multimedialnych."

msgid "For security reasons, your upload has been renamed to %filename."
msgstr "Ze względów bezpieczeństwa nazwę wysłanego pliku zmieniono na %filename."

msgid "The specified file %name could not be uploaded."
msgstr "Nie udało się wysłać pliku %name."

msgid "The file could not be uploaded because the destination %destination is invalid."
msgstr "Plik nie mógł być wysłany ponieważ docelowa lokalizacja %destination jest nieprawidłowa."

msgid "File upload error. Could not move uploaded file."
msgstr "Błąd wysyłania pliku. Nie udało się przenieść wysłanego pliku."

msgid "Upload error. Could not move uploaded file %file to destination %destination."
msgstr "Błąd w trakcie wysyłania. Próba przeniesienia pliku %file do katalogu docelowego %destination nie powiodła się."

msgid "The file could not be saved because it exceeds the maximum allowed size for uploads."
msgstr "Nie można zapisać pliku, ponieważ jego wielkość przekracza maksymalny limit obowiązujący w przypadku operacji przesyłania."

msgid "The file could not be saved because the upload did not complete."
msgstr "Nie można zapisać pliku, ponieważ przesyłanie nie zostało zakończone."

msgid "The file could not be saved. An unknown error has occurred."
msgstr "Nie można zapisać pliku. Wystąpił nieznany błąd."

msgid "There was a problem while processing the file named @name"
msgstr "Wystąpił problem podczas przetwarzania pliku o nazwie @name"

msgid "You don't have sufficent permissions to use the DropzoneJS uploader. Contact your system administrator"
msgstr "Nie masz wystarczających uprawnień do używania funkcji przesyłania DropzoneJS. Skontaktuj się z administratorem systemu."

msgid "A maximum of @count files can be uploaded."
msgstr "Maksymalna liczba plików, którą można wysłać: @count."

msgid "Drop file here to upload it"
msgid_plural "Drop files here to upload them"
msgstr[0] "Upuść plik w tym miejscu, aby go przesłać"
msgstr[1] "Aby przesłać pliki, upuść je tutaj"
msgstr[2] "Aby przesłać pliki, upuść je tutaj"

