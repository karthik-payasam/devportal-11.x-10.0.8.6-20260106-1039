msgid "Social Media Links Field"
msgstr "Sosyal Medya Bağlantıları Alanı"

msgid "The module provides a field type to capture social media profiles."
msgstr "Modül, sosyal medya profillerini almak için bir alan tipi sağlar."

msgid "Platform"
msgstr "Platform"

msgid "Appearance"
msgstr "Görünüm"

msgid "Orientation"
msgstr "Yön"

msgid "vertical"
msgstr "dikey"

msgid "horizontal"
msgstr "yatay"

msgid "Show name"
msgstr "Adı göster"

msgid "Show the platform name next to the icon."
msgstr "Simgenin yanında platform adını gösterin."

msgid "Link attributes"
msgstr "Bağlantı öznitelikleri"

msgid "Default target"
msgstr "Varsayılan hedef"

msgid "Remove target attribute"
msgstr "Hedef özniteliği kaldır"

msgid "Open in a new browser window or tab (_blank)"
msgstr "Yeni bir tarayıcı penceresinde ya da sekmede aç (_blank)"

msgid "Open in the current window (_self)"
msgstr "Geçerli pencerede aç (_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "Bağlantının bulunduğu çerçeveden üstün çerçevede aç (_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "Tüm çerçeveleri iptal et ve tam tarayıcı penceresinde aç (_top)"

msgid "Default rel"
msgstr "Varsayılan ilişki"

msgid "Remove rel attribute"
msgstr "İlişki özniteliğini kaldır"

msgid "Set nofollow"
msgstr "nofollow ayarla"

msgid "Orientation: @orientation"
msgstr "Yön: @orientation"

msgid "Yes"
msgstr "Evet"

msgid "No"
msgstr "Hayır"

msgid "Show name: @show_name"
msgstr "Adı göster: @show_name"

msgid "Default"
msgstr "Varsayılan"

msgid "Value"
msgstr "Değer"

msgid "Platform Values"
msgstr "Platform Değerleri"

msgid "Icon Style"
msgstr "Simge Stili"

msgid "Description"
msgstr "Açıklama"

msgid "Weight"
msgstr "Ağırlık"

msgid "Platforms"
msgstr "Platformlar"

msgid "The platforms that are allowed to be used in this field. Select none to allow all platforms."
msgstr "Bu alanda kullanılmasına izin verilen platformlar. Tüm platformlara izin vermek için yok (none) seçeneğini belirleyin."

msgid "The description is used for the title and WAI-ARIA attribute."
msgstr "Açıklama başlık ve WAI-ARIA özniteliği için kullanılır."

msgid "Find / Follow us on %platform"
msgstr "Bizi %platform üzerinde bulun / takip edin"

msgid "Weight for type @type"
msgstr "@type tipi için ağırlık"

msgid "Handle links to social media profiles."
msgstr "Sosyal medya profilleriyle bağlantıları işleyin."

msgid "List with all available platforms"
msgstr "Tüm kullanılabilir platformlarla listele"

msgid "One available platform (selectable)"
msgstr "Kullanılabilir tek platform (seçilebilir)"

