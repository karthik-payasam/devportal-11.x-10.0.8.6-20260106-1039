msgstr "Удалить"

msgid "The @label password policy has been deleted."
msgstr "Стратегия управления паролями @label удалена."

msgid "Policy Name"
msgstr "Имя стратегии"

msgid "Password Reset Days"
msgstr "Дни сброса пароля"

