msgid "Policy"
msgstr "Политика"

msgid "Status"
msgstr "Статус"

msgid "Constraint"
msgstr "Ограничение"

msgid "There are no constraints for the selected user roles"
msgstr "Для выбранных ролей пользователей отсутствуют ограничения"

msgid "The password does not satisfy the password policies."
msgstr "Пароль не удовлетворяет требованиям стратегий управления паролями."

msgid "Password Policy"
msgstr "Стратегия управления паролями"

msgid "Sets up constraints and expiration of passwords."
msgstr "Устанавливает ограничения и срок действия паролей."

msgid "Security"
msgstr "Безопасность"

msgid "Add Policy"
msgstr "Добавить стратегию"

msgid "Configuring security settings."
msgstr "Настройка параметров защиты."

msgid "Create password policies."
msgstr "Создать стратегии управления паролями."

msgid "Manage password reset"
msgstr "Управление сбросом пароля"

msgid "Be able to manually override user password reset dates."
msgstr "Можно вручную переопределить даты сброса паролей пользователей."

msgid "Force Password Reset"
msgstr "Принудительный сброс пароля"

msgid "Delete policy"
msgstr "Удалить политику"

msgid "Password Policies"
msgstr "Стратегии управления паролями"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "Метка"

msgid "Password reset"
msgstr "Сбросить пароль"

msgid "Language"
msgstr "Язык"

msgid "Constraints"
msgstr "Ограничения"

msgid "Roles"
msgstr "Роли"

msgid "Role"
msgstr "Роль"

msgid "Constraint settings"
msgstr "Параметры ограничений"

msgid "Password Policy settings"
msgstr "Параметры стратегии управления паролями"

msgid "Cron threshold"
msgstr "Порог cron"

msgid "Blacklist"
msgstr "Чёрный список"

msgid "Password"
msgstr "Пароль"

msgid "Password Character Types Policy"
msgstr "Стратегия типов символов для паролей"

msgid "Minimum number of different character types the password must contain."
msgstr "Минимальное число разных типов символов, которые должен содержать пароль."

msgid "Character Types"
msgstr "Типы символов"

msgid "Invalid plugin configuration."
msgstr "Недопустимая конфигурация модуля."

msgid "Password must contain at least @types types of characters from the following character types: lowercase letters, uppercase letters, digits, special characters."
msgstr "Пароль должен содержать по крайней мере @types типов символов из следующих: строчные буквы, прописные буквы, цифры, специальные символы."

msgid "Minimum number of character types"
msgstr "Минимальное число типов символов"

msgid "Select the minimum number of character types which must be found in a password. The four supported character types are given as: lowercase letters, uppercase letters, digits, special characters."
msgstr "Выберите минимальное число типов символов, которые должны быть в пароле. Поддерживаются следующие четыре типа символов: строчные буквы, прописные буквы, цифры, специальные символы."

msgid "The number of character types must be between 2 and 4."
msgstr "Число типов символов должно быть от 2 до 4."

msgid "Minimum password character types: @types"
msgstr "Минимальное число типов символов пароля: @types"

msgid "Password character types"
msgstr "Типы символов пароля"

msgid "Verifying that a password has a minimum number of character types."
msgstr "Проверка наличия минимального числа типов символов в пароле."

msgid "Your password must have different character types."
msgstr "Пароль должен состоять из символов разных типов."

msgid "Password Characters of Type Policy"
msgstr "Стратегия типа символов для паролей"

msgid "Minimum characters of a particular type the password must contain."
msgstr "Минимальное число символов определенного типа, которое должен содержать пароль."

msgid "Number of characters"
msgstr "Число символов"

msgid "Character type"
msgstr "Тип символов"

msgid "Uppercase"
msgstr "Верхний регистр"

msgid "Lowercase"
msgstr "Нижний регистр"

msgid "Letter"
msgstr "Буква"

msgid "Numeric"
msgstr "Числовая"

msgid "The number of characters must be a positive number."
msgstr "Число символов должно быть положительным числом."

msgid "Password character type"
msgstr "Тип символов пароля"

msgid "Verifying that a password has a specific number of characters"
msgstr "Проверка наличия в пароле определенного количества символов"

msgid "The password does not contain a the correct number of certain characters."
msgstr "Пароль содержит неверное количество определенных символов."

msgid "Password Consecutive Characters Policy"
msgstr "Стратегия последовательных символов пароля"

msgid "Sets up a consecutive characters constraint for passwords."
msgstr "Настройка ограничения последовательных символов для паролей."

msgid "Maximum consecutive character count"
msgstr "Максимальное количество одинаковых символов подряд"

msgid "Password must have fewer than @max consecutive identical characters. This is case sensitive."
msgstr "Пароль должен содержать менее @max одинаковых символов подряд. Учитывается регистр символов."

msgid "The number of consecutive identical characters must be higher than 1 otherwise all passwords will fail."
msgstr "Число идущих подряд одинаковых символов должно быть больше 1, в противном случае все пароли будут недопустимыми."

msgid "Consecutive characters"
msgstr "Последовательные символы"

msgid "Verifying that a password has a maximum number of consecutive identical characters."
msgstr "Проверка наличия в пароле максимального количества одинаковых символов подряд."

msgid "Your password has too many consecutive characters."
msgstr "Пароль содержит слишком много одинаковых символов подряд."

msgid "Password Policy History"
msgstr "Хронология стратегии управления паролями"

msgid "Sets up a password constraint to limit repeated use of the same password."
msgstr "Ограничивает повторное использование одного и того же пароля."

msgid "The number of repeated passwords value must be zero or greater."
msgstr "Число повторяющихся паролей должно быть не меньше нуля."

msgid "Password History"
msgstr "Хронология паролей"

msgid "Provide restrictions on previously used passwords."
msgstr "Укажите ограничения на ранее использовавшиеся пароли."

msgid "You have used the same password previously and cannot."
msgstr "Такой пароль уже использовался. Его нельзя больше использовать."

msgid "Password Character Length Policy"
msgstr "Стратегия длины пароля"

msgid "Sets up a character length constraint for passwords."
msgstr "Задает ограничение на количество символов в паролях."

msgid "Operation"
msgstr "Действие"

msgid "Minimum length"
msgstr "Минимальная длина"

msgid "Maximum length"
msgstr "Максимальная длина"

msgid "The character length must be a positive number."
msgstr "Количество символов должно быть положительным числом."

msgid "at least"
msgstr "не менее"

msgid "at most"
msgstr "не более"

msgid "Password length must be at least 1 character."
msgid_plural "Password length must be at least @count characters."
msgstr[0] "Длина пароля должна быть не менее 1 символа."
msgstr[1] "Длина пароля должна быть не менее @count символов."
msgstr[2] "Длина пароля должна быть не менее @count символов."

msgid "Password length must not exceed 1 character."
msgid_plural "Password length must not exceed @count characters."
msgstr[0] "Длина пароля не должна превышать 1 символа."
msgstr[1] "Длина пароля не должна превышать @count символов."
msgstr[2] "Длина пароля не должна превышать @count символов."

msgid "Password character length of @operation 1 character"
msgid_plural "Password character length of @operation @characters characters"
msgstr[0] "Длина пароля @operation составляет 1 символ"
msgstr[1] "Длина пароля @operation составляет @characters символов"
msgstr[2] "Длина пароля @operation составляет @characters символов"

msgid "Password character length"
msgstr "Длина пароля"

msgid "Verifying that a password has a minimum character length"
msgstr "Проверка минимальной длины пароля"

msgid "The length of your password is too short."
msgstr "Пароль слишком короткий."

msgid "Password Username Policy"
msgstr "Стратегия имени пользователя для паролей"

msgid "Restrict users from having their username in their password."
msgstr "Запретить пользователям указывать свое имя пользователя в пароле."

msgid "Disallow username"
msgstr "Запретить имя пользователя"

msgid "Password must not contain the username."
msgstr "Пароль не должен содержать имя пользователя."

msgid "Prevent user from having a password containing their username."
msgstr "Запретить пользователю иметь пароль, содержащий его имя пользователя."

msgid "Password must not contain the user's username."
msgstr "Пароль не должен содержать имя пользователя."

msgid "Password username"
msgstr "Имя пользователя пароля"

msgid "Password must not contain their username"
msgstr "Пароль не должен содержать имя пользователя."

msgid "Your password contains your username."
msgstr "Ваш пароль содержит ваше имя пользователя."

msgid "@message"
msgstr "@message"

msgid "Pass"
msgstr "Пройден"

