msgstr "Добавить ограничение"

msgid "Configure Constraint Settings"
msgstr "Настройка параметров ограничения"

msgid "Policy Constraints"
msgstr "Ограничения стратегии"

msgid "Plugin Id"
msgstr "ИД модуля"

msgid "Summary"
msgstr "Сводка"

msgid "Operations"
msgstr "Операции"

msgid "No constraints have been configured."
msgstr "Ограничения не настроены."

msgid "Apply to Roles"
msgstr "Применить к ролям"

msgid "Select Roles to which this policy applies."
msgstr "Выберите роли, к которым применяется эта стратегия."

msgid "Edit"
msgstr "Редактировать"

msgid "Configure Required Context"
msgstr "Настроить обязательный контекст"

msgid "Force password reset of selected roles."
msgstr "Принудительный сброс паролей для выбранных ролей."

msgid "Exclude Myself"
msgstr "Исключить меня"

msgid "Exclude your account if you are included in the roles."
msgstr "Исключите свою учетную запись, если у вас есть эти роли."

msgid "No roles selected."
msgstr "Роли не выбраны."

msgid "Reset the %roles role."
msgid_plural "Reset the %roles roles."
msgstr[0] "Сброс %roles роли."
msgstr[1] "Сброс %roles ролей."
msgstr[2] "Сброс %roles ролей."

