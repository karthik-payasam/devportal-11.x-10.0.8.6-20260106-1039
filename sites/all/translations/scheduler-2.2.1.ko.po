msgid "Unpublishing failed for %title. @failed_hooks returned a failure code."
msgstr "%title에 대해 공개 취소에 실패했습니다. @failed_hooks이(가) 실패 코드를 리턴했습니다."

msgid "Action '%action_id' is missing. Use Config Update to import the missing action."
msgstr "'%action_id' 조치가 누락되었습니다. 구성 업데이트를 사용하여 누락된 조치를 가져오십시오."

msgid "Entity id @id is not a @type entity. Processing skipped."
msgstr "엔티티 ID @id은(는) @type 엔티티가 아닙니다. 처리를 건너뛰었습니다."

msgid "Schedule publishing and unpublishing of %label"
msgstr "%label 공개 및 공개 취소 스케줄"

msgid "Allows users to set a start and end time for %singular_label publication."
msgstr "사용자가 %singular_label 공개의 시작 및 종료 시간을 설정할 수 있도록 합니다."

msgid "View scheduled %label"
msgstr "스케줄된 %label 보기"

msgid "Allows users to see a list of all %plural_label that are scheduled."
msgstr "사용자가 스케줄된 모든 %plural_label의 목록을 볼 수 있도록 합니다."

msgid "Scheduler lightweight cron completed."
msgstr "스케줄러 경량 cron이 완료되었습니다."

msgid "nothing to update"
msgstr "업데이트 사항 없음"

msgid "Scheduler entity update - @updated"
msgstr "스케줄러 엔티티 업데이트 - @updated"

msgid "nothing to do"
msgstr "수행할 작업 없음"

msgid "Scheduler entity revert - @reverted"
msgstr "스케줄러 엔티티 되돌리기 - @reverted"

msgid "Most of the Scheduler options are set independently for each entity type and bundle. These can be accessed from the <a href=\"@link\">admin structure</a> page or directly by using the drop-button"
msgstr "대부분의 스케줄러 옵션은 각 엔티티 유형 및 번들에 대해 독립적으로 설정됩니다. <a href=\"@link\">관리 구조</a> 페이지에서 또는 드롭 단추를 사용하여 직접 액세스할 수 있습니다."

msgid "Entity Types"
msgstr "엔티티 유형"

msgid "no entity types defined"
msgstr "정의된 엔티티 유형 없음"

msgid "publishing"
msgstr "공개"

msgid "unpublishing"
msgstr "공개 취소"

msgid "The settings below are common to all entity types."
msgstr "아래 설정은 모든 엔티티 유형에 공통입니다."

msgid "Date only"
msgstr "날짜만"

msgid "Allow users to enter only a date and provide a default time."
msgstr "사용자가 날짜만을 입력하고 기본시간을 제공하도록 허용합니다. "

msgid "When only a date is entered the time will default to a specified value, but the user can change this if required."
msgstr "날짜만이 입력되면 시간은 기본적으로 지정된 값으로 설정되지만 사용자는 필요한 경우 이를 변경할 수 있습니다. "

msgid "Default time"
msgstr "기본 시간"

msgid "Provide a default time in @format format that will be used if the user does not enter a value."
msgstr "사용자가 값을 입력하지 않는 경우 사용할 기본 시간을 @format 형식으로 제공하십시오."

msgid "Time settings"
msgstr "시간 설정"

msgid "Hide the seconds."
msgstr "시간(초)을 숨깁니다."

msgid "When entering a time, only show hours and minutes in the input field."
msgstr "시간을 입력할 때 입력 필드에 시간 및 분만 표시합니다."

msgid "The default time should be in the format @format"
msgstr "기본 시간은 @format 형식이어야 합니다."

msgid "No %bundle_id entity types returned by %module module for use in %plugin_label"
msgstr "%plugin_label에서 사용하기 위해 %module 모듈에서 리턴된 %bundle_id 엔티티 유형이 없습니다."

msgid "Lightweight cron settings"
msgstr "경량 cron 설정"

msgid "Log every activation and completion message."
msgstr "모든 활성 및 완료 메시지를 로그합니다. "

msgid "When this option is checked, Scheduler will write an entry to the log every time the lightweight cron process is started and completed. This is useful during set up and testing, but can result in a large number of log entries. Any actions performed during the lightweight cron run will always be logged regardless of this setting."
msgstr "이 옵션이 선택되면 스케줄러는 경량 cron 프로세스가 시작되고 완료될 때마다 항목을 로그에 씁니다. 이는 설정 및 테스트 동안에 유용하지만 로그 항목의 수가 너무 많아지는 결과가 나올 수 있습니다. 경량 cron 실행 동안에 수행된 모든 조치는 이 설정과 관계 없이 항상 로그됩니다. "

msgid "Similar to Drupal's cron key this acts as a security token to prevent unauthorised calls to scheduler/cron. The key should be passed as scheduler/cron/{access key}"
msgstr "Drupal의 cron 키와 유사하게 이는 스케줄러/cron에 무단 호출을 방지하기 위해 보안 토큰으로서 작동합니다. 키는 스케줄러/cron/{access key}로서 전달되어야 합니다. "

msgid "Generate new random key"
msgstr "새 랜덤 키 생성"

msgid "You can test Scheduler's lightweight cron process interactively"
msgstr "스케줄러의 경량 cron 프로세스를 대화식으로 테스트할 수 있습니다. "

msgid "Run Scheduler's lightweight cron now"
msgstr "스케줄러의 경량 cron을 지금 실행"

msgid "Lightweight cron run completed. See the <a href=\"@url\">log</a> for details."
msgstr "경량 cron 실행 완료. 세부사항은 <a href=\"@url\">로그</a>를 참조하십시오. "

