msgstr "\"@label\" bağlantı tipi kullanılırken bir işaret onay iletisi gereklidir."

msgid "An unflag confirmation message is required when using the \"@label\" link type."
msgstr "\"@label\" bağlantı tipi kullanılırken bir işaret kaldırma onay iletisi gereklidir."

msgid "Normal link"
msgstr "Normal bağlantı"

msgid "A normal non-JavaScript request will be made and the current page will be reloaded."
msgstr "JavaScript olmayan normal bir istek yapılacak ve geçerli sayfa yeniden yüklenecektir."

msgid "Permissions based on ownership of a comment's parent entity."
msgstr "Bir yorumun üst varlığının sahibine dayalı izinler."

msgid "Flag %flag_title comments on own parent entities"
msgstr "%flag_title işareti, kendi üst varlıkları hakkında yorum yapar"

msgid "Unflag %flag_title on own parent entities"
msgstr "Kendi üst varlıklarında %flag_title işaretini kaldır"

