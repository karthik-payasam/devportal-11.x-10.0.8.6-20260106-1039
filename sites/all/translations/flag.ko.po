msgstr "사용자가 엔티티에 설정할 수 있는 사용자 정의 플래그를 작성하십시오."

msgid "Add flag"
msgstr "플래그 추가"

msgid "Configure flags for marking content with arbitrary information (such as <em>offensive</em> or <em>bookmarked</em>)."
msgstr "컨텐츠를 임의의 정보(예: <em>불쾌함</em> 또는 <em>책갈피</em>)로 표시하기 위한 플래그를 구성하십시오."

