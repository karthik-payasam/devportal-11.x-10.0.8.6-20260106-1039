msgid "OpenAPI"
msgstr "OpenAPI"

msgid "Connects Drupal to the OpenAPI Javascript Library"
msgstr "Connette Drupal alla libreria Javascript OpenAPI"

msgid "Available OpenAPI Documentation."
msgstr "Documentazione OpenAPI disponibile. "

msgid "Access API Docs"
msgstr "Accedi alle Doc API"

msgid "Access documentation page for the REST API"
msgstr "Accede alla pagina della documentazione per le API REST "

msgid "OpenAPI Schema Download"
msgstr "Download dello schema OpenAPI"

msgid "OpenAPI Resources"
msgstr "Risorse OpenAPI "

msgid "OpenAPI Documentation"
msgstr "Documentazione OpenAPI "

msgid "%label OpenApi Schema Download"
msgstr "%label Download dello schema OpenApi"

msgid "The specifications provide the documentation on some of Drupal's apis following <a href=':openapi_spec'>OpenAPI (aka Swagger)</a> standards."
msgstr "Le specifiche forniscono la documentazione relative ad alcune API di Drupal che seguono le specifiche <a href=':openapi_spec'>OpenAPI (dette anche Swagger)</a>. "

msgid "These json files can be used in tools such as the <a href=\":swagger_editor\">Swagger Editor</a> to provide a more detailed version of the API documentation or <a href=\":swagger_codegen\">Swagger Codegen</a> to create an api client."
msgstr "Tali file json possono essere utilizzati in strumenti come l'<a href=\":swagger_editor\">Editor Swagger</a> per fornire una versione più dettagliata della documentazione API o <a href=\":swagger_codegen\">generatore di codice Swagger</a> per creare un client API. "

msgid "Module"
msgstr "Modulo"

msgid "Specification"
msgstr "Specifica "

msgid "Explore"
msgstr "Esplora "

msgid "Please visit the <a href=':openapi_ui_link'>OpenAPI UI module</a> for information on these interfaces and to discover others."
msgstr "Visitare il <a href=':openapi_ui_link'>modulo UI OpenAPI</a> per informazioni su tali interfacce e per scoprirne di nuove. "

msgid "No UI plugins available"
msgstr "Nessun plugin UI disponibile "

msgid "There are no plugins available for exploring the OpenAPI documentation."
msgstr "Non è disponibile alcun plugin per l'esplorazione della documentazione OpenAPI. "

msgid "You can install one of the below projects to view the API Specifications from with your site."
msgstr "È possibile installare uno dei seguenti progetti per visualizzare le Specifiche API dal proprio sito. "

msgid "View/Download"
msgstr "Visualizza/Download"

msgid "Explore with %interface"
msgstr "Esplora con %interface"

msgid "No UI available."
msgstr "Nessun Interfaccia Utente disponibile. "

msgid "No OpenApi generator plugins are currently available."
msgstr "Nessun plug-in generatore OpenApi è attualmente disponibile."

msgid "You must enable a REST or API module which supports OpenApi Downloads, such as the <a href=\":rest_link\">Core Rest</a> and <a href=\":jsonapi_link\">JSON:API</a> modules."
msgstr "È necessario abilitare un modulo REST o API che supporti i Download OpenAPI, come i moduli <a href=\":rest_link\">Rest principale</a> e <a href=\":jsonapi_link\">JSON:API</a>."

msgid "%generator OpenApi Documentation"
msgstr "%generator documentazione OpenApi "

