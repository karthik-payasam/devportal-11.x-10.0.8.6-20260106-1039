msgstr "Standardziel"

msgid "Remove target attribute"
msgstr "Zielattribut entfernen"

msgid "Open in a new browser window or tab (_blank)"
msgstr "In einem neuen Browserfenster oder auf einer neuen Registerkarte öffnen (_blank)"

msgid "Open in the current window (_self)"
msgstr "Im aktuellen Fenster öffnen (_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "In dem Frame öffnen, der dem Frame mit dem Link übergeordnet ist (_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "Alle Frames abbrechen und im vollständigen Browserfenster öffnen (_top)"

msgid "Default rel"
msgstr "Standardeinstellung für rel"

msgid "Remove rel attribute"
