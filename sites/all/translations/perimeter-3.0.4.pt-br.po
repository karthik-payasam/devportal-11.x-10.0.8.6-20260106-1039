msgid "Allowlist skipping ban: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Allowlist skipping ban: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"

msgid "Banned: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Banido: %ip para %type com falha em %form <br />Origem: %source ^% <br /> Agente do Usuário: %browser"

msgid "Drupal Perimeter Defence"
msgstr "Defesa de Perímetro Drupal"

msgid "Immediately ban hackers when they try to scan the site."
msgstr "Bane os hackers imediatamente ao tentarem varrer o site."

msgid "Perimeter defence settings"
msgstr "Configurações de defesa de perímetro"

msgid "Configure the settings for Drupal Perimeter Defence."
msgstr "Defina as configurações para o Drupal Perimeter Defence."

msgid "Bypass Perimeter Defence ban rules"
msgstr "Ignorar regras de proibição do Perimeter Defence"

msgid "Allow users to bypass the rules defined by Perimeter Defence module."
msgstr "Permitir que os usuários ignorem as regras definidas pelo módulo Perimeter Defence."

msgid "Perimeter settings"
msgstr "Configurações do perímetro"

msgid "Perimeter Settings"
msgstr "Configurações do perímetro"

msgid "A list of regex patterns"
msgstr "Uma lista de padrões de expressão regular"

msgid "A regex pattern"
msgstr "Um padrão de expressão regular"

msgid "Banned: %ip for requesting %pattern <br />Source: %source <br /> User Agent: %browser"
msgstr "Proibido: %ip para solicitar %pattern <br />Origem: %source <br /> Agente do usuário: %browser"

msgid "Perimeter will ban any user that generates \"404 - File not found\" for requesting any of the following url pattern"
msgstr "O perímetro banirá qualquer usuário que gerar \"404 - Arquivo não encontrado\" para solicitar qualquer um dos padrões de URL a seguir"

msgid "Ban URL patterns"
msgstr "Banir padrões de URL"

msgid "A list of regex patterns, each pattern on a separate line"
msgstr "Uma lista de padrões de expressão regular, cada padrão em uma linha separada"

