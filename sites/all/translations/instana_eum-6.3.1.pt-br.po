msgid "Instana EUM"
msgstr "Instana EUM"

msgid "Configures Instana End User Monitoring (EUM) beacon module."
msgstr "Configura o módulo beacon do Instana End User Monitoring (EUM)."

msgid "Monitoring"
msgstr "Monitoramento"

msgid "Instana EUM Configuration"
msgstr "Configuração do Instana EUM"

msgid "Setup Instana EUM connection parameters."
msgstr "Configurar parâmetros de conexão do Instana EUM."

msgid "Configure the Instana EUM module"
msgstr "Configurar o módulo Instana EUM"

msgid "Setup the parameters to connect Drupal to Instana."
msgstr "Configure os parâmetros para conectar o Drupal à Instana."

msgid "Instana EUM Settings"
msgstr "Configurações do Instana EUM"

msgid "The API Key for the Instana server"
msgstr "A chave de API para o servidor Instana"

msgid "The reporting URL of the Instana server"
msgstr "A URL do server reporting da Instana"

msgid "Allow Instana to monitor page views, load times and JS errors for individual pages"
msgstr "Permitir que a Instana monitore visualizações de página, tempos de carregamento e erros de JS para páginas individuais"

msgid "Enable monitoring of admin pages."
msgstr "Ativar o monitoramento de páginas de administrador."

msgid "Advanced settings for the Instana server configuration"
msgstr "Configurações avançadas para a configuração do servidor Instana"

msgid "Configures Instana End User Monitoring (EUM) beacon module. Please see the <a href=\"https://www.instana.com/docs/website_monitoring/\" target=\"_blank\">official documentation</a> for further details."
msgstr "Configura o módulo beacon do Instana End User Monitoring (EUM). Veja a <a href=\"https://www.instana.com/docs/website_monitoring/\" target=\"_blank\">documentação oficial</a> para mais detalhes."

msgid "API Key"
msgstr "Chave de API"

msgid "Enter the API key for your Instana server."
msgstr "Insira a chave de API para seu servidor Instana."

msgid "Reporting URL"
msgstr "URL de reporting"

msgid "Enter the Instana server reporting URL."
msgstr "Insira a URL do server reporting da Instana."

msgid "Track individual pages"
msgstr "Controlar páginas individuais"

msgid "Isolate specific pages and analyze their performance to find pages with the most traffic, or the slowest response times."
msgstr "Isole páginas específicas e analise seu desempenho para encontrar páginas com a maioria do tráfego, ou os tempos de resposta mais lentos."

msgid "Admin page tracking"
msgstr "Rastreamento de página de administrador"

msgid "Include monitoring of pages with /admin in the url."
msgstr "Incluir monitoramento de páginas com /admin na URL."

msgid "You can use this to set additional EUM settings."
msgstr "É possível usar isso para definir configurações adicionais do EUM."

msgid "See documentation here"
msgstr "Veja a documentação aqui"

msgid "Examples:"
msgstr "Exemplos:"

msgid "Advanced Settings"
msgstr "Configurações avançadas"

