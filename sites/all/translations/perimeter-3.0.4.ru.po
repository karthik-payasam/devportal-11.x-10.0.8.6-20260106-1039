msgid "Allowlist skipping ban: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Белый список игнорирует блокировку: %ip ошибочного типа %type в форме %form <br />Источник: %source <br /> Браузер пользователя: %browser"

msgid "Banned: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Запрещен %ip, поскольку возник сбой %type для %form <br />Источник: %source <br /> Браузер: %browser"

msgid "Drupal Perimeter Defence"
msgstr "Защита периметра Drupal"

msgid "Immediately ban hackers when they try to scan the site."
msgstr "Немедленно блокировать хакеров, которые сканируют сайт."

msgid "Perimeter defence settings"
msgstr "Настройки защиты периметра"

msgid "Configure the settings for Drupal Perimeter Defence."
msgstr "Настройте параметры периметра защиты Drupal. "

msgid "Perimeter settings"
msgstr "Настройки периметра"

msgid "Perimeter Settings"
msgstr "Настройки периметра"

msgid "A list of regex patterns"
msgstr "Список шаблонов регулярных выражений"

msgid "A regex pattern"
msgstr "Шаблон регулярного выражения"

msgid "Banned: %ip for requesting %pattern <br />Source: %source <br /> User Agent: %browser"
msgstr "Запрещен %ip для запроса %pattern <br />Источник: %source <br /> Браузер: %browser"

msgid "Perimeter will ban any user that generates \"404 - File not found\" for requesting any of the following url pattern"
msgstr "Периметр заблокирует любого пользователя, который получит сообщение «404 — Файл не найден» при запросе любого из следующих шаблонов URL."

msgid "Ban URL patterns"
msgstr "Шаблонов URL для блокирования"

msgid "A list of regex patterns, each pattern on a separate line"
msgstr "Список шаблонов регулярных выражений, каждый шаблон в отдельной строке"

