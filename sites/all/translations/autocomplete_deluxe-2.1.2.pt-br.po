msgid "Autocomplete Deluxe"
msgstr "Autocomplete Deluxe"

msgid "Enhanced autocomplete using Jquery UI autocomplete."
msgstr "Melhoria do autocomplete usando a jQuery UI autocomplete."

msgid "User interface"
msgstr "Interface de usuário"

msgid "None"
msgstr "Nenhum"

msgid "The entity '@term' will be added."
msgstr "A entidade '@term' será adicionada."

msgid "No terms could be found. Please type in order to add a new term."
msgstr "Nenhum termo pôde ser localizado. Digite a ordem para incluir um novo termo."

msgid "No results found"
msgstr "Nenhum resultado encontrado."

msgid "Autocomplete Deluxe widget settings"
msgstr "Configurações de widget Autocomplete Deluxe"

msgid "Match Operator"
msgstr "Operador de correspondência"

msgid "Route Name"
msgstr "Nome da Rota"

msgid "Size"
msgstr "Tamanho"

msgid "Selection Handler"
msgstr "Manipulador de seleção"

msgid "Limit"
msgstr "Limite"

msgid "Min Length"
msgstr "Comprimento mínimo"

msgid "Delimiter"
msgstr "Delimitador"

msgid "Allow \"Not Found\" message"
msgstr "Permitir mensagem \"Não localizada\""

msgid "\"Not Found\" Message"
msgstr "Mensagem \"Não localizada\""

msgid "Allow New Terms"
msgstr "Permitir novos termos"

msgid "No Empty Message"
msgstr "Nenhuma mensagem vazia"

msgid "Match operator"
msgstr "Operador de combinação"

msgid "Specify the matcting operator."
msgstr "Especificar o operador de correspondência."

msgid "Limit of the output."
msgstr "Limite da saída."

msgid "If set to zero no limit will be used"
msgstr "Se configurado como zero, nenhum limite será usado"

msgid "Minimum length."
msgstr "Comprimento mínimo."

msgid "The minimum length of characters to enter to open the suggestion list."
msgstr "A quantidade mínima de caracteres para abrir a lista de sugestões."

msgid "Delimiter."
msgstr "Delimitador"

msgid "A character which should be used beside the enter key, to separate terms."
msgstr "Um caractere que deve ser usado ao lado da tecla ENTER para separar termos."

msgid "Show Term not found message"
msgstr "Mostrar a mensagem de Termo não localizado"

msgid "If this is enabled, a message will be displayed when the term is not found."
msgstr "Se isso estiver ativado, uma mensagem será exibida quando o termo não for localizado."

msgid "Term not found message."
msgstr "Mensagem de Termo não localizado."

msgid "A message text which will be displayed, if the entered term was not found."
msgstr "Um texto da mensagem que será exibido se o termo inserido não tiver sido localizado."

msgid "Allow new terms"
msgstr "Permitir novos termos"

msgid "Should it be allowed, that user enter new terms?"
msgstr "Deve-se permitir ao usuário adicionar novos termos?"

msgid "Empty value message."
msgstr "Mensagem de Valor vazio."

msgid "A text message that will be displayed when the field is focused and it does not contain values."
msgstr "Uma mensagem de texto que será exibida quando o foco estiver no campo e ele não contiver valores."

msgid "Match operator: @match_operator"
msgstr "Operador de correspondência: @match_operator"

msgid "Limit: @limit"
msgstr "Limite: @limit"

msgid "Min length: @min_length"
msgstr "Comprimento mínimo: @min_length"

msgid "Delimiter: @delimiter"
msgstr "Delimitador: @delimiter"

msgid "Allow Not Found message: @not_found_message_allow"
msgstr "Permitir mensagem de Não localizado: @not_found_message_allow"

msgid "Not Found message: @not_found_message"
msgstr "Mensagem de Não localizado: @not_found_message"

msgid "Allow new terms: @new_terms"
msgstr "Permitir novos termos: @new_terms"

msgid "Empty value message: @no_empty_message"
msgstr "Mensagem de valor vazio: @no_empty_message"

msgid "@not_found_message"
msgstr "@not_found_message"

msgid "@no_empty_message"
msgstr "@no_empty_message"

msgid "Starts with"
msgstr "Começa com"

msgid "Contains"
msgstr "Contendo"

