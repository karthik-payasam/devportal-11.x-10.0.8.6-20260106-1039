msgid "Whether the mail should be sent as HTML"
msgstr "Określa, czy poczta powinna być wysyłana w formacie HTML"

msgid "Delete contact message configuration"
msgstr "Usuń konfigurację wiadomości kontaktowych"

msgid "Contact form"
msgstr "Formularz kontaktowy"

msgid "Contact Message bulk form"
msgstr "Formularz zbiorczy dla wiadomości kontaktów"

