msgid "Rest Facets"
msgstr "Fazety služby REST (Representational State Transfer)"

msgid "Adds facets to rest views based on a Search API index."
msgstr "Přidá fazety do pohledů služby REST (Representational State Transfer) na základě indexu rozhraní API pro vyhledávání."

msgid "Search"
msgstr "Vyhledávání"

msgid "Show facets in the output"
msgstr "Zobrazit fazety ve výstupu"

msgid "Facets serializer"
msgstr "Serializační modul fazet"

msgid "Serializes views row data using the Serializer component."
msgstr "Serializuje řádková data pohledu pomocí komponenty serializačního modulu."

