msgid "Send e-mail when content is published by Scheduler"
msgstr "Enviar e-mail quando o conteúdo for publicado pelo Planejador"

msgid "'[node:title]' has been published on [site:name]"
msgstr "'[node:title]' foi publicado em [site:name]"

