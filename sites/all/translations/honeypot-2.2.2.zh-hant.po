msgid "About"
msgstr "關於"

msgid "Uses"
msgstr "使用"

msgid "Honeypot installed successfully. Please <a href=\":url\">configure Honeypot</a> to protect your forms from spam bots."
msgstr "已順利安裝 Honeypot。請<a href=\":url\">配置 Honeypot</a>，以保護您的表單不受 spambot 程式攻擊。"

msgid "Honeypot"
msgstr "Honeypot"

msgid "Mitigates spam form submissions using the honeypot method."
msgstr "使用誘騙系統方法來減緩垃圾郵件表單提交。"

msgid "Spam control"
msgstr "Spam 控制"

msgid "Honeypot configuration"
msgstr "Honeypot 配置"

msgid "Configure Honeypot spam prevention and the forms on which Honeypot will be used."
msgstr "配置 Honeypot 垃圾郵件預防，以及將在其上使用 Honeypot 的表單。"

msgid "Administer Honeypot"
msgstr "管理 Honeypot"

msgid "Administer Honeypot-protected forms and settings."
msgstr "管理受 Honeypot 保護的表單及設定。"

msgid "Bypass Honeypot protection"
msgstr "略過 Honeypot 保護"

msgid "Bypass Honeypot form protection."
msgstr "略過 Honeypot 表單保護。"

msgid "Protect all forms"
msgstr "保護所有表單"

msgid "Unprotected forms"
msgstr "未受保護的幾個表單"

msgid "Unprotected form"
msgstr "未受保護的表單"

msgid "Log blocked form submissions"
msgstr "記載封鎖的表單提交"

msgid "Honeypot element name"
msgstr "Honeypot 元素名稱"

msgid "Honeypot time limit"
msgstr "Honeypot 時間限制"

msgid "Expiration"
msgstr "有效期限"

msgid "Leave this field blank"
msgstr "將此欄位保留空白"

msgid "Timestamp"
msgstr "時間"

msgid "There was a problem with your form submission. Please refresh the page and try again."
msgstr "提交表單時發生問題。請重新整理頁面，然後再試一次。"

msgid "Preview"
msgstr "預覽"

msgid "There was a problem with your form submission. Please wait @limit seconds and try again."
msgstr "提交表單時發生問題。請稍候 @limit 秒，然後再試一次。"

msgid "submission of a value in the honeypot field"
msgstr "提交 Honeypot 欄位中的值"

msgid "submission of the form in less than minimum required time"
msgstr "在最短的必要時間內提交表單"

msgid "Blocked submission of %form due to @cause."
msgstr "由於 @cause，封鎖了 %form 的提交。"

msgid "Honeypot Configuration"
msgstr "Honeypot 配置"

msgid "Protect all forms with Honeypot"
msgstr "使用 Honeypot 保護所有表單"

msgid "Enable Honeypot protection for ALL forms on this site (it is best to only enable Honeypot for the forms you need below)."
msgstr "為此網站中的所有表單啟用 Honeypot 保護（最好只對您需要的以下表單啟用 Honeypot）。"

msgid "<strong>Page caching will be disabled on any page where a form is present if the Honeypot time limit is not set to 0.</strong>"
msgstr "<strong>如果 Honeypot 時間限制未設為 0，則在任何呈現表單的頁面上，頁面快取將會停用。</strong>"

msgid "Log submissions that are blocked due to Honeypot protection."
msgstr "記載由於 Honeypot 保護而封鎖的提交。"

msgid "Minimum time required before form should be considered entered by a human instead of a bot. Set to 0 to disable."
msgstr "將表單視為由人員輸入而不是機器人輸入所需的最短時間。設為 0 表示停用。"

msgid "seconds"
msgstr "秒"

msgid "<strong>Page caching will be disabled if there is a form protected by time limit on the page.</strong>"
msgstr "<strong>如果頁面上有一個表單受到時間限制保護，則會停用頁面快取。</strong>"

msgid "Honeypot Enabled Forms"
msgstr "啟用 Honeypot 的表單"

msgid "Check the boxes next to individual forms on which you'd like Honeypot protection enabled."
msgstr "勾選您想啟用 Honeypot 保護的個別表單旁的勾選框。"

msgid "General Forms"
msgstr "一般表單"

msgid "User Registration form"
msgstr "使用者登錄表單"

msgid "User Password Reset form"
msgstr "使用者密碼重設表單"

msgid "Contact Forms"
msgstr "聯絡表單"

msgid "Node Forms"
msgstr "節點表單"

msgid "@name node form"
msgstr "@name 節點表單"

msgid "Comment Forms"
msgstr "評論表單"

msgid "@name comment form"
msgstr "@name 評論表單"

msgid "The element name cannot contain spaces or other special characters."
msgstr "元素名稱不得包含空格或其他特殊字元。"

msgid "The element name must start with a letter."
msgstr "元素名稱必須以字母開頭。"

msgid "The element name cannot match one of the common Drupal form field names (e.g. @names)."
msgstr "元素名稱不能與其中一個一般 Drupal 表單欄位名稱（例如 @name）相符。"

