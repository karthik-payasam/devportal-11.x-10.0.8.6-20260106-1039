msgstr "Bilinmeyen sıralama düzeni @order. Varsayılan olarak \"@default\" kullanılıyor. "

msgid "Unknown facet field @field."
msgstr "Bilinmeyen kategori alanı @field."

msgid "Facets on location fields are currently not supported."
msgstr "Konum alanlarındaki kategoriler şu anda desteklenmiyor."

msgid "Unknown field @field: please check (and re-save) the index's fields settings."
msgstr "Bilinmeyen alan @field: lütfen dizinin alan ayarlarını kontrol edin ve (yeniden kaydedin)."

msgid "An overlong word (more than 50 characters) was encountered while indexing: %word.<br />Since database search servers currently cannot index words of more than 50 characters, the word was truncated for indexing. If this should not be a single word, please make sure the \"Tokenizer\" processor is enabled and configured correctly for index %index."
msgstr "Dizinleme sırasında çok uzun bir sözcükle (50 karakterden uzun) karşılaşıldı: %word.<br />Veritabanı arama sunucuları şu anda 50 karakteri aşan sözcükleri dizinleyemediğinden sözcük dizinleme için kesildi. Bunun tek bir sözcük olmaması gerekmiyorsa, lütfen \"Tokenizer\" işlemcisinin %index dizini için etkin ve doğru yapılandırılmış olduğundan emin olun."

msgid "An overlong value (more than 255 characters) was encountered while indexing: %value.<br />Database search servers currently cannot index such values correctly – the value was therefore trimmed to the allowed length."
msgstr "Dizinleme sırasında çok uzun bir değerle (255 karakterden uzun) karşılaşıldı: %value.<br />Veritabanı arama sunucuları şu anda bu tür değerleri doğru dizinleyemiyor, bu nedenle değer izin verilen uzunluğa kadar kırpıldı."

msgid "Error while adding facets: only \"item_id\" field should be used, used are: @fields."
msgstr "Kategoriler eklenirken hata oluştu: yalnızca \"item_id\" alanı kullanılmalıdır, kullanılanlar: @fields."

msgid "Indexes items in the database. Supports several advanced features, but should not be used for large sites."
msgstr "Veritabanındaki öğeleri dizinler. Bazı gelişmiş özellikleri destekler, ancak büyük siteler için kullanılmamalıdır."

msgid "Completed about @percentage% of the indexing operation (@current of @total)."
msgstr "Dizinleme işleminde @percentage% tamamlandı (@current/@total)."

msgid "An error occurred during indexing on @index: @message"
msgstr "@index üzerinde dizin oluşturma sırasında hata oluştu: @message"

msgid "Couldn't index items. Check the logs for details."
msgstr "Öğeler dizinlenemedi. Ayrıntılar için günlüklere bakın."

msgid "An error occurred while trying to index items. Check the logs for details."
msgstr "Öğeler dizinlenmeye çalışılırken hata oluştu. Ayrıntılar için günlüklere bakın."

