msgid "Schema.org: Recipe"
msgstr "Schema.org: Tarif"

msgid "RECOMMENDED BY GOOGLE. The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Öğenin, inceleme ya da değerlendirme toplamına dayalı genel notu."

msgid "RECOMMENDED BY GOOGLE. Author of the recipe."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Tarifin yazarı."

msgid "RECOMMENDED BY GOOGLE. Cook Time (The time it takes to actually cook the dish, in ISO 8601 duration format.)."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Pişirme Süresi (ISO 8601 süre biçiminde, yemeği pişirmek için gereken süre.)."

msgid "RECOMMENDED BY GOOGLE. Date the recipe was published."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Tarifin yayınlandığı tarih."

msgid "RECOMMENDED BY GOOGLE. A description of the item."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Öğenin açıklaması."

msgid "Globally unique id of the recipe, usually a url."
msgstr "Tarifin genel olarak benzersiz tanıtıcısı, genellikle bir url'dir."

msgid "RECOMMENDED BY GOOGLE. The primary image for this item."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Bu öğe için birincil resim."

msgid "RECOMMENDED BY GOOGLE. Keywords of the recipe (comma separated). For example, 'winter apple pie, nutmeg crust'"
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Tarifin anahtar sözcükleri (virgülle ayrılmış). Örneğin, 'kış elmalı turta, muskat kabuğu'"

msgid "REQUIRED BY GOOGLE. Name of the recipe."
msgstr "GOOGLE İÇİN ZORUNLU. Tarifin adı."

msgid "RECOMMENDED BY GOOGLE. The nutrition for this item."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Bu öğe için beslenme değerleri."

msgid "RECOMMENDED BY GOOGLE. The length of time it takes to prepare the recipe for dish, in ISO 8601 format."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Yemek için tarifi hazırlama süresi, ISO 8601 biçiminde."

msgid "RECOMMENDED BY GOOGLE. The category of the recipe—for example, appetizer, entree, etc."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Tarif kategorisi, örneğin, iştah açıcı, antre vb."

msgid "RECOMMENDED BY GOOGLE. The region associated with your recipe. For example, 'French Mediterranean', or 'American'."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Tarifinizle ilişkili bölge. Örneğin, 'Fransız-Akdeniz' veya 'Amerika'."

msgid "RECOMMENDED BY GOOGLE. A list of single ingredients used in the recipe, e.g. sugar, flour or garlic."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Tarifte kullanılan tek tek malzeme listesi; örneğin, şeker, un veya sarımsak."

msgid "RECOMMENDED BY GOOGLE. Steps in making the recipe."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Tarifin yapımındaki adımlar."

msgid "RECOMMENDED BY GOOGLE. The quantity produced by the recipe (for example, number of people served, number of servings, etc)."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Tarifin ürettiği miktar (örneğin, servis sayısı, servis edilen kişi sayısı)."

msgid "RECOMMENDED BY GOOGLE. Reviews of this recipe."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Bu tarifin incelemeleri."

msgid "RECOMMENDED BY GOOGLE. Total Time (The total time required to perform instructions or a direction (including time to prepare the supplies), in ISO 8601 duration format."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. ISO 8601 biçiminde toplam süre (yönergeleri veya bir yönü gerçekleştirmek için gereken toplam süre (malzemeleri hazırlama süresi dahil))."

msgid "REQUIRED. The type of recipe."
msgstr "ZORUNLU. Tarifin tipi."

