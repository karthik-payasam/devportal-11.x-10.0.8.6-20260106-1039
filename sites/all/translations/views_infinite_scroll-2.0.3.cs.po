msgid "Views Infinite Scroll"
msgstr "Nekonečné posouvání pohledů"

msgid "A pager which allows an infinite scroll effect for views."
msgstr "Pager, který umožňuje efekt nekonečného posouvání pro pohledy. "

msgid "Views"
msgstr "Views"

msgid "Infinite Scroll Pager"
msgstr "Pager nekonečného posouvání"

msgid "Button Text"
msgstr "Text tlačítka"

msgid "Automatically Load Content"
msgstr "Automaticky načítat obsah"

msgid "Initially load all pages"
msgstr "Nejprve načíst všechny stránky"

msgid "Load More"
msgstr "Načíst další"

msgid "Automatic infinite scroll"
msgstr "Automatické nekonečné posouvání"

msgid "Click to load"
msgstr "Klepnutím načíst"

msgid "Initially load one page"
msgstr "Nejprve načíst jednu stránku"

msgid "Infinite Scroll Options"
msgstr "Volby nekonečného posouvání"

msgid "Note: The infinite scroll option overrides and requires the <em>Use AJAX</em> setting for this views display."
msgstr "Poznámka: Volba nekonečného posouvání potlačuje a zároveň vyžaduje nastavení <em>Použít AJAX</em> pro toto zobrazení pohledů. "

msgid "The following tokens are supported:"
msgstr "Podporovány jsou následující tokeny:"

msgid "Automatically load subsequent pages as the user scrolls."
msgstr "Automaticky načítat následné stránky během posouvání uživatelem. "

msgid "Initially load all pages up to the requested page"
msgstr "Nejprve načíst všechny stránky až na požadovanou stránku"

msgid "When initially loading a page beyond the first, this option will load all pages up to the requested page instead of just the requested page. So, if you have the pager set to 10 items per page, and you load the page with ?page=2 in the url, you will get page 0, 1 and 2 loaded for a total of 30 items. <em>Note that this could cause some long page load times when loading many pages.</em>"
msgstr "Tato volba, při počátečním načítání stránky po první, načte všechny stránky až po požadovanou stránku, nikoli pouze požadovanou stránku. Máte-li tedy stránkovač nastavený na 10 položek na stránku a načtete stránku s parametrem ?page=2 v adrese URL, načtou se stránky 0, 1 a 2 pro celkem 30 položek. <em>Poznámka: V případě většího počtu stránek by načítání mohlo trvat dlouhou dobu.</em>"

msgid "@action, @count item"
msgid_plural "@action, @count items, @pages"
msgstr[0] "@action, @count položka"
msgstr[1] "@action, @count items, @pages"
msgstr[2] "@action, @count items, @pages"

msgid "Infinite Scroll"
msgstr "Nekonečné posouvání"

msgid "A views plugin which provides infinte scroll."
msgstr "Modul plug-in pohledu poskytující nekonečné posouvání. "

msgid "Load more items"
msgstr "Načíst další položky"

