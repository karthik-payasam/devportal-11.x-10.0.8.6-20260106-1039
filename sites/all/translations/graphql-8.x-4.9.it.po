msgid "About"
msgstr "Informazioni"

msgid ""
"\n"
"<p>This module generates and exposes a\n"
"  <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a> schema for\n"
"  <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a> entities,\n"
"  and allows you to expose your own custom schema in a consistent way and with\n"
"  minimal effort.</p>"
msgstr ""
"\n"
"<p>Questo modulo genera ed espone uno\n"
"  schema <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a> per le\n"
"  entità <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a>,\n"
"  e consente di esporre i propri schemi predefiniti in modo congruente e con\n"
"  uno sforzo minimo.</p>"

