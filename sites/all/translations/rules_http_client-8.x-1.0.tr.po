msgid "Rules HTTP Client"
msgstr "Kurallar HTTP İstemcisi"

msgid "Provides an action for making http requests."
msgstr "http istekleri yapma işlemi sağlar."

msgid "Rules"
msgstr "Kurallar"

msgid "Error while requsting url as Error code: %code and Message: %message."
msgstr "Url istenirken hata oluştu: hata kodu: %code ve ileti: %message."

msgid "Request HTTP data"
msgstr "HTTP verileri iste"

msgid "Data"
msgstr "Veri"

msgid "URL"
msgstr "URL"

msgid "Url address where to post, get and delete request send."
msgstr "Gönderme, alma ve silme isteğinin gönderileceği url adresi."

msgid "Headers"
msgstr "Üstbilgiler"

msgid "Request headers to send as 'name: value' pairs, one per line (e.g., Accept: text/plain). See <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a> for more information."
msgstr "Satır başına bir adet olmak üzere, 'name: value' olarak gönderilecek üstbilgiler isteyin (örn, Kabul et: metin/düz). Daha fazla bilgi için bkz. <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a>."

msgid "Method"
msgstr "Yöntem"

msgid "The HTTP request methods like'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH' etc."
msgstr "HTTP isteği yöntemleri: 'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH' gibi."

msgid "The request body, formatter as 'param=value&param=value&...' or one 'param=value' per line.."
msgstr "'param=value&param=value&...' olarak biçimleyici veya satır başına bir 'param=value' olarak istek gövdesi.."

msgid "Max Redirect"
msgstr "Maks Yeniden Yönlendirme"

msgid "How many times a redirect may be followed."
msgstr "Bir yeniden yönlendirmenin izlenebileceği sayı."

msgid "Timeout"
msgstr "Zamanaşımı"

msgid "The maximum number of seconds the request may take.."
msgstr "İsteğin alabileceği maksimum saniye sayısı.."

msgid "HTTP data"
msgstr "HTTP verileri"

