msgid "About"
msgstr "Over"

msgid "Provides support for the hreflang meta tag with some extra logic to simplify it."
msgstr "Biedt ondersteuning voor de metatag hreflang met wat extra logica om deze te vereenvoudigen."

msgid "Metatag: Hreflang"
msgstr "Metatag: Hreflang"

msgid "SEO"
msgstr "SEO"

msgid "Default locale (x-default)"
msgstr "Standaardlocale (x-default)"

msgid "Href per language"
msgstr "Href per taal"

msgid "URL for a version of this page in %langcode"
msgstr "URL voor een versie van deze pagina in %langcode"

msgid "Alternative language links (hreflang)"
msgstr "Alternatieve-taallinks (hreflang)"

msgid "These meta tags are designed to point visitors to versions of the current page in other languages."
msgstr "Deze metatags hebben als doel bezoekers te verwijzen naar versies van de huidige pagina in andere talen."

msgid "Hreflang per language"
msgstr "Hreflang per taal"

msgid "This plugin will be cloned from these settings for each enabled language."
msgstr "Deze plugin wordt voor elke ingeschakelde taal gekloond op basis van deze instellingen."

msgid "This should point to the version of the page that is for the main or primary locale, e.g. the original version of an article that is translated into other languages."
msgstr "Dit moet verwijzen naar de versie van de pagina die bedoeld is voor de hoofd- of primaire locale, bijvoorbeeld de oorspronkelijke versie van een artikel dat in andere talen is vertaald."

