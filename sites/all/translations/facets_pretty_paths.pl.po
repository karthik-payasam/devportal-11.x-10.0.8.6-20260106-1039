msgid "Pretty paths coder"
msgstr "Koder ładnych ścieżek"

msgid "Facets Pretty Paths"
msgstr "Ładne ścieżki aspektów"

msgid "Pretty paths for Facets."
msgstr "Ładne ścieżki aspektów."

msgid "Search"
msgstr "Szukaj"

msgid "Facet Pretty Paths third party settings on the Facet config"
msgstr "Ustawienia innych firm dla ładnych ścieżek aspektów w konfiguracji aspektu"

msgid "The coder plugin ID"
msgstr "Identyfikator wtyczki kodera"

msgid "Home"
msgstr "Strona główna"

msgid "Pretty paths"
msgstr "Ładne ścieżki"

msgid "Pretty paths uses slashes as separator, e.g. /brand/drupal/color/blue"
msgstr "W ładnych ścieżkach jako separatory są używane ukośniki, np. /marka/drupal/kolor/niebieski."

msgid "Default"
msgstr "Domyślny"

msgid "Use the raw value, no special processing is done, e.g. /color/<strong>2</strong>"
msgstr "Użyj wartości surowej. Nie jest wykonywane żadne specjalne przetwarzanie. Na przykład: /kolor/<strong>2</strong>."

msgid "Node title + id"
msgstr "Tytuł węzła + identyfikator"

msgid "Use node title with entity id, e.g. /color/<strong>blue-2</strong>"
msgstr "Użyj tytułu węzła z identyfikatorem jednostki, np. /kolor/<strong>niebieski-2</strong>"

msgid "Taxonomy term name + id"
msgstr "Nazwa terminu systematyki + identyfikator"

msgid "Use term name with term id, e.g. /color/<strong>blue-2</strong>"
msgstr "Użyj nazwy terminu z identyfikatorem terminu, np. /kolor/<strong>niebieski-2</strong>."

