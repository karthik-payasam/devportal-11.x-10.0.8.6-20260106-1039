msgstr "L'entrée de journal expliquant les changements dans cette révision."

msgid "Crop"
msgstr "Recadrer"

msgid "Are you sure you want to delete the crop type %type?"
msgstr "Voulez-vous vraiment supprimer le type de cadrage %type ?"

msgid "The crop type %name has been deleted."
msgstr "Le type de recadrage %name a été supprimé."

msgid "Deleted crop type %name."
msgstr "Type de recadrage %name supprimé."

msgid "%type is used by 1 piece of content on your site. You can not remove this content type until you have removed all of the %type content."
msgid_plural "%type is used by @count pieces of content on your site. You may not remove %type until you have removed all of the %type content."
msgstr[0] "%type est utilisé par un contenu du site. Vous ne pouvez pas supprimer ce type de contenu tant que vous n'avez pas supprimé tous les contenus du type %type."
msgstr[1] "%type est utilisé par @count contenus du site. Vous ne pouvez pas supprimer ce type de contenu tant que vous n'avez pas supprimé tous les contenus du type %type."

msgid "Edit %label crop type"
msgstr "Modifier le type de recadrage %label"

msgid "The human-readable name of this crop type. This name must be unique."
msgstr "Le nom affiché de ce type de recadrage. Il doit être unique."

msgid "A unique machine-readable name for this crop type. It must only contain lowercase letters, numbers, and underscores."
msgstr "Nom lisible unique de ce type de cadrage. Il ne doit contenir que des minuscules, des chiffres et des traits de soulignement."

msgid "Describe this crop type."
msgstr "Décrire ce type de recadrage."

msgid "Set an aspect ratio <b>eg: 16:9</b> or leave this empty for arbitrary aspect ratio"
msgstr "Définissez un rapport hauteur/largeur, <b>par exemple 16:9</b>, ou laissez cette zone vide pour un rapport hauteur/largeur arbitraire "

msgid "Soft limit"
msgstr "Limite recommandée"

msgid "Define crop size soft limit. Warning will be displayed if crop smaller than that is selected."
msgstr "Définissez la limite flexible pour la taille du cadrage. Un avertissement s'affiche si le cadrage est plus petit que celui sélectionné. "

msgid "Limit for width."
msgstr "Limite pour la largeur."

msgid "Limit for height."
msgstr "Limite pour la hauteur."

msgid "Hard limit"
msgstr "Limite stricte"

msgid "Define crop size hard limit. User is not allowed to make a smaller selection than defined here."
msgstr "Définissez la limite absolue pour la taille du cadrage. L'utilisateur ne peut pas effectuer une sélection plus petite que celle définie ici. "

msgid "Limit for width"
msgstr "Limite pour la largeur"

msgid "Save crop type"
msgstr "Enregistrer le type de recadrage"

msgid "Delete crop type"
msgstr "Supprimer le type de recadrage"

msgid "The crop type %name has been updated."
msgstr "Le type de recadrage %name a été mis à jour."

msgid "The crop type %name has been added."
msgstr "Le type de recadrage %name a été ajouté."

msgid "View"
msgstr "Voir"

msgid "Added crop type %name."
msgstr "Type de recadrage %name ajouté."

msgid "File"
msgstr "Fichier"

msgid "Provides crop integration for core files."
msgstr "Fournit l'intégration du cadrage pour les fichiers de base. "

msgid "Provides crop integration for media."
msgstr "Fournit l'intégration du cadrage pour le média."

msgid "Crop type to be used for the image style."
msgstr "Type de cadrage à utiliser pour le style d'image. "

msgid "- Select a Provider -"
msgstr "- Sélectionner un fournisseur -"

msgid "The name of automatic crop provider to use if crop is not set for an image."
msgstr "Nom du fournisseur de culture automatique à utiliser si la culture n'est pas définie pour une image."

msgid "Manual image crop failed due to misconfigured crop type on %path."
msgstr "Le cadrage manuel de l'image a échoué car le type de cadrage n'est pas configuré correctement dans %path."

msgid "Manual image crop failed using the %toolkit toolkit on %path (%mimetype, %width x %height)"
msgstr "Le cadrage manuel de l'image à l'aide du kit d'outils %toolkit a échoué dans %path (%mimetype, %width x %height)"

msgid "Manual crop"
msgstr "Recadrage manuel"

msgid "Applies manually provided crop to the image."
msgstr "Applique manuellement le cadrage fourni à l'image. "

