msgid "Facets summary (Experimental)"
msgstr "Souhrn fazet (experimentální)"

msgid "Exposes a Facets block summary showing the current search."
msgstr "Odkrývá souhrn bloku fazety zobrazující aktuální vyhledávání."

msgid "Search"
msgstr "Vyhledávání"

msgid "Add facet summary"
msgstr "Přidat souhrn fazety"

msgid "Edit facets summary"
msgstr "Upravit souhrn fazet"

msgid "Edit"
msgstr "Upravit"

msgid "Facet Summary settings"
msgstr "Nastavení souhrnu fazety"

msgid "Facet"
msgstr "Fazeta"

msgid "ID"
msgstr "ID"

msgid "Name"
msgstr "Název"

msgid "Facet source id"
msgstr "ID zdroje fazety"

msgid "Processor settings"
msgstr "Nastavení procesoru"

msgid "A processor"
msgstr "Procesor"

msgid "The plugin ID of the processor"
msgstr "ID modulu plug-in procesoru"

msgid "The processors weight for this stage"
msgstr "Váha procesorů pro tuto fázi"

msgid "the weight"
msgstr "váha"

msgid "Facets configuration"
msgstr "Konfigurace fazet"

msgid "Is this facet enabled"
msgstr "Je tato fazeta povolena"

msgid "Label"
msgstr "Štítek"

msgid "Results separator"
msgstr "Oddělovač výsledků"

msgid "Show count on items"
msgstr "Zobrazit počet položek"

msgid "Facet Weight"
msgstr "Váha fazety"

msgid "No results behavior"
msgstr "Chování při nenalezení žádných výsledků"

msgid "The text to show when there is no current search"
msgstr "Text, který se má zobrazit v případě, že neexistuje žádné aktuální hledání"

msgid "Reset facets link"
msgstr "Odkaz pro resetování fazet"

msgid "The text to show for the reset link."
msgstr "Text, který má být zobrazen pro odkaz na resetování."

msgid "Position of the reset link."
msgstr "Pozice odkazu na reset."

msgid "Processor @id specifies a non-existing @class."
msgstr "Procesor @id určuje neexistující třídu @class."

msgid "Facet summary"
msgstr "Souhrn fazety"

msgid "Edit %label facets summary"
msgstr "Upravit %label souhrnu fazet"

msgid "Enabled facets"
msgstr "Povolené fazety"

msgid "Separator"
msgstr "Oddělovač"

msgid "Show counts"
msgstr "Zobrazit počty"

msgid "Weight"
msgstr "Váha"

msgid "Select the facets to be shown in the summary block. You can reorder them."
msgstr "Vyberte fazety, které mají být zobrazeny v souhrnném bloku. Můžete změnit jejich pořadí."

msgid "Weight for @title"
msgstr "Váha pro @title"

msgid "No facets found."
msgstr "Nebyly nalezeny žádné fazety."

msgid "Facets Summary settings"
msgstr "Nastavení souhrnu fazet"

msgid "%processor settings"
msgstr "Nastavení %processor"

msgid "Advanced settings"
msgstr "Rozšířené nastavení"

msgid "Processor order"
msgstr "Pořadí procesoru"

msgid "Weight for processor %title"
msgstr "Váha pro procesor %title"

msgid "Facets Summary %name has been updated."
msgstr "Souhrn fazet %name byl aktualizován."

msgid "Add facets summary"
msgstr "Přidat souhrn fazet"

msgid "Facets settings for %label"
msgstr "Nastavení fazet pro %label"

msgid "You currently have no facet sources defined. You should start by adding a facet source before creating facets."
msgstr "Aktuálně nejsou definovány žádné zdroje fazet. Před vytvářením fazet byste měli začít přidáním zdroje fazet."

msgid "Facet source"
msgstr "Zdroj fazety"

msgid "The source where this summary will be built from."
msgstr "Zdroj, ze kterého bude tento souhrn sestaven."

msgid "The administrative name used for this summary."
msgstr "Administrativní název použitý pro tento souhrn."

msgid "Facet Summary %name has been created. Go to the <a href=\":block_overview\">Block overview page</a> to place the new block in the desired region."
msgstr "Byl vytvořen souhrn fazety %name. Chcete-li umístit nový blok do požadované oblasti, přejděte na <a href=\":block_overview\">Stránku přehledu bloků</a>."

msgid "Facet %name has been updated."
msgstr "Fazeta %name byla aktualizována"

msgid "Caching of view %view has been disabled."
msgstr "Ukládání pohledu %view do mezipaměti bylo zakázáno"

msgid "Facet Summary: :facet_summary"
msgstr "Souhrn fazety: :souhrn fazety"

msgid "Facets Summary"
msgstr "Souhrn fazet"

msgid "In preview"
msgstr "V náhledu"

msgid "Hide Summary when Facet Source is not rendered"
msgstr "Skrýt souhrn, když není vykreslen zdroj fazety"

msgid "When checked, this facet will only be rendered when the facet source is rendered. If you want to show facets on other pages too, you need to uncheck this setting."
msgstr "Je-li toto políčko zaškrtnuto, bude tato fazeta vykreslena pouze v případě vykreslení zdroje fazety. Chcete-li zobrazit fazety i na jiných stránkách, musíte zaškrtnutí tohoto nastavení zrušit."

msgid "Reset"
msgstr "Resetovat"

msgid "Reset facets link text"
msgstr "Text odkazu pro resetování fazet"

msgid "Show reset link before facets links"
msgstr "Zobrazit odkaz na reset před odkazy na fazety"

msgid "Show reset link after facets links"
msgstr "Zobrazit odkaz na reset po odkazech na fazety"

msgid "Show only reset link"
msgstr "Zobrazit pouze odkaz na reset"

msgid "Position"
msgstr "Pozice"

msgid "Set position of the link to display it before, after or instead of facets links."
msgstr "Nastavte pozici odkazu tak, aby byl zobrazen před, po nebo namísto odkazů na fazety."

msgid "Adds reset facets link."
msgstr "Přidá odkaz pro resetování fazet"

msgid "When checked, this facet will add a link to reset enabled facets."
msgstr "Je-li toto políčko zaškrtnuto, přidá tato fazeta odkaz pro resetování povolených fazet."

msgid "Show a summary of how many results were found"
msgstr "Zobrazit souhrn počtu nalezených výsledků"

msgid "When checked, this will show the amount of results found."
msgstr "Je-li toto políčko zaškrtnuto, zobrazí se počet nalezených výsledků."

msgid "Show a summary of all selected facets"
msgstr "Zobrazit souhrn všech vybraných fazet"

msgid "When checked, this facet will show an imploded list of all selected facets."
msgstr "Je-li toto políčko zaškrtnuto, zobrazí tato fazeta implodovaný seznam všech vybraných fazet."

msgid "Empty text"
msgstr "Prázdný text"

msgid "No results found."
msgstr "Nebyly nalezeny žádné výsledky."

msgid "Show a text when there are no results"
msgstr "Zobrazit text, pokud nejsou k dispozici žádné výsledky"

msgid "Show a text when there are no results, otherwise it will hide the block."
msgstr "Zobrazit text, pokud nejsou k dispozici žádné výsledky, jinak se blok skryje."

msgid "Build stage"
msgstr "Fáze sestavení"

msgid "1 result found"
msgid_plural "@count results found"
msgstr[0] "Byl nalezen 1 výsledek"
msgstr[1] "Počet nalezených výsledků je @count"
msgstr[2] "Počet nalezených výsledků je @count"

