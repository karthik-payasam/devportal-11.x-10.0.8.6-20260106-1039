msgstr "Destino padrão"

msgid "Remove target attribute"
msgstr "Remover o atributo-alvo"

msgid "Open in a new browser window or tab (_blank)"
msgstr "Abrir em uma nova janela ou guia do navegador (_blank)"

msgid "Open in the current window (_self)"
msgstr "Abrir na janela atual (_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "Abra na estrutura superior à estrutura na qual o link se encontra (_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "Cancelar todos os quadros e abrir em janela inteira do navegador (_top)"

