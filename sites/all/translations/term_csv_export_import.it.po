msgid "No destination directory provided."
msgstr "Non è stata fornita nessuna directory di destinazione."

msgid "About"
msgstr "Informazioni"

msgid "Helper module to quickly import a list of terms with parent structure."
msgstr "Modulo Helper per importare rapidamente un elenco di termini con struttura parent."

msgid "Term CSV Export/Import"
msgstr "Termine Esporta/Importa CSV"

msgid "Import and Export Taxonomy terms as csv."
msgstr "Importa e esporta termini di tassonomia come csv."

msgid "Taxonomy"
msgstr "Tassonomia"

msgid "Import and Export Taxonomy Terms as CSV"
msgstr "Importa e esporta termini di tassonomia come CSV."

msgid "Term CSV Import"
msgstr "Termine Importa CSV"

msgid "Term CSV Export"
msgstr "Termine Esporta CSV"

msgid "Administer CSV Term Import"
msgstr "Amministra termine CSV import"

msgid "Allows a user to import taxonomy terms."
msgstr "Consente ad un utente di importare termini di tassonomia."

msgid "CSV Term Import"
msgstr "Importazione termine CSV"

msgid "CSV Term Export"
msgstr "Esportazione termine CSV"

msgid "The header keys were not included in the import."
msgstr "Le chiavi di intestazione non sono state incluse nell'importazione."

msgid "Line with \"@part\" could not be parsed. Incorrect number of values: @count."
msgstr "La riga con \"@part\" non può essere analizzata. Numero di valori non corretto: @count."

msgid "The term @name has multiple matches. Ignoring."
msgstr "Il termine @name ha molteplici corrispondenze. Verrà ignorato."

msgid "The term with id @id already exists and preserve existing terms is checked. No modification has been made."
msgstr "Il termine con id @id già esiste e conserva i termini esistenti.Non è stata effettuata nessuna modifica."

msgid "The Term ID already exists."
msgstr "L'ID termine esiste già."

msgid "More than 1 terms are named @name. Cannot distinguish by name. Try using id export/import."
msgstr "Più di 1 termine è denominato @name. Impossibile distinguerli per nome. Provare ad utilizzare l'esportazione/importazione dell'ID."

msgid "The field data <em>@data</em> is not formatted correctly. Please use the export function."
msgstr "Il campo dati <em>@data</em> non è formattato correttamente. Utilizzare la funzione di esportazione."

msgid "The field data <em>@data</em> could not be imported. Please add the appropriate fields to the vocabulary you are importing into."
msgstr "Non è stato possibile importare i dati del campo <em>@data</em>. Aggiungere i campi appropriati al vocabolario in cui si sta importando."

msgid "Imported @count terms."
msgstr "Importati @count termini."

msgid "Include Term Ids in export."
msgstr "Includere gli ID dei termini nell'esportazione."

msgid "Include Term Headers in export."
msgstr "Includere le intestazioni dei termini nell'esportazione."

msgid "Include extra fields in export."
msgstr "Includere campi supplementari nell'esportazione."

msgid "Note that fields are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"
msgstr "Notare che i campi vengo trasformati in stringhe usando <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"

msgid "Export"
msgstr "Esporta"

msgid "CSV Data"
msgstr "Dati CSV"

msgid "The formatted term data"
msgstr "I dati dei termini formattati"

msgid "Input"
msgstr "Immissione"

msgid "<p><strong>See CSV Export for an example.</strong></p><p>Enter in the form of: <pre>\"name,status,description,format,weight,parent_name,[any_additional_fields];</pre><pre>name,status,description,format,weight,parent_name[;parent_name1;parent_name2;...],[any_additional_fields]\"</pre> or <pre>\"tid,uuid,name,status,revision_id,description,format,weight,parent_name[;parent_name1;parent_name2;...],parent_tid[;parent_tid1;parent_tid2;...],[any_additional_fields];</pre><pre>tid,uuid,name,status,revision_id,description,format,weight,parent_name,parent_tid,[any_additional_fields]\"</pre> Note that <em>[any_additional_fields]</em> are optional and are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>If you need to export from Drupal 7, you can import and modify the view d7exportview.txt found at the root directory of this project</p>"
msgstr "<p><strong>Consultare l'esportazione CSV per un esempio.</strong></p><p>Immettere in forma di: <pre>\"name,status,description,format,weight,parent_name,[any_additional_fields];</pre><pre>name,status,description,format,weight,parent_name[;parent_name1;parent_name2;...],[any_additional_fields]\"</pre> o <pre>\"tid,uuid,name,status,revision_id,description,format,weight,parent_name[;parent_name1;parent_name2;...],parent_tid[;parent_tid1;parent_tid2;...],[any_additional_fields];</pre><pre>tid,uuid,name,status,revision_id,description,format,weight,parent_name,parent_tid,[any_additional_fields]\"</pre> Notare che <em>[any_additional_fields]</em> sono facoltativi e sono trasformati in stringhe usando <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>Se è necessario esportare da Drupal 7, è possibile importare e modificare la vista d7exportview.txt trovata nella directory root di questo progetto. </p>"

msgid "Preserve Vocabularies on existing terms."
msgstr "Conservare i vocabulari su termini esistenti."

msgid "Preserve existing terms. This will prevent a term id collision if importing from another install."
msgstr "Conservare i termini esistenti. Ciò eviterà un conflitto di ID del termine se viene importato da un'altra installazione. "

msgid "Next"
msgstr "Seguente"

msgid "Name"
msgstr "Nome"

msgid "Create New Vocabulary"
msgstr "Crea nuovo vocabolario"

msgid "Create Vocabulary"
msgstr "Crea vocabolario"

msgid "Are you sure you want to copy @count_terms terms into the vocabulary @vocabulary@preserve_vocabularies?"
msgstr "Si è sicuri di voler copiare @count_terms termini nel vocabolario @vocabulary@preserve_vocabularies?"

msgid "Import"
msgstr "Importa"

