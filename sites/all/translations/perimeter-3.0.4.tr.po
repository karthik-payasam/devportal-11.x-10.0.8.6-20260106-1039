msgid "Allowlist skipping ban: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "İzin listesi atlama cezaı: %form üzerinde %type konusunda başarısız olunduğu için %ip <br />Kaynak: %source <br /> Kullanıcı Aracı: %browser"

msgid "Banned: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Yasaklandı: %form %type için başarısız olduğundan %ip <br />Kaynak: %source <br /> Kullanıcı Aracısı: %browser"

msgid "Drupal Perimeter Defence"
msgstr "Drupal Perimetre Savunması"

msgid "Immediately ban hackers when they try to scan the site."
msgstr "Siteyi taramaya çalıştıklarında anında saldırganları yasakla."

msgid "Perimeter defence settings"
msgstr "Perimetre koruma ayarları"

msgid "Configure the settings for Drupal Perimeter Defence."
msgstr "Drupal Perimeter Defence ayarlarını yapılandırın."

msgid "Bypass Perimeter Defence ban rules"
msgstr "Çevre Savunma yasağı kurallarını atla"

msgid "Allow users to bypass the rules defined by Perimeter Defence module."
msgstr "Kullanıcıların, Çevre Savunma modülü tarafından tanımlanan kuralları atlamasına izin verin."

msgid "Perimeter settings"
msgstr "Perimetre ayarları"

msgid "Perimeter Settings"
msgstr "Perimetre Ayarları"

msgid "A list of regex patterns"
msgstr "Regex kalıpları listesi"

msgid "A regex pattern"
msgstr "Bir regex kalıbı"

msgid "Banned: %ip for requesting %pattern <br />Source: %source <br /> User Agent: %browser"
msgstr "Yasaklı: %ip for requesting %pattern <br />Kaynak: %source <br /> Kullanıcı Aracısı: %browser"

msgid "Perimeter will ban any user that generates \"404 - File not found\" for requesting any of the following url pattern"
msgstr "Perimetre, aşağıdaki url kalıbından birini istemek için \"404 - Dosya bulunamadı\" oluşturan bir kullanıcıyı yasaklar"

msgid "Ban URL patterns"
msgstr "URL kalıplarını yasakla"

msgid "A list of regex patterns, each pattern on a separate line"
msgstr "Her kalıp ayrı satırda olacak şekilde regex kalıpları listesi"

