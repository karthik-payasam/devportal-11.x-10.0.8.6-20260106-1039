msgid "Password Username Policy"
msgstr "Kennwort-Benutzernamens-Richtlinie"

msgid "Restrict users from having their username in their password."
msgstr "Nicht zulassen, dass das Kennwort von Benutzern deren Benutzernamen enthält."

msgid "Security"
msgstr "Sicherheit"

msgid "Disallow username"
msgstr "Benutzernamen nicht zulassen"

msgid "Password must not contain the username."
msgstr "Kennwort darf den Benutzernamen nicht enthalten."

msgid "Prevent user from having a password containing their username."
msgstr "Verhindern, dass Benutzer ein Kennwort haben, das ihren Benutzernamen enthält."

msgid "Password must not contain the user's username."
msgstr "Kennwort darf den Benutzernamen des Benutzers nicht enthalten."

msgid "Password username"
msgstr "Kennwort und Benutzername"

msgid "Password must not contain their username"
msgstr "Kennwort darf den Benutzernamen nicht enthalten"

msgid "Your password contains your username."
msgstr "Ihr Kennwort enthält Ihren Benutzernamen."

