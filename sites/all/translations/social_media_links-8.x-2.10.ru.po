msgstr "Вес"

msgid "Platforms"
msgstr "Платформы"

msgid "The platforms that are allowed to be used in this field. Select none to allow all platforms."
msgstr "Платформы, которые разрешено использовать в этом поле. Выберите значение none, чтобы разрешить все платформы."

msgid "The description is used for the title and WAI-ARIA attribute."
msgstr "Описание, применяемое для заголовка и атрибута WAI-ARIA."

msgid "Find / Follow us on %platform"
msgstr "Следите за нами в %platform"

msgid "Weight for type @type"
msgstr "Вес типа @type"

msgid "Handle links to social media profiles."
msgstr "Обрабатывать ссылки на профайлы в социальных сетях."

msgid "List with all available platforms"
msgstr "Все доступные платформы"

msgid "One available platform (selectable)"
msgstr "Одна доступная платформа (с возможностью выбора)"

msgid "The entered value %value is a URL. You should enter only the relative part, the URL prefix is automatically prepended."
msgstr "Введенное значение %value является полным URL. Необходимо указать только относительный путь - префикс URL добавляется автоматически."

msgid "Platform URL"
msgstr "URL платформы"

msgid "Weight for @title"
msgstr "Вес @title"

msgid "Theme hook suggestion"
msgstr "Предложение перехватчика темы"

msgid "A theme hook suggestion can be used to override the default HTML and CSS found in <code>social-media-links-platforms.html</code>."
msgstr "Предложение перехватчика темы позволяет переопределить HTML и CSS по умолчанию из файла <code>social-media-links-platforms.html</code>."

msgid "The theme hook suggestion must contain only lowercase letters, numbers, and underscores."
msgstr "Предложение перехватчика темы должно содержать только буквы с нижнем регистре, цифры и символы подчеркивания. "

