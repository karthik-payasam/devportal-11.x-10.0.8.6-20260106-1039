msgid "About"
msgstr "Информация"

msgid "The modules provides a configurable block that display links (icons) to your profiles on various popular networking sites."
msgstr "Модули предоставляют настраиваемый блок с ссылками (значками) на профайлы на популярных сайтах. "

msgid "Installation"
msgstr "Установка"

msgid "Install as usual, see <a href=\":documentation\">installing contributed modules</a> for further information."
msgstr "Дополнительная информация об установке приведена в разделе <a href=\":documentation\">Установка дополнительных модулей</a>. "

msgid "The module has no special configuration. All settings are available in the block settings: /admin/structure/block."
msgstr "Специальная конфигурация не требуется. Все параметры доступны в параметрах блока: /admin/structure/block."

msgid "Included icon sets"
msgstr "Включенные наборы значков"

msgid "The module contains a icon set, that the module is ready for use immediately after the installation."
msgstr "Модуль содержит набор значков, которые можно использовать сразу после установки. "

msgid "Social Media Links Block"
msgstr "Блок ссылок на социальные сети"

msgid "The module provides a block that display links (icons) to your profiles on various social networking sites."
msgstr "Этот модуль предоставляет блок с ссылками (значками) на профайлы в популярных социальных сетях. "

msgid "Social Media Links Field"
msgstr "Поле ссылок на социальные сети"

msgid "The module provides a field type to capture social media profiles."
msgstr "Модуль предоставляет тип поля для сохранения профайлов в социальных сетях. "

msgid "Platform"
msgstr "Платформа"

msgid "Appearance"
msgstr "Оформление"

msgid "Orientation"
msgstr "Ориентация"

msgid "vertical"
msgstr "вертикальный"

msgid "horizontal"
msgstr "горизонтальный"

msgid "Show name"
msgstr "Показать имя"

msgid "Show the platform name next to the icon."
msgstr "Показать имя платформы рядом со значком."

msgid "Link attributes"
msgstr "Атрибуты ссылки"

msgid "Default target"
msgstr "Целевой объект по умолчанию"

msgid "Remove target attribute"
msgstr "Удалить атрибут целевого объекта "

msgid "Open in a new browser window or tab (_blank)"
msgstr "Открыть в новом окне или на новой вкладке браузера (_blank)"

msgid "Open in the current window (_self)"
msgstr "Открыть в текущем окне (_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "Открыть во фрейме на уровне выше фрейма ссылки (_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "Отменить все фреймы и открыть в полном окне браузера (_top)"

msgid "Default rel"
msgstr "Атрибут rel по умолчанию"

msgid "Remove rel attribute"
msgstr "Удалить атрибут rel"

msgid "Set nofollow"
msgstr "Задать атрибут nofollow"

