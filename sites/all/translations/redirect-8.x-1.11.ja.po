msgstr "リダイレクトがまだ割り当てられていない 404 エラーのパスの概要。"

msgid "Path"
msgstr "パス"

msgid "The path of the request."
msgstr "要求のパス。"

msgid "The language of this request."
msgstr "この要求の言語。"

