msgid "Defuse PHP-Encryption library"
msgstr "Bibliothèque de désamorçage du chiffrement PHP"

msgid "Installed"
msgstr "Installé"

msgid "Not Installed"
msgstr "Non installé"

msgid "Please install the Defuse PHP-encryption library via Composer. See README.txt"
msgstr "Veuillez installer la bibliothèque de désamorçage du chiffrement PHP via Composer. Consultez le fichier README.txt"

msgid "Real AES"
msgstr "AES réel"

msgid "Provides an Authenticated AES encryption method for Encrypt through the Defuse PHP Encryption library."
msgstr "Fournit une méthode de chiffrement AES authentifié pour Encrypt via la bibliothèque Defuse PHP Encryption."

msgid "Security"
msgstr "Sécurité"

msgid "Defuse PHP Encryption library is not correctly installed."
msgstr "La bibliothèque de désamorçage du chiffrement PHP n'est pas installée correctement."

msgid "Authenticated AES (Real AES)"
msgstr "AES authentifié (AES réel)"

