msgid "Disable language"
msgstr "Zakázat jazyk"

msgid "This will remove the language from the language switcher and filter out the Simple XML sitemap"
msgstr "Tím odeberete jazyk z přepínače jazyka a odfiltrujete jednoduchou XML mapu webu"

msgid "Select language to which we redirect"
msgstr "Vyberte jazyk, do kterého přesměrováváme"

msgid "This option will redirect to the selected language when a user calls the disabled language"
msgstr "Tato volba se přesměruje na vybraný jazyk, když uživatel zavolá zakázaný jazyk"

msgid "Disabled"
msgstr "Vypnuto"

msgid "Yes"
msgstr "Ano"

msgid "No"
msgstr "Ne"

msgid "Disable Language"
msgstr "Zakázat jazyk"

msgid "A module that lets you disable multiple languages."
msgstr "Modul, který umožňuje zakázat více jazyků."

msgid "Multilingual"
msgstr "Vícejazyčné"

msgid "Disable Language settings"
msgstr "Zakázat jazyková nastavení"

msgid "Configure the Disable Language module settings"
msgstr "Konfigurovat nastavení modulu Zakázat jazyk"

msgid "View disabled languages"
msgstr "Zobrazit zakázané jazyky"

msgid "Allows the user to see disabled languages"
msgstr "Umožňuje uživateli zobrazit zakázané jazyky"

msgid "Create content in disabled language"
msgstr "Vytvořit obsah v zakázaném jazyce"

msgid "Allows the user to create content in a disabled language"
msgstr "Umožňuje uživateli vytvářet obsah v zakázaném jazyce"

msgid "Disable Language Settings"
msgstr "Zakázat jazyková nastavení"

msgid "List of route names that will redirect to themselves in the right language instead of the frontpage when accessed in a disabled language."
msgstr "Seznam názvů tras, které budou přesměrovávat ve správném jazyce na sebe, nikoli jako u zakázaného jazyka na titulní stranu."

msgid "Redirect override route"
msgstr "Přesměrovat trasu přepsání"

msgid "Request path condition"
msgstr "Podmínka cesty k požadavku"

msgid "Disable language settings"
msgstr "Zakázat nastavení jazyka"

msgid "Language to redirect to"
msgstr "Jazyk k přesměrování na"

msgid "Help"
msgstr "Nápověda"

msgid "As we can't define appropriate cache invalidation, you will have to clear your cache after you save this form."
msgstr "Vzhledem k tomu, že nelze definovat příslušné zneplatnění mezipaměti, musíte vymazat mezipaměť po uložení tohoto formuláře."

msgid "Override routes"
msgstr "Přepsat trasy"

msgid "Enter route names (one per line) that should redirect to themselves in the correct language instead of the frontpage"
msgstr "Zadejte názvy tras (jeden na řádek), které by měly ve správném jazyce přesměrovat na sebe, namísto na titulní stranu"

msgid "Exclude by path"
msgstr "Vyloučit podle cesty"

