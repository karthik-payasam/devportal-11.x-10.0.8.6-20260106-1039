msgid "Client-side Hierarchical Select"
msgstr "Hiërarchische selectie op client"

msgid "A simple client-side hierarchical select widget for taxonomy terms."
msgstr "Een eenvoudige widget voor hiërarchische selectie op de client voor taxonomietermen."

msgid "Widgets"
msgstr "Widgets"

msgid "CSHS field widget settings"
msgstr "Instellingen voor CSHS-velden"

msgid "Save lineage"
msgstr "Afstamming opslaan"

msgid "Force selection of deepest level"
msgstr "Selectie van diepste niveau afdwingen"

msgid "Parent"
msgstr "Bovenliggend"

msgid "Labels per hierarchy-level"
msgstr "Labels per hiërarchisch niveau"

msgid "Hierarchy depth"
msgstr "Hiërarchiediepte"

msgid "Required depth"
msgstr "Vereiste diepte"

msgid "The \"no selection\" label"
msgstr "Het label \"geen selectie\""

msgid "Client-side Hierarchical Select: Menu Link"
msgstr "Hiërarchische selectie op client: menulink"

msgid "A client-side hierarchical selection of parents for the menu link. Works for node and term forms (with \"taxonomy_menu_ui\" enabled)."
msgstr "Een hiërarchische selectie op client van bovenliggende items voor de menulink. Werkt voor knooppunt- en termijnformulieren (met \"taxonomy_menu_ui\" ingeschakeld)."

msgid "Deepest"
msgstr "Diepste"

msgid "None"
msgstr "Geen"

msgid "Yes"
msgstr "Ja"

msgid "No"
msgstr "Nee"

msgid "Parent: @parent"
msgstr "Bovenliggend item: @parent"

msgid "Force deepest: @force_deepest"
msgstr "Diepste afdwingen: @force_deepest"

msgid "Save lineage: @save_lineage"
msgstr "Afstamming opslaan: @save_lineage"

msgid "Level labels: @level_labels"
msgstr "Niveaulabels: @level_labels"

msgid "The \"no selection\" label: @none_label"
msgstr "Het label \"geen selectie\": @none_label"

msgid "Select a parent term to use only a subtree of a vocabulary for this field."
msgstr "Selecteer een bovenliggende term als u alleen een substructuur van een vocabulaire voor dit veld wilt gebruiken."

msgid "Force the deepest level selection"
msgstr "De selectie van het diepste niveau forceren"

msgid "If checked the user will be forced to select terms from the deepest level."
msgstr "Als deze optie is geselecteerd, wordt de gebruiker gedwongen om termen te kiezen uit het diepste niveau."

msgid "Enter labels for each hierarchy-level separated by comma."
msgstr "Geef voor elk hiërarchisch niveau labels op, van elkaar gescheiden door komma's."

msgid "The label for an empty option."
msgstr "Het label voor een lege optie."

msgid "The hierarchy depth cannot be @actual because the selection list has @levels levels."
msgstr "De hiërarchiediepte kan niet @actual zijn, omdat de selectielijst @levels niveaus heeft."

msgid "The required depth cannot be greater than the hierarchy depth."
msgstr "De vereiste diepte kan niet groter zijn dan de hiërarchiediepte."

msgid "Format"
msgstr "Indeling"

msgid "Specify a format for each field item by using tokens."
msgstr "Geef voor elk velditem een indeling op met behulp van tokens."

msgid "Clear Tokens"
msgstr "Tokens wissen"

msgid "Remove token from final text if no replacement value is generated"
msgstr "Token verwijderen uit definitieve tekst als er geen vervangende waarde is gegenereerd"

msgid "Format: @format"
msgstr "Indeling: @format"

msgid "Flexible hierarchy"
msgstr "Flexibele hiërarchie"

msgid "Allows to specify the output with tokens."
msgstr "Hiermee kunt u de uitvoer met tokens opgeven."

msgid "Link to term page"
msgstr "Link naar termenpagina"

msgid "Reverse order view"
msgstr "Omgekeerde volgorde weergeven"

msgid "Outputs hierarchy in reverse order (the deepest level first)."
msgstr "Hiermee wordt de hiërarchie weergegeven in omgekeerde volgorde (eerst het diepste niveau)."

msgid "Linked to term page: @linked"
msgstr "Gekoppeld aan termenpagina: @linked"

msgid "Reverse order view: @reverse"
msgstr "Omgekeerde volgorde weergeven: @reverse"

msgid "Separator"
msgstr "Scheidingsteken"

msgid "Specify a separator which will be placed in between the different hierarchy levels."
msgstr "Geef een scheidingsteken op om tussen de verschillende hiërarchieniveaus te plaatsen."

msgid "Separator: @separator"
msgstr "Scheidingsteken: @separator"

msgid "Full hierarchy"
msgstr "Volledige hiërarchie"

msgid "Display the full hierarchy of the taxonomy term."
msgstr "Volledige hiërarchie van de taxonomieterm afbeelden."

msgid "Sorting"
msgstr "Sorteren"

msgid "Depth"
msgstr "Diepte"

msgid "The maximum hierarchy depth. Use 0 to not limit or 1 to display just the root term (or the last if reverse order selected)."
msgstr "De maximale hiërarchiediepte. Gebruik 0 om niet te beperken of 1 om alleen de hoofdterm (of de laatste als omgekeerde volgorde is geselecteerd) weer te geven."

msgid "Last child"
msgstr "Laatste onderliggende item"

msgid "Show only the root term and its deepest child."
msgstr "Toon alleen de hoofdterm en het diepste onderliggende item."

msgid "Sorting: @value"
msgstr "Sorteren: @value"

msgid "Depth: @value"
msgstr "Diepte: @value"

msgid "Last child only"
msgstr "Alleen laatste onderliggende item"

msgid "Unlimited"
msgstr "Onbeperkt"

msgid "Hierarchy grouped by root"
msgstr "Hiërarchie gegroepeerd op hoofddirectory"

msgid "Display the hierarchy of the taxonomy term grouped by root."
msgstr "Hiërarchie van de taxonomieterm gegroepeerd op hoofddirectory afbeelden."

msgid "Client-side hierarchical select"
msgstr "Hiërarchische selectie op client"

msgid "An invalid vocabulary is selected. Please change it in the options."
msgstr "Er is een ongeldige woordenlijst geselecteerd. Wijzig dit in de opties."

msgid "About"
msgstr "Over"

msgid "Settings"
msgstr "Instellingen"

msgid "Multi-lingual"
msgstr "Meertalig"

msgid "Supports multi-lingual terms localized with i18n_taxonomy module (Which is part of the i18n package)."
msgstr "Ondersteunt meertalige termen die zijn gelokaliseerd met module i18n_taxonomy (die deel uitmaakt van het i18n-pakket)."
