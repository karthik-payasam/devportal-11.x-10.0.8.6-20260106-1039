msgid "About"
msgstr "O stronie"

msgid "Enables metatags for custom routes"
msgstr "Włącza znaczniki meta dla tras niestandardowych"

msgid "Metatag Custom Routes (Paths)"
msgstr "Trasy niestandardowe znaczników meta (ścieżki)"

msgid "Allows assigning meta tags to be used on custom routes, equivalent to custom paths."
msgstr "Umożliwia przypisywanie znaczników meta do użycia na trasach niestandardowych, co jest równoważne ścieżkom niestandardowym."

msgid "SEO"
msgstr "SEO"

msgid "Add meta tag for custom route"
msgstr "Dodaj znacznik meta dla trasy niestandardowej"

msgid "Add custom metatag"
msgstr "Dodaj niestandardowy znacznik meta"

msgid "Route / Path"
msgstr "Trasa / ścieżka"

msgid "Enter the route (path) for this new configuration, starting with a leading slash.<br />Note: this must already exist as a path in Drupal."
msgstr "Wprowadź trasę (ścieżka) dla tej nowej konfiguracji, zaczynając od początkowego ukośnika. <br />Uwaga: ta ścieżka musi już istnieć jako ścieżka w systemie Drupal."

msgid "Submit"
msgstr "Zachowaj"

msgid "The path must begin with /"
msgstr "Ścieżka musi zaczynać się od znaku /"

msgid "The admin routes should not have metatags."
msgstr "Trasy administracyjne nie powinny mieć znaczników meta."

msgid "The entities routes metatags must be added by fields. @entity_type - @id"
msgstr "Znaczniki meta kierujące elementy muszą być dodawane według pól. @entity_type - @id"

msgid "There are already metatags created for this route."
msgstr "Dla tej trasy zostały utworzone już znaczniki meta."

msgid "The path does not exist as an internal Drupal route."
msgstr "Ścieżka nie istnieje jako wewnętrzna trasa Drupal."

msgid "Created metatags for the path: @url. Internal route: @route."
msgstr "Utworzono znaczniki meta dla ścieżki: @url. Trasa wewnętrzna: @route."

msgid "The metatags could not be created for the path: @url."
msgstr "Nie można utworzyć znaczników meta dla ścieżki: @url."

