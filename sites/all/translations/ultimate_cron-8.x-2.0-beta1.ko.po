msgstr "<strong>Any</strong>: 그냥 사용 가능한 스레드를 사용"

msgid "<strong>Fixed</strong>: Only run in one specific thread. The maximum number of threads is spread across the jobs."
msgstr "<strong>Fixed</strong>: 하나의 특정 스레드에서 실행됩니다. 스레드의 최대 수는 작업에 따라 커집니다."

msgid "<strong>1-?</strong>: Only run when a specific thread is invoked. This setting only has an effect when cron is run through cron.php with an argument ?thread=N or through Drush with --options=thread=N."
msgstr "<strong>1-?</strong>: 특정 스레드가 호출 될 때 실행됩니다. 이 설정은 인수와 함께 cron.php를 통해 실행하는 예약작업일 때 효과가 있습니다. ?thread=N 또는  --options=thread=N와 함께 Drush를 통해."

msgid "Cache bin"
msgstr "캐쉬함"

msgid "Select which cache bin to use for storing logs."
msgstr "로그를 저장하기 위해 사용되는 캐시함 선택."

msgid "Cache timeout"
msgstr "캐시 제한 시간"

msgid "Seconds before cache entry expires (0 = never, -1 = on next general cache wipe)."
msgstr "캐쉬 항목이 만료되기 전의 시간(초) (0 = 만료없음, -1 = 다음 캐쉬 삭제 후)."

msgid "Remove logs older than a specified age"
msgstr "지정된 날보다 오래된 로그를 제거"

msgid "Retain only a specific amount of log entries"
msgstr "로그 항목만 특정 크기를 유지"

msgid "Log entry cleanup method"
msgstr "로그 항목 정리 방법"

msgid "Select which method to use for cleaning up logs."
msgstr "로그를 청소할 방법을 선택합니다."

msgid "Log entry expiration"
msgstr "로그 항목 만료"

msgid "Remove log entries older than X seconds."
msgstr "X 초보다 오래된 로그 항목을 제거합니다."

msgid "Retain logs"
msgstr "로그를 보관"

msgid "Retain X amount of log entries."
msgstr "로그 항목의 X 양을 보관하십시오."

msgid "Catch up"
msgstr "따라 잡기"

msgid "Don't run job after X seconds of rule."
msgstr "규칙의 X초 후에 작업을 실행하지 마십시오."

msgid "Rules"
msgstr "규칙"

msgid "Semi-colon separated list of crontab rules."
msgstr "cron 탭 규칙의 세미 콜론으로 구분된 목록입니다. "

msgid "Rules help"
msgstr "규칙 도움말"

msgid "Run cron every"
msgstr "아래 주기로 정기 작업 실행"

msgid "Select the interval you wish cron to run on."
msgstr "예약 작업을 실행하고자 하는 간격을 선택합니다."

msgid "running"
msgstr "실행 중"

msgid "unfinished but not locked?"
msgstr "완료되지 않았지만 잠겨 있지 않습니까? "

msgid "Cleaned up @count expired locks"
msgstr "@count개의 만기된 잠금을 정리"

msgid "N/A"
msgstr "해당 없음"

msgid "anonymous"
msgstr "익명사용자"

msgid "by"
msgstr "등록자"

msgid "Registered at @datetime"
msgstr "@datetime에 등록"

msgid "no info"
msgstr "아무런 정보가 없습니다"

msgid "-- Any -- "
msgstr "-- 모두 -- "

msgid "-- Fixed -- "
msgstr "-- 고정 -- "

msgid "Which thread to run in when invoking with ?thread=N. Note: This setting only has an effect when cron is run through cron.php with an argument ?thread=N or through Drush with --options=thread=N."
msgstr "?thread=N으로 호출할 때 실행할 스레드입니다. 참고: 이 설정은 cron이 ?thread=N 인수와 함께 cron.php를 통해서나 --options=thread=N과 함께 Drush를 통해 실행될 때에만 적용됩니다. "

msgid "%title must be greater than 0"
msgstr "%title은(는) 0보다 커야 함"

msgid "Launched in thread @current_thread"
msgstr "@current_thread 스레드에서 시작됨"

msgid "Invalid thread available for starting launch thread"
msgstr "시작 스레드를 시작하는 데 사용 가능한 올바르지 않은 스레드"

msgid "Thread @thread is already running"
msgstr "@thread 스레드가 이미 실행 중임"

msgid "No free threads available for launching jobs"
msgstr "작업 시작에 사용 가능한 여유 스레드가 없음"

msgid "Serial"
msgstr "시리얼"

msgid "Launches scheduled jobs in the same thread and runs them consecutively."
msgstr "동일 스레드에서 예약된 작업을 시작하고 연속적으로 실행합니다."

msgid "Stores the last log entry (and only the last) in the cache."
msgstr "캐시의 마지막 로그 엔트리(마지막만)를 저장"

msgid "Lock #@original_lid was already closed and logged. Creating a new log entry #@lid"
msgstr "#@original_lid 잠금이 이미 처리완료되었고 로그되었습니다. #@lid 새 로그 항목 작성"

msgid "@count_entries log entries removed for @jobs_count jobs"
msgstr "@count_entries 로그 항목이 @jobs_count 작업에 대해 제거됨"

msgid "Invalid cleanup method: @method"
msgstr "올바르지 않은 정리 메소드: @method"

msgid "Stores logs in the database."
msgstr "데이터베이스에 로그 저장"

msgid "Next scheduled run at @datetime"
msgstr "다음 @datetime에 실행 예정"

msgid "Comma separated list of crontab rules."
msgstr "쉼표를 사용하여 crontab 규칙의 목록을 분리."

msgid "Rule is invalid"
msgstr "규칙이 올바르지 않습니다. "

msgid "Use crontab rules for scheduling jobs."
msgstr "예약 작업에 대한 클론탭 규칙을 사용"

msgid "Every @interval"
msgstr "@interval 마다"

msgid "Provides a set of predefined intervals for scheduling."
msgstr "스케줄링 간격이 미리 정의된 세트를 제공합니다."

