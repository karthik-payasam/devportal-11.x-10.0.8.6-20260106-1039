msgid "VotingAPI tokens"
msgstr "VotingAPI トークン"

msgid "Dynamic Tokens for VotingAPI."
msgstr "VotingAPI の動的トークン。"

msgid "Vote count"
msgstr "投票カウント"

msgid "Number of votes."
msgstr "投票の数。"

msgid "Average Result"
msgstr "平均結果"

msgid "Average result of votes."
msgstr "投票の平均結果。"

msgid "Best Vote"
msgstr "最高の投票"

msgid "Best Vote cast."
msgstr "最高の投票数。"

