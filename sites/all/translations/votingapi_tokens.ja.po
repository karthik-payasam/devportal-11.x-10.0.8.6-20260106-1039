msgstr "最低の投票数。"

msgid "About"
msgstr "アバウト"

msgid "This module enables tokens for all entity types that has <kbd>voting_api_field</kbd>."
msgstr "このモジュールは、<kbd>voting_api_field</kbd> があるすべてのエンティティー・タイプでトークンを有効にします。"

msgid "Usage"
msgstr "使用法"

msgid "Tokens are dynamic and you have to pass <emph>vote_type</emph> as the last parameter. Module defines four tokens:"
msgstr "トークンは動的であり、最後のパラメーターとして <emph>vote_type</emph> を渡す必要があります。モジュールは、以下の 4 つのトークンを定義します。"

msgid "<ul><li>Vote count :: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"
msgstr "<ul><li>投票カウント :: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"

msgid "<li>Vote average :: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"
msgstr "<li>投票平均 :: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"

msgid "<li>Best vote :: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"
msgstr "<li>最高の投票 :: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"

msgid "<li>Worst vote :: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"
msgstr "<li>最低の投票 :: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"

msgid "Voting API Tokens"
msgstr "投票 API トークン"

msgid "Token support for Voting API"
msgstr "投票 API のトークン・サポート"

msgid "Voting"
msgstr "投票"

