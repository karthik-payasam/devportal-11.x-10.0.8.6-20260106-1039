msgid "Schema.org: JobPosting"
msgstr "Schema.org: JobPosting"

msgid "baseSalary"
msgstr "baseSalary"

msgid "RECOMMENDED BY GOOGLE. The base salary of the position."
msgstr "AANBEVOLEN DOOR GOOGLE. Het basissalaris voor de functie."

msgid "REQUIRED BY GOOGLE. Date and time when the job was posted."
msgstr "VEREIST DOOR GOOGLE. De datum en tijd waarop de vacature is geplaatst."

msgid "REQUIRED BY GOOGLE. The description of the position."
msgstr "VEREIST DOOR GOOGLE. Een beschrijving van de functie."

msgid "RECOMMENDED BY GOOGLE. The employment type of the jobPosting. Should be one of FULL_TIME, PART_TIME, CONTRACTOR, TEMPORARY, INTERN, VOLUNTEER, PER_DIEM, OTHER."
msgstr "AANBEVOLEN DOOR GOOGLE. Het type werk van de jobPosting. Moet een van de volgende zijn - FULL_TIME, PART_TIME, CONTRACTOR, TEMPORARY, INTERN, VOLUNTEER, PER_DIEM, OTHER."

msgid "REQUIRED BY GOOGLE. The organization offering the job position"
msgstr "VEREIST DOOR GOOGLE. De organisatie die de vacature aanbiedt."

msgid "Globally unique id of the job posting, usually a url."
msgstr "Globaal uniek ID van de taakposting, meestal een URL."

msgid "RECOMMENDED BY GOOGLE. The internal identifier of the position."
msgstr "AANBEVOLEN DOOR GOOGLE. Het interne ID van de functie."

msgid "The industry the job belongs to."
msgstr "De bedrijfstak waartoe de functie behoort."

msgid "The benefits of the position."
msgstr "De secundaire arbeidsvoorwaarden van de functie."

msgid "location"
msgstr "locatie"

msgid "REQUIRED BY GOOGLE. The location of the job."
msgstr "VEREIST DOOR GOOGLE. De locatie van de baan."

msgid "The necessary qualifications of the candidate."
msgstr "De noodzakelijke kwalificaties van de sollicitant."

msgid "The responsibilities in the job."
msgstr "De functieverantwoordelijkheden."

msgid "REQUIRED BY GOOGLE. The title of the job."
msgstr "VEREIST DOOR GOOGLE. De titel van de baan."

msgid "REQUIRED. The type of jobPosting."
msgstr "VEREIST. Het type jobPosting (vacature)."

msgid "REQUIRED BY GOOGLE. The date after which this job posting is not valid anymore."
msgstr "VEREIST DOOR GOOGLE. De datum waarna deze vacature niet meer geldig is."

