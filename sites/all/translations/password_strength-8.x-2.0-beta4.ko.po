msgid "Password Strength"
msgstr "Password Strength"

msgid "Sets up the Password Strength password constraint."
msgstr "Password Strength 비밀번호 제한조건을 설정합니다."

msgid "Security"
msgstr "보안"

msgid "Update Password Strength Settings"
msgstr "Password Strength 설정 업데이트"

msgid "Password Strength settings"
msgstr "Password Strength 설정"

msgid "enabled_matchers"
msgstr "enabled_matchers"

msgid "zxcvbn_datematch"
msgstr "zxcvbn_datematch"

msgid "zxcvbn_digitmatch"
msgstr "zxcvbn_digitmatch"

msgid "zxcvbn_l33tmatch"
msgstr "zxcvbn_l33tmatch"

msgid "zxcvbn_repeatmatch"
msgstr "zxcvbn_repeatmatch"

msgid "zxcvbn_sequencematch"
msgstr "zxcvbn_sequencematch"

msgid "zxcvbn_spatialmatch"
msgstr "zxcvbn_spatialmatch"

msgid "zxcvbn_yearmatch"
msgstr "zxcvbn_yearmatch"

msgid "zxcvbn_dictionarymatch"
msgstr "zxcvbn_dictionarymatch"

msgid "The password has a score of @password-score but the policy requires a score of at least @policy-score"
msgstr "비밀번호의 점수는 @password-score이지만 정책은 적어도 @policy-score의 점수가 필요합니다."

msgid "Password Strength Minimum Score"
msgstr "Password Strength 최소 점수"

msgid "Password Strength minimum score of @score"
msgstr "Password Strength @score의 최소 점수"

msgid "PasswordStrength is a password strength estimator using pattern matching and minimum entropy calculation. Scores range from 0 to 4, 4 being the strongest password."
msgstr "PasswordStrength는 패턴 매칭과 최소 엔트로피 계산을 사용하는 비밀번호 강도 평가자입니다. 점수의 범위는 0에서 4까지이며, 4는 가장 강력한 비밀번호입니다."

msgid "Your password lacks strength and has too many common patterns."
msgstr "비밀번호가 강력하지 않고 일반적인 패턴이 너무 많습니다."

