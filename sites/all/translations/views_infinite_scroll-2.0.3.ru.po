msgid "Views Infinite Scroll"
msgstr "Бесконечная прокрутка представлений"

msgid "A pager which allows an infinite scroll effect for views."
msgstr "Элемент разбиения на страницы с поддержкой бесконечной прокрутки для представлений. "

msgid "Views"
msgstr "Представления"

msgid "Infinite Scroll Pager"
msgstr "Элемент разбиения на страницы с бесконечной прокруткой"

msgid "Button Text"
msgstr "Текст кнопки"

msgid "Automatically Load Content"
msgstr "Автоматически загружать контент"

msgid "Initially load all pages"
msgstr "Изначально загружать все страницы"

msgid "Load More"
msgstr "Загрузить ещё"

msgid "Automatic infinite scroll"
msgstr "Автоматическая бесконечная прокрутка"

msgid "Click to load"
msgstr "Нажать для загрузки"

msgid "Initially load one page"
msgstr "Изначально загрузить одну страницу"

msgid "Infinite Scroll Options"
msgstr "Параметры бесконечной прокрутки"

msgid "Note: The infinite scroll option overrides and requires the <em>Use AJAX</em> setting for this views display."
msgstr "Примечание: параметр бесконечной прокрутки переопределяет параметр <em>Использовать AJAX</em> и требует его наличия. "

msgid "The following tokens are supported:"
msgstr "Поддерживаются следующие маркеры:"

msgid "Automatically load subsequent pages as the user scrolls."
msgstr "Автоматически загружать последующие страницы в процессе прокрутки. "

msgid "Initially load all pages up to the requested page"
msgstr "Изначально загружать все страницы до запрошенной страницы"

msgid "When initially loading a page beyond the first, this option will load all pages up to the requested page instead of just the requested page. So, if you have the pager set to 10 items per page, and you load the page with ?page=2 in the url, you will get page 0, 1 and 2 loaded for a total of 30 items. <em>Note that this could cause some long page load times when loading many pages.</em>"
msgstr "В случае начальной загрузки страницы этот параметр загружает все страницы до запрошенной страницы, а не просто запрошенную страницу. Таким образом, если на каждой странице отображается 10 элементов и загрузить страницу с параметром ?page=2 в URL, то будут загружены страницы 0, 1 и 2 (в сумме 30 элементов). <em>Обратите внимание, что в случае загрузки большого числа страниц могут возникать задержки. </em>"

msgid "@action, @count item"
msgid_plural "@action, @count items, @pages"
msgstr[0] "@action, @count элемент"
msgstr[1] "@action, @count элемента, @pages"
msgstr[2] "@action, @count элементов, @pages"

msgid "Infinite Scroll"
msgstr "Бесконечная прокрутка"

msgid "A views plugin which provides infinte scroll."
msgstr "Модуль представлений, обеспечивающий бесконечную прокрутку. "

msgid "Load more items"
msgstr "Загрузить ещё"

