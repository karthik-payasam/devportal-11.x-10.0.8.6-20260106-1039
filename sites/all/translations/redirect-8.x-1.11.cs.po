msgstr "Odstraněno @count přesměrování."

msgid "Are you sure you want to delete this redirect?"
msgid_plural "Are you sure you want to delete these redirects?"
msgstr[0] "Opravdu chcete odstranit tuto přesměrování?"
msgstr[1] "Opravdu chcete odstranit tato přesměrování?"
msgstr[2] "Opravdu chcete odstranit tato přesměrování?"

msgid "Deleted 1 redirect."
