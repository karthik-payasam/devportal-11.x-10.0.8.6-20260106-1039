msgid "Views Autocomplete Filters"
msgstr "Views Autocomplete Filters"

msgid "Use Autocomplete for string field filters."
msgstr "Użyj funkcji automatycznego uzupełniania w przypadku filtrów pól łańcuchowych. "

msgid "Views"
msgstr "Widoki"

msgid "Autocomplete for Combine fields filter"
msgstr "Automatycznie uzupełniaj w przypadku filtru pól połączonych"

msgid "Exposed"
msgstr "Udostępniony"

msgid "Use Autocomplete"
msgstr "Użyj autouzupełnienia"

msgid "Minimum number of characters to start filter"
msgstr "Minimalna liczba znaków do uruchomienia filtru"

msgid "Maximum number of items in Autocomplete"
msgstr "Maksymalna liczba pozycji na liście automatycznego uzupełniania"

msgid "Field with autocomplete results"
msgstr "Pole z wynikami automatycznego uzupełniania"

msgid "Unformatted suggestion"
msgstr "Niesformatowana sugestia"

msgid "Unformatted dropdown"
msgstr "Niesformatowana lista rozwijana"

msgid "Suggestions depend on other filter fields"
msgstr "Sugestie zależą od innych pól filtru"

msgid "Autocomplete for Search API fulltext search filter"
msgstr "Automatycznie uzupełniaj w przypadku filtru wyszukiwania pełnotekstowego interfejsu API wyszukiwania"

msgid "Autocomplete for Search API text field filter"
msgstr "Automatycznie uzupełniaj w przypadku filtru pól tekstowych interfejsu API wyszukiwania"

msgid "Autocomplete for basic textfield filter"
msgstr "Automatycznie uzupełniaj w przypadku podstawowego filtru pól tekstowych"

msgid "Field for autocomplete filter %label is not set in view %view, display %display"
msgstr "Pole filtru automatycznego uzupełniania %label nie jest ustawione w widoku %view (ekran %display)."

msgid "Field for autocomplete filter %label not exists in view %view, display %display"
msgstr "Pole filtru automatycznego uzupełniania %label nie istnieje w widoku %view (ekran %display)."

msgid "Use Autocomplete for this filter."
msgstr "Użyj autouzupełnienia dla tego filtra."

msgid "Enter 0 for no limit."
msgstr "Podaj 0, aby nie ograniczać"

msgid "Autocomplete suggestions will be filtered by other filter fields"
msgstr "Sugestie funkcji automatycznego uzupełniania będą filtrowane przez inne pola filtru"

msgid "The selected field will be used for drop-down results of the autocompletion. In most cases it should be the same field you use for the filter, and <em>must</em> be included in the field list for the view/display in order to appear here."
msgstr "Wybrane pole zostanie użyte do rozwijania wyników automatycznego uzupełniania. W większości przypadków powinno to być to samo pole, które jest używane dla filtru, a <em>musi</em> być umieszczone na liście pól dla widoku/ekranu, aby można było wyświetlić je w tym miejscu."

msgid "Use unformatted data from database for dropdown list instead of field formatter result. Value will be printed as plain text."
msgstr "Na potrzeby listy rozwijanej użyj niesformatowanych danych z bazy danych zamiast wyników formatera pól. Wartość zostanie wyświetlona jako zwykły tekst."

msgid "The same as above, but for suggestion (text appearing inside textfield when item is selected)."
msgstr "Tak samo jak powyżej, ale na potrzeby sugestii (tekst znajdujący się wewnątrz pola tekstowego, gdy jest wybrana pozycja)."

msgid "Add some fields to view"
msgstr "Dodaj pola do widoku"

