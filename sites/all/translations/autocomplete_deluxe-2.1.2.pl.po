msgid "Autocomplete Deluxe"
msgstr "Autocomplete Deluxe"

msgid "Enhanced autocomplete using Jquery UI autocomplete."
msgstr "Rozbudowane pole automatycznego uzupełniania wykorzystujący Jquery UI autocomplete."

msgid "User interface"
msgstr "Interfejs użytkownika"

msgid "None"
msgstr "Brak"

msgid "The entity '@term' will be added."
msgstr "Jednostka '@term' zostanie dodana."

msgid "No terms could be found. Please type in order to add a new term."
msgstr "Nie znaleziono żadnych terminów. Wpisz nowy termin, aby go dodać."

msgid "No results found"
msgstr "Nie znaleziono żadnych wyników"

msgid "Autocomplete Deluxe widget settings"
msgstr "Ustawienia widgetu Autocomplete Deluxe"

msgid "Match Operator"
msgstr "Operator dopasowania"

msgid "Route Name"
msgstr "Nazwa trasy"

msgid "Size"
msgstr "Rozmiar"

msgid "Selection Handler"
msgstr "Procedura obsługi wyboru"

msgid "Limit"
msgstr "Ograniczenie"

msgid "Min Length"
msgstr "Min. długość"

msgid "Delimiter"
msgstr "Separator"

msgid "Allow \"Not Found\" message"
msgstr "Zezwalaj na komunikat \"Nie znaleziono\""

msgid "\"Not Found\" Message"
msgstr "Komunikat \"Nie znaleziono\""

msgid "Allow New Terms"
msgstr "Zezwalaj na nowe terminy"

msgid "No Empty Message"
msgstr "Komunikat Niepuste"

msgid "Match operator"
msgstr "Operator dopasowania"

msgid "Specify the matcting operator."
msgstr "Określ operator dopasowania."

msgid "Limit of the output."
msgstr "Limit wyjścia"

msgid "If set to zero no limit will be used"
msgstr "Jeśli wpiszesz 0, żaden limit nie będzie ustawiony"

msgid "Minimum length."
msgstr "Długość minimalna."

msgid "The minimum length of characters to enter to open the suggestion list."
msgstr "Minimalna ilość wpisanych znaków po których wyświetli się lista z sugestiami."

msgid "Delimiter."
msgstr "Ogranicznik"

msgid "A character which should be used beside the enter key, to separate terms."
msgstr "Znak, który powinien być używany, obok klawisza Enter, do rozdzielenia terminów."

msgid "Show Term not found message"
msgstr "Pokaż komunikat o nieznalezionym terminie"

msgid "If this is enabled, a message will be displayed when the term is not found."
msgstr "Gdy ta opcja jest włączona, w przypadku nieznalezienia terminu zostanie wyświetlony komunikat."

msgid "Term not found message."
msgstr "Wiadomość 'nie znaleziono terminu'."

msgid "A message text which will be displayed, if the entered term was not found."
msgstr "Tekst wiadomości, który będzie wyświetlany jeśli wpisany termin nie zostanie odnaleziony."

msgid "Allow new terms"
msgstr "Zezwól na dodawanie nowych kategorii"

msgid "Should it be allowed, that user enter new terms?"
msgstr "Czy użytkownik może dodawać nowe terminy?"

msgid "Empty value message."
msgstr "Komunikat o pustej wartości."

msgid "A text message that will be displayed when the field is focused and it does not contain values."
msgstr "Komunikat tekstowy, który będzie wyświetlany, gdy pole będzie aktywne i nie będzie zawierało żadnej wartości."

msgid "Match operator: @match_operator"
msgstr "Operator zgodności: @match_operator"

msgid "Limit: @limit"
msgstr "Limit: @limit"

msgid "Min length: @min_length"
msgstr "Minimalna długość: @min_length"

msgid "Delimiter: @delimiter"
msgstr "Ogranicznik: @delimiter"

msgid "Allow Not Found message: @not_found_message_allow"
msgstr "Nie zezwalaj na komunikat Nie znaleziono: @not_found_message_allow"

msgid "Not Found message: @not_found_message"
msgstr "Komunikat Nie znaleziono: @not_found_message"

msgid "Allow new terms: @new_terms"
msgstr "Zezwalaj na nowe terminy: @new_terms"

msgid "Empty value message: @no_empty_message"
msgstr "Komunikat o pustej wartości: @no_empty_message"

msgid "@not_found_message"
msgstr "@not_found_message"

msgid "@no_empty_message"
msgstr "@no_empty_message"

msgid "Starts with"
msgstr "Zaczyna się od"

msgid "Contains"
msgstr "Zawiera"

