msgid ""
"\n"
"        <h2>Maintenance200 module.</h2>\n"
"        <h3>Instructions</h3>\n"
"        <p>Install the module as normal and enable in <strong>/admin/modules</strong>.</p>\n"
"        <p>On the module configuration form you will find a switch to turn on or off the rewriting of the HTTP code returned when the site is in maintenance mode, as well as a field where you\n"
"        can input the numeric HTTP which the site should return.</p>\n"
"      "
msgstr ""
"\n"
"        <h2>Module Maintenance200 .</h2>\n"
"        <h3>Instructies</h3>        <p>Installeer de module als normaal en schakel deze in in <strong>/admin/modules</strong>.</p>\n"
"        <p>In het configuratieformulier van de module vindt u een switch om het herschrijven van de HTTP-code in of uit te schakelen wanneer de site zich in de onderhoudswerkstand bevindt, en een veld waarin u de numerieke HTTP kunt invoeren die de site moet retourneren.</p>\n"
"      "

msgid "Maintenance 200"
msgstr "Onderhoud 200"

msgid "Allows the maintenance page to return a configurable HTTP status code rather than the standard 503 code."
msgstr "Hiermee kan de onderhoudspagina een configureerbare HTTP-statuscode retourneren in plaats van de standaard 503-code."

msgid "Configure maintenance200"
msgstr "Configureer maintenance200"

msgid "Maintenance200 Settings"
msgstr "Maintenance200 -instellingen"

msgid "Maintenance 200 settings"
msgstr "Onderhoud 200 instellingen"

msgid "Enable custom status code during maintenance mode"
msgstr "Aangepaste statuscode inschakelen tijdens onderhoudswerkstand"

msgid "Status code to return during maintenance mode"
msgstr "Statuscode om terug te keren tijdens onderhoudsmodus"

msgid "Change the status code during maintenance mode"
msgstr "Statuscode wijzigen tijdens onderhoudswerkstand"

msgid "Status code to use"
msgstr "Te gebruiken statuscode"

msgid "A valid HTTP status code is required. See the Wikipedia <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">HTTP status codes</a> page for a complete list."
msgstr "Er is een geldige HTTP-statuscode vereist. Zie de pagina Wikipedia <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">HTTP-statuscodes</a> voor een volledige lijst."

msgid "A valid HTTP status code is required."
msgstr "Er is een geldige HTTP-statuscode vereist."

msgid "You must provide an HTTP status code."
msgstr "U moet een HTTP-statuscode opgeven."

