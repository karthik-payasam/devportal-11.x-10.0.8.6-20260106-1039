msgstr "Alto de límite estricto"

msgid "Third party settings"
msgstr "Configuración de terceros"

msgid "Crop settings"
msgstr "Configuración del recorte"

msgid "Field storing image to be cropped"
msgstr "Campo que almacena la imagen por recortar"

msgid "Crop effect configuration"
msgstr "Configuración del efecto de recorte"

msgid "Automatic crop provider"
msgstr "Proveedor automático de cultivos"

msgid "Crop API settings"
msgstr "Parámetros del API de recorte"

msgid "Indicates whether to flush image derivatives when a crop entity is change"
msgstr "Indica si se desechan los derivados de imagen cuando cambia una entidad de recorte"

msgid "Media entity crop"
msgstr "Recorte de entidad de soporte"

msgid "Deprecated."
msgstr "En desuso. "

