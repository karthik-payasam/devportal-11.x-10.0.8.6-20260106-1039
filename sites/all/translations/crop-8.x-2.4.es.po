msgstr "El tipo de recorte."

msgid "Language code"
msgstr "Código de idioma"

msgid "The node language code."
msgstr "El código del idioma del nodo."

msgid "Entity ID"
msgstr "ID de entidad"

msgid "ID of entity crop belongs to."
msgstr "ID de entidad a la que pertenece el recorte."

msgid "Entity type"
msgstr "Tipo de entidad"

msgid "The type of entity crop belongs to."
msgstr "El ID entidad a la que pertenece el recorte."

msgid "URI"
msgstr "URI"

msgid "The URI of the image crop belongs to."
msgstr "El URI de la imagen la que pertenece el recorte."

