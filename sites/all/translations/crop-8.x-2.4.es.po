msgstr "@first, @second y @count más"

msgid "No crop types available. <a href=\"@link\">Add crop type</a>."
msgstr "No hay tipos de recorte disponibles. <a href=\"@link\">Añadir tipo de recorte</a>."

msgid "Entity provider @id not found."
msgstr "No se ha encontrado el proveedor de entidades @id."

