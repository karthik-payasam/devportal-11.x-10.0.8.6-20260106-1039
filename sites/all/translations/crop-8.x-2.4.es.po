msgstr "Coordenada X"

msgid "The crop's X coordinate."
msgstr "La coordenada X del recorte."

msgid "Y coordinate"
msgstr "Coordenada Y"

msgid "The crop's Y coordinate."
msgstr "La coordenada Y del recorte."

msgid "Revision timestamp"
msgstr "Marca temporal de la revisión"

msgid "The time that the current revision was created."
msgstr "La fecha en la que se creó la revisión actual."

msgid "Revision author ID"
msgstr "ID de autor de revisión"

msgid "The user ID of the author of the current revision."
msgstr "El ID del usuario del autor del la revisión actual."

msgid "Revision Log"
msgstr "Registro de revisiones"

msgid "The log entry explaining the changes in this revision."
msgstr "La entra de registro explica el cambio en la revisión."

msgid "Crop"
msgstr "Recortar"

msgid "Are you sure you want to delete the crop type %type?"
msgstr "¿Está seguro que desea borrar el tipo de recorte %type?"

msgid "The crop type %name has been deleted."
msgstr "El tipo de recorte %name se ha borrado."

msgid "Deleted crop type %name."
msgstr "Se ha borrado el tipo de recorte %name."

msgid "%type is used by 1 piece of content on your site. You can not remove this content type until you have removed all of the %type content."
msgid_plural "%type is used by @count pieces of content on your site. You may not remove %type until you have removed all of the %type content."
msgstr[0] "%type está siendo usado por 1 elemento de contenido en su sitio web. Usted no puede borrar este tipo de contenido hasta que haya eliminado todos los contenidos de tipo %type."
msgstr[1] "%type está siendo usado por @count elementos de contenido en su sitio web. Usted no puede borrar este tipo de contenido hasta que haya eliminado todos los contenidos de tipo %type."

msgid "Edit %label crop type"
msgstr "Editar tipo de recorte %label "

msgid "The human-readable name of this crop type. This name must be unique."
msgstr "El nombre legible de este tipo de recorte. Debe ser un nombre único."

msgid "A unique machine-readable name for this crop type. It must only contain lowercase letters, numbers, and underscores."
msgstr "Un nombre único legible por máquina de este tipo de recorte. Debe contener únicamente letras minúsculas, números y guiones bajos."

msgid "Describe this crop type."
msgstr "Describa este tipo de comentario."

msgid "Set an aspect ratio <b>eg: 16:9</b> or leave this empty for arbitrary aspect ratio"
msgstr "Configure una relación de aspecto <b>p.ej.: 16:9</b> o deje esto vacío para obtener una relación de aspecto arbitraria."

msgid "Soft limit"
msgstr "Límite flexible"

msgid "Define crop size soft limit. Warning will be displayed if crop smaller than that is selected."
msgstr "Defina el límite flexible del tamaño del recorte. Se mostrará un aviso si se selecciona un recorte por debajo de este límite. "

msgid "Limit for width."
msgstr "Límite del ancho. "

msgid "Limit for height."
msgstr "Límite del alto."

msgid "Hard limit"
msgstr "Límite estricto"

msgid "Define crop size hard limit. User is not allowed to make a smaller selection than defined here."
msgstr "Defina el límite estricto del tamaño del recorte. No se permitirá al usuario seleccionar algo por debajo de este límite."

msgid "Limit for width"
msgstr "Límite del ancho"

msgid "Save crop type"
msgstr "Guardar el tipo de recorte"

msgid "Delete crop type"
msgstr "Borrar el tipo de recorte"

msgid "The crop type %name has been updated."
msgstr "El tipo de recorte %name se ha actualizado."

msgid "The crop type %name has been added."
msgstr "El tipo de recorte %name se ha añadido."

msgid "View"
msgstr "Ver"

msgid "Added crop type %name."
msgstr "Se ha añadido el tipo de recorte %name."

msgid "File"
msgstr "Archivo"

msgid "Provides crop integration for core files."
msgstr "Proporciona integración de recortes para archivos de núcleo."

msgid "Provides crop integration for media."
msgstr "Proporciona integración de recortes para medios."

msgid "Crop type to be used for the image style."
msgstr "Tipo de recorte que se usa en el estilo de imagen."

msgid "- Select a Provider -"
msgstr "- Seleccionar un proveedor -"

msgid "The name of automatic crop provider to use if crop is not set for an image."
msgstr "El nombre del proveedor de cultivos automático que se debe utilizar si no se ha establecido la cosecha para una imagen."

msgid "Manual image crop failed due to misconfigured crop type on %path."
msgstr "El recorte de imagen manual ha fallado debido a un tipo de recorte mal configurado en %path."

msgid "Manual image crop failed using the %toolkit toolkit on %path (%mimetype, %width x %height)"
msgstr "El recorte de imagen manual ha fallado usando el kit de herramientas %toolkit en  %path (%mimetype, %width x %height)"

msgid "Manual crop"
msgstr "Recorte manual"

msgid "Applies manually provided crop to the image."
msgstr "Aplica un recorte manual a la imagen."

msgctxt "Validation"
msgid "Crop Type aspect ratio"
msgstr "Relación de aspecto del tipo de recorte"

msgid "Invalid aspect ratio format. Should be defined in H:W form."
msgstr "Formato no válido de relación de aspecto. Ha de tener el formato alto:ancho."

