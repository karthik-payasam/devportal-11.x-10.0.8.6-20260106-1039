msgid "Pretty paths coder"
msgstr "Bem caminhos codificador"

msgid "Facets Pretty Paths"
msgstr "Bem Caminhos Aspectos"

msgid "Pretty paths for Facets."
msgstr "Muito caminhos para Aspectos."

msgid "Search"
msgstr "Buscar"

msgid "Facet Pretty Paths third party settings on the Facet config"
msgstr "Configurações de terceiro do Facet Pretty Paths na configuração do Facet"

msgid "The coder plugin ID"
msgstr "O ID do plug-in do codificador"

msgid "Home"
msgstr "Início"

msgid "Pretty paths"
msgstr "Muito caminhos"

msgid "Pretty paths uses slashes as separator, e.g. /brand/drupal/color/blue"
msgstr "Caminhos elegantes usam barras como separadores, por exemplo, /brand/drupal/color/blue"

msgid "Default"
msgstr "Padrão"

msgid "Use the raw value, no special processing is done, e.g. /color/<strong>2</strong>"
msgstr "Use o valor bruto, sem processamento especial, por exemplo, /color/<strong>2</strong>"

msgid "Node title + id"
msgstr "Título do nó + ID"

msgid "Use node title with entity id, e.g. /color/<strong>blue-2</strong>"
msgstr "Usar título do nó com id da entidade, por exemplo, /color/<strong>blue-2</strong>"

msgid "Taxonomy term name + id"
msgstr "Nome + ID do termo de taxonomia"

msgid "Use term name with term id, e.g. /color/<strong>blue-2</strong>"
msgstr "Usar o nome do termo com ID do termo, por exemplo, /color/<strong>blue-2</strong>"

