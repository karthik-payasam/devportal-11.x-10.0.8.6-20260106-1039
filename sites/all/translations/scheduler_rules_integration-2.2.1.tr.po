msgstr "Zamanlanmış bir yayından kaldırma tarihi olup olmadığı denetlenecek @entity_type_singular öğesi."

msgid "Node type is enabled for scheduled publishing"
msgstr "Düğüm tipi, zamanlanan yayınlama için etkinleştirildi"

msgid "Content (Scheduler)"
msgstr "İçerik (Zamanlayıcı)"

msgid "The node to check for the type being enabled for scheduled publishing."
msgstr "Zamanlanmış yayımlama için etkinleştirilmekte olan tip olup olmadığı denetlenecek düğüm."

msgid "Node is scheduled for publishing"
msgstr "Düğüm yayınlama için zamanlandı"

msgid "The node to check for having a scheduled publishing date."
msgstr "Zamanlanmış bir yayımlama tarihi olup olmadığı denetlenecek düğüm."

msgid "Node is scheduled for unpublishing"
msgstr "Düğüm, yayından kaldırma için zamanlandı"

msgid "The node to check for having a scheduled unpublishing date."
msgstr "Zamanlanmış bir yayından kaldırma tarihi olup olmadığı denetlenecek düğüm."

msgid "Node type is enabled for scheduled unpublishing"
msgstr "Düğüm tipi, zamanlanan yayından kaldırma için etkinleştirildi"

msgid "The node to check for the type being enabled for scheduled unpublishing."
msgstr "Zamanlanmış yayından kaldırma için etkinleştirilmekte olan tip olup olmadığı denetlenecek düğüm."

msgid "scheduled publishing"
msgstr "zamanlanmış yayımlama"

msgid "scheduled unpublishing"
msgstr "zamanlanmış yayından kaldırma"

msgid "@bundle_label is enabled for @activity"
msgstr "@bundle_label, @activity için etkinleştirildi"

msgid "@type settings"
msgstr "@type ayarları"

msgid "Action %action is not valid because @activity is not enabled for %type @group. Add the condition %condition to your Reaction Rule, or enable @activity via the <a href=\"@url\">%type</a> settings."
msgstr "@activity, %type @group için etkinleştirilmediğinden %action eylemi geçerli değil. %condition koşulunu Tepki Kuralınıza ekleyin ya da <a href=\"@url\">%tip</a> ayarlarıyla @activity öğesini etkinleştirin."

msgid "Action %action is not valid because @activity is not enabled for %type @group. Add the condition %condition to your Reaction Rule, or enable @activity via the %type settings."
msgstr "@activity, %type @group için etkinleştirilmediğinden %action eylemi geçerli değil. %condition koşulunu Tepki Kuralınıza ekleyin ya da %tip ayarlarıyla @activity öğesini etkinleştirin."

