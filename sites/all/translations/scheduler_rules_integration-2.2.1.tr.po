msgstr "@entity_type_label yayımlanmak üzere zamanlandı"

msgid "The @entity_type_singular to check for having a scheduled publishing date."
msgstr "Zamanlanmış bir yayımlama tarihi olup olmadığı denetlenecek @entity_type_singular öğesi."

