msgid "Send e-mail when content is published by Scheduler"
msgstr "Zamanlayıcı tarafından içerik yayınlandığında e-posta gönder"

msgid "'[node:title]' has been published on [site:name]"
msgstr "'[node:title]' [site:name] sitesinde yayınlandı"

msgid "Send e-mail when content is unpublished by Scheduler"
msgstr "Zamanlayıcı tarafından içerik yayından kaldırıldığında e-posta gönder"

msgid "'[node:title]' has been unpublished on [site:name]"
msgstr "'[node:title]' [site:name] sitesinde yayından kaldırıldı"

msgid "Node"
msgstr "Düğüm"

msgid "The node for publishing via Scheduler."
msgstr "Zamanlayıcı aracılığıyla yayınlanacak düğüm."

msgid "Publish-on Date"
msgstr "Yayınlama Tarihi"

msgid "The publishing date to be used by Scheduler."
msgstr "Zamanlayıcı tarafından kullanılacak yayınlama tarihi."

msgid "Set scheduled publishing date"
msgstr "Zamanlanan yayınlama tarihini ayarla"

msgid "The node for unpublishing via Scheduler."
msgstr "Zamanlayıcı tarafından yayından kaldırılacak düğüm."

msgid "Unpublish-on Date"
msgstr "Yayından Kaldırma Tarihi"

msgid "The unpublishing date to be used by Scheduler."
msgstr "Zamanlayıcı tarafından kullanılacak yayından kaldırma tarihi."

msgid "Set scheduled unpublishing date"
msgstr "Zamanlanan yayından kaldırma tarihini ayarla"

msgid "The scheduled node"
msgstr "Zamanlanan düğüm"

msgid "The node scheduled for publishing via Scheduler."
msgstr "Zamanlayıcı aracılığıyla yayınlama için zamanlanan düğüm."

msgid "Remove scheduled publishing date"
msgstr "Zamanlanan yayınlama tarihini kaldır"

msgid "The node scheduled for unpublishing via Scheduler."
msgstr "Zamanlayıcı aracılığıyla yayından kaldırma için zamanlanan düğüm."

msgid "Remove scheduled unpublishing date"
msgstr "Zamanlanan yayından kaldırma tarihini kaldır"

msgid "Scheduler Rules Integration"
msgstr "Zamanlayıcı Kuralları Bütünleştirmesi"

msgid "Scheduler sub-module providing conditions, actions and events for use with the Rules module."
msgstr "Kurallar modülüyle kullanılacak koşulları, eylemleri ve olayları sağlayan zamanlayıcı alt modülü."

msgid "Scheduler"
msgstr "Zamanlayıcı"

msgid "The object representing the scheduled @entity_type"
msgstr "Zamanlanmış @entity_type öğesini temsil eden nesne"

msgid "After saving a new @entity_type that is scheduled for publishing"
msgstr "Yayımlanmak üzere zamanlanmış yeni bir @entity_type öğesini kaydettikten sonra"

msgid "After saving a new @entity_type that is scheduled for unpublishing"
msgstr "Yayından kaldırmak üzere zamanlanmış yeni bir @entity_type öğesini kaydettikten sonra"

msgid "After updating a @entity_type that is scheduled for publishing"
msgstr "Yayımlanmak üzere zamanlanmış bir @entity_type öğesini güncelledikten sonra"

msgid "After updating a @entity_type that is scheduled for unpublishing"
msgstr "Yayından kaldırmak üzere zamanlanmış bir @entity_type öğesini güncelledikten sonra"

msgid "After Scheduler has published a @entity_type"
msgstr "Zamanlayıcı bir @entity_type öğesini yayımlandıktan sonra"

msgid "After Scheduler has unpublished a @entity_type"
msgstr "Zamanlayıcı bir @entity_type öğesini yayından kaldırdıktan sonra"

msgid "@entity_type_label type is enabled for scheduled publishing"
msgstr "@entity_type_label tipi zamanlanmış yayımlama için etkinleştirildi"

msgid "@entity_type_label"
msgstr "@entity_type_label"

msgid "The @entity_type_singular to check for the type being enabled for scheduled publishing."
msgstr "Zamanlanmış yayımlama için etkinleştirilmekte olan tip olup olmadığı denetlenecek @entity_type_singular öğesi."

msgid "@entity_type_label type is enabled for scheduled unpublishing"
msgstr "@entity_type_label tipi zamanlanmış yayından kaldırma için etkinleştirildi"

