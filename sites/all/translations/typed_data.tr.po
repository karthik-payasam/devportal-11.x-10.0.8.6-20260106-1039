msgid "Typed Data"
msgstr "Yazılan Veriler"

msgid "Extends the core Typed Data API with new APIs and features."
msgstr "Temel Yazılan Veriler API'sini yeni API ve özelliklerle genişletir."

msgid "Missing arguments for filter %filter_id"
msgstr "%filter_id süzgeci için eksik bağımsız değişkenler"

msgid "Entity machine names:"
msgstr "Varlık makinesi adları:"

msgid "Global context variables:"
msgstr "Genel bağlam değişkenleri:"

msgid "Available TypedData data types:"
msgstr "Kullanılabilecek TypedData veri tipleri:"

msgid "Text"
msgstr "Metin"

msgid "The count filter counts the number of characters in the input string."
msgstr "Sayı filtresi, giriş dizgisindeki karakter sayısını sayar."

msgid "Applies a default value if there is no value."
msgstr "Bir değer yoksa varsayılan bir değer uygular."

msgid "Provides the URL of an entity."
msgstr "Bir varlığın URL'sini sağlar."

msgid "Unkown date format %format given."
msgstr "Bilinmeyen tarih biçimi %format sağlandı."

msgid "If a custom date format is supplied, 'custom' must be passed as date format."
msgstr "Özel bir tarih biçimi sağlanırsa tarih biçimi olarak 'custom' iletilmelidir."

msgid "If 'custom' is given as date type, a custom date formatting string must be provided; e.g., 'Y-m-d H:i:s'."
msgstr "Tarih tipi olarak 'custom' sağlanırsa, özel tarih biçimlendirme dizesi sağlanmalıdır; örn. 'Y-m-d H:i:s'."

msgid "Formats a date, using a configured date type or a custom date format string."
msgstr "Yapılandırılan tarih tipi ya da özel tarih biçimi dizesini kullanarak bir tarihi biçimlendirir."

msgid "The format_text filter passes the text through the given filter."
msgstr "format_text filtresi, ilgili filtre aracılığıyla metni geçirir."

msgid "Converts a string to lower case."
msgstr "Bir dizeyi küçük harfe dönüştürür."

msgid "The replace filter replaces all occurrences of the text given in the first argument with the text given in the second argument."
msgstr "Yerine koyma filtresi, birinci bağımsız değişkende verilen metnin bütün gerçekleşmelerini ikinci bağımsız değişkende verilen metinle değiştirir."

msgid "The striptags filter strips SGML/XML tags and replace adjacent whitespace by one space."
msgstr "striptags süzgeci, SGML/XML etiketlerini çıkarır ve bitişik boşlukları tek bir boşlukla değiştirir."

msgid "The trim filter removes whitespace from both the beginning and the end of an input string."
msgstr "Kırpma filtresi, giriş dizgisinin başlangıcından ve bitiminden beyaz alanı kaldırır."

msgid "The upper filter converts the entire input string to upper case."
msgstr "Üst süzgeç, tüm giriş dizesini büyük harfe dönüştürür."

msgid "No widget exists for this data type."
msgstr "Bu veri tipi için bir pencere bileşeni yok."

msgid "The field %field_label consists of the data type %data_type which cannot be input or a widget for this data type is not implemented yet."
msgstr "%field_label alanı, girilemeyen %data_type veri tipinden oluşuyor ya da bu veri tipi için pencere bileşeni henüz uygulanmadı."

msgid "Label"
msgstr "Etiket"

msgid "Broken widget"
msgstr "Pencere bileşeni bozuk"

msgid "A widget for everything that cannot be input or if a widget for a data type is not yet implemented."
msgstr "Bir veri tipi için pencere bileşeni henüz uygulanmadıysa ya da girilemeyen her şey için bir pencere bileşeni."

msgid "currently in daylight saving mode"
msgstr "şu anda gün ışığından yararlanma kipinde"

msgid "not in daylight saving mode"
msgstr "gün ışığından yararlanma kipinde değil"

msgid "Timezone : %timezone %daylight_saving."
msgstr "Saat dilimi: %timezone %daylight_saving."

msgid "Start date"
msgstr "Başlangıç Tarihi"

msgid "End date"
msgstr "Bitiş zamanı"

msgid "Description"
msgstr "Açıklama"

msgid "The @title end date cannot be before the start date"
msgstr "@title bitiş tarihi, başlangıç tarihinden önce olamaz"

msgid "Datetime Range"
msgstr "Tarih Saat Aralığı"

msgid "A datetime range input widget, containing two datetime values, for the start and end of the range."
msgstr "Aralığın başlangıç ve bitiş tarihi için iki tarih saat değeri içeren bir tarih saat aralığı giriş pencere bileşeni."

msgid "Datetime"
msgstr "Tarih/Saat"

msgid "A datetime input widget."
msgstr "Bir tarih-saat giriş pencere bileşeni."

msgid "Empty option label"
msgstr "Boş seçenek etiketi"

msgid "Allows overriding the label of the empty option"
msgstr "Boş seçeneğin etiketinin geçersiz kılınmasına olanak sağlar"

msgid "Select"
msgstr "Seç"

msgid "A simple select box."
msgstr "Basit bir seçme kutusu."

msgid "Placeholder value"
msgstr "Yer tutucu değeri"

msgid "Input field size"
msgstr "Giriş alanı boyutu"

msgid "Maximum text length"
msgstr "Maksimum metin uzunluğu"

msgid "Text input"
msgstr "Metin girişi"

msgid "A simple, one-line text input widget."
msgstr "Basit bir tek satırlık metin girişi pencere bileşeni."

msgid "Number of rows in the text box"
msgstr "Metin kutusundaki satır sayısı"

msgid "Number of columns in the text box"
msgstr "Metin kutusundaki sütun sayısı"

msgid "Controls whether the text area is resizable"
msgstr "Metin alanının yeniden boyutlandırılabilir olup olmadığını denetler"

msgid "Allowed values are \"none\", \"vertical\", \"horizontal\", or \"both\"."
msgstr "İzin verilen değerler \"yok\", \"dikey\", \"yatay\" ya da \"her ikisi\" şeklindedir."

msgid "Textarea"
msgstr "Metin alanı"

msgid "A multi-line text input widget."
msgstr "Çok satırlı bir metin girişi pencere bileşeni."

