msgid "VotingAPI tokens"
msgstr "VotingAPI 토큰"

msgid "Dynamic Tokens for VotingAPI."
msgstr "VotingAPI에 대한 동적 토큰입니다."

msgid "Vote count"
msgstr "투표 수"

msgid "Number of votes."
msgstr "투표 수입니다."

msgid "Average Result"
msgstr "평균 결과"

msgid "Average result of votes."
msgstr "평균 투표 결과입니다."

msgid "Best Vote"
msgstr "최다 득표"

msgid "Best Vote cast."
msgstr "최다 득표 수입니다."

msgid "Worst Vote"
msgstr "최저 득표"

msgid "Worst Vote cast."
msgstr "최저 득표 수입니다."

msgid "About"
msgstr "정보"

msgid "This module enables tokens for all entity types that has <kbd>voting_api_field</kbd>."
msgstr "이 모듈은 <kbd>voting_api_field</kbd>가 있는 모든 엔티티 유형에 대한 토큰을 사용으로 설정합니다."

msgid "Usage"
msgstr "사용법"

msgid "Tokens are dynamic and you have to pass <emph>vote_type</emph> as the last parameter. Module defines four tokens:"
msgstr "토큰은 동적이며 <emph>vote_type</emph>을 마지막 매개변수로 전달해야 합니다. 모듈은 네 개의 토큰을 정의합니다."

msgid "<ul><li>Vote count :: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"
msgstr "<ul><li>투표 수: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"

msgid "<li>Vote average :: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"
msgstr "<li>투표 평균: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"

msgid "<li>Best vote :: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"
msgstr "<li>최다 득표: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"

msgid "<li>Worst vote :: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"
msgstr "<li>최저 득표: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"

msgid "Voting API Tokens"
msgstr "Voting API 토큰"

msgid "Token support for Voting API"
msgstr "Voting API에 대한 토큰 지원"

msgid "Voting"
msgstr "투표"

