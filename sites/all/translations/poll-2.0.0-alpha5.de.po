msgid "Unlimited"
msgstr "Unbegrenzt"

msgid "Poll Duration"
msgstr "Umfragedauer"

msgid "After this period, the poll will be closed automatically."
msgstr "Nach diesem Zeitraum wird die Umfrage automatisch geschlossen."

msgid "Allow anonymous votes"
msgstr "Anonyme Stimmabgaben zulassen"

msgid "A flag indicating whether anonymous users are allowed to vote."
msgstr "Ein Flag, das angibt, ob anonyme Benutzer mit abstimmen dürfen."

msgid "Allow cancel votes"
msgstr "Stornieren von Stimmabgaben zulassen"

msgid "A flag indicating whether users may cancel their vote."
msgstr "Ein Flag, das angibt, ob Benutzer ihre Stimmabgabe stornieren dürfen."

msgid "Allow view results"
msgstr "Ergebnisanzeige zulassen"

msgid "A flag indicating whether users may see the results before voting."
msgstr "Ein Flag, das angibt, ob Benutzer vor ihrer Stimmabgabe die Ergebnisse anzeigen dürfen."

msgid "Active"
msgstr "Aktiv"

msgid "A flag indicating whether the poll is active."
msgstr "Ein Flag, das angibt, ob die Umfrage aktiv ist."

msgid "When the poll was created, as a Unix timestamp."
msgstr "Der Zeitpunkt, zu dem die Umfrage erstellt wurde, als UNIX-Zeitstempel."

