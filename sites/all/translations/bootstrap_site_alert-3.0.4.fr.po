msgid "Bootstrap Site Alert"
msgstr "Alerte du site Bootstrap"

msgid "This module is for rendering alerts site wide using the power of Bootstrap"
msgstr "Ce module permet de diffuser des alertes au niveau du site en utilisant la puissance de Bootstrap"

msgid "Other"
msgstr "Autre"

msgid "Bootstrap Site Alert Configuration"
msgstr "Configuration d'alerte du site Bootstrap"

msgid "Configure the Bootstrap Site Wide Alert Settings"
msgstr "Configurer les paramètres d'alerte au niveau du site Bootstrap"

msgid "Administer Bootstrap Site Alert"
msgstr "Administrer l'alerte du site Bootstrap"

msgid "View Bootstrap Site Alert"
msgstr "Afficher l'alerte du site Bootstrap"

msgid "Settings"
msgstr "Paramètres"

msgid ""
"<h3>Use this form to setup the bootstrap site alert(s).</h3>\n"
"                  <p>Make sure you select the checkbox if you want to turn the alerts on</p>"
msgstr ""
"<h3>Utilisez ce formulaire pour configurer les alertes du site Bootstrap.</h3>\n"
"                  <p>Veillez à cocher la case si vous voulez activer les alertes</p>"

msgid "Select Bootstrap Version"
msgstr "Sélectionner la version Bootstrap"

msgid "3"
msgstr "3"

msgid "4"
msgstr "4"

msgid "- SELECT -"
msgstr "- SELECTIONNER -"

msgid "Save Bootstrap Version"
msgstr "Sauvegarder la version Bootstrap"

msgid "Success"
msgstr "Succès"

msgid "Info"
msgstr "Info"

msgid "Warning"
msgstr "Avertissement"

msgid "Danger"
msgstr "Danger"

msgid "Primary"
msgstr "Primaire"

msgid "Secondary"
msgstr "Secondaire"

msgid "Light"
msgstr "Léger"

msgid "Dark"
msgstr "Sombre"

msgid "If Checked, Bootstrap Site Alert is Active."
msgstr "Si cette case est cochée, l'alerte du site Bootstrap est active."

msgid "Severity"
msgstr "Importance"

msgid "Make this alert dismissable?"
msgstr "Rendre cette alerte escamotable ?"

msgid "Hide this alert on admin pages?"
msgstr "Masquer cette alerte sur les pages d'administration ?"

msgid "Only Show On Certain Pages?"
msgstr "Afficher uniquement sur certaines pages ?"

msgid "Path(s) to show on"
msgstr "Chemin(s) pour l'affichage"

msgid "Specify pages by using their paths. Enter one path per line. The '*' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page."
msgstr "Spécifiez des pages en utilisant leurs chemins. Entrez un chemin par ligne. Le caractère '*' est un caractère de remplacement. Exemples de chemin : %user-wildcard pour chaque page utilisateur. %front est la page d'accueil."

msgid "Alert Message"
msgstr "Message d'alerte"

msgid "Add Another Alert"
msgstr "Ajouter une autre alerte"

msgid "Remove Last Alert"
msgstr "Retirer la dernière alerte"

msgid "Save Alert Message(s)"
msgstr "Sauvegarder les messages d'alerte"

