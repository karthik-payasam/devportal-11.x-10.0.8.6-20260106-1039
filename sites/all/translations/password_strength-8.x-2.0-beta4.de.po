msgid "Password Strength"
msgstr "Kennwortsicherheit"

msgid "Sets up the Password Strength password constraint."
msgstr "Konfiguriert die Kennworteinschränkung 'Kennwortsicherheit'."

msgid "Security"
msgstr "Sicherheit"

msgid "Update Password Strength Settings"
msgstr "Einstellungen für die Kennwortsicherheit aktualisieren"

msgid "Password Strength settings"
msgstr "Kennwortsicherheitseinstellungen"

msgid "enabled_matchers"
msgstr "enabled_matchers"

