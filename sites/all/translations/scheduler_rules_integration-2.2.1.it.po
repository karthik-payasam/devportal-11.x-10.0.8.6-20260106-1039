msgid "Send e-mail when content is published by Scheduler"
msgstr "Invia e-mail quando il contenuto viene pubblicato dallo Scheduler"

msgid "'[node:title]' has been published on [site:name]"
msgstr "'[node:title]' è stato pubblicato su [site:name]"

