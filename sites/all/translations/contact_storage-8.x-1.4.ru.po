msgid "Add a form element that lets you run operations on multiple messages."
msgstr "Добавьте элемент формы, который позволяет запускать операции с несколькими сообщениями."

msgid "The contact form has not been configured. <a href=\":add\">Add one or more forms</a> ."
msgstr "Контактная форма ещё не настроена. <a href=\":add\">Добавьте одну или несколько форм</a>."

msgid "Edit @label"
msgstr "Редактирование @label"

msgid "Label"
msgstr "Метка"

msgid "Example: 'website feedback' or 'product information'."
msgstr "Примеры: 'Замечания по работе сайта' или 'Информация о товаре'."

msgid "Contact form %label has been added."
msgstr "Контактная форма %label была добавлена."

msgid "Are you sure you want to disable the contact form %form?"
msgstr "Вы действительно хотите отключить форму контактов %form?"

msgid "Disable"
msgstr "Отключить"

msgid "Disabled contact forms are not displayed. This action can be undone from the contact forms administration page."
msgstr "Выключенные формы контактной информации не отображаются. Это действие можно отменить на странице администрирования форм контактной информации."

msgid "Default message to display if the contact form is disabled. It will be saved when clicking \"Disable\"."
msgstr "Сообщение по умолчанию, которое отображается, если форма контактной информации выключена. Оно сохраняется при нажатии кнопки \"Выключить\"."

msgid "Disabled contact form %form."
msgstr "Отключенная форма контактов %form."

msgid "Are you sure you want to enable the contact form %form?"
msgstr "Вы действительно хотите включить форму контактной информации %form?"

msgid "Enable"
msgstr "Включить"

msgid "Enabling the contact form will make it visible. This action can be undone from the contact forms administration page."
msgstr "Включение формы контакта сделает ее видимой. Это действие можно отменить на странице администрирования контактных форм."

msgid "Enabled contact form %form."
msgstr "Включенная форма контактов %form."

msgid "Send HTML"
msgstr "Отправить HTML"

msgid "Whether the mails should be sent as HTML. A module like <a href=\"https://www.drupal.org/project/swiftmailer\">Swiftmailer</a> is needed for this feature. This has only been tested with the Swiftmailer module, other modules might not work out of the box and will not use the provided default template."
msgstr "Указывает, следует ли отправлять сообщения электронной почты в формате HTML. Для применения этой функции рекомендуется использовать модуль <a href=\"https://www.drupal.org/project/swiftmailer\">Swiftmailer</a>. Она тестировалась только вместе с модулем Swiftmailer; другие модули могут потребовать дополнительной настройки или не будут использовать шаблон по умолчанию."

msgid "The possible values this field can contain. Enter one value per line, in the format key|label|emails."
msgstr "Возможные значения этого поля. Введите по одному значению в каждой строке в формате: ключ|метка|адреса."

msgid "\"key\" is the message that is added to the body of the message."
msgstr "\"ключ\" - сообщение, добавляемое в тело сообщения."

msgid "\"label\" is the value displayed in the dropdown menu on the contact form."
msgstr "\"метка\" - значение, отображаемое в выпадающем меню формы контактной информации."

msgid "\"emails\" are the email addresses to add to the recipients list (each separated by a comma)."
msgstr "\"адреса\" - адреса электронной почты для добавления в список получателей (в качестве разделителя применяется запятая)."

msgid "Allowed HTML tags in labels: @tags"
msgstr "Допустимые в метках HTML-теги: @tags"

msgid "Text value"
msgstr "Текстовое значение"

msgid "Options email"
msgstr "Параметры электронной почты"

msgid "Stores e-mail recipients for the provided options."
msgstr "Хранит получателей электронной почты для предоставленных опций."

msgid "HTML test mailer"
msgstr "Тестовая HTML отправка почты"

