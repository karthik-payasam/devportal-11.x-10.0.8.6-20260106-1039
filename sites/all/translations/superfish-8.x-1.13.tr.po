msgid "None"
msgstr "Yok"

msgid "Vertical"
msgstr "Dikey"

msgid "Horizontal"
msgstr "Yatay"

msgid "Diagonal"
msgstr "Çapraz"

msgid "About Superfish"
msgstr "Superfish Hakkında"

msgid "<a href=\"@url_module\">Superfish module</a> integrates <a href=\"@url_library\">jQuery Superfish</a> plugin to your Drupal menu blocks. Please refer to the module <a href=\"@url_documentation\">documentation</a> for more information."
msgstr "<a href=\"@url_module\">Superfish modülü</a>, Drupal menü bloklarıyla <a href=\"@url_library\">jQuery Superfish</a> eklentisini bütünleştirir. Lütfen daha fazla bilgi için modül <a href=\"@url_documentation\">belgelerine</a> bakın."

msgid "In order to use Superfish, go to the <a href=\"@block\">Block layout</a> page and use any of the \"Place block\" buttons to create a Superfish block."
msgstr "Superfish'i kullanmak için <a href=\"@block\">Blok yerleşimi</a> sayfasına gidin ve bir Superfish bloğu oluşturmak için \"Blok yerleştir\" düğmelerinden herhangi birini kullanın."

msgid "Superfish library is missing. Please refer to the <a href=\"@documentation\">plugin documentation</a> for how you can fix this issue; Once done, go to the <a href=\"@block\">Block layout</a> page and use any of the \"Place block\" buttons to create a Superfish block."
msgstr "Superfish kitaplığı eksik. Bu sorunu nasıl düzeltebileceğinizi öğrenmek için lütfen <a href=\"@documentation\">eklenti belgelerine</a> bakın; bu işlem yapıldıktan sonra, <a href=\"@block\">Blok yerleşimi</a> sayfasına gidin ve Superfish bloğu oluşturmak için \"Blok yerleştir\" düğmelerinden herhangi birini kullanın."

msgid "If there was no Superfish block in the \"Place block\" form, go to the <a href=\"@performance\">Performance</a> page and clear the cache once."
msgstr "\"Blok yerleştir\" formunda Superfish bloğu yoksa, <a href=\"@performance\">Performans</a> sayfasına gidin ve önbelleği bir kez temizleyin."

msgid "Superfish library"
msgstr "Superfish kitaplığı"

msgid "Inaccessible"
msgstr "Erişilemez"

msgid "Cannot access the Superfish library directory; perhaps because its permissions and/or ownership are not set up correctly."
msgstr "Superfish kitaplık dizinine erişilemiyor; bu, dizinin izinlerinin ve/veya sahibinin düzgün şekilde ayarlanmamasından kaynaklanabilir."

msgid "Unknown version"
msgstr "Bilinmeyen sürüm"

msgid "Cannot determine the version of your Superfish library."
msgstr "Superfish kitaplığınızın sürümü belirlenemiyor."

msgid "Not supported"
msgstr "Desteklenmiyor"

msgid "The Superfish library requires an update. You can find the update instructions on :url."
msgstr "Superfish kitaplığı bir güncelleme gerektiriyor. Şurada güncelleme yönergelerini bulabilirsiniz :url."

msgid "Installed; at @location"
msgstr "Kurulu, yeri: @location"

msgid "Not installed"
msgstr "Kurulu değil"

msgid "Please download the Superfish library from :url."
msgstr "Lütfen şuradan Superfish kitaplığını yükleyin :url."

msgid "Superfish"
msgstr "Superfish"

msgid "Adds jQuery Superfish plugin to menu blocks."
msgstr "Menü bloklarına jQuery Superfish eklentisi ekler."

msgid "User interface"
msgstr "Kullanıcı arabirimi"

msgid "Block settings"
msgstr "Blok ayarları"

msgid "Default"
msgstr "Varsayılan"

msgid "Horizontal (single row)"
msgstr "Yatay (tek satır)"

msgid "Menu type"
msgstr "Menü tipi"

msgid "Horizontal (double row)"
msgstr "Yatay (çift satır)"

msgid "Vertical (stack)"
msgstr "Dikey (yığın)"

msgid "Style"
msgstr "Stil"

msgid "Black"
msgstr "Siyah"

msgid "Blue"
msgstr "Mavi"

msgid "Coffee"
msgstr "Kahve"

msgid "White"
msgstr "Beyaz"

msgid "Add arrows to parent menus"
msgstr "Üst menülere oklar ekle"

msgid "Drop shadows"
msgstr "Gölgeleri bırak"

msgid "jQuery Easing plugin is not installed."
msgstr "jQuery Easing eklentisi kurulmadı."

msgid "The plugin provides a handful number of animation effects, they can be used by uploading the 'jquery.easing.js' file to the libraries directory within the 'easing' directory (for example: libraries/easing/jquery.easing.js). Refresh this page after the plugin is uploaded, this will make more effects available in the above list."
msgstr "Eklenti, bazı animasyon efektleri sağlar. Bu efektler 'easing' dizini içindeki libraries dizinine 'jquery.easing.js' dosyası yüklenerek (örneğin: libraries/easing/jquery.easing.js) kullanılabilir. Eklenti karşıya yüklendikten sonra bu sayfayı yenileyin, bu yukarıdaki listede daha çok efekti kullanılabilir hale getirir."

msgid "Slide-in effect"
msgstr "Kaydırma efekti"

msgid "Superfish plugins"
msgstr "Superfish eklentileri"

msgid "Relocates sub-menus when they would otherwise appear outside the browser window area."
msgstr "Tersi durumda, tarayıcı penceresi alanı dışında görünecek olan alt menüleri yeniden yerleştirir."

msgid "enabled"
msgstr "etkin"

msgid "jQuery Supposition"
msgstr "jQuery Supposition"

msgid "Prevents accidental firing of animations by waiting until the user's mouse slows down enough, hence determinig user's <em>intent</em>."
msgstr "Kullanıcının faresi yeterince yavaşlayıncaya kadar bekleyerek kazara animasyonları önler ve kullanıcının <em>amacını</em> belirler."

msgid "jQuery hoverIntent"
msgstr "jQuery hoverIntent"

msgid "<strong>sf-Touchscreen</strong> provides touchscreen compatibility."
msgstr "<strong>sf-Touchscreen</strong> dokunmatik ekran uyumluluğu sağlar."

msgid "The first click on a parent hyperlink shows its children and the second click opens the hyperlink."
msgstr "Bir üst köprü ilk kez tıklatıldığında alt öğelerini gösterir ve ikinci tıklatmayla köprü açılır."

msgid "sf-Touchscreen"
msgstr "sf-Touchscreen"

msgid "Disable"
msgstr "Devre dışı bırak"

msgid "Enable jQuery sf-Touchscreen plugin for this menu."
msgstr "Bu menü için jQuery sf-Touchscreen eklentisini etkinleştirin."

msgid "Enable jQuery sf-Touchscreen plugin for this menu depending on the user's Web browser <strong>window width</strong>."
msgstr "Kullanıcının web tarayıcısı <strong>pencere genişliğine</strong> göre bu menü için jQuery sf-Touchscreen eklentisini etkinleştirin."

msgid "Enable jQuery sf-Touchscreen plugin for this menu depending on the user's Web browser <strong>user agent</strong>."
msgstr "Kullanıcının web tarayıcısı <strong>kullanıcı aracısına</strong> göre bu menü için jQuery sf-Touchscreen eklentisini etkinleştirin."

msgid "Hiding the sub-menu on the second tap, adding cloned parent links to the top of sub-menus as well."
msgstr "İkinci dokunmada alt menü gizlenir, alt menülerin üstüne klonlanan üst bağlantılar eklenir."

msgid "Using this plugin, the first click or tap will expand the sub-menu, here you can choose what a second click or tap should do."
msgstr "Bu eklenti kullanıldığında ilk tıklatma ya da dokunmayla alt menü genişletilir, burada ikinci tıklatma ya da dokunmayla ne olacağını seçebilirsiniz."

msgid "Opening the parent menu item link on the second tap."
msgstr "İkinci dokunmada üst menü öğesi bağlantısı açılır."

msgid "Hiding the sub-menu on the second tap."
msgstr "İkinci dokunmada alt menü gizlenir."

msgid "sf-Touchscreen will be enabled only if the width of user's Web browser window is smaller than the below value."
msgstr "sf-Touchscreen yalnızca kullanıcının Web tarayıcısı penceresi genişliği aşağıdaki değerden küçükse etkinleştirilir."

msgid "Please note that in most cases such a meta tag is necessary for this feature to work properly:"
msgstr "Birçok durumda bu özelliğin doğru çalışması için böyle bir meta etiketin gerekli olduğunu lütfen göz önünde bulundurun:"

msgid "Window width settings"
msgstr "Pencere genişliği ayarları"

msgid "Also known as \"Breakpoint\"."
msgstr "\"Kesme Noktası\" olarak da bilinir."

msgid "pixels"
msgstr "piksel"

msgid "User agent settings"
msgstr "Kullanıcı aracı ayarları"

msgid "Use the pre-defined list of the <strong>user agents</strong>."
msgstr "<strong>Kullanıcı aracılarının</strong> önceden tanımlı listesini kullanın."

msgid "Recommended"
msgstr "Önerilen"

msgid "Use the custom list of the <strong>user agents</strong>."
msgstr "<strong>Kullanıcı aracılarının</strong> özel listesini kullanın."

msgid "UA string of the current Web browser:"
msgstr "Geçerli Web tarayıcısının UA dizesi:"

msgid "Could be partial or complete. (Asterisk separated)"
msgstr "Kısmi ya da tam olabilir. (Yıldız işaretiyle ayrılmış)"

msgid "empty"
msgstr "boş"

msgid "Examples"
msgstr "Örnekler"

msgid "Custom list of the user agents"
msgstr "Kullanıcı aracılarının özel listesi"

msgid "Client-side (JavaScript)"
msgstr "İstemci tarafı (JavaScript)"

msgid "<strong>User agent</strong> detection method"
msgstr "<strong>Kullanıcı aracısı</strong> saptama yöntemi"

msgid "Server-side (PHP)"
msgstr "Sunucu tarafı (PHP)"

msgid "sf-Smallscreen"
msgstr "sf-Smallscreen"

msgid "<strong>sf-Smallscreen</strong> provides small-screen compatibility for your menus."
msgstr "<strong>sf-Smallscreen</strong> menüleriniz için küçük ekran uyumluluğu sağlar."

msgid "Enable jQuery sf-Smallscreen plugin for this menu depending on the user's Web browser <strong>window width</strong>."
msgstr "Kullanıcının web tarayıcısı <strong>pencere genişliğine</strong> göre bu menü için jQuery sf-Smallscreen eklentisini etkinleştirin."

msgid "Enable jQuery sf-Smallscreen plugin for this menu."
msgstr "Bu menü için jQuery sf-Smallscreen eklentisini etkinleştirin."

msgid "Enable jQuery sf-Smallscreen plugin for this menu depending on the user's Web browser <strong>user agent</strong>."
msgstr "Kullanıcının web tarayıcısı <strong>kullanıcı aracısına</strong> göre bu menü için jQuery sf-Smallscreen eklentisini etkinleştirin."

msgid "sf-Smallscreen will be enabled only if the width of user's Web browser window is smaller than the below value."
msgstr "sf-Smallscreen yalnızca kullanıcının Web tarayıcısı penceresi genişliği aşağıdaki değerden küçükse etkinleştirilir."

msgid "Convert the menu to an accordion menu."
msgstr "Menüyü akordeon menüsüne dönüştürün."

msgid "Select a type"
msgstr "Bir tip seçin"

msgid "Convert the menu to a &lt;select&gt; element."
msgstr "Menüyü bir &lt;select&gt; öğesine dönüştürün."

msgid "&lt;select&gt; settings"
msgstr "&lt;select&gt; ayarları"

msgid "By default the first item in the &lt;select&gt; element will be the name of the parent menu or the title of this block, you can change this by setting a custom title."
msgstr "Varsayılan olarak, &lt;select&gt; öğesindeki ilk öğe üst menünün adı ya da bu bloğun başlığı olacaktır; bunu özel bir başlık ayarlayarak değiştirebilirsiniz."

msgid "Example"
msgstr "Örnek"

msgid "Main Menu"
msgstr "Ana Menü"

msgid "&lt;select&gt; title"
msgstr "&lt;select&gt; başlığı"

msgid "Add <em>selected</em> attribute to the &lt;option&gt; element with the class <strong>active</strong> ."
msgstr "<em>Seçilen</em> özniteliği <strong>etkin</strong> sınıflı <seçenek> öğesine ekleyin."

msgid "Makes pre-selected the item linked to the active page when the page loads."
msgstr "Sayfa yüklendiğinde etkin sayfayla bağlantılı öğeyi önceden seçili hale getirir."

msgid "More"
msgstr "Daha Fazla"

msgid "Copy the main &lt;ul&gt; classes to the &lt;select&gt;."
msgstr "Ana &lt;ul&gt; sınıflarını &lt;select&gt; öğesine kopyalayın."

msgid "disabled"
msgstr "devre dışı"

msgid "Comma separated"
msgstr "Virgülle ayrılmış"

msgid "Exclude these classes from the &lt;select&gt; element"
msgstr "Bu sınıfları &lt;select&gt; öğesinin dışında bırak"

msgid "Copy the hyperlink classes to the &lt;option&gt; elements of the &lt;select&gt;."
msgstr "Metin bağlantısı sınıflarını &lt;select&gt; öğesinin &lt;option&gt; öğelerine kopyalayın."

msgid "Exclude these classes from the &lt;option&gt; elements of the &lt;select&gt;"
msgstr "Bu sınıfları &lt;select&gt; öğesinin &lt;option&gt; öğelerinin dışında bırak"

msgid "Include these classes in the &lt;select&gt; element"
msgstr "Bu sınıfları &lt; select &gt; öğesine dahil et"

msgid "Include these classes in the &lt;option&gt; elements of the &lt;select&gt;"
msgstr "Bu sınıfları &lt;select&gt; öğesinin &lt;option&gt; öğelerine dahil et"

msgid "Accordion settings"
msgstr "Akordeon ayarları"

msgid "By default the caption of the accordion toggle switch will be the name of the parent menu or the title of this block, you can change this by setting a custom title."
msgstr "Varsayılan olarak akordeon açma/kapatma anahtarının başlığı, bu bloğun başlığı ya da üst menünün adı olur; özel bir başlık ayarlayarak bunu değiştirebilirsiniz."

msgid "Menu"
msgstr "Menü"

msgid "Accordion menu title"
msgstr "Akordeon menüsü başlığı"

msgid "Use parent menu items as buttons, add cloned parent links to sub-menus as well."
msgstr "Üst menü öğelerini düğme olarak kullanın, klonlanan üst bağlantıları alt menülere de ekleyin."

msgid "Accordion button type"
msgstr "Akordeon düğme tipi"

msgid "Use parent menu items as buttons."
msgstr "Üst menü öğelerini düğme olarak kullanın."

msgid "Create new links next to parent menu item links and use them as buttons."
msgstr "Üst menü öğesi bağlantılarının yanında yeni bağlantılar oluşturun ve bunları düğme olarak kullanın."

msgid "Supersubs"
msgstr "Supersubs"

msgid "<strong>Supersubs</strong> makes it possible to define custom widths for your menus."
msgstr "<strong>Supersub</strong>'lar, menüleriniz için özel genişlikler tanımlanmasını sağlar."

msgid "Enable Supersubs for this menu."
msgstr "Bu menü için Supersub'ları etkinleştirin."

msgid "Minimum width for sub-menus, in <strong>em</strong> units."
msgstr "<strong>em</strong> birimi olarak, alt menüler için minimum genişlik."

msgid "Minimum width"
msgstr "Minimum genişlik"

msgid "Maximum width for sub-menus, in <strong>em</strong> units."
msgstr "<strong>em</strong> birimi olarak, menüler için maksimum genişlik."

msgid "Maximum width"
msgstr "Genişlik üst sınırı"

msgid "Please refer to the Superfish module documentation for how you should setup multi-column sub-menus."
msgstr "Lütfen çok sütunlu alt menülerin nasıl ayarlanacağıyla ilgili Superfish modül belgelerine bakın."

msgid "Multi-column sub-menus"
msgstr "Çok sütunlu alt menüler"

msgid "Enable multi-column sub-menus."
msgstr "Çok sütunlu alt menüleri etkinleştirin."

msgid "The depth of the first instance of multi-column sub-menus."
msgstr "Çok sütunlu alt menülerin ilk eşgörünümünün derinliği."

msgid "Start from depth"
msgstr "Başlangıç derinliği"

msgid "The amount of sub-menu levels that will be included in the multi-column sub-menu."
msgstr "Çok sütunlu alt menüye eklenecek alt menü düzeyleri sayısı."

msgid "Levels"
msgstr "Düzeyler"

msgid "Advanced settings"
msgstr "Gelişmiş ayarlar"

msgid "The speed of the animation either in <strong>milliseconds</strong> or pre-defined values (<strong>slow, normal, fast</strong>)."
msgstr "<strong>Milisaniye</strong> ya da önceden tanımlı değerler (<strong>yavaş, normal, hızlı</strong>) cinsinden animasyonun hızı."

msgid "Animation speed"
msgstr "Canlandırma hızı"

msgid "The delay in <strong>milliseconds</strong> that the mouse can remain outside a sub-menu without it closing."
msgstr "Farenin kapanmadan bir alt menü dışında kalabileceği <strong>milisaniye</strong> cinsinden gecikme."

msgid "Mouse delay"
msgstr "Fare gecikmesi"

msgid "The amount of sub-menu levels that remain open or are restored using the \".active-trail\" class."
msgstr "\". active-trail\" sınıfı kullanılarak açık kalan ya da geri yüklenen alt menü düzeylerinin miktarı."

msgid "Change this setting <strong>only and only</strong> if you are <strong>totally sure</strong> of what you are doing."
msgstr "Ne yaptığınızdan <strong>tamamen eminseniz</strong> bu ayarı <strong>yalnızca ve yalnızca</strong> olarak değiştirin."

msgid "Path levels"
msgstr "Yol düzeyleri"

msgid "Hyperlinks"
msgstr "Metin Bağlantıları"

msgid "By enabling this option, only parent menu items with <em>Expanded</em> option enabled will have their submenus appear."
msgstr "Bu seçeneği etkinleştirerek yalnızca <em>Genişletildi</em> seçeneği etkin olan üst menü öğelerinin alt menüleri görüntülenir."

msgid "Take \"Expanded\" option into effect."
msgstr "\"Genişletilmiş\" seçeneğini geçerli hale getiriniz."

msgid "Add cloned parent links to the top of sub-menus."
msgstr "Klonlanan üst bağlantıları alt menülerin üstüne ekleyin."

msgid "Disable hyperlink descriptions (\"title\" attribute)"
msgstr "Metin bağlantısı açıklamalarını devre dışı bırak (\"title\" özniteliği)"

msgid "Insert hyperlink descriptions (\"title\" attribute) into hyperlink texts."
msgstr "Metin bağlantısı metinlerine metin bağlantısı açıklamaları (\"title\" özniteliği) ekleyin."

msgid "Add item depth classes to menu items and their hyperlinks."
msgstr "Menü öğelerine ve köprülerine öğe derinliği sınıfları ekleyin."

msgid "Custom classes"
msgstr "Özel sınıflar"

msgid "(Space separated, without dots)"
msgstr "(Boşlukla ayrılmış, noktasız)"

msgid "For the main UL"
msgstr "Ana UL için"

msgid "For the list items"
msgstr "Liste öğeleri için"

msgid "For the hyperlinks"
msgstr "Köprüler için"

msgid "Unacceptable value entered for the \"Animation speed\" option."
msgstr "\"Canlandırma hızı\" seçeneği için kabul edilemez bir değer girildi."

msgid "Unacceptable value entered for the \"Mouse delay\" option."
msgstr "\"Fare gecikmesi\" seçeneği için kabul edilemez bir değer girildi."

msgid "\"sfTouchscreen Breakpoint\" option cannot be empty."
msgstr "\"sfTouchscreen Breakpoint\" seçeneği boş olamaz."

msgid "Unacceptable value enterd for the \"sfTouchscreen Breakpoint\" option."
msgstr "\"sfTouchscreen Breakpoint\" seçeneği için kabul edilemez bir değer girildi."

msgid "List of the touch-screen user agents cannot be empty."
msgstr "Dokunmatik ekran kullanıcı aracıları listesi boş olamaz."

msgid "\"sfSmallscreen Breakpoint\" option cannot be empty."
msgstr "\"sfSmallscreen Breakpoint\" seçeneği boş olamaz."

msgid "Unacceptable value entered for the \"sfSmallscreen Breakpoint\" option."
msgstr "\"sfSmallscreen Breakpoint\" seçeneği için kabul edilemez bir değer girildi."

msgid "List of the small-screen user agents cannot be empty."
msgstr "Küçük ekran kullanıcı aracılarının listesi boş olamaz."

msgid "Unacceptable value entered for the \"Supersubs minimum width\" option."
msgstr "\"Supersub minimum genişliği\" seçeneği için kabul edilemez bir değer girildi."

msgid "Unacceptable value entered for the \"Supersubs maximum width\" option."
msgstr "\"Supersub maksimum genişliği\" seçeneği için kabul edilemez bir değer girildi."

msgid "Supersubs \"maximum width\" has to be bigger than the \"minimum width\"."
msgstr "Supersubs \"maksimum genişliği\", \"minimum genişlik\"ten daha büyük olmalıdır."

msgid "Expand"
msgstr "Genişlet"

msgid "Collapse"
msgstr "Daralt"

