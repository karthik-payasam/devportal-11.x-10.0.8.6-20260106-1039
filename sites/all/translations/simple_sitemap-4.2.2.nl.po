msgstr "De verificatiesleutel van IndexNow is gedefinieerd in <em>Drupal State</em>: @key"

msgid "The IndexNow verification key is saved in <em>Drupal state</em>. Consider defining it in <em>settings.php</em> like so:<br/>@code"
msgstr "De verificatiesleutel van IndexNow wordt opgeslagen in <em>Drupal State</em>. Overweeg het te definiëren in <em>settings.php</em>, bijvoorbeeld: <br/>@code"

msgid "The IndexNow verification key is saved in <em>settings.php</em> and can be safely removed from <em>Drupal state</em>."
msgstr "De verificatiesleutel van IndexNow wordt opgeslagen in <em>settings.php</em> en kan veilig worden verwijderd uit <em>Drupal State</em>."

msgid "An IndexNow verification key needs to be generated and optionally added to <em>settings.php</em> in order for IndexNow engines to get notified about changes. This warning only applies to the production environment."
msgstr "Er moet een verificatiesleutel van IndexNow worden gegenereerd en optioneel worden toegevoegd aan <em>settings.php</em> om de IndexNow-programma's op de hoogte te stellen van wijzigingen. Deze waarschuwing geldt alleen voor de productieomgeving."

msgid "No sitemaps have been selected for submission."
