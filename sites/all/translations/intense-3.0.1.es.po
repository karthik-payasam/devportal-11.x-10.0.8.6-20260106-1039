msgid "Intense library"
msgstr "Biblioteca de Intense "

msgid "Installed"
msgstr "Instalado"

msgid "Not installed"
msgstr "No instalado"

msgid "The <a href=\"@url\">Intense library</a> should be installed at <strong>/libraries/intense[-images]/intense.min.js</strong>, or any path supported by core library finder, or libraries.module. Check out file or folder permissions if troubled with 403 or 404."
msgstr "La <a href=\"@url\">biblioteca intensa</a> debe instalarse en <strong>/libraries/intense[-images]/intense.min.js</strong>, o en cualquier vía de acceso compatible con el buscador de bibliotecas principal, o libraries.module. Consulte los permisos de archivo o carpeta si tiene problemas con 403 o 404."

msgid "Intense images"
msgstr "Imágenes de Intense "

msgid "Provides Intense images integration."
msgstr "Proporciona integración de imágenes de Intense. "

