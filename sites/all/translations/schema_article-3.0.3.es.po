msgid "Schema.org: Article"
msgstr "Schema.org: Article"

msgid "Comma separated list of what the article is about, for instance taxonomy terms or categories."
msgstr "Lista separada por comas de aquello de lo que trata el artículo, por ejemplo términos de taxonomía o categorías."

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "La valoración general, basada en una recopilación de revisiones o valoraciones del elemento."

msgid "REQUIRED BY GOOGLE. Author of the article."
msgstr "NECESARIO PARA GOOGLE. Autor del artículo."

msgid "RECOMMENDED BY GOOGLE. Date the article was last modified."
msgstr "RECOMENDADO POR GOOGLE. Fecha de la última modificación del artículo."

msgid "REQUIRED BY GOOGLE. Date the article was published."
msgstr "NECESARIO PARA GOOGLE. Fecha de la última publicación del artículo."

msgid "RECOMMENDED BY GOOGLE. A description of the item."
msgstr "RECOMENDADO POR GOOGLE. Una descripción del elemento."

msgid "REQUIRED BY GOOGLE. Headline of the article."
msgstr "NECESARIO PARA GOOGLE. Cabecera del artículo."

msgid "Globally unique id of the article, usually a url."
msgstr "ID exclusivo global del artículo, por lo general un url."

msgid "REQUIRED BY GOOGLE. The primary image for this item."
msgstr "NECESARIO PARA GOOGLE. La imagen primaria de este elemento."

msgid "RECOMMENDED BY GOOGLE. The canonical URL of the article page. Specify mainEntityOfPage when the article is the primary topic of the article page."
msgstr "RECOMENDADO POR GOOGLE. El URL canónico de la página del artículo. Especifique mainEntityOfPage cuando el artículo sea el tema principal de la página del artículo."

msgid "Name (usually the headline of the article)."
msgstr "Nombre (normalmente la línea de cabecera del artículo)."

msgid "REQUIRED BY GOOGLE. Publisher of the article."
msgstr "NECESARIO PARA GOOGLE. Publicador del artículo."

msgid "Reviews of this item."
msgstr "Revisiones de este elemento."

msgid "Speakable property."
msgstr "Propiedad de capacidad de expresión"

msgid "REQUIRED. The type of article."
msgstr "OBLIGATORIO. El tipo de artículo."

