msgid "Metatag: Pinterest"
msgstr "Meta tag: Pinterest"

msgid "Provides support for Pinterest's custom meta tags."
msgstr "Fornece suporte para meta tags customizadas do Pinterest."

msgid "SEO"
msgstr "SEO"

msgid "Pinterest: Description"
msgstr "Pinterest: descrição"

msgid "Pinterest: ID"
msgstr "Pinterest: ID"

msgid "Pinterest: Media"
msgstr "Pinterest: mídia"

msgid "Pinterest: No hover"
msgstr "Pinterest: nenhuma ajuda instantânea"

msgid "Pinterest: No pin"
msgstr "Pinterest: nenhum pin"

msgid "Pinterest: No search"
msgstr "Pinterest: nenhuma procura"

msgid "Pinterest: URL"
msgstr "Pinterest: URL"

msgid "Pinterest"
msgstr "Pinterest"

msgid "A set of meta tags used to control how the site's content is consumed by <a href='https://pinterest.com/'>Pinterest</a>."
msgstr "Um conjunto de meta tags usado para controlar como o conteúdo do site é consumido pelo <a href='https://pinterest.com/'>Pinterest</a>."

msgid "Description"
msgstr "Descrição"

msgid "A one to two sentence description of the content."
msgstr "Uma descrição do conteúdo com uma a duas frases."

msgid "Id"
msgstr "ID"

msgid "The Canonical Pinterest object to pin."
msgstr "O objeto do Pinterest canônico para fixar."

msgid "Media"
msgstr "Mídia"

msgid "The URL of media which should represent the content."
msgstr "A URL da mídia que deve representar o conteúdo."

msgid "No hover"
msgstr "Nenhuma ajuda instantânea"

msgid "Do not show hovering Save or Search buttons, generated by the Pinterest browser extensions."
msgstr "Não mostrar os botões Salvar ou Pesquisar, gerados pelas extensões do navegador do Pinterest."

msgid "No pin"
msgstr "Nenhum pin"

msgid "Do not pin anything from this page. When selected, this option will take precedence over all options below."
msgstr "Não fixar nada dessa página. Quando selecionada, essa opção terá precedência sobre todas as opções abaixo."

msgid "No search"
msgstr "Nenhuma procura"

msgid "Do not allow Pinterest visual search to happen from this page."
msgstr "Não permitir que a busca visual do Pinterest seja feita nesta página."

msgid "URL"
msgstr "URL"

msgid "The URL which should represent the content."
msgstr "A URL que deve representar o conteúdo."

