msgstr "使用 @registryName 登入"

msgid "Sign in"
msgstr "登入"

msgid "Sign in using @ur"
msgstr "使用 @ur 登入"

msgid "or"
msgstr "或"

msgid "Continue with"
msgstr "繼續"

