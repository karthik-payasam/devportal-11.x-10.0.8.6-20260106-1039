msgid "About"
msgstr "Informazioni"

msgid "Smart Trim implements a new field formatter for text fields (text, text_long, and text_with_summary, if you want to get technical) that improves upon the \"Summary or Trimmed\" formatter."
msgstr "Smart Trim implementa un nuovo formattatore di campi per i campi di testo (testo, text_long e text_with_summary, se si vuole ottenere informazioni tecniche) che migliora con il formattatore \"Summary or Trimmed\" ."

msgid "More"
msgstr "Altro"

msgid "Read more about [node:title]"
msgstr "Per saperne di più su [node:title]"

msgid "Smart Trim"
msgstr "Smart Trim"

msgid "Provides a more robust alternative to \"summary or trimmed\" textfield format"
msgstr "Fornisce un'alternativa più robusta al formato del campo di testo \"summary or trimmed\" "

msgid "Fields"
msgstr "Campi"

msgid "Smart trim formatter settings"
msgstr "Impostazioni di formattazione di Smart trim"

msgid "Trim length"
msgstr "Lunghezza del testo troncato"

msgid "Trim units"
msgstr "Unità del trim"

msgid "Suffix"
msgstr "Suffisso"

msgid "Wrap trimmed content"
msgstr "Coprire il contenuto tagliato"

msgid "Wrapped content class"
msgstr "Classe di contenuti avvolti"

msgid "More link configuration"
msgstr "Configurazione di altri link"

msgid "Display more link"
msgstr "Visualizza più collegamenti"

msgid "Open link in new window"
msgstr "Apre il link in una nuova finestra"

msgid "More link only when content is trimmed"
msgstr "Più link solo quando il contenuto viene tagliato"

msgid "More link class"
msgstr "Classe del collegamento More"

msgid "More link text"
msgstr "Testo del link Continua"

msgid "More link aria-label value"
msgstr "Valore aria-label del link altre informazioni"

msgid "Summary handler"
msgstr "Gestore di riepilogo"

msgid "Additional options"
msgstr "Opzioni aggiuntive"

msgid "Strip HTML"
msgstr "Elimina HTML"

msgid "Honor a zero trim length"
msgstr "Onorare una lunghezza zero"

msgid "Replace tokens before trimming"
msgstr "Sostituisci token prima del troncamento"

msgid "Characters"
msgstr "Caratteri"

msgid "Words"
msgstr "Parole"

msgid "Summary"
msgstr "Sommario"

msgid "Use summary if present, and do not trim"
msgstr "Usare il sommario se presente e non tagliare "

msgid "Use summary if present, honor trim settings"
msgstr "Usare il sommario se presente, considerare le impostazioni di rifinitura"

msgid "Do not use summary"
msgstr "Non usare il sommario"

msgid "Wrap trimmed content?"
msgstr "Avvolgere il contenuto tagliato?"

msgid "Adds a wrapper div to trimmed content. This option is deprecated and will be removed in Smart Trim 3.0.0. Please override the smart-trim.html.twig template file to customize output."
msgstr "Aggiunge un div wrapper al contenuto ritagliato. Questa opzione è obsoleta e verrà rimossa in Smart Trim 3.0.0. Sovrascrivere il file modello smart-trim.html.twig per personalizzare l'output."

msgid "Wrapped content class."
msgstr "Classe di contenuti avvolti."

msgid "If wrapping, define the class name here."
msgstr "Se si esegue il wrapping, definire qui il nome della classe."

msgid "<em>More</em> link"
msgstr "Link <em>Altro</em>"

msgid "Display <em>More</em> link?"
msgstr "Visualizzare il link <em>Altro</em>?"

msgid "Displays a link to the entity (if one exists)"
msgstr "Visualizza un collegamento all'entità (se ne esiste una)"

msgid "Display <em>More</em> link only when content is trimmed?"
msgstr "Visualizzare il link <em>Altro</em> solo quando il contenuto è tagliato?"

msgid "Only display <em>More</em> link if content is actually trimmed."
msgstr "Visualizzare il link <em>Altro</em> solo se il contenuto è effettivamente tagliato."

msgid "Open <em>More</em> link in new window"
msgstr "Apri link <em>Altro</em> in una nuova finestra"

msgid "<em>More</em> link text"
msgstr "Testo del link <em>Altro</em>"

msgid "If displaying <em>More</em> link, enter the text for the link. This field supports tokens."
msgstr "Se si visualizza il link <em>Altro</em>, immettere il testo per il link. Il campo accetta i token."

msgid "<em>More</em> link aria-label"
msgstr "aria-label link <em>Altro</em>"

msgid "If displaying <em>More</em> link, provide additional context for screen-reader users. In most cases, the aria-label value will be announced instead of the link text. This field supports tokens."
msgstr "Se si visualizza il link <em>Altro</em>, fornire un contesto aggiuntivo per gli utenti del programma di lettura dello schermo. Nella maggior parte dei casi, il valore di aria-label verrà annunciato invece del testo del link. Il campo accetta i token."

msgid "<em>More</em> link class"
msgstr "Classe link <em>Altro</em>"

msgid "If displaying <em>More</em> link, add a custom class for formatting."
msgstr "Se si visualizza il link <em>Altro</em>, aggiungere una classe personalizzata per la formattazione."

msgid "words"
msgstr "parole"

msgid "characters"
msgstr "caratteri"

msgid "Suffix: %suffix"
msgstr "Suffisso: %suffix"

msgid "<em>More</em> link enabled, text: %text"
msgstr "Link <em>Altro</em> abilitato, testo: %text"

msgid "Only display <em>More</em> link when trimmed"
msgstr "Visualizza il link <em>Altro</em> solo quando tagliato"

msgid "<em>More</em> link aria-label: %label"
msgstr "aria-label link <em>Altro</em>: %label"

msgid "<em>More</em> link class: %class"
msgstr "Classe link <em>Altro</em>: %class"

msgid "Smart trimmed"
msgstr "Smart trimmed"

