msgid "Favicons & touch icons"
msgstr "Iconos táctiles y faviconos"

msgid "A PNG image that is 60px wide by 60px high. Used with the non-Retina iPhone, iPod Touch, and Android 2.1+ devices."
msgstr "Imagen PNG de 60px de ancho por 60px de alto. Se usa en los dispositivos iPhone no Retina, iPod Touch y Android 2.1+."

msgid "A PNG image that is 114px wide by 114px high. Used with iPhone with @2x display running iOS <= 6."
msgstr "Imagen PNG de 114px de ancho por 114px de alto. Se usa en iPhone con pantalla @2x que ejecuta iOS <= 6."

msgid "A PNG image that is 120px wide by 120px high. Used with iPhone with @2x display running iOS >= 7."
msgstr "Imagen PNG de 120px de ancho por 120px de alto. Se usa en iPhone con pantalla @2x que ejecuta iOS >= 7."

msgid "A PNG image that is 144px wide by 144px high. Used with iPad with @2x display running iOS <= 6."
msgstr "Imagen PNG de 144px de ancho por 144px de alto. Se usa en iPad con pantalla @2x que ejecuta iOS <= 6."

msgid "A PNG image that is 152px wide by 152px high. Used with iPad with @2x display running iOS >= 7."
msgstr "Imagen PNG de 152px de ancho por 152px de alto. Se usa en iPad con pantalla @2x que ejecuta iOS >= 7."

msgid "A PNG image that is 180px wide by 180px high. Used with iPhone 6 Plus with @3x display."
msgstr "Imagen PNG de 180px de ancho por 180px de alto. Se usa en iPhone 6 Plus con pantalla @3x."

msgid "A PNG image that is 72px wide by 72px high. Used with the iPad mini and the first- and second-generation iPad (@1x display) on iOS <= 6."
msgstr "Imagen PNG de 72px de ancho por 72px de alto. Se usa con el iPad mini y los iPad de primera y segunda generación (pantalla @1x) con iOS <= 6."

msgid "A PNG image that is 76px wide by 76px high. Used with the iPad mini and the second-generation iPad (@1x display) on iOS >= 7."
msgstr "Imagen PNG de 76px de ancho por 76px de alto. Se usa con el iPad mini y los iPad de segunda generación (pantalla @1x) con iOS >= 7."

msgid "A PNG image that is 57px wide by 57px high. Used with the non-Retina iPhone, iPod Touch, and Android 2.1+ devices."
msgstr "Imagen PNG de 57px de ancho por 57px de alto. Se usa en los dispositivos iPhone no Retina, iPod Touch y Android 2.1+."

msgid "A PNG image that is 16px wide by 16px high."
msgstr "Imagen PNG de 16px de ancho por 16px de alto."

msgid "A PNG image that is 192px wide by 192px high."
msgstr "Imagen PNG de 192px de ancho por 192px de alto."

msgid "A PNG image that is 32px wide by 32px high."
msgstr "Imagen PNG de 32px de ancho por 32px de alto."

msgid "A PNG image that is 96px wide by 96px high."
msgstr "Imagen PNG de 96px de ancho por 96px de alto."

msgid "Mask icon color"
msgstr "Color de icono de máscara"

msgid "Color attribute for SVG (mask) icon in hexadecimal format, e.g. '#0000ff'. Setting it will break HTML validation. If not set macOS Safari ignores the Mask Icon entirely, making the Icon: SVG completely useless."
msgstr "Atributo de color para el icono (máscara) SVG en formato hexadecimal, por ejemplo \"#0000ff\". Al establecerse, se interrumpirá la validación HTML. Si no se establece, macOS Safari ignora por completo el icono de Máscara, lo que hace que el Icono: SVG sea completamente inútil."

msgid "Mask icon (SVG)"
msgstr "Icono de máscara (SVG)"

msgid "A grayscale scalable vector graphic (SVG) file."
msgstr "Archivo en escala de grises Scalable Vector Graphic (SVG)"

msgid "Default icon"
msgstr "Icono predeterminado"

msgid "The traditional favicon, must be either a GIF, ICO, JPG/JPEG or PNG image."
msgstr "El icono Favoritos tradicional tiene que ser una imagen GIF, ICO, JPG/JPEG o PNG."

