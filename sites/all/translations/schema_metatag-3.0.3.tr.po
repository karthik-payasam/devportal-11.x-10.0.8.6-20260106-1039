msgstr "GOOGLE İÇİN ZORUNLU. Makalenin yayıncısı."

msgid "Reviews of this item."
msgstr "Bu öğenin incelemeleri."

msgid "Speakable property."
msgstr "Speakable özelliği."

msgid "REQUIRED. The type of article."
msgstr "ZORUNLU. Makalenin tipi."

