msgid "Schema.org: Organization"
msgstr "Schema.org: Organizace"

msgid "RECOMMENDED BY GOOGLE for food establishments, True or False. If True, the best practice is to also define potentialAction."
msgstr "DOPORUČENO APLIKACÍ GOOGLE pro potravinářská zařízení, True nebo False. V případě True je doporučeným postupem také definovat potencialAction."

msgid " An additional type for the item, typically used for adding more specific types from external vocabularies in microdata syntax. This is a relationship between something and a class that the thing is in."
msgstr " Dodatečný typ položky, který se obvykle používá pro přidání specifičtějších typů z externích slovníků v syntaxi mikrodat. Jedná se o vztah mezi něčím a třídou, ve které se tato věc nachází."

msgid "REQUIRED BY GOOGLE. The address of the organization."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Adresa organizace."

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "Celkové hodnocení založené na kolekci revizí nebo hodnocení položky."

msgid "The brand of the organization."
msgstr "Značka organizace."

msgid "RECOMMENDED BY GOOGLE. A description of the item."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Popis položky."

msgid "RECOMMENDED BY GOOGLE. The geographic coordinates of a place or event."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Geografické souřadnice místa nebo události."

msgid "REQUIRED BY GOOGLE. Globally unique @id, usually a url, used to to link other properties to this object."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Globálně jedinečné @id, obvykle adresa URL, která se používá k propojení dalších vlastností s tímto objektem."

msgid "The primary image for this item."
msgstr "Primární obrázek pro tuto položku."

msgid "The logo for this organization."
msgstr "Logo pro tuto organizaci."

msgid "An Organization (or ProgramMembership) to which this Organization belongs."
msgstr "Organizace (nebo ProgramMembership), do které tato organizace patří."

msgid "RECOMMENDED BY GOOGLE for food establishments, the fully-qualified URL of the menu."
msgstr "DOPORUČENO APLIKACÍ GOOGLE pro potravinářská zařízení, úplná adresa URL nabídky."

msgid "REQUIRED BY GOOGLE. The name of the organization."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Název organizace."

msgid "RECOMMENDED BY GOOGLE. Hours during which the business location is open."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Hodiny, během nichž je otevřeno pracoviště."

msgid "RECOMMENDED BY GOOGLE. Potential action provided by this organization."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Potenciální akce poskytnutá touto organizací."

msgid "The price range of products of the organization."
msgstr "Cenový rozsah produktů organizace."

msgid "Reviews of this organization."
msgstr "Recenze této organizace."

msgid "Url linked to the web site, such as wikipedia page or social profiles."
msgstr "Adresa URL propojená s webovým serverem, jako např. se stránkou Wikipedie nebo sociálními profily."

msgid "An official rating for a lodging business or food establishment, e.g. from national associations or standards bodies."
msgstr "Oficiální hodnocení ubytovacího podniku nebo potravinářského zařízení, např. od národních sdružení nebo orgánů pro normalizaci."

msgid "RECOMMENDED BY GOOGLE. A business phone number meant to be the primary contact method for customers. Be sure to include the country code and area code in the phone number."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Obchodní telefonní číslo by mělo být metodou primárního kontaktu pro zákazníky. Ujistěte se, že jste do telefonního čísla zahrnuli kód země a kód oblasti."

msgid "REQUIRED. The type of organization."
msgstr "POŽADOVÁNO. Typ organizace."

msgid "RECOMMENDED BY GOOGLE. The url of the organization."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Adresa URL organizace."

