msgid "Pretty paths coder"
msgstr "Кодировщик красивых путей"

msgid "Facets Pretty Paths"
msgstr "Красивые пути для фасетов"

msgid "Pretty paths for Facets."
msgstr "Красивые пути для фасетов."

msgid "Search"
msgstr "Поиск"

msgid "Facet Pretty Paths third party settings on the Facet config"
msgstr "Сторонние параметры красивых путей фасета в конфигурации фасета"

msgid "The coder plugin ID"
msgstr "ИД модуля кодировщика"

msgid "Home"
msgstr "Главная"

msgid "Pretty paths"
msgstr "Красивые пути"

msgid "Pretty paths uses slashes as separator, e.g. /brand/drupal/color/blue"
msgstr "В красивых путях используются символы косой черты в качестве разделителя. Пример: /brand/drupal/color/blue"

msgid "Default"
msgstr "По умолчанию"

msgid "Use the raw value, no special processing is done, e.g. /color/<strong>2</strong>"
msgstr "Укажите необработанное значение, специальная обработка не выполняется. Пример: /color/<strong>2</strong>"

msgid "Node title + id"
msgstr "Заголовок узла + ИД"

msgid "Use node title with entity id, e.g. /color/<strong>blue-2</strong>"
msgstr "Использовать заголовок узла с ИД сущности, например <strong>blue-2</strong>"

msgid "Taxonomy term name + id"
msgstr "Имя термина таксономии + ИД"

msgid "Use term name with term id, e.g. /color/<strong>blue-2</strong>"
msgstr "Укажите имя термина с ИД термина. Пример: /color/<strong>blue-2</strong>"

