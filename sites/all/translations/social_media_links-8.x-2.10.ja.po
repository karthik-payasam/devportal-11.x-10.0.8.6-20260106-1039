msgid "About"
msgstr "アバウト"

msgid "The modules provides a configurable block that display links (icons) to your profiles on various popular networking sites."
msgstr "このモジュールは、利用者の多い各種ネットワーキング・サイト上のプロファイルへのリンク (アイコン) を表示する構成可能なブロックを提供します。"

msgid "Installation"
msgstr "インストール"

msgid "Install as usual, see <a href=\":documentation\">installing contributed modules</a> for further information."
msgstr "通常どおりにインストールします。詳しくは、『<a href=\":documentation\">installing contributed modules</a>』を参照してください。"

msgid "The module has no special configuration. All settings are available in the block settings: /admin/structure/block."
msgstr "このモジュールに特別な構成はありません。すべての設定はブロック設定 (/admin/structure/block) で指定できます。"

msgid "Included icon sets"
msgstr "含まれるアイコン・セット"

msgid "The module contains a icon set, that the module is ready for use immediately after the installation."
msgstr "このモジュールにはアイコン・セットが含まれており、インストール後すぐにモジュールで使用できるようになっています。"

msgid "Social Media Links Block"
msgstr "ソーシャル・メディア・リンク・ブロック"

msgid "The module provides a block that display links (icons) to your profiles on various social networking sites."
msgstr "このモジュールは、各種ソーシャル・ネットワーキング・サイト上のプロファイルへのリンク (アイコン) を表示するブロックを提供します。"

msgid "Social Media Links Field"
msgstr "ソーシャル・メディア・リンク・フィールド"

msgid "The module provides a field type to capture social media profiles."
msgstr "モジュールはソーシャル・メディア・プロファイルを取り込むフィールド・タイプを提供します。"

msgid "Platform"
msgstr "プラットフォーム"

msgid "Appearance"
msgstr "テーマ"

msgid "Orientation"
msgstr "向き"

msgid "vertical"
msgstr "垂直"

msgid "horizontal"
msgstr "水平"

msgid "Show name"
msgstr "名前の表示"

msgid "Show the platform name next to the icon."
msgstr "アイコンの隣にプラットフォーム名を表示します。"

msgid "Link attributes"
msgstr "リンクの属性"

msgid "Default target"
msgstr "デフォルトのターゲット"

msgid "Remove target attribute"
msgstr "ターゲット属性の削除"

msgid "Open in a new browser window or tab (_blank)"
msgstr "新規ブラウザー・ウィンドウまたはタブで開く (_blank)"

msgid "Open in the current window (_self)"
msgstr "現行ウィンドウで開く (_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "リンク先のフレームよりも上位のフレームで開く (_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "すべてのフレームをキャンセルし、フル・ブラウザー・ウィンドウで開く (_top)"

msgid "Default rel"
msgstr "デフォルトの rel"

msgid "Remove rel attribute"
msgstr "rel 属性の削除"

msgid "Set nofollow"
msgstr "nofollow に設定"

msgid "Orientation: @orientation"
msgstr "向き: @orientation"

msgid "Yes"
msgstr "はい"

msgid "No"
msgstr "いいえ"

msgid "Show name: @show_name"
msgstr "名前の表示: @show_name"

