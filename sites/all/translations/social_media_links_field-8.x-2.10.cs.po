msgid "Social Media Links Field"
msgstr "Pole odkazů na sociální média"

msgid "The module provides a field type to capture social media profiles."
msgstr "Modul poskytuje typ pole k zachycení profilů sociálních médií."

msgid "Platform"
msgstr "Platforma"

msgid "Appearance"
msgstr "Vzhled"

msgid "Orientation"
msgstr "Orientace"

msgid "vertical"
msgstr "vertikální"

msgid "horizontal"
msgstr "horizontální"

msgid "Show name"
msgstr "Zobrazit název"

msgid "Show the platform name next to the icon."
msgstr "Zobrazit název platformy vedle ikony."

msgid "Link attributes"
msgstr "Spojit atributy"

msgid "Default target"
msgstr "Výchozí cíl"

msgid "Remove target attribute"
msgstr "Odebrat cílový atribut"

msgid "Open in a new browser window or tab (_blank)"
msgstr "Otevřít v novém okně prohlížeče nebo na kartě (_blank)"

msgid "Open in the current window (_self)"
msgstr "Otevřít v aktuálním okně (_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "Otevřít v rámci, který je lepší než rámec, ve kterém se nachází odkaz v (_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "Zrušit všechny rámce a otevřít v celém okně prohlížeče (_top)"

msgid "Default rel"
msgstr "Výchozí rel"

msgid "Remove rel attribute"
msgstr "Odebrat rel atribut"

msgid "Set nofollow"
msgstr "Nastavit nofollow"

msgid "Orientation: @orientation"
msgstr "Orientace: @orientation"

msgid "Yes"
msgstr "Ano"

msgid "No"
msgstr "Ne"

msgid "Show name: @show_name"
msgstr "Zobrazit název: @show_name"

msgid "Default"
msgstr "Výchozí"

msgid "Value"
msgstr "Hodnota"

msgid "Platform Values"
msgstr "Hodnoty platformy"

msgid "Icon Style"
msgstr "Styl ikony"

msgid "Description"
msgstr "Popis"

msgid "Weight"
msgstr "Váha"

msgid "Platforms"
msgstr "Platformy"

msgid "The platforms that are allowed to be used in this field. Select none to allow all platforms."
msgstr "Platformy, které je povoleno používat v tomto poli. Vyberte volbu žádné, chcete-li povolit všechny platformy."

msgid "The description is used for the title and WAI-ARIA attribute."
msgstr "Popis se používá pro titulek a atribut WAI-ARIA."

msgid "Find / Follow us on %platform"
msgstr "Nalézt/sledovat nás na %platform"

msgid "Weight for type @type"
msgstr "Váha pro typ @type"

msgid "Handle links to social media profiles."
msgstr "Zpracujte odkazy na profily sociálních médií."

msgid "List with all available platforms"
msgstr "Seznam se všemi dostupnými platformami"

msgid "One available platform (selectable)"
msgstr "Jedna dostupná platforma (volitelná)"

