msgid "Panels Drupal core version"
msgstr "Verze jádra Drupal panelů"

msgid "Panels requires at least Drupal core 8.3."
msgstr "Panely vyžadují alespoň jádro Drupal 8.3."

msgid "Panels"
msgstr "Panely"

msgid "Core Panels display functions; provides no external UI, at least one other Panels module should be enabled."
msgstr "Funkce zobrazení panelů jádra; neposkytuje žádné externí uživatelské rozhraní, proto by měl být povolen alespoň jeden další modul Panely."

msgid "Use Panels Dashboard"
msgstr "Použít panel dashboard Panely"

msgid "Allows a user to access the Panels Dashboard."
msgstr "Umožňuje uživateli přístup k panelu dashboard Panely."

msgid "View administrative links on Panel panes"
msgstr "Zobrazit administrativní odkazy v podoknech panelu"

msgid "Configure access settings on Panel panes"
msgstr "Konfigurovat nastavení přístupu v podoknech panelu"

msgid "Access rules (often also called visibility rules) can be configured on a per-pane basis. This permission allows users to configure those settings."
msgstr "Přístupová pravidla (často také nazývaná pravidla viditelnosti) mohou být konfigurována i pro jednotlivá podokna. Toto oprávnění umožňuje uživatelům konfigurovat tato nastavení."

msgid "Configure advanced settings on Panel panes"
msgstr "Konfigurovat rozšířená nastavení v podoknech panelu"

msgid "Administer Panels layouts"
msgstr "Spravovat rozvržení panelů"

msgid "Allows a user to administer exported Panels layout plugins & instances."
msgstr "Umožňuje uživateli spravovat exportované moduly plug-in a instance rozvržení panelů."

msgid "Administer Panels styles"
msgstr "Spravovat styly panelů"

msgid "Allows a user to administer the styles of Panel panes."
msgstr "Umožňuje uživateli spravovat styly podoken panelu."

msgid "Configure caching settings on Panels"
msgstr "Konfigurovat nastavení mezipaměti v panelech"

msgid "Allows a user to configure caching on Panels displays and panes."
msgstr "Umožňuje uživateli nakonfigurovat ukládání do mezipaměti v zobrazeních a podoknech panelů."

msgid "Use panel locks"
msgstr "Použít zámky panelu"

msgid "Allows a user to lock and unlock panes in a panel display."
msgstr "Umožňuje uživateli zamknout a odemknout podokna v zobrazení panelu."

msgid "Use the Panels In-Place Editor with Page Manager"
msgstr "Použít editor Panels In-Place Editor ss Správcem stránek"

msgid "Allows users with access to the In-Place editor to administer page manager pages. This permission is only needed for users without \"use page manager\" access."
msgstr "Umožňuje uživatelům s přístupem k editoru In-Place Editor spravovat stránky Správcem stránek. Toto oprávnění je potřebné pouze pro uživatele, kteří nemají přístup \"použít Správce stránek\"."

