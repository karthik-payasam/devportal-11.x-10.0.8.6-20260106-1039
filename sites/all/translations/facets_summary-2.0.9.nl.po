msgid "Facets summary (Experimental)"
msgstr "Facetoverzicht (experimenteel)"

msgid "Exposes a Facets block summary showing the current search."
msgstr "Hiermee maakt u een blokoverzicht van facetten zichtbaar, met daarin de huidige zoekopdracht."

msgid "Search"
msgstr "Zoeken"

msgid "Add facet summary"
msgstr "Facetoverzicht toevoegen"

msgid "Edit facets summary"
msgstr "Facetoverzicht bewerken"

