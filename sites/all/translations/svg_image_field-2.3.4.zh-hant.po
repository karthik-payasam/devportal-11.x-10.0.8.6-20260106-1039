msgid "SVG Image Field - Media Bundle"
msgstr "SVG 影像欄位 - 媒體組合"

msgid "Creates a media bundle to use SVG Image Field with the Media capabilities in core. NOTE: if you are planning to use this with the Media Library in core, it is recommended to install that module before this one. Will also install Acquia Site Studio Components if that is installed."
msgstr "建立媒體組合，以在核心中使用 SVG 影像欄位與媒體功能。 附註：如果您計劃在核心中使用此媒體庫，建議在此媒體庫之前安裝該模組。 如果已安裝，則也會安裝「Acquia Site Studio 元件」。"

msgid "Content"
msgstr "內容"

msgid "File"
msgstr "檔案"

msgid ""
"Check this option if you want to manipulate the SVG image with CSS and JavaScript.\n"
"       Notice only trusted users should use fields with this option enabled because of\n"
"       <a href=\"@svg_security_link\">inline svg security</a>"
msgstr ""
"如果要使用 CSS 及 JavaScript 來操作 SVG 影像，請勾選此選項。\n"
"       請注意，只有授信使用者才應該使用啟用此選項的欄位，因為\n"
"       <a href=\"@svg_security_link\">行內 svg 安全</a>問題"

msgid "Apply dimensions."
msgstr "套用維度。"

msgid "Image width."
msgstr "影像寬度。"

msgid "Image height."
msgstr "影像高度。"

msgid "Force the fill to currentColor"
msgstr "強制填入 currentColor"

msgid "This can allow the SVG to inherit coloring from the enclosing tag, such as a link tag."
msgstr "這可讓 SVG 從含括標籤繼承著色，例如鏈結標籤。"

msgid "Sanitize SVG code"
msgstr "為 SVG 程式碼消毒"

msgid "Sanitize the SVG XML code and prevent XSS attacks."
msgstr "為 SVG XML 程式碼消毒，並防止 XSS 攻擊。"

msgid "Sanitize: Remove remote references"
msgstr "消毒：移除遠端參照"

msgid "Remove attributes that reference remote files, this will stop HTTP leaks but will add an overhead to the sanitizer."
msgstr "移除參照遠端檔案的屬性，這將停止 HTTP 洩漏，但會增加消毒器的額外負荷 。"

msgid "Nothing"
msgstr "沒有"

msgid "Enable alt attribute."
msgstr "啟用 alt 屬性。"

msgid "Enable title attribute."
msgstr "啟用 title 屬性。"

msgid "Inline SVG"
msgstr "行內 SVG"

msgid "Image width: @width"
msgstr "影像寬度：@width"

msgid "Image height: @height"
msgstr "影像高度：@height"

msgid "Alt enabled"
msgstr "已啟用替代文字"

msgid "Title enabled"
msgstr "已啟用標題"

msgid "Inline file %file is missing or empty. Inline display will be disabled and an image tag used instead."
msgstr "行內檔案 %file 遺漏或空白。 將停用行內顯示，並改用影像標籤。"

msgid "File %file could not be displayed by image formatter because it does not exist on server."
msgstr "影像格式製作程式無法顯示檔案 %file，因為它不存在於伺服器上。"

msgid "SVG Image Field formatter"
msgstr "SVG 影像欄位格式製作程式"

msgid "SVG Image URL formatter"
msgstr "SVG 影像 URL 格式製作程式"

msgid "Alternative text"
msgstr "替代文字"

msgid "Alternative image text, for the image's 'alt' attribute."
msgstr "替代影像文字，用於影像的 'alt' 屬性。"

msgid "Title"
msgstr "標題"

msgid "Image title text, for the image's 'title' attribute."
msgstr "影像標題文字，用於影像的 'title' 屬性。"

msgid "Upload destination"
msgstr "上載目的地"

msgid "Select where the final files should be stored. Private file storage has significantly more overhead than public files, but allows restricted access to files within this field."
msgstr "選擇最後檔案保存的位置。私有檔案儲存比公共檔案操作複雜得多，但是可以使用檔案的訪問權限控制。"

msgid "If no image is uploaded, this image will be shown on display."
msgstr "如果沒有圖片被上載，此圖片會顯示出來。"

msgid "Enable <em>Alt</em> field"
msgstr "啟用 <em>Alt</em> 欄位"

msgid "The alt attribute may be used by search engines, screen readers, and when the image cannot be loaded. Enabling this field is recommended."
msgstr "alt 屬性可由搜尋引擎、螢幕閱讀器使用，以及在影像無法載入時使用。建議啟用此欄位。"

msgid "<em>Alt</em> field required"
msgstr "需要 <em>Alt</em> 欄位"

msgid "Making this field required is recommended."
msgstr "建議將此欄位設為必要欄位。"

msgid "Enable <em>Title</em> field"
msgstr "啟用 <em>Title</em> 欄位"

msgid "The title attribute is used as a tooltip when the mouse hovers over the image. Enabling this field is not recommended as it can cause problems with screen readers."
msgstr "將滑鼠游標移至影像上方時，會以 title 屬性作為工具提示。建議不要啟用此欄位，因為這可能會導致螢幕閱讀器方面的問題。"

msgid "<em>Title</em> field required"
msgstr "需要<em>標題</em>欄位"

msgid "If no image is uploaded, this image will be shown on display and will override the field's default image."
msgstr "如果未上傳任何影像，此影像將會顯示在顯示畫面上，且會置換欄位的預設影像。"

msgid "Default image"
msgstr "預設圖像"

msgid "Image"
msgstr "圖片"

msgid "Image to be shown if no image is uploaded."
msgstr "未上傳任何影像時要顯示的影像。"

msgid "This text will be used by screen readers, search engines, and when the image cannot be loaded."
msgstr "此文字將由螢幕閱讀器、搜尋引擎使用，以及在影像無法載入時使用。"

msgid "The title attribute is used as a tooltip when the mouse hovers over the image."
msgstr "Title 屬性用於當使用者鼠標移動到此圖片上時的工具提示。"

msgid "Svg Image"
msgstr "SVG 影像"

msgid "This field stores the ID of an image file as an integer value."
msgstr "這個欄位把圖片檔案的 ID 作為一個整數值存儲。"

msgid "Reference"
msgstr "參照"

msgid "Alt"
msgstr "Alt"

msgid "Preview image max width"
msgstr "預覽影像寬度上限"

msgid "Preview image max height"
msgstr "預覽影像高度上限"

msgid "Preview image width: @width"
msgstr "預覽影像寬度：@width"

msgid "Preview image height: @height"
msgstr "預覽影像高度：@height"

msgid "This text will be used by screen readers, search engines, or when the image cannot be loaded."
msgstr "這些文字被應用於搜尋、螢幕閱讀器或當圖像沒法載入的時候。"

msgid "The title is used as a tool tip when the user hovers the mouse over the image."
msgstr "這是當滑鼠停留圖像上時所顯示的文字提示。"

msgid "SVG image"
msgstr "SVG 影像"

msgid "SVG"
msgstr "SVG"

msgid "Provides business logic and metadata for SVG files."
msgstr "提供 SVG 檔案的商業邏輯及 meta 資料。"

