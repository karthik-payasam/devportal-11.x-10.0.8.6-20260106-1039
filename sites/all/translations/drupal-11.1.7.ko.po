msgstr "콘텐츠 번역 링크"

msgid "Translation source"
msgstr "번역 원본"

msgid "Translation outdated"
msgstr "오래된 번역입니다."

msgid "Translation author"
msgstr "번역 작성자"

msgid "Translation status"
msgstr "번역 상태"

msgid "A boolean indicating whether the translation is visible to non-translators."
msgstr "번역가가 아닌 사용자에게 번역을 표시하는지 여부를 나타내는 부울입니다."

msgid "Translation created time"
msgstr "번역 작성 시간"

msgid "Translation changed time"
msgstr "번역 변경 시간"

msgid "Create %language translation of %title"
msgstr "%title 에 대한 %language 번역 작성"

msgid "@title [%language translation]"
msgstr "@title[%language translation]"

msgid "Source language: @language"
msgstr "소스 언어: @language"

msgid "Select source language"
msgstr "소스 언어 선택"

msgid "Change"
msgstr "변경하기"

msgid "Delete translation"
msgstr "번역 삭제"

msgid "An unpublished translation will not be visible without translation permissions."
msgstr "공개되지 않은 번역은 번역 권한이 없으면 표시되지 않습니다."

msgid "Only this translation is published. You must publish at least one more translation to unpublish this one."
msgstr "이 번역만 공개됩니다. 공개를 취소하려면 하나 이상의 번역을 공개해야 합니다."

msgid "This translation is published"
msgstr "이 번역이 공개됨"

msgid "Translations cannot be flagged as outdated when content is moderated."
msgstr "컨텐츠를 조정할 때 번역을 오래된 것으로 플래그 지정할 수 없습니다."

msgid "If you made a significant change, which means the other translations should be updated, you can flag all translations of this content as outdated. This will not change any other property of them, like whether they are published or not."
msgstr "중요한 내용을 변경한 경우(즉, 다른 번역이 업데이트되어야 함) 이 컨텐츠의 모든 번역을 오래된 항목으로 플래그 지정할 수 있습니다. 이 경우 공개 여부에 상관없이 항목의 다른 특성은 변경되지 않습니다."

msgid "This translation needs to be updated"
msgstr "번역의 업데이트가 필요"

msgid "When this option is checked, this translation needs to be updated. Uncheck when the translation is up to date again."
msgstr "이 옵션을 선택하면 이 번역을 업데이트해야 합니다. 번역이 다시 최신 상태인 경우 선택 취소합니다."

