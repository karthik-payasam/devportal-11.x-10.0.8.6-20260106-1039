msgstr "엔티티 참조를 포함하고 있는 엔티티 필드."

msgid "Reference"
msgstr "참조"

msgid "Number (float)"
msgstr "숫자(float)"

msgid "This field stores a number in the database in a floating point format."
msgstr "이 필드는 숫자를 부동 소주점 형식으로 데이터베이스에 저장합니다."

msgid "%name: The integer must be larger or equal to %min."
msgstr "%name: 정수는 %min보다 크거나 같아야 합니다."

msgid "Integer value"
msgstr "정수 값"

msgid "Number (integer)"
msgstr "숫자(정수)"

msgid "This field stores a number in the database as an integer."
msgstr "이 필드는 숫자를 정수로 데이터베이스에 저장합니다."

msgid "Language object"
msgstr "언어 객체"

msgid "The referenced language"
msgstr "참조된 언어"

msgid "An entity field referencing a language."
msgstr "언어를 참조하는 엔티티 필드."

msgid "Map"
msgstr "지도"

msgid "An entity field for storing a serialized array of values."
msgstr "직렬화된 배열 값을 저장하는 엔티티 필드."

msgid "The minimum value that should be allowed in this field. Leave blank for no minimum."
msgstr "이 필드에 허용할 최소 값입니다. 비워두면 최소 값을 제한하지 않습니다."

msgid "The maximum value that should be allowed in this field. Leave blank for no maximum."
msgstr "이 필드에 허용할 최대 값입니다. 비워두면 최대 값을 제한하지 않습니다."

msgid "Define a string that should be prefixed to the value, like '$ ' or '&euro; '. Leave blank for none. Separate singular and plural values with a pipe ('pound|pounds')."
msgstr "'$ '나 '&euro; ' 같이 값 앞에 덧붙여야 하는 문자열을 지정하세요. 입력하지 않으면 아무것도 붙지 않습니다. 단수형과 복수형 값은 파이프로 구분해주세요 ('pound|pounds')."

msgid "Define a string that should be suffixed to the value, like ' m', ' kb/s'. Leave blank for none. Separate singular and plural values with a pipe ('pound|pounds')."
msgstr "' m', ' kb/s' 같이 값 뒤에 덧붙여야 하는 문자열을 지정하세요. 입력하지 않으면 아무것도 붙지 않습니다. 단수형과 복수형 값은 파이프로 구분해주세요 ('pound|pounds')."

msgid "%name: the value may be no less than %min."
msgstr "%name: 값은 최소한 %min이어야 합니다."

msgid "%name: the value may be no greater than %max."
msgstr "%name: 값은 %max 이하여야 합니다."

msgid "The hashed password"
msgstr "해시 비밀번호"

msgid "Existing password"
msgstr "기존 비밀번호"

msgid "Determines if a password needs hashing"
msgstr "암호에 해시가 필요한지 결정"

msgid "Password"
msgstr "비밀번호"

msgid "An entity field containing a password value."
msgstr "비밀번호 값을 포함하고 있는 엔티티 필드."

msgid "%name: may not be longer than @max characters."
msgstr "%name: @max자보다 길 수 없습니다."

msgid "The maximum length of the field in characters."
msgstr "필드의 최대 문자열 길이"

msgid "Text (plain)"
msgstr "텍스트(plain)"

msgid "A field containing a plain string value."
msgstr "일반 문자열 값을 포함하고 있는 필드."

msgid "Text value"
msgstr "텍스트 값"

msgid "Text (plain, long)"
msgstr "텍스트(plain, long)"

msgid "A field containing a long string value."
msgstr "long 문자열 값을 포함하고 있는 필드."

msgid "An entity field containing a UNIX timestamp value."
msgstr "UNIX 시간소인 값을 포함하고 있는 엔티티 필드."

msgid "URI value"
msgstr "URI 값"

msgid "URI"
msgstr "URI"

msgid "An entity field containing a URI."
msgstr "URI를 포함하고 있는 엔티티 필드."

msgid "An entity field containing a UUID."
msgstr "UUID를 포함하고 있는 엔티티 필드."

msgid "Use field label instead of the \"On\" label as the label."
msgstr "레이블로 \"On\" 레이블 대신 필드 레이블 사용."

msgid "Use field label: @display_label"
msgstr "필드 레이블 사용: @display_label"

msgid "Single on/off checkbox"
msgstr "단일 온/오프 확인상자"

msgid "Textfield size"
msgstr "텍스트 필드 크기"

msgid "Text that will be shown inside the field until a value is entered. This hint is usually a sample value or a brief description of the expected format."
msgstr "값을 입력할 때까지 필드 내에 표시되는 텍스트입니다. 이 힌트는 샘플 값 또는 예상 형식의 간략한 설명입니다."

msgid "Placeholder: @placeholder"
msgstr "플레이스홀더: @placeholder"

msgid "No placeholder"
msgstr "플레이스홀더 없음"

msgid "Textfield size: @size"
msgstr "텍스트 필드 크기: @size"

msgid "Autocomplete (Tags style)"
msgstr "자동 완성 (태그)"

msgid "An autocomplete text field with tagging support."
msgstr "태그 지정을 지원하는 자동 완성 텍스트 필드."

msgid "Select the method used to collect autocomplete suggestions. Note that <em>Contains</em> can cause performance issues on sites with thousands of entities."
msgstr "자동 완성 제안을 수집하는 데 사용되는 방법을 선택하십시오. <em>포함</em>은 수천 개의 엔티티가 있는 사이트에서 성능 문제를 일으킬 수 있습니다."

msgid "Number of results"
msgstr "결과 수"

msgid "The number of suggestions that will be listed. Use <em>0</em> to remove the limit."
msgstr "나열될 제안 수입니다. 한계를 제거하려면 <em>0</em>을 사용하십시오."

msgid "Autocomplete matching: @match_operator"
msgstr "자동 완성 일치: @match_operator"

msgid "unlimited"
msgstr "무제한"

msgid "Autocomplete suggestion list size: @size"
msgstr "자동 완성 제안 목록 크기: @size"

msgid "Starts with"
msgstr "...로 시작"

msgid "Contains"
msgstr "포함"

msgid "Autocomplete"
msgstr "자동완성"

msgid "An autocomplete text field."
msgstr "자동 완성 텍스트 필드입니다."

msgid "Include locked languages such as <em>Not specified</em> and <em>Not applicable</em>"
msgstr "잠긴 언어(예: <em>지정되지 않음</em> 및 <em>적용할 수 없음</em>) 포함"

msgid "Language select"
msgstr "언어선택"

msgid "Number field"
msgstr "숫자 필드"

msgid "N/A"
msgstr "해당 없음"

msgid "Check boxes/radio buttons"
msgstr "체크박스/라디오 버튼"

msgid "- Select a value -"
msgstr "- 값 선택하기 -"

msgid "Select list"
msgstr "선택 목록"

msgid "@name field is required."
msgstr "@name 필드는 필수입니다."

msgid "Number of rows: @rows"
msgstr "행 수: @rows"

msgid "Text area (multiple rows)"
msgstr "텍스트 영역 (여러 행)"

msgid "Textfield"
msgstr "텍스트 필드"

msgid "URI field size: @size"
msgstr "URI 필드 크기: @size"

msgid "The file permissions could not be set on %uri."
msgstr "%uri 에서 파일 권한을 설정할 수 없습니다."

msgid "The specified file '%source' could not be copied to '%destination'."
msgstr "지정된 '%source' 파일을 '%destination'(으)로 복사할 수 없습니다."

msgid "Failed to unlink file '%path'."
msgstr "'%path' 파일을 링크 해제하지 못했습니다."

msgid "Cannot delete '%path' because it is a directory. Use deleteRecursive() instead."
msgstr "'%path'은(는) 디렉토리이기 때문에 삭제할 수 없습니다. 대신 deleteRecursive()를 사용하십시오."

msgid "The file '%path' is not of a recognized type so it was not deleted."
msgstr "'%path' 파일이 인식되는 유형이 아니므로 삭제되지 않았습니다."

msgid "The specified file '%source' could not be moved to '%destination'."
msgstr "지정된 '%source' 파일을 '%destination'(으)로 이동할 수 없습니다."

msgid "The source file '%source' could not be unlinked after copying to '%destination'."
msgstr "'%source' 소스 파일은 '%destination'(으)로 복사한 후 링크 해제할 수 없습니다."

msgid "File '%original_source' ('%realpath') could not be copied because it does not exist."
msgstr "'%original_source'('%realpath') 파일은 존재하지 않기 때문에 복사할 수 없습니다."

msgid "File '%original_source' could not be copied because it does not exist."
msgstr "'%original_source' 파일이 존재하지 않기 때문에 복사할 수 없습니다."

msgid "The specified file '%original_source' could not be copied because the destination directory '%destination_directory' is not properly configured. This may be caused by a problem with file or directory permissions."
msgstr "지정된 '%original_source' 파일은 대상 디렉토리 '%destination_directory'가 제대로 구성되지 않았기 때문에 복사할 수 없습니다. 이것은 파일 또는 디렉토리 권한 문제가 원인일 수 있습니다."

msgid "File '%original_source' could not be copied because a file by that name already exists in the destination directory ('%destination')."
msgstr "해당 이름의 파일이 이미 대상 디렉토리('%destination')에 존재하기 때문에 '%original_source' 파일을 복사할 수 없습니다."

msgid "File '%source' could not be copied because it would overwrite itself."
msgstr "'%source' 파일이 자신을 겹쳐쓰기 때문에 복사할 수 없습니다."

msgid "Temporary file '%temp_name' could not be created."
msgstr "임시 파일 '%temp_name'을(를) 작성할 수 없습니다."

msgid "@dir can not be opened"
msgstr "@dir 디렉토리를 열 수 없습니다."

msgid "Security warning: Couldn't write .htaccess file. Please create a .htaccess file in your %directory directory which contains the following lines: <pre><code>@htaccess</code></pre>"
msgstr "보안 경고: .htaccess 파일을 생성할 수 없습니다. 직접 %directory 디렉토리에 다음 코드가 들어있는 .htaccess 파일을 생성하세요. <pre><code>@htaccess</code></pre>"

msgid "Username"
msgstr "아이디"

msgid "Your password is not saved in the database and is only used to establish a connection."
msgstr "비밀번호는 데이터베이스에 저장되지 않고 연결을 설정하는 데만 사용됩니다."

msgid "Advanced settings"
msgstr "고급 설정"

msgid "The connection will be created between your web server and the machine hosting the web server files. In the vast majority of cases, this will be the same machine, and \"localhost\" is correct."
msgstr "웹서버와 웹서버 파일을 호스팅하는 기계간 연결을 생성합니다. 대부분의 경우 동일한 기계이며 \"localhost\"가 맞습니다."

msgid "Port"
msgstr "포트"

msgid "Unable to continue, no available methods of file transfer"
msgstr "파일을 전송할 방법이 없어, 진행을 할 수 없습니다."

msgid "WARNING: You are not using an encrypted connection, so your password will be sent in plain text. <a href=\":https-link\">Learn more</a>."
msgstr "경고: 암호화된 연결을 사용하지 않으므로 비밀번호가 일반 텍스트로 전송됩니다. <a href=\":https-link\">자세히 보기</a>."

msgid "To continue, provide your server connection details"
msgstr "계속하려면, 사용자의 서버 연결 정보를 자세히 입력하세요."

msgid "Connection method"
msgstr "연결 방법"

msgid "Enter connection settings"
msgstr "연결 설정 입력"

msgid "Continue"
msgstr "계속"

msgid "@backend connection settings"
msgstr "@backend 연결 설정"

msgid "Change connection type"
msgstr "연결 종류 변경"

msgid "Failed to connect to the server. The server reports the following message: <p class=\"error\">@message</p> For more help adding or updating code on your server, see the <a href=\":handbook_url\">handbook</a>."
msgstr "서버에 연결하는 데 실패했습니다. 서버는 다음 메시지를 보고합니다. <p class=\"error\">@message</p> 서버에서 코드를 추가하거나 업데이트하는 데 대한 자세한 정보는 <a href=\":handbook_url\">핸드북</a>을 참조하십시오."

msgid "Save configuration"
msgstr "설정 저장"

msgid "The configuration options have been saved."
msgstr "설정을 저장했습니다."

msgid "Form build-id mismatch detected while attempting to store a form in the cache."
msgstr "폼을 캐시에 저장하려고 하는데, 폼 빌드 아이디가 일치하지 않습니다."

msgid "The form has become outdated. Press the back button, copy any unsaved work in the form, and then reload the page."
msgstr "양식이 오래되었습니다. 이전 단추를 누르고 양식에 저장되지 않은 작업을 복사한 후 페이지를 다시 로드하십시오."

msgid "@name cannot be longer than %max characters but is currently %length characters long."
msgstr "@name은 %max문자보다 길 수 없지만 현재 %length문자입니다."

msgid "The submitted value %choice in the %name element is not allowed."
msgstr "%name 요소의 제출된 값 %choice 은(는) 허용되지 않습니다."

msgid "An unrecoverable error occurred. The uploaded file likely exceeded the maximum file size (@size) that this server supports."
msgstr "복구할 수 없는 에러가 발생했습니다. 업로드한 파일 크기가 이 서버가 지원하는 최대 제한 크기 (@size)를 초과한 듯 합니다."

msgid "The image toolkit '@toolkit' failed processing '@operation' for image '@image'. Reported error: @class - @message"
msgstr "이미지 툴킷 '@toolkit'이(가) 이미지 '@image'에 대한 '@operation'을(를) 처리하는 데 실패했습니다. 보고된 오류: @class - @message"

msgid "The selected image handling toolkit '@toolkit' can not process operation '@operation'."
msgstr "선택한 이미지 처리 툴킷 '@toolkit'은 '@operation' 조작을 처리할 수 없습니다."

msgid "Drupal already installed"
msgstr "드루팔이 이미 설치되어 있습니다"

msgid ""
"<ul>\n"
"<li>To start over, you must empty your existing database and copy <em>default.settings.php</em> over <em>settings.php</em>.</li>\n"
"<li>To upgrade an existing installation, proceed to the <a href=\":update-url\">update script</a>.</li>\n"
"<li>View your <a href=\":base-url\">existing site</a>.</li>\n"
"</ul>"
msgstr ""
"<ul>\n"
"<li>다시 시작하려면 기존 데이터베이스를 비우고 <em>settings.php</em>를 통해 <em>default.settings.php</em>를 복사해야 합니다.</li>\n"
"<li>기존 설치를 업그레이드하려면, <a href=\":update-url\">스크립트 업데이트</a>로 진행하십시오.</li>\n"
"<li><a href=\":base-url\">기존 사이트</a>를 보십시오.</li>\n"
"</ul>"

msgid "No profiles available"
msgstr "가능한 프로필 없음."

msgid "We were unable to find any installation profiles. Installation profiles tell us what modules to enable and what schema to install in the database. A profile is necessary to continue with the installation process."
msgstr "설치 프로필이 없습니다. 설치 프로필은 어떤 모듈을 사용할지와 어떤 데이터구조를 데이터베이스에 설치할지 알려줍니다. 프로필이 없으면 설치 과정을 진행할 수 없습니다."

msgid "Select an installation profile"
msgstr "설치 프로필을 선택하십시오."

msgid "Use existing configuration"
msgstr "기존 구성 사용"

msgid "Install %name using existing configuration."
msgstr "기존 구성을 사용하여 %name을(를) 설치합니다."

msgid "The configuration from the directory %sync_directory will be used."
msgstr "디렉토리 %sync_directory의 구성이 사용됩니다."

msgid "Save and continue"
msgstr "저장하고 계속하기"

msgid "All necessary changes to %dir and %file have been made, so you should remove write permissions to them now in order to avoid security risks. If you are unsure how to do so, consult the <a href=\":handbook_url\">online handbook</a>."
msgstr "%dir 및 %file에 필요한 모든 변경이 이루어졌으므로 보안 위험을 피하기 위해 지금은 쓰기 권한을 제거해야 합니다. 쓰기 권한을 제거하는 방법은 <a href=\":handbook_url\">온라인 핸드북</a>을 참조하십시오."

msgid "Site information"
msgstr "사이트 정보"

msgid "Site email address"
msgstr "사이트 이메일 주소"

msgid "Automated emails, such as registration information, will be sent from this address. Use an address ending in your site's domain to help prevent these emails from being flagged as spam."
msgstr "자동화된 이메일(예:등록 정보)이 이 주소에서 전송됩니다. 사이트 도메인으로 끝나는 주소를 사용하여 이 이메일이 스팸으로 플래그 지정되지 않도록 방지합니다."

msgid "Site maintenance account"
msgstr "사이트 유지보수 계정"

msgid "Several special characters are allowed, including space, period (.), hyphen (-), apostrophe ('), underscore (_), and the @ sign."
msgstr "공백, 마침표(.), 하이픈(-), 어포스트로피('), 밑줄(_), @ 부호를 포함하여 여러 특수 문자가 허용됩니다."

msgid "Email address"
msgstr "이메일 주소"

msgid "Regional settings"
msgstr "지역 설정"

msgid "Default country"
msgstr "기본 국가"

msgid "Default time zone"
msgstr "기본 시간대"

msgid "Update notifications"
msgstr "업데이트 알림"

msgid "When checking for updates, anonymous information about your site is sent to <a href=\"@drupal\">Drupal.org</a>."
msgstr "업데이트를 확인할 때 사이트에 대한 익명 정보가 <a href=\"@drupal\">Drupal.org</a>로 전송됩니다."

msgid "Check for updates automatically"
msgstr "자동으로 업데이트 확인"

msgid "Receive email notifications"
msgstr "메일로 알림을 받음"

msgid "Database configuration"
msgstr "데이터베이스 설정"

msgid "Database type"
msgstr "데이터베이스 유형"

msgid "@driver_name settings"
msgstr "@driver_name 설정"

msgid "Resolve all issues below to continue the installation. For help configuring your database server, see the <a href=\"https://www.drupal.org/docs/installing-drupal\">installation handbook</a>, or contact your hosting provider."
msgstr "설치를 계속하려면 아래의 모든 문제를 해결하십시오. 데이터베이스 서버 구성에 관한 도움말은 <a href=\"https://www.drupal.org/docs/installing-drupal\">설치 핸드북</a>을 참조하거나 호스팅 제공업체에 문의하십시오."

msgid "Interface text"
msgstr "인터페이스 텍스트"

msgid "Order of language detection methods for interface text. If a translation of interface text is available in the detected language, it will be displayed."
msgstr "인터페이스 텍스트의 언어 발견 방법 순서. 인터페이스 텍스트의 번역이 발견된 언어로 사용 가능하면 표시됩니다."

msgid "Order of language detection methods for content. If a version of content is available in the detected language, it will be displayed."
msgstr "콘텐츠에 대한 언어 인식 방법의 순서입니다. 다른 언어로 사용할 수 있는 콘텐츠가 있다면, 해당 언어를 표시합니다."

msgid "None"
msgstr "없음"

msgid "Unknown"
msgstr "알 수 없음"

msgid "Unknown (@langcode)"
msgstr "알 수 없음 (@langcode)"

