msgstr "썸네일"

msgid "Media Name"
msgstr "매체 이름"

msgid "Unpublished"
msgstr "비공개"

msgid "%type_name: Create new media"
msgstr "%type_name: 새 매체 작성"

msgid "%type_name: Edit own media"
msgstr "%type_name: 사용자 매체 편집"

msgid "%type_name: Edit any media"
msgstr "%type_name: 모든 매체 편집"

msgid "%type_name: Delete own media"
msgstr "%type_name: 사용자 매체 삭제"

msgid "%type_name: Delete any media"
msgstr "%type_name: 모든 매체 삭제"

msgid "Field with source information"
msgstr "소스 정보가 있는 필드"

msgid "- Create -"
msgstr "- 작성 -"

msgid "Select the field that will store essential information about the media item. If \"Create\" is selected a new field will be automatically created."
msgstr "매체 항목에 대한 필수 정보를 저장할 필드를 선택하십시오. \"작성\"이 선택되면 새 필드가 자동으로 작성됩니다."

msgid "%field_type field will be automatically created on this type to store the essential information about the media item."
msgstr "%field_type 필드는 매체 항목에 대한 필수 정보를 저장하기 위해 이 유형에 자동으로 생성됩니다."

msgid "%field_name field is used to store the essential information about the media item."
msgstr "%field_name 필드는 매체 항목에 관한 필수 정보를 저장하는 데 사용됩니다."

msgid "The human-readable name of this media type."
msgstr "이 매체 유형의 사람이 읽을 수 있는 이름."

msgid "A unique machine-readable name for this media type."
msgstr "이 매체 유형의 고유한 시스템이 읽을 수 있는 이름."

msgid "Describe this media type. The text will be displayed on the <em>Add new media</em> page."
msgstr "이 매체 유형을 설명합니다. 텍스트가 <em>새 미디어 추가</em> 페이지에 추가됩니다."

msgid "<em>The media source cannot be changed after the media type is created.</em>"
msgstr "<em>매체 유형을 작성한 후에는 매체 소스를 변경할 수 없습니다.</em>"

msgid "Media source that is responsible for additional logic related to this media type."
msgstr "이 매체 유형과 관련된 추가 논리를 담당하는 매체 소스."

msgid "Media source"
msgstr "매체 소스"

msgid "Media source configuration"
msgstr "매체 소스 구성"

msgid "Field mapping"
msgstr "필드 맵핑"

msgid "Media sources can provide metadata fields such as title, caption, size information, credits, etc. Media can automatically save this metadata information to entity fields, which can be configured below. Information will only be mapped if the entity field is empty."
msgstr "매체 소스는 제목, 캡션, 크기 정보, 신용 등과 같은 메타데이터 필드를 제공할 수 있습니다. 매체는 아래에서 이 메타데이터 정보를 구성할 수 있는 엔티티 필드에 자동으로 저장할 수 있습니다. 엔티티 필드가 비어있는 경우에만 정보가 맵핑됩니다."

msgid "- Skip field -"
msgstr "- 필드 건너뛰기 -"

msgid "Publishing options"
msgstr "공개 설정"

msgid "Default options"
msgstr "기본 설정"

msgid "Queue thumbnail downloads"
msgstr "큐 작은 그림 다운로드"

msgid "Media will be automatically published when created."
msgstr "매체는 작성될 때 자동으로 공개됩니다."

msgid "Automatically create new revisions. Users with the \"Administer media\" permission will be able to override this option."
msgstr "자동으로 새 개정판 작성. \"매체 관리\" 권한을 가진 사용자는 이 옵션을 대체할 수 있습니다."

msgid "Download thumbnails via a queue. When using remote media sources, the thumbnail generation could be a slow process. Using a queue allows for this process to be handled in the background."
msgstr "큐를 통해 작은 그림 다운로드. 원격 매체 소스를 사용할 때 작은 그림 생성이 느린 프로세스일 수 있습니다. 큐를 사용하면 이 프로세스를 백그라운드에서 처리할 수 있습니다."

msgid "The media type %name has been updated."
msgstr "매체 유형 %name이(가) 업데이트되었습니다."

msgid "The media type %name has been added."
msgstr "매체 유형 %name이(가) 추가되었습니다."

msgid "Added media type %name."
msgstr "추가된 매체 유형 %name."

msgid "No media types available. <a href=\":url\">Add media type</a>."
msgstr "사용 가능한 매체 유형이 없습니다. <a href=\":url\">매체 유형 추가</a>."

msgid "Published status or admin user"
msgstr "공개된 상태 또는 관리 사용자"

msgid "Filters out unpublished media if the current user cannot view it."
msgstr "현재 사용자가 볼 수 없는 경우 공개되지 않은 매체를 필터링합니다."

msgid "The thumbnail of the media item."
msgstr "매체 항목의 작은 그림."

msgid "The user ID of the author."
msgstr "작성자의 사용자 ID."

msgid "The time the media item was created."
msgstr "매체 항목이 작성된 시간."

msgid "The time the media item was last edited."
msgstr "매체 항목이 마지막으로 편집된 시간."

msgid "media item"
msgstr "매체 항목"

msgid "media items"
msgstr "매체 항목"

msgid "media type"
msgstr "매체 유형"

msgid "media types"
msgstr "매체 유형"

msgid "Alternate text"
msgstr "대체 텍스트"

msgid "There is nothing to configure for this media."
msgstr "이 매체에 대해 구성할 항목이 없습니다."

msgid "@warning <a href=\"@edit_url\">Edit the text format %format</a> to modify the attributes that can be overridden."
msgstr "@warning <a href=\"@edit_url\">텍스트 형식 %format을(를) 편집</a>하여 대체될 수 있는 속성을 수정하십시오."

msgid "It is potentially insecure to display oEmbed content in a frame that is served from the same domain as your main Drupal site, as this may allow execution of third-party code. Refer to <a href=\"https://oembed.com/#section3\">oEmbed Security Considerations</a>."
msgstr "기본 Drupal 사이트와 동일한 도메인에서 제공하는 프레임에 oEmbed 컨텐츠를 표시하는 것은 써드파티 코드를 실행할 수 있기 때문에 잠재적으로 안전하지 않습니다. <a href=\"https://oembed.com/#section3\">oEmbed 보안 고려 사항</a>을 참조하십시오."

msgid "Displaying media assets from third-party services, such as YouTube or Twitter, can be risky. This is because many of these services return arbitrary HTML to represent those assets, and that HTML may contain executable JavaScript code. If handled improperly, this can increase the risk of your site being compromised."
msgstr "YouTube 또는 Twitter와 같은 써드파티 서비스에서 매체 자산을 표시하는 것은 위험할 수 있습니다. 이는 이러한 서비스 중 많은 수가 임의 HTML을 반환하여 해당 자산을 나타내고 HTML에 실행 가능한 JavaScript 코드가 포함되어 있을 수 있기 때문입니다. 부적절하게 처리하면 사이트가 손상될 위험성이 커질 수 있습니다."

msgid "In order to mitigate the risks, third-party assets are displayed in an iFrame, which effectively sandboxes any executable code running inside it. For even more security, the iFrame can be served from an alternate domain (that also points to your Drupal site), which you can configure on this page. This helps safeguard cookies and other sensitive information."
msgstr "위험성을 완화하기 위해 써드파티 자산이 iFrame에 표시되어 그 내부에서 실행되는 실행 가능한 코드를 효과적으로 샌드박스합니다. 보안을 강화하기 위해 iFrame은 이 페이지에서 구성할 수 있는 대체 도메인(Drupal 사이트를 가리킴)에서 제공될 수 있습니다. 이렇게 하면 쿠키 및 기타 민감한 정보를 보호할 수 있습니다."

msgid "Security"
msgstr "보안"

msgid "iFrame domain"
msgstr "iFrame 도메인"

msgid "Enter a different domain from which to serve oEmbed content, including the <em>http://</em> or <em>https://</em> prefix. This domain needs to point back to this site, or existing oEmbed content may not display correctly, or at all."
msgstr "oEmbed 컨텐츠(<em>http://</em> 또는 <em>https://</em> 접두부 포함)를 제공하는 다른 도메인을 입력하십시오. 이 도메인은 이 사이트를 다시 가리켜야 하거나 기존 oEmbed 컨텐츠가 올바르게 표시되지 않거나 전혀 표시되지 않을 수 있습니다."

msgid "Standalone media URL"
msgstr "독립형 매체 URL"

msgid "Allow users to access @media-entities at /media/{id}."
msgstr "사용자가 /media/{id}의 @media-entities에 액세스하도록 허용합니다."

msgid "%type is used by @count media item on your site. You can not remove this media type until you have removed all of the %type media items."
msgid_plural "%type is used by @count media items on your site. You can not remove this media type until you have removed all of the %type media items."
msgstr[0] "%type은(는) @count개의 매체 항목에 의해 사용됩니다. 모든 %type 매체 항목을 제거할 때까지 이 매체 유형을 제거할 수 없습니다."

msgid "Remote oEmbed providers could not be retrieved due to error: @error. Using previously stored data. This may contain out of date information."
msgstr "@error 오류로 인해 원격 oEmbed 제공자를 검색할 수 없습니다. 이전에 저장된 데이터가 사용됩니다. 여기에 오래된 정보가 포함되어 있을 수 있습니다."

msgid "Remote oEmbed providers database returned invalid or empty list. Using previously stored data. This may contain out of date information."
msgstr "원격 oEmbed 제공자 데이터베이스에서 올바르지 않거나 비어 있는 목록을 리턴했습니다. 이전에 저장된 데이터가 사용됩니다. 여기에 오래된 정보가 포함되어 있을 수 있습니다."

msgid "Media selection"
msgstr "매체 선택"

msgid "Media item"
msgstr "매체 항목"

msgid "Linked to media item"
msgstr "매체 항목에 링크됨"

msgid "oEmbed loading"
msgstr "oEmbed 로딩"

msgid "Lazy render oEmbed with native loading attribute (<em>loading=\"lazy\"</em>). This improves performance by allowing browsers to lazily load assets."
msgstr "원시 로딩 속성(<em>loading=\"lazy\"</em>)이 있는 지연 렌더링 oEmbed입니다. 이는 브라우저가 자산을 느리게 로드할 수 있도록 하여 성능을 향상시킵니다."

msgid "oEmbed loading attribute"
msgstr "oEmbed 로딩 속성"

msgid "Select the loading attribute for oEmbed. <a href=\":link\">Learn more about the loading attribute for oEmbed.</a>"
msgstr "oEmbed에 대한 로딩 속성을 선택하십시오. <a href=\":link\"> oEmbed의 로딩 속성에 대해 자세히 알아보십시오.</a>"

msgid "Delays loading the resource until that section of the page is visible in the browser. When in doubt, lazy loading is recommended."
msgstr "페이지의 해당 섹션이 브라우저에 표시될 때까지 자원 로드를 지연합니다. 무엇이 좋을지 모르는 경우에는 지연 로딩이 권장됩니다."

msgid "Force browsers to download a resource as soon as possible. This is the browser default for legacy reasons. Only use this option when the resource is always expected to render."
msgstr "브라우저가 가능한 빨리 자원을 다운로드하도록 강제 실행합니다. 이는 레거시 이유로 인해 브라우저 기본값입니다. 자원이 항상 렌더링될 것으로 예상되는 경우에만 이 옵션을 사용하십시오."

msgid "Maximum size: %max_width x %max_height pixels"
msgstr "최대 크기: %max_width x %max_height 픽셀"

msgid "Maximum width: %max_width pixels"
msgstr "최대 너비: %max_width 픽셀"

msgid "Maximum height: %max_height pixels"
msgstr "최대 높이: %max_height 픽셀"

msgid "Loading attribute: @attribute"
msgstr "로딩 속성: @attribute"

msgid "Could not retrieve the remote URL (@url)."
msgstr "원격 URL(@url)을 검색할 수 없습니다."

msgid "oEmbed content"
msgstr "oEmbed 컨텐츠"

msgid "You can link to media from the following services: @providers"
msgstr "다음 서비스에서 매체를 링크할 수 있습니다. @providers"

msgid "oEmbed URL"
msgstr "oEmbed URL"

msgid "Default view mode"
msgstr "기본 보기 모드"

msgid "The view mode that an embedded media item should be displayed in by default. This can be overridden using the <code>data-view-mode</code> attribute."
msgstr "기본적으로 임베드된 매체 항목이 표시되어야 하는 보기 모드입니다. <code>data-view-mode</code> 속성을 사용하여 이를 대체할 수 있습니다."

msgid "If none are selected, all will be allowed."
msgstr "없음을 선택하면 모두 허용됩니다."

msgid "View modes selectable in the 'Edit media' dialog"
msgstr "'매체 편집' 대화 상자에서 선택 가능한 보기 모드"

msgid "If two or more view modes are selected, users will be able to update the view mode that an embedded media item should be displayed in after it has been embedded.  If less than two view modes are selected, media will be embedded using the default view mode and no view mode options will appear after a media item has been embedded."
msgstr "두 개 이상의 보기 모드가 선택된 경우 사용자가 임베드된 매체 항목이 임베드된 후 표시되어야 하는 보기 모드를 업데이트할 수 있습니다. 두 개 미만의 보기 모드가 선택되면 매체가 기본 보기 모드를 사용하여 임베드되고 매체 항목이 임베드된 후 보기 모드 옵션이 표시되지 않습니다."

msgid "The referenced media source is missing and needs to be re-embedded."
msgstr "참조된 매체 소스가 누락되었으며 다시 임베드되어야 합니다."

msgid ""
"\n"
"      <p>You can embed media items:</p>\n"
"      <ul>\n"
"        <li>Choose which media item to embed: <code>&lt;drupal-media data-entity-uuid=\"07bf3a2e-1941-4a44-9b02-2d1d7a41ec0e\" /&gt;</code></li>\n"
"        <li>Optionally also choose a view mode: <code>data-view-mode=\"tiny_embed\"</code>, otherwise the default view mode is used.</li>\n"
"        <li>The <code>data-entity-type=\"media\"</code> attribute is required for consistency.</li>\n"
"      </ul>"
msgstr ""
"\n"
"      <p>매체 유형을 임베드할 수 있습니다.</p>\n"
"      <ul>\n"
"        <li>임베드할 매체 유형을 선택하십시오. <code>&lt;drupal-media data-entity-uuid=\"07bf3a2e-1941-4a44-9b02-2d1d7a41ec0e\" /&gt;</code></li>\n"
"        <li>선택적으로 보기 모드를 선택하십시오. <code>data-view-mode=\"tiny_embed\"</code> 선택하지 않으면 기본 보기 모드가 사용됩니다.</li>\n"
"        <li>일관성을 위해 <code>data-entity-type=\"media\"</code> 속성이 필요합니다.</li>\n"
"      </ul>"

msgid "You can embed media items (using the <code>&lt;drupal-media&gt;</code> tag)."
msgstr "<code>&lt;drupal-media&gt;</code> 태그를 사용하여 매체 항목을 임베드할 수 있습니다."

msgid "During rendering of embedded media: recursive rendering detected for %entity_id. Aborting rendering."
msgstr "임베드된 매체 렌더링 중에 %entity_id에 대한 재귀 렌더링이 발견되었습니다. 렌더링을 중단하는 중입니다."

msgid "During rendering of embedded media: the media item with UUID \"@uuid\" does not exist."
msgstr "임베드된 매체 렌더링 중에 UUID가 \"@uuid\"인 매체 유형이 존재하지 않습니다."

msgid "During rendering of embedded media: the view mode \"@view-mode-id\" does not exist."
msgstr "임베드된 매체 렌더링 중에 보기 모드 \"@view-mode-id\"이(가) 존재하지 않습니다."

msgid "Embed media"
msgstr "매체 임베드"

msgid "Embeds media items using a custom tag, <code>&lt;drupal-media&gt;</code>. If used in conjunction with the 'Align/Caption' filters, make sure this filter is configured to run after them."
msgstr "사용자 정의 태그 <code>&lt;drupal-media&gt;</code>를 사용하여 매체 항목을 임베드합니다. '맞추기/캡션' 필터와 함께 사용되는 경우 이 필터가 다음에 실행되도록 구성되었는지 확인하십시오."

msgid "Thumbnail downloader"
msgstr "작은 그림 다운로더"

msgctxt "Validation"
msgid "oEmbed resource"
msgstr "oEmbed 자원"

msgid "The given URL does not match any known oEmbed providers."
msgstr "지정된 URL이 알려진 oEmbed 제공자와 일치하지 않습니다."

msgid "Sorry, the @name provider is not allowed."
msgstr "죄송합니다! @name 제공자는 허용되지 않습니다."

msgid "The provided URL does not represent a valid oEmbed resource."
msgstr "제공된 URL이 올바른 oEmbed 자원을 표시하지 않습니다."

msgid "An error occurred while trying to retrieve the oEmbed provider database."
msgstr "oEmbed 제공자 데이터베이스를 검색하는 중에 오류가 발생했습니다."

msgid "Audio file"
msgstr "오디오 파일"

msgid "Use audio files for reusable media."
msgstr "재사용가능 매체에 대해 오디오 파일 사용."

