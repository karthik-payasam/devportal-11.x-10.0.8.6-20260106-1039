msgid "Batch"
msgstr "Traitement par lots"

msgid "Exports under one request. Best fit for small exports."
msgstr "Exporte les données en une requête. Convient aux exportations de petite taille."

msgid "Exports data in sequences. Should be used when large amount of data is exported (> 2000 rows)."
msgstr "Exporte les données en séquences. Convient aux exportations de grande taille (> 2000 lignes)."

msgid "The number of rows to process under a request."
msgstr "Nombre de lignes à traiter pour une requête."

msgid "The maximum amount of rows to export. 0 means unlimited."
msgstr "Nombre maximal de lignes à exporter. La valeur 0 signifie qu'il n'y a pas de limite. "

msgid "File Storage/Download Settings"
msgstr "Paramètres de stockage/téléchargement de fichier"

msgid "Filename"
msgstr "Nom du fichier"

msgid "The filename that will be suggested to the browser for downloading purposes. You may include replacement patterns from the list below."
msgstr "Le nom de fichier qui sera proposé au navigateur pour le téléchargement. Vous pouvez inclure les motifs de remplacement de la liste ci-dessous."

msgid "Store file in public files directory"
msgstr "Stocker les fichiers dans le répertoire de fichiers publics"

msgid "Check this if you want to store the export files in the public:// files directory instead of the private:// files directory."
msgstr "Cochez cette case si vous souhaitez stocker les fichiers d'exportation dans le répertoire de fichiers public:// et non dans le répertoire private://."

msgid "<strong>The private:// file system is not configured so the exported files will be stored in the public:// files directory. Click <a href=\"@link\" target=\"_blank\">here</a> for instructions on configuring the private files in the settings.php file.</strong>"
msgstr "<strong>Le système de fichiers private:// n'est pas configuré. Par conséquent, les fichiers exportés seront stockés dans le répertoire de fichiers public://. Cliquez <a href=\"@link\" target=\"_blank\">ici</a> pour en savoir plus sur la configuration des fichiers privés dans le fichier settings.php.</strong>"

msgid "Check this if you want to download the file immediately after it is created. Does <strong>NOT</strong> work for JSON data exports."
msgstr "Cochez cette case si vous voulez télécharger le fichier immédiatement après sa création. Ne fonctionne <strong>PAS</strong> avec les exportations de données JSON."

msgid "Check this if you want to configure a custom redirect path."
msgstr "Cochez cette case si vous voulez configurer un chemin de redirection personnalisé."

msgid "Select the display to redirect to after batch finishes. If None is selected the user will be redirected to the front page."
msgstr "Sélectionnez l'écran vers lequel revenir à la fin du traitement par lots. Si Aucun est sélectionné, l'utilisateur est redirigé vers la page d'accueil."

msgid "Enter custom path to redirect user after batch finishes."
msgstr "Entrez un chemin personnalisé vers lequel rediriger l'utilisateur à la fin du traitement par lots."

msgid "Check this if you want to include query string parameters on redirect."
msgstr "Cochez cette option si vous voulez inclure des paramètres de chaîne de requête lors de la redirection."

msgid "Displays"
msgstr "Affichages"

msgid "The data export icon will be available only to the selected displays."
msgstr "L'icône d'exportation des données ne sera disponible que dans les écrans sélectionnés. "

msgid "Choose the facet source used to alter data export. This should be the display that this data export is attached to."
msgstr "Choisissez la source de la facette utilisée pour modifier l'exportation des données. Il doit s'agir de l'écran auquel cette exportation des données est associée."

msgid "Could not write to temporary output file for result export (@file). Check permissions."
msgstr "Impossible d'écrire dans le fichier de rendu temporaire pour le résultat d'exportation (@file). Veuillez vérifier les droits."

msgid "Export complete. Download the file <a download href=\":download_url\"  data-download-enabled=\"false\" id=\"vde-automatic-download\">here</a>."
msgstr "Export terminé. <a download href=\":download_url\" data-download-enabled=\"false\" id=\"vde-automatic-download\">Télécharger le fichier</a>."

msgid "Export complete. Download the file <a download href=\":download_url\" data-download-enabled=\"true\" id=\"vde-automatic-download\">here</a> if file is not automatically downloaded."
msgstr "Export terminé. <a download href=\":download_url\" data-download-enabled=\"true\" id=\"vde-automatic-download\">Cliquer ici pour télécharger le fichier</a> si le téléchargement ne démarre pas automatiquement."

msgid "Export failed. Make sure the private file system is configured and check the error log."
msgstr "L'exportation a échoué. Assurez-vous que le système de fichiers privé est configuré et consultez le journal des erreurs."

msgid "Data export"
msgstr "Exportation de données"

msgid "Export the view results to a file. Can handle very large result sets."
msgstr "Exporter les résultats de la vue dans un fichier. Peut traiter des ensembles de résultats très larges."

msgid "Indicates the character used to delimit fields. Defaults to a comma (<code>,</code>). For tab-separation use <code>\\t</code> characters."
msgstr "Indique le caractère utilisé pour délimiter les zones. Par défaut, il s'agit d'une virgule (<code>,</code>). Pour appliquer la tabulation comme séparateur, utilisez le caractère <code>\\t</code>. "

msgid "Indicates the character used for field enclosure. Defaults to a double quote (<code>\"</code>)."
msgstr "Indique le caractère utilisé pour délimiter une zone. Par défaut, il s'agit de guillemets (<code>\"</code>)."

msgid "Indicates the character used for escaping. Defaults to a backslash (<code>\\</code>)."
msgstr "Indique le caractère utilisé pour l'échappement. Par défaut, il s'agit d'une barre oblique inversée (<code>\\</code>)."

msgid "Strips HTML tags from CSV cell values."
msgstr "Retire les balises HTML des valeurs de cellule CSV. "

msgid "Trims whitespace from beginning and end of CSV cell values."
msgstr "Enlève les blancs au début et à la fin des valeurs de cellule CSV. "

msgid "Determines the encoding used for CSV cell values."
msgstr "Détermine le codage utilisé pour les valeurs de cellule CSV. "

msgid "UTF-8"
msgstr "UTF-8"

msgid "Include unicode signature (<a href=\"@bom\" target=\"_blank\">BOM</a>)."
msgstr "Incluez la signature unicode (<a href=\"@bom\" target=\"_blank\">BOM</a>)."

msgid "Only use Symfony serializer->encode method"
msgstr "Utiliser seulement la méthode Symfony serializer->encode"

msgid "Skips the symfony data normalize method when rendering data export to increase performance on large datasets. <strong>(Only use when not exporting nested data)</strong>"
msgstr "Ignore la méthode de normalisation des données symfony lors du rendu de l'exportation des données afin de renforcer les performances sur les grands ensembles de données. <strong>(A ne pas utiliser avec l'exportation de données imbriquées)</strong>"

msgid "Configurable row output for data exports."
msgstr "Sortie de ligne configurable pour les exportations de données. "

msgid "Download @format"
msgstr "Télécharger @format"

