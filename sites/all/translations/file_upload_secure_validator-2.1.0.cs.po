msgid "About"
msgstr "Popis"

msgid "Secure File Upload Mime Detect"
msgstr "Detekce zabezpečení odeslání souboru Mime"

msgid "Fileinfo extension"
msgstr "Rozšíření Fileinfo"

msgid "Found"
msgstr "Nalezeno"

msgid "Fileinfo extension not available"
msgstr "Rozšíření Fileinfo není k dispozici"

msgid "File upload secure validator module uses Fileinfo extension. It seems as if Fileinfo extension is not loaded/enabled. If you are using Windows, may be, you should uncomment php_fileinfo.dll in php.ini file."
msgstr "Zabezpečený validátor pro odeslání souboru používá rozšíření Fileinfo. Zdá se, jako kdyby rozšíření Fileinfo nebylo načteno/povoleno. Pokud používáte systém Windows, možná byste měli zrušit komentář souboru php_fileinfo.dll v souboru php.ini."

msgid "File Upload Secure Validator"
msgstr "Zabezpečený validátor pro odeslání souboru"

msgid "Secure Mime Detect"
msgstr "Zabezpečená detekce Mime"

msgid "Security"
msgstr "Bezpečnost"

msgid "Manage the list of MIME types equivalence groups."
msgstr "Správa seznamu skupin ekvivalence typů MIME."

msgid "Administer File Upload Secure Validator configuration"
msgstr "Spravovat konfiguraci zabezpečeného validátoru pro odeslání souboru"

msgid "Allow user to administer File Upload Secure Validator configuration."
msgstr "Povolte uživateli spravovat konfiguraci zabezpečeného validátoru pro odeslání souboru."

msgid "SettingsForm"
msgstr "SettingsForm"

msgid "MIME types equivalence groups"
msgstr "Skupiny ekvivalence typů MIME "

msgid "MIME types equivalence group"
msgstr "Skupina ekvivalence typů MIME"

msgid "MIME type"
msgstr "Typ MIME"

msgid "MIME types equivalence group(s)"
msgstr "Skupina(y) ekvivalence typů MIME"

msgid "A CSV-like list of MIME types groups; if two MIME types are part of the same group, then, File Upload Secure Validator will not protest."
msgstr "Seznam skupin typů MIME podobný CSV; jsou-li dva typy MIME součástí stejné skupiny, pak nebude Validátor zabezpečení odeslání souboru (File Upload Secure Validator) protestovat."

msgid "Caught an InvalidArgumentException; cannot validate missing file requested as @path"
msgstr "Zachycena výjimka InvalidArgumentException; nelze ověřit chybějící soubor požadovaný jako @path"

msgid "There was a problem with this file. The uploaded file is of type @extension but the real content seems to be @real_extension"
msgstr "Došlo k problému s tímto souborem. Odeslaný soubor je typu @extension, ale skutečný obsah se zdá být @real_extension"

msgid "Error while uploading file: MimeTypeGuesser guessed '%mime_by_fileinfo' and fileinfo '%mime_by_filename'"
msgstr "Chyba při odesílání souboru: MimeTypeGuesser odhadoval '%mime_by_fileinfo' a informace o souboru '%mime_by_filename'"

