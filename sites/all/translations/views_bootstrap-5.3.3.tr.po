msgid "@style style will not display without the \"@field\" setting."
msgstr "@style stili, \"@field\" ayarı olmadan görüntüler."

msgid "About"
msgstr "Hakkında"

msgid "The <a href=\":bootstrap\">Views Bootstrap module</a> adds styles to Views to output the results of a view as several common <a href=\":components\">Twitter Bootstrap</a> components."
msgstr "<a href=\":bootstrap\">Görünümler Bootstrap modülü</a>, birkaç genel <a href=\":components\">Twitter Bootstrap</a> bileşeni olarak bir görünüm sonuçlarının çıktısı için Görünümlere stilleri ekler."

msgid "Uses"
msgstr "Kullanım"

msgid "<a href=\":views\">Create a view</a> using one of the following styles:"
msgstr "Aşağıdaki stillerden birini kullanarak <a href=\":views\">bir görünüm oluşturun</a>:"

msgid "<a href=\":docs\">Accordion</a>"
msgstr "<a href=\":docs\">Akordeon</a>"

msgid "<a href=\":docs\">Cards</a>"
msgstr "<a href=\":docs\">Kartlar</a>"

msgid "<a href=\":docs\">Carousel</a>"
msgstr "<a href=\":docs\">Karusel</a>"

msgid "<a href=\":docs\">Dropdown</a>"
msgstr "<a href=\":docs\">Açılır liste</a>"

msgid "<a href=\":docs\">Grid</a>"
msgstr "<a href=\":docs\">Izgara</a>"

msgid "<a href=\":docs\">Thumbnails</a>"
msgstr "<a href=\":docs\">Küçük resimler</a>"

msgid "<a href=\":docs\">Tables</a>"
msgstr "<a href=\":docs\">Tablolar</a>"

msgid "<a href=\":docs\">Tabs</a>"
msgstr "<a href=\":docs\">Sekmeler</a>"

msgid "<a href=\":docs\">Media object</a>"
msgstr "<a href=\":docs\">Ortam nesnesi</a>"

msgid "<a href=\":docs\">List group</a>"
msgstr "<a href=\":docs\">Liste grubu</a>"

msgid "Views Bootstrap"
msgstr "Görünümler Bootstrap"

msgid "Views Twitter Bootstrap Components."
msgstr "Görünümler Twitter Bootstrap Bileşenleri."

msgid "Views"
msgstr "Görünümler"

msgid "The Bootstrap accordion displays content in collapsible panels (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap akordiyon, daraltılabilir panolarda içeriği görüntüler (<a href=\":docs\">belgelere bakın</a>)."

msgid "Panel title field"
msgstr "Pano başlığı alanı"

msgid "Select the field that will be used as the accordion panel titles."
msgstr "Akordiyon panosu başlıkları olarak kullanılacak alanı seçin."

msgid "Label field"
msgstr "Etiket alanı"

msgid "- None -"
msgstr "- Hiçbiri -"

msgid "Select the field that will be used as the label."
msgstr "Etiket olarak kullanılacak alanı seçin."

msgid "Collapse Options"
msgstr "Seçenekleri Daralt"

msgid "All Items Closed"
msgstr "Tüm Öğeler Kapalı"

msgid "First Item Open"
msgstr "İlk Öğe Açık"

msgid "All Items Open"
msgstr "Tüm Öğeler Açık"

msgid "Default panel state for collapse behavior."
msgstr "Daraltma davranışı için varsayılan pano durumu."

msgid "Bootstrap Accordion"
msgstr "Bootstrap Akordeon"

msgid "Displays rows in a Bootstrap Accordion."
msgstr "Bir Bootstrap Akordeon içindeki satırları görüntüler."

msgid "Card title field"
msgstr "Kart başlığı alanı"

msgid "Select the field that will be used for the card title."
msgstr "Kart başlığı için kullanılacak alanı seçin."

msgid "Card content field"
msgstr "Kart içeriği alanı"

msgid "Select the field that will be used for the card content."
msgstr "Kart içeriği için kullanılacak alanı seçin."

msgid "Card image field"
msgstr "Kart görüntüsü alanı"

msgid "Select the field that will be used for the card image."
msgstr "Kart görüntüsü için kullanılacak alanı seçin."

msgid "Custom card group class"
msgstr "Özel kart grubu sınıfı"

msgid "Additional classes to provide on the card group. Separated by a space."
msgstr "Kart grubunda sağlanacak ek sınıflar. Boşlukla ayrılmış olarak belirtilir."

msgid "Additional classes to provide on each card. Separated by a space."
msgstr "Her kartta sağlanacak ek sınıflar. Boşlukla ayrılmış olarak belirtilir."

msgid "Bootstrap Cards"
msgstr "Önyükleme Kartları"

msgid "Displays rows in a Bootstrap Card Group layout"
msgstr "Bir Önyükleme Kartı Grubu yerleşim düzeninde satırları görüntüler"

msgid "The Bootstrap carousel displays content as a slideshow (<a href=\":docs\">see documentation</a>)."
msgstr "Bootsrap karusel, içeriği bir slayt gösterisi olarak görüntüler (<a href=\":docs\">belgelere bakın</a>)."

msgid "<None>"
msgstr "<None>"

msgid "Interval"
msgstr "Aralık"

msgid "The amount of time to delay between automatically cycling an item. If false, carousel will not automatically cycle."
msgstr "Bir öğenin otomatik döngüsü arasındaki gecikme için süre. False ise karusel otomatik olarak dönmez."

msgid "Show navigation"
msgstr "Gezinmeyi göster"

msgid "Show indicators"
msgstr "Göstergeleri göster"

msgid "Pause on hover"
msgstr "İmleç getirildiğinde duraklat"

msgid "Pauses the cycling of the carousel on mouseenter and resumes the cycling of the carousel on mouseleave."
msgstr "Fare girişinde karuselin dönüşünü duraklatır ve fare ayrıldığında dönüşü sürdürür."

msgid "Wrap"
msgstr "Kaydır"

msgid "The carousel should cycle continuously or have hard stops."
msgstr "Karusel sürekli olarak dönmeli ya da sert duruşları olmalıdır."

msgid "Columns"
msgstr "Sütunlar"

msgid "The number of columns to include in the carousel."
msgstr "Karuselin içereceği sütun sayısı."

msgid "Breakpoints"
msgstr "Kesme Noktaları"

msgid "The min-width breakpoint of the multicolumn carousel."
msgstr "Çok hücreli karuselle ilgili en az genişlikli kesme noktası."

msgid "Extra Small"
msgstr "En Küçük"

msgid "Small"
msgstr "Küçük"

msgid "Medium"
msgstr "Orta"

msgid "Large"
msgstr "Büyük"

msgid "Display"
msgstr "Görüntü"

msgid "Select by fields"
msgstr "Alanlara göre seç"

msgid "Display fields as row content"
msgstr "Alanları satır içeriği olarak görüntüle"

msgid "Displaying fields as row content will output the field rows as unformatted values within each carousel item."
msgstr "Alanların satır içeriği olarak görüntülenmesi, alan satırlarının her bir karusel içinde biçimlendirilmemiş değerler olarak çıkarılmasını sağlar."

msgid "Image"
msgstr "Görsel"

msgid "Title"
msgstr "Başlık"

msgid "Description"
msgstr "Açıklama"

msgid "Bootstrap Carousel"
msgstr "Bootstrap Karuseli"

msgid "Displays rows in a Bootstrap Carousel."
msgstr "Bir Bootstrap Karusel içindeki satırları görüntüler."

msgid "The Bootstrap dropdown style displays a list of links in a drop-down menu format (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap aşağı açılır stili, açılır menü biçiminde bağlantıların bir listesini görüntüler (<a href=\":docs\">belgelere bakın</a>)."

msgid "Button text"
msgstr "Buton metni"

msgid "Text label for the button that is the drop-down toggle."
msgstr "Açılır liste için açma/kapama sağlayan düğmeye ilişkin metin etiketi."

msgid "Button class"
msgstr "Düğme sınıfı"

msgid "Classes for the button that is the drop-down toggle."
msgstr "Açılır liste için açma/kapama sağlayan düğmeye ilişkin sınıflar."

msgid "Default"
msgstr "Varsayılan"

msgid "Primary"
msgstr "Birincil"

msgid "Success"
msgstr "Başarılı"

msgid "Info"
msgstr "Bilgi"

msgid "Warning"
msgstr "Uyarı"

msgid "Danger"
msgstr "Tehlike"

msgid "Wrapper class"
msgstr "Sarıcı sınıfı"

msgid "The class to provide on the wrapper, outside the list."
msgstr "Liste dışında, sarıcıda sağlanacak sınıf."

msgid "List class"
msgstr "Liste sınıfı"

msgid "The class to provide on the list element itself."
msgstr "Liste öğesinde sağlanacak sınıf."

msgid "Bootstrap Dropdown"
msgstr "Bootsrap Açılır Listesi"

msgid "Displays rows in a Bootstrap Dropdown."
msgstr "Bir Bootstrap Açılır Liste içindeki satırları görüntüler."

msgid "The Bootstrap grid displays content in a responsive, mobile first fluid grid (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap ızgarası, içeriği duyarlı, mobile öncelik veren, değişken bir ızgarada görüntüler (<a href=\":docs\">belgelere bakın</a>)."

msgid "Alignment"
msgstr "Hizalama"

msgid "Horizontal"
msgstr "Yatay"

msgid "Vertical"
msgstr "Düşey"

msgid ""
"Horizontal alignment will place items starting in the upper left and moving right.\n"
"      Vertical alignment will place items starting in the upper left and moving down."
msgstr ""
"Yatay hizalamada öğeler sol üst taraftan başlayıp sağa doğru yerleştirilir.\n"
"      Dikey hizalama, öğeleri sol üstten başlayarak aşağı doğru yerleştirir."

msgid "Default column classes"
msgstr "Varsayılan sütun sınıfları"

msgid "Add the default views column classes like views-col, col-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "views-col, col-1 ve clearfix gibi varsayılan görünüm sütunu sınıflarını çıktıya ekler. Görünümün varsayılan olarak sağladığı biçimleme miktarını hızla azaltmak için, CSS'nin uygulanmasını zorlaştırma karşılığında bu öğeyi kullanabilirsiniz."

msgid "Custom column class"
msgstr "Özel sütun sınıfı"

msgid "Additional classes to provide on each column. Separated by a space."
msgstr "Her bir sütunda sağlanacak ek sınıflar. Boşlukla ayrılmış olarak belirtilir."

msgid "You may use field tokens from as per the \"Replacement patterns\" used in \"Rewrite the output of this field\" for all fields."
msgstr "Tüm alanlar için \"Bu alanın çıktısını yeniden yaz\" içinde kullanılan \"Değiştirme şablonları\" doğrultusunda alan belirteçlerini kullanabilirsiniz."

msgid "Default row classes"
msgstr "Varsayılan satır sınıfları"

msgid "Adds the default views row classes like views-row, row-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "views-row, row-1 ve clearfix gibi varsayılan görünüm satırı sınıflarını çıktıya ekler. Görünümün varsayılan olarak sağladığı biçimleme miktarını hızla azaltmak için, CSS'nin uygulanmasını zorlaştırma karşılığında bu öğeyi kullanabilirsiniz."

msgid "Custom row class"
msgstr "Özel satır sınıfı"

msgid "Additional classes to provide on each row. Separated by a space."
msgstr "Her bir satırda sağlanacak ek sınıflar. Boşlukla ayrılmış olarak belirtilir."

msgid "Base number of columns"
msgstr "Temel sütun sayısı"

msgid "all"
msgstr "tümü"

msgid "Choose the number of columns that views will wrap in a single row. This will be reflected in the HTML structure rendered regardless of the device size. If selecting \"all\" then use the alternative template."
msgstr "Görünümlerin tek bir satırda kaydırılacağı sütun sayısını seçin. Bu, aygıt boyutundan bağımsız olarak oluşturulan HTML yapısında yansıtılır. \"all\" (tümü) seçilirse, alternatif şablonu kullanın."

msgid "Number of columns (col-@size)"
msgstr "Sütun sayısı (col-@size)"

msgid "This adds col-@size to the div."
msgstr "Bu, bölüme col-@size öğesini ekler."

msgid "Bootstrap Grid"
msgstr "Bootstrap Izgarası"

msgid "Displays rows in a Bootstrap Grid layout"
msgstr "Bir Bootstrap Izgara yerleşimi içindeki satırları görüntüler"

msgid "The Bootstrap list group displays content in an unordered list with list group classes (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap liste grubu, liste grubu sınıflarına sahip sınırsız bir listede içerik görüntüler (<a href=\":docs\">belgelere bakın</a>)."

msgid "Set group field in panel heading"
msgstr "Pano başlığında grup alanını ayarla"

msgid "Title field"
msgstr "Başlık alanı"

msgid "Select the field that will be used as the title."
msgstr "Başlık olarak kullanılacak alanı seçin."

msgid "Bootstrap List Group"
msgstr "Bootstrap Liste Grubu"

msgid "Displays rows in a Bootstrap List Group."
msgstr "Bir Bootstrap Liste Grubunda satırları görüntüler."

msgid "The Bootstrap media object displays content with an image item lead with heading and text (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap ortam nesnesi, içeriği başlık ve metinle birlikte bir resim öğesi öncüsüyle görüntüler (<a href=\":docs\">belgelere bakın</a>)."

msgid "Heading field"
msgstr "Başlık alanı"

msgid "Select the field that will be used as the media object heading. Exclude this field from display to prevent duplication."
msgstr "Ortam nesnesi işlemesi olarak kullanılacak alanı seçin. Yinelemeyi önlemek için bu alanı görüntüden dışlayın."

msgid "Image field"
msgstr "Resim alanı"

msgid "Select the field that will be used as the media object image. Exclude this field from display to prevent duplication."
msgstr "Ortam nesnesi resmi olarak kullanılacak alanı seçin. Yinelemeyi önlemek için bu alanı görüntüden dışlayın."

msgid "Body field"
msgstr "Gövde alanı"

msgid "All fields that are not excluded from display will be shown as the body."
msgstr "Görüntülemeden dışlanmamış olan tüm alanlar gövde olarak gösterilir."

msgid "Image Alignment"
msgstr "Resim Hizalama"

msgid "Left"
msgstr "Sol"

msgid "Right"
msgstr "Sağ"

msgid "Middle"
msgstr "Orta"

msgid "Align the media object image left or right."
msgstr "Ortam nesnesi resmini sola ya da sağa hizalayın."

msgid "Bootstrap Media Object"
msgstr "Bootstrap Ortam Nesnesi"

msgid "Displays rows in a Bootstrap Media Object."
msgstr "Bir Bootstrap Ortam Nesnesinde satırları görüntüler."

msgid "The Bootstrap panels displays content in a box with optional header and footer elements (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap panoları, içeriği isteğe bağlı üstbilgi ve altbilgi öğeleriyle bir kutuda görüntüler (<a href=\":docs\">belgelere bakın</a>)."

msgid "Contextual class"
msgstr "Bağlamsal sınıf"

msgid "<a href=\":docs\">see Bootstrap documentation</a>"
msgstr "<a href=\":docs\">Bootstrap belgelerine bakın</a>"

msgid "Select the field that will be used as the panel heading titles."
msgstr "Pano üstbilgi başlıkları olarak kullanılacak alanı seçin."

msgid "Panel footer field"
msgstr "Pano altbilgi alanı"

msgid "Select the field that will be used as the panel footer."
msgstr "Pano altbilgisi olarak kullanılacak alanı seçin."

msgid "Bootstrap Panels"
msgstr "Bootstrap Panoları"

msgid "Displays rows in a Bootstrap Panel."
msgstr "Bir Bootstrap Panosundaki satırları görüntüler."

msgid "The Bootstrap tabs displays content with tab titles linked to dynamically displayed content (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap sekmeleri, içeriği dinamik olarak görüntülenen içeriğe bağlı sekme başlıkları ile görüntüler (<a href=\":docs\">belgelere bakın</a>)."

msgid "Tab field"
msgstr "Sekme alanı"

msgid "Select the field that will be used as the tab."
msgstr "Sekme olarak kullanılacak alanı seçin."

msgid "Tab Type"
msgstr "Sekme Tipi"

msgid "Tabs"
msgstr "Sekmeler"

msgid "Pills"
msgstr "Haplar"

msgid "List"
msgstr "Liste"

msgid "Position of tabs"
msgstr "Sekmelerin konumu"

msgid "Tabs/pills on the top"
msgstr "Üstteki sekmeler/sütunlar"

msgid "Tabs/pills on the left"
msgstr "Soldaki sekmeler/sütunlar"

msgid "Tabs/pills on the right"
msgstr "Sağdaki sekmeler/sütunlar"

msgid "Tabs/pills on the bottom"
msgstr "Alttaki sekmeler/sütunlar"

msgid "Tabs/pills justified on the top"
msgstr "Üste yaslanmış sekmeler/haplar"

msgid "Tabs/pills stacked"
msgstr "Yığılı sekmeler/sütunlar"

msgid "Fade Effect"
msgstr "Soluklaşma Etkisi"

msgid "Add a fade in effect when tabs clicked"
msgstr "Sekmeler tıklatıldığında bir soluklaşma etkisi ekle"

msgid "Bootstrap Tabs"
msgstr "Bootstrap Sekmeleri"

msgid "Displays rows in Bootstrap Tabs."
msgstr "Bootstrap Sekmelerinde satırları görüntüler."

msgid "The Bootstrap table style adds default Bootstrap table classes and optional classes (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap tablo stili, varsayılan bootstrap tablo sınıflarını ve isteğe bağlı sınıfları ekler (<a href=\":docs\">belgelere bakın</a>)."

msgid "Responsive"
msgstr "Duyarlı"

msgid "To make a table scroll horizontally on small devices."
msgstr "Bir tablonun küçük aygıtlarda yatay olarak kaydırılması için."

msgid "Bootstrap styles"
msgstr "Bootstrap stilleri"

msgid "Striped"
msgstr "Şeritli"

msgid "Bordered"
msgstr "Kenarlıklı"

msgid "Hover"
msgstr "Beliren"

msgid "Condensed"
msgstr "Dar"

msgid "Caption for the table"
msgstr "Tablonun başlığı"

msgid "A title semantically associated with your table for increased accessibility."
msgstr "Daha yüksek erişilebilirlik için tablonuzla semantik olarak ilişkilendirilmiş bir başlık."

msgid "Table details"
msgstr "Tablo ayrıntıları"

msgid "Summary title"
msgstr "Özet başlığı"

msgid "Table description"
msgstr "Tablo açıklaması"

msgid "Provide additional details about the table to increase accessibility."
msgstr "Erişilebilirliği artırmak için tabloyla ilgili ek ayrıntılar sağlar."

msgid "Bootstrap Table"
msgstr "Bootstrap Tablosu"

msgid "Displays rows in a Bootstrap table."
msgstr "Bir Bootstrap tablosu içindeki satırları görüntüler."

msgid "The Bootstrap thumbnails extends the grid display with the thumbnail component to showcase linked images (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap küçük resimleri, bağlantılı resimleri göstermek için küçük resim bileşeniyle ızgara görüntüsünü genişletir (<a href=\":docs\">belgelere bakın</a>)."

msgid "Bootstrap Thumbnails"
msgstr "Bootstrap Küçük Resimleri"

msgid "Displays rows in a Bootstrap Grid layout with thumbnails"
msgstr "Bir Bootstrap Izgara yerleşimi içindeki satırları küçük resimlerle görüntüler"

msgid "Previous"
msgstr "Önceki"

msgid "Next"
msgstr "Sonraki"

