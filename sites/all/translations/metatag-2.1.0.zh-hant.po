msgstr "以逗點區隔的 Facebook 使用者 ID 清單，這些人員被視為此頁面的管理者或控管者。"

msgid "Facebook Application ID"
msgstr "Facebook 應用程式 ID"

msgid "A comma-separated list of Facebook Platform Application IDs applicable for this site."
msgstr "適用於此網站並以逗點區隔的 Facebook 平台應用程式 ID 清單。"

msgid "Facebook Instant Articles claim URL token."
msgstr "Facebook 即時文章要求 URL 記號。"

msgid "Provides support for many different favicons."
msgstr "提供對許多不同 Favicon 的支援。"

