msgid "About"
msgstr "Over"

msgid "Provides additional Open Graph Protocol meta tags for describing products."
msgstr "Biedt aanvullende metatags van het protocol Open Graph voor beschrijving van producten."

msgid "Metatag: Open Graph Products"
msgstr "Metatag: Open Graph-producten"

msgid "SEO"
msgstr "SEO"

msgid "Open Graph Product: Price availability"
msgstr "Grafiekproduct openen: Beschikbaarheid van prijzen"

msgid "Open Graph Product: Product condition"
msgstr "Open grafiek Product: Productconditie"

msgid "Open Graph Product: Price amount"
msgstr "Open Graph-product: Prijs (bedrag)"

msgid "Open Graph Product: Price currency"
msgstr "Open Graph-product: Prijs (valuta)"

msgid "Open Graph Product: Retailer Item ID"
msgstr "Open grafiekproduct: ID wederverkoper-item"

msgid "Open Graph - Products"
msgstr "Open Graph - Producten"

msgid "These <a href='https://ogp.me/'>Open Graph meta tags</a> are for describing products.<br><br>The Facebook <a href='https://developers.facebook.com/tools/debug/'>Sharing Debugger</a> lets you preview how your content will look when it's shared to Facebook and debug any issues with your Open Graph tags."
msgstr "Deze <a href='https://ogp.me/'>Grafiekmetatag openen</a> zijn voor het beschrijven van producten.<br><br>De Facebook <a href='https://developers.facebook.com/tools/debug/'>Foutopsporingsprogramma delen</a> laat u een voorbeeld geven van de manier waarop uw content er zal uitzien wanneer het wordt gedeeld met Facebook en om eventuele problemen met uw Open Graph-tags op te sporen."

msgid "Product availability"
msgstr "Beschikbaarheid van producten"

msgid "The availability of the product."
msgstr "De beschikbaarheid van het product."

msgid "Product condition"
msgstr "Productvoorwaarde"

msgid "The condition of the product."
msgstr "De toestand van het product."

msgid "Product price amount"
msgstr "Productprijs (bedrag)"

msgid "The price amount of the product."
msgstr "Het prijsbedrag voor het product."

msgid "Product price currency"
msgstr "Productprijs (valuta)"

msgid "The price currency of the product."
msgstr "Het valuta voor de prijs van het product."

msgid "Retailer Item ID"
msgstr "Item-ID wederverkoper"

msgid "The ID of the product as provided by the retailer."
msgstr "Het ID van het product dat door de detailhandelaar wordt geleverd."

