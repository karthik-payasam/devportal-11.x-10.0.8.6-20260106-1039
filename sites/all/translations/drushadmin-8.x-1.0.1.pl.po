msgid "APIC Drush Administration commands"
msgstr "Komendy administracyjne Drush programu APIC"

msgid "Additional drush admin commands"
msgstr "Dodatkowe komendy administracyjne drush"

msgid "IBM API Developer Portal"
msgstr "IBM API Developer Portal"

msgid "@theme_name deleted."
msgstr "Usunięto @theme_name."

msgid "@module_name deleted."
msgstr "Usunięto @module_name."

msgid "All bans cleared."
msgstr "Wyczyszczono wszystkie zakazy."

msgid "Processing batch delete of users..."
msgstr "Realizacja wsadowego usuwania użytkowników..."

msgid "@theme_name not deleted. It is either still activated or is not a custom theme."
msgstr "Nie usunięto @theme_name. Jest nadal aktywowany lub nie jest kompozycją niestandardową."

msgid "@module_name not deleted. It is either still activated or is not a custom module."
msgstr "Nie usunięto @module_name. Jest nadal aktywowany lub nie jest modułem niestandardowym."

msgid "Unknown entity type"
msgstr "Nieznany typ jednostki"

msgid "All entities of type %type deleted."
msgstr "Usunięto wszystkie jednostki typu %type."

msgid "All nodes of type %type deleted."
msgstr "Usunięto wszystkie węzły typu %type."

msgid "All users from user registry %type have been deleted."
msgstr "Wszyscy użytkownicy z rejestru użytkowników %type zostali usunięci."

msgid "All users (except admin) have been deleted."
msgstr "Wszyscy użytkownicy (z wyjątkiem administratora) zostali usunięci."

