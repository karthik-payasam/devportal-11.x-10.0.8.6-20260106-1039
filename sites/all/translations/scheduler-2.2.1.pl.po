msgstr "Domyślny czas planowania. Używany z opcją zezwalającą tylko na datę."

msgid "Default value for entity type setting unpublish_enable"
msgstr "Wartość domyślna dla ustawienia typu jednostki unpublish_enable"

msgid "Default value for entity type setting unpublish_required"
msgstr "Wartość domyślna dla ustawienia typu jednostki unpublish_required"

msgid "Default value for entity type setting unpublish_revision"
msgstr "Wartość domyślna dla ustawienia typu jednostki unpublish_revision"

msgid "Hide the seconds on the input control when entering a time"
msgstr "Ukryj sekundy w elemencie sterującym wprowadzania podczas wprowadzania czasu"

msgid "Lightweight cron access key"
msgstr "Klucz dostępu uproszczonego zadania cron"

msgid "Log every Scheduler lightweight cron activation and completion message"
msgstr "Rejestruj każdy komunikat o aktywowaniu i zakończeniu uproszczonego zadania cron programu planującego"

