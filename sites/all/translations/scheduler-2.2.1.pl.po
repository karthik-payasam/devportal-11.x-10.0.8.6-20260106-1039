msgstr "Zestaw liter daty PHP dozwolony w formacie daty programu planującego"

msgid "Date part of the full format"
msgstr "Część pełnego formatu określająca datę"

msgid "Default value for entity type setting expand_fieldset"
msgstr "Wartość domyślna dla ustawienia typu jednostki expand_fieldset"

