msgstr "Ustawienia typu jednostki programu planującego"

msgid "Conditions under which to expand the date input fieldset or vertical tab (\"when_required\" or \"always\")"
msgstr "Warunki, zgodnie z którymi należy rozwinąć pole wprowadzania daty lub tabulacji pionowej (\"when_required\" lub \"always\")"

msgid "The way the scheduling fields are displayed in the edit form (\"vertical_tab\" or \"fieldset\")"
msgstr "Sposób wyświetlania pól planowania w formularzu edycji (\"vertical_tab\" lub \"fieldset\")"

msgid "Enable scheduled publishing"
msgstr "Włącz planowane publikowanie."

msgid "Action to be taken for publication dates in the past (\"error\", \"publish\" or \"schedule\")"
msgstr "Działania, które należy podjąć w przypadku dat publikacji wskazujących przeszłość (\"error\", \"publish\" lub \"schedule\")"

msgid "Change entity creation date for past dates to avoid \"changed\" being earlier than \"created\""
msgstr "Zmień datę utworzenia jednostki dla minionych dat, aby uniknąć wartości \"changed\" wcześniejszej od wartości \"created\""

msgid "Change entity creation time to match the scheduled publish time"
msgstr "Zmień czas utworzenia jednostki, aby był zgodny z zaplanowanym czasem publikacji"

msgid "Show a message after updating an entity which is scheduled"
msgstr "Pokaż komunikat po zaktualizowaniu jednostki, która jest zaplanowana"

msgid "Enable scheduled unpublishing"
msgstr "Włącz planowane wycofywanie z publikowania"

msgid "State Change configuration"
msgstr "Konfiguracja zmiany stanu"

msgid "Scheduled for publishing"
msgstr "Zaplanowano publikację"

msgid "Scheduled for unpublishing"
msgstr "Zaplanowano zakończenie publikacji"

msgid "Not scheduled"
msgstr "Nie zaplanowano publikacji"

msgid "Publishing enabled"
msgstr "Publikowanie włączone"

msgid "Unpublishing enabled"
msgstr "Kończenie publikacji włączone"

msgid "Node form scheduler"
msgstr "Program planujący formularza węzła"

msgid "Scheduler date options on the Node form."
msgstr "Opcje daty programu planującego w formularzu węzła."

msgid "Form"
msgstr "Formularz"

msgid "Scheduler options"
msgstr "Opcje programu planującego"

msgid "Send e-mail when content is published by Scheduler"
msgstr "Wysyłaj wiadomość e-mail, gdy treść jest publikowana przez program planujący"

msgid "'[node:title]' has been published on [site:name]"
msgstr "Węzeł '[node:title]' został opublikowany w serwisie [site:name]"

msgid ""
"Dear [node:author:name],\r\n"
"Your [node:type] '[node:title]' has been published on [site:name].\r\n"
"The link is [node:url]\r\n"
""
msgstr ""
"Witaj [node:author:name]!\r\n"
"W serwisie [site:name] został opublikowany węzeł '[node:title]' typu [node:type].\r\n"
"Odsyłacz: [node:url]\r\n"
" "

msgid "Send e-mail when content is unpublished by Scheduler"
msgstr "Wysyłaj wiadomość e-mail, gdy publikacja treści jest wycofywana przez program planujący"

msgid "'[node:title]' has been unpublished on [site:name]"
msgstr "Publikacja węzła '[node:title]' w serwisie [site:name] została wycofana."

msgid ""
"Dear [node:author:name],\r\n"
"Your [node:type] '[node:title]' has been unpublished on [site:name].\r\n"
"The link is [node:url]\r\n"
""
