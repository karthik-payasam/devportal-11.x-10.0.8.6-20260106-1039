msgid "Node"
msgstr "Węzeł"

msgid "The node for publishing via Scheduler."
msgstr "Węzeł do opublikowania za pośrednictwem programu planującego."

msgid "Publish-on Date"
msgstr "Data publikacji"

msgid "The publishing date to be used by Scheduler."
msgstr "Data publikacji, która ma być używana przez program planujący."

msgid "Set scheduled publishing date"
msgstr "Ustaw datę planowanej publikacji"

msgid "The node for unpublishing via Scheduler."
msgstr "Węzeł do wycofania publikacji za pośrednictwem programu planującego."

msgid "Unpublish-on Date"
msgstr "Data wycofania publikacji"

msgid "The unpublishing date to be used by Scheduler."
msgstr "Data wycofania publikacji, która ma być używana przez program planujący."

msgid "Set scheduled unpublishing date"
msgstr "Ustaw datę planowanego wycofania publikacji"

msgid "The scheduled node"
msgstr "Zaplanowany węzeł"

msgid "The node scheduled for publishing via Scheduler."
msgstr "Węzeł, który został zaplanowany do opublikowania za pośrednictwem programu planującego."

msgid "Remove scheduled publishing date"
