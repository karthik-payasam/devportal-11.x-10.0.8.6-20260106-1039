msgstr "Ustawienia"

msgid "Lightweight cron"
msgstr "Uproszczone zadanie cron"

msgid "Administer scheduler"
msgstr "Administruj programem planującym"

msgid "Configure scheduler - set default times, lightweight cron."
msgstr "Skonfiguruj program planujący – ustaw domyślne czasy, uproszczony podsystem cron."

msgid "Allow date-only input with time taken from default time setting"
msgstr "Zezwalaj na dane wejściowe tylko w formacie daty z godziną pobieraną z domyślnego ustawienia czasu"

msgid "Full date and time format"
msgstr "Pełny format daty i godziny"

