msgstr "Wartość domyślna dla ustawienia typu jednostki publish_past_date"

msgid "Default value for entity type setting publish_past_date_created"
msgstr "Wartość domyślna dla ustawienia typu jednostki publish_past_date_created"

msgid "Default value for entity type setting publish_required"
msgstr "Wartość domyślna dla ustawienia typu jednostki publish_required"

msgid "Default value for entity type setting publish_revision"
msgstr "Wartość domyślna dla ustawienia typu jednostki publish_revision"

msgid "Default value for entity type setting publish_touch"
msgstr "Wartość domyślna dla ustawienia typu jednostki publish_touch"

