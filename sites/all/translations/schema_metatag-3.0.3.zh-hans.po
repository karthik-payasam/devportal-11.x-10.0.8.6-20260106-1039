msgid "RECOMMENDED BY GOOGLE. Offers associated with the event."
msgstr "GOOGLE 推荐。 与该事件相关联的报价。"

msgid "RECOMMENDED BY GOOGLE. The organizer of the event."
msgstr "GOOGLE 推荐。 该事件的组织者。"

msgid "RECOMMENDED BY GOOGLE. The performer on the event."
msgstr "GOOGLE 推荐。 该事件的执行者。"

msgid "RECOMMENDED BY GOOGLE. The previousStartDate of the event."
msgstr "GOOGLE 推荐。 该事件的 previousStartDate。"

msgid "Reviews of this event."
msgstr "该事件的评论。"

msgid "REQUIRED BY GOOGLE. Date and time when the event starts."
msgstr "GOOGLE 必需。 该事件的开始日期和时间。"

msgid "REQUIRED. The type of event."
msgstr "必需。 该事件的类型。"

msgid "The URL of the event."
msgstr "该事件的 URL。"

