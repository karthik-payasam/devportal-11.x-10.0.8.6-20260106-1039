msgid "Social Media Links Field"
msgstr "Campo Link social media"

msgid "The module provides a field type to capture social media profiles."
msgstr "Il modulo fornisce un tipo di campo per l'acquisizione dei profili social media."

msgid "Platform"
msgstr "Piattaforma"

msgid "Appearance"
msgstr "Aspetto"

msgid "Orientation"
msgstr "Orientamento"

msgid "vertical"
msgstr "verticale"

msgid "horizontal"
msgstr "orizzontale"

msgid "Show name"
msgstr "Mostra nome"

msgid "Show the platform name next to the icon."
msgstr "Mostra il nome della piattaforma accanto all'icona."

msgid "Link attributes"
msgstr "Attributi del link"

msgid "Default target"
msgstr "Destinazione predefinita"

msgid "Remove target attribute"
msgstr "Rimuovi attributi di destinazione"

msgid "Open in a new browser window or tab (_blank)"
msgstr "Apri in una nuova scheda o finestra del browser (_blank)"

msgid "Open in the current window (_self)"
msgstr "Apri nella finestra corrente (_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "Apri nel frame superiore al frame che contiene il link (_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "Annulla tutti i frame ed apri in una finestra del browser completa (_top)"

msgid "Default rel"
msgstr "Rel predefinito"

msgid "Remove rel attribute"
msgstr "Rimuovi attributo rel"

msgid "Set nofollow"
msgstr "Imposta nofollow"

msgid "Orientation: @orientation"
msgstr "Orientamento: @orientation"

msgid "Yes"
msgstr "Sì"

msgid "No"
msgstr "No"

msgid "Show name: @show_name"
msgstr "Mostra nome: @show_name"

msgid "Default"
msgstr "Predefinito"

msgid "Value"
msgstr "Valore"

msgid "Platform Values"
msgstr "Valori piattaforma"

msgid "Icon Style"
msgstr "Stile icona"

msgid "Description"
msgstr "Descrizione"

msgid "Weight"
msgstr "Peso"

msgid "Platforms"
msgstr "Piattaforme"

msgid "The platforms that are allowed to be used in this field. Select none to allow all platforms."
msgstr "Le piattaforme che possono essere utilizzate in questo campo. Non effettuare alcuna selezione per consentire tutte le piattaforme."

msgid "The description is used for the title and WAI-ARIA attribute."
msgstr "La descrizione viene utilizzata per il titolo e l'attributo WAI-ARIA."

msgid "Find / Follow us on %platform"
msgstr "Trova / Seguici su %platform"

msgid "Weight for type @type"
msgstr "Peso per il tipo @type"

msgid "Handle links to social media profiles."
msgstr "Gestisce i link ai profili social media."

msgid "List with all available platforms"
msgstr "Elenco con tutte le piattaforme disponibili"

msgid "One available platform (selectable)"
msgstr "Una piattaforma disponibile (selezionabile)"

