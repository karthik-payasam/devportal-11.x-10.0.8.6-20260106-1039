msgid "Pretty paths coder"
msgstr "Pretty パス・コーダー"

msgid "Facets Pretty Paths"
msgstr "ファセット Pretty パス"

msgid "Pretty paths for Facets."
msgstr "ファセット用の Pretty パス。"

msgid "Search"
msgstr "検索"

msgid "Facet Pretty Paths third party settings on the Facet config"
msgstr "ファセット構成でのファセット・プリティー・パス・サード・パーティー設定"

msgid "The coder plugin ID"
msgstr "コーダー・プラグイン ID"

msgid "Home"
msgstr "ホーム"

msgid "Pretty paths"
msgstr "Pretty パス"

msgid "Pretty paths uses slashes as separator, e.g. /brand/drupal/color/blue"
msgstr "Pretty パスは区切り記号としてスラッシュを使用します (例: /brand/drupal/color/blue)"

msgid "Default"
msgstr "デフォルト"

msgid "Use the raw value, no special processing is done, e.g. /color/<strong>2</strong>"
msgstr "未加工値を使用し、特殊な処理は実行されません (例: /color/<strong>2</strong>)"

msgid "Node title + id"
msgstr "ノード・タイトル + ID"

msgid "Use node title with entity id, e.g. /color/<strong>blue-2</strong>"
msgstr "ノード・タイトルとエンティティー ID を使用します (例: /color/<strong>blue-2</strong>)"

msgid "Taxonomy term name + id"
msgstr "分類用語名 + ID"

msgid "Use term name with term id, e.g. /color/<strong>blue-2</strong>"
msgstr "用語名と用語 ID を使用します (例: /color/<strong>blue-2</strong>)"

