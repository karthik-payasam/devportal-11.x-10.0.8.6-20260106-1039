msgstr "Эта опция добавляет случайный шум, состоящий из разноцветных точек."

msgid "Add line noise"
msgstr "Добавить линейный шум"

msgid "This option enables lines randomly drawn on top of the text code."
msgstr "Эта опция разрешает линии, случайно нанесенные поверх текстового кода."

msgid "low"
msgstr "низко"

msgid "medium"
msgstr "средний"

msgid "high"
msgstr "сильный"

msgid "severe"
msgstr "сильно"

