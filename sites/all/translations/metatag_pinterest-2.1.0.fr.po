msgid "Metatag: Pinterest"
msgstr "Balise meta : Pinterest"

msgid "Provides support for Pinterest's custom meta tags."
msgstr "Fournit la prise en charge des balises meta personnalisées de Pinterest."

msgid "SEO"
msgstr "optimisation pour les moteurs de recherche"

msgid "Pinterest: Description"
msgstr "Pinterest : Description"

msgid "Pinterest: ID"
msgstr "Pinterest : ID"

msgid "Pinterest: Media"
msgstr "Pinterest : Média"

msgid "Pinterest: No hover"
msgstr "Pinterest : Aucune infobulle"

msgid "Pinterest: No pin"
msgstr "Pinterest : Aucune épingle"

msgid "Pinterest: No search"
msgstr "Pinterest : Aucune recherche"

msgid "Pinterest: URL"
msgstr "Pinterest : URL"

msgid "Pinterest"
msgstr "Pinterest"

msgid "A set of meta tags used to control how the site's content is consumed by <a href='https://pinterest.com/'>Pinterest</a>."
msgstr "Ensemble de balises meta utilisées pour contrôler l'utilisation du contenu du site par <a href='https://pinterest.com/'>Pinterest</a>."

msgid "Description"
msgstr "Description"

msgid "A one to two sentence description of the content."
msgstr "Une ou deux phrases de description du contenu."

msgid "Id"
msgstr "Id"

msgid "The Canonical Pinterest object to pin."
msgstr "Objet Pinterest canonique à épingler."

msgid "Media"
msgstr "Support"

msgid "The URL of media which should represent the content."
msgstr "URL de média représentant le contenu."

msgid "No hover"
msgstr "Aucune infobulle"

msgid "Do not show hovering Save or Search buttons, generated by the Pinterest browser extensions."
msgstr "Ne pas afficher les infobulles des boutons Sauvegarder ou Rechercher, générés par les extensions de navigateur Pinterest."

msgid "No pin"
msgstr "Aucune épingle"

msgid "Do not pin anything from this page. When selected, this option will take precedence over all options below."
msgstr "Ne rien épingler à partir de cette page. Lorsqu'elle est sélectionnée, cette option est prioritaire par rapport à toutes les options ci-dessous."

msgid "No search"
msgstr "Aucune recherche"

msgid "Do not allow Pinterest visual search to happen from this page."
msgstr "Ne pas autoriser de recherche visuelle Pinterest à partir de cette page."

msgid "URL"
msgstr "URL"

msgid "The URL which should represent the content."
msgstr "URL représentant le contenu."

