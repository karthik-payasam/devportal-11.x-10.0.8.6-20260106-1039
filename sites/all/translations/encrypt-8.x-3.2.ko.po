msgid "Changed key type from \"aes_encryption\" to \"encryption\" for existing keys."
msgstr "기존 키에 대해 \"aes_encryption\"에서 \"암호화\"로 키 유형을 변경했습니다."

msgid "No changes to existing keys were made because there were no keys defined with the \"aes_encryption\" key type."
msgstr "\"aes_encryption\" 키 유형으로 정의된 키가 없어 기존 키가 변경되지 않았습니다."

msgid "Added configuration dependencies on keys for existing profiles."
msgstr "기존 프로파일에 대해 키에서 구성 종속성을 추가했습니다."

msgid "No changes were made because there were no profiles without a configuration dependency on their key."
msgstr "키에 대한 구성 종속성이 없는 프로파일이 없기 때문에 변경되지 않았습니다."

msgid "Encrypt"
msgstr "암호화"

msgid "Provides an API for two-way encryption."
msgstr "방향 암호화를 위한 API를 제공합니다."

msgid "Encryption"
msgstr "암호화"

msgid "Add Encryption Profile"
msgstr "암호화 프로파일 추가"

msgid "Encryption profiles"
msgstr "암호화 프로파일"

msgid "Manage profiles that can be used to encrypt and decrypt data."
msgstr "암호화 및 복호화 데이터에 사용할 수 있는 프로파일을 관리합니다."

msgid "List"
msgstr "목록"

msgid "Settings"
msgstr "설정"

msgid "Administer encryption settings"
msgstr "암호화 설정 관리"

msgid "Change encryption settings (does not let them view encrypted data)."
msgstr "암호화 설정 변경(암호화된 데이터를 볼 수 없도록 함)."

msgid "Add encryption profile"
msgstr "암호화 프로파일 추가"

msgid "Edit encryption profile"
msgstr "암호화 프로파일 편집"

msgid "Delete encryption profile"
msgstr "암호화 프로파일 삭제"

msgid "Test encryption profile"
msgstr "암호화 프로파일 테스트"

msgid "Encrypt settings"
msgstr "암호화 설정"

msgid "Encrypt Profile"
msgstr "암호화 프로파일"

msgid "ID"
msgstr "아이디"

msgid "Label"
msgstr "레이블"

msgid "Encryption method selected for encryption profile"
msgstr "암호화 프로파일에 대해 선택된 암호화 방법"

msgid "Encryption method configuration"
msgstr "암호화 방법 구성"

msgid "Key ID for encryption profile"
msgstr "암호화 프로파일에 대한 키 ID"

msgid "Encryption method config"
msgstr "암호화 방법 구성"

msgid "Encrypt Settings"
msgstr "암호화 설정"

msgid "Check profile validation status."
msgstr "프로파일 유효성 검사 상태를 확인합니다."

msgid "Deprecated encryption plugins allowed."
msgstr "더 이상 사용되지 않는 암호화 플러그인이 허용되었습니다."

msgid "Encrypt commands"
msgstr "암호화 명령"

msgid "Interact with the encryption service."
msgstr "암호화 서비스와 상호작용."

msgid "Encryption profile \"@name\" could not be loaded."
msgstr "암호화 프로파일 \"@name\"을(를) 로드할 수 없습니다."

msgid "Please specify the encryption profile and the text to be encrypted"
msgstr "암호화 프로파일과 암호화할 텍스트를 지정하십시오."

msgid "Please specify the decryption profile and the encrypted text to be decrypted"
msgstr "복호화 프로파일과 복호화할 텍스트를 지정하십시오."

msgid "Please specify the encryption profile to be validated"
msgstr "유효성 검사할 암호화 프로파일을 지정하십시오."

msgid "Encryption profile validates successfully."
msgstr "암호화 프로파일 유효성 검사가 완료되었습니다."

msgid "Encryption profile @profile could not be loaded."
msgstr "암호화 프로파일 @profile을(를) 로드할 수 없습니다."

msgid "Encryption method"
msgstr "암호화 방법"

msgid "Key"
msgstr "키"

msgid "Status"
msgstr "상태"

msgid "Error loading encryption method"
msgstr "암호화 방법 로드 오류"

msgid "Error loading key"
msgstr "키 로드 오류"

msgid "The encryption plugin used in this encryption profile is deprecated."
msgstr "이 암호화 프로파일에 사용된 암호화 플러그인이 더 이상 사용되지 않습니다."

msgid "OK"
msgstr "OK"

msgid "Test"
msgstr "테스트"

msgid "No encryption profiles are available. <a href=\":link\">Add a profile</a>."
msgstr "사용 가능한 암호화 프로파일이 없습니다. <a href=\":link\">프로파일 추가</a>."

msgid "No encryption method selected."
msgstr "선택한 암호화 방법이 없습니다."

msgid "No encryption key selected."
msgstr "선택한 암호화 키가 없습니다."

msgid "The encryption method linked to this encryption profile does not exist."
msgstr "이 암호화 프로파일에 링크된 암호화 방법이 없습니다."

msgid "The key linked to this encryption profile does not exist."
msgstr "이 암호화 프로파일에 링크된 키가 없습니다."

msgid "The selected key cannot be used with the selected encryption method."
msgstr "선택한 키는 선택한 암호화 방법과 함께 사용할 수 없습니다."

msgid "Encryption Profile"
msgstr "암호화 프로파일"

msgid "Show the validation status of encryption profiles."
msgstr "암호화 프로파일의 유효성 검사 상태를 표시합니다."

msgid "On the encryption profiles overview page, automatically validate each encryption profile to check if there are problems with it. Disable when you have a lot of encryption profiles and are encountering performance issues, or if you do not want encryption keys to be loaded by the status check."
msgstr "암호화 프로파일 개요 페이지에서 각 암호화 프로파일을 자동으로 유효성 검증하여 문제가 있는지 확인합니다. 암호화 프로파일이 많고 성능 문제가 있거나 상태 확인으로 암호화 키를 로드하지 않으려는 경우 사용 안함으로 설정하십시오."

msgid "Allow the use of deprecated plugins."
msgstr "더 이상 사용되지 않는 플러그인의 사용을 허용합니다."

msgid "Enable this setting to allow the use of deprecated encryption plugins in new profiles. Leave disabled to only allow their use in existing profiles"
msgstr "이 설정을 통해 새 프로파일에 더 이상 사용되지 않는 암호화 플러그인을 사용할 수 있습니다. 기존 프로파일에만 사용하도록 허용하려면 사용 안함으로 남겨 두십시오."

msgid "Are you sure you want to delete %name?"
msgstr "%name을(를) 삭제하시겠습니까?"

msgid "Delete"
msgstr "삭제하기"

msgid "content @type: deleted @label."
msgstr "컨텐츠 @type: 삭제된 @label."

msgid "Be extremely careful when editing an encryption profile! It may result in making data encrypted with this profile unreadable. Are you sure you want to edit this profile?"
msgstr "암호화 프로파일을 편집할 때는 특히 주의하십시오! 이 프로파일로 암호화된 데이터를 읽을 수 없게 만들 수 있습니다. 이 프로파일을 편집하시겠습니까?"

msgid "Label for the encryption profile."
msgstr "암호화 프로파일의 레이블입니다."

msgid "Encryption Method"
msgstr "암호화 방법"

msgid "Select the method used for encryption"
msgstr "암호화에 사용된 방법 선택"

msgid "Encryption method settings"
msgstr "암호화 방법 설정"

msgid "Encryption Key"
msgstr "암호화 키"

msgid "Edit"
msgstr "편집하기"

msgid "Cancel"
msgstr "취소"

msgid "Saved the %label encryption profile."
msgstr "%label 암호화 프로파일을 저장했습니다."

msgid "The %label encryption profile was not saved."
msgstr "%label 암호화 프로파일이 저장되지 않았습니다."

msgid "Encryption test"
msgstr "암호화 테스트"

msgid "Text to encrypt"
msgstr "암호화할 텍스트"

msgid "Specify the text you want to encrypt with this encryption profile. The result of the encryption will be shown below."
msgstr "이 암호화 프로파일로 암호화할 텍스트를 지정하십시오. 암호화 결과는 다음과 같습니다."

msgid "Base64-encode the encrypted text."
msgstr "Base64 인코딩으로 암호화된 텍스트."

msgid "Encrypted text"
msgstr "암호화된 텍스트"

msgid "Decryption test"
msgstr "복호화 테스트"

msgid "Text to decrypt"
msgstr "복호화할 텍스트"

msgid "Specify the text you want to decrypt with this encryption profile. The result of the decryption will be shown below."
msgstr "이 암호화 프로파일로 복호화할 텍스트를 지정하십시오. 복호화 결과는 다음과 같습니다."

msgid "Base64-decode the encrypted text before decrypting."
msgstr "복호화하기 전에 암호화된 텍스트를 Base64 디코딩."

msgid "Decrypt"
msgstr "복호화"

msgid "Decrypted text"
msgstr "복호화된 텍스트"

