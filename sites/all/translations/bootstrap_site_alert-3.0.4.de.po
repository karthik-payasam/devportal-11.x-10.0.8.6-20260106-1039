msgid "Bootstrap Site Alert"
msgstr "Bootstrap-Site-Alert"

msgid "This module is for rendering alerts site wide using the power of Bootstrap"
msgstr "Dieses Modul dient zur Wiedergabe von Alerts auf der gesamten Site unter Nutzung von Bootstrap"

msgid "Other"
msgstr "Weitere"

msgid "Bootstrap Site Alert Configuration"
msgstr "Bootstrap-Site-Alert-Konfiguration"

msgid "Configure the Bootstrap Site Wide Alert Settings"
msgstr "Einstellungen für Bootstrap-Alerts für die gesamte Site konfigurieren"

msgid "Administer Bootstrap Site Alert"
msgstr "Bootstrap-Site-Alert verwalten"

msgid "View Bootstrap Site Alert"
msgstr "Bootstrap-Site-Alert anzeigen"

msgid "Settings"
msgstr "Einstellungen"

msgid ""
"<h3>Use this form to setup the bootstrap site alert(s).</h3>\n"
"                  <p>Make sure you select the checkbox if you want to turn the alerts on</p>"
msgstr ""
"<h3>Verwenden Sie dieses Formular, um Bootstrap-Site-Alerts zu konfigurieren. </h3>\n"
"                  <p>Achten sie darauf, das Kontrollkästchen auszuwählen, wenn Sie die Alerts einschalten möchten</p>"

msgid "Select Bootstrap Version"
msgstr "Bootstrap-Version auswählen"

msgid "3"
msgstr "3"

msgid "4"
msgstr "4"

msgid "- SELECT -"
msgstr "- AUSWÄHLEN -"

msgid "Save Bootstrap Version"
msgstr "Bootstrap-Version speichern"

msgid "Success"
msgstr "Erfolg"

msgid "Info"
msgstr "Info"

msgid "Warning"
msgstr "Warnung"

msgid "Danger"
msgstr "Gefahr"

msgid "Primary"
msgstr "Primär"

msgid "Secondary"
msgstr "Zweites"

msgid "Light"
msgstr "Hell"

msgid "Dark"
msgstr "Dunkel"

msgid "If Checked, Bootstrap Site Alert is Active."
msgstr "Wenn diese Option aktiviert ist, ist der Bootstrap-Site-Alert aktiv."

msgid "Severity"
msgstr "Schweregrad"

msgid "Make this alert dismissable?"
msgstr "Möchten Sie diese Warnmeldung wirklich  ausblendbar machen?"

msgid "Hide this alert on admin pages?"
msgstr "Diesen Alert auf Verwaltungsseiten ausblenden?"

msgid "Only Show On Certain Pages?"
msgstr "Nur auf bestimmten Seiten anzeigen?"

msgid "Path(s) to show on"
msgstr "Pfad(e) zum Anzeigen auf"

msgid "Specify pages by using their paths. Enter one path per line. The '*' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page."
msgstr "Bestimmte Seiten können angegeben werden indem deren Pfadangaben eintragen werden. Dabei wird eine Pfadangabe pro Zeile gemacht. Das Zeichen „*“ kann als Platzhalter verwendet werden. Ein Beispiel für eine Pfadangabe ist: %user-wildcard für jede Seite innerhalb der Nutzerkonten. %front ist die Startseite."

msgid "Alert Message"
msgstr "Alertnachricht"

msgid "Add Another Alert"
msgstr "Weiteren Alert hinzufügen"

msgid "Remove Last Alert"
msgstr "Letzten Alert entfernen"

msgid "Save Alert Message(s)"
msgstr "Alertnachricht(en) speichern"

