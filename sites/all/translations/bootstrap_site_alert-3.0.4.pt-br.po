msgid "Bootstrap Site Alert"
msgstr "Alerta do Sítio de Auto-inicialização"

msgid "This module is for rendering alerts site wide using the power of Bootstrap"
msgstr "Este módulo destina-se a renderizar o site de alertas totalmente usando a energia de autoinicialização"

msgid "Other"
msgstr "Outros"

msgid "Bootstrap Site Alert Configuration"
msgstr "Configuração de Alerta do Site de Auto-inicialização"

msgid "Configure the Bootstrap Site Wide Alert Settings"
msgstr "Definir as configurações de alerta do site para autoinicialização"

msgid "Administer Bootstrap Site Alert"
msgstr "Administrar Alerta do Site de Auto-inicialização"

msgid "View Bootstrap Site Alert"
msgstr "Visualizar Alerta do Site de Auto-inicialização"

msgid "Settings"
msgstr "Configurações"

msgid ""
"<h3>Use this form to setup the bootstrap site alert(s).</h3>\n"
"                  <p>Make sure you select the checkbox if you want to turn the alerts on</p>"
msgstr ""
"<h3>Use este formulário para configurar os alertas do site do Bootstrap.</h3>\n"
"                  <p>Certifique-se de selecionar a caixa de opção se desejar ativar os alertas</p>"

msgid "Select Bootstrap Version"
msgstr "Selecionar Versão do Bootstrap"

msgid "3"
msgstr "3"

msgid "4"
msgstr "4"

msgid "- SELECT -"
msgstr "-SELECT-"

msgid "Save Bootstrap Version"
msgstr "Salvar Versão do Bootstrap"

msgid "Success"
msgstr "Sucesso"

msgid "Info"
msgstr "Informações"

msgid "Warning"
msgstr "Aviso"

msgid "Danger"
msgstr "Perigo"

msgid "Primary"
msgstr "Primário"

msgid "Secondary"
msgstr "Secundário"

msgid "Light"
msgstr "Light"

msgid "Dark"
msgstr "Escuro"

msgid "If Checked, Bootstrap Site Alert is Active."
msgstr "Se marcado, o Alerta do site de autoinicialização está Ativo."

msgid "Severity"
msgstr "Severidade"

msgid "Make this alert dismissable?"
msgstr "Tornar este alerta descartável?"

msgid "Hide this alert on admin pages?"
msgstr "Ocultar este alerta nas páginas de administrador?"

msgid "Only Show On Certain Pages?"
msgstr "Mostrar Apenas em Determinadas Páginas?"

msgid "Path(s) to show on"
msgstr "Caminhos a serem mostrados"

msgid "Specify pages by using their paths. Enter one path per line. The '*' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page."
msgstr "Especifique páginas usando suas URLs. Digite uma URL por linha. O caractere '*' serve como curinga. Um caminho de exemplo é %user-wildcard para cada página do usuário. Use %front para a página inicial."

msgid "Alert Message"
msgstr "Mensagem de Alerta"

msgid "Add Another Alert"
msgstr "Incluir Outro Alerta"

msgid "Remove Last Alert"
msgstr "Remover Último Alerta"

msgid "Save Alert Message(s)"
msgstr "Salvar Mensagens de Alerta"

