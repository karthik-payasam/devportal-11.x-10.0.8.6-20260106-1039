msgid "Schema.org: HowTo"
msgstr "Schema.org: HowTo"

msgid "RECOMMENDED BY GOOGLE. A description of the how-to."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Popis postupu."

msgid "RECOMMENDED BY GOOGLE. The estimated cost of the supplies consumed when performing instructions."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Odhadované náklady na dodávky spotřebované při provádění instrukcí."

msgid "Globally unique id of the how to, usually a url."
msgstr "Globálně jedinečné ID pro jak, obvykle adresa URL."

msgid "RECOMMENDED BY GOOGLE. Image of the completed how-to."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Obrázek dokončeného postupu."

msgid "REQUIRED BY GOOGLE. The title of the how-to. For example, 'How to tie a tie'."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Titulek postupu. Například 'Jak uvázat kravatu'."

msgid "REQUIRED BY GOOGLE. An array of HowToStep elements which comprise the full instructions of the how-to."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Pole prvků HowToStep, které obsahuje úplné pokyny k tomu, jak to provést."

msgid "RECOMMENDED BY GOOGLE. A supply consumed when performing instructions or a direction."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Dodávka spotřebovaná při provádění instrukcí nebo pokynu."

msgid "RECOMMENDED BY GOOGLE. An object used (but not consumed) when performing instructions or a direction."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Objekt, který se použije (ale nespotřebuje) při provádění instrukcí nebo pokynu."

msgid "REQUIRED. The type of page."
msgstr "POŽADOVÁNO. Typ stránky."

msgid "The URL of the how-to."
msgstr "Adresa URL pro jak."

