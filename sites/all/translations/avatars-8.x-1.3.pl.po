msgstr "Typ: @type | Tło: @background"

msgid "Robots and monsters from Robohash.org"
msgstr "Roboty i potwory z serwisu Robohash.org"

msgid "Avatar generator settings"
msgstr "Ustawienia generatora awatarów"

msgid "How long should dynamic avatars be cached before allowing refresh."
msgstr "Czas buforowania dynamicznych awatarów przed odświeżeniem."

msgid "How long should non-preferred static avatars be cached. Leave empty to never delete. Preferred static avatars never expire."
msgstr "Czas buforowania niepreferowanych awatarów statycznych. Pozostawienie pustego pola wyłącza usuwanie awatarów. Preferowane awatary statyczne nigdy nie tracą ważności."

msgid "Avatar Generator"
msgstr "Generator awatarów"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "Etykieta"

msgid "Weight"
msgstr "Waga"

msgid "Plugin"
msgstr "Wtyczka"

msgid "Provider"
msgstr "Usługodawca"

