msgid "Site default"
msgstr "Domyślne ustawienia witryny"

msgid "User picture"
msgstr "Obraz użytkownika"

msgid "An image representing your user account. Do not upload your avatars to this field."
msgstr "Obraz reprezentujący konto użytkownika. Nie należy przesyłać awatarów do tego pola."

msgid "User picture upload"
msgstr "Przesyłanie obrazu użytkownika"

msgid "An image representing your user account."
msgstr "Obraz reprezentujący konto użytkownika."

msgid "Avatar Kit"
msgstr "Zestaw awatarów"

msgid "Provides a selection of generated avatars for users."
msgstr "Udostępnia użytkownikom zestaw wygenerowanych awatarów do wyboru."

msgid "Avatars"
msgstr "Awatary"

msgid "Add avatar generator"
msgstr "Dodaj generator awatarów"

msgid "Avatar settings"
msgstr "Ustawienia awatara"

msgid "Manage avatar generator settings."
msgstr "Zarządzaj ustawieniami generatora awatarów."

msgid "Administer Avatar Kit"
msgstr "Administruj zestawem awatarów"

msgid "Manage settings for Avatar Kit."
msgstr "Zarządzaj ustawieniami zestawu awatarów."

msgid "Avatar Kit settings"
msgstr "Ustawienia zestawu awatarów"

msgid "Edit avatar generator"
msgstr "Edytuj generator awatarów"

msgid "Delete avatar generator"
msgstr "Usuń generator awatarów"

msgid "Adorable"
msgstr "Adorable"

msgid "Adds an Adorable.io avatar generator for Avatar Kit."
msgstr "Dodaje generator awatarów Adorable.io do zestawu awatarów."

msgid "Adorable avatars by adorable.io"
msgstr "Urocze awatary z generatora adorable.io"

msgid "Gravatar"
msgstr "Gravatar"

msgid "Adds Gravatar.com avatar generators for Avatar Kit."
msgstr "Dodaje generatory awatarów z serwisu Gravatar.com do zestawu awatarów."

msgid "Maximum content rating"
msgstr "Maksymalna ocena treści"

msgid "Gravatar generator"
msgstr "Generator Gravatar"

msgid "Type"
msgstr "Typ"

msgid "Unrestricted"
msgstr "Nieograniczone"

msgid "G: suitable for display on all websites with any audience type."
msgstr "G: nadaje się do wyświetlania we wszystkich serwisach WWW, z których korzystają różni odbiorcy."

msgid "PG: may contain rude gestures, provocatively dressed individuals, the lesser swear words, or mild violence."
msgstr "PG: może zawierać nieprzyzwoite gesty, prowokacyjnie ubrane osoby, łagodne wulgaryzmy i przekleństwa lub umiarkowaną przemoc."

msgid "R: may contain such things as harsh profanity, intense violence, nudity, or hard drug use."
msgstr "R: może zawierać ostre wulgaryzmy i przekleństwa, nagość lub intensywną przemoc i przedstawiać zażywanie twardych narkotyków."

msgid "X: may contain hardcore sexual imagery or extremely disturbing violence."
msgstr "X: może zawierać pornografię lub brutalną przemoc."

msgid "Maximum rating: @maximum_rating"
msgstr "Maksymalna ocena: @maximum_rating"

msgid "Universal avatar uploaded to Gravatar.com"
msgstr "Uniwersalny awatar przesłany do serwisu Gravatar.com"

msgid "Identicon"
msgstr "Identicon"

msgid "Monster ID"
msgstr "Monster ID"

msgid "Wavatar"
msgstr "Wavatar"

msgid "8-bit style avatar"
msgstr "Awatar 8-bitowy"

msgid "Missing Configuration"
msgstr "Brakująca konfiguracja"

msgid "Type: @type"
msgstr "Typ: @type"

msgid "Identicon, MonsterID, Retro, and Wavatar avatar generators."
msgstr "Generatory awatarów Identicon, MonsterID, Retro i Wavatar"

msgid "Robohash"
msgstr "Robohash"

msgid "Adds Robohash avatar generators for Avatar Kit."
msgstr "Dodaje generatory awatarów Robohash do zestawu awatarów."

msgid "Background"
msgstr "Tło"

msgid "Robots"
msgstr "Roboty"

msgid "Robot Heads"
msgstr "Głowy robotów"

