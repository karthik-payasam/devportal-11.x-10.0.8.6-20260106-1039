msgstr "Ustawienia podglądu generatora awatarów"

msgid "Preview image style"
msgstr "Styl podglądu obrazka"

msgid "Failed to get @id avatar for @generator: %exception"
msgstr "Nie powiodło się pobranie awatara o identyfikatorze @id z generatora @generator: %exception "

msgid "Use %label"
msgstr "Użyj generatora %label"

msgid "User can select %label avatar generator."
msgstr "Użytkownik może wybrać generator awatarów %label."

msgid "Preview ID"
msgstr "Identyfikator podglądu"

msgid "The preview ID."
msgstr "Identyfikator podglądu."

msgid "Avatar generator"
msgstr "Generator awatarów"

msgid "The avatar generator for the associated avatar."
msgstr "Generator awatarów powiązany z awatarem."

msgid "The user who owns this avatar."
msgstr "Użytkownik, który jest właścicielem tego awatara."

msgid "Reference to a file entity containing an avatar."
msgstr "Odwołanie do jednostki pliku zawierającej awatara."

msgid "Date of creation"
msgstr "Data utworzenia"

msgid "The date the avatar preview was created."
msgstr "Data utworzenia podglądu awatara."

msgid "Preference scope"
msgstr "Zasięg preferencji"

msgid "Which preference caused this avatar to be generated."
msgstr "Preferencja, która spowodowała wygenerowanie tego awatara."

msgid "Avatar preview"
msgstr "Podgląd awatara"

msgid "Are you sure you want to delete avatar generator %label?"
msgstr "Czy na pewno chcesz usunąć generator awatarów %label?"

msgid "Delete"
msgstr "Usuń"

msgid "Avatar generator %label was deleted."
msgstr "Generator awatarów %label został usunięty."

msgid "Edit avatar generator %label"
msgstr "Edytuj generator awatarów %label"

msgid "Machine name"
msgstr "Identyfikator systemowy"

msgid "<strong>@label</strong><br />@description"
msgstr "<strong>@label</strong><br />@description"

msgid "Created avatar generator %label"
msgstr "Utworzono generator awatarów %label."

msgid "Updated avatar generator %label"
msgstr "Zaktualizowano generator awatarów %label."

msgid "Settings"
msgstr "Ustawienia"

msgid "Enabled"
msgstr "Włączone"

msgid "Operations"
msgstr "Operacje"

msgid "A list of avatar generators to try for each user in order of preference."
msgstr "Lista generatorów awatarów do wypróbowania przez poszczególnych użytkowników (w preferowanej kolejności)."

msgid "No avatar generators found."
msgstr "Nie znaleziono generatorów awatarów."

msgid "Dynamic"
msgstr "Dynamicznie"

msgid "Static"
msgstr "Statycznie"

msgid "Edit"
msgstr "Edytuj"

msgid "Dynamic lifetime"
msgstr "Dynamiczny czas życia"

msgid "How long dynamic avatars are cached before allowing refresh."
msgstr "Czas buforowania dynamicznych awatarów przed odświeżeniem."

msgid "seconds"
msgstr "sekundy"

msgid "Static lifetime"
msgstr "Statyczny czas życia"

msgid "How long static avatars are cached. Only applies to avatars which are not the users preference."
msgstr "Czas buforowania awatarów statycznych. Ma zastosowanie tylko do awatarów, które nie są preferowane przez użytkowników."

msgid "Never delete"
msgstr "Nigdy nie usuwaj"

msgid "Delete after"
msgstr "Usuń po"

msgid "Settings saved."
msgstr "Ustawienia zachowane."

msgid "Broken/Missing"
msgstr "Uszkodzony/brakujący"

msgid "User upload"
msgstr "Przesłane przez użytkownika"

msgid "Image uploaded by the user to the site."
msgstr "Obraz przesłany przez użytkownika do serwisu."

msgid "User preference"
msgstr "Preferencja użytkownika"

msgid "Avatar generator calculated based on user preference."
msgstr "Generator awatarów obliczony na podstawie preferencji użytkownika."

msgid "Original"
msgstr "Oryginał"

msgid "A preview of the avatar will be shown in this size."
msgstr "Zostanie wyświetlony podgląd awatara o tej wielkości."

msgid "Preview image style: @style"
msgstr "Styl podglądu obrazu: @style"

msgid "Let the site determine which avatar to use."
msgstr "Zezwól serwisowi na wybranie awatara, który ma być używany."

msgid "Avatar Generator Previews"
msgstr "Podglądy generatora awatarów"

