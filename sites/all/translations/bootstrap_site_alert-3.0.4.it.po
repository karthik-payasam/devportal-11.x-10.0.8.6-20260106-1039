msgid "Bootstrap Site Alert"
msgstr "Avvio del sito Bootstrap"

msgid "This module is for rendering alerts site wide using the power of Bootstrap"
msgstr "Questo modulo è per il rendering di avvisi in tutto il sito utilizzando la potenza di Bootstrap"

msgid "Other"
msgstr "Altro"

msgid "Bootstrap Site Alert Configuration"
msgstr "Configurazione degli avvisi per il sito Bootstrap"

msgid "Configure the Bootstrap Site Wide Alert Settings"
msgstr "Configurare le impostazioni di avviso per il sito Widestart Bootstrap"

msgid "Administer Bootstrap Site Alert"
msgstr "Amministrare gli avvisi per il sito Bootstrap "

msgid "View Bootstrap Site Alert"
msgstr "Visualizza avvisi per il sito Bootstrap "

msgid "Settings"
msgstr "Impostazioni"

msgid ""
"<h3>Use this form to setup the bootstrap site alert(s).</h3>\n"
"                  <p>Make sure you select the checkbox if you want to turn the alerts on</p>"
msgstr ""
"<h3>Utilizzare questo modulo per impostare l'avviso del sito di bootstrap.</h3>\n"
"                  <p>Assicurarsi di selezionare la casella di controllo se si vogliono attivare gli avvisi</p>"

msgid "Select Bootstrap Version"
msgstr "Seleziona versione bootstrap"

msgid "3"
msgstr "3"

msgid "4"
msgstr "4"

msgid "- SELECT -"
msgstr "- SELECT -"

msgid "Save Bootstrap Version"
msgstr "Salva versione bootstrap"

msgid "Success"
msgstr "Riuscito"

msgid "Info"
msgstr "Informazioni"

msgid "Warning"
msgstr "Avviso"

msgid "Danger"
msgstr "Pericolo"

msgid "Primary"
msgstr "Primario"

msgid "Secondary"
msgstr "Secondario"

msgid "Light"
msgstr "Chiaro"

msgid "Dark"
msgstr "Scuro"

msgid "If Checked, Bootstrap Site Alert is Active."
msgstr "Se selezionato, Bootstrap Site Alert è attivo."

msgid "Severity"
msgstr "Rilevanza"

msgid "Make this alert dismissable?"
msgstr "Rendere questo avviso eliminabile?"

msgid "Hide this alert on admin pages?"
msgstr "Nascondere questo avviso sulle pagine admin?"

msgid "Only Show On Certain Pages?"
msgstr "Mostrare solo in determinate pagine?"

msgid "Path(s) to show on"
msgstr "Percorso in cui mostrare"

msgid "Specify pages by using their paths. Enter one path per line. The '*' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page."
msgstr "Specificare le pagine usando i loro percorsi. Immettere un percorso per riga. Il carattere '*' è un carattere jolly. Un percorso di esempio è %user-wildcard per ogni pagina utente. %front è la prima pagina."

msgid "Alert Message"
msgstr "Messaggio di avviso"

msgid "Add Another Alert"
msgstr "Aggiungi altro avviso"

msgid "Remove Last Alert"
msgstr "Rimuovi ultimo avviso"

msgid "Save Alert Message(s)"
msgstr "Salva messaggi di avviso"

