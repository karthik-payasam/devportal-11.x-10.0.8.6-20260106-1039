msgctxt "Validation"
msgid "Address Format"
msgstr "Format adresu"

msgid "@name field must be blank."
msgstr "Pole @name musi być puste."

msgid "@name field is required."
msgstr "Pole @name jest wymagane."

msgid "@name field is not in the right format."
msgstr "Format pola @name nie jest poprawny."

msgid "The country %value is not valid."
msgstr "Kraj %value nie jest poprawny."

