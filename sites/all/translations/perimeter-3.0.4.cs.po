msgid "Allowlist skipping ban: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Zákaz přeskočení seznamu povolených: %ip pro selhávající typ %type na formuláři %form <br />Zdroj: %ssource <br /> Agent uživatele: %browser"

msgid "Banned: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Zakázáno: %ip pro selhání %type při %form <br />Zdroj: %source <br /> Agent uživatele: %browser"

msgid "Drupal Perimeter Defence"
msgstr "Drupal Perimeter Defence"

msgid "Immediately ban hackers when they try to scan the site."
msgstr "Okamžitě zakázat hackery, když se snaží skenovat server."

msgid "Perimeter defence settings"
msgstr "Nastavení obrany perimetru"

msgid "Configure the settings for Drupal Perimeter Defence."
msgstr "Nakonfigurujte nastavení pro obranu perimetru Drupal."

msgid "Bypass Perimeter Defence ban rules"
msgstr "Vynechat pravidla zákazu modulu Perimeter Defence"

msgid "Allow users to bypass the rules defined by Perimeter Defence module."
msgstr "Umožněte uživatelům vynechat pravidla definovaná modulem Perimeter Defence."

msgid "Perimeter settings"
msgstr "Nastavení perimetru"

msgid "Perimeter Settings"
msgstr "Nastavení perimetru"

msgid "A list of regex patterns"
msgstr "Seznam vzorů regulárního výrazu"

msgid "A regex pattern"
msgstr "Vzor regulárního výrazu"

msgid "Banned: %ip for requesting %pattern <br />Source: %source <br /> User Agent: %browser"
msgstr "Zakázáno: %ip for requesting %pattern <br />Zdroj: %ssource <br /> Agent uživatele: %browser"

msgid "Perimeter will ban any user that generates \"404 - File not found\" for requesting any of the following url pattern"
msgstr "Perimetr zakáže všechny uživatele, kteří generují chybu \"404 - Soubor nebyl nalezen\" pro vyžádání některého z následujících vzorů adres URL"

msgid "Ban URL patterns"
msgstr "Zakázat vzory adres URL"

msgid "A list of regex patterns, each pattern on a separate line"
msgstr "Seznam vzorů regulárního výrazu, každý vzor na samostatném řádku"

