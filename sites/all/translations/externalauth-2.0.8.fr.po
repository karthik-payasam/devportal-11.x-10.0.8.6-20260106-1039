msgid "External Authentication Map"
msgstr "Mappe d'authentification externe"

msgid "Provider"
msgstr "Fournisseur"

msgid "The name of the authentication provider providing the authname."
msgstr "Nom du fournisseur d'authentification fournissant le nom d'authentification."

msgid "Authname"
msgstr "Nom d'authentification"

msgid "Unique authentication name provided by authentication provider."
msgstr "Nom d'authentification unique fourni par le fournisseur d'authentification. "

msgid "Drupal User ID"
msgstr "Identifiant (ID) utilisateur Drupal"

msgid "The user linked to the authname."
msgstr "Utilisateur lié au nom d'utilisateur."

msgid "Linked Drupal user"
msgstr "Utilisateur Drupal lié"

msgid "Link to delete @label entry"
msgstr "Lien permettant de supprimer l'entrée @label"

msgid "Provide a link to delete the @label entry."
msgstr "Fournissez un lien pour supprimer l'entrée @label ."

msgid "About"
msgstr "À propos"

msgid "Authenticates users using an external site / service and stores identification details."
msgstr "Authentifie les utilisateurs à l'aide d'un site/service externe et stocke les détails d'identification. "

msgid "External Authentication"
msgstr "Authentification externe"

msgid "Helper module to authenticate users using an external site / service and storing identification details"
msgstr "Module auxiliaire permettant d'authentifier les utilisateurs à l'aide d'un site/service externe et de stocker les détails d'identification "

msgid "User authentication"
msgstr "Authentification de l'utilisateur"

msgid "View external authentication data"
msgstr "Afficher les données d'authentification externes"

msgid "Delete external authentication data"
msgstr "Supprimer les données d'authentification externes"

msgid "Delete authmap entry"
msgstr "Supprimer une entrée authmap"

msgid "Authmap change (%old => %new) for user %name with uid %uid from provider %provider"
msgstr "Changement de mappe d'authentification (%old => %new) pour l'utilisateur %name avec l'ID utilisateur %u du fournisseur %provider"

msgid "External registration of user %name from provider %provider and authname %authname"
msgstr "Enregistrement externe de l'utilisateur %name depuis le fournisseur %provider, avec le nom d'authentification %authname"

msgid "External login of user %name"
msgstr "Connexion externe de l'utilisateur %name"

msgid "Are you sure you want to delete the link between authentication name %id and Drupal user %user?"
msgstr "Voulez-vous vraiment supprimer le lien entre le nom d'authentification %id et Drupal user %user?"

msgid "No authmap record found for provider @provider / uid @uid."
msgstr "Aucun enregistrement authmap n'a été trouvé pour le fournisseur @provider / uid @uid."

msgid "The link has been deleted."
msgstr "Le lien a été supprimé."

msgid "User’s users.uid."
msgstr "Valeur users.uid de l'utilisateur. "

msgid "Unique authentication name."
msgstr "Nom d'authentification unique. "

msgid "Module which is controlling the authentication."
msgstr "Module contrôlant l'authentification. "

msgid "delete"
msgstr "supprimer"

msgid "Output the URL as text"
msgstr "Rendre l'URL en tant que texte"

msgid "Use absolute link (begins with \"http://\")"
msgstr "Utiliser un lien absolu (commençant par \"http://\")"

msgid "Enable this option to output an absolute link. Required if you want to use the path as a link destination."
msgstr "Activer cette option pour afficher un lien absolu. Requis si vous souhaitez utiliser le chemin en tant que lien de destination."

