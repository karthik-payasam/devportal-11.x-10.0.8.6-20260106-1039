msgid "Chaos Tools Views"
msgstr "Pohledy nástrojů Chaos"

msgid "A set of improvements to the core Views code that allows for greater control over Blocks."
msgstr "Sada vylepšení kódu jádra pohledů, která umožňuje větší kontrolu nad bloky."

msgid "Chaos tool suite (Experimental)"
msgstr "Sada nástrojů pro chaos (experimentální)"

msgid "Items per page"
msgstr "Počet položek na stránku"

msgid "Pager offset"
msgstr "Posunutí pageru"

msgid "Pager type"
msgstr "Typ pageru"

msgid "Hide fields"
msgstr "Skrýt pole"

msgid "Reorder fields"
msgstr "Změnit pořadí polí"

msgid "Configure filters"
msgstr "Konfigurovat filtry"

msgid "Disable filters"
msgstr "Zakázat filtry"

msgid "Configure sorts"
msgstr "Nakonfigurovat řazení"

msgid "Allow settings"
msgstr "Povolit nastavení"

msgid "None"
msgstr "Není"

msgid "For example, set this to 3 and the first 3 items will not be displayed."
msgstr "Nastavte například tuto hodnotu na 3 a první 3 položky nebudou zobrazeny."

msgid "Inherit from view"
msgstr "Zdědit z pohledu"

msgid "Display a specified number of items"
msgstr "Zobrazit určený počet položek"

msgid "Display all items"
msgstr "Zobrazit všechny položky"

msgid "Pager"
msgstr "Pager"

msgid "Hide"
msgstr "Skrýt"

msgid "Label"
msgstr "Popisek"

msgid "Weight"
msgstr "Váha"

msgid "Weight for @title"
msgstr "Váha pro @title"

msgid "Exposed filter values"
msgstr "Hodnoty vystaveného filtru"

msgid "If a value is set for an exposed filter, it will be removed from the block display."
msgstr "Je-li hodnota nastavena pro vystavený filtr, bude odebrána z obrazovky bloku."

msgid "Expose filter value to user"
msgstr "Vystavit hodnotu filtru uživateli"

msgid "Expose this filter value to visitors? If so, the value set here will be the default."
msgstr "Chcete vystavit tuto hodnotu filtru návštěvníkům? Je-li tomu tak, bude zde nastavená hodnota výchozí hodnota."

msgid "Expose filter operator to user"
msgstr "Vystavit operátor filtru uživateli"

msgid "Expose this filter's operator to visitors? If so, the operator set here will be the default."
msgstr "Vystavit tento operátor filtru návštěvníkům? Je-li tomu tak, bude zde nastavený operátor výchozí hodnota."

msgid "Disable filter: @handler"
msgstr "Zakázat filtr: @handler"

msgid "Sort ascending"
msgstr "Řadit vzestupně"

msgid "Sort descending"
msgstr "Řadit sestupně"

msgid "Order"
msgstr "Pořadí"

