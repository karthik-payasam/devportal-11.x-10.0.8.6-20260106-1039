msgid "Lists registered library information."
msgstr "Elenca le informazioni della libreria registrata."

msgid ""
"Downloads a registered library into the libraries directory for the active site.\n"
"\n"
"See libraries-list for a list of registered libraries."
msgstr ""
"Scarica una libreria registrata nella directory librerie del sito attivo.\n"
"\n"
"Vedere libraries-list per un elenco di librerie registrate."

msgid "Name"
msgstr "Nome"

msgid "Status"
msgstr "Stato"

msgid "Version"
msgstr "Versione"

msgid "Variants"
msgstr "Varianti"

msgid "Dependencies"
msgstr "Dipendenze"

msgid "OK"
msgstr "OK"

msgid "Missing dependency: unzip. Install it before using this command."
msgstr "Dipendenza mancante: unzip. Installarla prima di utilizzare questo comando."

msgid "Directory @path was created"
msgstr "La directory @path è stata creata"

msgid "A existing Colorbox plugin was overwritten at @path"
msgstr "Un plug-in Colorbox esistente è stato sostituito in @path"

msgid "Colorbox plugin has been downloaded to @path"
msgstr "Il plug-in Colorbox è stato scaricato in @path"

msgid "Drush was unable to download the Colorbox plugin to @path"
msgstr "Drush non è riuscito a scaricare il plug-in Colorbox in @path"

msgid "The %dependency library, which the %library library depends on, is not installed."
msgstr "La libreria %dependency, da cui dipende la libreria %library, non è installata."

msgid "The version %dependency_version of the %dependency library is not compatible with the %library library."
msgstr "La versione %dependency_version della libreria %dependency non è compatibile con la libreria %library."

msgid "The %library library could not be found."
msgstr "Impossibile trovare la libreria %library."

msgid "The version of the %library library could not be detected."
msgstr "Impossibile rilevare la versione della libreria %library."

msgid "The installed version %version of the %library library is not supported."
msgstr "La versione installata %version della libreria %library non è supportata."

msgid "The %variant variant of the %library library could not be found."
msgstr "Impossibile rilevare la variante %variant della libreria %library."

msgid "The following external libraries could not successfully be registered with Drupal core: @libs. See earlier log entries for more details. Once these issues are addressed please be sure to clear your Drupal library cache to ensure external library detection is run again."
msgstr "Impossibile registrare correttamente le seguenti librerie esterne con il core di Drupal: @libs. Consultare le voci precedenti del log per ulteriori dettagli. Una volta risolti questi problemi cancellare la cache libreria Drupal per assicurarsi che il rilevamento della libreria esterna venga eseguito di nuovo."

msgid "Libraries"
msgstr "Librerie"

msgid "Allows version-dependent and shared usage of external libraries."
msgstr "Consente l'utilizzo basato sulla versione e quello condiviso delle librerie esterne."

msgid "Libraries API settings"
msgstr "Impostazioni API delle librerie"

msgid "Library definition settings"
msgstr "Impostazioni definizione libreria"

msgid "Local"
msgstr "Locale"

msgid "Local path"
msgstr "Percorso locale"

msgid "Enable remote fetching of library definitions"
msgstr "Abilita il richiamo remoto delle definizioni libreria"

msgid "A list of remote library registry URLs"
msgstr "Un elenco di URL del registro di librerie remote"

msgid "The URL of a remote library registry"
msgstr "L'URL di un registro della libreria remota"

msgid "URI locator configuration"
msgstr "Configurazione locator URI"

msgid "The locator URI"
msgstr "URI del locator"

msgid "Assets"
msgstr "Risorse"

msgid "Provides access to asset library files."
msgstr "Fornisce accesso ai file della libreria degli asset."

msgid "Library definitions"
msgstr "Definizioni delle librerie"

msgid "Provides access to library definition files."
msgstr "Fornisce accesso ai file delle definizioni della libreria."

msgid "PHP library files"
msgstr "File libreria PHP"

msgid "Provides access to PHP library files."
msgstr "Fornisce l'accesso ai file della libreria PHP."

