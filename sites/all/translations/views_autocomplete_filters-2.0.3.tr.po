msgid "Views Autocomplete Filters"
msgstr "Otomatik Tamamlama Süzgeçleri Görüntüler"

msgid "Use Autocomplete for string field filters."
msgstr "Dizi alanı süzgeçleri için Otomatik Tamamlamayı kullanın."

msgid "Views"
msgstr "Görünümler"

msgid "Autocomplete for Combine fields filter"
msgstr "Birleştir alanları süzgeci için otomatik tamamla"

msgid "Exposed"
msgstr "Gösterilen"

msgid "Use Autocomplete"
msgstr "Otomatik Tamamlamayı Kullan"

msgid "Minimum number of characters to start filter"
msgstr "Süzgeci başlatmak için minimum karakter sayısı"

msgid "Maximum number of items in Autocomplete"
msgstr "Otomatik Tamamlamada maksimum öğe sayısı"

msgid "Field with autocomplete results"
msgstr "Otomatik tamamlama sonuçlarıyla alanlar"

msgid "Unformatted suggestion"
msgstr "Biçimlendirilmemiş öneri"

msgid "Unformatted dropdown"
msgstr "Biçimlendirilmemiş aşağı açılır menü"

msgid "Suggestions depend on other filter fields"
msgstr "Öneriler diğer süzgeç alanlarına bağlıdır"

msgid "Autocomplete for Search API fulltext search filter"
msgstr "Arama API'si tam metin arama süzgeci için otomatik tamamla"

msgid "Autocomplete for Search API text field filter"
msgstr "Arama API'si metin alanı süzgeci için otomatik tamamla"

msgid "Autocomplete for basic textfield filter"
msgstr "Temel metin alanı süzgeci için otomatik tamamla"

msgid "Field for autocomplete filter %label is not set in view %view, display %display"
msgstr "Otomatik tamamlama süzgeci alanı %label, %view görünümü ve %display görüntüsünde ayarlanmamış"

msgid "Field for autocomplete filter %label not exists in view %view, display %display"
msgstr "Otomatik tamamlama süzgeci alanı %label, %view görünümü ve %display görüntüsünde yok"

msgid "Use Autocomplete for this filter."
msgstr "Bu süzgeç için Otomatik Tamamlamayı kullanın."

msgid "Enter 0 for no limit."
msgstr "Sınır koymamak için 0 değerini girin."

msgid "Autocomplete suggestions will be filtered by other filter fields"
msgstr "Otomatik tamamlama önerileri, diğer süzgeç alanlarına göre süzülecek."

msgid "The selected field will be used for drop-down results of the autocompletion. In most cases it should be the same field you use for the filter, and <em>must</em> be included in the field list for the view/display in order to appear here."
msgstr "Seçilen alan, otomatik tamamlama işleminin açılan sonuçları için kullanılır. Bu, çoğu durumda, süzgeç için kullandığınız aynı alan olmalıdır ve burada görünmesi için gör/görüntüle alan listesine <em>konmalıdır</em>."

msgid "Use unformatted data from database for dropdown list instead of field formatter result. Value will be printed as plain text."
msgstr "Alan biçimlendirici sonucu yerine aşağı açılır liste için veritabanından biçimlendirilmemiş verileri kullanın. Değer, düz metin olarak yazdırılır."

msgid "The same as above, but for suggestion (text appearing inside textfield when item is selected)."
msgstr "Yukarıdakiyle yanı, ancak öneri için (öğe seçildiğinde metin alanı içinde görünen metin)."

msgid "Add some fields to view"
msgstr "Görünüme bazı alanlar ekle"

