msgid "No Content Security Policy headers are currently enabled."
msgstr "Nyní nejsou povolena žádná záhlaví zabezpečení obsahu."

msgid "Enable a header via <a href=\":csp-settings\">the Content Security Policy settings</a>."
msgstr "Povolte záhlaví prostřednictvím <a href=\":csp-settings\">nastavení zásad zabezpečení obsahu</a>."

msgid "Enabling Content Security Policy in Security Kit is likely to cause policy conflicts."
msgstr "Povolení zásady zabezpečení obsahu v sadě zabezpečení pravděpodobně způsobí konflikty zásad."

msgid "Disable the Content Security Policy settings in <a href=\":seckit-settings\">Security Kit configuration</a>."
msgstr "Zakažte nastavení zásad zabezpečení v <a href=\":seckit-settings\">konfiguraci sady zabezpečení</a>."

msgid "Content Security Policy"
msgstr "Zásady zabezpečení obsahu"

msgid "Provide Content-Security-Policy headers"
msgstr "Zadejte záhlaví zásad zabezpečení obsahu"

msgid "Configure policy enforcement."
msgstr "Konfigurovat vynucení zásad."

msgid "Administer Content Security Policy"
msgstr "Spravovat zásady zabezpečení obsahu"

msgid "Content Security Policy Settings"
msgstr "Nastavení zásad zabezpečení obsahu"

msgid "Report-Only Policy"
msgstr "Zásada pouze k dokumentaci"

msgid "Enforce Policy"
msgstr "Vynutit zásadu"

msgid "Policy"
msgstr "Zásada"

msgid "Enable"
msgstr "Zapnout"

msgid "Directives"
msgstr "Direktivy"

msgid "Reporting"
msgstr "Vytváření sestav"

msgid "The Reporting Handler Plugin ID"
msgstr "ID modulu plug-in obslužné rutiny vytváření sestav"

msgid "Reporting Plugin Options"
msgstr "Volby modulu plug-in vytváření sestav"

msgid "Base"
msgstr "Základ"

msgid "Flags"
msgstr "Příznaky"

msgid "Sources"
msgstr "Zdroje"

msgid "None"
msgstr "Žádné"

msgid "Site Log"
msgstr "Protokol webu"

msgid "Report URI"
msgstr "URI hlášení"

msgid "Subdomain"
msgstr "Subdoména"

msgid "Wizard"
msgstr "Průvodce"

msgid "URI"
msgstr "URI"

msgid "CSP Extras"
msgstr "Doplňky CSP"

msgid "Module is not required in Drupal ^10.1"
msgstr "Modul není požadován v Drupal ^10.1"

msgid "Content Security Policy Extras"
msgstr "Doplňky zásady zabezpečení obsahu"

msgid "Optional extra features for Content Security Policy"
msgstr "Volitelné další funkce pro zásadu zabezpečení obsahu"

msgid ""
"@type <br/>\n"
"<pre>@data</pre>"
msgstr ""
"@type <br/>\n"
"<pre>@data</pre>"

msgid "Policies"
msgstr "Zásady"

msgid "Report Only"
msgstr "Pouze hlásit"

msgid "Enforced"
msgstr "Vynuceno"

msgid "Enable '@type'"
msgstr "Povolit '@type'"

msgid "Additional Sources"
msgstr "Další zdroje"

msgid "Additional domains or protocols to allow for this directive, separated by a space."
msgstr "Další domény či protokoly, které mají být povoleny pro tuto direktivu, oddělené mezerou."

msgid "Instead of child-src, nested browsing contexts and workers should use the frame-src and worker-src directives, respectively."
msgstr "Vnořené kontexty procházení a objekty worker by místo direktivy child-src měly použít frame-src a worker-src."

msgid "Handler"
msgstr "Ovladač"

msgid "Reset @policyType policy to default values"
msgstr "Resetovat zásadu @policyType na výchozí hodnoty"

msgid "No policies are currently enabled."
msgstr "Nyní nejsou povoleny žádné zásady."

msgid "%policy %directive has a hash source configured, which may block functionality that relies on inline code."
msgstr "%policy %directive má nakonfigurovaný zdroj hašování, který může blokovat funkčnost, která se spoléhá na vložený kód."

msgid "%policy %directive is enabled without a fallback directive for non-supporting browsers."
msgstr "%policy %directive je povolena bez náhradní direktivy pro nepodporující prohlížeče."

msgid "<a href=\":docUrl\">Nonces must be a unique value for each request</a>, so cannot be set in configuration."
msgstr "<a href=\":docUrl\">Hodnoty Nonce musí být pro každý požadavek jedinečné</a>, nelze je proto nastavovat v konfiguraci."

msgid "Invalid domain or protocol provided."
msgstr "Byla zadána neplatná doména nebo protokol."

msgid "Reporting Handler is required for enabled policies."
msgstr "Pro povolené zásady je vyžadována obslužná rutina vytváření sestav."

msgid "Reporting is disabled"
msgstr "Vytváření sestav je vypnuté"

msgid "Your <a href=\":url\">Report-URI.com subdomain</a>."
msgstr "Vaše <a href=\":url\">subdoména Report-URI.com</a>."

msgid "Enable Wizard"
msgstr "Povolit průvodce"

msgid "Send reports to the <a href=\":url\">CSP Wizard</a> reporting address."
msgstr "Odešlete sestavy na adresu vytváření sestav <a href=\":url\">Průvodce CSP</a>."

msgid "Reports will be sent to a ReportURI.com account."
msgstr "Sestavy budou odeslány na účet ReportURI.com."

msgid "Reports will be added to the site log."
msgstr "Sestavy budou přidávány do protokolu webu."

msgid "The URI to send reports to."
msgstr "Identifikátor URI, který má být použit k odesílání sestav."

msgid "Reports will be sent to a URI."
msgstr "Sestavy budou odeslány na identifikátor URI."

