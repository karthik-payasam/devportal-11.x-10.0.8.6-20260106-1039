msgstr "Número máximo de hilos de lanzamiento que pueden estar ejecutando en un momento dado."

msgid "Run in thread"
msgstr "Ejecutar en hilo"

msgid "Which thread to run jobs in."
msgstr "En qué hilo ejecutar los trabajos."

msgid "<strong>Any</strong>: Just use any available thread"
msgstr "<strong>Cualquiera</strong>: Usar cualquier hilo disponible"

msgid "<strong>Fixed</strong>: Only run in one specific thread. The maximum number of threads is spread across the jobs."
msgstr "<strong>Fijo</strong>: Ejecutar solo en un hilo concreto. El número máximo de hilos se reparte entre los trabajos."

msgid "<strong>1-?</strong>: Only run when a specific thread is invoked. This setting only has an effect when cron is run through cron.php with an argument ?thread=N or through Drush with --options=thread=N."
msgstr "<strong>1-?</strong>: Ejecutar solo cuando se invoca un hilo determinado. Este parámetro solo tiene efecto cuando se ejecuta cron a través de cron.php con el argumento ?thread=N o a través de Drush con --options=thread=N."

msgid "Cache bin"
msgstr "Contenedor de caché"

