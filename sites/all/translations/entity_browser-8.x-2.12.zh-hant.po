msgstr "要顯示在實體瀏覽器選取按鈕上的文字。"

msgid "Whether or not the selection should be hidden by default."
msgstr "選擇是否應該依預設隱藏。"

msgid "Multi step selection display"
msgstr "多步驟選擇顯示"

msgid "Shows the current selection display, allowing to mix elements selected through different widgets in several steps."
msgstr "展現現行選擇顯示，這容許混合若干步驟中透過不同小組件選取的元素。"

msgid "No selection display"
msgstr "無選擇顯示"

msgid "Skips the current selection display and immediately delivers the entities selected."
msgstr "略過現行選擇顯示，並且立即遞送選取的實體。"

msgid "Use selection"
msgstr "使用選擇"

msgid "@view : @display"
msgstr "@view : @display"

msgid "View : View display"
msgstr "視圖：檢視畫面"

