msgid "Bootstrap Site Alert"
msgstr "Bootstrap Site Alert"

msgid "This module is for rendering alerts site wide using the power of Bootstrap"
msgstr "Ten moduł jest przeznaczony do wyświetlania alertów w całym serwisie przy użyciu możliwości biblioteki Bootstrap"

msgid "Other"
msgstr "Inne"

msgid "Bootstrap Site Alert Configuration"
msgstr "Konfiguracja modułu Bootstrap Site Alert"

msgid "Configure the Bootstrap Site Wide Alert Settings"
msgstr "Skonfiguruj ustawienia alertów biblioteki Bootstrap dla całego serwisu"

msgid "Administer Bootstrap Site Alert"
msgstr "Administrowanie modułem Bootstrap Site Alert"

msgid "View Bootstrap Site Alert"
msgstr "Wyświetl moduł Bootstrap Site Alert"

msgid "Settings"
msgstr "Ustawienia"

msgid ""
"<h3>Use this form to setup the bootstrap site alert(s).</h3>\n"
"                  <p>Make sure you select the checkbox if you want to turn the alerts on</p>"
msgstr ""
"<h3>Ten formularz służy do konfigurowania alertów serwisu środowiska Bootstrap.</h3>\n"
"                  <p>Upewnij się, że pole wyboru jest zaznaczone, jeśli alerty mają być włączone</p>"

msgid "Select Bootstrap Version"
msgstr "Wybierz wersję środowiska Bootstrap"

msgid "3"
msgstr "3"

msgid "4"
msgstr "4"

msgid "- SELECT -"
msgstr "- WYBIERZ -"

msgid "Save Bootstrap Version"
msgstr "Zapisz wersję środowiska Bootstrap"

msgid "Success"
msgstr "Sukces"

msgid "Info"
msgstr "Informacja"

msgid "Warning"
msgstr "Ostrzeżenie"

msgid "Danger"
msgstr "Niebezpieczeństwo"

msgid "Primary"
msgstr "Główny"

msgid "Secondary"
msgstr "Drugorzędny"

msgid "Light"
msgstr "Jasny"

msgid "Dark"
msgstr "Ciemny"

msgid "If Checked, Bootstrap Site Alert is Active."
msgstr "Jeśli ta opcja jest zaznaczona, moduł bootstrap Site Alert jest aktywny."

msgid "Severity"
msgstr "Priorytet"

msgid "Make this alert dismissable?"
msgstr "Czy ten alert można odrzucić?"

msgid "Hide this alert on admin pages?"
msgstr "Czy ukryć ten alert na stronach administracyjnych?"

msgid "Only Show On Certain Pages?"
msgstr "Czy pokazywać tylko na niektórych stronach?"

msgid "Path(s) to show on"
msgstr "Ścieżka lub ścieżki do wyświetlenia"

msgid "Specify pages by using their paths. Enter one path per line. The '*' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page."
msgstr "Należy wskazać strony podając ich ścieżki, po jednej na wiersz. Znak '*' zastępuje dowolny ciąg. Przykładowo ścieżka %user-wildcard oznacza każdą stronę z profilem użytkownika. Ścieżka %front oznacza stronę główną."

msgid "Alert Message"
msgstr "Komunikat alertu"

msgid "Add Another Alert"
msgstr "Dodaj kolejny alert"

msgid "Remove Last Alert"
msgstr "Usuń ostatni alert"

msgid "Save Alert Message(s)"
msgstr "Zapisz komunikaty o alertach"

