msgid "Client-side Hierarchical Select"
msgstr "Sélection hiérarchique côté client"

msgid "A simple client-side hierarchical select widget for taxonomy terms."
msgstr "Widget de sélection hiérarchique côté client simple pour les termes de la taxonomie."

msgid "Widgets"
msgstr "Widgets"

msgid "CSHS field widget settings"
msgstr "Paramètres de widget de zone CSHS"

msgid "Save lineage"
msgstr "Sauvegarder la lignée"

msgid "Force selection of deepest level"
msgstr "Forcer la sélection du niveau le plus bas"

msgid "Parent"
msgstr "Parent"

msgid "Labels per hierarchy-level"
msgstr "Libellés par niveau de hiérarchie"

msgid "Hierarchy depth"
msgstr "Profondeur de la hiérarchie"

msgid "Required depth"
msgstr "Profondeur requise"

msgid "The \"no selection\" label"
msgstr "Libellé \"no selection\""

msgid "Client-side Hierarchical Select: Menu Link"
msgstr "Sélection hiérarchique côté client : lien de menu"

msgid "A client-side hierarchical selection of parents for the menu link. Works for node and term forms (with \"taxonomy_menu_ui\" enabled)."
msgstr "Sélection hiérarchique des parents côté client pour le lien de menu. Fonctionne pour les formulaires de noeud et de terme (avec \"taxonomy_menu_ui\" activé)."

msgid "Deepest"
msgstr "Le plus profond"

msgid "None"
msgstr "Aucun(e)"

msgid "Yes"
msgstr "Oui"

msgid "No"
msgstr "Non"

msgid "Parent: @parent"
msgstr "Parent : @parent"

msgid "Force deepest: @force_deepest"
msgstr "Forcer le niveau le plus profond : @force_deepest"

msgid "Save lineage: @save_lineage"
msgstr "Sauvegarder la lignée : @save_lineage"

msgid "Level labels: @level_labels"
msgstr "Libellés de niveau : @level_labels"

msgid "The \"no selection\" label: @none_label"
msgstr "Libellé \"no selection\" : @none_label"

msgid "Select a parent term to use only a subtree of a vocabulary for this field."
msgstr "Sélectionnez un terme parent afin de n'utiliser qu'une sous-arborescence d'un vocabulaire pour cette zone."

msgid "Force the deepest level selection"
msgstr "Forcer la sélection de niveau le plus profond"

msgid "If checked the user will be forced to select terms from the deepest level."
msgstr "Si cette option est sélectionnée, l'utilisateur devra obligatoirement sélectionner des termes dans le niveau le plus bas."

msgid "Enter labels for each hierarchy-level separated by comma."
msgstr "Entrez des libellés pour chaque niveau de hiérarchie séparé par une virgule."

msgid "The label for an empty option."
msgstr "Libellé de l'option vide."

msgid "The hierarchy depth cannot be @actual because the selection list has @levels levels."
msgstr "La profondeur de la hiérarchie ne peut pas être @actual, car la liste de sélection contient des niveaux @levels."

msgid "The required depth cannot be greater than the hierarchy depth."
msgstr "La profondeur requise ne peut pas être supérieure à la profondeur de la hiérarchie."

msgid "Format"
msgstr "Format"

msgid "Specify a format for each field item by using tokens."
msgstr "Spécifiez un format pour chaque élément de zone à l'aide de jetons."

msgid "Clear Tokens"
msgstr "Effacer les jetons"

msgid "Remove token from final text if no replacement value is generated"
msgstr "Retirer le jeton du texte final en l'absence de génération d'une valeur de remplacement"

msgid "Format: @format"
msgstr "Format : @format"

msgid "Flexible hierarchy"
msgstr "Hiérarchie souple"

msgid "Allows to specify the output with tokens."
msgstr "Permet de spécifier la sortie avec des jetons."

msgid "Link to term page"
msgstr "Lien vers la page des termes"

msgid "Reverse order view"
msgstr "Vue d'ordre inverse"

msgid "Outputs hierarchy in reverse order (the deepest level first)."
msgstr "Affiche la hiérarchie dans l'ordre inverse (le niveau le plus bas en premier)."

msgid "Linked to term page: @linked"
msgstr "Lié à la page du terme : @linked"

msgid "Reverse order view: @reverse"
msgstr "Vue d'ordre inverse : @reverse"

msgid "Separator"
msgstr "Séparateur"

msgid "Specify a separator which will be placed in between the different hierarchy levels."
msgstr "Spécifiez un séparateur à placer entre les niveaux de hiérarchie."

msgid "Separator: @separator"
msgstr "Séparateur : @separator"

msgid "Full hierarchy"
msgstr "Hiérarchie complète"

msgid "Display the full hierarchy of the taxonomy term."
msgstr "Affichez la hiérarchie complète du terme de taxonomie."

msgid "Sorting"
msgstr "Tri"

msgid "Depth"
msgstr "Profondeur"

msgid "The maximum hierarchy depth. Use 0 to not limit or 1 to display just the root term (or the last if reverse order selected)."
msgstr "Profondeur maximale de la hiérarchie. Utilisez 0 pour ne pas limiter ou 1 pour afficher uniquement le terme racine (ou le dernier si l'ordre inverse est sélectionné)."

msgid "Last child"
msgstr "Dernier enfant"

msgid "Show only the root term and its deepest child."
msgstr "Afficher uniquement le terme racine et son enfant le plus profond."

msgid "Sorting: @value"
msgstr "Tri : @value"

msgid "Depth: @value"
msgstr "Profondeur : @value"

msgid "Last child only"
msgstr "Dernier enfant uniquement"

msgid "Unlimited"
msgstr "Illimité"

msgid "Hierarchy grouped by root"
msgstr "Hiérarchie regroupée par racine"

msgid "Display the hierarchy of the taxonomy term grouped by root."
msgstr "Affichez la hiérarchie du terme de taxonomie regroupée par racine."

msgid "Client-side hierarchical select"
msgstr "Sélection hiérarchique côté client"

msgid "An invalid vocabulary is selected. Please change it in the options."
msgstr "Un vocabulaire invalide a été sélectionné. Merci de le modifier dans les options."

msgid "About"
msgstr "À propos"

msgid "Settings"
msgstr "Paramètres"

msgid "Multi-lingual"
msgstr "Multilingue"

msgid "Supports multi-lingual terms localized with i18n_taxonomy module (Which is part of the i18n package)."
msgstr "Prend en charge les termes multilingues traduits avec le module i18n_taxonomy (appartenant au package i18n)."

