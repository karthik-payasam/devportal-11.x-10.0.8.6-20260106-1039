msgid "Facets summary (Experimental)"
msgstr "Récapitulatif des facettes (expérimental)"

msgid "Exposes a Facets block summary showing the current search."
msgstr "Expose un récapitulatif des blocs de facettes affichant la recherche en cours."

msgid "Search"
msgstr "Rechercher"

msgid "Add facet summary"
msgstr "Ajouter un récapitulatif de facette"

msgid "Edit facets summary"
msgstr "Editer le récapitulatif des facettes"

msgid "Edit"
msgstr "Editer"

msgid "Facet Summary settings"
msgstr "Paramètres du récapitulatif de facette"

msgid "Facet"
msgstr "Facette"

msgid "ID"
msgstr "ID"

msgid "Name"
msgstr "Nom"

msgid "Facet source id"
msgstr "ID source de la facette"

msgid "Processor settings"
msgstr "Paramètres du processeur"

msgid "A processor"
msgstr "Un processeur"

msgid "The plugin ID of the processor"
msgstr "ID de plug-in du processeur"

msgid "The processors weight for this stage"
msgstr "Pondération des processeurs pour cette étape"

msgid "the weight"
msgstr "la pondération"

msgid "Facets configuration"
msgstr "Configuration de facettes"

msgid "Is this facet enabled"
msgstr "Cette facette est-elle activée"

msgid "Label"
msgstr "Libellé"

msgid "Results separator"
msgstr "Séparateur de résultats"

msgid "Show count on items"
msgstr "Afficher le nombre sur les éléments"

msgid "Facet Weight"
msgstr "Pondération de la facette"

msgid "No results behavior"
msgstr "Comportement en cas d'absence de résultats"

msgid "The text to show when there is no current search"
msgstr "Texte à afficher lorsqu'il n'y a pas de recherche en cours"

msgid "Reset facets link"
msgstr "Lien de réinitialisation des facettes"

msgid "The text to show for the reset link."
msgstr "Texte à afficher pour le lien de réinitialisation."

msgid "Position of the reset link."
msgstr "Position du lien de réinitialisation."

msgid "Processor @id specifies a non-existing @class."
msgstr "Le processeur @id spécifie une @class qui n'existe pas."

msgid "Facet summary"
msgstr "Récapitulatif de facette"

msgid "Edit %label facets summary"
msgstr "Editer le récapitulatif des facettes %label"

msgid "Enabled facets"
msgstr "Facettes activées"

msgid "Separator"
msgstr "Séparateur"

msgid "Show counts"
msgstr "Afficher les nombres"

msgid "Weight"
msgstr "Poids"

msgid "Select the facets to be shown in the summary block. You can reorder them."
msgstr "Sélectionnez les facettes à afficher dans le bloc récapitulatif. Vous pouvez les réorganiser."

msgid "Weight for @title"
msgstr "Poids pour @title"

msgid "No facets found."
msgstr "Aucune facette trouvée."

msgid "Facets Summary settings"
msgstr "Paramètres du récapitulatif des facettes"

msgid "%processor settings"
msgstr "Paramètres %processor"

msgid "Advanced settings"
msgstr "Paramètres avancés"

msgid "Processor order"
msgstr "Ordre des processeurs"

msgid "Weight for processor %title"
msgstr "Pondération pour le processeur %title"

msgid "Facets Summary %name has been updated."
msgstr "Le récapitulatif des facettes %name a été mis à jour."

msgid "Add facets summary"
msgstr "Ajouter le récapitulatif des facettes"

msgid "Facets settings for %label"
msgstr "Paramètres de facettes pour %label"

msgid "You currently have no facet sources defined. You should start by adding a facet source before creating facets."
msgstr "Aucune source de facette n'est définie actuellement. Vous devez commencer en ajoutant une source de facette avant de créer des facettes."

msgid "Facet source"
msgstr "Source de facette"

msgid "The source where this summary will be built from."
msgstr "Source à partir de laquelle ce récapitulatif sera généré."

msgid "The administrative name used for this summary."
msgstr "Nom administratif utilisé pour ce récapitulatif."

msgid "Facet Summary %name has been created. Go to the <a href=\":block_overview\">Block overview page</a> to place the new block in the desired region."
msgstr "Le récapitulatif de facette %name a été créé. Allez sur la <a href=\":block_overview\">page de présentation du bloc</a> pour placer le nouveau bloc dans la région souhaitée."

msgid "Facet %name has been updated."
msgstr "La facette %name a été mise à jour."

msgid "Caching of view %view has been disabled."
msgstr "La mise en cache de la vue %view a été désactivée."

msgid "Facet Summary: :facet_summary"
msgstr "Récapitulatif de facette : : facet_summary"

msgid "Facets Summary"
msgstr "Récapitulatif des facettes"

msgid "In preview"
msgstr "En avant-première"

msgid "Hide Summary when Facet Source is not rendered"
msgstr "Masquer le récapitulatif lorsque la source de la facette n'est pas affichée"

msgid "When checked, this facet will only be rendered when the facet source is rendered. If you want to show facets on other pages too, you need to uncheck this setting."
msgstr "Lorsque cette case est cochée, cette facette ne s'affiche que lorsque la source de la facette est affichée. Si vous souhaitez également afficher des facettes sur d'autres pages, vous devez désélectionner ce paramètre."

msgid "Reset"
msgstr "Réinitialiser"

msgid "Reset facets link text"
msgstr "Texte du lien de réinitialisation des facettes"

msgid "Show reset link before facets links"
msgstr "Afficher le lien de réinitialisation avant les liens de facettes"

msgid "Show reset link after facets links"
msgstr "Afficher le lien de réinitialisation après les liens de facettes"

msgid "Show only reset link"
msgstr "Afficher uniquement le lien de réinitialisation"

msgid "Position"
msgstr "Position"

msgid "Set position of the link to display it before, after or instead of facets links."
msgstr "Définissez la position du lien pour l'afficher avant, après ou à la place des liens de facettes."

msgid "Adds reset facets link."
msgstr "Ajoute le lien de réinitialisation des facettes."

msgid "When checked, this facet will add a link to reset enabled facets."
msgstr "Lorsque cette case est cochée, cette facette ajoute un lien pour réinitialiser les facettes activées."

msgid "Show a summary of how many results were found"
msgstr "Afficher le récapitulatif du nombre de résultats trouvés"

msgid "When checked, this will show the amount of results found."
msgstr "Lorsque cette case est cochée, affiche le nombre de résultats trouvés."

msgid "Show a summary of all selected facets"
msgstr "Afficher le récapitulatif de toutes les facettes sélectionnées"

msgid "When checked, this facet will show an imploded list of all selected facets."
msgstr "Lorsque cette case est cochée, cette facette affiche une liste réduite de toutes les facettes sélectionnées."

msgid "Empty text"
msgstr "Texte vide"

msgid "No results found."
msgstr "Aucun résultat trouvé."

msgid "Show a text when there are no results"
msgstr "Afficher un texte lorsqu'il n'y a aucun résultat"

msgid "Show a text when there are no results, otherwise it will hide the block."
msgstr "Afficher un texte lorsqu'il n'y a aucun résultat, sinon le bloc sera masqué."

msgid "Build stage"
msgstr "Etape de génération"

msgid "1 result found"
msgid_plural "@count results found"
msgstr[0] "1 résultat trouvé"
msgstr[1] "@count résultats trouvés"

