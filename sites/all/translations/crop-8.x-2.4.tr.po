msgstr "Açıklama"

msgid "Aspect ratio"
msgstr "En-boy oranı"

msgid "Soft limit width"
msgstr "Esnek sınırlı genişlik"

msgid "Soft limit height"
msgstr "Esnek sınırlı yükseklik"

msgid "Hard limit width"
msgstr "Sabit sınırlı genişlik"

msgid "Hard limit height"
msgstr "Sabit sınırlı yükseklik"

msgid "Third party settings"
msgstr "Üçüncü parti ayarları"

msgid "Crop settings"
msgstr "Kırpma ayarları"

msgid "Field storing image to be cropped"
msgstr "Kırpılacak resmin depolandığı alan"

msgid "Crop effect configuration"
msgstr "Kırpma etkisi yapılandırması"

msgid "Automatic crop provider"
msgstr "Otomatik kırpma sağlayıcısı"

msgid "Crop API settings"
msgstr "Kırpma API'si ayarları"

msgid "Indicates whether to flush image derivatives when a crop entity is change"
msgstr "Bir kırpma varlığı değiştirildiğinde resim türevlerinin boşaltılıp boşaltılmayacağını gösterir"

msgid "Media entity crop"
msgstr "Ortam varlığı kırpma"

msgid "Deprecated."
msgstr "Kullanımdan kaldırıldı."

msgid "Aspect Ratio"
msgstr "En Boy Oranı"

msgid "Used in"
msgstr "Şurada kullanılıyor"

msgid "@first, @second and @count more"
msgstr "@first, @second ve @count daha"

msgid "No crop types available. <a href=\"@link\">Add crop type</a>."
msgstr "Kullanılabilir kırpma tipi yok. <a href=\"@link\">Kırpma tipi ekleyin</a>."

msgid "Entity provider @id not found."
msgstr "Varlık sağlayıcı @id bulunamadı."

msgid "Crop ID"
msgstr "Kırpma Tanıtıcısı"

msgid "The crop ID."
msgstr "Kırpma tanıtıcısı."

msgid "UUID"
msgstr "UUID"

msgid "The crop UUID."
msgstr "Kırpma UUID'si."

msgid "Revision ID"
msgstr "Sürüm ID"

msgid "The crop revision ID."
msgstr "Kırpma düzeltme tanıtıcısı."

msgid "Type"
msgstr "Tip"

msgid "The crop type."
msgstr "Kırpma tipi."

msgid "Language code"
msgstr "Dil kodu"

msgid "The node language code."
msgstr "Düğüm dil kodu."

msgid "Entity ID"
msgstr "Varlık kimliği (ID)"

msgid "ID of entity crop belongs to."
msgstr "Kırpmanın ait olduğu varlık tanıtıcısı."

msgid "Entity type"
msgstr "Varlık tipi"

msgid "The type of entity crop belongs to."
msgstr "Kırpmanın ait olduğu varlık tipi."

msgid "URI"
msgstr "URI"

msgid "The URI of the image crop belongs to."
msgstr "Kırpmanın ait olduğu resim URI'si."

msgid "Height"
msgstr "Yükseklik"

msgid "The crop height."
msgstr "Kırpma yüksekliği."

msgid "Width"
msgstr "Genişlik"

msgid "The crop width."
msgstr "Kırpma genişliği."

msgid "X coordinate"
msgstr "X koordinatı"

msgid "The crop's X coordinate."
msgstr "Kırpmanın X koordinatı."

msgid "Y coordinate"
msgstr "Y koordinatı"

msgid "The crop's Y coordinate."
msgstr "Kırpmanın Y koordinatı."

msgid "Revision timestamp"
msgstr "Sürüm zaman damgası"

msgid "The time that the current revision was created."
msgstr "Geçerli düzeltmenin oluşturulduğu zaman."

msgid "Revision author ID"
msgstr "Düzeltme yazarı kimliği"

msgid "The user ID of the author of the current revision."
msgstr "Son versiyon yazarının kullanıcı kimliği (ID)."

msgid "Revision Log"
msgstr "Düzeltme Günlüğü"

msgid "The log entry explaining the changes in this revision."
msgstr "Bu sürümdeki değişiklikleri açıklayan günlük girdisi."

msgid "Crop"
msgstr "Kırp"

msgid "Are you sure you want to delete the crop type %type?"
msgstr "%type kırpma tipini silmek istediğinizden emin misiniz?"

msgid "The crop type %name has been deleted."
msgstr "Kırpma tipi %name silindi."

msgid "Deleted crop type %name."
msgstr "Silinen kırpma tipi %name."

msgid "%type is used by 1 piece of content on your site. You can not remove this content type until you have removed all of the %type content."
msgid_plural "%type is used by @count pieces of content on your site. You may not remove %type until you have removed all of the %type content."
msgstr[0] "%type sitenizdeki içeriğin 1 parçası tarafından kullanılıyor. %type içeriğinin tümünü kaldırıncaya kadar bu içerik tipini kaldıramazsınız."
msgstr[1] "%type sitenizdeki içeriğin @count parçası tarafından kullanılıyor. Tüm %type içeriğini kaldırıncaya kadar %type içeriğini kaldıramayabilirsiniz."

msgid "Edit %label crop type"
msgstr "%label kırpma tipini düzenle"

msgid "The human-readable name of this crop type. This name must be unique."
msgstr "Bu kırpma tipinin kişi tarafından okunabilir adı. Bu ad benzersiz olmalıdır."

msgid "A unique machine-readable name for this crop type. It must only contain lowercase letters, numbers, and underscores."
msgstr "Bu kırpma tipi için benzersiz bir, makine tarafından okunabilir adı. Yalnızca küçük harfler, rakamlar ve alt çizgiler içerebilir."

msgid "Describe this crop type."
msgstr "Bu kırpma tipini açıklayın."

msgid "Set an aspect ratio <b>eg: 16:9</b> or leave this empty for arbitrary aspect ratio"
msgstr "Bir en-boy oranı <b>örn: 16:9</b> ayarlayın ya da bu rastgele en-boy oranı için bunu boş bırakın"

msgid "Soft limit"
msgstr "Esnek sınır"

msgid "Define crop size soft limit. Warning will be displayed if crop smaller than that is selected."
msgstr "Kırpma boyutu için esnek sınırı tanımlayın. Bundan küçük kırpma seçilirse uyarı görüntülenir."

msgid "Limit for width."
msgstr "Genişlik sınırı."

msgid "Limit for height."
msgstr "Yükseklik sınırı."

msgid "Hard limit"
msgstr "Sabit sınır"

msgid "Define crop size hard limit. User is not allowed to make a smaller selection than defined here."
msgstr "Kırpma boyutu için sabit sınırı tanımlayın. Kullanıcının burada tanımlanandan daha küçük bir seçim yapmasına izin verilmez."

msgid "Limit for width"
msgstr "Genişlik sınırı"

msgid "Save crop type"
msgstr "Kırpma tipini kaydet"

msgid "Delete crop type"
msgstr "Kırpma tipini sil"

msgid "The crop type %name has been updated."
msgstr "Kırpma tipi %name güncellendi."

msgid "The crop type %name has been added."
msgstr "Kırpma tipi %name eklendi."

msgid "View"
msgstr "Görüntüle"

msgid "Added crop type %name."
msgstr "Kırpma tipi %name eklendi."

msgid "File"
msgstr "Dosya"

msgid "Provides crop integration for core files."
msgstr "Çekirdek dosyalar için kırpma bütünleştirmesi sağlar."

msgid "Provides crop integration for media."
msgstr "Ortam için kırpma bütünleştirmesi sağlar."

msgid "Crop type to be used for the image style."
msgstr "Resim stili için kullanılacak kırpma tipi."

msgid "- Select a Provider -"
msgstr "- Bir Sağlayıcı Seçin -"

msgid "The name of automatic crop provider to use if crop is not set for an image."
msgstr "Bir görüntü için kırpma ayarlanmadıysa kullanılacak otomatik kırpma sağlayıcısının adı."

msgid "Manual image crop failed due to misconfigured crop type on %path."
msgstr "%path yolundaki yanlış yapılandırılan kırpma tipi nedeniyle, manuel resim kırpma işlemi başarısız oldu. "

msgid "Manual image crop failed using the %toolkit toolkit on %path (%mimetype, %width x %height)"
msgstr "Resmi %path yolundaki %toolkit araç takımı kullanarak manuel kırpma başarısız oldu (%mimetype, %width x %height)"

msgid "Manual crop"
msgstr "Manuel kırpma"

msgid "Applies manually provided crop to the image."
msgstr "Resme, manuel olarak sağlanan kırpma işlemini uygular. "

msgctxt "Validation"
msgid "Crop Type aspect ratio"
msgstr "Kırpma Tipi en-boy oranı"

msgid "Invalid aspect ratio format. Should be defined in H:W form."
msgstr "Geçersiz en-boy oranı biçimi. Y:G biçiminde tanımlanmalıdır."

msgctxt "Validation"
msgid "Crop Type machine name"
msgstr "Kırpma Tipi makine adı"

msgid "Invalid machine-readable name."
msgstr "Geçersiz makine adı."

