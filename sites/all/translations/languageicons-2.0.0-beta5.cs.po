msgid "This module manages language icons for multilingual sites:"
msgstr "Tento modul spravuje ikony jazyků pro vícejazyčné stránky:"

msgid "Automatically adds icons to language links."
msgstr "Automaticky přidávat ikony k odkazům na jiné jazyky."

msgid "Provides related theme functions."
msgstr "Poskytuje související funkce motivu."

msgid "For more information, please see <a href=\"@handbook\">the online handbook section</a>."
msgstr "Více informací najdete v <a href=\"@handbook\">online příručce</a>."

msgid "To enable multilingual support for specific content types go to <a href=\"@configure_content_types\">configure content types</a>."
msgstr "Pro zapnutí vícejazyčné podpory pro určité typy obsahu jděte na stránku <a href=\"@configure_content_types\">konfigurace typů obsahu</a>."

msgid "Language Icons"
msgstr "Jazykové ikony"

msgid "Adds icons to language links."
msgstr "Přidá ikony k odkazům na jazykové verze."

msgid "Multilingual"
msgstr "Vícejazyčné"

msgid "Language icons"
msgstr "Ikony jazyků"

msgid "Configure the Language Icons module."
msgstr "Nakonfigurujte modul Ikony jazyka."

msgid "Icons"
msgstr "Ikony"

msgid "Language Icons settings"
msgstr "Nastavení ikon jazyka"

msgid "Show the icons on a node"
msgstr "Zobrazit ikony na uzlu"

msgid "Show the icons on the language switcher block"
msgstr "Zobrazit ikony v bloku přepínače jazyků"

msgid "Add language icons"
msgstr "Přidat ikony jazyků"

msgid "Link types to add language icons."
msgstr "Typy odkazů, ke kterým se mají přidat jazykové ikony."

msgid "Node links"
msgstr "Odkazy na uzly"

msgid "Language switcher block"
msgstr "Blok pro přepínání jazyka"

msgid "These options are currently disabled due to <a href=\":issue_url\">a bug</a> that cannot currently be resolved. They may be reintroduced at a later stage."
msgstr "Tyto volby jsou aktuálně vypnuté kvůli <a href=\":issue_url\">chybě</a>, kterou nelze aktuálně vyřešit. Mohou být znovu zavedeny v pozdější fázi."

msgid "Icon placement"
msgstr "Umístění ikony"

msgid "Before link"
msgstr "Před odkazem"

msgid "After link"
msgstr "Za odkazem"

msgid "Replace link"
msgstr "Nahradit odkaz"

msgid "Where to display the icon, relative to the link title."
msgstr "Kde se má zobrazit ikona (vzhledem k textu odkazu)."

msgid "Icons file path"
msgstr "Cesta k souboru s ikonami"

msgid "Path for language icons, relative to Drupal installation. \"*\" is a placeholder for language code."
msgstr "Cesta k ikonám jazyků, relativní k Drupal instalaci. \"*\" nahrazuje kód jazyka."

msgid "Image size"
msgstr "Velikost obrázku"

msgid "Image size for language icons, in the form \"width x height\"."
msgstr "Velikost obrázku pro ikony jazyků; ve tvaru\"šířka x výška\"."

