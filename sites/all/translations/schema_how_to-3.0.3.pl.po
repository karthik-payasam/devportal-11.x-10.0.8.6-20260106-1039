msgid "Schema.org HowTo"
msgstr "Instrukcje HowTo w standardzie Schema.org"

msgid "Adds Schema.org/HowTo to the JSON LD array."
msgstr "Dodaje ścieżkę Schema.org/HowTo do tablicy JSON LD."

msgid "SEO"
msgstr "SEO"

msgid "@type"
msgstr "@type"

msgid "name"
msgstr "nazwa"

