msgid "External Authentication Map"
msgstr "Correlación de autenticación externa"

msgid "Provider"
msgstr "Proveedor"

msgid "The name of the authentication provider providing the authname."
msgstr "El nombre del proveedor de autenticación que proporciona el authname."

msgid "Authname"
msgstr "Authname"

msgid "Unique authentication name provided by authentication provider."
msgstr "Nombre de autenticación exclusivo proporcionado por el proveedor de autenticación."

msgid "Drupal User ID"
msgstr "ID de usuario de Drupal"

msgid "The user linked to the authname."
msgstr "El usuario vinulado al mombre de autenticación."

msgid "Linked Drupal user"
msgstr "Usuario de Drupal vinculado"

msgid "Link to delete @label entry"
msgstr "Enlace para suprimir la entrada @label"

msgid "Provide a link to delete the @label entry."
msgstr "Proporcione un enlace para suprimir la entrada @label."

msgid "About"
msgstr "Acerca de"

msgid "Authenticates users using an external site / service and stores identification details."
msgstr "Autentica usuarios usando un sitio / servicio externo y almacena los detalles de identificación."

msgid "External Authentication"
msgstr "Autenticación externa"

msgid "Helper module to authenticate users using an external site / service and storing identification details"
msgstr "Módulo auxiliar para autenticar usuarios usando un sitio / servicio externo y almacenando los detalles de identificación"

msgid "User authentication"
msgstr "Autenticación de usuario"

msgid "View external authentication data"
msgstr "Ver datos de autenticación externa"

msgid "Delete external authentication data"
msgstr "Suprimir datos de autenticación externa"

msgid "Delete authmap entry"
msgstr "Suprimir entrada authmap"

msgid "Authmap change (%old => %new) for user %name with uid %uid from provider %provider"
msgstr "Cambio de correlación de autorización (%old = > %new) para el usuario %name con el ID de usuario %udel proveedor %provider"

msgid "External registration of user %name from provider %provider and authname %authname"
msgstr "Registro externo del usuario %name del proveedor %provider y nombre de autorizacion %authname"

msgid "External login of user %name"
msgstr "Inicio de sesión externo del usuario %name"

msgid "Are you sure you want to delete the link between authentication name %id and Drupal user %user?"
msgstr "¿Está seguro de que desea suprimir el enlace entre el nombre de autenticación %id y el usuario de Drupal %u?"

msgid "No authmap record found for provider @provider / uid @uid."
msgstr "No se ha encontrado ningún registro de authmap para @provider /uid @uid."

msgid "The link has been deleted."
msgstr "El enlace se ha suprimido."

msgid "User’s users.uid."
msgstr "users.uid del usuario."

msgid "Unique authentication name."
msgstr "Nombre de autenticación exclusivo."

msgid "Module which is controlling the authentication."
msgstr "Módulo que está controlando la autenticación."

msgid "delete"
msgstr "eliminar"

msgid "Output the URL as text"
msgstr "Muestra la URL como texto"

msgid "Use absolute link (begins with \"http://\")"
msgstr "Utilizar enlace absoluto (empieza con «http://»)"

msgid "Enable this option to output an absolute link. Required if you want to use the path as a link destination."
msgstr "Habilite esta opción para generar un enlace absoluto. Se requiere si desea usar la ruta como un destino de enlace."

