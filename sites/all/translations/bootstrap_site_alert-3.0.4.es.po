msgid "Bootstrap Site Alert"
msgstr "Alerta de sitio de programa de arranque"

msgid "This module is for rendering alerts site wide using the power of Bootstrap"
msgstr "Este módulo sirve para representar alertas en todo el sitio utilizando la potencia del programa de arranque"

msgid "Other"
msgstr "Otro(s)"

msgid "Bootstrap Site Alert Configuration"
msgstr "Configuración de alerta de sitio de programa de arranque"

msgid "Configure the Bootstrap Site Wide Alert Settings"
msgstr "Configurar los valores de alerta de todo el sitio de programa de arranque"

msgid "Administer Bootstrap Site Alert"
msgstr "Administrar alerta de sitio de programa de arranque"

msgid "View Bootstrap Site Alert"
msgstr "Ver alerta de sitio de programa de arranque"

msgid "Settings"
msgstr "Configuración"

msgid ""
"<h3>Use this form to setup the bootstrap site alert(s).</h3>\n"
"                  <p>Make sure you select the checkbox if you want to turn the alerts on</p>"
msgstr ""
"<h3>Utilice este formulario para configurar las alertas del sitio de programa de arranque.</h3>\n"
"                  <p>Asegúrese de seleccionar la casilla de verificación si desea activar las alertas en</p>"

msgid "Select Bootstrap Version"
msgstr "Seleccionar versión de programa de arranque"

msgid "3"
msgstr "3"

msgid "4"
msgstr "4"

msgid "- SELECT -"
msgstr "- SELECCIONAR -"

msgid "Save Bootstrap Version"
msgstr "Guardar versión del programa de arranque"

msgid "Success"
msgstr "Éxito"

msgid "Info"
msgstr "Info"

msgid "Warning"
msgstr "Advertencia"

msgid "Danger"
msgstr "Peligro"

msgid "Primary"
msgstr "Primario"

msgid "Secondary"
msgstr "Secundario"

msgid "Light"
msgstr "Fina"

msgid "Dark"
msgstr "Oscuro"

msgid "If Checked, Bootstrap Site Alert is Active."
msgstr "Si está seleccionada, la alerta de sitio de programa de arranque está activa."

msgid "Severity"
msgstr "Gravedad"

msgid "Make this alert dismissable?"
msgstr "¿Hacer que esta alerta sea desechable?"

msgid "Hide this alert on admin pages?"
msgstr "¿Ocultar esta alerta en las páginas de administración?"

msgid "Only Show On Certain Pages?"
msgstr "¿Mostrar solo determinadas páginas?"

msgid "Path(s) to show on"
msgstr "Vías de acceso para mostrar en"

msgid "Specify pages by using their paths. Enter one path per line. The '*' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page."
msgstr "Especifique las páginas utilizando sus rutas. Introduzca una ruta en cada línea. El carácter '*' es un comodín. Un ejemplo de ruta puede ser %user-wildcard para cada página de usuario. %front es la página principal."

msgid "Alert Message"
msgstr "Mensaje de alerta"

msgid "Add Another Alert"
msgstr "Añadir otra alerta"

msgid "Remove Last Alert"
msgstr "Eliminar la última alerta"

msgid "Save Alert Message(s)"
msgstr "Guardar mensajes de alerta"

