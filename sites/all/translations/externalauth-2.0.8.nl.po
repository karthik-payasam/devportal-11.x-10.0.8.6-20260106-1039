msgid "External Authentication Map"
msgstr "Externe verificatietoewijzing"

msgid "Provider"
msgstr "Provider"

msgid "The name of the authentication provider providing the authname."
msgstr "De naam van de verificatieprovider die de authname levert."

msgid "Authname"
msgstr "Authname"

msgid "Unique authentication name provided by authentication provider."
msgstr "Unieke, door de verificatieprovider aangeleverde verificatienaam."

msgid "Drupal User ID"
msgstr "Gebruikers-ID Drupal"

msgid "The user linked to the authname."
msgstr "De gebruiker die is gekoppeld aan de authname."

msgid "Linked Drupal user"
msgstr "Gekoppelde Drupal-gebruiker"

msgid "Link to delete @label entry"
msgstr "Link voor het wissen van @label-item"

msgid "Provide a link to delete the @label entry."
msgstr "Geef een link op om het item @label te wissen."

msgid "About"
msgstr "Over"

msgid "Authenticates users using an external site / service and stores identification details."
msgstr "Hiermee worden gebruikers geverifieerd met behulp van een externe site / service en worden de identificatiegegevens opgeslagen."

msgid "External Authentication"
msgstr "External Authentication"

msgid "Helper module to authenticate users using an external site / service and storing identification details"
msgstr "Helper-module waarmee gebruikers worden geverifieerd met behulp van een externe site / service en waarmee de identificatiegegevens worden opgeslagen."

msgid "User authentication"
msgstr "Gebruikersauthenticatie"

msgid "View external authentication data"
msgstr "Externe verificatiegegevens bekijken"

msgid "Delete external authentication data"
msgstr "Externe verificatiegegevens wissen"

msgid "Delete authmap entry"
msgstr "Authmap-item wissen"

msgid "Authmap change (%old => %new) for user %name with uid %uid from provider %provider"
msgstr "Authmap wijzigen (%old = > %new) voor gebruiker %name met uid %uid van provider %provider"

msgid "External registration of user %name from provider %provider and authname %authname"
msgstr "Externe registratie van gebruiker %name van provider %provider en authname %authname"

msgid "External login of user %name"
msgstr "Externe aanmelding van gebruiker %name"

msgid "Are you sure you want to delete the link between authentication name %id and Drupal user %user?"
msgstr "Weet u zeker dat u de link tussen verificatienaam %id en Drupal-gebruiker %user wilt wissen?"

msgid "No authmap record found for provider @provider / uid @uid."
msgstr "Geen authmap-record gevonden voor provider @provider /uid @uid."

msgid "The link has been deleted."
msgstr "De link is gewist."

msgid "User’s users.uid."
msgstr "users.uid van gebruiker."

msgid "Unique authentication name."
msgstr "Unieke verificatienaam."

msgid "Module which is controlling the authentication."
msgstr "Module die de gebruikersverificatie (authentication) bestuurt."

msgid "delete"
msgstr "verwijderen"

msgid "Output the URL as text"
msgstr "URL als tekst tonen"

msgid "Use absolute link (begins with \"http://\")"
msgstr "Absolute link gebruiken (begint met 'http://')"

msgid "Enable this option to output an absolute link. Required if you want to use the path as a link destination."
msgstr "Schakel dit in om een absolute link te genereren. Vereist als het pad als linkdoel gebruikt wordt."

