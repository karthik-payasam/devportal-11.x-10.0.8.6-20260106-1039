msgid "Lists registered library information."
msgstr "Répertorie les informations sur les bibliothèques enregistrées. "

msgid ""
"Downloads a registered library into the libraries directory for the active site.\n"
"\n"
"See libraries-list for a list of registered libraries."
msgstr ""
"Télécharge une bibliothèque enregistrée dans le répertoire des bibliothèques pour le site actif.\n"
"\n"
"Voir libraries-list pour la liste des bibliothèques enregistrées. "

msgid "Name"
msgstr "Nom"

msgid "Status"
msgstr "État"

msgid "Version"
msgstr "Version"

msgid "Variants"
msgstr "Variantes"

msgid "Dependencies"
msgstr "Dépendances"

msgid "OK"
msgstr "OK"

msgid "Missing dependency: unzip. Install it before using this command."
msgstr "Dépendance manquante : unzip. Installez-la avant d'utiliser cette commande. "

msgid "Directory @path was created"
msgstr "Le répertoire @path a été créé"

msgid "A existing Colorbox plugin was overwritten at @path"
msgstr "Un plug-in Colorbox existant a été remplacé dans @path"

msgid "Colorbox plugin has been downloaded to @path"
msgstr "Le plug-in Colorbox a été téléchargé dans @path"

msgid "Drush was unable to download the Colorbox plugin to @path"
msgstr "Drush n'est pas parvenu à télécharger le plug-in Colorbox dans @path"

msgid "The %dependency library, which the %library library depends on, is not installed."
msgstr "La bibliothèque %dependency dont dépend la bibliothèque %library n'est pas installée."

msgid "The version %dependency_version of the %dependency library is not compatible with the %library library."
msgstr "La version %dependency_version de la bibliothèque %dependency n'est pas compatible avec la bibliothèque %library."

msgid "The %library library could not be found."
msgstr "La bibliothèque %library est introuvable."

msgid "The version of the %library library could not be detected."
msgstr "La version de la bibliothèque %library n'a pas pu être détectée."

msgid "The installed version %version of the %library library is not supported."
msgstr "La version %version installée de la bibliothèque %library n'est pas prise en charge."

msgid "The %variant variant of the %library library could not be found."
msgstr "La variante %variant de la bibliothèque %library est introuvable."

msgid "The following external libraries could not successfully be registered with Drupal core: @libs. See earlier log entries for more details. Once these issues are addressed please be sure to clear your Drupal library cache to ensure external library detection is run again."
msgstr "Les bibliothèques externes suivantes n'ont pas pu être enregistrées auprès du coeur de Drupal : @libs. Reportez-vous aux entrées de journal précédentes pour plus de détails. Une fois les problèmes résolus, veillez à effacer votre cache des bibliothèques Drupal pour garantir une nouvelle exécution de la détection des bibliothèques externes. "

msgid "Libraries"
msgstr "Bibliothèques"

msgid "Allows version-dependent and shared usage of external libraries."
msgstr "Permet la dépendance à la version et l'utilisation partagée des bibliothèques externes. "

msgid "Libraries API settings"
msgstr "Paramètres de l'API des bibliothèques "

msgid "Library definition settings"
msgstr "Paramètres de définition de bibliothèque "

msgid "Local"
msgstr "Locale"

msgid "Local path"
msgstr "Chemin local"

msgid "Enable remote fetching of library definitions"
msgstr "Activer l'extraction à distance des définitions de bibliothèque "

msgid "A list of remote library registry URLs"
msgstr "Liste des URL de registre de bibliothèques à distance "

msgid "The URL of a remote library registry"
msgstr "URL d'un registre de bibliothèques à distance "

msgid "URI locator configuration"
msgstr "Configuration de l'URI de localisation "

msgid "The locator URI"
msgstr "URI de localisation "

msgid "Assets"
msgstr "Assets"

msgid "Provides access to asset library files."
msgstr "Fournit l'accès aux fichiers de la bibliothèque d'actifs. "

msgid "Library definitions"
msgstr "Définitions de bibliothèque "

msgid "Provides access to library definition files."
msgstr "Fournit l'accès aux fichiers de définition de bibliothèque. "

msgid "PHP library files"
msgstr "Fichiers de bibliothèque PHP "

msgid "Provides access to PHP library files."
msgstr "Fournit l'accès aux fichiers de bibliothèque PHP. "

