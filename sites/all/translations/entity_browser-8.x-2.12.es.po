msgstr "@view : @display"

msgid "View : View display"
msgstr "Vista : Ver pantalla"

msgid "View display to use for displaying currently selected items. Do note that to get something useful out of this display, its first contextual filter should be a filter on the primary identifier field of your entity type (e.g., Node ID, Media ID)."
msgstr "Ver la pantalla que se usa para visualizar los elementos seleccionados en la actualidad. Tenga en cuenta que para obtener algo útil de esta pantalla, su primer filtro contextual debe ser un filtro en el campo de identificador primario del tipo de entidad (por ejemplo, ID de nodo, ID de soporte)."

msgid "View selection display"
msgstr "Ver pantalla de selección"

msgid "Use a pre-configured view as selection area."
msgstr "Usar una vista preconfigurada como área de selección"

msgid "The media type is not configured correctly."
msgstr "El tipo de soporte no está configurado correctamente."

msgid "The configured media type is not using the image plugin."
msgstr "El tipo de soporte configurado no utiliza el plug-in de imagen."

msgid "Allowed extensions"
msgstr "Extensiones de archivo permitidas"

