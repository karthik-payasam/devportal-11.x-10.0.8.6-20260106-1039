msgid "Client-side Hierarchical Select"
msgstr "Выбор элементов в иерархии на стороне клиента"

msgid "A simple client-side hierarchical select widget for taxonomy terms."
msgstr "Простой виджет выбора элементов в иерархии для терминов таксономии на стороне клиента."

msgid "Widgets"
msgstr "Виджеты"

msgid "CSHS field widget settings"
msgstr "Настройки виджета для поля CSHS"

msgid "Save lineage"
msgstr "Сохранять путь"

msgid "Force selection of deepest level"
msgstr "Форсированная выборка глубокого уровня"

msgid "Parent"
msgstr "Родитель"

msgid "Labels per hierarchy-level"
msgstr "Метки для уровней иерархии"

msgid "The \"no selection\" label"
msgstr "Метка \"ничего не выбрано\""

msgid "Client-side Hierarchical Select: Menu Link"
msgstr "Выбор элементов в иерархии на стороне клиента: ссылка меню"

msgid "A client-side hierarchical selection of parents for the menu link. Works for node and term forms (with \"taxonomy_menu_ui\" enabled)."
msgstr "Выбор родительских элементов ссылки меню в иерархии на стороне клиента. Работает для форм узлов и терминов (если включен \"taxonomy_menu_ui\"). "

msgid "Deepest"
msgstr "Самый глубокий"

msgid "None"
msgstr "Нет"

msgid "Yes"
msgstr "Да"

msgid "No"
msgstr "Нет"

msgid "Parent: @parent"
msgstr "Родительский: @parent"

msgid "Force deepest: @force_deepest"
msgstr "Самый глубокий: @force_deepest"

msgid "Save lineage: @save_lineage"
msgstr "Сохранить происхождение: @save_lineage"

msgid "Level labels: @level_labels"
msgstr "Метки уровней: @level_labels"

msgid "The \"no selection\" label: @none_label"
msgstr "Метка \"ничего не выбрано\": @none_label"

msgid "Select a parent term to use only a subtree of a vocabulary for this field."
msgstr "Выберите родительский термин для применения только поддерева словаря в этом поле."

msgid "Force the deepest level selection"
msgstr "Принудительный выбор самого глубокого уровня"

msgid "If checked the user will be forced to select terms from the deepest level."
msgstr "Если отмечено, пользователь должен будет выбраться элементы из конечных по глубине уровней."

msgid "Enter labels for each hierarchy-level separated by comma."
msgstr "Введите метки для каждого уровня иерархии (в качестве разделителя применяется запятая)."

msgid "The label for an empty option."
msgstr "Метку пустой опции. "

msgid "The hierarchy depth cannot be @actual because the selection list has @levels levels."
msgstr "Глубина иерархии не может превышать @actual, поскольку список выбора имеет @levels уровней. "

msgid "The required depth cannot be greater than the hierarchy depth."
msgstr "Требуемая глубина не может быть больше глубины иерархии. "

msgid "Format"
msgstr "Формат"

msgid "Specify a format for each field item by using tokens."
msgstr "Укажите формат для каждого поля с помощью маркеров."

msgid "Clear Tokens"
msgstr "Очистить маркеры"

msgid "Remove token from final text if no replacement value is generated"
msgstr "Удалить маркер из окончательного текста, если заменяющее значение не создано"

msgid "Format: @format"
msgstr "Формат: @format"

msgid "Flexible hierarchy"
msgstr "Гибкая иерархия"

msgid "Allows to specify the output with tokens."
msgstr "Позволяет указать вывод с маркерами."

msgid "Link to term page"
msgstr "Ссылка на страницу термина"

msgid "Reverse order view"
msgstr "Обратный порядок"

msgid "Outputs hierarchy in reverse order (the deepest level first)."
msgstr "Иерархия вывода в обратном порядке (сначала самый глубокий уровень)."

msgid "Linked to term page: @linked"
msgstr "Связанная страница термина: @linked"

msgid "Reverse order view: @reverse"
msgstr "Обратный порядок: @reverse"

msgid "Separator"
msgstr "Разделитель"

msgid "Specify a separator which will be placed in between the different hierarchy levels."
msgstr "Укажите разделитель, отображаемый между разными уровнями иерархии."

msgid "Separator: @separator"
msgstr "Разделитель: @separator"

msgid "Full hierarchy"
msgstr "Полная иерархия"

msgid "Display the full hierarchy of the taxonomy term."
msgstr "Отображает полную иерархию термина таксономии."

msgid "Sorting"
msgstr "Сортировка"

msgid "Depth"
msgstr "Глубина"

msgid "The maximum hierarchy depth. Use 0 to not limit or 1 to display just the root term (or the last if reverse order selected)."
msgstr "Максимальная глубина иерархии. Значение 0 означает отсутствие ограничений, значение 1 — отображение только корневого термина (или последнего при обратном порядке)."

msgid "Sorting: @value"
msgstr "Сортировка: @value"

msgid "Depth: @value"
msgstr "Глубина: @value"

msgid "Unlimited"
msgstr "Неограничено"

msgid "Hierarchy grouped by root"
msgstr "Иерархия, сгруппированная по корневому элементу"

msgid "Display the hierarchy of the taxonomy term grouped by root."
msgstr "Отображает иерархию термина таксономии, сгруппированную по корневому элементу."

msgid "Client-side hierarchical select"
msgstr "Выбор элементов в иерархии на стороне клиента"

msgid "An invalid vocabulary is selected. Please change it in the options."
msgstr "Выбран неверный словарь. Измените его в настройках."

msgid "About"
msgstr "Информация"

msgid "Settings"
msgstr "Настройки"

msgid "Multi-lingual"
msgstr "Поддержка нескольких языков"

msgid "Supports multi-lingual terms localized with i18n_taxonomy module (Which is part of the i18n package)."
msgstr "Поддерживает термины на нескольких языках, локализованные с помощью модуля i18n_taxonomy, который входит в состав пакета i18n."

