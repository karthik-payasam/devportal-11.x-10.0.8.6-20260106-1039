msgstr "Dotaz použitý pro tuto akci, tj. https://query.example.com/search?q={search_term_string}."

msgid "query-input"
msgstr "vstup dotazu"

msgid "The placeholder for the query, i.e. required name=search_term_string."
msgstr "Zástupný symbol pro dotaz, tj. povinný název= earch_term_string."

