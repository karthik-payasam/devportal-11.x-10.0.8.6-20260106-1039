msgstr "DOPORUČENO APLIKACÍ GOOGLE. Celkový počet hlasů, který tato odpověď přijala."

msgid "RECOMMENDED BY GOOGLE. The date at which the answer was added to the page, in ISO-8601 format."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Datum, kdy byla odpověď přidána na stránku, ve formátu ISO-8601."

msgid "RECOMMENDED BY GOOGLE. The author of the answer."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Autor odpovědi."

msgid "Book"
msgstr "Kniha"

msgid "bookEdition"
msgstr "bookEdition"

msgid "The edition of the book."
msgstr "Vydání knihy."

msgid "bookFormat"
msgstr "bookFormat"

msgid "The format of the book (comma-separated), i.e. https://schema.org/Hardcover,https://schema.org/Paperback,https://schema.org/EBook"
msgstr "Formát knihy (oddělený čárkami), tj. https://schema.org/Hardcover,https://schema.org/Paperback,https://schema.org/EBook"

msgid "The author of the work."
msgstr "Autor práce."

msgid "Potential action for the work, like a ReadAction."
msgstr "Potenciální akce pro práci, jako je akce ReadAction."

msgid "The name of the work."
msgstr "Název práce."

msgid "Absolute URL of the canonical Web page for the work."
msgstr "Absolutní adresa URL kanonické webové stránky pro práci."

msgid "Urls and social media links, comma-separated list of absolute URLs."
msgstr "Adresy URL a odkazy na sociální média, seznam absolutních adres URL oddělených čárkami."

msgid "Publication date."
msgstr "Datum publikace."

msgid "- None -"
msgstr "-žádný-"

msgid "False"
msgstr "False"

msgid "True"
msgstr "True"

msgid "Boolean"
msgstr "Logický"

msgid "Brand"
msgstr "Značka"

msgid "Name of the brand."
msgstr "Název značky."

msgid "Description of the brand."
msgstr "Popis značky."

msgid "Absolute URL of the canonical Web page, e.g. the URL of the brand's node or term page or brand website."
msgstr "Absolutní adresa URL kanonické webové stránky, např. adresa URL uzlu značky nebo stránky výrazu nebo webové stránky značky."

msgid "Comma separated list of URLs for the person's or organization's official social media profile page(s)."
msgstr "Čárkami oddělený seznam adres URL pro oficiální profilové stránky sociálních médií dané osoby nebo organizace."

msgid "No"
msgstr "Ne"

msgid "Yes"
msgstr "Ano"

msgid "BreadcrumbList"
msgstr "BreadcrumbList"

msgid "Clip"
msgstr "Oříznutí"

msgid ""
"One of the following values:\n"
"'trailer': A preview or advertisement of the work.\n"
"'behind_the_scenes': A summary of the production of the work.\n"
"'highlight': A contiguous scene from the work."
msgstr ""
"Jedna z následujících hodnot: 'trailer': náhled nebo reklama na práci.\n"
"'behind_the_scenes': Souhrn výroby práce.\n"
"'highlight': Přílehlá scéna z práce."

msgid "timeRequired"
msgstr "timeRequired"

msgid "Duration of the clip in ISO 8601 format, 'PT2M5S' (2min 5sec)."
msgstr "Doba trvání klipu ve formátu ISO 8601, 'PT2M5S' (2min 5s)."

msgid "Potential action for the work."
msgstr "Potenciální akce pro práci."

msgid "ContactPoint"
msgstr "ContactPoint"

msgid "Email address."
msgstr "E-mailová adresa."

msgid "faxnumber"
msgstr "faxnumber"

msgid "The fax number."
msgstr "Faxové číslo."

msgid "URL of place, organization."
msgstr "Adresa URL místa, organizace."

msgid "availableLanguage"
msgstr "availableLanguage"

msgid "contactType"
msgstr "contactType"

msgid "One of the following: customer service, technical support, billing support, bill payment, sales, reservations, credit card support, emergency, baggage tracking, roadside assistance, package tracking."
msgstr "Jedna z následujících možností: zákaznická služba, technická podpora, fakturační podpora, platba faktur, oddělení prodeje, rezervace, podpora kreditních karet, naléhavá situace, sledování zavazadel, silniční asistence, sledování zásilek."

msgid "contactOption"
msgstr "contactOption"

msgid "One of the following: HearingImpairedSupported, TollFree."
msgstr "Jedna z následujících hodnot: HearingImpairedSupported, TollFree."

msgid "productSupported"
msgstr "productSupported"

msgid "areaServed"
msgstr "areaServed"

msgid "The geographical region served by the number, specified as a AdministrativeArea. If omitted, the number is assumed to be global."
msgstr "Geografický region obsluhovaný číslem určený jako AdministrativeArea. Pokud je vynechán, předpokládá se, že je číslo globální."

msgid "Country"
msgstr "Země"

msgid "The country. For example, USA. You can also provide the two-letter ISO 3166-1 alpha-2 country code."
msgstr "Země. Například USA. Můžete také zadat dvoupísmenný kód země ISO 3166-1 alpha-2."

msgid "CreativeWork"
msgstr "CreativeWork"

msgid "CreativeWorkSeason"
msgstr "CreativeWorkSeason"

msgid "The number of the season."
msgstr "Číslo sezóny."

msgid "Use a token like [node:created:html_datetime]."
msgstr "Použijte token jako [node:created:html_datetime]."

msgid "Date"
msgstr "Datum"

msgid "DateTime"
msgstr "DateTime"

msgid "Duration"
msgstr "Trvání"

msgid "EntryPoint"
msgstr "EntryPoint"

