msgstr "DOPORUČENO APLIKACÍ GOOGLE. Kanonická adresa URL stránky článku. Zadejte položku mainEntityOfPage, je-li článek primárním tématem stránky článku."

msgid "Name (usually the headline of the article)."
msgstr "Název (obvykle nadpis článku)."

