msgid "Facets summary (Experimental)"
msgstr "Обзор фасетов (экспериментальный)"

msgid "Exposes a Facets block summary showing the current search."
msgstr "Обеспечивает доступ к обзору блока фасетов, показывая текущий поиск."

msgid "Search"
msgstr "Поиск"

msgid "Add facet summary"
msgstr "Добавить обзор фасетов"

msgid "Edit facets summary"
msgstr "Изменить обзор фасетов"

msgid "Edit"
msgstr "Изменить"

msgid "Facet Summary settings"
msgstr "Параметры обзора фасетов"

msgid "Facet"
msgstr "Фасет"

msgid "ID"
msgstr "ИД"

msgid "Name"
msgstr "Имя"

msgid "Facet source id"
msgstr "ИД источника фасета"

msgid "Processor settings"
msgstr "Параметры обработчика"

msgid "A processor"
msgstr "Обработчик"

msgid "The plugin ID of the processor"
msgstr "ИД модуля обработчика"

msgid "The processors weight for this stage"
msgstr "Вес обработчика для этого этапа"

msgid "the weight"
msgstr "вес"

msgid "Facets configuration"
msgstr "Конфигурация фасетов"

msgid "Is this facet enabled"
msgstr "Если этот фасет включен"

msgid "Label"
msgstr "Метка"

msgid "Results separator"
msgstr "Разделитель результатов"

msgid "Show count on items"
msgstr "Показывать число на элементах"

msgid "Facet Weight"
msgstr "Вес фасета"

msgid "No results behavior"
msgstr "Поведение в случае отсутствия результатов"

msgid "The text to show when there is no current search"
msgstr "Текст, показываемый, когда нет текущего поиска"

msgid "Reset facets link"
msgstr "Ссылка Сбросить фасеты"

msgid "The text to show for the reset link."
msgstr "Текст, показываемый для ссылки сброса."

msgid "Processor @id specifies a non-existing @class."
msgstr "В обработчике @id указан несуществующий класс @class."

msgid "Facet summary"
msgstr "Обзор фасетов"

msgid "Edit %label facets summary"
msgstr "Изменить обзор фасетов %label"

msgid "Enabled facets"
msgstr "Выключенные фасеты"

msgid "Separator"
msgstr "Разделитель"

msgid "Show counts"
msgstr "Показать счетчики"

msgid "Weight"
msgstr "Вес"

msgid "Select the facets to be shown in the summary block. You can reorder them."
msgstr "Выберите фасеты, которые будут показываться в блоке обзора. Их порядок можно изменить."

msgid "Weight for @title"
msgstr "Все @title"

msgid "No facets found."
msgstr "Фасеты не найдены."

msgid "Facets Summary settings"
msgstr "Параметры обзора фасетов"

msgid "%processor settings"
msgstr "Параметры %processor"

msgid "Advanced settings"
msgstr "Дополнительные параметры"

msgid "Processor order"
msgstr "Порядок обработчиков"

msgid "Weight for processor %title"
msgstr "Вес обработчика %title"

msgid "Facets Summary %name has been updated."
msgstr "Обновлен обзор фасетов %name."

msgid "Add facets summary"
msgstr "Добавить обзор фасетов"

msgid "Facets settings for %label"
msgstr "Параметры фасетов для %label"

msgid "You currently have no facet sources defined. You should start by adding a facet source before creating facets."
msgstr "В данный момент не определены источники фасетов. Перед тем как создавать фасеты, необходимо добавить источник фасета."

msgid "Facet source"
msgstr "Источник фасета"

msgid "The source where this summary will be built from."
msgstr "Источник, из которого будет формироваться данный обзор."

msgid "The administrative name used for this summary."
msgstr "Административное имя, используемое для этого обзора."

msgid "Facet Summary %name has been created. Go to the <a href=\":block_overview\">Block overview page</a> to place the new block in the desired region."
msgstr "Создан обзор фасетов %name. Перейдите на <a href=\":block_overview\">страницу Обзор блока</a>, чтобы поместить новый блок в нужную область."

msgid "Facet %name has been updated."
msgstr "Фасет %name обновлен."

msgid "Caching of view %view has been disabled."
msgstr "Кэширование представления %view выключено."

msgid "Facet Summary: :facet_summary"
msgstr "Обзор фасетов: :facet_summary"

msgid "Facets Summary"
msgstr "Обзор фасетов"

msgid "Hide Summary when Facet Source is not rendered"
msgstr "Скрыть обзор, когда источник фасета не выводится"

msgid "When checked, this facet will only be rendered when the facet source is rendered. If you want to show facets on other pages too, you need to uncheck this setting."
msgstr "Если включен, то этот фасет будет показываться только при выводе источника фасета. Если нужно, чтобы фасеты показывались и на других страницах; выключите этот параметр."

msgid "Reset"
msgstr "Сброс"

msgid "Reset facets link text"
msgstr "Текст ссылки Сбросить фасеты"

msgid "Adds reset facets link."
msgstr "Добавляет ссылку сброса фасетов."

msgid "When checked, this facet will add a link to reset enabled facets."
msgstr "Когда включен, этот фасет добавляет ссылку для сброса включенных фасетов."

msgid "Show a summary of how many results were found"
msgstr "Показывать сводку количества найденных результатов"

msgid "When checked, this will show the amount of results found."
msgstr "Если параметр включен, в нем будет отображаться число найденных результатов."

msgid "Show a summary of all selected facets"
msgstr "Показывать сводку всех выбранных фасетов"

msgid "When checked, this facet will show an imploded list of all selected facets."
msgstr "Когда включен, этот фасет показывает свернутый список всех выбранных фасетов."

msgid "Empty text"
msgstr "Пустой текст"

msgid "No results found."
msgstr "Результаты не найдены."

msgid "Show a text when there are no results"
msgstr "Показывать текст при отсутствии результатов"

msgid "Show a text when there are no results, otherwise it will hide the block."
msgstr "Показывать текст при отсутствии результатов, в противном случае блок будет скрыт."

msgid "Build stage"
msgstr "Этап компоновки"

msgid "1 result found"
msgid_plural "@count results found"
msgstr[0] "Найден 1 результат"
msgstr[1] "Найдено @count результатов"
msgstr[2] "Найдено @count результатов"

