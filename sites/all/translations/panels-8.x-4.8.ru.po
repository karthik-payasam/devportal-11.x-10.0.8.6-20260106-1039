msgid "Panels Drupal core version"
msgstr "Версия ядра Drupal для модуля Панели"

msgid "Panels requires at least Drupal core 8.3."
msgstr "Для модуля Панели требуется ядро Drupal версии 8.3 или выше."

msgid "Panels"
msgstr "Панели"

msgid "Core Panels display functions; provides no external UI, at least one other Panels module should be enabled."
msgstr "Базовые функции отображения модуля Панели. Внешний пользовательский интерфейс отсутствует, должен быть включен крайней мере еще один модуль Панели."

msgid "Use Panels Dashboard"
msgstr "Использовать сводную панель модуля Панели"

msgid "Allows a user to access the Panels Dashboard."
msgstr "Разрешает пользователю доступ к сводной панели модуля Панели."

msgid "View administrative links on Panel panes"
msgstr "Показывать административные ссылки на подпанелях панели"

msgid "Configure access settings on Panel panes"
msgstr "Настройка параметров доступа на подпанелях панели"

msgid "Access rules (often also called visibility rules) can be configured on a per-pane basis. This permission allows users to configure those settings."
msgstr "Правила доступа (также часто называемые правилами видимости) можно настраивать индивидуально для каждой подпанели. Эти права доступа позволяют пользователям настраивать данные параметры."

msgid "Configure advanced settings on Panel panes"
msgstr "Настройка дополнительных параметров на подпанелях панели"

msgid "Administer Panels layouts"
msgstr "Администрирование макетов для панелей"

msgid "Allows a user to administer exported Panels layout plugins & instances."
msgstr "Позволяет пользователю управлять экспортированными экземплярами и модулями макетов панелей."

msgid "Administer Panels styles"
msgstr "Администрирование стилей панелей"

msgid "Allows a user to administer the styles of Panel panes."
msgstr "Позволяет пользователю управлять стилями подпанелей панели."

msgid "Configure caching settings on Panels"
msgstr "Настройка параметров кэширования модуля Панели"

msgid "Allows a user to configure caching on Panels displays and panes."
msgstr "Позволяет пользователю настраивать кэширование отображений и подпанелей панели."

msgid "Use panel locks"
msgstr "Использование блокировки панелей"

msgid "Allows a user to lock and unlock panes in a panel display."
msgstr "Позволяет пользователю блокировать и разблокировать подпанели в отображении панели."

msgid "Use the Panels In-Place Editor with Page Manager"
msgstr "Использование встроенного редактора панелей с модулем Администратор страниц"

msgid "Allows users with access to the In-Place editor to administer page manager pages. This permission is only needed for users without \"use page manager\" access."
msgstr "Позволяет пользователям с доступом к встроенному редактору управлять страницами администратора страниц. Эти права доступа нужны только пользователям, у которых нет прав доступа \"использование администратора страниц\"."

