msgstr "텍스트 색깔"

msgid "Text transformation"
msgstr "텍스트 변환"

msgid "Successfully updated the existing Bootstrap layout found in \"@id\"."
msgstr "\"@id\"에 있는 기존 부트스트랩 레이아웃을 업데이트했습니다. "

msgid "Unable to update the existing Bootstrap layout found in \"@id\":"
msgstr "\"@id\"에 있는 기본 부트스트랩 레이아웃을 업데이트할 수 없습니다. "

msgid "Using layout: @layout_id (@storage_ids)"
msgstr "사용하는 레이아웃: @layout_id (@storage_ids)"

msgid "Tokens"
msgstr "토큰"

msgid "Wrapper"
msgstr "랩퍼"

msgid "Classes"
msgstr "클래스"

msgid "Add layout specific class: <code>@class</code>"
msgstr "레이아웃 특정 클래스 추가: <code>@class</code>"

msgid "Additional attributes"
msgstr "추가 속성"

msgid "Region: @region"
msgstr "지역: @region"

msgid "Add region specific classes: <code>bs-region</code> and <code>bs-region--@region</code>"
msgstr "지역 특정 클래스 추가: <code>bs-region</code> 및 <code>bs-region--@region</code>"

