msgid "Bootstrap Layouts"
msgstr "부트스트랩 레이아웃"

msgid "This module is going to generate layouts with Bootstrap grid system."
msgstr "이 모듈은 부트스트랩 그리드 시스템에서 레이아웃을 생성합니다. "

msgid "Layout"
msgstr "레이아웃"

msgid "Left"
msgstr "왼쪽"

msgid "Right"
msgstr "오른쪽"

msgid "Center"
msgstr "중앙"

msgid "Justify"
msgstr "양쪽 맞춤"

msgid "No Wrap"
msgstr "줄 바꾸기 없음"

msgid "Lowercase"
msgstr "소문자"

msgid "Uppercase"
msgstr "대문자"

msgid "Capitalize"
msgstr "대문자로 변경"

msgid "Clear Fix"
msgstr "수정사항 지우기"

msgid "Row"
msgstr "행"

msgid "Extra Small"
msgstr "초소형"

msgid "Small"
msgstr "작게"

msgid "Medium"
msgstr "중간길이 형식"

msgid "Large"
msgstr "크게"

msgid "@size: @column"
msgstr "@size: @column"

msgid "@type"
msgstr "@type"

msgid "Muted"
msgstr "음소거"

msgid "Utility"
msgstr "유틸리티"

msgid "Columns"
msgstr "열"

