msgid "Autocomplete Deluxe"
msgstr "Autocomplete Deluxe"

msgid "Enhanced autocomplete using Jquery UI autocomplete."
msgstr "Geavanceerde automatisch aanvullen met behulp van Jquery-UI."

msgid "User interface"
msgstr "Gebruikersinterface"

msgid "None"
msgstr "Geen"

msgid "The entity '@term' will be added."
msgstr "De entiteit '@term' wordt toegevoegd."

msgid "No terms could be found. Please type in order to add a new term."
msgstr "Er zijn geen termen gevonden. Typ iets om een nieuwe term toe te voegen."

msgid "No results found"
msgstr "Geen resultaat gevonden"

msgid "Autocomplete Deluxe widget settings"
msgstr "Deluxe-widgetinstellingen automatisch aanvullen"

msgid "Match Operator"
msgstr "Operator matchen"

msgid "Route Name"
msgstr "Routenaam"

msgid "Size"
msgstr "Grootte"

msgid "Selection Handler"
msgstr "Selectiehandler"

msgid "Limit"
msgstr "Limiet"

msgid "Min Length"
msgstr "Mininumlengte"

msgid "Delimiter"
msgstr "Scheidingsteken"

msgid "Allow \"Not Found\" message"
msgstr "Bericht \"Niet gevonden\" toestaan"

msgid "\"Not Found\" Message"
msgstr "Bericht \"Niet gevonden\" Message"

msgid "Allow New Terms"
msgstr "Nieuwe termen toestaan"

msgid "No Empty Message"
msgstr "Geen leeg bericht"

msgid "Match operator"
msgstr "Match-operator"

msgid "Specify the matcting operator."
msgstr "Geef de overeenkomende operator op."

msgid "Limit of the output."
msgstr "Limiet van de uitvoer."

msgid "If set to zero no limit will be used"
msgstr "Als deze waarde is ingesteld op nul, wordt er geen limiet gebruikt"

msgid "Minimum length."
msgstr "Minimumlengte."

msgid "The minimum length of characters to enter to open the suggestion list."
msgstr "De minimumlengte van de tekens die moet worden ingevoerd om de suggestielijst te openen."

msgid "Delimiter."
msgstr "Scheidingsteken."

msgid "A character which should be used beside the enter key, to separate terms."
msgstr "Een teken dat naast de Enter-toets moet worden gebruikt om termen te scheiden."

msgid "Show Term not found message"
msgstr "Bericht Term niet gevonden afbeelden"

msgid "If this is enabled, a message will be displayed when the term is not found."
msgstr "Als dit is ingeschakeld wordt er een bericht afgebeeld als de term niet gevonden is. "

msgid "Term not found message."
msgstr "Bericht Term niet gevonden."

msgid "A message text which will be displayed, if the entered term was not found."
msgstr "Een berichttekst die wordt afgebeeld als de opgegeven term niet is gevonden."

msgid "Allow new terms"
msgstr "Nieuwe termen toestaan"

msgid "Should it be allowed, that user enter new terms?"
msgstr "Moet het worden toegestaan dat de gebruiker nieuwe termen invoert?"

msgid "Empty value message."
msgstr "Bericht met lege waarde."

msgid "A text message that will be displayed when the field is focused and it does not contain values."
msgstr "Een tekstbericht dat wordt afgebeeld wanneer het veld in focus is en geen waarden bevat."

msgid "Match operator: @match_operator"
msgstr "Stem operator af: @match_operator"

msgid "Limit: @limit"
msgstr "Limiet: @limit"

msgid "Min length: @min_length"
msgstr "Minimumlengte: @min_length"

msgid "Delimiter: @delimiter"
msgstr "Scheidingsteken: @delimiter"

msgid "Allow Not Found message: @not_found_message_allow"
msgstr "Bericht Niet gevonden toestaan: @not_found_message_allow"

msgid "Not Found message: @not_found_message"
msgstr "Bericht Niet gevonden: @not_found_message"

msgid "Allow new terms: @new_terms"
msgstr "Nieuwe termen toestaan: @new_terms"

msgid "Empty value message: @no_empty_message"
msgstr "Bericht Lege waarde: @no_empty_message"

msgid "@not_found_message"
msgstr "@not_found_message"

msgid "@no_empty_message"
msgstr "@no_empty_message"

msgid "Starts with"
msgstr "Begint met"

msgid "Contains"
msgstr "Bevat"

