msgid "Ignoring alias %alias because it is the same as the internal path."
msgstr "Игнорируется синоним %alias, потому что он такой же, как и внутренний путь."

msgid "Created new alias %alias for %source, replacing %old_alias."
msgstr "Создан новый синоним %alias для %source, заменивший %old_alias."

msgid "Created new alias %alias for %source."
msgstr "Создан новый синоним %alias для %source."

msgid "The automatically generated alias %original_alias conflicted with an existing alias. Alias changed to %alias."
msgstr "Автоматически сформированный %original_alias конфликтует с существующим адресом. Синоним изменён на %alias."

msgid "Pathauto state"
msgstr "Состояние Pathauto"

msgid "Whether an automated alias should be created or not."
msgstr "Указывает, должен ли создаваться автоматический псевдоним."

msgid "Conditions"
msgstr "Условия"

msgid "Duplicate"
msgstr "Дубликат"

msgid "Uncheck this to create a custom alias below. <a href=\"@admin_link\">Configure URL alias patterns.</a>"
msgstr "Снимите флажок, чтобы создать псевдоним URL вручную. <a href=\"@admin_link\">Настройки шаблонов URL-синонимов.</a>"

msgid "Uncheck this to create a custom alias below."
msgstr "Снимите флажок, чтобы создать псевдоним URL вручную."

msgid "Generate automatic URL alias"
msgstr "Создать синоним URL автоматически"

msgid "Bulk updating URL aliases"
msgstr "Массовое обновление псевдонимов URL"

msgid "Bulk deleting URL aliases"
msgstr "Массовое удаления URL синонимов"

msgid "All of your path aliases have been deleted."
msgstr "Все ваши синонимы путей были удалены."

msgid "All of your %label path aliases have been deleted."
msgstr "Удалены все псевдонимы пути %label."

msgid "Choose the action to perform."
msgstr "Выберите действие для выполнения."

msgid "Choose the alias type(s). Separate multiple choices with commas, e.g. \"1,2,4\", or choose \"0\" for all types."
msgstr "Выберите типы псевдонимов. Перечислите несколько вариантов через запятую (например \"1,2,4\") или выберите \"0\" для всех типов."

msgid "Invalid action argument \"@invalid_action\". Please use one of: @valid_actions"
msgstr "Недопустимый аргумент действия \"@invalid_action\". Укажите одно из следующих значений: @valid_actions"

msgid "Invalid type argument \"@invalid_types\". Please choose from the following: @valid_types"
msgstr "Недопустимый аргумент типа \"@invalid_types\". Укажите одно из следующих значений: @valid_types"

msgid "Generate a URL alias for un-aliased paths only."
msgstr "Генерировать псевдоним URL только для путей без псевдонимов."

msgid "Update the URL alias for paths having an old URL alias."
msgstr "Обновить псевдоним URL для путей со старым псевдонимом URL."

msgid "Regenerate URL aliases for all paths."
msgstr "Повторное создание псевдонимов URL для всех путей."

msgid "Pathauto pattern"
msgstr "Шаблон Pathauto"

msgid "Choose aliases to delete"
msgstr "Выберите синонимы для удаления"

msgid "All aliases"
msgstr "Все синонимы"

msgid "Delete all aliases. Number of aliases which will be deleted: %count."
msgstr "Удалить все синонимы. Количество синонимов, которые будут удалены: %count."

msgid "Delete aliases for all @label. Number of aliases which will be deleted: %count."
msgstr "Удалить синонимы для всех @label. Число синонимов, которые будут удалены: %count."

msgid "Delete options"
msgstr "Опции удаления"

msgid "Only delete automatically generated aliases"
msgstr "Удалять только автоматически сгенерированные псевдонимы"

msgid "When checked, aliases which have been manually set are not affected by this mass-deletion."
msgstr "Когда выбрано, псевдонимы, установленные вручную, не будут затронуты этим массовым удалением."

msgid "<strong>Note:</strong> there is no confirmation. Be sure of your action before clicking the \"Delete aliases now!\" button.<br />You may want to make a backup of the database and/or the path_alias and path_alias_revision tables prior to using this feature."
msgstr "<strong>Помните:</strong> действие невозможно отменить. Убедитесь в правильности своих действий до того, как нажмёте кнопку \"Удалить синонимы!\".<br />Если не уверены в правильности действий, сделайте резервную копию таблиц path_alias и path_alias_revision или всей БД."

msgid "Delete aliases now!"
msgstr "Удалить синонимы сейчас!"

msgid "All of your automatically generated path aliases have been deleted."
msgstr "Удалены все автоматически созданные псевдонимы пути."

msgid "All of your automatically generated %label path aliases have been deleted."
msgstr "Удалены все автоматически созданные псевдонимы пути %label."

msgid "An error occurred while processing @operation with arguments : @args"
msgstr "Возникла ошибка в процессе @operation с аргументами: @args"

msgid "Select the types of paths for which to generate URL aliases"
msgstr "Выберите типы путей, для которых нужно создать псевдонимы URL."

msgid "Select which URL aliases to generate"
msgstr "Выберите, какие псевдонимы URL генерировать"

msgid "Generate a URL alias for un-aliased paths only"
msgstr "Генерировать псевдоним URL только для путей без псевдонимов"

msgid "<a href=\":url\">Pathauto settings</a> are set to ignore paths which already have a URL alias. You can only create URL aliases for paths having none."
msgstr "В <a href=\":url\">параметрах Pathauto</a> указано игнорировать пути, у которых уже есть псевдоним URL. Псевдонимы URL можно создавать только для путей, у которых нет псевдонимов."

msgid "Update the URL alias for paths having an old URL alias"
msgstr "Обновить псевдоним URL для путей со старым псевдонимом URL"

msgid "Regenerate URL aliases for all paths"
msgstr "Повторное создание псевдонимов URL для всех путей"

msgid "Update"
msgstr "Обновить"

msgid "No new URL aliases to generate."
msgstr "Новые синонимы URL не созданы."

msgid "Generated 1 URL alias."
msgid_plural "Generated @count URL aliases."
msgstr[0] "Создан 1 псевдоним."
msgstr[1] "Создано @count псевдонима."
msgstr[2] "Создано @count псевдонимов."

msgid "Enable to add a path field and allow to define alias patterns for the given type. Disabled types already define a path field themselves or currently have a pattern."
msgstr "Включите, чтобы добавить поле пути и разрешить определять шаблоны псевдонимов для данного типа. Отключенные типы уже сами определяют поле пути или в настоящее время имеют шаблон."

msgid "Verbose"
msgstr "Подробности"

msgid "Display alias changes (except during bulk updates)."
msgstr "Показать изменения синонимов (кроме пакетного обновления)"

msgid "Separator"
msgstr "Разделитель"

msgid "Character used to separate words in titles. This will replace any spaces and punctuation characters. Using a space or + character can cause unexpected results."
msgstr "Символ, разделяющий слова в заголовках. Им заменяются все пробелы и символы пунктуации. Использование пробела или символа + может привести к непредвиденным результатам."

msgid "Character case"
msgstr "Регистр символов"

msgid "Convert token values to lowercase."
msgstr "Конвертировать значения токенов в нижний регистр."

msgid "See <a href=\":pathauto-help\">Pathauto help</a> for details."
msgstr "Смотри подробности в<a href=\":pathauto-help\">справке Pathauto</a>."

msgid "Maximum alias length"
msgstr "Максимальная длина синонима"

msgid "Maximum length of aliases to generate. 100 is the recommended length. @max is the maximum possible length."
msgstr "Максимальная длина создаваемых псевдонимов. Рекомендуется длина 100. Максимально возможная длина - @max."

msgid "Maximum component length"
msgstr "Максимальная длина компонента"

msgid "Maximum text length of any component in the alias (e.g., [title]). 100 is the recommended length. @max is the maximum possible length."
msgstr "Максимальная длина текста любого компонента в псевдониме, например [title]. Рекомендуется длина 100. Максимально возможная длина - @max."

msgid "What should Pathauto do when updating an existing content item which already has an alias?"
msgstr "Выберите действие, которое будет использовать модуль Pathauto в том случае, когда альтернативный адрес уже существует."

msgid "The <a href=\":url\">Redirect module settings</a> affect whether a redirect is created when an alias is deleted."
msgstr "<a href=\":url\">Перенаправление параметров модуля</a> влияет на то, будет ли создано перенаправление при удалении псевдонима."

msgid "Considering installing the <a href=\":url\">Redirect module</a> to get redirects when your aliases change."
msgstr "Рекомендуется установить <a href=\":url\">модуль Перенаправление</a> для получения перенаправлений при изменении псевдонимов."

msgid "Update action"
msgstr "Действие при обновлении"

msgid "Do nothing. Leave the old alias intact."
msgstr "Ничего не делать. Оставить старый синоним нетронутым."

msgid "Create a new alias. Leave the existing alias functioning."
msgstr "Создать новый синоним. Оставить существующий синоним рабочим."

msgid "Create a new alias. Delete the old alias."
msgstr "Создать новый синоним. Удалить старый синоним."

msgid "Transliterate prior to creating alias"
msgstr "Транслитерировать перед созданием синонима"

msgid "When a pattern includes certain characters (such as those with accents) should Pathauto attempt to transliterate them into the US-ASCII alphabet?"
msgstr "Когда шаблон содержит определенные символы (например, символы с диакритическими знаками), должен ли Pathauto транслитерировать их в набор символов US-ASCII?"

msgid "Reduce strings to letters and numbers"
msgstr "Сокращать строки до букв и цифр"

msgid "Filters the new alias to only letters and numbers found in the ASCII-96 set."
msgstr "Отметьте это поле, чтобы при транслитерации из адресов исключались знаки, не входящие в ASCII-96."

msgid "Strings to Remove"
msgstr "Строки для удаления"

msgid "Words to strip out of the URL alias, separated by commas. Do not use this to remove punctuation."
msgstr "Слова для исключения из путей, разделенные запятыми. Не используйте это поле для удаления знаков пунктуации."

msgid "Safe tokens"
msgstr "Безопасные токены"

msgid "List of tokens that are safe to use in alias patterns and do not need to be cleaned. For example urls, aliases, machine names. Separated with a comma."
msgstr "Список маркеров, которые можно безопасно использовать в шаблонах псевдонимов и для которых не требуется очистка. Пример: URL, псевдонимы, имена систем. Разделенные запятыми."

msgid "Punctuation"
msgstr "Пунктуация"

msgid "Remove"
msgstr "Удалить"

msgid "Replace by separator"
msgstr "Заменять разделителем"

msgid "No action (do not replace)"
