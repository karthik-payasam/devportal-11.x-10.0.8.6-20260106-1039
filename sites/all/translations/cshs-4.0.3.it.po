msgid "Client-side Hierarchical Select"
msgstr "Selezione gerarchica lato client"

msgid "A simple client-side hierarchical select widget for taxonomy terms."
msgstr "Un semplice widget di selezione gerarchica lato client per i termini della tassonomia."

msgid "Widgets"
msgstr "Widget"

msgid "CSHS field widget settings"
msgstr "Impostazioni widget campo CSHS"

msgid "Save lineage"
msgstr "Salva genealogia"

msgid "Force selection of deepest level"
msgstr "Forza la seleziona del livello più profondo"

msgid "Parent"
msgstr "Genitore"

msgid "Labels per hierarchy-level"
msgstr "Etichette per livello della gerarchia"

msgid "Hierarchy depth"
msgstr "Profondità della gerarchia"

msgid "Required depth"
msgstr "Profondità obbligatoria"

msgid "The \"no selection\" label"
msgstr "L'etichetta \"nessuna selezione\""

msgid "Client-side Hierarchical Select: Menu Link"
msgstr "Selezione gerarchica lato client: Collegamento al menu  "

msgid "A client-side hierarchical selection of parents for the menu link. Works for node and term forms (with \"taxonomy_menu_ui\" enabled)."
msgstr "Una selezione gerarchica lato client degli elementi principali del collegamento al menu. Si applica ai moduli dei nodi e dei termini (con \"taxonomy_menu_ui\" abilitato)."

msgid "Deepest"
msgstr "Più profondo"

msgid "None"
msgstr "Nessuno"

msgid "Yes"
msgstr "Sì"

msgid "No"
msgstr "No"

msgid "Parent: @parent"
msgstr "Principale: @parent"

msgid "Force deepest: @force_deepest"
msgstr "Forza più profondo: @force_deepest"

msgid "Save lineage: @save_lineage"
msgstr "Salva derivazione: @save_lineage"

msgid "Level labels: @level_labels"
msgstr "Etichette del livello: @level_labels"

msgid "The \"no selection\" label: @none_label"
msgstr "L'etichetta \"nessuna selezione\": @none_label"

msgid "Select a parent term to use only a subtree of a vocabulary for this field."
msgstr "Selezionare un termine parent per utilizzare solo una sottostruttura di un vocabolario per questo campo."

msgid "Force the deepest level selection"
msgstr "Forza la selezione del livello più profondo"

msgid "If checked the user will be forced to select terms from the deepest level."
msgstr "Se si seleziona questa opzione l'utente verrà obbligato a selezionare i termini dal livello più profondo."

msgid "Enter labels for each hierarchy-level separated by comma."
msgstr "Immettere etichette separate da virgola per ciascun livello gerarchico."

msgid "The label for an empty option."
msgstr "L'etichetta per un'opzione vuota."

msgid "The hierarchy depth cannot be @actual because the selection list has @levels levels."
msgstr "La profondità della gerarchia non può essere @actual perché l'elenco di selezione ha i livelli @levels."

msgid "The required depth cannot be greater than the hierarchy depth."
msgstr "La profondità richiesta non può essere maggiore della profondità della gerarchia."

msgid "Format"
msgstr "Formato"

msgid "Specify a format for each field item by using tokens."
msgstr "Specificare un formato per ciascun elemento del campo utilizzando i token."

msgid "Clear Tokens"
msgstr "Cancella token"

msgid "Remove token from final text if no replacement value is generated"
msgstr "Rimuovi token dal testo finale se non viene generato alcun valore di sostituzione"

msgid "Format: @format"
msgstr "Formato: @format"

msgid "Flexible hierarchy"
msgstr "Gerarchia flessibile"

msgid "Allows to specify the output with tokens."
msgstr "Consente di specificare l'output con i token."

msgid "Link to term page"
msgstr "Link alla pagina del termine"

msgid "Reverse order view"
msgstr "Vista con ordine inverso"

msgid "Outputs hierarchy in reverse order (the deepest level first)."
msgstr "La gerarchia degli output in ordine inverso (il primo livello è il più profondo)."

msgid "Linked to term page: @linked"
msgstr "Collegato alla pagina dei termini: @linked"

msgid "Reverse order view: @reverse"
msgstr "Vista con ordine inverso: @reverse"

msgid "Separator"
msgstr "Separatore"

msgid "Specify a separator which will be placed in between the different hierarchy levels."
msgstr "Specificare un separatore che verrà inserito tra i diversi livelli gerarchici."

msgid "Separator: @separator"
msgstr "Separatore: @separator"

msgid "Full hierarchy"
msgstr "Gerarchia completa"

msgid "Display the full hierarchy of the taxonomy term."
msgstr "Visualizza la gerarchia completa dei termini di tassonomia."

msgid "Sorting"
msgstr "Ordinamento"

msgid "Depth"
msgstr "Profondità"

msgid "The maximum hierarchy depth. Use 0 to not limit or 1 to display just the root term (or the last if reverse order selected)."
msgstr "La profondità massima della gerarchia. Utilizzare 0 per non limitare o 1 per visualizzare solo il termine root (o l'ultimo, se viene selezionato l'ordine inverso)."

msgid "Last child"
msgstr "Ultimo elemento secondario"

msgid "Show only the root term and its deepest child."
msgstr "Mostra solo il termine root e l'elemento secondario più profondo."

msgid "Sorting: @value"
msgstr "Ordinamento: @value"

msgid "Depth: @value"
msgstr "Profondità: @value"

msgid "Last child only"
msgstr "Solo ultimo elemento secondario"

msgid "Unlimited"
msgstr "Nessun limite"

msgid "Hierarchy grouped by root"
msgstr "Gerarchia raggruppata per root"

msgid "Display the hierarchy of the taxonomy term grouped by root."
msgstr "Visualizza la gerarchia del termine di tassonomia raggruppati per root."

msgid "Client-side hierarchical select"
msgstr "Selezione gerarchica lato client"

msgid "An invalid vocabulary is selected. Please change it in the options."
msgstr "È stato selezionato un vocabolario non valido. Si prega di modificarlo nelle opzioni."

msgid "About"
msgstr "Informazioni"

msgid "Settings"
msgstr "Impostazioni"

msgid "Multi-lingual"
msgstr "Multilingua"

msgid "Supports multi-lingual terms localized with i18n_taxonomy module (Which is part of the i18n package)."
msgstr "Supporta termini multilingua con il modulo i18n_taxonomy (che fa parte del package i18n)."

