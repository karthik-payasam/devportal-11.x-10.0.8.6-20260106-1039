msgstr "Restablecer"

msgid "Create customized flags that users can set on entities."
msgstr "Crear marcas personalizadas que los usuarios puedan poner a las entidades."

msgid "Add flag"
msgstr "Añadir distintivo"

msgid "Configure flags for marking content with arbitrary information (such as <em>offensive</em> or <em>bookmarked</em>)."
msgstr "Configurar marcas de contenido con información arbitraria (por ejemplo, <em>ofensivo</em> o <em>marcado</em> (en bookmark))."

