msgid "Lists registered library information."
msgstr "Kayıtlı kitaplık bilgilerini listeler."

msgid ""
"Downloads a registered library into the libraries directory for the active site.\n"
"\n"
"See libraries-list for a list of registered libraries."
msgstr ""
"Kayıtlı kitaplık bilgilerini etkin sitenin kitaplıklar dizinine yükler.\n"
"\n"
"Kayıtlı kitaplıklar listesi için kitaplıklar listesine bakın."

msgid "Name"
msgstr "İsim"

msgid "Status"
msgstr "Durum"

msgid "Version"
msgstr "Sürüm"

msgid "Variants"
msgstr "Değişkeler"

msgid "Dependencies"
msgstr "Bağımlılıklar"

msgid "OK"
msgstr "Tamam"

msgid "Missing dependency: unzip. Install it before using this command."
msgstr "Eksik bağımlılık: unzip. Bu komutu kullanmadan önce bunu kurun."

msgid "Directory @path was created"
msgstr "@path dizini oluşturuldu"

msgid "A existing Colorbox plugin was overwritten at @path"
msgstr "Var olan Colorbox eklentisinin @path yolunda üzerine yazıldı"

msgid "Colorbox plugin has been downloaded to @path"
msgstr "Colorbox eklentisi @path yoluna yüklendi"

msgid "Drush was unable to download the Colorbox plugin to @path"
msgstr "Drush, Colorbox eklentisini @path yoluna yükleyemedi"

msgid "The %dependency library, which the %library library depends on, is not installed."
msgstr "%library kitaplığının bağlı olduğu %dependency kitaplığı kurulu değil."

msgid "The version %dependency_version of the %dependency library is not compatible with the %library library."
msgstr "%dependency kitaplığının %dependency_version sürümü %library kitaplığıyla uyumlu değil."

msgid "The %library library could not be found."
msgstr "%library kitaplığı bulunamadı."

msgid "The version of the %library library could not be detected."
msgstr "%library kitaplığının sürümü saptanamadı."

msgid "The installed version %version of the %library library is not supported."
msgstr "%library kitaplığının kurulu %version sürümü desteklenmiyor."

msgid "The %variant variant of the %library library could not be found."
msgstr "%library kitaplığının %variant değişkeni bulunamadı."

msgid "The following external libraries could not successfully be registered with Drupal core: @libs. See earlier log entries for more details. Once these issues are addressed please be sure to clear your Drupal library cache to ensure external library detection is run again."
msgstr "Aşağıdaki dış kitaplıklar Drupal çekirdeğine başarıyla kaydedilemedi: @libs. Ayrıntılar için daha önceki günlük girdilerine bakın. Bu sorunlar ele alındığında lütfen dış kitaplık saptamasının yeniden yapılmasını sağlamak için Drupal kitaplığı önbelleğinizi temizlediğinizden emin olun."

msgid "Libraries"
msgstr "Kütüphaneler"

msgid "Allows version-dependent and shared usage of external libraries."
msgstr "Dış kitaplıkların sürüme bağlı ve ortak kullanımına izin verir."

msgid "Libraries API settings"
msgstr "Kitaplıklar API'si ayarları"

msgid "Library definition settings"
msgstr "Kitaplık tanımı ayarları"

msgid "Local"
msgstr "Yerel"

msgid "Local path"
msgstr "Yerel yol"

msgid "Enable remote fetching of library definitions"
msgstr "Kitaplık tanımlarının uzaktan getirilmesini sağla"

msgid "A list of remote library registry URLs"
msgstr "Uzak kitaplık kaydı URL'lerinin listesi"

msgid "The URL of a remote library registry"
msgstr "Uzak kitaplık kaydı URL'si"

msgid "URI locator configuration"
msgstr "URI bulucu yapılandırması"

msgid "The locator URI"
msgstr "Bulucu URI'si"

msgid "Assets"
msgstr "Varlıklar"

msgid "Provides access to asset library files."
msgstr "Varlık kitaplık dosyalarına erişim sağlar."

msgid "Library definitions"
msgstr "Kitaplık tanımları"

msgid "Provides access to library definition files."
msgstr "Kitaplık tanımı dosyalarına erişim sağlar."

msgid "PHP library files"
msgstr "PHP kitaplık dosyaları"

msgid "Provides access to PHP library files."
msgstr "PHP kitaplık dosyalarına erişim sağlar."

