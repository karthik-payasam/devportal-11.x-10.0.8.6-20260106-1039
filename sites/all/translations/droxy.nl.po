msgid "About"
msgstr "Over"

msgid "Drupal Proxy Module"
msgstr "Drupal-proxymodule"

msgid "Drupal Proxy"
msgstr "Drupal Proxy"

msgid "Proxy"
msgstr "Proxy"

msgid "Proxy Settings"
msgstr "Proxy-instellingen"

msgid "ProxySettingForm"
msgstr "ProxySettingForm"

msgid "Https or Https"
msgstr "Https of Https"

msgid "type of Scheme"
msgstr "type schema"

msgid "Proxy Server"
msgstr "Proxyserver"

msgid "The IP address or hostname of the proxy server."
msgstr "Het IP-adres of de hostnaam van de proxyserver."

msgid "Port"
msgstr "Poort"

msgid "The port number used by the proxy server for client connections."
msgstr "Het poortnummer dat door de proxyserver wordt gebruikt voor clientverbindingen."

msgid "Proxy Username"
msgstr "Gebruikersnaam proxy"

msgid "A username used of proxy server for Authentication."
msgstr "Een gebruikersnaam die wordt gebruikt voor verificatie bij de proxyserver."

msgid "Proxy Password"
msgstr "Wachtwoord proxy"

msgid "Password of proxy server used for Authentication."
msgstr "Wachtwoord voor de proxyserver ter verificatie."

msgid "Proxy User Agent"
msgstr "Proxy-gebruikersagent"

msgid "A string which can be used by the proxy server to identify connection requests."
msgstr "Een tekenreeks die door de proxyserver kan worden gebruikt voor het identificeren van verbindingsaanvragen."

msgid "Proxy Exceptions"
msgstr "Proxy-uitzonderingen"

msgid "Specify exceptions using either IP addresses or hostnames. Enter one exception per line. Exceptions will be accessed directly, not via proxy."
msgstr "Geef uitzonderingen op met behulp van IP-adressen of hostnamen. Geef één uitzondering per regel op. Uitzonderingen worden direct benaderd, niet via een proxy."

