msgstr "Informace"

msgid "This module enables tokens for all entity types that has <kbd>voting_api_field</kbd>."
msgstr "Tento modul povoluje tokeny pro všechny typy entit, které mají <kbd>voting_api_field</kbd>."

msgid "Usage"
msgstr "Použití"

msgid "Tokens are dynamic and you have to pass <emph>vote_type</emph> as the last parameter. Module defines four tokens:"
msgstr "Tokeny jsou dynamické a vy musíte předat <emph>vote_type</emph> jako poslední parametr. Modul definuje čtyři tokeny:"

msgid "<ul><li>Vote count :: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"
msgstr "<ul><li>Počet hlasů :: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"

msgid "<li>Vote average :: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"
msgstr "<li>Průměr hlasování :: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"

msgid "<li>Best vote :: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"
msgstr "<li>Nejlepší hlas :: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"

msgid "<li>Worst vote :: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"
msgstr "<li>Nejhorší hlas :: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"

msgid "Voting API Tokens"
msgstr "Tokeny rozhraní API hlasování"

