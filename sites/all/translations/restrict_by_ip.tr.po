msgid "Restrict by IP settings"
msgstr "IP ayarlarına göre kısıtla"

msgid "Enter IP Address Ranges in CIDR Notation separated with semi-colons, with no trailing semi-colon. E.G. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />For more information on CIDR notation <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\" target=\"_blank\">click here</a>.<br /><strong>Leave field empty to disable IP restrictions for this user.</strong>"
msgstr "Sonda noktalı virgül olmadan, noktalı virgülle ayrılmış CIDR Gösteriminde IP Adresi Aralıklarını Girin. ÖRN. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />CIDR gösterimiyle ilgili daha fazla bilgi için <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\" target=\"_blank\">burayı tıklatın</a>.<br /><strong>Bu kullanıcı için IP kısıtlamalarını devre dışı bırakmak üzere alanı boş bırakın.</strong>"

msgid "Restrict By IP"
msgstr "IP'ye göre kısıtla"

msgid "Enables limiting user login and role access to specific IP Addresses."
msgstr "Kullanıcı oturum açma ve rol erişimini belirli IP Adresleriyle sınırlamayı etkinleştirir."

msgid "Access control"
msgstr "Erişim denetimi"

msgid "Restrict by IP"
msgstr "IP'ye göre kısıtla"

msgid "General settings for Restrict by IP module."
msgstr "IP'ye göre kısıtlama modülü için genel ayarlar."

msgid "General Settings"
msgstr "Genel Ayarlar"

msgid "Restrict login by IP"
msgstr "Oturum açmayı IP'ye göre kısıtla"

msgid "Global Restrictions"
msgstr "Genel Kısıtlamalar"

msgid "User restrictions"
msgstr "Kullanıcı kısıtlamaları"

msgid "Restrict role by IP"
msgstr "Rolü IP'ye göre kısıtla"

msgid "Administer restrict by ip"
msgstr "IP'ye göre kısıtlamayı yönet"

msgid "Create, edit and delete rules for restricted IP login."
msgstr "Kısıtlı IP ile oturum açma için kuralları oluşturun, düzenleyin ve silin."

msgid "Server header to check for user IP address"
msgstr "Kullanıcı IP adresini denetlemek için sunucu üstbilgisi"

msgid "Page user is redirected to when login is denied"
msgstr "Oturum açma reddedildiğinde kullanıcının yönlendirileceği sayfa"

msgid "Global IP address login restrictions"
msgstr "Genel IP adresi oturum açma kısıtlamaları"

msgid "User level IP address login restrictions"
msgstr "Kullanıcı düzeyi IP adresi oturum açma kısıtlamaları"

msgid "Role level IP address grant restrictions"
msgstr "Rol düzeyinde IP adresi vermeyle ilgili kısıtlamalar"

msgid "Dependencies"
msgstr "Bağımlılıklar"

msgid "Login denied from @ip for %name."
msgstr "%name için @ip adresinden oturum açma reddedildi."

msgid "Header to check"
msgstr "Denetlenecek üstbilgi"

msgid "This is the HTTP request header that contains the client IP Address. It is sometimes re-written by reverse proxies and Content Distribution Networks."
msgstr "Bu, istemci IP Adresini içeren HTTP isteği üstbilgisidir. Bazen ters yetkili sunucular ve İçerik Dağıtımı Ağları tarafından yeniden yazılır."

msgid "Your current IP address is %ipaddress. If this is wrong, make sure you have the correct header configured in general settings."
msgstr "Geçerli IP adresiniz %ipaddress. Bu hatalıysa genel ayarlarda doğru üstbilginin yapılandırıldığından emin olun."

msgid "Login denied error page"
msgstr "Oturum açma reddedildi hata sayfası"

msgid "This the address of the page to which the user will be redirected if they are not allowed to login. If you don't set this the user will not know why they couldn't login."
msgstr "Oturum açmasına izin verilmediğinde kullanıcının yönlendirileceği sayfanın adresidir. Bunu ayarlamazsanız, kullanıcı neden oturum açamadığını bilemez."

msgid "Restrict global login to allowed IP range"
msgstr "Genel oturum açmayı izin verilen IP aralığıyla kısıtla"

msgid "To restrict login for ALL users, enter global IP Address Ranges in CIDR Notation separated with semi-colons, with no trailing semi-colon. E.G. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />For more information on CIDR notation click <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\">here</a>.<br />Leave field blank to disable IP restrictions for user login."
msgstr "TÜM kullanıcılar için oturum açmayı kısıtlamak üzere genel IP Adresi Aralıklarını sonda noktalı virgül olmadan, noktalı virgülle ayrılmış CIDR Gösteriminde girin. ÖRN. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />CIDR gösterimi hakkında daha fazla bilgi için <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\">burayı</a> tıklatın.<br />Kullanıcı oturum açma işlemlerinde IP kısıtlamalarını devre dışı bırakmak için alanı boş bırakın."

msgid "No roles configured. <a href=\"@add-role\">Add a role</a>."
msgstr "Kural yapılandırılmadı. <a href=\"@add-role\">Bir rol ekleyin</a>."

msgid "@role-label role IP range"
msgstr "@role-label rolü IP aralığı"

msgid "Add new user allowed IP range"
msgstr "Yeni kullanıcı için izin verilen IP aralığı ekle"

msgid "Username"
msgstr "Kullanıcı adı"

msgid "Allowed IP range"
msgstr "İzin verilen IP aralığı"

msgid "Enter IP Address Ranges in CIDR Notation separated with semi-colons, with no trailing semi-colon. E.G. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />For more information on CIDR notation click <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\">here</a>."
msgstr "Sonda noktalı virgül olmadan, noktalı virgülle ayrılmış CIDR Gösteriminde IP Adresi Aralıklarını Girin. ÖRN. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />CIDR gösterimi hakkında daha fazla bilgi için <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\">burayı</a> tıklatın."

msgid "@name user IP range"
msgstr "@name kullanıcı IP aralığı"

msgid "Enter IP Address Ranges in CIDR Notation separated with semi-colons, with no trailing semi-colon. E.G. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />For more information on CIDR notation click <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\">here</a>.<br />Leave field blank to disable IP restrictions for @name."
msgstr "Sonda noktalı virgül olmadan, noktalı virgülle ayrılmış CIDR Gösteriminde IP Adresi Aralıklarını Girin. ÖRN. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />CIDR gösterimi hakkında daha fazla bilgi için <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\">burayı</a> tıklatın.<br />@name için IP kısıtlamalarını devre dışı bırakmak üzere alanı boş bırakın."

msgid "Restriction for that user already exist."
msgstr "Bu kullanıcı için zaten bir kısıtlama var."

