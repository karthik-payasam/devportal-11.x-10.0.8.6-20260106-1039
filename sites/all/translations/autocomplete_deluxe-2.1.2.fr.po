msgid "Autocomplete Deluxe"
msgstr "Autocomplétion Deluxe"

msgid "Enhanced autocomplete using Jquery UI autocomplete."
msgstr "Amélioration de la saisie semi-automatique à l'aide de la saisie semi-automatique de Jquery UI."

msgid "User interface"
msgstr "Interface utilisateur"

msgid "None"
msgstr "Aucun(e)"

msgid "The entity '@term' will be added."
msgstr "L'entité '@term' sera ajoutée."

msgid "No terms could be found. Please type in order to add a new term."
msgstr "Aucun terme n'a pu être trouvé. Merci de saisir afin d'ajouter un nouveau terme."

msgid "No results found"
msgstr "Aucun résultat trouvé"

msgid "Autocomplete Deluxe widget settings"
msgstr "Paramètres du widget Autocomplete Deluxe"

msgid "Match Operator"
msgstr "Match Operator"

msgid "Route Name"
msgstr "Nom de la route"

msgid "Size"
msgstr "Taille"

msgid "Selection Handler"
msgstr "Gestionnaire de sélection"

msgid "Limit"
msgstr "Limite"

msgid "Min Length"
msgstr "Longueur minimale"

msgid "Delimiter"
msgstr "Délimiteur"

msgid "Allow \"Not Found\" message"
msgstr "Autoriser le message \"Introuvable\""

msgid "\"Not Found\" Message"
msgstr "Message \"Introuvable\""

msgid "Allow New Terms"
msgstr "Autoriser les nouveaux termes"

msgid "No Empty Message"
msgstr "Aucun message vide"

msgid "Match operator"
msgstr "Opérateur de mise en correspondance"

msgid "Specify the matcting operator."
msgstr "Spécifier l'opérateur de correspondance."

msgid "Limit of the output."
msgstr "Limite du rendu."

msgid "If set to zero no limit will be used"
msgstr "S'il est défini à zéro, aucune limite ne sera utilisée"

msgid "Minimum length."
msgstr "Longueur minimale."

msgid "The minimum length of characters to enter to open the suggestion list."
msgstr "La longueur minimale de caractères à saisir pour ouvrir la liste de suggestions."

msgid "Delimiter."
msgstr "Délimiteur."

msgid "A character which should be used beside the enter key, to separate terms."
msgstr "Un caractère qui doit être utilisé à côté de la touche entrée, pour séparer les termes."

msgid "Show Term not found message"
msgstr "Afficher le message de Terme introuvable"

msgid "If this is enabled, a message will be displayed when the term is not found."
msgstr "Si cette option est activée, un message s'affichera lorsque le terme n'est pas trouvé."

msgid "Term not found message."
msgstr "Message pour terme introuvable."

msgid "A message text which will be displayed, if the entered term was not found."
msgstr "Un message textuel qui s'affichera si le terme saisi n'a pas été trouvé."

msgid "Allow new terms"
msgstr "Autoriser les nouveaux termes"

msgid "Should it be allowed, that user enter new terms?"
msgstr "S-il est autorisé que l'utilisateur saisisse de nouveaux termes  ?"

msgid "Empty value message."
msgstr "Message de valeur vide."

msgid "A text message that will be displayed when the field is focused and it does not contain values."
msgstr "Un message texte qui s'affichera lorsque le champ est focalisé et qu'il ne contient pas de valeurs."

msgid "Match operator: @match_operator"
msgstr "Opérateur de correspondance : @match_operator"

msgid "Limit: @limit"
msgstr "Limite : @limit"

msgid "Min length: @min_length"
msgstr "Longueur minimale : @min_length"

msgid "Delimiter: @delimiter"
msgstr "Délimiteur : @delimiter"

msgid "Allow Not Found message: @not_found_message_allow"
msgstr "Autoriser le message introuvable : @not_found_message_allow"

msgid "Not Found message: @not_found_message"
msgstr "Message introuvable : @not_found_message"

msgid "Allow new terms: @new_terms"
msgstr "Autoriser les nouveaux termes : @new_terms"

msgid "Empty value message: @no_empty_message"
msgstr "Message de valeur vide : @no_empty_message"

msgid "@not_found_message"
msgstr "@not_found_message"

msgid "@no_empty_message"
msgstr "@no_empty_message"

msgid "Starts with"
msgstr "Commence par"

msgid "Contains"
msgstr "Contient"

