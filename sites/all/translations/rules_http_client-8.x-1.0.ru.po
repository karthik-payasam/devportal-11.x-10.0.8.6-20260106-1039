msgid "Rules HTTP Client"
msgstr "Клиент HTTP для правил"

msgid "Provides an action for making http requests."
msgstr "Предоставляет действие для выполнения запросов HTTP."

msgid "Rules"
msgstr "Правила"

msgid "Error while requsting url as Error code: %code and Message: %message."
msgstr "Ошибка при запросе URL. Код ошибки: %code. Сообщение: %message."

msgid "Request HTTP data"
msgstr "Запросить данные HTTP"

msgid "Data"
msgstr "Данные"

msgid "URL"
msgstr "URL"

msgid "Url address where to post, get and delete request send."
msgstr "URL для запросов POST, GET и DELETE."

msgid "Headers"
msgstr "Заголовки"

msgid "Request headers to send as 'name: value' pairs, one per line (e.g., Accept: text/plain). See <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a> for more information."
msgstr "Заголовки отправляемого запроса в виде пар 'имя: значение' по одной на строке, например Accept: text/plain. См. статью <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a>."

msgid "Method"
msgstr "Метод"

msgid "The HTTP request methods like'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH' etc."
msgstr "Методы запроса HTTP, такие как 'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH' и пр."

msgid "The request body, formatter as 'param=value&param=value&...' or one 'param=value' per line.."
msgstr "Тело запроса в формате 'параметр=значение&параметр=значение&...' или 'параметр=значение' (по одному на строке)."

msgid "Max Redirect"
msgstr "Максимальное количество перенаправлений"

msgid "How many times a redirect may be followed."
msgstr "Сколько перенаправлений можно делать."

msgid "Timeout"
msgstr "Время ожидания"

msgid "The maximum number of seconds the request may take.."
msgstr "Максимальная продолжительность запроса в секундах."

msgid "HTTP data"
msgstr "Данные HTTP"

