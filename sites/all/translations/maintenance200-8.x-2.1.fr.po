msgid ""
"\n"
"        <h2>Maintenance200 module.</h2>\n"
"        <h3>Instructions</h3>\n"
"        <p>Install the module as normal and enable in <strong>/admin/modules</strong>.</p>\n"
"        <p>On the module configuration form you will find a switch to turn on or off the rewriting of the HTTP code returned when the site is in maintenance mode, as well as a field where you\n"
"        can input the numeric HTTP which the site should return.</p>\n"
"      "
msgstr ""
"\n"
"        <h2>Module Maintenance200 .</h2>\n"
"        <h3>Instructions</h3> <p>Installez le module comme normal et activez dans <strong>/admin/modules</strong>.</p>\n"
"        <p>Sur le formulaire de configuration du module, vous trouverez un commutateur pour activer ou désactiver la réécriture du code HTTP renvoyé lorsque le site est en mode maintenance, ainsi qu'une zone dans laquelle vous pouvez entrer le HTTP numérique que le site doit renvoyer.</p>\n"
"      "

msgid "Maintenance 200"
msgstr "Maintenance 200"

msgid "Allows the maintenance page to return a configurable HTTP status code rather than the standard 503 code."
msgstr "Permet à la page de maintenance de renvoyer un code d'état HTTP configurable plutôt que le code 503 standard."

msgid "Configure maintenance200"
msgstr "Configuration de maintenance200"

msgid "Maintenance200 Settings"
msgstr "Paramètres Maintenance200"

msgid "Maintenance 200 settings"
msgstr "Paramètres de maintenance 200"

msgid "Enable custom status code during maintenance mode"
msgstr "Activer le code d'état personnalisé pendant le mode de maintenance"

msgid "Status code to return during maintenance mode"
msgstr "Code de statut à renvoyer pendant le mode de maintenance"

msgid "Change the status code during maintenance mode"
msgstr "Modifier le code d'état pendant le mode de maintenance"

msgid "Status code to use"
msgstr "Code d'état à utiliser"

msgid "A valid HTTP status code is required. See the Wikipedia <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">HTTP status codes</a> page for a complete list."
msgstr "Un code d'état HTTP valide est requis. Voir la page Wikipedia <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">Codes d'état HTTP</a> pour une liste complète."

msgid "A valid HTTP status code is required."
msgstr "Un code d'état HTTP valide est requis."

msgid "You must provide an HTTP status code."
msgstr "Vous devez fournir un code d'état HTTP."

