msgid "Schema.org: Event"
msgstr "Schema.org: Event"

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "Ogólna ocena na podstawie kolekcji recenzji lub ocen elementu."

msgid "RECOMMENDED BY GOOGLE. A description of the event."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Opis zdarzenia."

msgid "The time when admission will commence."
msgstr "Czas rozpoczęcia."

msgid "RECOMMENDED BY GOOGLE. Date and time when the event ends."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Data i godzina zakończenia zdarzenia."

msgid "RECOMMENDED BY GOOGLE. The eventAttendanceMode of the event. Valid values are https://schema.org/OfflineEventAttendanceMode, https://schema.org/MixedEventAttendanceMode, or https://schema.org/OnlineEventAttendanceMode."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Właściwość eventAttendanceMode zdarzenia. Poprawne wartości to https://schema.org/OfflineEventAttendanceMode, https://schema.org/MixedEventAttendanceMode i https://schema.org/OnlineEventAttendanceMode."

msgid "RECOMMENDED BY GOOGLE. The status of the event. Valid options are https://schema.org/EventCancelled, https://schema.org/EventMovedOnline, https://schema.org/EventPostponed, https://schema.org/EventRescheduled, or https://schema.org/EventScheduled."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Status zdarzenia. Poprawne opcje to https://schema.org/EventCancelled, https://schema.org/EventMovedOnline, https://schema.org/EventPostponed, https://schema.org/EventRescheduled i https://schema.org/EventScheduled."

msgid "Globally unique id of the event, usually a url."
msgstr "Unikalny globalnie identyfikator zdarzenia (zwykle adres URL)."

msgid "RECOMMENDED BY GOOGLE. The primary image for this item."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Podstawowy obraz tego elementu."

msgid "REQUIRED BY GOOGLE. The location of the event."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Lokalizacja zdarzenia."

msgid "REQUIRED BY GOOGLE. The name of the event."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Nazwa zdarzenia."

msgid "RECOMMENDED BY GOOGLE. Offers associated with the event."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Oferty powiązane ze zdarzeniem."

msgid "RECOMMENDED BY GOOGLE. The organizer of the event."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Organizator zdarzenia."

msgid "RECOMMENDED BY GOOGLE. The performer on the event."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Wykonawca zdarzenia."

msgid "RECOMMENDED BY GOOGLE. The previousStartDate of the event."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Właściwość previousStartDate zdarzenia."

msgid "Reviews of this event."
msgstr "Recenzje tego zdarzenia."

msgid "REQUIRED BY GOOGLE. Date and time when the event starts."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Data i godzina rozpoczęcia zdarzenia."

msgid "REQUIRED. The type of event."
msgstr "WYMAGANE. Typ zdarzenia."

msgid "The URL of the event."
msgstr "Adres URL zdarzenia."

