msgid "In order to use the Simple XML Sitemap Views module, the Views URL generator must be <a href=\"@url\">added</a> to a sitemap type."
msgstr "Om de module Simple XML Sitemap Views te kunnen gebruiken, moet de URL-generator voor Views <a href=\"@url\">toegevoegd</a> zijn aan een sitemap-type."

msgid "Simple XML Sitemap (Views)"
msgstr "Simple XML Sitemap (views)"

msgid "Provides integration of the Simple XML Sitemap module with the Views module."
msgstr "Biedt integratie van de Simple XML Sitemap-module met de module Views."

msgid "SEO"
msgstr "SEO"

msgid "Views"
msgstr "Weergaven"

msgid "Simple XML Sitemap"
msgstr "Eenvoudige XML-sitemap"

msgid "Variants"
msgstr "Varianten"

msgid "Index"
msgstr "Index"

msgid "Priority"
msgstr "Prioriteit"

msgid "Change frequency"
msgstr "Wijzigingsfrequentie"

msgid "Indexed arguments"
msgstr "Geïndexeerde argumenten"

msgid "Max links"
msgstr "Max links"

msgid "View"
msgstr "Bekijken"

msgid "Display"
msgstr "Weergave"

msgid "Sitemaps"
msgstr "Sitemaps"

msgid "Operations"
msgstr "Bewerkingen"

msgid "No view displays are set to be indexed yet. <a href=\"@url\">Edit a view.</a>"
msgstr "Er zijn nog geen weergaven van views die geïndexeerd moeten worden. <a href=\"@url\">Een view bewerken.</a>"

msgid "Please configure at least one <a href=\"@sitemaps_url\">sitemap</a> to be of a <a href=\"@types_url\">type</a> that implements the views URL generator."
msgstr "Configureer ten minste één <a href=\"@sitemaps_url\">sitemap</a> van een <a href=\"@types_url\">type</a> dat de URL-generator voor views implementeert."

msgid "Edit"
msgstr "Bewerken"

msgid "Garbage collection in the simple_sitemap_views table"
msgstr "Opschoning in de tabel simple_sitemap_views"

msgid "Views URL generator"
msgstr "URL-generator van views"

msgid "Generates URLs for views."
msgstr "Hiermee worden URL's voor views gegenereerd."

msgid "Index this display in sitemap <em>@variant_label</em>"
msgstr "Indexeer deze weergave in sitemap <em>@variant_label</em>"

msgid "The priority this display will have in the eyes of search engine bots."
msgstr "De prioriteit die dit scherm zal hebben bij bots van zoekmachines."

msgid "The frequency with which this display changes. Search engine bots may take this as an indication of how often to index it."
msgstr "De frequentie waarmee deze weergave wordt gewijzigd. Bots van zoekmachines kunnen dit als indicatie zien van hoe vaak er geïndexeerd moet worden."

msgid "Maximum display variations"
msgstr "Maximumaantal weergavevariaties"

msgid "The maximum number of link variations to be indexed for this display. If left blank, each argument will create link variations for this display. Use with caution, as a large number of argument values​can significantly increase the number of sitemap links."
msgstr "Het maximumaantal linkvariaties dat moet worden geïndexeerd voor deze weergave. Als u dit veld leeg laat, maakt elk argument linkvariaties voor deze weergave. Gebruik dit voorzichtig, een groot aantal argumentwaarden​kan het aantal sitemaplinks significant verhogen."

msgid "Simple XML Sitemap settings for this display"
msgstr "Instellingen voor Simple XML Sitemap voor deze weergave"

msgid "Included in sitemaps: @variants"
msgstr "Opgenomen in sitemaps: @variants"

msgid "Excluded from all sitemaps"
msgstr "Uitgesloten van alle sitemaps"

msgid "To enable indexing of an argument, you must enable indexing of all previous arguments."
msgstr "Om het indexeren van een argument in te schakelen, moet u de indexering van alle eerdere argumenten inschakelen."

msgid "Simple XML Sitemap settings for this view."
msgstr "Instellingen van Simple XML Sitemap voor deze view."

