msgstr "Начат импорт конфигурации."

msgid "Configuration import has encountered an error."
msgstr "При импорте конфигурации возникла ошибка."

msgid "The configuration synchronization failed validation."
msgstr "Не удалось произвести проверку синxронизации конфигурации."

