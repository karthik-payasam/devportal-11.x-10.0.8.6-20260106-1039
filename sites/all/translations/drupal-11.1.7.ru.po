msgid "Use language codes as <a href=\":w3ctags\">defined by the W3C</a> for interoperability. <em>Examples: \"en\", \"en-gb\" and \"zh-hant\".</em>"
msgstr "Для оперативной совместимости используйте языковые коды <a href=\":w3ctags\">заданные W3C</a>. <em>Примеры: \"en\", \"en-gb\" и \"zh-hant\".</em>"

msgid "Direction that text in this language is presented."
