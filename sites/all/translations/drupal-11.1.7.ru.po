msgstr "Отображение раскрытых фильтров в блоках требует флажка \"Использовать AJAX\" для корректной работы."

msgid "Allow settings in the block configuration"
msgstr "Разрешить настройки в конфигурации блока"

msgid "@count (default setting)"
msgstr "@count (настройка по умолчанию)"

msgid "Display the view as a block."
msgstr "Отобразить представление в виде блока."

msgid "Default settings for this view."
msgstr "Настройки по умолчанию для этого представления."

msgid "Broken field"
msgstr "Повреждённое поле"

