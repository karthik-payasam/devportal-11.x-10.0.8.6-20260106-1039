msgstr "@requirements_message (Используется @item версия @version)"

msgid "Enter the date using the format @placeholder_date (e.g., @date_format)."
msgstr "Введите дату в формате @placeholder_date (например, @date_format)."

msgid "Enter the time using the format @placeholder_time (e.g., @time_format)."
msgstr "Введите время в формате @placeholder_time (например, @time_format)."

