msgid "Schema.org Book"
msgstr "Schema.org 书籍"

msgid "Adds Schema.org/Book to the JSON LD array."
msgstr "向 JSON LD 数组添加 Schema.org/书籍。"

msgid "SEO"
msgstr "SEO"

msgid "author"
msgstr "作者"

