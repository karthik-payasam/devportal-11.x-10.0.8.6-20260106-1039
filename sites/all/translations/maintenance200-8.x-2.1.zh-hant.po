msgid ""
"\n"
"        <h2>Maintenance200 module.</h2>\n"
"        <h3>Instructions</h3>\n"
"        <p>Install the module as normal and enable in <strong>/admin/modules</strong>.</p>\n"
"        <p>On the module configuration form you will find a switch to turn on or off the rewriting of the HTTP code returned when the site is in maintenance mode, as well as a field where you\n"
"        can input the numeric HTTP which the site should return.</p>\n"
"      "
msgstr ""
"\n"
"        <h2>Maintenance200 模組。</h2>\n"
"        <h3>指示</h3> <p>正常安裝模組，並在 <strong>/admin/modules</strong> 中啟用。</p>\n"
"        <p>在模組配置表單上，您會找到一個開關，可開啟或關閉重新編寫網站處於維護模式時所傳回的 HTTP 代碼，以及一個欄位，您可以在其中輸入網站應該傳回的數值 HTTP。</p>\n"
"      "

msgid "Maintenance 200"
msgstr "維護 200"

msgid "Allows the maintenance page to return a configurable HTTP status code rather than the standard 503 code."
msgstr "容許維護頁面傳回可配置的 HTTP 狀態碼，而不是標準 503 代碼。"

msgid "Configure maintenance200"
msgstr "配置 maintenance200"

msgid "Maintenance200 Settings"
msgstr "Maintenance200 設定"

msgid "Maintenance 200 settings"
msgstr "Maintenance 200 設定"

msgid "Enable custom status code during maintenance mode"
msgstr "在維護模式期間啟用自訂狀態碼"

msgid "Status code to return during maintenance mode"
msgstr "在維護模式期間要傳回的狀態碼"

msgid "Change the status code during maintenance mode"
msgstr "在維護模式期間變更狀態碼"

msgid "Status code to use"
msgstr "要使用的狀態碼"

msgid "A valid HTTP status code is required. See the Wikipedia <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">HTTP status codes</a> page for a complete list."
msgstr "需要有效的 HTTP 狀態碼。 如需完整清單，請參閱Wikipedia <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">HTTP 狀態碼</a>頁面。"

msgid "A valid HTTP status code is required."
msgstr "需要有效的 HTTP 狀態碼。"

msgid "You must provide an HTTP status code."
msgstr "您必須提供 HTTP 狀態碼。"

