msgid "Chaos Tools Views"
msgstr "Widoki narzędzi Chaos"

msgid "A set of improvements to the core Views code that allows for greater control over Blocks."
msgstr "Zestaw udoskonaleń kodu widoków podstawowych umożliwiający lepsze sterowanie blokami."

msgid "Chaos tool suite (Experimental)"
msgstr "Pakiet narzędzi Chaos (eksperymentalny)"

msgid "Items per page"
msgstr "Liczba pozycji na stronie"

msgid "Pager offset"
msgstr "Przesunięcie paginatora"

msgid "Pager type"
msgstr "Typ paginatora"

msgid "Hide fields"
msgstr "Ukryj pola"

msgid "Reorder fields"
msgstr "Zmień kolejność pól"

msgid "Configure filters"
msgstr "Konfiguruj filtry"

msgid "Disable filters"
msgstr "Wyłącz filtry"

msgid "Configure sorts"
msgstr "Konfiguruj sortowanie"

msgid "Allow settings"
msgstr "Zezwól na ustawienia"

msgid "None"
msgstr "Brak"

msgid "For example, set this to 3 and the first 3 items will not be displayed."
msgstr "Na przykład ustawienie wartości 3 powoduje, że nie będą wyświetlane pierwsze 3 pozycje."

msgid "Inherit from view"
msgstr "Dziedzicz z widoku"

msgid "Display a specified number of items"
msgstr "Wyświetl podaną liczbę pozycji"

msgid "Display all items"
msgstr "Wyświetl wszystkie pozycje"

msgid "Pager"
msgstr "Paginator"

msgid "Hide"
msgstr "Ukryj"

msgid "Label"
msgstr "Etykieta"

msgid "Weight"
msgstr "Waga"

msgid "Weight for @title"
msgstr "Waga elementu @title"

msgid "Exposed filter values"
msgstr "Ujawnione wartości filtru"

msgid "If a value is set for an exposed filter, it will be removed from the block display."
msgstr "Jeśli wartość jest ustawiona dla ujawnionego filtru, zostanie ona usunięta z ekranu blokowego."

msgid "Expose filter value to user"
msgstr "Ujawnij użytkownikowi wartość filtru"

msgid "Expose this filter value to visitors? If so, the value set here will be the default."
msgstr "Czy ujawnić odwiedzającym tę wartość filtru? Jeśli tak, to wartość ustawiona w tym miejscu będzie wartością domyślną."

msgid "Expose filter operator to user"
msgstr "Ujawnij użytkownikowi operator filtru"

msgid "Expose this filter's operator to visitors? If so, the operator set here will be the default."
msgstr "Czy ujawnić odwiedzającym ten operator filtru? Jeśli tak, to operator ustawiony w tym miejscu będzie wartością domyślną."

msgid "Disable filter: @handler"
msgstr "Wyłącz filtr: @handler"

msgid "Sort ascending"
msgstr "Sortuj rosnąco"

msgid "Sort descending"
msgstr "Sortuj malejąco"

msgid "Order"
msgstr "Kolejność"

