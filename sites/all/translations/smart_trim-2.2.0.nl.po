msgid "About"
msgstr "Over"

msgid "Smart Trim implements a new field formatter for text fields (text, text_long, and text_with_summary, if you want to get technical) that improves upon the \"Summary or Trimmed\" formatter."
msgstr "Smart Trim implementeert een nieuwe veldformatter voor tekstvelden (text, text_long en text_with_summary, om technisch te zijn). Deze vormt een duidelijke verbetering ten opzichte van de formatter \"Summary or Trimmed\". "

msgid "More"
msgstr "Meer"

msgid "Read more about [node:title]"
msgstr "Lees meer over [node:title]"

msgid "Smart Trim"
msgstr "Smart Trim"

msgid "Provides a more robust alternative to \"summary or trimmed\" textfield format"
msgstr "Vormt een robuuster alternatief voor de indeling \"summary or trimmed\" voor tekstvelden"

msgid "Fields"
msgstr "Velden"

msgid "Smart trim formatter settings"
msgstr "Instellingen voor Smart Trim Formatter"

msgid "Trim length"
msgstr "Lengte beperken"

msgid "Trim units"
msgstr "Eenheden voor bijsnijden"

msgid "Suffix"
msgstr "Achtervoegsel"

msgid "Wrap trimmed content"
msgstr "Bijgesneden content naar volgende regel"

msgid "Wrapped content class"
msgstr "Klasse van teruglopende content"

msgid "More link configuration"
msgstr "Meer koppelingsconfiguratie"

msgid "Display more link"
msgstr "Link 'Meer' afbeelden"

msgid "Open link in new window"
msgstr "Link in nieuw venster openen"

msgid "More link only when content is trimmed"
msgstr "Meer link alleen als de content wordt getrimd"

msgid "More link class"
msgstr "Klasse van link 'Meer'"

msgid "More link text"
msgstr "Tekst 'meer'-link"

msgid "More link aria-label value"
msgstr "Aria-labelwaarde van de link 'Meer'"

msgid "Summary handler"
msgstr "Samenvattingshandler"

msgid "Additional options"
msgstr "Extra opties"

msgid "Strip HTML"
msgstr "HTML strippen"

msgid "Honor a zero trim length"
msgstr "Bijsnijlengte van 0 accepteren"

msgid "Replace tokens before trimming"
msgstr "Tokens vervangen voor inkorten"

msgid "Characters"
msgstr "Tekens"

msgid "Words"
msgstr "Woorden"

msgid "Summary"
msgstr "Samenvatting"

msgid "Use summary if present, and do not trim"
msgstr "Samenvatting gebruiken (indien aanwezig), en niet bijsnijden"

msgid "Use summary if present, honor trim settings"
msgstr "De instellingen voor bijsnijden respecteren, ook als er een samenvatting aanwezig is"

msgid "Do not use summary"
msgstr "Samenvatting niet gebruiken"

msgid "Wrap trimmed content?"
msgstr "Bijgesneden content naar volgende regel?"

msgid "Adds a wrapper div to trimmed content. This option is deprecated and will be removed in Smart Trim 3.0.0. Please override the smart-trim.html.twig template file to customize output."
msgstr "Hiermee wordt er een wrapper div toegevoegd aan bijgesneden content. Deze optie is gedeprecieerd en wordt verwijderd in Smart Trim 3.0.0. Overschrijd het sjabloonbestand smart-trim.html.twig om de uitvoer aan te passen."

msgid "Wrapped content class."
msgstr "Klasse van teruglopende content."

msgid "If wrapping, define the class name here."
msgstr "Als de tekst doorloopt op de volgende regel, moet u hier de klasse definiëren."

msgid "<em>More</em> link"
msgstr "Link <em>Meer</em>"

msgid "Display <em>More</em> link?"
msgstr "Link <em>Meer</em> afbeelden?"

msgid "Displays a link to the entity (if one exists)"
msgstr "Hiermee wordt er een link naar de entiteit afgebeeld (als er een bestaat)"

msgid "Display <em>More</em> link only when content is trimmed?"
msgstr "Link <em>Meer</em> alleen afbeelden als de content wordt getrimd?"

msgid "Only display <em>More</em> link if content is actually trimmed."
msgstr "Alleen de link <em>Meer</em> afbeelden als de content daadwerkelijk is getrimd."

msgid "Open <em>More</em> link in new window"
msgstr "Open <em>Meer</em> link in nieuw venster"

msgid "<em>More</em> link text"
msgstr "<em>Meer</em>-linktekst"

msgid "If displaying <em>More</em> link, enter the text for the link. This field supports tokens."
msgstr "Als de link <em>Meer</em> wordt afgebeeld, geeft u de tekst voor de link op. Dit veld ondersteunt tokens."

msgid "<em>More</em> link aria-label"
msgstr "<em>Meer</em> link aria-label"

msgid "If displaying <em>More</em> link, provide additional context for screen-reader users. In most cases, the aria-label value will be announced instead of the link text. This field supports tokens."
msgstr "Als de link <em>Meer</em> wordt afgebeeld, biedt u extra context voor schermleesgebruikers. In de meeste gevallen wordt de aria-labelwaarde aangekondigd in plaats van de linktekst. Dit veld ondersteunt tokens."

msgid "<em>More</em> link class"
msgstr "<em>Meer</em>-linkklasse"

msgid "If displaying <em>More</em> link, add a custom class for formatting."
msgstr "Als de link <em>Meer</em> wordt afgebeeld, voegt u een aangepaste klasse toe voor de opmaak."

msgid "words"
msgstr "woorden"

msgid "characters"
msgstr "tekens"

msgid "Suffix: %suffix"
msgstr "Suffix: %suffix"

msgid "<em>More</em> link enabled, text: %text"
msgstr "<em>Meer</em> koppeling ingeschakeld, tekst: %text"

msgid "Only display <em>More</em> link when trimmed"
msgstr "Alleen <em>Meer</em> -link afbeelden wanneer bijgesneden"

msgid "<em>More</em> link aria-label: %label"
msgstr "<em>Meer</em> link aria-label: %label"

msgid "<em>More</em> link class: %class"
msgstr "<em>Meer</em>-linkklasse: %class"

msgid "Smart trimmed"
msgstr "Slim inkorten"

