msgid "In order to use the Simple XML Sitemap Views module, the Views URL generator must be <a href=\"@url\">added</a> to a sitemap type."
msgstr "Para utilizar el módulo Vistas de mapa de sitio XML simple, hay que <a href=\"@url\">añadir</a> el generador de URL de vistas a un tipo de mapa del sitio."

msgid "Simple XML Sitemap (Views)"
msgstr "Mapa del sitio XML simple (Vistas)"

msgid "Provides integration of the Simple XML Sitemap module with the Views module."
msgstr "Proporciona la integración del módulo de mapa de sitios XML simple con el módulo de vistas."

msgid "SEO"
msgstr "SEO (optimizador del motor de búsqueda)"

msgid "Views"
msgstr "Vistas"

msgid "Simple XML Sitemap"
msgstr "Mapa de sitio XML simple"

msgid "Variants"
msgstr "Variantes"

msgid "Index"
msgstr "Índice"

msgid "Priority"
msgstr "Prioridad"

msgid "Change frequency"
msgstr "Cambiar frecuencia"

msgid "Indexed arguments"
msgstr "Argumentos indexados"

msgid "Max links"
msgstr "Máximo de enlaces"

msgid "View"
msgstr "Ver"

msgid "Display"
msgstr "Visualización"

msgid "Sitemaps"
msgstr "Mapas de sitios"

msgid "Operations"
msgstr "Operaciones"

msgid "No view displays are set to be indexed yet. <a href=\"@url\">Edit a view.</a>"
msgstr "Todavía no se han establecido visualizaciones de vista para ser indexadas. <a href=\"@url\">Editar una vista.</a>"

msgid "Please configure at least one <a href=\"@sitemaps_url\">sitemap</a> to be of a <a href=\"@types_url\">type</a> that implements the views URL generator."
msgstr "Configure al menos un <a href=\"@sitemaps_url\">mapa de sitio</a> para que sea de un <a href=\"@types_url\">tipo</a> que implemente el generador de URL de vistas."

msgid "Edit"
msgstr "Editar"

msgid "Garbage collection in the simple_sitemap_views table"
msgstr "Recogida de basura en la tabla simple_sitemap_views"

msgid "Views URL generator"
msgstr "Generador de url de vistas"

msgid "Generates URLs for views."
msgstr "Genera los URL para vistas."

msgid "Index this display in sitemap <em>@variant_label</em>"
msgstr "Indexar esta visualización en mapa del sitio <em>@variant_label</em>"

msgid "The priority this display will have in the eyes of search engine bots."
msgstr "La prioridad que tendrá esta pantalla desde el punto de vista de los robots del motor de búsqueda."

msgid "The frequency with which this display changes. Search engine bots may take this as an indication of how often to index it."
msgstr "La frecuencia con la que cambia esta pantalla. Los bots de motor de búsqueda pueden tomar esto como una indicación de la frecuencia de indexación."

msgid "Maximum display variations"
msgstr "Máximo de variaciones de visualización"

msgid "The maximum number of link variations to be indexed for this display. If left blank, each argument will create link variations for this display. Use with caution, as a large number of argument values​can significantly increase the number of sitemap links."
msgstr "El número máximo de variaciones de enlace que se van a indexar para esta pantalla. Si se deja en blanco, cada argumento creará variaciones de enlace para esta pantalla. Utilícelo con precaución, ya que un número elevado de valores de argumento puede aumentar de forma significativa el número de enlaces de mapa de sitio."

msgid "Simple XML Sitemap settings for this display"
msgstr "Valores del mapa del sitio XML simple para esta visualización"

msgid "Included in sitemaps: @variants"
msgstr "Incluidas en mapas de sitio: @variants"

msgid "Excluded from all sitemaps"
msgstr "Excluido de todos los mapas de sitio"

msgid "To enable indexing of an argument, you must enable indexing of all previous arguments."
msgstr "Para habilitar la indexación de un argumento, debe habilitar la indexación de todos los argumentos anteriores."

msgid "Simple XML Sitemap settings for this view."
msgstr "Valores del mapa del sitio XML simple para esta vista"

