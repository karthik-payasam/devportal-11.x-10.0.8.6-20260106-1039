msgid "Font Awesome IconPicker"
msgstr "Font Awesome IconPicker"

msgid "The fontIconPicker library is installed."
msgstr "Biblioteka fontIconPicker jest zainstalowana."

msgid "Not installed"
msgstr "Nie zainstalowano"

msgid "The fontIconPicker library could not be found. To use the Font Awesome Iconpicker, please verify that the fontIconPicker library is installed correctly. Please see the Font Awesome Iconpicker submodule README file for more details."
msgstr "Nie można znaleźć biblioteki fontIconPicker. Aby skorzystać z narzędzia Font Awesome Iconpicker, sprawdź, czy biblioteka fontIconPicker jest poprawnie zainstalowana. Więcej szczegółów można znaleźć w pliku README modułu podrzędnego Font Awesome Iconpicker."

msgid "Font Awesome Iconpicker Widget"
msgstr "Widget Font Awesome iconpicker"

msgid "Provides an iconpicker widget for Font Awesome"
msgstr "Udostępnia widget iconpicker dla Font Awesome"

msgid "IconPicker already present at @path. No download required."
msgstr "Element IconPicker jest już obecny w @path. Pobieranie nie jest wymagane."

msgid "Drush was unable to download the fontIconPicker library from @remote."
msgstr "Program Drush nie mógł pobrać biblioteki fontIconPicker z @remote."

msgid "Error: unable to download fontIconPicker library from @remote"
msgstr "Błąd: nie można pobrać biblioteki fontIconPicker z @remote"

msgid "fontIconPicker library has been successfully downloaded to @path."
msgstr "Biblioteka fontIconPicker została pomyślnie pobrana do katalogu @path."

msgid "Drush was unable to load the fontIconPicker) library"
msgstr "Program Drush nie mógł załadować biblioteki fontIconPicker"

msgid "Icon Name"
msgstr "Nazwa ikony"

msgid "Invalid icon"
msgstr "Niepoprawna ikona"

