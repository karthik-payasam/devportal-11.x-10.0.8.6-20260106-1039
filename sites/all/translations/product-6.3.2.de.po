msgstr "Außerkraftsetzen von Drush-Produkt: falsche Anzahl an Anwendungen mit der URL '@url' gefunden. Sollte 1 sein, war aber @count."

msgid "Drush product supersede : incorrect number of products found. Should be 2 but was @count."
msgstr "Außerkraftsetzen von Drush-Produkt: falsche Anzahl an Produkten gefunden. Sollte 2 sein, war aber @count."

msgid "Drush product supersede : no content provided."
msgstr "Außerkraftsetzen von Drush-Produkt: kein Inhalt angegeben."

msgid "Drush ReplaceProduct deleted retired API @api"
msgstr "Drush ReplaceProduct hat zurückgezogene API @api gelöscht"

msgid "Drush product replace : found a product in a strange lifecycle state '@state'. Expected 'published', 'deprecated' or 'retired'."
msgstr "Ersetzen von Drush-Produkt: Produkt mit ungewöhnlichem Lebenszyklusstatus '@state' gefunden. Erwartet wurde 'published', 'deprecated' oder 'retired'."

msgid "Drush product replace : incorrect number of products found. Should be 2 but was @count."
msgstr "Ersetzen von Drush-Produkt: falsche Anzahl an Produkten gefunden. Sollte 2 sein, war aber @count."

