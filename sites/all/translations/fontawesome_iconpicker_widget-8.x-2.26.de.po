msgid "Font Awesome IconPicker"
msgstr "Font Awesome IconPicker"

msgid "The fontIconPicker library is installed."
msgstr "Die fontIconPicker-Bibliothek ist installiert."

msgid "Not installed"
msgstr "Nicht installiert"

msgid "The fontIconPicker library could not be found. To use the Font Awesome Iconpicker, please verify that the fontIconPicker library is installed correctly. Please see the Font Awesome Iconpicker submodule README file for more details."
msgstr "Die fontIconPicker-Bibliothek wurde nicht gefunden. Wenn Sie den Font Awesome Iconpicker verwenden möchten, stellen Sie sicher, dass die fontIconPicker-Bibliothek ordnungsgemäß installiert ist. Weitere Informationen finden Sie in der Readme-Datei zum Untermodul von Font Awesome Iconpicker."

msgid "Font Awesome Iconpicker Widget"
msgstr "Font Awesome Iconpicker-Widget"

msgid "Provides an iconpicker widget for Font Awesome"
msgstr "Stellt ein Iconpicker-Widget für Font Awesome bereit"

msgid "IconPicker already present at @path. No download required."
msgstr "IconPicker ist bereits bei @path vorhanden. Kein Download erforderlich."

msgid "Drush was unable to download the fontIconPicker library from @remote."
msgstr "Drush konnte die fontIconPicker-Bibliothek nicht von @remote herunterladen."

msgid "Error: unable to download fontIconPicker library from @remote"
msgstr "Fehler: fontIconPicker-Bibliothek kann nicht von @remote heruntergeladen werden"

msgid "fontIconPicker library has been successfully downloaded to @path."
msgstr "fontIconPicker-Bibliothek wurde erfolgreich in @path heruntergeladen."

msgid "Drush was unable to load the fontIconPicker) library"
msgstr "Drush konnte die fontIconPicker-Bibliothek nicht laden"

msgid "Icon Name"
msgstr "Symbolname"

msgid "Invalid icon"
msgstr "Ungültiges Symbol"

