msgid "Metatag: Dublin Core"
msgstr "Metaetiqueta: Dublin Core"

msgid "Provides the fifteen <a href=\"https://dublincore.org/documents/dces/\">Dublin Core Metadata Element Set 1.1</a> meta tags from the <a href=\"https://dublincore.org/\">Dublin Core Metadata Institute</a>."
msgstr "Proporciona las quince metaetiquetas de <a href=\"https://dublincore.org/documents/dces/\">Dublin Core Metadata Element Set 1.1</a> del <a href=\"https://dublincore.org/\">Dublin Core Metadata Institute</a>."

