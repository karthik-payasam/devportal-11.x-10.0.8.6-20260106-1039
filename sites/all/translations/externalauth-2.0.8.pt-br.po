msgid "External Authentication Map"
msgstr "Mapear Autenticação Externa"

msgid "Provider"
msgstr "Provedor"

msgid "The name of the authentication provider providing the authname."
msgstr "O nome do provedor de autenticação que fornece o nome de autoria."

msgid "Authname"
msgstr "Autor"

msgid "Unique authentication name provided by authentication provider."
msgstr "O nome de autenticação exclusivo fornecido pelo provedor de autenticação."

msgid "Drupal User ID"
msgstr "ID do usuário Drupal"

msgid "The user linked to the authname."
msgstr "O usuário vinculado ao authname."

msgid "Linked Drupal user"
msgstr "Usuário Drupal vinculado"

msgid "Link to delete @label entry"
msgstr "Link para excluir a entrada @label"

msgid "Provide a link to delete the @label entry."
msgstr "Forneça um link para excluir a entrada @label."

msgid "About"
msgstr "Sobre"

msgid "Authenticates users using an external site / service and stores identification details."
msgstr "Autentica usuários usando um site/serviço externo e armazena detalhes de identificação."

msgid "External Authentication"
msgstr "Autenticação Externa"

msgid "Helper module to authenticate users using an external site / service and storing identification details"
msgstr "Módulo auxiliar para autenticar usuários utilizando um site/serviço externo e armazenando detalhes de identificação"

msgid "User authentication"
msgstr "Autenticação do usuário"

msgid "View external authentication data"
msgstr "Visualizar dados de autenticação externa"

msgid "Delete external authentication data"
msgstr "Excluir dados de autenticação externa"

msgid "Delete authmap entry"
msgstr "Excluir entrada de authmap"

msgid "Authmap change (%old => %new) for user %name with uid %uid from provider %provider"
msgstr "Mudança de authmap (%old => %new) para o usuário %name com o UID %uid do provedor %provider"

msgid "External registration of user %name from provider %provider and authname %authname"
msgstr "Registro externo do usuário %name a partir do provedor %provider e nome do autor %authname "

msgid "External login of user %name"
msgstr "login externo do usuário %name"

msgid "Are you sure you want to delete the link between authentication name %id and Drupal user %user?"
msgstr "Tem certeza de que deseja excluir o link entre o nome de autenticação %id e o usuário do Drupal %user?"

msgid "No authmap record found for provider @provider / uid @uid."
msgstr "Nenhum registro de authmap foi localizado para o provedor @provider / uid @uid."

msgid "The link has been deleted."
msgstr "O link foi excluído."

msgid "User’s users.uid."
msgstr "users.uid do usuário."

msgid "Unique authentication name."
msgstr "Nome exclusivo de autenticação."

msgid "Module which is controlling the authentication."
msgstr "Módulo que controla a autenticação."

msgid "delete"
msgstr "apagar"

msgid "Output the URL as text"
msgstr "Saída da URL como texto"

msgid "Use absolute link (begins with \"http://\")"
msgstr "Use link absoluto (links que começam com \"http://\")"

msgid "Enable this option to output an absolute link. Required if you want to use the path as a link destination."
msgstr "Habilite esta opção para produzir um link absoluto. Necessário se você quiser usar o caminho como destino de link."

