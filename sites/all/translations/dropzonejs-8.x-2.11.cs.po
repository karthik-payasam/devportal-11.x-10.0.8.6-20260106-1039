msgid "About"
msgstr "Popis"

msgid "DropzoneJS"
msgstr "DropzoneJS"

msgid "or"
msgstr "nebo"

msgid "Select file"
msgid_plural "Select files"
msgstr[0] "Vybrat soubor"
msgstr[1] "Vybrat soubory"
msgstr[2] "Vybrat soubory"

msgid "Dropzone library missing"
msgstr "Chybí knihovna Dropzone"

msgid ""
"Dropzonejs requires the dropzone.min.js library.\n"
"        Download it (https://github.com/enyo/dropzone) and place it in the\n"
"        libraries folder (/libraries)"
msgstr ""
"Dropzonejs vyžaduje knihovnu dropzone.min.js.\n"
"        Stáhněte ji (https://github.com/enyo/dropzone) a umístěte do\n"
"        adresáře knihoven (/libraries)"

msgid "dropzonejs"
msgstr "dropzonejs"

msgid "The Drupal integration for DropzoneJS."
msgstr "Integrace Drupal pro DropzoneJS."

msgid "Media"
msgstr "Média"

msgid "Dropzone upload files"
msgstr "Soubory k odeslání Dropzone"

msgid "Allow uploading of files via dropzonejs."
msgstr "Umožňuje odeslání souborů prostřednictvím služby dropzonejs."

msgid "DropzoneJS settings"
msgstr "Nastavení DropzoneJS"

msgid "Upload scheme"
msgstr "Schéma odeslání"

msgid "Transliterate names of uploaded files"
msgstr "Přepis názvů odeslaných souborů"

msgid "Upload timeout"
msgstr "Časový limit odeslání"

msgid "Drop files here to upload"
msgstr "Umístit soubory k odeslání zde"

msgid "Your browser does not support drag'n'drop file uploads."
msgstr "Prohlížeč nepodporuje odeslání souboru přetažením myší."

msgid "Please use the fallback form below to upload your files like in the olden days."
msgstr "Použijte náhradní formulář níže a odešlete své soubory starým způsobem."

msgid "File is too big ({{filesize}}MiB). Max filesize: {{maxFilesize}}MiB."
msgstr "Soubor je příliš velký ({{filesize}}MiB). Maximální velikost souboru: {{maxFilesize}}MiB."

msgid "You can't upload files of this type."
msgstr "Nemůžete odesílat soubory tohoto typu."

msgid "Server responded with {{statusCode}} code."
msgstr "Server odpověděl s kódem {{statusCode}}."

msgid "Cancel upload"
msgstr "Stornovat odeslání"

msgid "Are you sure you want to cancel this upload?"
msgstr "Opravdu chcete zrušit toto odeslání?"

msgid "Remove file"
msgstr "Odstranit soubor"

msgid "You can not upload any more files."
msgstr "Nelze odesílat žádné další soubory."

msgid "TB"
msgstr "TB"

msgid "GB"
msgstr "GB"

msgid "MB"
msgstr "MB"

msgid "KB"
msgstr "KB"

msgid "b"
msgstr "b"

msgid "DropzoneJS entity browser widget"
msgstr "Modul widget prohlížeče entit DropzoneJS"

msgid "DropzoneJS Entity browser widget."
msgstr "Modul widget prohlížeče entit DropzoneJS."

msgid "DropzoneJS widget configuration"
msgstr "Konfigurace modulu widget DropzoneJS"

msgid "Submit button text"
msgstr "Text odesílacího tlačítka"

msgid "Automatically submit selection"
msgstr "Automaticky odeslat výběr"

msgid "Upload location"
msgstr "Umístění pro odesílání "

msgid "Dropzone drag-n-drop zone text"
msgstr "Text zóny pro přetažení Dropzone"

msgid "Maximum size of files"
msgstr "Maximální velikost souborů "

msgid "Allowed file extensions"
msgstr "Povolené přípony souboru"

msgid "Use clientside resize"
msgstr "Použít změnu velikosti na straně klienta "

msgid "Maximum width"
msgstr "Maximální šířka"

msgid "Maximum height"
msgstr "Maximální výška"

msgid "Resize quality"
msgstr "Kvalita změny velikosti "

msgid "Method used for resizing"
msgstr "Metoda použitá pro změnu velikosti "

msgid "Method used for generating the thumbnail"
msgstr "Metoda použitá pro generování miniatury "

msgid "Media Entity DropzoneJS widget configuration"
msgstr "Konfigurace modulu widget Media Entity DropzoneJS "

msgid "Media type"
msgstr "Typ média"

msgid "Media Entity DropzoneJS with edit widget configuration"
msgstr "Konfigurace modulu Media Entity DropzoneJS s modulem widget pro úpravy"

msgid "Form mode"
msgstr "Režim formuláře"

msgid "Drop files here to upload them"
msgstr "Přetáhněte na toto místo soubory, které chcete odeslat"

msgid "File upload"
msgstr "Nahrát soubor"

msgid "Files could not be uploaded because the destination directory %destination is not configured correctly."
msgstr "Soubory se nepodařilo odeslat, protože cílový adresář %destination není správně nakonfigurován. "

msgid "Some files that you are trying to upload did not pass validation. Requirements are: max file %size, allowed extensions are %extensions"
msgstr "Některé ze souborů, které se pokoušíte odeslat, neprošly ověřením. Požadavky: maximální velikost souboru %size, povolené přípony názvů: %extensions"

msgid "At least one valid file should be uploaded."
msgstr "Musí být odeslán nejméně jeden platný soubor."

msgid "A space separated list of file extensions"
msgstr "Seznam přípon názvů souborů s položkami oddělenými mezerou"

msgid "Use client side resizing"
msgstr "Použít změnu velikosti na straně klienta"

msgid "Requires droopzone version v4.4.0 or higher and the <a href=\"@exif\" target=\"_blank\">exif</a> library."
msgstr "Vyžaduje droopzone verze 4.4.0 nebo novější a knihovnu <a href=\"@exif\" target=\"_blank\">exif</a>."

msgid "Max width"
msgstr "Maximální šířka"

msgid "Max height"
msgstr "Maximální výška"

msgid "Resize method"
msgstr "Metoda změny velikosti"

msgid "Contain (scale)"
msgstr "Obsahuje (měřítko)"

msgid "Crop"
msgstr "Oříznout"

msgid "Thumbnail method"
msgstr "Metoda tvorby miniatur"

msgid "Invalid extension list format."
msgstr "Neplatný formát seznamu přípon."

msgid "Adds DropzoneJS upload integration."
msgstr "Přidává integraci odesílání DropzoneJS."

msgid "Missing requirement: in order to use this widget you have to install Inline entity form module first"
msgstr "Nesplněný požadavek: chcete-li použít tento modul widget, musíte nejprve nainstalovat modul formuláře vložené entity"

msgid "Edit"
msgstr "Upravit"

msgid "Media Entity DropzoneJS with edit"
msgstr "Media Entity DropzoneJS s úpravou"

msgid "Adds DropzoneJS upload integration that saves Media entities and allows to edit them."
msgstr "Přidává integraci odeslání DropzoneJS, jež ukládá mediální entity a umožňuje jejich úpravu."

msgid "The type of media entity to create from the uploaded file(s)."
msgstr "Typ mediální entity, která má být vytvořena z odeslaného souboru či souborů."

msgid "You must @create_media_type before using this widget."
msgstr "Před použitím tohoto videa musíte spustit úlohu @create_media_type."

msgid "create a media type"
msgstr "vytvořit typ média"

msgid "Media Entity DropzoneJS"
msgstr "Media Entity DropzoneJS"

msgid "Adds DropzoneJS upload integration that saves Media entities."
msgstr "Přidává integraci odeslání DropzoneJS, jež ukládá mediální entity."

msgid "For security reasons, your upload has been renamed to %filename."
msgstr "Z bezpečnostních důvodů byl nahraný soubor přejmenován na %filename."

msgid "The specified file %name could not be uploaded."
msgstr "Zadaný soubor %name nelze nahrát."

msgid "The file could not be uploaded because the destination %destination is invalid."
msgstr "Soubor nelze nahrát, protože cílový adresář %destination je neplatný."

msgid "File upload error. Could not move uploaded file."
msgstr "Chyba při nahrání souboru. Nelze přesunout nahraný soubor."

msgid "Upload error. Could not move uploaded file %file to destination %destination."
msgstr "Chyba při nahrávání souboru. Nelze přesunout soubor %file do %destination."

msgid "The file could not be saved because it exceeds the maximum allowed size for uploads."
msgstr "Soubor se nepodařilo uložit, protože překračuje maximální povolenou velikost pro odeslání. "

msgid "The file could not be saved because the upload did not complete."
msgstr "Soubor nelze uložit, protože odeslání nebylo dokončeno."

msgid "The file could not be saved. An unknown error has occurred."
msgstr "Soubor nelze uložit. Došlo k neznámé chybě."

msgid "There was a problem while processing the file named @name"
msgstr "Došlo k problému při zpracování souboru s názvem @name"

msgid "You don't have sufficent permissions to use the DropzoneJS uploader. Contact your system administrator"
msgstr "Nemáte oprávnění postačující k použití odesílače DropzoneJS. Obraťte se na administrátora svého systému"

msgid "A maximum of @count files can be uploaded."
msgstr "Můžete odeslat maximálně @count souborů."

msgid "Drop file here to upload it"
msgid_plural "Drop files here to upload them"
msgstr[0] "Chcete-li soubor odeslat, přetáhněte jej sem"
msgstr[1] "Chcete-li soubory odeslat, přetáhněte je sem"
msgstr[2] "Chcete-li soubory odeslat, přetáhněte je sem"

