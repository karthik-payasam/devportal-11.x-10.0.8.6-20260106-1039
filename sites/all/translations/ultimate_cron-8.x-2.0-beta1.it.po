msgstr "Il thread in cui eseguire i lavori. "

msgid "<strong>Any</strong>: Just use any available thread"
msgstr "<strong>Qualsiasi</strong>: Utilizza qualsiasi thread disponibile "

msgid "<strong>Fixed</strong>: Only run in one specific thread. The maximum number of threads is spread across the jobs."
msgstr "<strong>Fisso</strong>: Esegui solo in uno specifico thread. Il numero massimo di thread viene suddiviso tra i lavori. "

msgid "<strong>1-?</strong>: Only run when a specific thread is invoked. This setting only has an effect when cron is run through cron.php with an argument ?thread=N or through Drush with --options=thread=N."
msgstr "<strong>1-?</strong>: Esegui solo quando viene richiamato uno specifico thread. Questa impostazione ha effetto solo quando cron viene eseguito mediante cron.php con un argomento ?thread=N oppure mediante Drush con --options=thread=N. "

