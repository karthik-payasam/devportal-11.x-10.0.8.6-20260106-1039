msgid "About"
msgstr "Informazioni"

msgid "Drupal Proxy Module"
msgstr "Modulo Proxy Drupal "

msgid "Drupal Proxy"
msgstr "Proxy Drupal "

msgid "Proxy"
msgstr "Proxy"

msgid "Proxy Settings"
msgstr "Impostazioni proxy "

msgid "ProxySettingForm"
msgstr "ProxySettingForm"

msgid "Https or Https"
msgstr "Https o Https"

msgid "type of Scheme"
msgstr "tipo di schema"

msgid "Proxy Server"
msgstr "Server proxy "

msgid "The IP address or hostname of the proxy server."
msgstr "L'indirizzo IP o il nome host del server proxy. "

msgid "Port"
msgstr "Porta"

msgid "The port number used by the proxy server for client connections."
msgstr "Il numero di porta utilizzato dal server proxy per le connessioni al client. "

msgid "Proxy Username"
msgstr "Nome utente proxy "

msgid "A username used of proxy server for Authentication."
msgstr "Un nome utente utilizzato dal server proxy per l'autenticazione. "

msgid "Proxy Password"
msgstr "Password proxy "

msgid "Password of proxy server used for Authentication."
msgstr "Password del server proxy utilizzato per l'autenticazione. "

msgid "Proxy User Agent"
msgstr "Agent utente proxy"

msgid "A string which can be used by the proxy server to identify connection requests."
msgstr "Una stringa che può essere utilizzata dal server proxy per identificare le richieste di connessione. "

msgid "Proxy Exceptions"
msgstr "Eccezioni proxy "

msgid "Specify exceptions using either IP addresses or hostnames. Enter one exception per line. Exceptions will be accessed directly, not via proxy."
msgstr "Specificare le espressioni utilizzando gli indirizzi IP o i nomi host. Immettere un'eccezione per ciascuna riga. L'accesso alle eccezioni verrà eseguito direttamente, non mediante il proxy. "

