msgstr "Operacja przenoszenia nie została jeszcze zaimplementowana."

msgid "Disable mouse-over effect for terms (weights and direct link)"
msgstr "Wyłącz efekt umieszczania wskaźnika myszy dla terminów (wagi i bezpośrednie odsyłacze)"

msgid "Disabling this feature speeds up the Taxonomy Manager"
msgstr "Wyłączenie tej funkcji przyspiesza działanie menedżera systematyki"

msgid "Pager count"
msgstr "Liczba terminów na stronie"

msgid "Select how many terms should be listed on one page. Huge page counts can slow down the Taxonomy Manager"
msgstr "Wybierz ile terminów powinno pojawić się na jednej stronie. Duże ilości mogą spowolnić działanie modułu Taxonomy Manager"

msgid "Taxonomy Manager - %voc_name"
msgstr "Menedżer taksonomii - %voc_name"

msgid "No terms available"
msgstr "Brak dostępnych terminów"

