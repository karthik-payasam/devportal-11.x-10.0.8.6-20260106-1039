msgid "Schema.org: HowTo"
msgstr "Schema.org: HowTo"

msgid "RECOMMENDED BY GOOGLE. A description of the how-to."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Nasıl yapılır bilgisinin açıklaması."

msgid "RECOMMENDED BY GOOGLE. The estimated cost of the supplies consumed when performing instructions."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Yönergeler gerçekleştirilirken tüketilen malzemelerin tahmini maliyeti."

msgid "Globally unique id of the how to, usually a url."
msgstr "Nasıl yapılır öğesinin genel olarak benzersiz tanıtıcısı, genellikle bir url'dir."

msgid "RECOMMENDED BY GOOGLE. Image of the completed how-to."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Tamamlanan nasıl yapılır bilgisinin resmi."

msgid "REQUIRED BY GOOGLE. The title of the how-to. For example, 'How to tie a tie'."
msgstr "GOOGLE İÇİN ZORUNLU. Nasıl yapılır bilgisinin başlığı. Örneğin, 'Kravat nasıl bağlanır?'."

msgid "REQUIRED BY GOOGLE. An array of HowToStep elements which comprise the full instructions of the how-to."
msgstr "GOOGLE İÇİN ZORUNLU. Nasıl yapılır bilgisinin tüm yönergelerini oluşturan bir Nasıl Yapılır Adımı öğeleri dizisi."

msgid "RECOMMENDED BY GOOGLE. A supply consumed when performing instructions or a direction."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Yönergeler ya da talimat gerçekleştirilirken tüketilen bir malzeme."

msgid "RECOMMENDED BY GOOGLE. An object used (but not consumed) when performing instructions or a direction."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Yönergeler ya da talimat gerçekleştirilirken kullanılan (ancak tüketilmeyen) bir nesne."

msgid "REQUIRED. The type of page."
msgstr "ZORUNLU. Sayfa tipi."

msgid "The URL of the how-to."
msgstr "Nasıl yapılır öğesinin URL'si."

