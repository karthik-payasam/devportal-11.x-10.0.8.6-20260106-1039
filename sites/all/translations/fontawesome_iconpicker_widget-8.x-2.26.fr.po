msgid "Font Awesome IconPicker"
msgstr "Sélecteur d'icône Font Awesome"

msgid "The fontIconPicker library is installed."
msgstr "La bibliothèque de sélection fontIcon est installée."

msgid "Not installed"
msgstr "Non installé"

msgid "The fontIconPicker library could not be found. To use the Font Awesome Iconpicker, please verify that the fontIconPicker library is installed correctly. Please see the Font Awesome Iconpicker submodule README file for more details."
msgstr "La bibliothèque de sélection fontIcon est introuvable. Pour utiliser Font Awesome Iconpicker, vérifiez que la bibliothèque de sélection fontIcon est correctement installée. Pour plus de détails, consultez le fichier README du sous-module Font Awesome Iconpicker."

msgid "Font Awesome Iconpicker Widget"
msgstr "Widget de sélecteur d'icône Font Awesome"

msgid "Provides an iconpicker widget for Font Awesome"
msgstr "Fournit un widget iconpicker pour Font Awesome"

msgid "IconPicker already present at @path. No download required."
msgstr "IconPicker déjà présent dans @path. Aucun téléchargement requis."

msgid "Drush was unable to download the fontIconPicker library from @remote."
msgstr "Drush n'a pas pu télécharger la bibliothèque de sélection fontIcon à partir de @remote."

msgid "Error: unable to download fontIconPicker library from @remote"
msgstr "Erreur : impossible de télécharger la bibliothèque de sélection fontIcon à partir de @remote"

msgid "fontIconPicker library has been successfully downloaded to @path."
msgstr "La bibliothèque de sélection fontIcon a été téléchargée dans @path."

msgid "Drush was unable to load the fontIconPicker) library"
msgstr "Drush n'a pas pu charger la bibliothèque de sélection fontIcon"

msgid "Icon Name"
msgstr "Nom de l'icône"

msgid "Invalid icon"
msgstr "Icône non valide"

