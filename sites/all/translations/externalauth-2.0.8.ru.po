msgid "External Authentication Map"
msgstr "Карта внешней идентификации"

msgid "Provider"
msgstr "Поставщик"

msgid "The name of the authentication provider providing the authname."
msgstr "Имя провайдера идентификации, предоставляющего имя идентификации."

msgid "Authname"
msgstr "Имя идентификации"

msgid "Unique authentication name provided by authentication provider."
msgstr "Уникальное имя идентификации, предоставленное провайдером идентификации."

msgid "About"
msgstr "Информация"

msgid "Authenticates users using an external site / service and stores identification details."
msgstr "Идентифицирует пользователей через внешний сайт/службу и хранит идентификационные данные."

msgid "External Authentication"
msgstr "Внешняя идентификация"

msgid "Helper module to authenticate users using an external site / service and storing identification details"
msgstr "Вспомогательный модуль для идентификации пользователей через внешний сайт/службу и хранения идентификационных данных"

msgid "User authentication"
msgstr "Идентификация пользователей"

msgid "External registration of user %name from provider %provider and authname %authname"
msgstr "Внешняя регистрация пользователя %name от провайдера %provider и authname %authname"

msgid "External login of user %name"
msgstr "Внешний вход пользователя %name"

msgid "User’s users.uid."
msgstr "users.uid пользователя."

msgid "Unique authentication name."
msgstr "Уникальное имя идентификации."

msgid "Module which is controlling the authentication."
msgstr "Модуль, управляющий идентификацией."

msgid "delete"
msgstr "удалить"

msgid "Output the URL as text"
msgstr "Вывести URL как текст"

msgid "Use absolute link (begins with \"http://\")"
msgstr "Использовать абсолютный путь (начиная с \"http://\")"

msgid "Enable this option to output an absolute link. Required if you want to use the path as a link destination."
msgstr "Включите эту опцию, чтобы вывести абсолютную ссылку. Требуется, если вы хотите использовать путь в качестве места назначения ссылки."

