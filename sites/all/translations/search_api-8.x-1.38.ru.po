msgstr "Удалить"

msgid "Save changes"
msgstr "Сохранить изменения"

msgid "%field_id is a reserved value and cannot be used as the machine name of a normal field."
msgstr "%field_id - это зарезервированное значение и его нельзя использовать в качестве имени системы в обычном поле."

msgid "Field IDs have to contain non-underscore characters."
msgstr "ИД полей должны содержать символы без подчеркивания."

msgid "Field IDs must contain only lowercase letters, numbers and underscores."
msgstr "ИД полей должны содержать только буквы с нижнем регистре, цифры и символы подчеркивания."

msgid "Field ID %field_id is used multiple times. Field IDs must be unique."
msgstr "ИД поля %field_id используется несколько раз. ИД полей должны быть уникальными."

msgid "The field with ID %field_id does not exist anymore."
msgstr "Поле с ИД %field_id больше не существует."

msgid "The type of field %field (%field_id) cannot be changed."
msgstr "Невозможно изменить тип поля %field (%field_id). "

msgid "The changes were successfully saved."
msgstr "Изменения успешно сохранены."

msgid "All content was scheduled for <a href=\":url\">reindexing</a> so the new settings can take effect."
msgstr "Запланирована <a href=\":url\">переиндексация</a> контента, чтобы новые настройки вступили в силу."

