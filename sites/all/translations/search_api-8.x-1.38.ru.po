msgstr "Источник данных"

msgid "Select one or more datasources of items that will be stored in this index."
msgstr "Выберите один или несколько источников данных для элементов, которые будут храниться в этом индексе."

msgid "Configure"
msgstr "Настроить"

msgid "Select the type of tracker which should be used for keeping track of item changes."
msgstr "Выберите тип функции отслеживания, который должен использоваться для отслеживания изменений элементов."

msgid "Select the server this index should use. Indexes cannot be enabled without a connection to a valid, enabled server."
msgstr "Выберите сервер, который должен использоваться данным индексом. Индексы нельзя включать без подключения к допустимому включенному серверу."

msgid "- No server -"
msgstr "- Без сервера -"

msgid "Only enabled indexes can be used for indexing and searching. This setting will only take effect if the selected server is also enabled."
msgstr "Для индексации и поиска можно использовать только включенные индексы. Этот параметр действует только в том случае, если выбранный сервер также включен."

msgid "Enter a description for the index."
msgstr "Введите описание индекса."

msgid "Index options"
msgstr "Настройки индексирования"

msgid "Read only"
msgstr "Только чтение"

msgid "Do not write to this index or track the status of items in this index."
msgstr "Не следует выполнять запись в этот индекс или отслеживать состояние элементов в этом индексе."

msgid "Immediately index new or updated items instead of waiting for the next cron run. This might have serious performance drawbacks and is generally not advised for larger sites."
msgstr "Выполнять индексацию новых или обновленных элементов сразу, а не при следующем выполнении задания cron. Это может существенно снизить производительность и, как правило, не рекомендуется для больших сайтов."

msgid "Set how many items will be indexed at once when indexing items during a cron run. \"0\" means that no items will be indexed by cron for this index, \"-1\" means that cron should index all items at once."
msgstr "Укажите число элементов, индексируемых за одно выполнение задания cron. Значение \"0\" означает, что элементы индексироваться не будут, \"-1\" означает, что за один раз должны проиндексироваться все элементы."

msgid "Configure the %datasource datasource"
msgstr "Настройки источника данных \"%datasource\""

msgid "Please configure the used datasources."
msgstr "Настройте используемый источник данных."

msgid "The tracker plugin is missing or invalid."
msgstr "Модуль отслеживания отсутствует или недопустим."

msgid "Configure the %plugin tracker"
msgstr "Настройки трекера \"%plugin\""

msgid "Please configure the used tracker."
msgstr "Настройте используемый модуль отслеживания."

msgid "Save and add fields"
msgstr "Сохранить и добавить поля"

msgid "The index was successfully saved."
msgstr "Индекс успешно сохранён."

msgid "The index could not be saved."
msgstr "Не удалось сохранить индекс."

msgid "It is recommended not to use this processor with the selected server."
msgstr "Не рекомендуется использовать этот процессор с выбранным сервером."

msgid "Manage processors for search index %label"
msgstr "Управление процессорами поискового индекса %label"

msgid "Configure processors which will pre- and post-process data at index and search time. Find more information on the <a href=\":url\" target=\"_blank\">processors documentation page</a>."
msgstr "Настроить процессоры для предварительной и заключительной обработки данных во время индексации и поиска. Дополнительная информация приведена на странице <a href=\":url\" target=\"_blank\">документации по процессорам</a>."

msgid "Processor order"
msgstr "Порядок процессоров"

msgid "Weight for processor %title"
msgstr "Весовой коэффициент процессора %title"

msgid "The indexing workflow was successfully edited."
msgstr "Поток операций индексации успешно изменен."

msgid "No values were changed."
msgstr "Значения не изменены."

msgid "Processor %id specifies a non-existing class %class."
msgstr "Процессор %id задает несуществующий класс %class."

msgid "Are you sure you want to rebuild the tracking data for the search index %name?"
msgstr "Вы действительно хотите перекомпоновать отслеживаемые данные для индекса поиска %name?"

msgid "<p>The complete information about existing and indexed items for this index will be deleted and will have to be rebuilt.</p><p>This should usually not be necessary, but can help if some existing items aren't contained in the index's tracking data for whatever reason (in other words, when the total number of items to be indexed is less than it should be).</p><p>This action cannot be undone.</p>"
msgstr "<p>Полная информация о существующих и проиндексированных элементах этого индекса будет удалена и для нее потребуется перекомпоновка.</p><p>Обычно в этом нет необходимости, но такое действие может помочь, если некоторые существующие элементы по какой-либо причине не содержатся в данных отслеживания индекса (другими словами, если общее число индексируемых элементов меньше требуемого).</p><p>Это действие нельзя будет отменить.</p>"

msgid "The tracking information for search index %name will be rebuilt."
msgstr "Информация об отслеживании индекса поиска %name будет перекомпонована."

msgid "Are you sure you want to reindex the search index %name?"
msgstr "Вы действительно хотите выполнить повторную индексацию индекса поиска %name?"

msgid "Indexed data will remain on the search server until all items have been reindexed. Searches on this index will continue to yield results. This action cannot be undone."
msgstr "Индексированные данные останутся на сервере поиска до тех пор, пока все элементы не будут переиндексированы. Поиск по этому индексу будет продолжен для получения результатов. Это действие нельзя будет отменить."

msgid "The search index %name was successfully queued for reindexing."
msgstr "Индекс поиска %name успешно добавлен в очередь для переиндексации."

msgid "Failed to queue items for reindexing on search index %name."
msgstr "Не удалось добавить элементы в очередь для переиндексации для индекса поиска %name."

msgid "Track items for index"
msgstr "Отслеживать элементы для индекса"

msgid "Not all items have been tracked for this index. This means the displayed index status is incomplete and not all items will currently be indexed."
msgstr "Для этого индекса не удалось отследить все элементы. Это означает, что отображаемое состояние индекса - не завершено, а также что не все элементы будут проиндексированы в данный момент."

msgid "Track now"
msgstr "Отслеживать"

msgid "Start indexing now"
msgstr "Запустить индексирование"

msgid "all"
msgstr "все"

msgid "all"
msgstr "все"

msgid "all"
msgstr "все"

msgid "all"
msgstr "все"

msgid "Index @limit items in batches of @batch_size items"
msgstr "Индексировать @limit элемент(ов) пачками по @batch_size элемент(ов)"

msgid "Number of items to index"
msgstr "Количество элементов для индексирования"

msgid "Number of items per batch run"
msgstr "Количество элементов для выполнения одной пакетной операции"

msgid "Index now"
msgstr "Индексировать сейчас"

msgid "Queue all items for reindexing"
msgstr "Поставить все элементы в очередь на переиндексацию"

msgid "Clear all indexed data"
msgstr "Очистить все проиндексированные данные"

msgid "Rebuild tracking information"
msgstr "Повторно создать информацию об отслеживании"

msgid "Enter a non-zero integer. Use \"-1\" or \"@all\" for \"all items\"."
msgstr "Введите целое число, не равное 0. Значения \"-1\" и \"@all\" обозначают \"все элементы\"."

msgid "Failed to create a batch, please check the batch size and limit."
msgstr "Не удалось создать пакет, проверьте правильность размера пакета и предельного значения."

msgid "Are you sure you want to clear all indexed data from the search server %name?"
msgstr "Вы действительно хотите очистить все проиндексированные данные на сервере поиска %name?"

msgid "This will permanently remove all data currently indexed on this server for indexes that aren't read-only. Items are queued for reindexing. Until reindexing occurs, searches for the affected indexes will not return any results. This action cannot be undone."
msgstr "Данная операция окончательно удалит все проиндексированные на текущий момент данные на этом сервере для индексов, доступных не только для чтения. Элементы помещены в очередь для повторной индексации. На время выполнения повторной индексации поиск в задействованных индексах не будет возвращать никаких результатов. Это действие нельзя будет отменить."

msgid "All indexed data was successfully deleted from the server."
msgstr "Все проиндексированные данные успешно удалены с сервера."

msgid "Indexed data could not be cleared for some indexes. Check the logs for details."
msgstr "Не удалось выполнить очистку проиндексированных данных для некоторых индексов. Дополнительные сведения содержатся в протоколах."

msgid "Failed to mark the following indexes for reindexing: @indexes. Check the logs for details."
msgstr "Не удалось пометить для повторной индексации следующие индексы: @indexes. Дополнительные сведения содержатся в протоколах."

msgid "Are you sure you want to delete the search server %name?"
msgstr "Вы действительно хотите удалить сервер поиска %name?"

msgid "Deleting a server will disable all its indexes and their searches."
msgstr "При удалении сервера будут отключены все его индексы и результаты поиска."

msgid "The search server %name has been deleted."
msgstr "Сервер поиска %name удален."

msgid "Are you sure you want to disable the search server %name?"
msgstr "Вы действительно хотите отключить сервер поиска %name?"

msgid "Disabling a server will also disable all attached indexes, clearing their tracking tables and indexed data. When re-enabling the server and its indexes, all data will have to be re-indexed. This action cannot be undone."
msgstr "При отключении сервера будут отключены все подключенные индексы, а также будет выполнена очистка таблиц отслеживания и проиндексированных данных. При повторном включении сервера и его индексов потребуется повторная индексация всех данных. Это действие нельзя будет отменить."

msgid "The search server %name has been disabled."
msgstr "Сервер поиска %name отключен."

msgid "Add search server"
msgstr "Добавить сервер поиска"

msgid "Edit search server %label"
msgstr "Изменить сервер поиска %label"

msgid "Server name"
msgstr "Название сервера"

msgid "Enter the displayed name for the server."
msgstr "Введите отображаемое имя для сервера."

msgid "Only enabled servers can index items or execute searches."
msgstr "Выполнять поиск и индексировать элементы могут только включенные серверы."

msgid "Enter a description for the server."
msgstr "Введите описание сервера."

msgid "Backend"
msgstr "Базовая программа"

msgid "Choose a backend to use for this server."
msgstr "Выберите базовую программу для работы с этим сервером."

msgid "There are no backend plugins available for the Search API. Please install a <a href=\":url\">module that provides a backend plugin</a> to proceed."
msgstr "Для API поиска нет доступных модулей базовых программ. Для продолжения установите <a href=\":url\">модуль, предоставляющий компонент базовой программы</a>."

msgid "Please configure the selected backend."
msgstr "Настройте выбранную базовую программу."

msgid "Configure %plugin backend"
msgstr "Настроить базовую программу %plugin"

msgid "The backend plugin is missing or invalid."
msgstr "Модуль базовой программы отсутствует или недопустим."

msgid "The server was successfully saved."
msgstr "Сервер успешно сохранён."

msgid "The server could not be saved."
msgstr "Не удалось сохранить сервер."

msgid "Pending server tasks"
msgstr "Ожидающие задачи сервера"

msgid "Pending tasks are created when operations on the server, such as deleting one or more items, cannot be executed because the server is currently unavailable (which will usually also create an entry in the Drupal logs). They are automatically tried again before any other operation is executed and the operation is aborted if the tasks could still not be executed, or if there are too many pending tasks to be executed in a single page request. In the latter case, you can use this form to manually execute all tasks and thus unblock the server again."
msgstr "Ожидающие задачи создаются при невозможности выполнения операций на сервере, таких как удаление одного или нескольких элементов, из-за недоступности сервера в данный момент (обычно при этом также создается запись в протоколе Drupal). Они автоматически повторяют попытку выполнения перед другой операцией, при этом операция прерывается, если задачу все еще не удается выполнить либо если в одном запросе страницы необходимо выполнить слишком много ожидающих задач. В последнем случае можно с помощью данной формы вручную выполнить все задачи и таким образом разблокировать сервер."

msgid "Execute tasks now"
msgstr "Выполнить задачи"

msgid "Delete all indexed data on this server"
msgstr "Удалить все проиндексированные данные с этого сервера"

msgid "There is currently @count task pending for this server."
msgid_plural "There are currently @count tasks pending for this server."
msgstr[0] "В данный момент на этом сервере обнаружена @count ожидающая задача."
msgstr[1] "В данный момент на этом сервере обнаружено ожидающих задач: @count."
msgstr[2] "В данный момент на этом сервере обнаружено ожидающих задач: @count."

msgid "This index is being edited by user @user, and is therefore locked from editing by others. This lock is @age old. Click here to <a href=\":url\">break this lock</a>."
msgstr "В данный момент пользователь @user редактирует этот индекс, поэтому индекс заблокирован для редактирования другими пользователями. Время этой блокировки: @age. Щелкните <a href=\":url\">здесь для снятия этой блокировки</a>."

msgid "You have unsaved changes."
msgstr "Есть несохранённые изменения."

msgid "My parse mode"
msgstr "Мой режим анализа"

msgid "Some information about my parse mode"
msgstr "Сведения о режиме анализа"

msgid "HTML text (Search API)"
msgstr "Текст HTML (API поиска)"

msgid "Text (Search API)"
msgstr "Текст (API поиска)"

msgid "Boolean"
msgstr "Логическое"

msgid "Boolean fields can only have one of two values: true or false."
msgstr "В булевских полях могут указывать только два значения: true или false."

msgid "Date"
msgstr "Дата"

msgid "Represents points in time."
msgstr "Представляет моменты времени."

msgid "Decimal"
msgstr "Десятичное число"

msgid "Contains numeric, typically non-integer values."
msgstr "Содержит числовые значения, обычно нецелочисленные."

msgid "Integer"
msgstr "Целое число"

msgid "Contains integer values."
msgstr "Содержит целочисленные значения."

msgid "String"
msgstr "Строка"

msgid "String fields are used for short, keyword-like character strings where you only want to find complete field values, not individual words."
msgstr "Строковые поля применяются для коротких символьных строк, например ключевых слов, для которых требуется найти только полное значение поля, и не применяются для отдельных слов."

msgid "Fulltext"
msgstr "Полнотекстовый"

msgid "Fulltext fields are analyzed fields which are made available for fulltext search. This data type should be used for any fields (usually with free text input by users) which you want to search for individual words."
msgstr "Полнотекстовые поля - это анализируемые поля, сделанные доступными для полнотекстового поиска. Этот тип данных должен использоваться для любых полей (как правило, со свободным вводом текста пользователями), в которых требуется выполнить поиск по отдельным словам."

msgid "Which bundles should be indexed?"
msgstr "Какие бандлы надо индексировать?"

msgid "Only those selected"
msgstr "Только выбранные"

msgid "All except those selected"
msgstr "Все кроме выбранных"

msgid "Which languages should be indexed?"
msgstr "Какие языки надо индексировать?"

msgid "Go to changed %entity_type with ID \"@entity_id\""
msgstr "Перейти к измененному %entity_type с ИД \"@entity_id\""

msgid "Provides %entity_type entities for indexing and searching."
msgstr "Предоставляет записи (кол-во записей: %entity_type) для индексирования и поиска."

msgid "View %view_name, display %display_title"
msgstr "Представление: %view_name, окно: %display_title"

msgid "%view_description – Represents the display %display_title of view %view_name."
msgstr "%view_description – представляет собой окно %display_title представления %view_name."

msgid "Represents the display %display_title of view %view_name."
msgstr "Представляет собой окно %display_title представления %view_name."

msgid "Direct query"
msgstr "Прямой запрос"

msgid "Don't parse the query, just hand it to the search server unaltered. Might fail if the query contains syntax errors in regard to the specific server's query syntax."
msgstr "Не анализировать запрос, просто передать его на сервер поиска неизмененным. Возможен сбой при наличии синтаксических ошибок в запросе в части синтаксиса запроса конкретного сервера."

msgid "Single phrase"
msgstr "Одиночная фраза"

msgid "The query is interpreted as a single phrase, possibly containing spaces or special characters, that should appear exactly like this in the results."
msgstr "Запрос интерпретируется как одиночная фраза, возможно, содержащая пробелы или специальные символы, которые должны в точности перенестись в результаты."

msgid "Multiple words"
msgstr "Несколько слов"

msgid "Select the fields to which hierarchical data should be added."
msgstr "Выберите поля, в которые необходимо добавить иерархические данные."

msgid "Hierarchy property to use"
msgstr "Свойство используемой структуры"

msgid "This field has several nested properties which look like they might contain hierarchy data for the field. Please pick the one that should be used."
msgstr "В этом поле есть несколько вложенных свойств, которые выглядят как содержащие иерархические данные для поля. Выберите свойство для использования."

msgid "You need to select a nested property to use for the hierarchy data."
msgstr "Необходимо выбрать вложенное свойство для иерархических данных."

msgid "You need to select at least one field for which to add hierarchy data."
msgstr "Необходимо выбрать хотя бы одно поле, для которого требуется добавить иерархические данные."

msgid "Index hierarchy"
msgstr "Индексация иерархии"

msgid "Allows the indexing of values along with all their ancestors for hierarchical fields (like taxonomy term references)"
msgstr "Позволяет индексировать значений вместе со всеми родительскими полями для иерархических полей (например указателей на термины таксономии)"

msgid "URI"
msgstr "URI"

msgid "A URI where the item can be accessed"
msgstr "URI для доступа к элементу"

msgid "URL field"
msgstr "Поле URL"

msgid "Adds the item's URL to the indexed data."
msgstr "Добавляет URL элемента в индексированные данные."

msgid "Aggregated field"
msgstr "Объединенное поле"

msgid "An aggregation of multiple other fields."
msgstr "Объединение нескольких других полей."

msgid "Aggregated fields"
msgstr "Агрегированные поля"

msgid "Add customized aggregations of existing fields to the index."
msgstr "Добавить настроенные объединения существующих полей в индексы."

msgid "Node access information"
msgstr "Информация о доступе к узлу"

msgid "Data needed to apply node access."
msgstr "Данные, необходимые для доступа к узлу."

msgid "You have no access to any results in this search."
msgstr "У вас нет доступа ни к каким результатам в этом поиске."

msgid "An illegal user UID was given for node access: @uid."
msgstr "Для доступа к узлу предоставлен недопустимый UID пользователя: @uid."

msgid "Content access"
msgstr "Доступ к материалу"

msgid "Adds content access checks for nodes and comments."
msgstr "Добавляет проверки доступа к содержимому для узлов и комментариев."

msgid "Entity status"
msgstr "Статус сущности"

msgid "Entity type"
msgstr "Тип сущности"

msgid "Highlight returned field data"
msgstr "Выделить данные возвращенных полей"

msgid "Select whether returned fields should be highlighted."
msgstr "Укажите, следует ли выделять возвращенные поля."

msgid "Always"
msgstr "Всегда"

msgid "If the server returns fields"
msgstr "Возвращает ли сервер поля"

msgid "Never"
msgstr "Никогда"

msgid "Highlight partial matches"
msgstr "Выделить частичные совпадения"

msgid "When enabled, matches in parts of words will be highlighted as well."
msgstr "Если включено, совпадающие части слов выделяются цветом."

msgid "Create excerpt"
msgstr "Создать фрагмент"

msgid "Excerpt length"
msgstr "Длина фрагмента"

msgid "Exclude fields from excerpt"
msgstr "Исключить поля из фрагмента"

msgid "Exclude certain fulltext fields from being included in the excerpt."
msgstr "Исключить некоторые полнотекстовые поля из включенных во фрагмент."

msgid "Highlighting prefix"
msgstr "Префикс выделения цветом"

msgid "Highlighting suffix"
msgstr "Суффикс выделения цветом"

msgid "… @excerpt … @excerpt …"
msgstr "… @excerpt … @excerpt …"

msgid "A PCRE error (#%error_num) occurred during results highlighting."
msgstr "При выделении результатов произошла ошибка PCRE (#%error_num). "

msgid "Highlight"
msgstr "Подсвеченный"

msgid "Adds a highlighted excerpt to results and highlights returned fields."
msgstr "Добавляет выделенный фрагмент в результаты и выделяет возвращенные поля."

msgid "Index title attribute"
msgstr "Индексировать атрибут title"

msgid "If set, the contents of title attributes will be indexed."
msgstr "Если задано, будет проиндексировано содержимое атрибутов title."

msgid "Index alt attribute"
msgstr "Индексировать атрибут alt"

msgid "If set, the alternative text of images will be indexed."
msgstr "Если задано, будет индексироваться альтернативный текст для изображений."

msgid "Specify special boost values for certain HTML elements, in <a href=\":url\">YAML file format</a>. The boost values of nested elements are multiplied, elements not mentioned will have the default boost value of 1. Assign a boost of 0 to ignore the text content of that HTML element."
msgstr "Укажите специальные значения параметра boost для определенных элементов HTML <a href=\":url\">формате файла YAML</a>. Значения параметра boost вложенных элементов перемножаются, элементам, которые не были упомянуты, присваивается значение boost по умолчанию (1). Присвойте значение boost, равное 0, для игнорирования текстового контекста такое элемента HTML."

msgid "Tags is not a valid YAML map. See @link for information on how to write correctly formed YAML."
msgstr "Теги не являются допустимой картой связей YAML. Запись правильно сформированного YAML описана в разделе @link."

msgid "Boost value for tag @tag can't be an array."
msgstr "Значение параметра Boost для тега @tag не может быть массивом."

msgid "Boost value for tag @tag must be numeric."
msgstr "Значение параметра Boost для тега @tag должно быть числовым."

msgid "Boost value for tag @tag must be non-negative."
msgstr "Значение параметра Boost для тега @tag должно быть неотрицательным."

msgid "HTML filter"
msgstr "Фильтр HTML"

msgid "Strips HTML tags from fulltext fields and decodes HTML entities. Use this processor when indexing HTML data – for example, node bodies for certain text formats. The processor also allows to boost (or ignore) the contents of specific elements."
msgstr "Удаляет теги HTML из полнотекстовых полей и декодирует объекты HTML. Этот процессор следует применять при индексации данных HTML, например тел узлов для определенных текстовых форматов. Процессор позволяет также игнорировать содержимое указанных элементов или повысить весовой коэффициент этого содержимого."

msgid "Ignore case"
msgstr "Игнорировать регистр"

msgid "Makes searches case-insensitive on selected fields."
msgstr "Задает в выбранных полях поиск без учета регистра."

msgid "Strip by regular expression"
msgstr "Удалить с помощью регулярного выражения"

msgid "Specify characters which should be removed from fulltext fields and search strings, as a <a href=\":url\">PCRE regular expression</a>."
msgstr "Укажите символы, которые должны быть удалены из полнотекстовых полей и строк поиска как <a href=\":url\">регулярное выражение PCRE</a>."

msgid "Strip by character property"
msgstr "Выделять по свойству символа"

msgid "Specify <a href=\":url\">Unicode character properties</a> of characters to be ignored."
msgstr "Укажите <a href=\":url\">свойства символов Unicode</a> для игнорируемых символов."

msgid "Ignored character properties"
msgstr "Игнорируемые свойства символов"

msgid "The entered text is no valid regular expression."
msgstr "Введенный текст не является допустимым регулярным выражением."

msgid "Punctuation, Connector Characters"
msgstr "Пунктуация, символы-коннекторы"

msgid "Punctuation, Dash Characters"
msgstr "Пунктуация, символы тире"

msgid "Punctuation, Close Characters"
msgstr "Пунктуация, закрывающие символы"

msgid "Punctuation, Final quote Characters"
msgstr "Пунктуация, символы закрывающих кавычек"

msgid "Punctuation, Initial quote Characters"
msgstr "Пунктуация, символы открывающих кавычек"

msgid "Punctuation, Other Characters"
msgstr "Пунктуация, другие символы"

msgid "Punctuation, Open Characters"
msgstr "Пунктуация, открывающие символы"

msgid "Other, Control Characters"
msgstr "Прочее, управляющие символы"

msgid "Other, Format Characters"
msgstr "Прочее, символы форматирования"

msgid "Other, Private Use Characters"
msgstr "Прочее, символы частного использования"

msgid "Mark, Spacing Combining Characters"
msgstr "Пометка, интервал между символами комбинирования"

msgid "Mark, Enclosing Characters"
msgstr "Пометка, ограничение ширины знаков"

msgid "Mark, Nonspacing Characters"
msgstr "Пометка, неразделяемые символы"

msgid "Symbol, Currency Characters"
msgstr "Символ, символы валюты"

msgid "Symbol, Modifier Characters"
msgstr "Символ, символ модификатора"

msgid "Symbol, Math Characters"
msgstr "Символ, математические символы"

msgid "Symbol, Other Characters"
msgstr "Символ, прочие символы"

msgid "Separator, Line Characters"
msgstr "Разделитель, символы строк"

msgid "Separator, Paragraph Characters"
msgstr "Разделитель, символы абзаца"

msgid "Separator, Space Characters"
msgstr "Разделитель, символы пробелов"

msgid "Ignore characters"
msgstr "Игнорировать символы"

msgid "Configure types of characters which should be ignored for searches."
msgstr "Настроить типы символов, которые должны быть проигнорированы при поиске."

msgid "Language (with fallback)"
msgstr "Язык (с возможностью переключения)"

msgid "The item language, or a language the item is a fallback for."
msgstr "Язык элемента или резервный язык элемента. "

msgid "Adds the item's language to the indexed data, and considers language fallbacks."
msgstr "Добавляет язык элемента в индексируемые данные и учитывает резервные языки. "

msgid "Ignore"
msgstr "Игнорировать"

msgid "Boost factor"
msgstr "Буст-фактор"

msgid "Aggregation"
msgstr "Сбор новостей"

msgid "maximum"
msgstr "максимальное"

msgid "minimum"
msgstr "минимальное"

msgid "average"
msgstr "средне"

msgid "sum"
msgstr "сум"

msgid "product"
msgstr "товар"

msgid "use first value"
msgstr "использовать первое значение"

msgid "Select the method of aggregation to use in case the field has multiple values."
msgstr "Выберите метод объединения для использования в случае многозначного поля."

msgid "Number field-based boosting"
msgstr "Повышение значимости на основе числового поля"

msgid "Adds a boost to indexed items based on the value of a numeric field."
msgstr "Добавляет значимость к индексированным элементам на основе значения числового поля."

msgid "Rendered HTML output"
msgstr "Выведенный HTML"

msgid "The complete HTML which would be displayed when viewing the item"
msgstr "Полный HTML, который должен отображаться при показе элемента"

msgid "Field settings"
msgstr "Настройки поля"

msgid "The field %field_label (%field_id) on index %index is missing view mode configuration for some datasources or bundles. Please review (and re-save) the field settings."
msgstr "В поле %field_label (%field_id) из индекса %index отсутствует конфигурация режима просмотра для отдельных источников данных или комплектов. Проверьте (и повторно сохраните) параметры поля. "

msgid "Adds an additional field containing the rendered item as it would look when viewed."
msgstr "Добавляет поле, содержащее выведенный элемент в том виде, в каком он будет отображаться при просмотре."

msgid "Reverse reference: %entity_type using %property"
msgstr "Обратная ссылка: %entity_type с %property"

msgid "All %entity_type entities that reference this item via the %property field."
msgstr "Все объекты %entity_type, связанные с этим элементом с помощью поля %property."

msgid "Reverse entity references"
msgstr "Обратные ссылки на объекты"

msgid "Allows indexing of entities that link to the indexed entity."
msgstr "Разрешает индексацию объектов, содержащих ссылки на проиндексированный объект."

msgid "Role-based access information"
msgstr "Информация о доступе на основе ролей"

msgid "Data needed to apply role-based item access"
msgstr "Данные, необходимые для применения ролевого доступа к элементам"

msgid "Role-based access checks could not be added to a search query on index %index since the required field is not available. Please re-save the index."
msgstr "Не удалось добавить проверки ролевого доступа к запросу на поиск в индексе %index, так как обязательное поле недоступно. Сохраните индекс повторно."

msgid "Role-based access"
msgstr "Доступ на основе ролей"

msgid "Which users should be indexed?"
msgstr "Какие пользователи должны быть проиндексированы?"

msgid "All but those from one of the selected roles"
msgstr "Все, кроме одной из выбранных ролей"

msgid "Only those from the selected roles"
msgstr "Только выбранные роли"

msgid "Roles"
msgstr "Роли"

msgid "Role filter"
msgstr "Фильтр ролей"

msgid "Filters out users based on their role."
msgstr "Отфильтровать пользователей на основе их ролей."

msgid "If the <a href=\"http://snowball.tartarus.org/algorithms/english/stemmer.html\">algorithm</a> does not stem words in your dataset in the desired way, you can enter specific exceptions in the form of WORD=STEM, where \"WORD\" is the original word in the text and \"STEM\" is the resulting stem. List each exception on a separate line."
msgstr "Если <a href=\"http://snowball.tartarus.org/algorithms/english/stemmer.html\">алгоритм</a> не создает основы слов в наборе данных должным образом, можно указать конкретные исключения в формате WORD=STEM, где \"WORD\" - исходное слово в тексте, а \"STEM\" - результирующая основа. Каждое исключение указывается на отдельной строке."

msgid "Exceptions"
msgstr "Исключения"

msgid "The entered text is not in valid WORD=STEM format."
msgstr "Текст введен не в допустимом формате WORD=STEM."

msgid "Stemmer"
msgstr "Функция определения основы"

msgid "Enter a list of stopwords, each on a separate line, that will be removed from content before it is indexed and from search terms before searching. <a href=\":url\">More info about stopwords.</a>."
msgstr "Введите список игнорируемых слов, которые будут удаляться из материалов перед их индексацией и из условий поиска перед операцией поиска. <a href=\":url\">Дополнительная информация об игнорируемых словах.</a>."

msgid "Stopwords"
msgstr "Стоп-слова"

msgid "Allows you to define stopwords which will be ignored in searches. <strong>Caution:</strong> Only use after both 'Ignore case' and 'Tokenizer' have run."
msgstr "Позволяет определять слова, которые будут игнорироваться при поиске. <strong>Внимание:</strong> применяется только после выполнения обеих функций 'Игнорировать регистр' и 'Программа разбиения на лексемы'."

msgid "Ignored characters"
msgstr "Игнорируемые символы"

msgid "Whitespace characters"
msgstr "Символы пробелов"

msgid "Specify the characters that should be regarded as whitespace and therefore used as word-delimiters. Specify the characters as the inside of a <a href=\":pcre-url\">PCRE character class</a>. Leave empty to use a <a href=\":doc-url\">default</a> which should be suitable for most languages with a Latin alphabet."
msgstr "Укажите символы, которые будут использоваться в качестве пробелов и, таким образом, будут применяться как разделители слов. Укажите символы как в <a href=\":pcre-url\">классе символов PCRE</a>. Оставьте поле пустым для использования <a href=\":doc-url\">значений по умолчанию</a>, которые должны подходить для большинства языков, использующих латинский алфавит."

msgid "Simple CJK handling"
msgstr "Простая обработка CJK"

msgid "Whether to apply a simple Chinese/Japanese/Korean tokenizer based on overlapping sequences. Does not affect other languages."
msgstr "Следует ли применять простую программу разбиения на лексемы китайского/японского/корейского языка на основе перекрывающихся последовательностей. Не влияет на другие языки."

msgid "Minimum word length to index"
msgstr "Минимальная длина слова для индексации"

msgid "The number of characters a word has to be to be indexed. A lower setting means better search result ranking, but also a larger database. Each search query must contain at least one keyword that is this size (or longer)."
msgstr "Минимальное количество знаков в словах которые будут индексироваться. Меньшее количество знаков позволяет улучшить качество поиска, но одновременно увеличивает размер индекса. Поисковый запрос не может состоять из меньшего количества знаков."

msgid "The entered text is no valid PCRE character class."
msgstr "Введенный текст не является допустимым классом символов PCRE."

msgid "Tokenizer"
msgstr "Программа разбиения на лексемы"

msgid "Splits text into individual words for searching."
msgstr "Разделяет текст на отдельные слова для поиска."

msgid "Transliteration"
msgstr "Транслитерация"

msgid "Makes searches insensitive to accents and other non-ASCII characters."
msgstr "Выполняет поиск без учета акцентов и других символов, не относящихся к ASCII."

msgid "Use datasource default"
msgstr "Использовать источники данных по умолчанию"

msgid "Boost settings for %datasource"
msgstr "Параметры функции Boost для %datasource"

msgid "Default boost for items from this datasource"
msgstr "Параметры boost по умолчанию для элементов из этого источника данных"

msgid "Boost for the %bundle bundle"
msgstr "Функция Boost для комплекта %bundle"

msgid "Type-specific boosting"
msgstr "Функция boost для конкретного типа"

msgid "Adds a boost to indexed items based on their datasource and/or bundle."
msgstr "Добавляет boost в индексированные элементы на основе источника данных и (или) комплекта."

msgid "Generate absolute URL"
msgstr "Создать полный URL"

msgid "Check this box to pass absolute URLs to the index. This can be useful when indexing multiple sites with a single search index."
msgstr "Выберите этот параметр, чтобы передавать полные URL в индекс. Это может применяться, если в один индекс поиска индексируются несколько сайтов."

msgid "Aggregation type"
msgstr "Тип агрегации"

msgid "Apart from the @union type, all types will result in just a single value."
msgstr "Все типы кроме типа @union дадут всего одно значение."

msgid "Union"
msgstr "Объединение"

msgid "Contained fields"
msgstr "Вложенные поля"

msgid "Machine name: @name"
msgstr "Машинное имя: @name"

msgid "A @type aggregation of the following fields: @fields."
msgstr "Объединение @type следующих полей: @fields."

msgid "Concatenation"
msgstr "Конкатенация"

msgid "Sum"
msgstr "Сумма"

msgid "Count"
msgstr "Количество"

msgid "Maximum"
msgstr "Максимум"

msgid "Minimum"
msgstr "Минимум"

msgid "First"
msgstr "Первый"

msgid "Last"
msgstr "Последний"

msgid "First letter"
msgstr "Первая буква"

msgid "The Union aggregation does an union operation of all the values of the field. 2 fields with 2 values each become 1 field with 4 values."
msgstr "Объединение Union выполняет операцию union для всех значений поля. 2 поля, в каждом из которых содержится по 2 значения станут одним полем с 4 значениями."

msgid "The Concatenation aggregation concatenates the text data of all contained fields."
msgstr "Объединение Concatenation выполняет конкатенацию текстовых данных всех вложенных полей."

msgid "The Sum aggregation adds the values of all contained fields numerically."
msgstr "Объединение Sum добавляет значения всех вложенных полей в числовом виде."

msgid "The Count aggregation takes the total number of contained field values as the aggregated field value."
msgstr "Объединение Count получает общее число значений вложенных полей в качестве значения объединенного поля."

msgid "The Maximum aggregation computes the numerically largest contained field value."
msgstr "Объединение Maximum вычисляет в числовом виде самое большое значение вложенных полей."

msgid "The Minimum aggregation computes the numerically smallest contained field value."
msgstr "Объединение Minimum вычисляет в числовом виде самое маленькое значение вложенных полей."

msgid "The First aggregation will simply keep the first encountered field value."
msgstr "Объединение First просто сохраняет первое обнаруженное значение поля."

msgid "The Last aggregation will keep the last encountered field value."
msgstr "Объединение Last сохранит последнее обнаруженное значение поля."

msgid "The “First letter” aggregation uses just the first letter of the first encountered field value as the aggregated value. This can, for example, be used to build a Glossary view."
msgstr "Объединение “Первая буква” использует в качестве объединенного значения только первую букву значения первого встреченного поля. Например, это может пригодиться для создания представления Глоссарий."

msgid "User roles"
msgstr "Роли пользователя"

msgid "Your item will be rendered as seen by a user with the selected roles. We recommend to just use \"@anonymous\" here to prevent data leaking out to unauthorized roles."
msgstr "Элемент будет выведен с точки зрения пользователя с выбранными ролями. Рекомендуется использовать здесь \"@anonymous\" для предотвращения утечки данных в неавторизованные роли."

msgid "You can choose the view modes to use for rendering the items of different datasources and bundles. We recommend using a dedicated view mode (for example, the \"Search index\" view mode available by default for content) to make sure that only relevant data (especially no field labels) will be included in the index."
msgstr "Можно выбрать режимы просмотра с целью использования для вывода элементов из других источников данных и комплектов. Рекомендуется использовать режим выделенного просмотра (например режим просмотра \"Индекс поиска\" по умолчанию доступен для материалов) для гарантии, что в индекс будут включены только значимые данные (в частности, без меток полей)."

msgid "Don't include the rendered item."
msgstr "Не включать выведенный элемент."

msgid "View mode for %datasource » %bundle"
msgstr "Режим просмотра для %datasource » %bundle"

msgid "The order in which items will be indexed."
msgstr "Порядок, в котором будут индексироваться элементы."

msgid "Index items in the same order in which they were saved"
msgstr "Индексировать элементы в том порядке, в котором они были сохранены"

msgid "Index the most recent items first"
msgstr "Индексировать сначала новые элементы"

msgid "Default index tracker which uses a simple database table for tracking items."
msgstr "Функция отслеживания индекса по умолчанию, использующий для отслеживания элементов простую таблицу базы данных."

msgid "No valid taxonomy term IDs given for \"All taxonomy term fields\" contextual filter."
msgstr "Не указаны допустимые ИД терминов таксономии для контекстного фильтра \"Все поля терминов таксономии\"."

msgid "\"All taxonomy term fields\" contextual filter could not be applied as taxonomy term %label (ID: @id) belongs to vocabulary %vocabulary, not contained in any indexed fields."
msgstr "Не удалось применить контекстный фильтр \"Все поля терминов таксономии\", поскольку термин таксономии %label (ИД: @id) из словаря %vocabulary отсутствует в индексируемых полях."

msgid "Choose how the search keys will be parsed."
msgstr "Выберите способ анализа ключей поиска."

msgid "Searched fields"
msgstr "Поисковые поля"

msgid "Select the fields that will be searched. If no fields are selected, all available fulltext fields will be searched."
msgstr "Выберите поля для поиска. Если поля не выбраны, поиск будет выполняться по всем доступным полнотекстовым полям."

msgid "Operator"
msgstr "Оператор"

msgid "Determines how multiple keywords entered for the search will be combined."
msgstr "Определяет способ объединения нескольких ключевых слов, введенных для поиска."

msgid "Contains all of these words"
msgstr "Содержит все эти слова"

msgid "Contains any of these words"
msgstr "Содержит любое из этих слов"

msgid "Fields for similarity"
msgstr "Поля для поиска похожих материалов"

msgid "Select the fields that will be used for finding similar content. If no fields are selected, all available fields will be used."
msgstr "Выберите поля для поиска похожих материалов. Если поля не выбраны, будут использоваться все доступные поля."

msgid "The search backend \"@backend_id\" does not offer \"More like this\" functionality."
msgstr "Базовая программа поиска \"@backend_id\" не предлагает функцию \"Больше похоже на следующее\"."

msgid "Allow multiple values"
msgstr "Разрешить множественные значения"

msgid "If selected, users can enter multiple values in the form of 1+2+3 (for OR) or 1,2,3 (for AND)."
msgstr "Если выбрано, пользователь сможет ввести несколько значений в виде 1+2+3 (для OR), или 1,2,3 (для AND)."

msgid "Exclude"
msgstr "Исключить"

msgid "If selected, the values entered for the filter will be excluded rather than limiting the view to those values."
msgstr "Если выбрано, то введенные значения для фильтра будут исключены и не будут использоваться для отображения только этих значений."

msgid "Search API (tag-based)"
msgstr "API поиска (на основе тегов)"

msgid "Cache results until the associated cache tags are invalidated. Useful for small sites that use the database search backend. <strong>Caution:</strong> Can lead to stale results and might harm performance for complex search pages."
msgstr "Кэшировать результаты, если связанные теги кэша не будут аннулированы. Применяется для небольших сайтов, использующих базовую программу поиска в базе данных. <strong>Внимание:</strong> может привести к устареванию результатов и снижению быстродействия для сложных страниц поиска."

msgid "Search API (time-based)"
msgstr "API поиска (на основе времени)"

msgid "Cache results for a predefined time period. Useful for sites that use external search engines such as Solr, or index multiple datasources. <strong>Caution:</strong> Will lead to stale results and might harm performance for complex search pages."
msgstr "Кэшировать результаты для заранее определенного промежутка времени. Применяется для сайтов, использующих внешние модули поиска, такие как Solr, или индексирующих несколько источников данных. <strong>Внимание:</strong> это приведет к устареванию результатов и снижению быстродействия для сложных страниц поиска."

msgid "Update this item"
msgstr "Обновить этот элемент"

msgid "Apply to selected items"
msgstr "Применить к отмеченным позициям"

msgid "Row %items removed from selection as it's not compatible with %action action."
msgid_plural "Rows %items removed from selection as they are not compatible with %action action."
msgstr[0] "Строка %items удалена из числа выбранных, поскольку она несовместима с действием %action. "
msgstr[1] "Строки %items удалены из числа выбранных, поскольку они несовместимы с действием %action."
msgstr[2] "Строки %items удалены из числа выбранных, поскольку они несовместимы с действием %action."

msgid "Display for \"@bundle\" bundle"
msgstr "Показать данные для комплекта \"@bundle\""

msgid "Hide"
msgstr "Скрыть"

msgid "Raw ID"
msgstr "Непосредственный ИД"

msgid "Only label"
msgstr "Только метка"

msgid "Entity view"
msgstr "Представление объекта"

msgid "View mode for \"@bundle\" bundle"
msgstr "Режим представления для комплекта \"@bundle\""

msgid "This will only take effect for entities for which only the entity label is displayed."
msgstr "Это повлияет только на объекты, для которых отображаются только метки объекта."

msgid "If checked, Drupal's built-in field rendering mechanism will be used for rendering this field's values, which requires the entity to be loaded. If unchecked, a type-specific, entity-independent rendering mechanism will be used."
msgstr "Если опция выбрана, встроенный механизм вывода полей Drupal будет применяться для вывода значений этих полей, для чего потребуется загрузка объекта. Если опция не выбрана, будет применяться объектно-независимый механизм вывода для конкретного типа."

msgid "Render settings"
msgstr "Параметры вывода"

msgid "Link this field to its item"
msgstr "Связать это поле с его элементом"

msgid "Display this field as a link to its original entity or item."
msgstr "Показать это поле в виде ссылки на его исходный объект или элемент."

msgid "Display field with matches of the search keywords highlighted, if available."
msgstr "Показать поле, соответствующее выделенным ключевым словам поиска (если доступно)."

msgid "Multiple values handling"
msgstr "Обработка нескольких значений"

msgid "If this field contains multiple values for an item, these settings will determine how they are handled."
msgstr "Если в поле содержится несколько значений для элемента, эти параметры будут определять способ их обработки."

msgid "Display type"
msgstr "Тип отображения"

msgid "Unordered list"
msgstr "Маркированный список"

msgid "Ordered list"
msgstr "Пронумерованный список"

msgid "Simple separator"
msgstr "Простой разделитель"

msgid "Separator"
msgstr "Разделитель"

msgid "View mode for datasource %name"
msgstr "Способ отображения источника данных %name"

msgid "This datasource doesn't have any view modes available. It is therefore not possible to display results of this datasource in this field."
msgstr "Для этого источника данных нет доступных режимов представления. Поэтому показать результаты этого источника данных в этом поле невозможно."

msgid "View mode for datasource %datasource, bundle %bundle"
msgstr "Способ отображения для источника данных %datasource и бандла %bundle"

msgid "This bundle doesn't have any view modes available. It is therefore not possible to display results of this bundle using this row plugin."
msgstr "Для этого комплекта нет доступных режимов представления. Поэтому показать результаты этого комплекта с помощью модуля строк невозможно."

msgid "Failed to load item %item_id in view %view."
msgstr "Не удалось загрузить элемент %item_id в представлении %view."

msgid "Item of unknown datasource %datasource returned in view %view."
msgstr "В %view возвращен элемент из неизвестного источника данных %datasource."

msgid "Depending on the parse mode set, some of these options might not work as expected. Please either use \"@multiple_words\" as the parse mode or make sure that the filter behaves as expected for multiple words."
msgstr "В зависимости от заданного режима анализа некоторые из этих опций могут работать непредсказуемым образом. Используйте режим анализа \"@multiple_words\" или убедитесь, что фильтр правильно работает для нескольких слов."

msgid "and"
msgstr "и"

msgid "or"
msgstr "или"

msgid "Contains none of these words"
msgstr "Не содержит эти слова"

msgid "not"
msgstr "нет"

msgid "Minimum keyword length"
msgstr "Минимальная длина ключевого слова"

msgid "Minimum length of each word in the search keys. Leave empty to allow all words."
msgstr "Минимальная длина каждого слова в ключах поиска. Для использования всех слов оставьте поле пустым."

msgid "Hint text that appears inside the field when empty."
msgstr "Текст подсказки, который появляется внутри поля, когда пусто."

msgid "Expose searched fields"
msgstr "Открыть доступ к поисковым полям"

msgid "Expose the list of searched fields. This allows users to narrow the search to the desired fields."
msgstr "Откройте доступ к списку поисковых полей. Пользователи могут сократить область поиска до указанных полей. "

msgid "This will appear in the URL after the ? to identify this searched fields form element."
msgstr "Отображается в URL после знака вопроса, чтобы отличать поисковые поля от элемента. "

msgid "Search fields"
msgstr "Поля для поиска"

msgid "You must include at least one positive keyword with @count characters or more."
msgstr "Необходимо указать хотя бы одно не исключающее ключевое слово, содержащее не менее @count символов."

msgid "contains"
msgstr "содержит"

msgid "doesn't contain"
msgstr "не содержит"

msgid "Is one of"
msgstr "Один из"

msgid "="
msgstr "="

msgid "Is all of"
msgstr "Все"

msgid "Is none of"
msgstr "Кроме"

msgid "<>"
msgstr "<>"

msgid "Is empty (NULL)"
msgstr "Пустое (NULL)"

msgid "empty"
msgstr "пусто"

msgid "Is not empty (NOT NULL)"
msgstr "Не пустое (NOT NULL)"

msgid "not empty"
msgstr "не пусто"

msgid "Skip item access checks"
msgstr "Пропустить проверки доступа к элементу"

msgid "By default, an additional access check will be executed for each item returned by the search query. However, since removing results this way will break paging and result counts, it is preferable to configure the view in a way that it will only return accessible results. If you are sure that only accessible results will be returned in the search, or if you want to show results to which the user normally wouldn't have access, you can enable this option to skip those additional access checks. This should be used with care."
msgstr "По умолчанию для каждого элемента, возвращенного поисковым запросом, будет выполняться дополнительная проверка доступа. Однако удаление результатов этим способом приведет к неправильному формированию числа страниц и результатов, предпочтительнее настраивать представление таким способом, чтобы оно возвращало только доступные результаты. Если есть уверенность, что поиск возвратит только доступные результаты, или если требуется показать результаты, к которым пользователь не имеет доступа, можно включить эту опцию для пропуска этих дополнительных проверок доступа. Эту опцию следует использовать с осторожностью."

msgid "Bypass access checks"
msgstr "Пропускать проверки доступа"

msgid "If the underlying search index has access checks enabled (for example, through the \"Content access\" processor), this option allows you to disable them for this view. This will never disable any filters placed on this view."
msgstr "Если для основного индекса поиска включена проверка доступа (например с помощью процессора \"Доступ к содержимому\"), то эта опция позволяет отключить их для данного представления. При этом никакие фильтры в этом представлении никогда не будут отключены."

msgid "Preserve facets while using filters"
msgstr "Сохранить фасеты при использовании фильтров"

msgid "If set, these tags will be appended to the query and can be used to identify the query in a module. This can be helpful for altering queries."
msgstr "Если установлено, то эта метка будет добавлена к запросу и будет возможно идентифицировать запрос в модуле. Это может быть полезно для изменения запросов."

msgid "Tried to sort results randomly on server %server which does not support random sorting."
msgstr "Выполнена попытка сортировки результатов случайным образом на сервере %server, которые не поддерживает сортировку случайным образом."

msgid "Search API Query"
msgstr "Запрос API поиска"

msgid "The query will be generated and run using the Search API."
msgstr "Запрос будет сформирован и выполнен с помощью API поиска."

msgid "Skip access checks"
msgstr "Пропустить проверки доступа"

msgid "Do not verify that the user has access to the entities referenced through this relationship. This will allow you to display data to the user to which they normally would not have access. This should therefore be used with care."
msgstr "Не следует проверять права доступа пользователя к объектам, на которые есть ссылки из этой взаимосвязи. Это позволит показать пользователю данные, к которым он обычно не имеет доступа. Поэтому эту опцию следует использовать с осторожностью."

msgid "This datasource doesn't have any view modes available. It is therefore not possible to display results of this datasource using this row plugin."
msgstr "Для этого источника данных нет доступных режимов представления. Поэтому показать результаты этого источника данных с помощью модуля строк невозможно."

msgid "Rendered entity"
msgstr "Готовая к выводу сущность"

msgid "Displays entity of the matching search API item"
msgstr "Показывает объект соответствующего элемента API поиска"

msgid "Enable on all supported fields"
msgstr "Включить для всех поддерживаемых полей"

msgid "Enable this processor for all supported fields. This will also automatically update the setting when new supported fields are added to the index."
msgstr "Включить этот процессор для всех поддерживаемых полей. При этом параметр будет обновляться автоматически при добавлении в индекс новых поддерживаемых полей."

msgid "Enable this processor on the following fields"
msgstr "Включить этот процессор для следующих полей"

msgid "Note: The Search API currently doesn't support per-field keywords processing, so this setting will be ignored when preprocessing search keywords. It is therefore usually recommended that you enable the processor for all fields that you intend to use as fulltext search fields, to avoid undesired consequences."
msgstr "Примечание: В настоящее время API поиска не поддерживает обработку ключевых слов по каждому полю, поэтому этот параметр будет игнорироваться при предварительной обработке ключевых слов поиска. Поэтому во избежание нежелательных последствий рекомендуется включать процессор для всех полей, которые планируется использовать в качестве полей полнотекстового поиска."

msgid "My Processor"
msgstr "Мой процессор"

msgid "Does … something."
msgstr "Что-то делает."

msgid "Preprocess index"
msgstr "Предварительная обработка индекса"

msgid "Preprocess query"
msgstr "Предварительная обработка запроса"

msgid "Postprocess query"
msgstr "Выполнить обработку после запроса"

msgid "An error occurred while trying to execute tasks. Check the logs for details."
msgstr "Ошибка при выполнении задач. Дополнительные сведения содержатся в протоколах."

msgid "Successfully executed @count pending task."
msgid_plural "Successfully executed @count pending tasks."
msgstr[0] "Успешно выполнена @count ожидающая задача."
msgstr[1] "Успешно выполнено ожидающих задач: @count."
msgstr[2] "Успешно выполнено ожидающих задач: @count."

msgid "My tracker"
msgstr "Функция отслеживания"

msgid "Simple tracking system."
msgstr "Простая система отслеживания."

msgid "enabled"
msgstr "включено"

msgid "There are no indexes defined. Please create an index before trying to enable it."
msgstr "Не определены индексы. Перед включением индекса его необходимо создать."

msgid "You must specify at least one index to enable."
msgstr "Необходимо указать хотя бы один индекс для включения."

msgid "There are no indexes defined. Please create an index before trying to disable it."
msgstr "Не определены индексы. Перед отключением индекса его необходимо создать."

msgid "You must specify at least one index to disable."
msgstr "Необходимо указать хотя бы один индекс для отключения."

msgid "The index @index is up to date."
msgstr "Индекс @index в актуальном состоянии."

msgid "Found @remaining items to index for @index. Indexing @limit items."
msgstr "Найдены элементы (@remaining) для индексации в @index. Выполняется индексация элементов (число элементов: @limit)."

msgid "Indexing a maximum number of @limit items (@batch_size items per batch run) for the index '@index'."
msgstr "Индексация максимального числа элементов (@limit) (при пакетном выполнении максимальное число элементов равно @batch_size) для индекса '@index'."

msgid "Couldn't create a batch, please check the batch size and limit parameters."
msgstr "Не удалось создать пакет, проверьте правильность параметров размера пакета и предельного значения."

msgid "@index was successfully cleared."
msgstr "@index успешно очищен."

msgid "@index was not found"
msgstr "@index не найден"

msgid "There are no servers present."
msgstr "Отсутствуют серверы."

msgid "The server could not be loaded."
msgstr "Не удалось загрузить сервер."

msgid "Invalid index ID \"@index_id\"."
msgstr "Недопустимый ИД индекса \"@index_id\"."

msgid "Invalid server ID \"@server_id\"."
msgstr "Недопустимый ИД сервера \"@server_id\"."

msgid "Index @index has been set to use server @server and items have been queued for indexing."
msgstr "Для индекса @index задано использование сервера @server, элементы помещены в очередь для индексации."

msgid "There was an error setting index @index to use server @server, or this index is already configured to use this server."
msgstr "Ошибка настройки индекса @index для использования сервера @server, или этот индекс уже настроен для использования этого сервера."

msgid "The index @index is already @desired_state."
msgstr "Индекс @index уже находится в состоянии @desired_state."

msgid "Index @index could not be @desired_state because it is not bound to any server."
msgstr "Не удалось перевести индекс @index в состояние @desired_state, так как он не связан ни с одним сервером."

msgid "The index @index was successfully @desired_state."
msgstr "Индекс @index успешно переведен в состояние @desired_state."

msgid "Index status"
msgstr "Состояние индекса"

