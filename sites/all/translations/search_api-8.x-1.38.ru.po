msgid "Database Search Defaults"
msgstr "Параметры по умолчанию для поиска в базе данных"

msgid "Enable this module for a best-practice default setup of Search API with the Database backend. After installation it is recommended to uninstall this module again for performance reasons. The provided configuration will not be removed."
msgstr "Включите этот модуль для использования рекомендуемой стандартной настройки API поиска с базовой программой базы данных. После установки рекомендуется повторно удалить этот модуль из системы для повышения быстродействия. Предоставленная конфигурация не будет удалена."

msgid "Database"
msgstr "База данных"

msgid "Select the database key and target to use for storing indexing information in. Cannot be changed after creation."
msgstr "Выберите целевой объект и ключ базы данных для хранения информации об индексировании. Эти параметры нельзя изменить после создания."

msgid "Minimum word length"
msgstr "Минимальная длина слова"

msgid "The minimum number of characters a word must consist of to be indexed"
msgstr "Минимальное число символов в слове для индексирования"

msgid "Partial matching"
msgstr "Частичное совпадение"

msgid "Match whole words only"
msgstr "Сравнивать только слова целиком"

msgid "Match on parts of a word"
msgstr "Сравнивать части слов"

msgid "Match words starting with given keywords"
msgstr "Сравнивать слова, начинающиеся с заданных ключевых слов"

msgid "Autocomplete settings"
msgstr "Настройки автодополнения"

msgid "These settings allow you to configure how suggestions are computed when autocompletion is used. If you are seeing many inappropriate suggestions you might want to deactivate the corresponding suggestion type. You can also deactivate one method to speed up the generation of suggestions."
msgstr "Эти параметры позволяют настраивать способы вычисления предположений при использовании автодополнения. При отображении большого количества неправильных предположений может потребоваться деактивировать соответствующий тип предположения. Можно также деактивировать один способ для ускорения формирования предположений."

msgid "Suggest word endings"
msgstr "Предлагать окончания слов"

msgid "Suggest endings for the currently entered word."
msgstr "Предлагать окончания для вводимого слова."

msgid "Suggest additional words"
msgstr "Предлагать дополнительные слова"

msgid "Suggest additional words the user might want to search for."
msgstr "Предлагать дополнительные слова для поиска."

msgid "none"
msgstr "нет"

msgid "Autocomplete suggestions"
msgstr "Предложения автодополнения"

msgid "No valid search keys were present in the query."
msgstr "В запросе не было ни одного допустимого ключевого слова."

msgid "Unknown sort order @order. Assuming \"@default\"."
msgstr "Неизвестный порядок сортировки @order. Предполагается \"@default\"."

msgid "Unknown facet field @field."
msgstr "Неизвестное поле фасета @field."

msgid "Unknown field @field: please check (and re-save) the index's fields settings."
msgstr "Неизвестное поле @field: проверьте (и сохраните повторно) параметры полей индекса."

msgid "An overlong word (more than 50 characters) was encountered while indexing: %word.<br />Since database search servers currently cannot index words of more than 50 characters, the word was truncated for indexing. If this should not be a single word, please make sure the \"Tokenizer\" processor is enabled and configured correctly for index %index."
msgstr "Во время индексации обнаружено слишком длинное слово (более 50 символов): %word.<br />Так как в настоящее время серверы поиска в базах данных не могут индексировать слова, длина которых превышает 50 символов, слово для индексации было усечено. Если оно не должно быть одним словом, убедитесь, что процессор \"Программа разбиения на лексемы\" включен и правильно настроен для индекса %index."

msgid "An overlong value (more than 255 characters) was encountered while indexing: %value.<br />Database search servers currently cannot index such values correctly – the value was therefore trimmed to the allowed length."
msgstr "Во время индексации обнаружено слишком длинное значение (более 255 символов): %value.<br />В настоящее время серверы поиска в базах данных не могут правильно индексировать такие значения, поэтому значение было усечено до разрешенной длины."

msgid "Error while adding facets: only \"item_id\" field should be used, used are: @fields."
msgstr "Ошибка при добавлении фасетов: необходимо использовать только поле \"item_id\", используемые поля: @fields."

msgid "Indexes items in the database. Supports several advanced features, but should not be used for large sites."
msgstr "Индексирует элементы в базе данных. Поддерживает несколько дополнительных функций, но не должен использоваться для больших сайтов."

msgid "Completed about @percentage% of the indexing operation (@current of @total)."
msgstr "Индексация завершена на @percentage% (@current из @total)"

msgid "Couldn't index items. Check the logs for details."
msgstr "Не удалось индексировать элементы. Дополнительные сведения содержатся в протоколах."

msgid "An error occurred while trying to index items. Check the logs for details."
msgstr "Ошибка при попытке индексации элементов. Дополнительные сведения содержатся в протоколах."

msgid "Successfully indexed 1 item on @index."
msgid_plural "Successfully indexed @count items on @index."
msgstr[0] "Успешно проиндексирован @count элемент в @index"
msgstr[1] "Успешно проиндексировано @count элемента в @index"
msgstr[2] "Успешно проиндексировано @count элементов в @index"

msgid "Successfully indexed 1 item."
msgid_plural "Successfully indexed @count items."
msgstr[0] "Успешно проиндексирован @count элемент."
msgstr[1] "Успешно проиндексировано @count элемента."
msgstr[2] "Успешно проиндексировано @count элементов."

msgid "1 item could not be indexed. Check the logs for details."
msgid_plural "@count items could not be indexed. Check the logs for details."
msgstr[0] "Не удалось индексировать 1 элемент. Дополнительные сведения содержатся в протоколах."
msgstr[1] "Не удалось индексировать элементы (кол-во элементов: @count). Дополнительные сведения содержатся в протоколах."
msgstr[2] "Не удалось индексировать элементы (кол-во элементов: @count). Дополнительные сведения содержатся в протоколах."

msgid "The required Node module is not installed on your site. Database Search Defaults module could not be installed."
msgstr "На сайте не установлен требуемый модуль узла. Не удалось установить модуль параметров по умолчанию для поиска в базе данных."

msgid "Content type @content_type not found. Database Search Defaults module could not be installed."
msgstr "Не найден тип содержимого @content_type. Не удалось установить модуль параметров по умолчанию для поиска в базе данных."

msgid "Field @field in content type @node_type not found. Database Search Defaults module could not be installed"
msgstr "Не найдено поле @field в типе содержимого @node_type. Не удалось установить модуль параметров по умолчанию для поиска в базе данных."

msgid "It looks like the default setup provided by this module already exists on your site. Cannot re-install module."
msgstr "Похоже, что настройка по умолчанию, заданная этим модулем, уже существует на вашем сайте. Не удается переустановить модуль."

