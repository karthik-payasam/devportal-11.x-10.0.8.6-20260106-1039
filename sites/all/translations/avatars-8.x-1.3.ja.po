msgid "Site default"
msgstr "サイトのデフォルト"

msgid "User picture"
msgstr "ユーザー画像"

msgid "An image representing your user account. Do not upload your avatars to this field."
msgstr "ユーザー・アカウントを表すイメージ。このフィールドにアバターをアップロードしないでください。"

msgid "User picture upload"
msgstr "ユーザーの写真のアップロード"

msgid "An image representing your user account."
msgstr "ユーザー・アカウントを表すイメージ。"

msgid "Avatar Kit"
msgstr "アバター・キット"

