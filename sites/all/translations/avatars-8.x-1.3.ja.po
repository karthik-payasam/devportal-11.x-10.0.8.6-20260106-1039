msgstr "静的存続時間"

msgid "How long static avatars are cached. Only applies to avatars which are not the users preference."
msgstr "静的アバターをキャッシュする期間。ユーザー設定ではないアバターのみに適用されます。"

msgid "Never delete"
msgstr "削除しない"

msgid "Delete after"
msgstr "次の後に削除"

