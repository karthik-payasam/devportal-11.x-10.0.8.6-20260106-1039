msgid "Chaos Tools Views"
msgstr "Vues d'outils Chaos"

msgid "A set of improvements to the core Views code that allows for greater control over Blocks."
msgstr "Ensemble d'améliorations du code des vues de base permettant un meilleur contrôle des blocs."

msgid "Chaos tool suite (Experimental)"
msgstr "Suite d'outils Chaos (expérimentale)"

msgid "Items per page"
msgstr "Eléments par page"

msgid "Pager offset"
msgstr "Décalage de la mise en page"

msgid "Pager type"
msgstr "Type de mise en page"

msgid "Hide fields"
msgstr "Masquer les zones"

msgid "Reorder fields"
msgstr "Réorganiser les zones"

msgid "Configure filters"
msgstr "Configurer des filtres"

msgid "Disable filters"
msgstr "Désactiver les filtres"

msgid "Configure sorts"
msgstr "Configurer les tris"

msgid "Allow settings"
msgstr "Permettre les paramètres"

msgid "None"
msgstr "Aucun"

msgid "For example, set this to 3 and the first 3 items will not be displayed."
msgstr "Par exemple, en le paramétrant à 3, les 3 premiers éléments ne seront pas affichés."

msgid "Inherit from view"
msgstr "Hériter de la vue"

msgid "Display a specified number of items"
msgstr "Afficher un nombre défini d'éléments"

msgid "Display all items"
msgstr "Afficher tous les éléments"

msgid "Pager"
msgstr "Mise en page"

msgid "Hide"
msgstr "Masquer"

msgid "Label"
msgstr "Libellé"

msgid "Weight"
msgstr "Poids"

msgid "Weight for @title"
msgstr "Poids pour @title"

msgid "Exposed filter values"
msgstr "Valeurs de filtre exposé"

msgid "If a value is set for an exposed filter, it will be removed from the block display."
msgstr "Si une valeur est définie pour un filtre exposé, elle est retirée de l'affichage des blocs."

msgid "Expose filter value to user"
msgstr "Exposer la valeur de filtre à l'utilisateur"

msgid "Expose this filter value to visitors? If so, the value set here will be the default."
msgstr "Exposer cette valeur de filtre aux visiteurs ? Si oui, la valeur définie ici sera la valeur par défaut."

msgid "Expose filter operator to user"
msgstr "Exposer l'opérateur de filtre à l'utilisateur"

msgid "Expose this filter's operator to visitors? If so, the operator set here will be the default."
msgstr "Exposer l'opérateur de ce filtre aux visiteurs ? Si oui, l'opérateur défini ici sera la valeur par défaut."

msgid "Disable filter: @handler"
msgstr "Désactiver le filtre : @handler"

msgid "Sort ascending"
msgstr "Trier par ordre croissant"

msgid "Sort descending"
msgstr "Trier par ordre décroissant"

msgid "Order"
msgstr "Commande"

