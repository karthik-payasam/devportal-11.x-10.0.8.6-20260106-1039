msgid "Pretty paths coder"
msgstr "Coder percorsi Pretty"

msgid "Facets Pretty Paths"
msgstr "Percorsi Pretty dei facet"

msgid "Pretty paths for Facets."
msgstr "Percorsi Pretty per i facet."

msgid "Search"
msgstr "Cerca"

msgid "Facet Pretty Paths third party settings on the Facet config"
msgstr "Impostazioni di terze parti dei Pretty Paths dei Facet nella configurazione Facet "

msgid "The coder plugin ID"
msgstr "ID plugin coder "

msgid "Home"
msgstr "Home"

msgid "Pretty paths"
msgstr "Percorsi Pretty"

msgid "Pretty paths uses slashes as separator, e.g. /brand/drupal/color/blue"
msgstr "I percorsi Pretty utilizzano le barre come separatore, ad esempio /brand/drupal/color/blue"

msgid "Default"
msgstr "Predefinito"

msgid "Use the raw value, no special processing is done, e.g. /color/<strong>2</strong>"
msgstr "Utilizzare il valore non elaborato, non viene effettuata alcuna elaborazione speciale, ad esempio /color/<strong>2</strong>"

msgid "Node title + id"
msgstr "Titolo nodo + id"

msgid "Use node title with entity id, e.g. /color/<strong>blue-2</strong>"
msgstr "Utilizzare il titolo del nodo con l'ID entità, ad esempio /color/<strong>blue-2</strong>"

msgid "Taxonomy term name + id"
msgstr "Nome + id del termine della tassonomia"

msgid "Use term name with term id, e.g. /color/<strong>blue-2</strong>"
msgstr "Utilizzare il nome del termine con l'id del termine, ad es. /color/<strong>blue-2</strong>"

