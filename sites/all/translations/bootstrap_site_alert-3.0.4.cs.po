msgid "Bootstrap Site Alert"
msgstr "Výstraha webu zaváděcího programu"

msgid "This module is for rendering alerts site wide using the power of Bootstrap"
msgstr "Tento modul je určen pro vykreslení výstrah v rámci celého webu prostřednictvím zaváděcího programu."

msgid "Other"
msgstr "Jiné"

msgid "Bootstrap Site Alert Configuration"
msgstr "Konfigurace výstrah webu zaváděcího programu"

msgid "Configure the Bootstrap Site Wide Alert Settings"
msgstr "Konfigurovat nastavení výstrah pro celý web zaváděcího programu"

msgid "Administer Bootstrap Site Alert"
msgstr "Spravovat výstrahy webu zaváděcího programu"

msgid "View Bootstrap Site Alert"
msgstr "Zobrazit výstrahy webu zaváděcího programu"

msgid "Settings"
msgstr "Nastavení"

msgid ""
"<h3>Use this form to setup the bootstrap site alert(s).</h3>\n"
"                  <p>Make sure you select the checkbox if you want to turn the alerts on</p>"
msgstr ""
"<h3>Pomocí tohoto formuláře můžete nastavit výstrahu webu zaváděcího programu.</h3>\n"
"                  <p>Chcete-li zapnout výstrahy, ujistěte se, že jste zaškrtli toto políčko</p>"

msgid "Select Bootstrap Version"
msgstr "Vybrat verzi Bootstrap"

msgid "3"
msgstr "3"

msgid "4"
msgstr "4"

msgid "- SELECT -"
msgstr "- VYBRAT -"

msgid "Save Bootstrap Version"
msgstr "Uložit verzi Bootstrap"

msgid "Success"
msgstr "Úspěšně dokončeno"

msgid "Info"
msgstr "Info"

msgid "Warning"
msgstr "Varování"

msgid "Danger"
msgstr "Nebezpečí"

msgid "Primary"
msgstr "Primární"

msgid "Secondary"
msgstr "Sekundární"

msgid "Light"
msgstr "Světlý"

msgid "Dark"
msgstr "Tmavý"

msgid "If Checked, Bootstrap Site Alert is Active."
msgstr "Je-li políčko zaškrtnuto, je výstraha webu zaváděcího programu aktivní."

msgid "Severity"
msgstr "Vážnost"

msgid "Make this alert dismissable?"
msgstr "Nastavit tuto výstrahu jako zamítnutelnou?"

msgid "Hide this alert on admin pages?"
msgstr "Skrýt tuto výstrahu na administrativních stránkách?"

msgid "Only Show On Certain Pages?"
msgstr "Zobrazit pouze na určitých stránkách?"

msgid "Path(s) to show on"
msgstr "Cesta(y) k zobrazení"

msgid "Specify pages by using their paths. Enter one path per line. The '*' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page."
msgstr "Určete stránky pomocí jejich cest. Zadejte jednu cestu na řádek. Znak '*' je zástupný znak. Příklad cesty je %user-wildcard pro každou uživatelskou stránku. %front je titulní strana."

msgid "Alert Message"
msgstr "Výstražná zpráva"

msgid "Add Another Alert"
msgstr "Přidat další výstrahu"

msgid "Remove Last Alert"
msgstr "Odebrat poslední výstrahu"

msgid "Save Alert Message(s)"
msgstr "Uložit výstražnou zprávu(y)"

