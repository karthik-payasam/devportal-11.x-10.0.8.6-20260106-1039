msgstr "取得最佳化檔案的詳細資訊"

msgid "Filename"
msgstr "檔名"

msgid "Lookup Details"
msgstr "查閱詳細資料"

msgid "Input an optimized filename like \"@css_file\"."
msgstr "輸入最佳化檔名，例如 \"@css_file\"。"

