msgid "Policies"
msgstr "Políticas"

msgid "Report Only"
msgstr "Somente relatório"

msgid "Enforced"
msgstr "Impingido"

msgid "Enable '@type'"
msgstr "Ativar '@type'"

msgid "Additional Sources"
msgstr "Origens Adicionais"

msgid "Additional domains or protocols to allow for this directive, separated by a space."
msgstr "Domínios ou protocolos adicionais para permitir esta diretiva, separados por um espaço."

msgid "Instead of child-src, nested browsing contexts and workers should use the frame-src and worker-src directives, respectively."
msgstr "Em vez de child-src, os contextos de navegação aninhados e os trabalhadores devem utilizar as diretivas frame-src e worker-src, respectivamente."

msgid "Handler"
msgstr "Gerenciador"

msgid "Reset @policyType policy to default values"
msgstr "Reconfigurar a política @policyType para valores padrão"

msgid "No policies are currently enabled."
msgstr "Nenhuma política está atualmente ativado."

msgid "%policy %directive has a hash source configured, which may block functionality that relies on inline code."
msgstr "%policy %directive tem uma origem hash configurada, que pode bloquear a funcionalidade que depende do código sequencial."

msgid "%policy %directive is enabled without a fallback directive for non-supporting browsers."
msgstr "%policy %directive está ativada sem uma diretiva de fallback para navegadores sem suporte."

msgid "<a href=\":docUrl\">Nonces must be a unique value for each request</a>, so cannot be set in configuration."
msgstr "<a href=\":docUrl\">Nonces deve ser um valor exclusivo para cada solicitação</a>, por isso, não pode ser definido na configuração."

msgid "Invalid domain or protocol provided."
msgstr "Domínio inválido ou protocolo fornecido."

msgid "Reporting Handler is required for enabled policies."
msgstr "O Manipulador de relatórios é necessário para as políticas ativadas."

msgid "Reporting is disabled"
msgstr "O relatório está desativado"

msgid "Your <a href=\":url\">Report-URI.com subdomain</a>."
msgstr "Seu <a href= \" :url \" >Report-URI.com subdomínio</a>."

msgid "Enable Wizard"
msgstr "Ativar Assistente"

msgid "Send reports to the <a href=\":url\">CSP Wizard</a> reporting address."
msgstr "Enviar relatórios para o endereço de relatório <a href=\":url\">Assistente do CSP</a>."

msgid "Reports will be sent to a ReportURI.com account."
msgstr "Os relatórios serão enviados para uma conta de ReportURI.com."

msgid "Reports will be added to the site log."
msgstr "Os relatórios serão incluídos no log de site."

msgid "The URI to send reports to."
msgstr "O URI para enviar relatórios."

msgid "Reports will be sent to a URI."
msgstr "Os relatórios serão enviados para um URI."

