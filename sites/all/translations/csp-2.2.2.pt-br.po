msgid "No Content Security Policy headers are currently enabled."
msgstr "Nenhum cabeçalho de Política de segurança de conteúdo está atualmente ativado."

msgid "Enable a header via <a href=\":csp-settings\">the Content Security Policy settings</a>."
msgstr "Ativar um cabeçalho por meio das <a href=\":csp-settings\">configurações da Política de Segurança de Conteúdo</a>."

msgid "Enabling Content Security Policy in Security Kit is likely to cause policy conflicts."
msgstr "A ativação da Política de Segurança de Conteúdo no Kit de Segurança provavelmente causará conflitos de política."

msgid "Disable the Content Security Policy settings in <a href=\":seckit-settings\">Security Kit configuration</a>."
msgstr "Desative as configurações da Política de Segurança de Conteúdo em <a href=\":seckit-settings\">Configuração do Kit de Segurança</a>."

msgid "Content Security Policy"
msgstr "Política de segurança de conteúdo"

msgid "Provide Content-Security-Policy headers"
msgstr "Forneça os cabeçalhos Content-Security-Policy"

msgid "Configure policy enforcement."
msgstr "Configurar cumprimento de política."

msgid "Administer Content Security Policy"
msgstr "Administrar a política de segurança de conteúdo"

msgid "Content Security Policy Settings"
msgstr "Conteúdo Configurações de Política de Segurança"

msgid "Report-Only Policy"
msgstr "Relatório Apenas Política"

