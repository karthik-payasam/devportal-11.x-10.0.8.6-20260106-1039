msgid "About"
msgstr "關於"

msgid "<a href=':crop'>Crop</a> provides basic API for image cropping. This module won't do much by itself. Users should pick one of UI modules that utilize this API.</a>"
msgstr "<a href=':crop'>Crop</a> 提供基本 API 來裁剪影像。此模組本身不會執行太多功能。使用者應挑選其中一個會利用這個 API 的使用者介面模組。</a>"

msgid "Configuration"
msgstr "設定"

msgid "This is API module. In order to crop your images you need a UI module. There are currently two UI modules that use Crop API:"
msgstr "這是 API 模組。為了裁剪您的影像，您需要一個使用者介面模組。目前有兩個使用者介面模組會使用 Crop API："

msgid "<a href=\":image_widget_crop\">Image widget crop</a>"
msgstr "<a href=\":image_widget_crop\">影像小組件裁剪</a>"

msgid "<a href=\":focal_point\">Focal point</a>"
msgstr "<a href=\":focal_point\">焦點</a>"

msgid "Technical details"
msgstr "技術詳細資料"

msgid "Initial discussion can be found on <a href=\":manual\">manual crop issue queue</a>."
msgstr "您可以在<a href=\":manual\">手動裁剪問題佇列</a>上找到初步的討論。"

msgid "Crop configuration"
msgstr "裁剪配置"

msgid "There are no file or image fields on this bundle at the moment. In order to configure crop add at least one such field and come back."
msgstr "目前此組合上沒有檔案或影像欄位。為了能夠配置裁剪，請至少新增一個這類欄位並返回。"

msgid "Image field"
msgstr "影像欄位"

msgid "- Skip field -"
msgstr "- 跳過欄位 -"

msgid "Select field that stores image which needs to be cropped."
msgstr "選取欄位來儲存需要進行裁剪的影像。"

msgid "Crop API"
msgstr "裁剪 API"

msgid "This branch of Crop API is not compatible with the version of Media Entity installed."
msgstr "「裁剪 API」的此分支與已安裝的「媒體實體」版本不相容。"

msgid "Provides storage and API for image crops."
msgstr "為影像裁剪提供儲存體和 API。"

msgid "Media"
msgstr "媒體"

msgid "Add crop type"
msgstr "新增裁剪類型"

msgid "Crop types"
msgstr "裁剪類型"

msgid "Manage crop types."
msgstr "管理裁剪類型。"

msgid "Administer crop settings"
msgstr "管理裁剪設定"

msgid "Administer the basic settings for Crop API."
msgstr "管理「裁剪 API」的基本設定。"

msgid "Administer crop types"
msgstr "管理裁剪類型"

msgid "Administer crop types."
msgstr "管理裁剪類型。"

msgid "Delete"
msgstr "刪除"

msgid "Crop type"
msgstr "裁剪類型"

msgid "Name"
msgstr "名稱"

msgid "Machine-readable name"
msgstr "機器可讀名稱"

msgid "Description"
msgstr "描述"

msgid "Aspect ratio"
msgstr "長寬比"

msgid "Soft limit width"
msgstr "軟性限制寬度"

msgid "Soft limit height"
msgstr "軟性限制高度"

msgid "Hard limit width"
msgstr "硬性限制寬度"

msgid "Hard limit height"
msgstr "硬性限制高度"

msgid "Third party settings"
msgstr "第三方設定"

msgid "Crop settings"
msgstr "裁剪設定"

msgid "Field storing image to be cropped"
msgstr "儲存要裁剪之影像的欄位"

msgid "Crop effect configuration"
msgstr "裁剪效果配置"

msgid "Automatic crop provider"
msgstr "自動裁剪提供者"

msgid "Crop API settings"
msgstr "裁剪 API 設定"

msgid "Indicates whether to flush image derivatives when a crop entity is change"
msgstr "指出在裁剪實體變更時是否要清除影像衍生物"

msgid "Media entity crop"
msgstr "媒體實體裁剪"

msgid "Deprecated."
msgstr "已淘汰。"

msgid "Aspect Ratio"
msgstr "長寬比"

msgid "Used in"
msgstr "使用於"

msgid "@first, @second and @count more"
msgstr "@first、@second 及其他 @count"

msgid "No crop types available. <a href=\"@link\">Add crop type</a>."
msgstr "沒有可用的裁剪類型。<a href=\"@link\">新增裁剪類型</a>。"

msgid "Entity provider @id not found."
msgstr "找不到實體提供者 @id。"

msgid "Crop ID"
msgstr "裁剪 ID"

msgid "The crop ID."
msgstr "裁剪 ID。"

msgid "UUID"
msgstr "UUID"

msgid "The crop UUID."
msgstr "裁剪 UUID。"

msgid "Revision ID"
msgstr "修訂版本 ID"

msgid "The crop revision ID."
msgstr "裁剪修訂 ID。"

msgid "Type"
msgstr "類型"

msgid "The crop type."
msgstr "裁剪類型。"

msgid "Language code"
msgstr "語言代碼"

msgid "The node language code."
msgstr "節點語言碼。"

msgid "Entity ID"
msgstr "實體 ID"

msgid "ID of entity crop belongs to."
msgstr "裁剪所屬的實體 ID。"

msgid "Entity type"
msgstr "實體類別"

msgid "The type of entity crop belongs to."
msgstr "裁剪所屬的實體類型。"

msgid "URI"
msgstr "URI"

msgid "The URI of the image crop belongs to."
msgstr "裁剪所屬的影像 URI。"

msgid "Height"
msgstr "高度"

msgid "The crop height."
msgstr "裁剪高度。"

msgid "Width"
msgstr "寬度"

msgid "The crop width."
msgstr "裁剪寬度。"

msgid "X coordinate"
msgstr "X 座標"

msgid "The crop's X coordinate."
msgstr "裁剪的 X 座標。"

msgid "Y coordinate"
msgstr "Y 座標"

msgid "The crop's Y coordinate."
msgstr "裁剪的 Y 座標。"

msgid "Revision timestamp"
msgstr "修訂時間戳記"

msgid "The time that the current revision was created."
msgstr "現行修訂的建立時間。"

msgid "Revision author ID"
msgstr "修訂作者 ID"

msgid "The user ID of the author of the current revision."
msgstr "現行修訂作者的使用者 ID。"

msgid "Revision Log"
msgstr "修訂日誌"

msgid "The log entry explaining the changes in this revision."
msgstr "此日誌登錄說明此修訂中的變更。"

msgid "Crop"
msgstr "裁剪"

msgid "Are you sure you want to delete the crop type %type?"
msgstr "確定要刪除裁剪類型 %type 嗎？"

msgid "The crop type %name has been deleted."
msgstr "裁剪類型 %name 已刪除。"

msgid "Deleted crop type %name."
msgstr "已刪除裁剪類型 %name。"

msgid "%type is used by 1 piece of content on your site. You can not remove this content type until you have removed all of the %type content."
msgid_plural "%type is used by @count pieces of content on your site. You may not remove %type until you have removed all of the %type content."
msgstr[0] "網站上有 @count 個內容片段在使用 %type。您必須先移除所有 %type 內容，才能移除 %type。"

msgid "Edit %label crop type"
msgstr "編輯 %label 裁剪類型"

msgid "The human-readable name of this crop type. This name must be unique."
msgstr "此裁剪類型的人類可讀名稱。此名稱必須是唯一的。"

msgid "A unique machine-readable name for this crop type. It must only contain lowercase letters, numbers, and underscores."
msgstr "此裁剪類型的唯一機器可讀名稱。它只能包含小寫字母、數字和底線。"

msgid "Describe this crop type."
msgstr "說明此裁剪類型。"

msgid "Set an aspect ratio <b>eg: 16:9</b> or leave this empty for arbitrary aspect ratio"
msgstr "設定長寬比（<b>例如：16:9</b>），或者將此選項保留空白以使用任意長寬比"

msgid "Soft limit"
msgstr "軟性限制"

msgid "Define crop size soft limit. Warning will be displayed if crop smaller than that is selected."
msgstr "定義裁剪大小軟性限制。如果裁剪小於所選取的裁剪，則將顯示警告。"

msgid "Limit for width."
msgstr "寬度限制。"

msgid "Limit for height."
msgstr "高度限制。"

msgid "Hard limit"
msgstr "硬性限制"

msgid "Define crop size hard limit. User is not allowed to make a smaller selection than defined here."
msgstr "定義裁剪大小硬性限制。不容許使用者進行小於這裡所定義限制的選擇。"

msgid "Limit for width"
msgstr "寬度限制"

msgid "Save crop type"
msgstr "儲存裁剪類型"

msgid "Delete crop type"
msgstr "刪除裁剪類型"

msgid "The crop type %name has been updated."
msgstr "裁剪類型 %name 已更新。"

msgid "The crop type %name has been added."
msgstr "裁剪類型 %name 已新增。"

msgid "View"
msgstr "檢視"

msgid "Added crop type %name."
msgstr "已新增裁剪類型 %name。"

msgid "File"
msgstr "檔案"

msgid "Provides crop integration for core files."
msgstr "為核心檔案提供裁剪整合。"

msgid "Provides crop integration for media."
msgstr "為媒體提供裁剪整合。"

msgid "Crop type to be used for the image style."
msgstr "要用於影像樣式的裁剪類型。"

msgid "- Select a Provider -"
msgstr "- 選取提供者 -"

msgid "The name of automatic crop provider to use if crop is not set for an image."
msgstr "未針對影像設定裁剪時要使用的自動裁剪提供者名稱。"

msgid "Manual image crop failed due to misconfigured crop type on %path."
msgstr "由於 %path 上的裁剪類型配置錯誤，造成手動影像裁剪失敗。"

msgid "Manual image crop failed using the %toolkit toolkit on %path (%mimetype, %width x %height)"
msgstr "手動影像裁剪失敗，使用的是 %path 上的 %toolkit 工具箱（%mimetype，%width x %height）"

msgid "Manual crop"
msgstr "手動裁剪"

msgid "Applies manually provided crop to the image."
msgstr "將手動提供的裁剪套用至影像。"

msgctxt "Validation"
msgid "Crop Type aspect ratio"
msgstr "裁剪類型長寬比"

msgid "Invalid aspect ratio format. Should be defined in H:W form."
msgstr "長寬比格式無效。應該以 H:W 格式定義。"

