msgstr "AdvAgg Minify JavaScript"

msgid "Minify JavaScript with a 3rd party minifier; JSMin+, JSMin c ext, JShrink, and JSqueeze currently."
msgstr "Momentálně zmenšete JavaScript s minifierem třetí strany; JSMin+, JSMin c ext, JShrink a JSqueeze."

msgid "JavaScript Minification"
msgstr "Minimalizace JavaScript"

msgid "AdvAgg JavaScript minification settings."
msgstr "Nastavení minimalizace AdvAgg JavaScript."

msgid "AdvAgg: JS Minification"
msgstr "AdvAgg: Minimalizace JS"

msgid "Minifier to use. 0 is disabled."
msgstr "Minifier, který se má použít. 0 je zakázáno."

msgid "Upper bound comparison value for the minification ratio test."
msgstr "Horní mez porovnávané hodnoty pro test poměru minimalizace."

msgid "Lower bound comparison value for the minification ratio test."
msgstr "Dolní mez porovnávané hodnoty pro test poměru minimalizace."

msgid "The jsmin function does not exist. Using JSqueeze."
msgstr "Funkce jsmin neexistuje. Použití JSqueeze."

msgid "JSMin had a possible error minifying: @file, correcting."
msgstr "JSMin mělo možnou chybu při zmenšení: @file, oprava."

msgid "JSMin had an error minifying file: @file, attempting to correct."
msgstr "JSMin měl chybu při zmenšování souboru: @file, pokus o opravu."

msgid "The currently installed jsmin version does not handle multibyte characters, you may consider to upgrade the jsmin extension. Using JSqueeze fallback."
msgstr "Momentálně nainstalovaná verze jsmin nezpracovává vícebajtové znaky, můžete zvážit upgrade rozšíření jsmin. Použití náhradního řešení JSqueueze."

msgid "The settings below will not have any effect because AdvAgg is currently in <a href=\"@devel\">development mode</a>. Once the cache settings have been set to a non-development level, JS minification will take place."
msgstr "Nastavení níže nebude mít žádný vliv, protože AdvAgg je aktuálně v <a href=\"@devel\">režimu vývoje</a>. Jakmile jsou nastavení mezipaměti nastavena na úroveň mimo vývoj, bude místo toho minimalizace JS."

msgid "JSMin+ ~1300ms"
msgstr "JSMin+ ~1300ms"

msgid "JShrink ~1000ms"
msgstr "JShrink ~1000ms"

msgid "JSqueeze ~600ms"
msgstr "JSqueeze ~600ms"

msgid "JSMin ~2ms"
msgstr "JSMin ~2ms"

msgid "JSMin is the very fast C complied version. Recommend using it."
msgstr "JSMin je velmi rychlá vyhovující verze C. Je doporučeno ji použít."

msgid "You can use the much faster C version of JSMin (~2ms) by installing the <a href=\"@php_jsmin\">JSMin PHP Extension</a> on this server."
msgstr "Můžete použít mnohem rychlejší verzi C JSMin (~2ms) instalací <a href=\"@php_jsmin\">Rozšíření JSMin PHP</a> na tomto serveru."

msgid "AdvAgg Modifier"
msgstr "Modifikátor AdvAgg"

