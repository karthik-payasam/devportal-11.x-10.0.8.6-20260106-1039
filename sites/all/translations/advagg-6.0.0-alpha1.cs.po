msgid "Keep all Advagg settings but disable all functionality."
msgstr "Ponechejte všechna nastavení Advagg, ale zakažte všechny funkce."

msgid "Restore all Advagg functionality if disabled."
msgstr "Pokud je vypnuto, obnovte všechny funkce Advagg."

msgid "Run the advagg cron hook. This will clear out all stale advagg aggregated files, remove aggregates that include missing files, and remove unused aggregates."
msgstr "Spusťte příkaz advagg cron hook. Tím se vyčistí všechny zastaralé agregované soubory advagg, odeberou agregáty s chybějícími soubory a odeberou nepoužívané agregace."

msgid "Remove all generated files. Useful if you think some of the generated files got corrupted and thus need to be deleted."
msgstr "Odeberte všechny generované soubory. Užitečné, pokud si myslíte, že některé z vygenerovaných souborů jsou poškozené, a proto je třeba je odstranit."

msgid "Force the creation of all new optimized files by incrementing a global counter. Current value of counter: %value. This is may be useful if a CDN has cached an something incorrectly as it will force new ones to be used even if nothing else has changed."
msgstr "Vynuťte vytvoření všech nových optimalizovaných souborů navýšením globálního čítače. Aktuální hodnota čítače: %value. To může být užitečné v případě, že CDN má v mezipaměti něco nesprávně uloženo, protože se tím vynutí nové uložení, i když se nic dalšího nezměnilo."

msgid "Run the advagg cron hook."
msgstr "Spusťte příkaz advagg cron hook."

msgid "Disable Advagg."
msgstr "Zakažte Advagg."

msgid "Enable Advagg."
msgstr "Povolte Advagg."

msgid "Remove all generated files."
msgstr "Odeberte všechny generované soubory."

msgid "Force the creation of all new files by incrementing a global counter."
msgstr "Vynuťte vytvoření všech nových souborů zvýšením globálního čítače."

msgid "All Advagg functionality is disabled."
msgstr "Všechny funkce Advagg jsou vypnuté."

msgid "All Advagg functionality is enabled."
msgstr "Všechny funkce Advagg jsou povolené."

msgid "Global counter is now set to @new_value"
msgstr "Globální čítač je nyní nastaven na hodnotu @new_value"

msgid "All AdvAgg optimized files have been deleted. %css_count CSS files and %js_count JS files have been removed."
msgstr "Všechny optimalizované soubory AdvAgg byly odstraněny. Bylo odebráno %css_count souborů CSS a %js_count souborů JS."

msgid "All stale aggregates have been deleted. %css_count CSS files and %js_count JS files have been removed."
msgstr "Všechny zastaralé agregace byly odstraněny. Bylo odebráno %css_count souborů CSS a %js_count souborů JS."

msgid "No stale aggregates found. Nothing was deleted."
msgstr "Nebyly nalezeny žádné zastaralé agregace. Nic nebylo odstraněno."

msgid "NOTE: If you wish to bypass AdvAgg optimizations for a set amount of time, you can go to the <a href=\"@operations\">AdvAgg operations</a> page and press the <em>\"optimization bypass cookie\"</em> button."
msgstr "POZNÁMKA: Chcete-li obejít optimalizaci AdvAgg po nastavenou dobu, můžete přejít na stránku <a href=\"@operations\">Operace AdvAgg</a> a stisknout tlačítko <em>\"soubor cookie vynechání optimalizace\"</em>."

msgid "You can also selectively bypass AdvAgg optimization by adding <code>@code</code> to the URL of any page."
msgstr "Rovněž můžete selektivně vynechat optimalizaci AdvAgg přidáním <code>@code</code> do adresy URL jakékoli stránky."

msgid "You do not have the <a href=\"@permission\">bypass advanced aggregation permission</a> so adding <code>@code</code> to the URL will not work at this time for you; either grant this permission to your user role or use the bypass cookie if you wish to selectively bypass AdvAgg optimizations."
msgstr "Nemáte <a href=\"@permission\">oprávnění k vynechání rozšířené agregace</a>, takže přidání <code>@code</code> do adresy URL nebude v této chvíli pracovat; buď toto oprávnění k roli uživatele udělte, nebo použijte cookie vynechání, pokud chcete selektivně vynechat optimalizace Advangg."

msgid "The AdvAgg bypass cookie is currently enabled. Turn it off by going to the <a href=\"@advagg_operations\">AdvAgg Operations</a> page and clicking the <em>Toggle the \"aggregation bypass cookie\" for this browser</em> button."
msgstr "Soubor cookie vynechání Advangg je aktuálně povolen. Vypněte jej tak, že přejdete na stránku <a href=\"@advagg_operations\">Operace AdvAgg</a> a klepnete na tlačítko <em>Přepnout \"soubor cookie vynechání agregace\" pro tento prohlížeč</em>."

msgid "The AdvAgg bypass cookie is currently enabled. Turn it off by <a href=\"@login\">logging in</a> with a user with the \"administer site configuration\" permissions and going to the <a herf=\"@advagg_operations\">AdvAgg Operations page</a> and clicking the <em>Toggle the \"aggregation bypass cookie\" for this browser</em> button."
msgstr "Soubor cookie vynechání Advangg je aktuálně povolen. Vypněte jej tak, že se <a href=\"@login\">přihlásíte</a> pomocí uživatele a oprávněními \"spravovat konfiguraci webu\" a přejdete na stránku <a herf=\"@advagg_operations\">Operace AdvAgg</a> a klepnete na tlačítko <em>Přepnout \"soubor cookie vynechání agregace\" pro tento prohlížeč</em>."

