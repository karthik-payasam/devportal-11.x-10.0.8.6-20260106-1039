msgstr "Ověřit CSS pomocí validátoru W3.org css"

msgid "Validate JavaScript with JSHint"
msgstr "Ověřit JavaScript pomocí JSHint"

msgid "Advanced CSS/JS Aggregation Asset Validation"
msgstr "Rozšířené ověření aktiv agregace CSS/JS"

msgid "AdvAgg: CSS Validator using CSSLint"
msgstr "AdvAgg: Validátor CSS používající CSSLint"

msgid "AdvAgg: CSS Validator using w3.org"
msgstr "AdvAgg: Validátor CSS používající w3.org"

msgid "AdvAgg: JavaScript Validator using JSHint"
msgstr "AdvAgg: Validátor JavaScript používající JSHint"

msgid "Default CSS Lint ignore settings."
msgstr "Výchozí nastavení ignorování Lint CSS."

