msgstr "Опрос %poll был обновлён."

msgid "The poll %poll has been added."
msgstr "Опрос %poll был добавлен."

msgid "Poll %poll added."
msgstr "Опрос %poll добавлен."

msgid "Are you sure you want to delete all items from the feed %feed?"
msgstr "Вы уверены, что хотите удалить все элементы из ленты %feed?"

msgid "Delete items"
msgstr "Удалить элементы"

msgid "There are no settings yet."
msgstr "Настроек еще нет."

msgid "Vote"
msgstr "Голосовать"

msgid "Your vote for this poll has already been submitted."
msgstr "Ваш голос для этого опроса уже подан."

msgid "Choices"
msgstr "Варианты"

msgid "Cancel vote"
msgstr "Отменить голос."

msgid "View poll"
msgstr "Показать опрос"

msgid "View results"
msgstr "Просмотр результатов"

