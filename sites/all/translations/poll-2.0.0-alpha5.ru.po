msgstr "н/д"

msgid "Poll ID"
msgstr "ID опроса"

msgid "The ID of the poll."
msgstr "ID опроса"

msgid "The poll author."
msgstr "Автор опроса"

msgid "UUID"
msgstr "UUID"

msgid "The poll UUID."
msgstr "UUID опроса"

msgid "The poll question."
msgstr "Вопрос опроса"

msgid "Language code"
msgstr "Код языка"

msgid "The poll language code."
msgstr "Код языка опроса"

msgid "Choice"
msgstr "Вариант"

msgid "Enter the poll choices."
msgstr "Введите варианты опроса."

msgid "Unlimited"
msgstr "Неограничено"

msgid "Poll Duration"
msgstr "Продолжительность опроса"

msgid "After this period, the poll will be closed automatically."
msgstr "По окончании этого периода опрос закроется автоматически."

msgid "Allow anonymous votes"
msgstr "Позволить голосовать анонимным пользователям"

msgid "A flag indicating whether anonymous users are allowed to vote."
msgstr "Флаг, указывающий, разрешено ли анонимным пользователям принимать участие в голосовании."

msgid "Allow cancel votes"
msgstr "Позволить отменять выбор"

msgid "A flag indicating whether users may cancel their vote."
msgstr "Флаг, указывающий, могут ли пользователи отозвать свой голос."

msgid "Allow view results"
msgstr "Позволить показывать результаты"

msgid "A flag indicating whether users may see the results before voting."
msgstr "Флаг, указывающий, могут ли пользователи видеть результаты перед голосованием."

msgid "Active"
msgstr "Активно"

msgid "A flag indicating whether the poll is active."
msgstr "Флаг, указывающий, активен ли опрос."

msgid "When the poll was created, as a Unix timestamp."
msgstr "Время создания опроса (в формате Unix)."

msgid "Choice ID"
msgstr "ID выбора"

msgid "Poll Choice"
msgstr "Выбор Опроса"

msgid "All associated votes will be deleted too. This action cannot be undone."
msgstr "Все связанные голоса тоже будут удалены. Это действие нельзя отменить."

