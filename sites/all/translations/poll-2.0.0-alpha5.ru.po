msgstr "Ваш голос был отменён."

msgid "Your vote has been recorded."
msgstr "Ваш голос был учтён."

msgid "Your vote could not be recorded because you did not select any of the choices."
msgstr "Ваш голос не может быть учтён, потому что вы не выбрали ни один из вариантов."

msgid "%user's vote in Poll #%poll deleted."
msgstr "Голос %user в опросе #%poll удален."

