msgid "Bootstrap Site Alert"
msgstr "Bootstrap Site Alert"

msgid "This module is for rendering alerts site wide using the power of Bootstrap"
msgstr "Deze module is bedoeld voor het site-breed weergeven van alerts met behulp van de kracht van Bootstrap"

msgid "Other"
msgstr "Andere"

msgid "Bootstrap Site Alert Configuration"
msgstr "Bootstrap Site Alert configureren"

msgid "Configure the Bootstrap Site Wide Alert Settings"
msgstr "De instellingen voor site-brede Bootstrap-alerts configureren"

msgid "Administer Bootstrap Site Alert"
msgstr "Bootstrap Site Alert beheren"

msgid "View Bootstrap Site Alert"
msgstr "Bootstrap Site Alert bekijken"

msgid "Settings"
msgstr "Instellingen"

msgid ""
"<h3>Use this form to setup the bootstrap site alert(s).</h3>\n"
"                  <p>Make sure you select the checkbox if you want to turn the alerts on</p>"
msgstr ""
"<h3>Gebruik dit formulier om Bootstrap Site Alert(s) in te stellen.</h3>\n"
"                  <p>Wilt u de alerts aanzetten? Vergeet dan niet om het desbetreffende vakje te selecteren</p>"

msgid "Select Bootstrap Version"
msgstr "Bootstrap-versie selecteren"

msgid "3"
msgstr "3"

msgid "4"
msgstr "4"

msgid "- SELECT -"
msgstr "- SELECTEREN -"

msgid "Save Bootstrap Version"
msgstr "Bootstrap-versie opslaan"

msgid "Success"
msgstr "Succes"

msgid "Info"
msgstr "Info"

msgid "Warning"
msgstr "Waarschuwing"

msgid "Danger"
msgstr "Gevaar"

msgid "Primary"
msgstr "Primaire"

msgid "Secondary"
msgstr "Secundaire"

msgid "Light"
msgstr "Licht"

msgid "Dark"
msgstr "Donker"

msgid "If Checked, Bootstrap Site Alert is Active."
msgstr "Als dit geselecteerd is, is Bootstrap Site Alert actief."

msgid "Severity"
msgstr "Ernst"

msgid "Make this alert dismissable?"
msgstr "Mogelijkheid bieden om deze alert uit te zetten?"

msgid "Hide this alert on admin pages?"
msgstr "Deze alert verbergen op beheerpagina's?"

msgid "Only Show On Certain Pages?"
msgstr "Alleen afbeelden op bepaalde pagina's?"

msgid "Path(s) to show on"
msgstr "Pad(en) om af te beelden"

msgid "Specify pages by using their paths. Enter one path per line. The '*' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page."
msgstr "Specificeer pagina's aan de hand van hun pad. Voer één pad in per regel. Het '*' karakter kan als jokerteken gebruikt worden. Een voorbeeldpad is %user-wildcard voor elke gebruikerspagina. %front is de voorpagina."

msgid "Alert Message"
msgstr "Alertbericht"

msgid "Add Another Alert"
msgstr "Een andere waarschuwing toevoegen"

msgid "Remove Last Alert"
msgstr "Laatste alert verwijderen"

msgid "Save Alert Message(s)"
msgstr "Alertbericht(en) opslaan"

