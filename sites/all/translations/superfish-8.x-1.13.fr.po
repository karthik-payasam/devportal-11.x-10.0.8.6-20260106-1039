msgid "None"
msgstr "Aucun"

msgid "Vertical"
msgstr "Vertical"

msgid "Horizontal"
msgstr "Horizontal"

msgid "Diagonal"
msgstr "Diagonale"

msgid "About Superfish"
msgstr "A propos de Superfish"

msgid "<a href=\"@url_module\">Superfish module</a> integrates <a href=\"@url_library\">jQuery Superfish</a> plugin to your Drupal menu blocks. Please refer to the module <a href=\"@url_documentation\">documentation</a> for more information."
msgstr "Le <a href=\"@url_module\">module Superfish</a> intègre le plug-in <a href=\"@url_library\">jQuery Superfish</a> à vos blocs de menu Drupal. Voir la <a href=\"@url_documentation\">documentation</a> du module pour plus d'informations."

msgid "In order to use Superfish, go to the <a href=\"@block\">Block layout</a> page and use any of the \"Place block\" buttons to create a Superfish block."
msgstr "Pour utiliser Superfish, accédez à la page <a href=\"@block\">Block layout</a> et utilisez l'un des boutons \"Place block\" pour créer un bloc Superfish."

msgid "Superfish library is missing. Please refer to the <a href=\"@documentation\">plugin documentation</a> for how you can fix this issue; Once done, go to the <a href=\"@block\">Block layout</a> page and use any of the \"Place block\" buttons to create a Superfish block."
msgstr "La bibliothèque Superfish manque. Reportez-vous à la <a href=\"@documentation\">documentation du plug-in</a> pour savoir comment résoudre ce problème. Une fois le problème résolu, accédez à la page <a href=\"@block\">Block layout</a> et utilisez l'un des boutons \"Place block\" pour créer un bloc Superfish."

msgid "If there was no Superfish block in the \"Place block\" form, go to the <a href=\"@performance\">Performance</a> page and clear the cache once."
msgstr "S'il n'y a pas de bloc Superfish dans le formulaire \"Place block\", accédez à la page <a href=\"@performance\">Performance</a> et effacez le cache une fois."

msgid "Superfish library"
msgstr "Bibliothèque Superfish"

msgid "Inaccessible"
msgstr "Inaccessible"

msgid "Cannot access the Superfish library directory; perhaps because its permissions and/or ownership are not set up correctly."
msgstr "Impossible d'accéder au répertoire de bibliothèque Superfish ; ses droits et/ou sa propriété ne sont peut-être pas correctement configurés."

msgid "Unknown version"
msgstr "Version inconnue"

msgid "Cannot determine the version of your Superfish library."
msgstr "Impossible de déterminer la version de votre bibliothèque Superfish."

msgid "Not supported"
msgstr "Non pris en charge"

msgid "The Superfish library requires an update. You can find the update instructions on :url."
msgstr "La bibliothèque Superfish doit être mise à jour. Les instructions de mise à jour sont disponibles à l'adresse :url."

msgid "Installed; at @location"
msgstr "Installé dans @location"

msgid "Not installed"
msgstr "Non installé"

msgid "Please download the Superfish library from :url."
msgstr "Téléchargez la bibliothèque Superfish depuis :url."

msgid "Superfish"
msgstr "Superfish"

msgid "Adds jQuery Superfish plugin to menu blocks."
msgstr "Ajoute le plug-in jQuery Superfish à des blocs de menu."

msgid "User interface"
msgstr "Interface utilisateur"

msgid "Block settings"
msgstr "Réglages du bloc"

msgid "Default"
msgstr "Par défaut"

msgid "Horizontal (single row)"
msgstr "Horizontal (ligne unique)"

msgid "Menu type"
msgstr "Type de menu"

msgid "Horizontal (double row)"
msgstr "Horizontal (deux lignes)"

msgid "Vertical (stack)"
msgstr "Vertical (pile)"

msgid "Style"
msgstr "Style"

msgid "Black"
msgstr "Noir"

msgid "Blue"
msgstr "Bleu"

msgid "Coffee"
msgstr "Café"

msgid "White"
msgstr "Blanc"

msgid "Add arrows to parent menus"
msgstr "Ajouter des flèches aux menus parent"

msgid "Drop shadows"
msgstr "Supprimer les ombres"

msgid "jQuery Easing plugin is not installed."
msgstr "Le plug-in Assouplissement jQuery n'est pas installé."

msgid "The plugin provides a handful number of animation effects, they can be used by uploading the 'jquery.easing.js' file to the libraries directory within the 'easing' directory (for example: libraries/easing/jquery.easing.js). Refresh this page after the plugin is uploaded, this will make more effects available in the above list."
msgstr "Le plug-in fournit de nombreux effets d'animation que vous pouvez utiliser après avoir téléchargé le fichier 'jquery.easing.js' dans le répertoire libraries sous le répertoire 'easing' (par exemple libraries/easing/jquery.easing.js). Actualisez cette page une fois le plug-in téléchargé ; ainsi, la liste ci-dessus contiendra davantage d'effets."

msgid "Slide-in effect"
msgstr "Effet de glissement"

msgid "Superfish plugins"
msgstr "Plug-ins Superfish"

msgid "Relocates sub-menus when they would otherwise appear outside the browser window area."
msgstr "Relocalise les sous-menus lorsqu'ils apparaissent en dehors de la zone de la fenêtre du navigateur."

msgid "enabled"
msgstr "activé"

msgid "jQuery Supposition"
msgstr "Supposition jQuery"

msgid "Prevents accidental firing of animations by waiting until the user's mouse slows down enough, hence determinig user's <em>intent</em>."
msgstr "Empêche le déclenchement accidentel d'animations en attendant que la souris de l'utilisateur ralentisse suffisamment, ce qui détermine l'<em>intention</em> de l'utilisateur."

msgid "jQuery hoverIntent"
msgstr "jQuery hoverIntent"

msgid "<strong>sf-Touchscreen</strong> provides touchscreen compatibility."
msgstr "<strong>sf-Touchscreen</strong> fournit la compatibilité avec les écrans tactiles."

msgid "The first click on a parent hyperlink shows its children and the second click opens the hyperlink."
msgstr "Le premier clic sur un lien hypertexte parent affiche ses enfants et le deuxième clic l'ouvre."

msgid "sf-Touchscreen"
msgstr "sf-Touchscreen"

msgid "Disable"
msgstr "Désactiver"

msgid "Enable jQuery sf-Touchscreen plugin for this menu."
msgstr "Activez le plug-in jQuery sf-Touchscreen pour ce menu."

msgid "Enable jQuery sf-Touchscreen plugin for this menu depending on the user's Web browser <strong>window width</strong>."
msgstr "Activez le plug-in jQuery sf-Touchscreen pour ce menu en fonction de la <strong>largeur de fenêtre</strong> du navigateur Web de l'utilisateur."

msgid "Enable jQuery sf-Touchscreen plugin for this menu depending on the user's Web browser <strong>user agent</strong>."
msgstr "Activez le plug-in jQuery sf-Touchscreen pour ce menu en fonction de l'<strong>agent utilisateur</strong> du navigateur Web de l'utilisateur."

msgid "Hiding the sub-menu on the second tap, adding cloned parent links to the top of sub-menus as well."
msgstr "Masquage du sous-menu à la deuxième tape et ajout de liens parent clonés au début des sous-menus."

msgid "Using this plugin, the first click or tap will expand the sub-menu, here you can choose what a second click or tap should do."
msgstr "Avec ce plug-in, le premier clic ou la première tape développe le sous-menu ; vous pouvez choisir l'effet d'un deuxième clic ou d'une deuxième tape."

msgid "Opening the parent menu item link on the second tap."
msgstr "Ouverture du lien d'élément de menu parent à la deuxième tape."

msgid "Hiding the sub-menu on the second tap."
msgstr "Masquage du sous-menu à la deuxième tape."

msgid "sf-Touchscreen will be enabled only if the width of user's Web browser window is smaller than the below value."
msgstr "sf-Touchscreen n'est activé que si la largeur de la fenêtre de navigateur Web de l'utilisateur est inférieure à la valeur ci-dessous."

msgid "Please note that in most cases such a meta tag is necessary for this feature to work properly:"
msgstr "Dans la plupart des cas, une balise meta du type suivant est nécessaire pour que cette fonction s'exécute correctement :"

msgid "Window width settings"
msgstr "Paramètres de largeur de fenêtre"

msgid "Also known as \"Breakpoint\"."
msgstr "Egalement connu sous le nom de \"point d'arrêt\"."

msgid "pixels"
msgstr "pixels"

msgid "User agent settings"
msgstr "Paramètres d'agent utilisateur"

msgid "Use the pre-defined list of the <strong>user agents</strong>."
msgstr "Utilisez la liste prédéfinie des <strong>agents utilisateur</strong>."

msgid "Recommended"
msgstr "Recommandé"

msgid "Use the custom list of the <strong>user agents</strong>."
msgstr "Utilisez la liste personnalisée des <strong>agents utilisateur</strong>."

msgid "UA string of the current Web browser:"
msgstr "Chaîne d'agent utilisateur du navigateur Web en cours :"

msgid "Could be partial or complete. (Asterisk separated)"
msgstr "Peut être partielle ou complète. (Séparés par un astérisque)"

msgid "empty"
msgstr "vide"

msgid "Examples"
msgstr "Exemples"

msgid "Custom list of the user agents"
msgstr "Liste personnalisée des agents utilisateur"

msgid "Client-side (JavaScript)"
msgstr "Côté client (JavaScript)"

msgid "<strong>User agent</strong> detection method"
msgstr "Méthode de détection d'<strong>agent utilisateur</strong>"

msgid "Server-side (PHP)"
msgstr "Côté serveur (PHP)"

msgid "sf-Smallscreen"
msgstr "sf-Smallscreen"

msgid "<strong>sf-Smallscreen</strong> provides small-screen compatibility for your menus."
msgstr "<strong>sf-Smallscreen</strong> fournit la compatibilité avec les petits écrans pour vos menus."

msgid "Enable jQuery sf-Smallscreen plugin for this menu depending on the user's Web browser <strong>window width</strong>."
msgstr "Activez le plug-in jQuery sf-Smallscreen pour ce menu en fonction de la <strong>largeur de fenêtre</strong> du navigateur Web de l'utilisateur."

msgid "Enable jQuery sf-Smallscreen plugin for this menu."
msgstr "Activez le plug-in jQuery sf-Smallscreen pour ce menu."

msgid "Enable jQuery sf-Smallscreen plugin for this menu depending on the user's Web browser <strong>user agent</strong>."
msgstr "Activez le plug-in jQuery sf-Smallscreen pour ce menu en fonction de l'<strong>agent utilisateur</strong> du navigateur Web de l'utilisateur."

msgid "sf-Smallscreen will be enabled only if the width of user's Web browser window is smaller than the below value."
msgstr "sf-Smallscreen n'est activé que si la largeur de la fenêtre de navigateur Web de l'utilisateur est inférieure à la valeur ci-dessous."

msgid "Convert the menu to an accordion menu."
msgstr "Convertissez le menu en menu accordéon."

msgid "Select a type"
msgstr "Sélectionnez un type"

msgid "Convert the menu to a &lt;select&gt; element."
msgstr "Convertissez le menu en élément &lt;select&gt;."

msgid "&lt;select&gt; settings"
msgstr "Paramètres &lt;select&gt;"

msgid "By default the first item in the &lt;select&gt; element will be the name of the parent menu or the title of this block, you can change this by setting a custom title."
msgstr "Par défaut, le premier élément de l'élément &lt;select&gt; sera le nom du menu parent ou le titre de ce bloc. Vous pouvez le modifier en définissant un titre personnalisé."

msgid "Example"
msgstr "Exemple"

msgid "Main Menu"
msgstr "Menu principal"

msgid "&lt;select&gt; title"
msgstr "Titre &lt;select&gt;"

msgid "Add <em>selected</em> attribute to the &lt;option&gt; element with the class <strong>active</strong> ."
msgstr "Ajoutez l'attribut <em>selected</em> à l'élément <option> avec la classe <strong>active</strong>."

msgid "Makes pre-selected the item linked to the active page when the page loads."
msgstr "Présélectionne l'élément lié à la page active lors du chargement de la page."

msgid "More"
msgstr "Plus"

msgid "Copy the main &lt;ul&gt; classes to the &lt;select&gt;."
msgstr "Copiez les classes &lt;ul&gt; principales dans &lt;select&gt;."

msgid "disabled"
msgstr "désactivé"

msgid "Comma separated"
msgstr "Eléments séparés par une virgule"

msgid "Exclude these classes from the &lt;select&gt; element"
msgstr "Exclure ces classes de l'élément &lt;select&gt;"

msgid "Copy the hyperlink classes to the &lt;option&gt; elements of the &lt;select&gt;."
msgstr "Copiez les classes d'hyperlien dans les éléments &lt;option&gt; de &lt;select&gt;."

msgid "Exclude these classes from the &lt;option&gt; elements of the &lt;select&gt;"
msgstr "Excluez ces classes des éléments &lt;option&gt; de &lt;select&gt;"

msgid "Include these classes in the &lt;select&gt; element"
msgstr "Incluez ces classes dans l'élément &lt;select&gt;"

msgid "Include these classes in the &lt;option&gt; elements of the &lt;select&gt;"
msgstr "Incluez ces classes dans les éléments &lt;option&gt; de &lt;select&gt;"

msgid "Accordion settings"
msgstr "Paramètres d'accordéon"

msgid "By default the caption of the accordion toggle switch will be the name of the parent menu or the title of this block, you can change this by setting a custom title."
msgstr "Par défaut, la légende du bouton d'activation/de désactivation de l'accordéon est le nom du menu parent ou le titre de ce bloc, que vous pouvez changer en définissant un titre personnalisé."

msgid "Menu"
msgstr "Menu"

msgid "Accordion menu title"
msgstr "Titre du menu accordéon"

msgid "Use parent menu items as buttons, add cloned parent links to sub-menus as well."
msgstr "Utilisez les éléments de menu parent comme boutons et ajoutez des liens parent clonés aux sous-menus."

msgid "Accordion button type"
msgstr "Type de bouton d'accordéon"

msgid "Use parent menu items as buttons."
msgstr "Utilisez des éléments de menu parent comme boutons."

msgid "Create new links next to parent menu item links and use them as buttons."
msgstr "Créez des liens à côté des liens d'élément de menu parent et utilisez-les comme boutons."

msgid "Supersubs"
msgstr "Superpositions"

msgid "<strong>Supersubs</strong> makes it possible to define custom widths for your menus."
msgstr "Les <strong>Superpositions</strong> permettent de définir des largeurs personnalisées pour vos menus."

msgid "Enable Supersubs for this menu."
msgstr "Activer les superpositions pour ce menu."

msgid "Minimum width for sub-menus, in <strong>em</strong> units."
msgstr "Largeur minimale des sous-menus, en unités <strong>em</strong>."

msgid "Minimum width"
msgstr "Largeur minimale"

msgid "Maximum width for sub-menus, in <strong>em</strong> units."
msgstr "Largeur maximale des sous-menus, en unités <strong>em</strong>."

msgid "Maximum width"
msgstr "Largeur maximale"

msgid "Please refer to the Superfish module documentation for how you should setup multi-column sub-menus."
msgstr "Consultez la documentation du module Superfish pour apprendre à configurer des sous-menus à plusieurs colonnes."

msgid "Multi-column sub-menus"
msgstr "Sous-menus à colonnes multiples"

msgid "Enable multi-column sub-menus."
msgstr "Activez les sous-menus à colonnes multiples."

msgid "The depth of the first instance of multi-column sub-menus."
msgstr "Profondeur de la première instance des sous-menus à plusieurs colonnes."

msgid "Start from depth"
msgstr "Commencer à partir de la profondeur"

msgid "The amount of sub-menu levels that will be included in the multi-column sub-menu."
msgstr "Nombre de niveaux de sous-menu qui seront inclus dans le sous-menu à plusieurs colonnes."

msgid "Levels"
msgstr "Niveaux"

msgid "Advanced settings"
msgstr "Paramètres avancés"

msgid "The speed of the animation either in <strong>milliseconds</strong> or pre-defined values (<strong>slow, normal, fast</strong>)."
msgstr "Vitesse de l'animation en <strong>millisecondes</strong> ou valeurs prédéfinies (<strong>slow, normal, fast</strong>)."

msgid "Animation speed"
msgstr "Vitesse d'animation"

msgid "The delay in <strong>milliseconds</strong> that the mouse can remain outside a sub-menu without it closing."
msgstr "Délai en <strong>millisecondes</strong> pendant lequel la souris peut rester en dehors d'un sous-menu sans qu'il se ferme."

msgid "Mouse delay"
msgstr "Délai de la souris"

msgid "The amount of sub-menu levels that remain open or are restored using the \".active-trail\" class."
msgstr "Nombre de niveaux de sous-menu qui restent ouverts ou qui sont restaurés à l'aide de la classe \".active-trail\"."

msgid "Change this setting <strong>only and only</strong> if you are <strong>totally sure</strong> of what you are doing."
msgstr "Changez ce paramètre <strong>seulement</strong> si vous <strong>maîtrisez la situation</strong>."

msgid "Path levels"
msgstr "Niveaux de chemin"

msgid "Hyperlinks"
msgstr "Hyperliens"

msgid "By enabling this option, only parent menu items with <em>Expanded</em> option enabled will have their submenus appear."
msgstr "Si cette option est activée, les sous-menus n'apparaissent que pour les éléments de menu parent dont l'option <em>Déplié</em> est activée."

msgid "Take \"Expanded\" option into effect."
msgstr "Activez l'option \"Expanded\"."

msgid "Add cloned parent links to the top of sub-menus."
msgstr "Ajoutez des liens parent clonés au début des sous-menus."

msgid "Disable hyperlink descriptions (\"title\" attribute)"
msgstr "Désactivez les descriptions de liens hypertexte (attribut \"title\")"

msgid "Insert hyperlink descriptions (\"title\" attribute) into hyperlink texts."
msgstr "Insérez des descriptions de lien hypertexte (attribut \"title\") dans les textes de lien hypertexte."

msgid "Add item depth classes to menu items and their hyperlinks."
msgstr "Ajoutez des classes de profondeur d'élément à des éléments de menu et à leurs liens hypertexte."

msgid "Custom classes"
msgstr "Classes personnalisées"

msgid "(Space separated, without dots)"
msgstr "(Séparés par des espaces, sans points)"

msgid "For the main UL"
msgstr "Pour l'UL principal"

msgid "For the list items"
msgstr "Pour les éléments de liste"

msgid "For the hyperlinks"
msgstr "Pour les hyperliens"

msgid "Unacceptable value entered for the \"Animation speed\" option."
msgstr "Valeur inacceptable entrée pour l'option \"Vitesse d'animation\"."

msgid "Unacceptable value entered for the \"Mouse delay\" option."
msgstr "Valeur inacceptable entrée pour l'option \"Délai de la souris\"."

msgid "\"sfTouchscreen Breakpoint\" option cannot be empty."
msgstr "L'option \"Point d'arrêt sfTouchscreen\" ne peut pas être vide."

msgid "Unacceptable value enterd for the \"sfTouchscreen Breakpoint\" option."
msgstr "Valeur inacceptable pour l'option \"Point d'arrêt sfTouchscreen\"."

msgid "List of the touch-screen user agents cannot be empty."
msgstr "La liste des agents utilisateur d'écran tactile ne peut pas être vide."

msgid "\"sfSmallscreen Breakpoint\" option cannot be empty."
msgstr "L'option \"Point d'arrêt sfSmallscreen\" ne peut pas être vide."

msgid "Unacceptable value entered for the \"sfSmallscreen Breakpoint\" option."
msgstr "Une valeur inacceptable a été entrée pour l'option \"Point d'arrêt sfSmallscreen\"."

msgid "List of the small-screen user agents cannot be empty."
msgstr "La liste des agents utilisateur de petit écran ne peut pas être vide."

msgid "Unacceptable value entered for the \"Supersubs minimum width\" option."
msgstr "Valeur inacceptable entrée pour l'option \"Largeur minimale des superpositions\"."

msgid "Unacceptable value entered for the \"Supersubs maximum width\" option."
msgstr "Valeur inacceptable entrée pour l'option \"Largeur maximale des superpositions\"."

msgid "Supersubs \"maximum width\" has to be bigger than the \"minimum width\"."
msgstr "La \"largeur maximale\" des superpositions doit être supérieure à la \"largeur minimale\"."

msgid "Expand"
msgstr "Développer"

msgid "Collapse"
msgstr "Condenser"

