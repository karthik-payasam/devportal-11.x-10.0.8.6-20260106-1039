msgid "All Product entries deleted."
msgstr "Byly odstraněny všechny položky produktu."

msgid "Drush @func No Product provided"
msgstr "Modul Drush @func nedodal žádný produkt"

msgid "Drush DeleteProduct deleted Product @prod"
msgstr "Modul Drush DeleteProduct odstranil produkt @prod"

msgid "Drush DeleteProduct could not find Product @prod"
msgstr "Modul Drush DeleteProduct nemůže najít produkt @prod"

msgid "Drush DeleteProduct deleted retired API @api"
msgstr "Modul Drush DeleteProduct odstranil vyřazené rozhraní API @api"

msgid "Drush DeleteProduct No Product provided."
msgstr "Modul Drush DeleteProduct nedodal žádný produkt."

msgid "Drush product supersede : found a product in a strange lifecycle state '@state'. Expected 'published' or 'deprecated'."
msgstr "Nahrazení produktu modulu Drush: nalezen produkt v neobvyklém stavu životního cyklu '@state'. Očekáváno 'published' nebo 'deprecated'."

msgid "Drush SupersedeProduct deleted retired API @api"
msgstr "Modul Drush SupersedeProduct odstranil vyřazené rozhraní API @api"

msgid "Drush product supersede : incorrect number of applications with url '@url' found. Should be 1 but was @count."
msgstr "Nahrazení produktu modulu Drush: byl nalezen nesprávný počet s adresou url '@url'. Měl být 1, ale byl @count."

msgid "Drush product supersede : incorrect number of products found. Should be 2 but was @count."
msgstr "Nahrazení produktu modulu Drush: byl nalezen chybný počet produktů. Měl být 2, ale byl @count."

msgid "Drush product supersede : no content provided."
msgstr "Nahrazení produktu modulu Drush: nebyl dodán žádný obsah."

msgid "Drush ReplaceProduct deleted retired API @api"
msgstr "Modul Drush ReplaceProduct odstranil vyřazené rozhraní API @api"

msgid "Drush product replace : found a product in a strange lifecycle state '@state'. Expected 'published', 'deprecated' or 'retired'."
msgstr "Nahrazení produktu modulu Drush: nalezen produkt v neobvyklém stavu životního cyklu '@state'. Očekáváno: 'published', 'deprecated' nebo 'staženo'."

msgid "Drush product replace : incorrect number of products found. Should be 2 but was @count."
msgstr "Nahrazení produktu modulu Drush: byl nalezen chybný počet produktů. Měl být 2, ale byl @count."

