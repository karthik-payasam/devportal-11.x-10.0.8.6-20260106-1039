msgid "Metatag: Pinterest"
msgstr "Metaznačka: Pinterest"

msgid "Provides support for Pinterest's custom meta tags."
msgstr "Poskytuje podporu pro vlastní metaznačky platformy Pinterest."

msgid "SEO"
msgstr "SEO"

msgid "Pinterest: Description"
msgstr "Pinterest: Popis"

msgid "Pinterest: ID"
msgstr "Pinterest: ID"

msgid "Pinterest: Media"
msgstr "Pinterest: Média"

msgid "Pinterest: No hover"
msgstr "Pinterest: Bez události hover"

msgid "Pinterest: No pin"
msgstr "Pinterest: Bez ukotvení"

msgid "Pinterest: No search"
msgstr "Pinterest: Bez hledání"

msgid "Pinterest: URL"
msgstr "Pinterest: Adresa URL"

msgid "Pinterest"
msgstr "Pinterest"

msgid "A set of meta tags used to control how the site's content is consumed by <a href='https://pinterest.com/'>Pinterest</a>."
msgstr "Sada metaznaček, jež se používají k řízení způsobu, kterým je obsah stránky využíván platformou <a href='https://pinterest.com/'>Pinterest</a>."

msgid "Description"
msgstr "Popis"

msgid "A one to two sentence description of the content."
msgstr "Popis obsahu o jedné či dvou větách."

msgid "Id"
msgstr "ID"

msgid "The Canonical Pinterest object to pin."
msgstr "Kanonický objekt Pinterest k ukotvení."

msgid "Media"
msgstr "Média"

msgid "The URL of media which should represent the content."
msgstr "Adresa URL média, jež představuje obsah."

msgid "No hover"
msgstr "Bez události hover"

msgid "Do not show hovering Save or Search buttons, generated by the Pinterest browser extensions."
msgstr "Nezobrazovat plovoucí popisky (hover) pro tlačítka Uložit a Hledat, které jsou generovány doplňky prohlížeče pro platformu Pinterest."

msgid "No pin"
msgstr "Bez ukotvení"

msgid "Do not pin anything from this page. When selected, this option will take precedence over all options below."
msgstr "Neukotvovat nic na této stránce. Je-li tato volba vybrána, má přednost před všemi níže uvedenými volbami"

msgid "No search"
msgstr "Bez hledání"

msgid "Do not allow Pinterest visual search to happen from this page."
msgstr "Nepovolit vizuální hledání Pinterest na této stránce."

msgid "URL"
msgstr "URL"

msgid "The URL which should represent the content."
msgstr "Adresa URL představující obsah."

