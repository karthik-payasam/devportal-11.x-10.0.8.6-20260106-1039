msgid "Font Awesome IconPicker"
msgstr "Lettertype Awesome IconPicker"

msgid "The fontIconPicker library is installed."
msgstr "De bibliotheek fontIcon Picker is geïnstalleerd."

msgid "Not installed"
msgstr "Niet geïnstalleerd"

msgid "The fontIconPicker library could not be found. To use the Font Awesome Iconpicker, please verify that the fontIconPicker library is installed correctly. Please see the Font Awesome Iconpicker submodule README file for more details."
msgstr "De bibliotheek fontIcon Picker is niet gevonden. Als u de lettertype Awesome Iconpicker wilt gebruiken, controleer dan of de bibliotheek fontIcon Picker correct is geïnstalleerd. Zie het README-bestand voor de submodule Font Awesome Iconpicker voor meer informatie."

msgid "Font Awesome Iconpicker Widget"
msgstr "Lettertype Awesome Iconpicker Widget"

msgid "Provides an iconpicker widget for Font Awesome"
msgstr "Biedt een iconpicker-widget voor lettertype Awesome"

msgid "IconPicker already present at @path. No download required."
msgstr "IconPicker is al aanwezig bij @path. Geen download vereist."

msgid "Drush was unable to download the fontIconPicker library from @remote."
msgstr "Drush kon de bibliotheek fontIcon Picker niet downloaden van @remote."

msgid "Error: unable to download fontIconPicker library from @remote"
msgstr "Fout: kan fontIconPicker-bibliotheek niet downloaden van @remote"

msgid "fontIconPicker library has been successfully downloaded to @path."
msgstr "De bibliotheek fontIconPicker is gedownload naar @path."

msgid "Drush was unable to load the fontIconPicker) library"
msgstr "Drush kon de bibliotheek fontIconPicker niet laden"

msgid "Icon Name"
msgstr "Pictogramnaam"

msgid "Invalid icon"
msgstr "Ongeldig pictogram"

