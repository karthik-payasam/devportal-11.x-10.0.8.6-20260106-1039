msgid "About"
msgstr "Über"

msgid "Secure File Upload Mime Detect"
msgstr "Mime-Erkennung für Secure File-Upload"

msgid "Fileinfo extension"
msgstr "Fileinfo-Erweiterung"

msgid "Found"
msgstr "Gefunden"

msgid "Fileinfo extension not available"
msgstr "Fileinfo-Erweiterung nicht verfügbar"

msgid "File upload secure validator module uses Fileinfo extension. It seems as if Fileinfo extension is not loaded/enabled. If you are using Windows, may be, you should uncomment php_fileinfo.dll in php.ini file."
msgstr "Sicheres Validatormodul für Dateiupload verwendet Fileinfo-Erweiterung. Die Fileinfo-Erweiterung wurde anscheinend nicht geladen/aktiviert. Wenn Sie Windows verwenden, sollten Sie möglicherweise die Kommentarzeichen für 'php_fileinfo.dll' in der Datei 'php.ini' entfernen."

msgid "File Upload Secure Validator"
msgstr "Sicherer Validator für den Dateiupload"

msgid "Secure Mime Detect"
msgstr "Sichere Mime-Erkennung"

msgid "Security"
msgstr "Sicherheit"

msgid "Manage the list of MIME types equivalence groups."
msgstr "Verwalten Sie die Liste der MIME-Typ-Äquivalenzgruppen."

msgid "Administer File Upload Secure Validator configuration"
msgstr "Konfiguration von File Upload Secure Validator verwalten"

msgid "Allow user to administer File Upload Secure Validator configuration."
msgstr "Ermöglicht es dem Benutzer, die Konfiguration von File Upload Secure Validator zu verwalten."

msgid "SettingsForm"
msgstr "Konfigruationsformualr"

msgid "MIME types equivalence groups"
msgstr "MIME-Typen Äquivalenzgruppen"

msgid "MIME types equivalence group"
msgstr "MIME-Typen Äquivalenzgruppe"

msgid "MIME type"
msgstr "MIME-Typ"

msgid "MIME types equivalence group(s)"
msgstr "MIME-Typen-Äquivalenzgruppe(n)"

msgid "A CSV-like list of MIME types groups; if two MIME types are part of the same group, then, File Upload Secure Validator will not protest."
msgstr "Eine CSV-ähnliche Liste von MIME-Typen-Gruppen; wenn zwei MIME-Typen Teil der gleichen Gruppe sind, wird File Upload Secure Validator nicht protestieren."

msgid "Caught an InvalidArgumentException; cannot validate missing file requested as @path"
msgstr "Es wurde eine InvalidArgument-Ausnahmebedingung abgefangen. Die als @path angeforderte fehlende Datei kann nicht validiert werden"

msgid "There was a problem with this file. The uploaded file is of type @extension but the real content seems to be @real_extension"
msgstr "Bei dieser Datei ist ein Fehler aufgetreten. Die hochgeladene Datei ist vom Typ @extension, aber der eigentliche Inhalt scheint @real_extension zu sein."

msgid "Error while uploading file: MimeTypeGuesser guessed '%mime_by_fileinfo' and fileinfo '%mime_by_filename'"
msgstr "Fehler beim Hochladen der Datei: MimeTypeGuesser hat '%mime_by_fileinfo' und Dateiinfo '%mime_by_filename' angenommen"

