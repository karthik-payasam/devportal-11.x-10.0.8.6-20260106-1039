msgstr "Configureer hieronder de metatags."

msgid "Undefined group '%group' on tag '%tag'"
msgstr "Niet-gedefinieerde groep '%group' voor tag '%tag'"

msgid ""
"This was expected to be an array but it is not: \n"
"%value"
