msgid "Open in a new browser window or tab (_blank)"
msgstr "Otevřít v novém okně nebo kartě prohlížeče (_blank)"

msgid "Open in the current window (_self)"
msgstr "Otevřít v aktuálním okně (_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "Otevřít v rámci, jenž je nadřazený rámci, ve kterém je odkaz (_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "Zrušit všechny rámce a otevřít v úplném okně prohlížeče (_top)"

msgid "Default rel"
msgstr "Výchozí rel"

msgid "Remove rel attribute"
msgstr "Odebrat atribut rel"

