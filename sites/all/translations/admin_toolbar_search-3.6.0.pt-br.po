msgid "About"
msgstr "Sobre"

msgid "The Admin Toolbar Search module add a search option to the toolbar for site administrative tasks."
msgstr "O módulo Procura da barra de ferramentas do administrador inclui uma opção de procura na barra de ferramentas para as tarefas administrativas do site."

msgid "Search"
msgstr "Procurar"

msgid "Admin Toolbar quick search"
msgstr "Procura rápida da Barra de Ferramentas do Administrador"

msgid "Admin Toolbar Search"
msgstr "Pesquisa da barra de ferramentas do administrador"

msgid "Provides search of Admin Toolbar items."
msgstr "Fornece procura de itens da Barra de Ferramentas do Administrador."

msgid "Administration"
msgstr "Administração"

msgid "Configure the Admin Toolbar Search module."
msgstr "Configurar o módulo Admin Toolbar Search."

msgid "Use Admin Toolbar search"
msgstr "Usar a Procura da barra de ferramentas do administrador"

msgid "Admin toolbar search settings"
msgstr "Configurações do Admin Toolbar Search"

msgid "Admin Toolbar Search settings"
msgstr "Configurações do Admin Toolbar Search"

msgid "How the search input will be displayed"
msgstr "Como a entrada de procura será exibida"

msgid "@entity_type > @bundle"
msgstr "@entity_type > @bundle"

msgid "Edit"
msgstr "Editar"

msgid "Manage fields"
msgstr "Gerenciar campos"

msgid "Manage form display"
msgstr "Gerenciar exibição de formulário"

msgid "Manage display"
msgstr "Gerenciar exibição"

msgid "Devel"
msgstr "Devel"

msgid "Delete"
msgstr "Excluir"

msgid "Menus > @menu_label"
msgstr "Menus > @menu_label"

msgid "Menus > @menu_label > Add link"
msgstr "Menus > @menu_label > Incluir link"

msgid "Menus > @menu_label > Delete"
msgstr "Menus > @menu_label > Excluir"

msgid "Menus > @menu_label > Devel"
msgstr "Menus> @menu_label > Desenvolver"

msgid "Display the search input as a menu item."
msgstr "Exibir a entrada de procura como um item de menu."

msgid "If set, instead of displaying a text input field, it displays a menu item in the toolbar so the user has to click on it to toggle the search input."
msgstr "Se configurado, em vez de exibir um campo de entrada de texto, ele exibirá um item de menu na barra de ferramentas para que o usuário tenha que clicar nele para alternar a entrada de procura."

