msgid "Gravatar"
msgstr "Gravatar"

msgid "Adds Gravatar.com avatar generators for Avatar Kit."
msgstr "Inclui geradores de avatar do Gravatar.com para o Avatar Kit."

msgid "Avatars"
msgstr "Avatars"

msgid "Maximum content rating"
msgstr "Classificação máxima de conteúdo"

msgid "Gravatar generator"
msgstr "Gerador do Gravatar"

msgid "Type"
msgstr "Autenticação"

msgid "Unrestricted"
msgstr "Sem restrições"

msgid "G: suitable for display on all websites with any audience type."
msgstr "G: adequado para exibição em todos os websites com qualquer tipo de público."

msgid "PG: may contain rude gestures, provocatively dressed individuals, the lesser swear words, or mild violence."
msgstr "PG: pode conter gestos rudes, pessoas vestidas de forma provocativa, palavrões menores ou violência leve."

msgid "R: may contain such things as harsh profanity, intense violence, nudity, or hard drug use."
msgstr "R: pode conter coisas como palavras de baixo escalão, violência intensa, nudez ou uso de drogas pesadas."

msgid "X: may contain hardcore sexual imagery or extremely disturbing violence."
msgstr "X: pode conter imagens sexuais explícitas ou de violência extremamente perturbadora."

msgid "Maximum rating: @maximum_rating"
msgstr "Classificação máxima: @maximum_rating"

msgid "Universal avatar uploaded to Gravatar.com"
msgstr "Avatar universal transferido por upload para Gravatar.com"

msgid "Identicon"
msgstr "Identicon"

msgid "Monster ID"
msgstr "ID do Monster"

msgid "Wavatar"
msgstr "Wavatar"

msgid "8-bit style avatar"
msgstr "Avatar de estilo de 8 bits"

msgid "Missing Configuration"
msgstr "Configuração ausente"

msgid "Type: @type"
msgstr "Tipo: @type"

msgid "Identicon, MonsterID, Retro, and Wavatar avatar generators."
msgstr "Geradores de avatar Identicon, MonsterID, Retro e Wavatar."

