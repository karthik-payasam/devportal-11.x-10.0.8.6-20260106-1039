msgstr "Typ przycięcia."

msgid "Language code"
msgstr "Kod języka"

msgid "The node language code."
msgstr "Kod języka węzła."

msgid "Entity ID"
msgstr "ID encji"

msgid "ID of entity crop belongs to."
msgstr "Identyfikator jednostki, do której należy przycięcie."

msgid "Entity type"
msgstr "Typ encji"

msgid "The type of entity crop belongs to."
msgstr "Typ jednostki, do której należy przycięcie."

msgid "URI"
msgstr "URI"

msgid "The URI of the image crop belongs to."
msgstr "Identyfikator URI obrazu, do którego należy przycięcie."

msgid "Height"
msgstr "Wysokość"

msgid "The crop height."
msgstr "Wysokość przycięcia."

msgid "Width"
msgstr "Szerokość"

msgid "The crop width."
msgstr "Szerokość przycięcia."

msgid "X coordinate"
msgstr "Współrzędna X"

msgid "The crop's X coordinate."
msgstr "Współrzędna X przycięcia."

msgid "Y coordinate"
msgstr "Współrzędna Y"

msgid "The crop's Y coordinate."
msgstr "Współrzędna Y przycięcia."

msgid "Revision timestamp"
msgstr "Znacznik czasowy wersji"

msgid "The time that the current revision was created."
msgstr "Czas utworzenia aktualnej wersji."

msgid "Revision author ID"
msgstr "Identyfikator autora wersji"

msgid "The user ID of the author of the current revision."
msgstr "ID użytkownika autora obecnej wersji."

msgid "Revision Log"
msgstr "Dziennik wersji"

msgid "The log entry explaining the changes in this revision."
msgstr "Wpis dziennika wyjaśnia zmiany w tej wersji."

msgid "Crop"
msgstr "Przytnij"

msgid "Are you sure you want to delete the crop type %type?"
msgstr "Czy na pewno usunąć typ przycięcia %type?"

msgid "The crop type %name has been deleted."
msgstr "Typ przycięcia %name został usunięty."

msgid "Deleted crop type %name."
msgstr "Usunięto typ przycięcia %name."

msgid "%type is used by 1 piece of content on your site. You can not remove this content type until you have removed all of the %type content."
msgid_plural "%type is used by @count pieces of content on your site. You may not remove %type until you have removed all of the %type content."
msgstr[0] "Rodzaj zawartości %type jest używany przez 1 element zawartości witryny. Nie można usunąć tego rodzaju zawartości dopóki nie zostanie usunięta cała zawartość typu %type."
msgstr[1] "Rodzaj zawartości %type jest używany przez @count elementy zawartości witryny. Nie można usunąć rodzaju zawartości %type dopóki nie zostanie usunięta cała zawartość typu %type."
msgstr[2] "Rodzaj zawartości %type jest używany przez @count elementów zawartości witryny. Nie można usunąć rodzaju zawartości %type dopóki nie zostanie usunięta cała zawartość typu %type."

msgid "Edit %label crop type"
msgstr "Edytuj typ przycięcia %label"

msgid "The human-readable name of this crop type. This name must be unique."
msgstr "Zrozumiała nazwa tego typu przycięcia. Ta nazwa musi być unikalna."

msgid "A unique machine-readable name for this crop type. It must only contain lowercase letters, numbers, and underscores."
msgstr "Unikalna nazwa tego typu przycięcia w formie zapisu maszynowego. Może zawierać tylko małe litery, cyfry i znaki podkreślenia."

msgid "Describe this crop type."
msgstr "Opisz ten typ przycięcia."

msgid "Set an aspect ratio <b>eg: 16:9</b> or leave this empty for arbitrary aspect ratio"
msgstr "Ustaw współczynnik kształtu obrazu (<b>np. 16:9</b>) lub pozostaw to pole puste w celu ustawienia dowolnego współczynnika kształtu obrazu."

msgid "Soft limit"
msgstr "Miękki limit"

msgid "Define crop size soft limit. Warning will be displayed if crop smaller than that is selected."
msgstr "Zdefiniuj elastyczny limit wielkości przycięcia. W przypadku wybrania mniejszego przycięcia zostanie wyświetlone ostrzeżenie."

msgid "Limit for width."
msgstr "Limit szerokości."

msgid "Limit for height."
msgstr "Limit wysokości."

msgid "Hard limit"
msgstr "Twarde ograniczenie"

msgid "Define crop size hard limit. User is not allowed to make a smaller selection than defined here."
msgstr "Zdefiniuj bezwzględny limit wielkości przycięcia. Uniemożliwia użytkownikowi wybranie mniejszej wielkości."

msgid "Limit for width"
msgstr "Limit szerokości"

msgid "Save crop type"
msgstr "Zapisz typ przycięcia"

msgid "Delete crop type"
msgstr "Usuń typ przycięcia"

msgid "The crop type %name has been updated."
msgstr "Zaktualizowano typ przycięcia %name."

msgid "The crop type %name has been added."
msgstr "Dodano typ przycięcia %name."

msgid "View"
msgstr "Widok"

msgid "Added crop type %name."
msgstr "Dodano typ przycięcia %name."

msgid "File"
msgstr "Plik"

msgid "Provides crop integration for core files."
msgstr "Zapewnia integrację przycięcia z podstawowymi plikami."

msgid "Provides crop integration for media."
msgstr "Zapewnia integrację przycięcia z multimediami."

msgid "Crop type to be used for the image style."
msgstr "Typ przycięcia, który ma być używany w przypadku stylu obrazu."

msgid "- Select a Provider -"
msgstr "-Wybierz dostawcę-"

msgid "The name of automatic crop provider to use if crop is not set for an image."
msgstr "Nazwa automatycznego dostawcy przycinania, który ma być używany, jeśli przycinanie nie zostało ustawione dla obrazu."

msgid "Manual image crop failed due to misconfigured crop type on %path."
msgstr "Ręczne przycinanie obrazu nie powiodło się z powodu błędnie skonfigurowanego typu przycięcia w ścieżce %path."

msgid "Manual image crop failed using the %toolkit toolkit on %path (%mimetype, %width x %height)"
msgstr "Ręczne przycinanie obrazu przy użyciu pakietu %toolkit w ścieżce %path (%mimetype, %width x %height) nie powiodło się."

msgid "Manual crop"
msgstr "Przytnij ręcznie"

msgid "Applies manually provided crop to the image."
msgstr "Umożliwia ręczne przycięcie obrazu."

msgctxt "Validation"
msgid "Crop Type aspect ratio"
msgstr "Współczynnik kształtu obrazu typu przycięcia"

msgid "Invalid aspect ratio format. Should be defined in H:W form."
msgstr "Niepoprawny format współczynnika kształtu obrazu. Powinien zostać zdefiniowany w postaci wys.:szer."

msgctxt "Validation"
msgid "Crop Type machine name"
msgstr "Nazwa typu przycięcia w formie zapisu maszynowego"

msgid "Invalid machine-readable name."
msgstr "Niepoprawna nazwa w formie zapisu maszynowego."

msgid "uses <em>@data.crop_type</em> crop type"
msgstr "używa typu przycięcia <em>@data.crop_type</em>"

