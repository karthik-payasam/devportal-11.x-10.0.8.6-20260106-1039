msgstr "Użyte w"

msgid "@first, @second and @count more"
msgstr "@first, @second i @count więcej"

msgid "No crop types available. <a href=\"@link\">Add crop type</a>."
msgstr "Brak dostępnych typów przycięcia. <a href=\"@link\">Dodaj typ przycięcia</a>."

msgid "Entity provider @id not found."
msgstr "Nie znaleziono dostawcy jednostek @id."

