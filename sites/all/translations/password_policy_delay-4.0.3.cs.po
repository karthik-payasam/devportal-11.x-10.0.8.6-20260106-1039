msgid "Password Policy Delay"
msgstr "Prodleva zásady hesla"

msgid "Sets up a password constraint to limit how soon before a password can be reset again."
msgstr "Nastaví omezení pro heslo, aby bylo omezeno, za jak dlouho může být heslo znovu resetováno."

msgid "Security"
msgstr "Zabezpečení"

msgid "Hours until next password reset may be performed."
msgstr "Počet hodin, než může být proveden další reset hesla."

msgid ""
"Not enough time has passed\n"
"          since this password was last reset."
msgstr ""
"Od posledního resetování tohoto hesla neuplynul dostatek času.\n"
""

msgid "Hours until password can be reset again."
msgstr "Počet hodin, než může být proveden další reset hesla."

msgid "A value of 0 represents no delay"
msgstr "Hodnota 0 znamená bez prodlevy"

msgid "The delay value must be zero or greater."
msgstr "Hodnota prodlevy musí být nula nebo větší."

msgid "Delay in hours until password can be reset: @delay"
msgstr "Prodleva v hodinách, než může být proveden další reset hesla: @delay"

msgid "Password Delay"
msgstr "Prodleva hesela"

msgid "Provide delay before password can be reset again."
msgstr "Zadejte prodlevu, než může být proveden další reset hesla."

msgid "You cannot reset your password until the delay has as elapsed."
msgstr "Heslo nemůžete resetovat, dokud neuplyne prodleva."

