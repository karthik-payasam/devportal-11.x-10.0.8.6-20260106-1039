msgid "About"
msgstr "Über"

msgid "Smart Trim implements a new field formatter for text fields (text, text_long, and text_with_summary, if you want to get technical) that improves upon the \"Summary or Trimmed\" formatter."
msgstr "Smart Trim implementiert einen neues Anzeigeformat für Textfelder (text, text_long und text_with_summary, wenn Sie die Systemnamen der beiden Anziegeformate wissen wollen), das das Anzeigeformat „Zusammenfassung oder gekürzt\" Formatierer verbessert."

msgid "More"
msgstr "Zusätzlich"

msgid "Read more about [node:title]"
msgstr "Weitere Informationen zu [node:title]"

msgid "Smart Trim"
msgstr "Automatisch kürzen"

msgid "Provides a more robust alternative to \"summary or trimmed\" textfield format"
msgstr "Ermöglicht die Anwendung erweiterter Einstellungen auf das Anzeigeformat „Zusammenfassung oder gekürzt“"

msgid "Fields"
msgstr "Felder"

msgid "Smart trim formatter settings"
msgstr "Einstellungen des Anzeigeforamts für automatisch gekürzte inhalte"

msgid "Trim length"
msgstr "Länge kürzen"

msgid "Trim units"
msgstr "Kürzungseinheiten"

msgid "Suffix"
msgstr "Suffix"

msgid "Wrap trimmed content"
msgstr "Gekürzte Inhalte mit einem Div-Element umgeben"

msgid "Wrapped content class"
msgstr "Klasse für von Div-Elementen umgebene Inhalte"

msgid "More link configuration"
msgstr "Konfiguration von Link 'Mehr'"

msgid "Display more link"
msgstr "Weiterlesen-Link anzeigen"

msgid "Open link in new window"
msgstr "Link in neuem Fenster öffnen"

msgid "More link only when content is trimmed"
msgstr "Link 'Mehr' nur, wenn Inhalt abgeschnitten wird"

msgid "More link class"
msgstr "Klasse für den Weiterlesen-Link"

msgid "More link text"
msgstr "Text des „Weiterlesen“-Links"

msgid "More link aria-label value"
msgstr "Mehr Link aria-label Wert"

msgid "Summary handler"
msgstr "Routine zur Verarbeitung der Zusammenfassung"

msgid "Additional options"
msgstr "Zusätzliche Optionen"

msgid "Strip HTML"
msgstr "HTML entfernen"

msgid "Honor a zero trim length"
msgstr "Zeichenkürzungsangaben mit eine Wert von 0 berücksichtigen"

msgid "Replace tokens before trimming"
msgstr "Token vor dem Kürzen austauschen"

msgid "Characters"
msgstr "Zeichen"

msgid "Words"
msgstr "Wörter"

msgid "Summary"
msgstr "Zusammenfassung"

msgid "Use summary if present, and do not trim"
msgstr "Zusammenfassung verwenden, falls vorhanden, und nicht kürzen."

msgid "Use summary if present, honor trim settings"
msgstr "Zusammenfassung verwenden, falls vorhanden, Kürzungseinstellungen berücksichtigen"

msgid "Do not use summary"
msgstr "Keine Zusammenfassung verwenden"

msgid "Wrap trimmed content?"
msgstr "Gekürzten Inhalt mit Element umgeben?"

msgid "Adds a wrapper div to trimmed content. This option is deprecated and will be removed in Smart Trim 3.0.0. Please override the smart-trim.html.twig template file to customize output."
msgstr "Fügt abgeschnittenem Inhalt ein Wrapper-DIV-Element hinzu. Diese Option ist veraltet und wird in Smart Trim 3.0.0 entfernt. Überschreiben Sie die Vorlagendatei smart-trim.html.twig, um die Ausgabe anzupassen."

msgid "Wrapped content class."
msgstr "CSS-Klasse für Inhalte, die mit Div-Elementen umgeben werden."

msgid "If wrapping, define the class name here."
msgstr "Falls gekürzte Inhalte mit Div-Elementen umgeben werden, geben Sie hier den Namen der zu verwendenden CSS-Klasse ein."

msgid "<em>More</em> link"
msgstr "Link <em>Mehr</em>"

msgid "Display <em>More</em> link?"
msgstr "Link <em>Mehr</em> anzeigen?"

msgid "Displays a link to the entity (if one exists)"
msgstr "Zeigt einen Link zur Entität an (Wenn eine Entität existiert)."

msgid "Display <em>More</em> link only when content is trimmed?"
msgstr "Link <em>Mehr</em> nur anzeigen, wenn Inhalt abgeschnitten ist?"

msgid "Only display <em>More</em> link if content is actually trimmed."
msgstr "Zeigt den Link <em>Mehr</em> nur an, wenn der Inhalt tatsächlich abgeschnitten ist."

msgid "Open <em>More</em> link in new window"
msgstr "Link <em>Mehr</em> in neuem Fenster öffnen"

msgid "<em>More</em> link text"
msgstr "Text zu Link <em>Mehr</em>"

msgid "If displaying <em>More</em> link, enter the text for the link. This field supports tokens."
msgstr "Wenn der Link <em>Mehr</em> angezeigt wird, geben Sie den Text für den Link ein. Dieses Feld unterstützt Tokens."

msgid "<em>More</em> link aria-label"
msgstr "aria-label für Link <em>Mehr</em>"

msgid "If displaying <em>More</em> link, provide additional context for screen-reader users. In most cases, the aria-label value will be announced instead of the link text. This field supports tokens."
msgstr "Wenn der Link <em>Mehr</em> angezeigt wird, stellen Sie zusätzlichen Kontext für Benutzer von Sprachausgabeprogrammen bereit. In den meisten Fällen wird der Wert \"aria-label\" anstelle des Linktexts gemeldet. Dieses Feld unterstützt Tokens."

msgid "<em>More</em> link class"
msgstr "Klasse für Link <em>Mehr</em>"

msgid "If displaying <em>More</em> link, add a custom class for formatting."
msgstr "Wenn der Link <em>Mehr</em> angezeigt wird, fügen Sie eine benutzerdefinierte Klasse für die Formatierung hinzu."

msgid "words"
msgstr "Wörter"

msgid "characters"
msgstr "Zeichen"

msgid "Suffix: %suffix"
msgstr "Suffix: %suffix"

msgid "<em>More</em> link enabled, text: %text"
msgstr "Link <em>Mehr</em> aktiviert, Text: %text"

msgid "Only display <em>More</em> link when trimmed"
msgstr "Link <em>Mehr</em> nur anzeigen, wenn abgeschnitten"

msgid "<em>More</em> link aria-label: %label"
msgstr "aria-label für Link <em>Mehr</em>: %label"

msgid "<em>More</em> link class: %class"
msgstr "Klasse für Link <em>Mehr</em>: %class"

msgid "Smart trimmed"
msgstr "Automatisch gekürzt"

