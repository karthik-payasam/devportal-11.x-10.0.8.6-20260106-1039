msgid "Views Autocomplete Filters"
msgstr "Filtres de saisie semi-automatique pour les vues"

msgid "Use Autocomplete for string field filters."
msgstr "Utilisez la saisie semi-automatique pour les filtres de zone de chaîne."

msgid "Views"
msgstr "Vues"

msgid "Autocomplete for Combine fields filter"
msgstr "Saisie semi-automatique pour le filtre de combinaison de zones"

msgid "Exposed"
msgstr "Exposé"

msgid "Use Autocomplete"
msgstr "Utiliser la saisie semi-automatique"

msgid "Minimum number of characters to start filter"
msgstr "Nombre minimal de caractères pour démarrer le filtrage"

msgid "Maximum number of items in Autocomplete"
msgstr "Nombre maximal d'éléments dans la saisie semi-automatique"

msgid "Field with autocomplete results"
msgstr "Zone contenant les résultats de la saisie semi-automatique"

msgid "Unformatted suggestion"
msgstr "Suggestion non formatée"

msgid "Unformatted dropdown"
msgstr "Liste déroulante non formatée"

msgid "Suggestions depend on other filter fields"
msgstr "Les suggestions dépendent d'autres zones de filtre"

msgid "Autocomplete for Search API fulltext search filter"
msgstr "Saisie semi-automatique pour le filtre de recherche de texte intégral de l'API de recherche"

msgid "Autocomplete for Search API text field filter"
msgstr "Saisie semi-automatique pour le filtre de zone de texte de l'API de recherche"

msgid "Autocomplete for basic textfield filter"
msgstr "Saisie semi-automatique pour le filtre de champ de texte de base"

msgid "Field for autocomplete filter %label is not set in view %view, display %display"
msgstr "La zone pour le filtre de saisie semi-automatique %label n'est pas définie dans la vue %view, affichage %display"

msgid "Field for autocomplete filter %label not exists in view %view, display %display"
msgstr "La zone pour le filtre de saisie semi-automatique %label n'existe pas dans la vue %view, affichage %display"

msgid "Use Autocomplete for this filter."
msgstr "Utilisez la saisie semi-automatique pour ce filtre."

msgid "Enter 0 for no limit."
msgstr "Saisir 0 pour ne pas limiter."

msgid "Autocomplete suggestions will be filtered by other filter fields"
msgstr "Les suggestions de saisie semi-automatique seront filtrées par d'autres zones de filtre"

msgid "The selected field will be used for drop-down results of the autocompletion. In most cases it should be the same field you use for the filter, and <em>must</em> be included in the field list for the view/display in order to appear here."
msgstr "La zone sélectionnée sera utilisée pour les résultats de liste déroulante de la saisie semi-automatique. Dans la plupart des cas, ce devrait être la même zone que celle que vous utilisez pour le filtre, et elle <em>doit</em> être incluse dans la liste des zones pour la vue ou l'écran pour apparaître ici."

msgid "Use unformatted data from database for dropdown list instead of field formatter result. Value will be printed as plain text."
msgstr "Utilisez les données non formatées de la base de données pour la liste déroulante au lieu du résultat de l'outil de formatage de zone. La valeur sera imprimée sous forme de texte en clair."

msgid "The same as above, but for suggestion (text appearing inside textfield when item is selected)."
msgstr "Identique à l'option ci-dessus, mais pour la suggestion (texte s'affichant la une zone de texte lorsqu'un élément est sélectionné)."

msgid "Add some fields to view"
msgstr "Ajouter des zones à la vue"

