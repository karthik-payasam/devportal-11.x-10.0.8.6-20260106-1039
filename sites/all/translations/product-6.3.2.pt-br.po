msgstr "O Drush ReplaceProduct excluiu a API @api obsoleta"

msgid "Drush product replace : found a product in a strange lifecycle state '@state'. Expected 'published', 'deprecated' or 'retired'."
msgstr "Substituição do produto Drush: localizado um produto em um estado de ciclo de vida estranho '@state'. Esperava-se 'published', 'deprecated' ou 'retired'."

msgid "Drush product replace : incorrect number of products found. Should be 2 but was @count."
msgstr "Substituição de produto Drush: número incorreto de produtos localizados. Deve ser 2, mas era @count."

