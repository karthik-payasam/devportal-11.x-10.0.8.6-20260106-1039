msgstr "Dal dominio"

msgid "Add another"
msgstr "Aggiungi un altro"

msgid "Save"
msgstr "Salva"

msgid "No protocol should be included in the redirect domain."
msgstr "Non deve essere incluso nessun protocollo nel dominio di reindirizzamento."

msgid "The domain redirects have been saved."
msgstr "I reindirizzamenti di dominio sono stati salvati."

msgid "Redirect ID"
msgstr "ID di reindirizzamento"

msgid "The redirect ID."
msgstr "L'ID di reindirizzamento."

msgid "UUID"
msgstr "UUID"

msgid "The record UUID."
msgstr "L'UUID del record."

