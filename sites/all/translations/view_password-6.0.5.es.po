msgid "About"
msgstr "Acerca de"

msgid "View Password module will help the user to see what password they entered."
msgstr "El módulo Ver contraseña ayudará al usuario a ver qué contraseña se ha especificado."

msgid "Show password"
msgstr "Mostrar contraseña"

msgid "Hide password"
msgstr "Ocultar contraseña"

msgid "View Password"
msgstr "Ver contraseña"

msgid "Allows the users to see the contents of the password fields on selected forms before submission."
msgstr "Permite a los usuarios ver el contenido de los campos de contraseña en formularios seleccionados antes de su envío."

msgid "View Password Settings"
msgstr "Ver valores de contraseña"

msgid "Lets you see password for the selected forms."
msgstr "Permite ver la contraseña para los formularios seleccionados."

msgid "Administer View password"
msgstr "Administrar Ver contraseña"

msgid "Configure the View password settings."
msgstr "Configurar los valores de Ver contraseña."

msgid "View password config"
msgstr "Configuración de Ver contraseña"

msgid "Do not want to display the password for this forms."
msgstr "No desea mostrar la contraseña para estos formularios."

msgid "Enter the form id(s) here."
msgstr "Especifique los ID de formulario aquí."

msgid "<p>Please enter the form id(s) by separating it with a comma (<em>make sure there are no spaces between form ids</em>). For example, the usual form ids are <code>user_login_form</code> and <code>user_register_form</code>. .</p>"
msgstr "<p>Especifique los ID de formulario separados por coma (<em>asegúrese de que no haya espacios entre los ID de formulario</em>). Por ejemplo, los ID de formulario habituales son <code>user_login_form</code> y <code>user_register_form</code>. .</p>"

msgid "Enter the form class here."
msgstr "Especifique aquí la clase de formulario."

msgid "Please enter the icon span classes separated with a space."
msgstr "Especifique las clases de extensión de icono (span) separadas por un espacio."

