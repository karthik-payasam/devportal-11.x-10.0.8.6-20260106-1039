msgid "Gravatar"
msgstr "Gravatar"

msgid "Adds Gravatar.com avatar generators for Avatar Kit."
msgstr "Añade generadores de avatar de Gravatar.com para el Kit de avatar."

msgid "Avatars"
msgstr "Avatares"

msgid "Maximum content rating"
msgstr "Calificación máxima del contenido"

msgid "Gravatar generator"
msgstr "Generador de Gravatar"

msgid "Type"
msgstr "Tipo"

msgid "Unrestricted"
msgstr "Sin restricciones"

msgid "G: suitable for display on all websites with any audience type."
msgstr "G: adecuado para visualizar en todos los sitios web con cualquier tipo de audiencia."

msgid "PG: may contain rude gestures, provocatively dressed individuals, the lesser swear words, or mild violence."
msgstr "PG: puede contener gestos groseros, individuos vestidos provocativamente, palabrotas suaves o violencia leve."

msgid "R: may contain such things as harsh profanity, intense violence, nudity, or hard drug use."
msgstr "R: puede contener cosas como blasfemia dura, violencia intensa, desnudos o consumo de drogas duras."

msgid "X: may contain hardcore sexual imagery or extremely disturbing violence."
msgstr "X: puede contener imágenes de sexo explícito o violencia extremadamente perturbadora."

msgid "Maximum rating: @maximum_rating"
msgstr "Calificación máxima: @maximum_rating"

msgid "Universal avatar uploaded to Gravatar.com"
msgstr "Avatar universal cargado en Gravatar.com"

msgid "Identicon"
msgstr "Identicon"

msgid "Monster ID"
msgstr "Monster ID"

msgid "Wavatar"
msgstr "Wavatar"

msgid "8-bit style avatar"
msgstr "Avatar de estilo de 8 bits"

msgid "Missing Configuration"
msgstr "Configuración faltante"

msgid "Type: @type"
msgstr "Tipo: @type"

msgid "Identicon, MonsterID, Retro, and Wavatar avatar generators."
msgstr "Generadores de avatar de Identicon, MonsterID, Retro y Wavatar."

