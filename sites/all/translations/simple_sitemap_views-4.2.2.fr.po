msgid "In order to use the Simple XML Sitemap Views module, the Views URL generator must be <a href=\"@url\">added</a> to a sitemap type."
msgstr "Pour utiliser le module Vues de plan de site XML simple, il faut <a href=\"@url\">ajouter</a> le générateur d'URL de vues à un type de plan de site."

msgid "Simple XML Sitemap (Views)"
msgstr "Plan de site XML simple (vues)"

msgid "Provides integration of the Simple XML Sitemap module with the Views module."
msgstr "Permet d'intégrer le module Plan de site XML simple au module Vues."

msgid "SEO"
msgstr "optimisation pour les moteurs de recherche"

msgid "Views"
msgstr "Vues"

msgid "Simple XML Sitemap"
msgstr "Plan de site XML simple"

msgid "Variants"
msgstr "Variantes"

msgid "Index"
msgstr "Index"

msgid "Priority"
msgstr "Priorité"

msgid "Change frequency"
msgstr "Modifier la fréquence"

msgid "Indexed arguments"
msgstr "Arguments indexés"

msgid "Max links"
msgstr "Nombre maximal de liens"

msgid "View"
msgstr "Afficher"

msgid "Display"
msgstr "Affichage"

msgid "Sitemaps"
msgstr "Plans du site"

msgid "Operations"
msgstr "Opérations"

msgid "No view displays are set to be indexed yet. <a href=\"@url\">Edit a view.</a>"
msgstr "Aucun affichage de vue n'est encore défini pour l'indexation. <a href=\"@url\">Editez une vue.</a>"

msgid "Please configure at least one <a href=\"@sitemaps_url\">sitemap</a> to be of a <a href=\"@types_url\">type</a> that implements the views URL generator."
msgstr "Configurez au moins un <a href=\"@sitemaps_url\">plan de site</a> pour qu'il soit d'un <a href=\"@types_url\">type</a> qui implémente le générateur d'URL de vues."

msgid "Edit"
msgstr "Editer"

msgid "Garbage collection in the simple_sitemap_views table"
msgstr "Récupération de place dans la table simple_sitemap_views"

msgid "Views URL generator"
msgstr "Générateur d'URL de vues"

msgid "Generates URLs for views."
msgstr "Génère des URL pour les vues."

msgid "Index this display in sitemap <em>@variant_label</em>"
msgstr "Indexer cet affichage dans le plan du site <em>@variant_label</em>"

msgid "The priority this display will have in the eyes of search engine bots."
msgstr "Priorité de cet affichage pour les robots de moteur de recherche."

msgid "The frequency with which this display changes. Search engine bots may take this as an indication of how often to index it."
msgstr "Fréquence de modification de cet affichage. Les robots de moteur de recherche peuvent s'en servir comme indication de la fréquence d'indexation."

msgid "Maximum display variations"
msgstr "Nombre maximal de variantes d'affichage"

msgid "The maximum number of link variations to be indexed for this display. If left blank, each argument will create link variations for this display. Use with caution, as a large number of argument values​can significantly increase the number of sitemap links."
msgstr "Nombre maximal de variantes de lien à indexer pour cet affichage. S'il reste vide, chaque argument crée des variantes de lien pour cet affichage. Utilisez cet option avec précaution, car un grand nombre de valeurs d'argument​peut augmenter considérablement le nombre de liens du plan de site."

msgid "Simple XML Sitemap settings for this display"
msgstr "Paramètres de plan de site XML simple pour cet affichage"

msgid "Included in sitemaps: @variants"
msgstr "Inclus dans les plans de site : @variants"

msgid "Excluded from all sitemaps"
msgstr "Exclu de tous les plans de site"

msgid "To enable indexing of an argument, you must enable indexing of all previous arguments."
msgstr "Pour activer l'indexation d'un argument, vous devez activer l'indexation de tous les arguments précédents."

msgid "Simple XML Sitemap settings for this view."
msgstr "Paramètres de plan de site XML simple pour cette vue."

