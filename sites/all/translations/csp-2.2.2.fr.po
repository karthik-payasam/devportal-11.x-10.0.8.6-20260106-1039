msgid "Policies"
msgstr "Stratégies"

msgid "Report Only"
msgstr "Rapport uniquement"

msgid "Enforced"
msgstr "Appliqué"

msgid "Enable '@type'"
msgstr "Activer '@type'"

msgid "Additional Sources"
msgstr "Sources supplémentaires"

msgid "Additional domains or protocols to allow for this directive, separated by a space."
msgstr "Protocoles ou domaines supplémentaires à autoriser pour cette directive, séparés par un espace."

msgid "Instead of child-src, nested browsing contexts and workers should use the frame-src and worker-src directives, respectively."
msgstr "Au lieu de child-src, les agents et les contextes de navigation imbriqués doivent utiliser les directives frame-src et worker-src, respectivement."

msgid "Handler"
msgstr "Gestionnaire"

msgid "Reset @policyType policy to default values"
msgstr "Réinitialiser la stratégie @policyType avec les valeurs par défaut"

msgid "No policies are currently enabled."
msgstr "Aucune stratégie n'est activée actuellement."

msgid "%policy %directive has a hash source configured, which may block functionality that relies on inline code."
msgstr "La directive %directive de la règle %policy a une source de hachage configurée, ce qui peut bloquer les fonctionnalités qui reposent sur le code en ligne."

msgid "%policy %directive is enabled without a fallback directive for non-supporting browsers."
msgstr "La directive %directive de la règle %policy est activée sans une directive de rétromigration pour les navigateurs non compatibles."

msgid "<a href=\":docUrl\">Nonces must be a unique value for each request</a>, so cannot be set in configuration."
msgstr "<a href=\":docUrl\">La valeur des attributs nonce doit être unique pour chaque demande</a> : elle ne peut donc pas être définie dans la configuration."

msgid "Invalid domain or protocol provided."
msgstr "Domaine ou protocole fourni non valide."

msgid "Reporting Handler is required for enabled policies."
msgstr "Le gestionnaire de génération de rapports est requis pour les stratégies activées."

msgid "Reporting is disabled"
msgstr "La génération de rapports est désactivée"

msgid "Your <a href=\":url\">Report-URI.com subdomain</a>."
msgstr "Votre <a href=\":url\">sous-domaine Report-URI.com</a>."

msgid "Enable Wizard"
msgstr "Activer l'assistant"

msgid "Send reports to the <a href=\":url\">CSP Wizard</a> reporting address."
msgstr "Envoyez des rapports à l'adresse de génération de rapports de l'<a href=\":url\">assistant CSP</a>."

msgid "Reports will be sent to a ReportURI.com account."
msgstr "Les rapports seront envoyés à un compte ReportURI.com."

msgid "Reports will be added to the site log."
msgstr "Les rapports seront ajoutés au journal du site."

msgid "The URI to send reports to."
msgstr "URI auquel envoyer les rapports."

msgid "Reports will be sent to a URI."
msgstr "Les rapports seront envoyés à un URI."

