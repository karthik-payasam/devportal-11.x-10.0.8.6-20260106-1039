msgid "No Content Security Policy headers are currently enabled."
msgstr "Aucun en-tête du dispositif de sécurité CSP (Content Security Policy) n'est activé actuellement."

msgid "Enable a header via <a href=\":csp-settings\">the Content Security Policy settings</a>."
msgstr "Activez un en-tête via <a href=\":csp-settings\">les paramètres du dispositif de sécurité CSP (Content Security Policy)</a>."

msgid "Enabling Content Security Policy in Security Kit is likely to cause policy conflicts."
msgstr "L'activation de la stratégie CSP (Content Security Policy) dans le kit de sécurité est susceptible de provoquer des conflits de stratégie."

msgid "Disable the Content Security Policy settings in <a href=\":seckit-settings\">Security Kit configuration</a>."
msgstr "Désactivez les paramètres CSP (Content Security Policy) dans la <a href=\":seckit-settings\">configuration du kit de sécurité</a>."

msgid "Content Security Policy"
msgstr "Politique de sécurité du contenu (CSP)"

msgid "Provide Content-Security-Policy headers"
msgstr "Fournir des en-têtes Content-Security-Policy"

msgid "Configure policy enforcement."
msgstr "Configurez l'application de la stratégie."

msgid "Administer Content Security Policy"
msgstr "Administrer le dispositif de sécurité CSP"

msgid "Content Security Policy Settings"
msgstr "Paramètres du dispositif de sécurité CSP (Content Security Policy)"

msgid "Report-Only Policy"
msgstr "Stratégie de rapport uniquement"

msgid "Enforce Policy"
msgstr "Appliquer la stratégie"

