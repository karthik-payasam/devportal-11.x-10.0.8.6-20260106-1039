msgid "No Content Security Policy headers are currently enabled."
msgstr "Все заголовки стратегии защиты содержимого в данный момент выключены. "

msgid "Enable a header via <a href=\":csp-settings\">the Content Security Policy settings</a>."
msgstr "Включите заголовок с помощью <a href=\":csp-settings\">параметров стратегии защиты содержимого</a>."

msgid "Enabling Content Security Policy in Security Kit is likely to cause policy conflicts."
msgstr "Включение стратегии защиты содержимого в комплекте обеспечения безопасности может вызвать конфликты стратегии."

msgid "Disable the Content Security Policy settings in <a href=\":seckit-settings\">Security Kit configuration</a>."
msgstr "Выключите параметры стратегии защиты содержимого в <a href=\":seckit-settings\">конфигурации комплекта обеспечения безопасности</a>."

msgid "Content Security Policy"
msgstr "Стратегия защиты содержимого "

msgid "Provide Content-Security-Policy headers"
msgstr "Указать заголовки Content-Security-Policy"

msgid "Configure policy enforcement."
msgstr "Включите стратегию. "

msgid "Administer Content Security Policy"
msgstr "Администрирование стратегии защиты содержимого"

msgid "Content Security Policy Settings"
msgstr "Параметры стратегии защиты содержимого"

msgid "Report-Only Policy"
msgstr "Только создание отчетов"

msgid "Enforce Policy"
msgstr "Включить стратегию"

msgid "Policy"
msgstr "Политика"

msgid "Enable"
msgstr "Включить"

msgid "Directives"
msgstr "Директивы"

msgid "Reporting"
msgstr "Формирование отчетов"

msgid "The Reporting Handler Plugin ID"
msgstr "ИД модуля обработчика отчетов"

msgid "Reporting Plugin Options"
msgstr "Параметры модуля создания отчетов"

msgid "Base"
msgstr "База"

msgid "Flags"
msgstr "Флаги"

msgid "Sources"
msgstr "Источники"

msgid "None"
msgstr "Нет"

msgid "Site Log"
msgstr "Протокол сайта"

msgid "Report URI"
msgstr "URI отчета"

msgid "Subdomain"
msgstr "Поддомен"

msgid "Wizard"
msgstr "Мастер"

msgid "URI"
msgstr "URI"

msgid "Content Security Policy Extras"
msgstr "Дополнения к стратегии защиты содержимого"

msgid "Optional extra features for Content Security Policy"
msgstr "Дополнительные функции для стратегии защиты содержимого"

msgid ""
"@type <br/>\n"
"<pre>@data</pre>"
msgstr ""
"@type <br/>\n"
"<pre>@data</pre>"

msgid "Policies"
msgstr "Стратегии"

msgid "Report Only"
msgstr "Только отчеты"

msgid "Enforced"
msgstr "Включено"

msgid "Enable '@type'"
msgstr "Включить '@type'"

msgid "Additional Sources"
msgstr "Дополнительные источники"

msgid "Additional domains or protocols to allow for this directive, separated by a space."
msgstr "Дополнительные домены или протоколы, которые требуется разрешить для этой директивы, перечисленные через пробел."

msgid "Instead of child-src, nested browsing contexts and workers should use the frame-src and worker-src directives, respectively."
msgstr "Вместо child-src вложенные контексты просмотра и обработчики должны использовать соответственно директивы frame-src и worker-src."

msgid "Handler"
msgstr "Обработчик"

msgid "Reset @policyType policy to default values"
msgstr "Восстановить стандартные значения политики @policyType"

msgid "No policies are currently enabled."
msgstr "Никакие стратегии не включены."

msgid "%policy %directive has a hash source configured, which may block functionality that relies on inline code."
msgstr "Поскольку для %policy %directive указан источник хэша, функции на основе встроенного кода могут быть блокированы. "

msgid "%policy %directive is enabled without a fallback directive for non-supporting browsers."
msgstr "%policy %directive включена без резервной директивы для браузеров без соответствующей поддержки. "

msgid "<a href=\":docUrl\">Nonces must be a unique value for each request</a>, so cannot be set in configuration."
msgstr "<a href=\":docUrl\">Одноразовые строки должны иметь уникальное значение в каждом запросе</a> и не могут быть указаны в конфигурации. "

msgid "Invalid domain or protocol provided."
msgstr "Указан недопустимый домен или протокол."

msgid "Reporting Handler is required for enabled policies."
msgstr "Обработчик отчетов требуется для включенных стратегий."

msgid "Reporting is disabled"
msgstr "Функция создания отчетов выключена"

msgid "Your <a href=\":url\">Report-URI.com subdomain</a>."
msgstr "Ваш <a href=\":url\">субдомен URI-отчета.com</a>."

msgid "Enable Wizard"
msgstr "Мастер активации"

msgid "Send reports to the <a href=\":url\">CSP Wizard</a> reporting address."
msgstr "Отправить отчеты на адрес <a href=\":url\">мастера CSP</a>."

msgid "Reports will be sent to a ReportURI.com account."
msgstr "Отчеты будут отправляться в учетную запись ReportURI.com."

msgid "Reports will be added to the site log."
msgstr "Отчеты будут добавлены в протокол сайта. "

msgid "The URI to send reports to."
msgstr "Целевой URI для отправки отчетов. "

msgid "Reports will be sent to a URI."
msgstr "Отчеты будут отправляться с помощью URI."

