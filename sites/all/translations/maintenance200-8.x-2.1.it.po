msgid ""
"\n"
"        <h2>Maintenance200 module.</h2>\n"
"        <h3>Instructions</h3>\n"
"        <p>Install the module as normal and enable in <strong>/admin/modules</strong>.</p>\n"
"        <p>On the module configuration form you will find a switch to turn on or off the rewriting of the HTTP code returned when the site is in maintenance mode, as well as a field where you\n"
"        can input the numeric HTTP which the site should return.</p>\n"
"      "
msgstr ""
"\n"
"        <h2>Modulo Maintenance200.</h2>\n"
"        <h3>Istruzioni</h3>        <p>Installare il modulo come di consueto e abilitarlo in <strong>/admin/modules</strong>.</p>\n"
"        <p>Nello schema di configurazione del modulo, è presente un selettore per attivare o disattivare la riscrittura del codice HTTP restituito quando il sito è in modalità di manutenzione, in aggiunta a un campo nel quale è possibile immettere l'HTTP numerico che il sito deve restituire.</p>\n"
"      "

msgid "Maintenance 200"
msgstr "Maintenance 200"

msgid "Allows the maintenance page to return a configurable HTTP status code rather than the standard 503 code."
msgstr "Consente alla pagina di manutenzione di restituire un codice di stato HTTP configurabile piuttosto che il codice 503 standard."

msgid "Configure maintenance200"
msgstr "Configura maintenance200"

msgid "Maintenance200 Settings"
msgstr "Impostazioni di Maintenance200"

msgid "Maintenance 200 settings"
msgstr "Impostazioni di Maintenance 200"

msgid "Enable custom status code during maintenance mode"
msgstr "Abilitare il codice di stato personalizzato durante la modalità di manutenzione"

msgid "Status code to return during maintenance mode"
msgstr "Codice di stato da restituire durante la modalità di manutenzione"

msgid "Change the status code during maintenance mode"
msgstr "Modificare il codice di stato durante la modalità di manutenzione"

msgid "Status code to use"
msgstr "Codice di stato da utilizzare"

msgid "A valid HTTP status code is required. See the Wikipedia <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">HTTP status codes</a> page for a complete list."
msgstr "È richiesto un codice di stato HTTP valido. Consultare la pagina sui <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">Codici di stato HTTP</a> di Wikipedia per un elenco completo."

msgid "A valid HTTP status code is required."
msgstr "È richiesto un codice di stato HTTP valido."

msgid "You must provide an HTTP status code."
msgstr "È necessario fornire un codice di stato HTTP."

