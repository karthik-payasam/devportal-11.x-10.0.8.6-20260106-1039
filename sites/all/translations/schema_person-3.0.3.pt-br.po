msgid "Schema.org: Person"
msgstr "Schema.org: pessoa"

msgid "An additional name for a Person, can be used for a middle name."
msgstr "Um nome adicional para uma pessoa, pode ser usado para um segundo nome."

msgid "Physical address of the person."
msgstr "Endereço físico da pessoa."

msgid "An organization that this person is affiliated with. For example, a school/university, a club, or a team."
msgstr "Uma organização da qual essa pessoa é afiliada. Por exemplo, uma escola/universidade, um clube ou uma equipe."

msgid "An alias for the person."
msgstr "Um alias para a pessoa."

msgid "birthDate"
msgstr "birthDate"

msgid "Date of birth of the person in ISO 8601 format, 2017-12-31."
msgstr "Data de nascimento da pessoa no formato da ISO 8601, 2017-12-31."

msgid "The brand of the person."
msgstr "A marca da pessoa."

msgid "A description of the person."
msgstr "Uma descrição da pessoa."

msgid "The email address of the person."
msgstr "O endereço de e-mail da pessoa."

msgid "familyName"
msgstr "familyName"

msgid "Family name. In the U.S., the last name of an Person. This can be used along with givenName instead of the name property."
msgstr "Sobrenome. Nos EUA, o sobrenome de uma Pessoa. Isso pode ser usado junto com givenName, em vez da propriedade do nome."

msgid "Gender of the person."
msgstr "Sexo da pessoa."

msgid "givenName"
msgstr "givenName"

msgid "Given name. In the U.S., the first name of a Person. This can be used along with familyName instead of the name property."
msgstr "Nome. Nos EUA, o nome de uma Pessoa. Isso pode ser usado junto com familyName, em vez da propriedade do nome."

msgid "Globally unique id of the person, usually a url."
msgstr "ID globalmente exclusivo da pessoa, geralmente uma URL."

msgid "The primary image for the person."
msgstr "A imagem primária da pessoa."

msgid "jobTitle"
msgstr "jobTitle"

msgid "The job title of the person (for example, Financial Manager)."
msgstr "O título da tarefa da pessoa (por exemplo, gerente financeiro)."

msgid "memberOf"
msgstr "memberOf"

msgid "An Organization (or ProgramMembership) to which this Person belongs."
msgstr "Uma organização (ou ProgramMembership) a qual esta pessoa pertence."

msgid "REQUIRED BY GOOGLE. The name of the person."
msgstr "REQUERIDO POR GOOGLE. O nome da pessoa."

msgid "REQUIRED BY GOOGLE. A single or an [array] of URLs for the person's official social media profile page(s)."
msgstr "REQUERIDO POR GOOGLE. Uma URL ou uma [matriz] de URLs para as páginas oficiais de perfil de mídia social da pessoa."

msgid "The telephone number of the person."
msgstr "O número de telefone da pessoa."

msgid "REQUIRED. The type of person (fixed by standard)."
msgstr "REQUIRED. O tipo de pessoa (fixo por padrão)."

msgid "REQUIRED BY GOOGLE. The URL for the person's official website."
msgstr "REQUERIDO POR GOOGLE. A URL para o website oficial da pessoa."

msgid "worksFor"
msgstr "worksFor"

msgid "Organizations that the person works for."
msgstr "Organizações para as quais a pessoa trabalha."

