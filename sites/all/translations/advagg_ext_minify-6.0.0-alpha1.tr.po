msgid "Advagg External Minification: PHP shell_exec"
msgstr "Advagg Dış Küçültme: PHP shell_exec"

msgid "PHP shell_exec is non-functional."
msgstr "PHP shell_exec işlevsel değildir."

msgid "Check php.ini for safemode or <a href=\"@link\" target=\"_blank\">disable_functions</a>."
msgstr "Güvenli kip ya da <a href=\"@link\" target=\"_blank\">disable_functions</a> için php.ini dosyasını denetleyin."

msgid "Enabled"
msgstr "Etkinleştirildi"

msgid "AdvAgg External Minification"
msgstr "AdvAgg Dış Küçültme"

msgid "Minify Javascript and/or CSS with a command line minifier."
msgstr "Javascript ve/veya CSS'yi bir komut satırı küçültücü ile küçültün."

msgid "Advanced CSS/JS Aggregation"
msgstr "Gelişmiş CSS/JS Toplaması"

msgid "External Minification"
msgstr "Dış Küçültme"

msgid "AdvAgg external minification settings."
msgstr "AdvAgg dış küçültme ayarları"

msgid "AdvAgg: External Minifiers"
msgstr "AdvAgg: Dış Küçültücüler"

msgid "Settings"
msgstr "Ayarlar"

msgid "Command line for external CSS minification."
msgstr "Dış CSS küçültme için komut satırı."

msgid "Whether to use the external CSS minifier if configured."
msgstr "Yapılandırıldıysa, dış CSS küçültücünün kullanılıp kullanılmayacağı."

msgid "Command line for external JavaScript minification."
msgstr "Dış JavaScript küçültme için komut satırı."

msgid "Whether to use the external JS minifier if configured."
msgstr "Yapılandırıldıysa, dış JS küçültücünün kullanılıp kullanılmayacağı."

msgid "CSS"
msgstr "CSS"

msgid "JavaScript"
msgstr "JavaScript"

msgid "Command Line"
msgstr "Komut Satırı"

msgid "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = input file. <br /> {%IN_URL_ENC%} = url pointing to the input file that has been url encoded. <br /> {%OUT%} = output file. <br /><br />"
msgstr "{%CWD%} = \\Drupal::root (). <br /> {%IN%} = giriş dosyası. <br /> {%IN_URL_ENC%} = url kodlu giriş dosyasını gösteren url. <br /> {%OUT%} = çıkış dosyası.<br /><br />"

msgid "Example using the <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"
msgstr "<a href=\"@link1\">Microsoft Ajax Minifier</a> özelliğinin kullanımı örneği. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "<a href=\"@link1\">Google Closure Compiler</a> özelliğini kullanım örneği. <p><code>@code1</code></p>"

msgid "Example using curl to minify via the <a href=\"@link1\">Online Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "<a href=\"@link1\">Çevrimiçi Google Closure Compiler</a> aracılığıyla küçültmek için curl kullanımı örneği. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">YUI Compressor</a>. <p><code>@code1</code></p>"
msgstr "<a href=\"@link1\">YUI Compressor</a> kullanma örneği. <p><code>@code1</code></p>"

msgid "Example using curl to minify via an online <a href=\"@link1\">CSS Minifier</a>. <p><code>@code1</code></p>"
msgstr "Çevrimiçi <a href=\"@link1\">CSS Minifier</a> aracılığıyla küçültmek için curl kullanımı örneği. <p><code>@code1</code></p>"

msgid "Command to run"
msgstr "Çalıştırılacak komut"

msgid "Enable external @type minification"
msgstr "Dış @type küçültmesini etkinleştir"

