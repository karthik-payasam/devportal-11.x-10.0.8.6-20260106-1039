msgid "Font Awesome IconPicker"
msgstr "Font Awesome IconPicker"

msgid "The fontIconPicker library is installed."
msgstr "fontIconPicker kitaplığı kuruldu."

msgid "Not installed"
msgstr "Kurulu değil"

msgid "The fontIconPicker library could not be found. To use the Font Awesome Iconpicker, please verify that the fontIconPicker library is installed correctly. Please see the Font Awesome Iconpicker submodule README file for more details."
msgstr "fontIconPicker kitaplığı bulunamadı. Font Awesome Iconpicker'ı kullanmak için lütfen fontIconPicker kitaplığının doğru şekilde kurulduğunu doğrulayın. Daha fazla ayrıntı için lütfen Font Awesome Iconpicker alt modülü README dosyasına bakın."

msgid "Font Awesome Iconpicker Widget"
msgstr "Font Awesome Iconpicker Pencere Bileşeni"

msgid "Provides an iconpicker widget for Font Awesome"
msgstr "Font Awesome için bir iconpicker pencere bileşeni sağlar"

msgid "IconPicker already present at @path. No download required."
msgstr "IconPicker şu adreste zaten var: @path. Karşıdan yükleme gerekmiyor."

msgid "Drush was unable to download the fontIconPicker library from @remote."
msgstr "Drush, fontIconPicker kitaplığını @remote konumundan yükleyemedi."

msgid "Error: unable to download fontIconPicker library from @remote"
msgstr "Hata: fontIconPicker kitaplığı @remote konumundan yüklenemiyor"

msgid "fontIconPicker library has been successfully downloaded to @path."
msgstr "fontIconPicker kitaplığı @path konumuna başarıyla yüklendi."

msgid "Drush was unable to load the fontIconPicker) library"
msgstr "Drush, fontIconPicker) kitaplığını yükleyemedi"

msgid "Icon Name"
msgstr "Simge Adı"

msgid "Invalid icon"
msgstr "Geçersiz simge"

