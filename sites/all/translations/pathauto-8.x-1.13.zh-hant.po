msgstr "已更新 %label @id 的別名。"

msgid "Updated 1 %label URL alias."
msgid_plural "Updated @count %label URL aliases."
msgstr[0] "已更新 @count 個 %label URL 別名。"

msgid "Forum"
msgstr "討論區"

