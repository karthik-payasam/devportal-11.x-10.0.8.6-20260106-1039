msgid "Password Characters of Type Policy"
msgstr "Richtlinie für Kennwortzeichenarten"

msgid "Minimum characters of a particular type the password must contain."
msgstr "Minimale Anzahl an Zeichen eines bestimmten Typs, die das Kennwort enthalten muss."

msgid "Security"
msgstr "Sicherheit"

msgid "Number of characters"
msgstr "Anzahl Zeichen"

msgid "Character type"
msgstr "Zeichenart"

msgid "Uppercase"
msgstr "Großschreibung"

msgid "Lowercase"
msgstr "Kleinschreibung"

msgid "Letter"
msgstr "Buchstabe"

msgid "Numeric"
msgstr "Numerisch"

msgid "Special Character"
msgstr "Sonderzeichen"

msgid "The number of characters must be a positive number."
msgstr "Die Anzahl an Zeichen muss eine positive Zahl sein."

msgid "Password must contain at least 1 uppercase character."
msgid_plural "Password must contain at least @count unique uppercase characters."
msgstr[0] "Kennwort muss mindestens 1 Großbuchstaben enthalten."
msgstr[1] "Kennwort must mindestens @count eindeutige Großbuchstaben enthalten."

msgid "Password must contain at least 1 lowercase character."
msgid_plural "Password must contain at least @count unique lowercase characters."
msgstr[0] "Kennwort muss mindestens 1 Kleinbuchstaben enthalten."
msgstr[1] "Kennwort muss mindestens @count eindeutige Kleinbuchstaben enthalen."

msgid "Password must contain at least 1 letter character."
msgid_plural "Password must contain at least @count unique letter characters."
msgstr[0] "Kennwort muss mindestens 1 Buchstaben enthalten."
msgstr[1] "Kennwort muss mindestens @count eindeutige Buchstaben enthalten."

msgid "Password must contain at least 1 special character."
msgid_plural "Password must contain at least @count unique special characters."
msgstr[0] "Kennwort muss mindestens 1 Sonderzeichen enthalten."
msgstr[1] "Kennwort muss mindestens @count eindeutige Sonderzeichen enthalten."

msgid "Password must contain at least 1 numeric character."
msgid_plural "Password must contain at least @count unique numeric characters."
msgstr[0] "Kennwort muss mindestens 1 numerisches Zeichen enthalten."
msgstr[1] "Kennwort muss mindestens @count eindeutige numerische Zeichen enthalten."

msgid "Password character type"
msgstr "Kennwortzeichenart"

msgid "Verifying that a password has a specific number of characters"
msgstr "Überprüfen, ob ein Kennwort eine bestimmte Anzahl an Zeichen enthält"

msgid "The password does not contain a the correct number of certain characters."
msgstr "Das Kennwort enthält nicht die richtige Anzahl an bestimmten Zeichen."

