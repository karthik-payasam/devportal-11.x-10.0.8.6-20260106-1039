msgid "IndexNow notification"
msgstr "Notification IndexNow"

msgid "IndexNow notification checkbox"
msgstr "Case à cocher de notification IndexNow"

msgid "Simple XML Sitemap IndexNow"
msgstr "Plan de site XML simple IndexNow"

msgid "Verification key in Drupal State"
msgstr "Clé de vérification dans l'état Drupal"

msgid "Verification key not available"
msgstr "Clé de vérification non disponible"

msgid "In order to generate a verification key for the IndexNow service and choose which sitemaps are to be submitted to search engines, visit <a href=\"@url\">this</a> configuration page."
msgstr "Pour générer une clé de vérification pour le service IndexNow et choisir les plans de site à soumettre aux moteurs de recherche, visitez <a href=\"@url\">cette</a> page de configuration."

msgid "Simple XML Sitemap (Search engines)"
msgstr "Plan de site XML simple (moteurs de recherche)"

msgid "Submits sitemaps to search engines and notifies IndexNow compatible engines about changes to entities."
msgstr "Soumet des plans de site aux moteurs de recherche et informe les moteurs compatibles avec IndexNow des modifications apportées aux entités."

msgid "SEO"
msgstr "optimisation pour les moteurs de recherche"

msgid "Search engines"
msgstr "Moteurs de recherche"

msgid "Status"
msgstr "Statut"

msgid "Settings"
msgstr "Paramètres"

msgid "Index entity on save"
msgstr "Indexer l'entité lors de la sauvegarde"

msgid "Allows optionally sending a change notice to IndexNow compatible search engines on entity form save."
msgstr "Autorise l'envoi facultatif d'un avis de modification aux moteurs de recherche compatibles avec IndexNow lors de la sauvegarde du formulaire d'entité."

msgid "Simple XML Sitemap"
msgstr "Plan de site XML simple"

msgid "Search engine"
msgstr "Moteur de recherche"

msgid "Search engine ID"
msgstr "ID de moteur de recherche"

msgid "Label"
msgstr "Libellé"

msgid "Submission URL"
msgstr "URL d'envoi"

msgid "IndexNow URL"
msgstr "URL IndexNow"

msgid "Sitemap variants"
msgstr "Variantes du plan de site"

msgid "Sitemap variant"
msgstr "Variante du plan de site"

msgid "IndexNow bundle settings"
msgstr "Paramètres de regroupement IndexNow"

msgid "IndexNow"
msgstr "IndexNow"

msgid "Sitemap search engine submission settings"
msgstr "Paramètres d'envoi du moteur de recherche du plan du site"

msgid "Sitemap submission enabled"
msgstr "Envoi du plan du site activé"

msgid "Sitemap submission frequency"
msgstr "Fréquence d'envoi du plan du site"

msgid "IndexNow submission enabled"
msgstr "Soumission IndexNow activée"

msgid "Selected engine for IndexNow submissions"
msgstr "Moteur sélectionné pour les soumissions IndexNow"

msgid "IndexNow on entity save"
msgstr "IndexNow lors de la sauvegarde de l'entité"

msgid "Sitemap submission status"
msgstr "Statut de la soumission du plan de site"

msgid "Name"
msgstr "Nom"

msgid "Sitemaps"
msgstr "Plans du site"

msgid "Last submitted"
msgstr "Dernier envoi"

msgid "There are no @label yet."
msgstr "Il n'y a pas encore de @label."

msgid "Submission settings can be configured <a href=\"@url\">here</a>."
msgstr "Les paramètres de soumission peuvent être configurés <a href=\"@url\">ici</a>."

msgid "Never"
msgstr "Jamais"

msgid "No search engines supporting sitemap submission have been found."
msgstr "Aucun moteur de recherche prenant en charge la soumission de plan de site n'a été trouvé."

msgid "Sitemap submission is disabled."
msgstr "La soumission de plan de site est désactivée."

msgid "IndexNow status"
msgstr "Statut d'IndexNow"

msgid "The last IndexNow submission was <em>@entity</em> to @engine_label on @time"
msgstr "La dernière soumission IndexNow était <em>@entity</em> à @engine_label à @time"

msgid "IndexNow settings can be configured <a href=\"@url\">here</a>."
msgstr "Les paramètres IndexNow peuvent être configurés <a href=\"@url\">ici</a>."

msgid "No search engines supporting IndexNow have been found."
msgstr "Aucun moteur de recherche prenant en charge IndexNow n'a été trouvé."

msgid "IndexNow submission is disabled."
msgstr "La soumission IndexNow est désactivée."

msgid "Excluded"
msgstr "Exclu"

msgid "Sitemap submission settings"
msgstr "Paramètres de soumission de plans de site"

msgid "Submit sitemaps to search engines"
msgstr "Soumettre des plans de site aux moteurs de recherche"

msgid "This enables/disables sitemap submission; don't forget to choose sitemaps below."
msgstr "Active/désactive la soumission des plans de site ; n'oubliez pas de choisir les plans de site ci-dessous."

msgid "Submission interval"
msgstr "Intervalle d'envoi"

msgid "Engines"
msgstr "Moteurs"

msgid "Choose which sitemaps are to be submitted to which search engines.<br>Sitemaps can be configured <a href=\"@url\">here</a>."
msgstr "Choisissez quels plans de site soumettre à quels moteurs de recherche.<br>Les plans de site peuvent être configurés <a href=\"@url\">ici</a>."

msgid "IndexNow settings"
msgstr "Paramètres d'IndexNow"

msgid "Submit changes to IndexNow capable engines"
msgstr "Soumettre les modifications aux moteurs compatibles avec IndexNow"

msgid "Send change notice to IndexNow compatible search engines right after submitting entity forms. Changes include creating, deleting and updating of an entity.<br/>This behaviour can be overridden on entity forms. Don't forget to <a href=\"@inclusion_url\">include entities</a>."
msgstr "Envoyer un avis de modification aux moteurs de recherche compatibles avec IndexNow juste après avoir soumis les formulaires d'entité. Les modifications incluent la création, la suppression et la mise à jour d'une entité.<br/>Ce comportement peut être remplacé sur les formulaires d'entité. N'oubliez pas d'<a href=\"@inclusion_url\">inclure des entités</a>."

msgid "Preferred IndexNow engine"
msgstr "Moteur IndexNow préféré"

msgid "All IndexNow requests will be sent to the engine selected here. Only one engine needs to be notified, as it will notify other IndexNow compatible engines for you.<br/>For the sake of equality of opportunity, <strong>consider leaving this at <em>Random</em></strong>, so a random engine can be picked on each submission."
msgstr "Toutes les demandes IndexNow seront envoyées au moteur sélectionné ici. Il suffit d'informer un seul moteur, car il informera les autres moteurs compatibles avec IndexNow pour vous.<br/>Pour des raisons d'égalité des chances, <strong>vous pouvez laisser cette zone sur <em>Aléatoire</em></strong> afin qu'un moteur aléatoire soit sélectionné à chaque soumission."

msgid "Random"
msgstr "Aléatoire"

msgid "Index on every entity save operation"
msgstr "Indexation à chaque opération de sauvegarde d'entité"

msgid "If checked, all entity save operations for <a href=\"@inclusion_url\">included entities</a> will trigger notification of IndexNow search engines.<br/>If unchecked, this will only be possible by adding/altering/deleting an entity through a form.<br/>This should be unchecked if there are mass operations performed on entities that are irrelevant to indexing."
msgstr "Si cette case est cochée, toutes les opérations de sauvegarde d'entité pour les <a href=\"@inclusion_url\">entités incluses</a> déclencheront une notification aux moteurs de recherche IndexNow.<br/>Si elle n'est pas cochée, cela ne sera possible qu'en ajoutant/modifiant/supprimant une entité via un formulaire.<br/>Cette case doit être décochée si des opérations de masse sont effectuées sur les entités qui ne concernent pas l'indexation."

msgid "Remove verification key from state"
msgstr "Supprimer la clé de vérification de l'état"

msgid "Generate verification key"
msgstr "Générer une clé de vérification"

msgid "The IndexNow verification key is saved in <em>settings.php</em>: @key"
msgstr "La clé de vérification IndexNow est sauvegardée dans <em>settings.php</em> : @key"

msgid "The IndexNow verification key is defined in <em>Drupal state</em>: @key"
msgstr "La clé de vérification IndexNow est définie dans l'état <em>Drupal</em> : @key"

msgid "The IndexNow verification key is saved in <em>Drupal state</em>. Consider defining it in <em>settings.php</em> like so:<br/>@code"
msgstr "La clé de vérification IndexNow est sauvegardée dans l'état <em>Drupal</em>. Envisagez de la définir dans <em>settings.php</em> ainsi : <br/>@code"

msgid "The IndexNow verification key is saved in <em>settings.php</em> and can be safely removed from <em>Drupal state</em>."
msgstr "La clé de vérification IndexNow est sauvegardée dans <em>settings.php</em> et peut être retirée sans risque de l'état <em>Drupal</em>."

msgid "An IndexNow verification key needs to be generated and optionally added to <em>settings.php</em> in order for IndexNow engines to get notified about changes. This warning only applies to the production environment."
msgstr "Une clé de vérification IndexNow doit être générée et éventuellement ajoutée à <em>settings.php</em> pour que les moteurs IndexNow soient informés des modifications. Cet avertissement ne s'applique qu'à l'environnement de production."

msgid "No sitemaps have been selected for submission."
msgstr "Aucun plan de site n'a été sélectionné pour la soumission."

msgid "Notify IndexNow search engines of changes <em>now</em>"
msgstr "Informer les moteurs de recherche IndexNow des modifications <em>maintenant</em>"

msgid "Send change notice to IndexNow compatible search engines right after submitting this form."
msgstr "Envoyer un avis de modification aux moteurs de recherche compatibles avec IndexNow juste après la soumission de ce formulaire."

msgid "Notify IndexNow search engines of changes <em>by default</em>"
msgstr "Informer les moteurs de recherche IndexNow des modifications <em>par défaut</em>"

msgid "Send change notice to IndexNow compatible search engines right after submitting entity forms of this type.<br/>Changes include creating, deleting and updating of an entity. This setting can be overridden on the entity form."
msgstr "Envoyer un avis de modification aux moteurs de recherche compatibles avec IndexNow juste après la soumission de formulaires d'entité de ce type.<br/>Les modifications incluent la création, la suppression et la mise à jour d'une entité. Ce paramètre peut être remplacé sur le formulaire d'entité."

msgid "Sitemap search engine submission"
msgstr "Envoi du moteur de recherche du plan du site"

