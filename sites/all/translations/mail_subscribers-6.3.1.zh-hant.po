msgstr "收件者名稱"

msgid "Recipient's e-mail"
msgstr "收件者電子郵件"

msgid "E-mail subject"
msgstr "電子郵件主旨"

msgid "E-mail body"
msgstr "電子郵件內文"

msgid "E-mail headers (serialized)"
msgstr "電子郵件標頭（序列化）"

