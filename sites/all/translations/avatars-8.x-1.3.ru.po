msgid "Site default"
msgstr "По умолчанию для сайта"

msgid "User picture"
msgstr "Аватар пользователя"

msgid "An image representing your user account. Do not upload your avatars to this field."
msgstr "Изображение, представляющее учетную запись пользователя. В это поле не следует добавлять аватары. "

msgid "User picture upload"
msgstr "Передача изображения пользователя"

msgid "An image representing your user account."
msgstr "Изображение, представляющее учетную запись пользователя."

msgid "Avatar Kit"
msgstr "Комплект аватаров"

msgid "Provides a selection of generated avatars for users."
msgstr "Позволяет выбрать созданные аватары для пользователей. "

msgid "Avatars"
msgstr "Аватары"

msgid "Add avatar generator"
msgstr "Добавить генератор аватаров"

msgid "Avatar settings"
msgstr "Настройки аватар"

msgid "Manage avatar generator settings."
msgstr "Управление параметрами генератора аватаров. "

msgid "Administer Avatar Kit"
msgstr "Администрирование комплекта аватаров"

msgid "Manage settings for Avatar Kit."
msgstr "Управление параметрами комплекта аватаров. "

msgid "Avatar Kit settings"
msgstr "Параметры комплекта аватаров"

msgid "Edit avatar generator"
msgstr "Изменить генератор аватаров"

msgid "Delete avatar generator"
msgstr "Удалить генератор аватаров"

msgid "Adorable"
msgstr "Adorable"

msgid "Adds an Adorable.io avatar generator for Avatar Kit."
msgstr "Добавляет генератор аватаров Adorable.io для комплекта аватаров. "

msgid "Adorable avatars by adorable.io"
msgstr "Аватары Adorable, разработанные компанией adorable.io"

msgid "Gravatar"
msgstr "Gravatar"

msgid "Adds Gravatar.com avatar generators for Avatar Kit."
msgstr "Добавляет генератор аватаров Gravatar.com для комплекта аватаров."

msgid "Maximum content rating"
msgstr "Максимальный рейтинг содержимого"

msgid "Gravatar generator"
msgstr "Генератор Gravatar"

msgid "Type"
msgstr "Тип"

msgid "Unrestricted"
msgstr "Без ограничений"

msgid "G: suitable for display on all websites with any audience type."
msgstr "G: подходит для отображения на всех веб-сайтах с любым типом аудитории. "

msgid "PG: may contain rude gestures, provocatively dressed individuals, the lesser swear words, or mild violence."
msgstr "PG: может содержать грубые жесты, провокационно одетых людей, ругательства или умеренное насилие. "

msgid "R: may contain such things as harsh profanity, intense violence, nudity, or hard drug use."
msgstr "R: может содержать такие вещи, как нецензурную лексику, открытое насилие, обнаженных людей и употребление тяжелых наркотиков. "

msgid "X: may contain hardcore sexual imagery or extremely disturbing violence."
msgstr "X: может содержать порнографические изображения и сцены проявления крайней жестокости. "

msgid "Maximum rating: @maximum_rating"
msgstr "Максимальный рейтинг: @maximum_rating"

msgid "Universal avatar uploaded to Gravatar.com"
msgstr "Универсальный аватар передан на сайт Gravatar.com"

msgid "Identicon"
msgstr "Identicon"

msgid "Monster ID"
msgstr "Monster ID"

msgid "Wavatar"
msgstr "Wavatar"

msgid "8-bit style avatar"
msgstr "8-битный аватар"

msgid "Missing Configuration"
msgstr "Отсутствует конфигурация"

msgid "Type: @type"
msgstr "Тип: @type"

msgid "Identicon, MonsterID, Retro, and Wavatar avatar generators."
msgstr "Генераторы аватаров Identicon, MonsterID, Retro и Wavatar. "

msgid "Robohash"
msgstr "Robohash"

msgid "Adds Robohash avatar generators for Avatar Kit."
msgstr "Добавляет генераторы аватаров Robohash для комплекта аватаров."

msgid "Background"
msgstr "Фон"

msgid "Robots"
msgstr "Robots"

msgid "Robot Heads"
msgstr "Robot Heads"

msgid "Monsters"
msgstr "Monsters"

msgid "Transparent"
msgstr "Прозрачный"

msgid "Places"
msgstr "Места"

msgid "Patterns"
msgstr "Шаблоны"

msgid "Type: @type | Background: @background"
msgstr "Тип: @type | фон: @background"

msgid "Robots and monsters from Robohash.org"
msgstr "Роботы и монстры с сайта Robohash.org"

msgid "Avatar generator settings"
msgstr "Параметры генератора аватаров"

msgid "How long should dynamic avatars be cached before allowing refresh."
msgstr "Срок хранения динамических аватаров в кэше перед обновлением. "

msgid "How long should non-preferred static avatars be cached. Leave empty to never delete. Preferred static avatars never expire."
msgstr "Срок хранения непредпочитаемых статических аватаров. Оставьте пустым, чтобы никогда не удалять. Срок хранения предпочитаемых статических аватаров неограничен. "

msgid "Avatar Generator"
msgstr "Генератор аватаров"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "Метка"

msgid "Weight"
msgstr "Вес"

msgid "Plugin"
msgstr "Плагин"

msgid "Provider"
msgstr "Поставщик"

msgid "Avatar generator preview settings"
msgstr "Параметры предварительного просмотра генератора аватаров"

msgid "Preview image style"
msgstr "Стиль изображения при предпросмотре"

msgid "Failed to get @id avatar for @generator: %exception"
msgstr "Не удалось получить аватар @id для @generator: %exception"

msgid "Use %label"
msgstr "Использовать %label"

msgid "User can select %label avatar generator."
msgstr "Пользователь может выбрать генератор аватаров %label. "

msgid "Preview ID"
msgstr "ИД предварительного просмотра"

msgid "The preview ID."
msgstr "ИД предварительного просмотра."

msgid "Avatar generator"
msgstr "Генератор аватаров"

msgid "The avatar generator for the associated avatar."
msgstr "Генератор аватаров для связанного аватара."

msgid "The user who owns this avatar."
msgstr "Пользователь, которому принадлежит этот аватар. "

msgid "Reference to a file entity containing an avatar."
msgstr "Ссылка на файл, содержащий аватар. "

msgid "Date of creation"
msgstr "Дата создания"

msgid "The date the avatar preview was created."
msgstr "Дата создания предварительного просмотра аватара. "

msgid "Preference scope"
msgstr "Область действия параметра"

msgid "Which preference caused this avatar to be generated."
msgstr "Каким образом был создан этот аватар. "

msgid "Avatar preview"
msgstr "Предварительный просмотр аватара"

msgid "Are you sure you want to delete avatar generator %label?"
msgstr "Вы действительно хотите удалить генератор аватаров %label?"

msgid "Delete"
msgstr "Удалить"

msgid "Avatar generator %label was deleted."
msgstr "Генератор аватаров %label удален. "

msgid "Edit avatar generator %label"
msgstr "Изменить генератор аватаров %label"

msgid "Machine name"
msgstr "Машинное имя"

msgid "<strong>@label</strong><br />@description"
msgstr "<strong>@label</strong><br />@description"

msgid "Created avatar generator %label"
msgstr "Создан генератор аватаров %label"

msgid "Updated avatar generator %label"
msgstr "Обновлен генератор аватаров %label"

msgid "Settings"
msgstr "Настройки"

msgid "Enabled"
msgstr "Включено"

msgid "Operations"
msgstr "Операции"

msgid "A list of avatar generators to try for each user in order of preference."
msgstr "Список генераторов аватаров, применяемых для каждого пользователя в порядке предпочтения. "

msgid "No avatar generators found."
msgstr "Генераторы аватаров не найдены. "

msgid "Dynamic"
msgstr "Динамический"

msgid "Static"
msgstr "Статическая"

msgid "Edit"
msgstr "Редактировать"

msgid "Dynamic lifetime"
msgstr "Динамическое время жизни"

msgid "How long dynamic avatars are cached before allowing refresh."
msgstr "Срок хранения динамических аватаров в кэше перед обновлением. "

msgid "seconds"
msgstr "секунд"

msgid "Static lifetime"
msgstr "Статическое время жизни"

msgid "How long static avatars are cached. Only applies to avatars which are not the users preference."
msgstr "Срок хранения статических аватаров в кэше. Применимо только к аватарам, которые не являются предпочитаемыми. "

msgid "Never delete"
msgstr "Не удалять"

msgid "Delete after"
msgstr "После удаления"

msgid "Settings saved."
msgstr "Настройки сохранены."

msgid "Broken/Missing"
msgstr "Повреждён/Отсутствует"

msgid "User upload"
msgstr "Передано пользователем"

msgid "Image uploaded by the user to the site."
msgstr "Изображение, переданное пользователем на сайт. "

msgid "User preference"
msgstr "Выбор пользователя"

msgid "Avatar generator calculated based on user preference."
msgstr "Генератор аватаров определяется с учетом предпочтений пользователя. "

msgid "Original"
msgstr "Оригинал"

msgid "A preview of the avatar will be shown in this size."
msgstr "Размер области предварительного просмотра аватара. "

msgid "Preview image style: @style"
msgstr "Предварительный просмотр стиля изображения: @style"

msgid "Let the site determine which avatar to use."
msgstr "Разрешить сайту выбирать аватар. "

msgid "Avatar Generator Previews"
msgstr "Предварительный просмотр генератора аватаров"

