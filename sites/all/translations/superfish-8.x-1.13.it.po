msgid "None"
msgstr "Nessuna"

msgid "Vertical"
msgstr "Verticale"

msgid "Horizontal"
msgstr "Orizzontale"

msgid "Diagonal"
msgstr "Diagonale"

msgid "About Superfish"
msgstr "Informazioni su Superfish"

msgid "<a href=\"@url_module\">Superfish module</a> integrates <a href=\"@url_library\">jQuery Superfish</a> plugin to your Drupal menu blocks. Please refer to the module <a href=\"@url_documentation\">documentation</a> for more information."
msgstr "Il <a href=\"@url_module\">modulo Superfish</a> integra il plugin <a href=\"@url_library\">jQuery Superfish</a> con i blocchi di menu Drupal. Fare riferimento alla <a href=\"@url_documentation\">documentazione</a> del modulo per ulteriori informazioni."

msgid "In order to use Superfish, go to the <a href=\"@block\">Block layout</a> page and use any of the \"Place block\" buttons to create a Superfish block."
msgstr "Per utilizzare Superfish, andare alla pagina <a href=\"@block\">Layout blocco</a> e utilizzare uno dei pulsanti \"Posiziona blocco\" per creare un blocco Superfish."

msgid "Superfish library is missing. Please refer to the <a href=\"@documentation\">plugin documentation</a> for how you can fix this issue; Once done, go to the <a href=\"@block\">Block layout</a> page and use any of the \"Place block\" buttons to create a Superfish block."
msgstr "Libreria Superfish non presente. Fare riferimento alla <a href=\"@documentation\">documentazione del plugin</a> per informazioni su come risolvere questo problema; al termine, andare alla pagina <a href=\"@block\">Layout blocco</a> e utilizzare uno dei pulsanti \"Posiziona blocco\" per creare un blocco Superfish."

msgid "If there was no Superfish block in the \"Place block\" form, go to the <a href=\"@performance\">Performance</a> page and clear the cache once."
msgstr "Se non era presente alcun blocco Superfish nel modulo \"Posiziona blocco\", andare alla pagina <a href=\"@performance\">Prestazioni</a> e cancellare la cache una volta."

msgid "Superfish library"
msgstr "Libreria Superfish"

msgid "Inaccessible"
msgstr "Inaccessibile"

msgid "Cannot access the Superfish library directory; perhaps because its permissions and/or ownership are not set up correctly."
msgstr "Impossibile accedere alla directory della libreria Superfish; probabilmente le relative autorizzazioni e/o la proprietà non sono impostate correttamente."

msgid "Unknown version"
msgstr "Versione sconosciuta"

msgid "Cannot determine the version of your Superfish library."
msgstr "Impossibile determinare la versione della libreria Superfish."

msgid "Not supported"
msgstr "Non supportato"

msgid "The Superfish library requires an update. You can find the update instructions on :url."
msgstr "La libreria Superfish richiede un aggiornamento. Le istruzioni per l'aggiornamento sono disponibili all'indirizzo :url."

msgid "Installed; at @location"
msgstr "Installato; in @location"

msgid "Not installed"
msgstr "Non installato"

msgid "Please download the Superfish library from :url."
msgstr "Scaricare la libreria Superfish da :url."

msgid "Superfish"
msgstr "Superfish"

msgid "Adds jQuery Superfish plugin to menu blocks."
msgstr "Aggiunge il plugin jQuery Superfish ai blocchi menu."

msgid "User interface"
msgstr "Interfaccia utente"

msgid "Block settings"
msgstr "Impostazioni blocco"

msgid "Default"
msgstr "Predefinito"

msgid "Horizontal (single row)"
msgstr "Orizzontale (riga singola)"

msgid "Menu type"
msgstr "Tipo di menu"

msgid "Horizontal (double row)"
msgstr "Orizzontale (riga doppia)"

msgid "Vertical (stack)"
msgstr "Verticale (pila)"

msgid "Style"
msgstr "Stile"

msgid "Black"
msgstr "Nero"

msgid "Blue"
msgstr "Blu"

msgid "Coffee"
msgstr "Caffè"

msgid "White"
msgstr "Bianco"

msgid "Add arrows to parent menus"
msgstr "Aggiunge frecce ai menu padre"

msgid "Drop shadows"
msgstr "Rilascia ombre"

msgid "jQuery Easing plugin is not installed."
msgstr "Plugin jQuery Easing non installato."

msgid "The plugin provides a handful number of animation effects, they can be used by uploading the 'jquery.easing.js' file to the libraries directory within the 'easing' directory (for example: libraries/easing/jquery.easing.js). Refresh this page after the plugin is uploaded, this will make more effects available in the above list."
msgstr "Il plugin fornisce alcuni effetti di animazione che possono essere utilizzati caricando il file 'jquery.easing.js' nella directory libraries all'interno della directory 'easing' (ad esempio: libraries/easing/jquery.easing.js). Aggiornare questa pagina una volta caricato il plugin; in questo modo, nell'elenco precedente saranno disponibili più effetti."

msgid "Slide-in effect"
msgstr "Effetto di scorrimento in entrata"

msgid "Superfish plugins"
msgstr "Plugin Superfish"

msgid "Relocates sub-menus when they would otherwise appear outside the browser window area."
msgstr "Riposiziona i menu secondari che, altrimenti, verrebbero visualizzati al di fuori dell'area della finestra del browser."

msgid "enabled"
msgstr "abilitato"

msgid "jQuery Supposition"
msgstr "jQuery Supposition"

msgid "Prevents accidental firing of animations by waiting until the user's mouse slows down enough, hence determinig user's <em>intent</em>."
msgstr "Impedisce l'avvio accidentale delle animazioni restando in attesa fino a quando il mouse rallenta a sufficienza, determinando l'<em>intenzione</em> dell'utente."

msgid "jQuery hoverIntent"
msgstr "jQuery hoverIntent"

msgid "<strong>sf-Touchscreen</strong> provides touchscreen compatibility."
msgstr "<strong>sf-Touchscreen</strong> fornisce la compatibilità con il touchscreen."

msgid "The first click on a parent hyperlink shows its children and the second click opens the hyperlink."
msgstr "Il primo clic su un link ipertestuale padre mostra i relativi elementi figlio ed il secondo clic apre il link ipertestuale."

msgid "sf-Touchscreen"
msgstr "sf-Touchscreen"

msgid "Disable"
msgstr "Disabilita"

msgid "Enable jQuery sf-Touchscreen plugin for this menu."
msgstr "Abilitare il plugin jQuery sf-Touchscreen per questo menu."

msgid "Enable jQuery sf-Touchscreen plugin for this menu depending on the user's Web browser <strong>window width</strong>."
msgstr "Abilitare il plugin jQuery sf-Touchscreen per questo menu in base alla <strong>larghezza della finestra</strong> del browser Web dell'utente."

msgid "Enable jQuery sf-Touchscreen plugin for this menu depending on the user's Web browser <strong>user agent</strong>."
msgstr "Abilitare il plugin jQuery sf-Touchscreen per questo menu in base all'<strong>agent utente</strong> del browser Web dell'utente."

msgid "Hiding the sub-menu on the second tap, adding cloned parent links to the top of sub-menus as well."
msgstr "Il menu secondario viene nascosto al secondo tocco, i link padre clonati vengono aggiunti nella parte superiore dei menu secondari."

msgid "Using this plugin, the first click or tap will expand the sub-menu, here you can choose what a second click or tap should do."
msgstr "Utilizzando questo plugin, il primo clic o tocco espande il menu secondario; qui è possibile scegliere l'operazione eseguita con il secondo clic o tocco."

msgid "Opening the parent menu item link on the second tap."
msgstr "Apertura del link dell'elemento menu padre al secondo tocco."

msgid "Hiding the sub-menu on the second tap."
msgstr "Il menu secondario viene nascosto al secondo tocco."

msgid "sf-Touchscreen will be enabled only if the width of user's Web browser window is smaller than the below value."
msgstr "sf-Touchscreen verrà abilitato solo se la larghezza della finestra del browser Web dell'utente è minore rispetto al valore riportato in basso."

msgid "Please note that in most cases such a meta tag is necessary for this feature to work properly:"
msgstr "Notare che nella maggior parte dei casi un metatag di questo tipo è necessario per il corretto funzionamento della funzione:"

msgid "Window width settings"
msgstr "Impostazioni larghezza finestra"

msgid "Also known as \"Breakpoint\"."
msgstr "Noto anche come \"punto di interruzione\"."

msgid "pixels"
msgstr "pixel"

msgid "User agent settings"
msgstr "Impostazioni agent utente"

msgid "Use the pre-defined list of the <strong>user agents</strong>."
msgstr "Utilizza l'elenco predefinito degli <strong>agent utente</strong>."

msgid "Recommended"
msgstr "Consigliato"

msgid "Use the custom list of the <strong>user agents</strong>."
msgstr "Utilizza l'elenco personalizzato degli <strong>agent utente</strong>."

msgid "UA string of the current Web browser:"
msgstr "Stringa UA del browser Web corrente:"

msgid "Could be partial or complete. (Asterisk separated)"
msgstr "Può essere parziale o completo. (Separato mediante asterisco)"

msgid "empty"
msgstr "vuoto"

msgid "Examples"
msgstr "Esempi"

msgid "Custom list of the user agents"
msgstr "Elenco personalizzato degli agent utente"

msgid "Client-side (JavaScript)"
msgstr "Lato client (JavaScript)"

msgid "<strong>User agent</strong> detection method"
msgstr "Metodo di rilevamento <strong>agent utente</strong>"

msgid "Server-side (PHP)"
msgstr "Lato server (PHP)"

msgid "sf-Smallscreen"
msgstr "sf-Smallscreen"

msgid "<strong>sf-Smallscreen</strong> provides small-screen compatibility for your menus."
msgstr "<strong>sf-Smallscreen</strong> fornisce la compatibilità small-screen per i menu."

msgid "Enable jQuery sf-Smallscreen plugin for this menu depending on the user's Web browser <strong>window width</strong>."
msgstr "Abilitare il plugin jQuery sf-Smallscreen per questo menu in base alla <strong>larghezza della finestra</strong> del browser Web dell'utente."

msgid "Enable jQuery sf-Smallscreen plugin for this menu."
msgstr "Abilitare il plugin jQuery sf-Smallscreen per questo menu."

msgid "Enable jQuery sf-Smallscreen plugin for this menu depending on the user's Web browser <strong>user agent</strong>."
msgstr "Abilitare il plugin jQuery sf-Smallscreen per questo menu in base all'<strong>agent utente</strong> del browser Web dell'utente."

msgid "sf-Smallscreen will be enabled only if the width of user's Web browser window is smaller than the below value."
msgstr "sf-Smallscreen verrà abilitato solo se la larghezza della finestra del browser Web dell'utente è minore rispetto al valore riportato in basso."

msgid "Convert the menu to an accordion menu."
msgstr "Converte il menu in un menu a fisarmonica."

msgid "Select a type"
msgstr "Seleziona un tipo"

msgid "Convert the menu to a &lt;select&gt; element."
msgstr "Convertire il menu in un elemento &lt;select&gt;."

msgid "&lt;select&gt; settings"
msgstr "Impostazioni &lt;select&gt;"

msgid "By default the first item in the &lt;select&gt; element will be the name of the parent menu or the title of this block, you can change this by setting a custom title."
msgstr "Per impostazione predefinita, la prima voce nell'elemento &lt;select&gt; sarà il nome del menu principale o il titolo di questo blocco, è possibile modificarlo impostando un titolo personalizzato."

msgid "Example"
msgstr "Esempio"

msgid "Main Menu"
msgstr "Menu principale"

msgid "&lt;select&gt; title"
msgstr "Titolo &lt;select&gt;"

msgid "Add <em>selected</em> attribute to the &lt;option&gt; element with the class <strong>active</strong> ."
msgstr "Aggiunge l'attributo <em>selected</em> all'elemento <option> con la classe <strong>active</strong> ."

msgid "Makes pre-selected the item linked to the active page when the page loads."
msgstr "Rende preselezionato l'elemento collegato alla pagina attiva quando viene caricata la pagina."

msgid "More"
msgstr "Più"

msgid "Copy the main &lt;ul&gt; classes to the &lt;select&gt;."
msgstr "Copiare le classi &lt;ul&gt; principali in &lt;select&gt;."

msgid "disabled"
msgstr "disabilitato"

msgid "Comma separated"
msgstr "Separato da virgole"

msgid "Exclude these classes from the &lt;select&gt; element"
msgstr "Escludi queste classi dall'elemento &lt;select&gt;"

msgid "Copy the hyperlink classes to the &lt;option&gt; elements of the &lt;select&gt;."
msgstr "Copiare le classi di link ipertestuale negli elementi &lt;option&gt; di &lt;select&gt;."

msgid "Exclude these classes from the &lt;option&gt; elements of the &lt;select&gt;"
msgstr "Escludi queste classi dagli elementi &lt;option&gt; di &lt;select&gt;"

msgid "Include these classes in the &lt;select&gt; element"
msgstr "Includi queste classi nell'elemento &lt;select&gt;"

msgid "Include these classes in the &lt;option&gt; elements of the &lt;select&gt;"
msgstr "Includi queste classi negli elementi &lt;option&gt; di &lt;select&gt;"

msgid "Accordion settings"
msgstr "Impostazioni accordion"

msgid "By default the caption of the accordion toggle switch will be the name of the parent menu or the title of this block, you can change this by setting a custom title."
msgstr "Per impostazione predefinita, la didascalia dello switch di attivazione del menu a fisarmonica sarà il nome del menu padre o il titolo di questo blocco; è possibile modificare questa impostazione impostando un titolo personalizzato."

msgid "Menu"
msgstr "Menu"

msgid "Accordion menu title"
msgstr "Titolo menu a fisarmonica"

msgid "Use parent menu items as buttons, add cloned parent links to sub-menus as well."
msgstr "Utilizza gli elementi del menu come pulsanti, aggiunge i link padre clonati ai menu secondari."

msgid "Accordion button type"
msgstr "Tipo di pulsante menu a fisarmonica"

msgid "Use parent menu items as buttons."
msgstr "Utilizza gli elementi del menu padre come pulsanti."

msgid "Create new links next to parent menu item links and use them as buttons."
msgstr "Creare nuovi link accanto ai link della voce del menu padre ed utilizzarli come pulsanti."

msgid "Supersubs"
msgstr "Supersubs"

msgid "<strong>Supersubs</strong> makes it possible to define custom widths for your menus."
msgstr "<strong>Supersubs</strong> consente di definire larghezze personalizzate per i propri menu."

msgid "Enable Supersubs for this menu."
msgstr "Abilitare Supersubs per questo menu."

msgid "Minimum width for sub-menus, in <strong>em</strong> units."
msgstr "Larghezza minima dei menu secondari, in unità <strong>em</strong>."

msgid "Minimum width"
msgstr "Larghezza minima"

msgid "Maximum width for sub-menus, in <strong>em</strong> units."
msgstr "Larghezza massima dei menu secondari, in unità <strong>em</strong>."

msgid "Maximum width"
msgstr "Larghezza massima"

msgid "Please refer to the Superfish module documentation for how you should setup multi-column sub-menus."
msgstr "Fare riferimento alla documentazione del modulo Superfish per informazioni sulla configurazione dei menu secondari a più colonne."

msgid "Multi-column sub-menus"
msgstr "Menu secondari a più colonne"

msgid "Enable multi-column sub-menus."
msgstr "Abilita i menu secondari a più colonne."

msgid "The depth of the first instance of multi-column sub-menus."
msgstr "La profondità della prima istanza dei menu secondari a più colonne."

msgid "Start from depth"
msgstr "Inizia dalla profondità"

msgid "The amount of sub-menu levels that will be included in the multi-column sub-menu."
msgstr "La quantità di livelli di menu secondari che verranno inclusi nel menu secondario a più colonne."

msgid "Levels"
msgstr "Livelli"

msgid "Advanced settings"
msgstr "Impostazioni avanzate"

msgid "The speed of the animation either in <strong>milliseconds</strong> or pre-defined values (<strong>slow, normal, fast</strong>)."
msgstr "La velocità dell'animazione in <strong>millisecondi</strong> o valori predefiniti (<strong>lento, normale, veloce</strong>)."

msgid "Animation speed"
msgstr "Velocità dell'animazione"

msgid "The delay in <strong>milliseconds</strong> that the mouse can remain outside a sub-menu without it closing."
msgstr "L'intervallo di tempo in <strong>millisecondi</strong> durante il quale il mouse può rimanere all'esterno di un menu secondario senza che questo venga chiuso."

msgid "Mouse delay"
msgstr "Ritardo mouse"

msgid "The amount of sub-menu levels that remain open or are restored using the \".active-trail\" class."
msgstr "La quantità di livelli di sottomenu che rimangono aperti o vengono ripristinati utilizzando la classe \".active-trail\"."

msgid "Change this setting <strong>only and only</strong> if you are <strong>totally sure</strong> of what you are doing."
msgstr "Modificare questa impostazione <strong>solo</strong> se si è <strong>completamente sicuri</strong> dell'operazione che si sta eseguendo."

msgid "Path levels"
msgstr "Livelli percorso"

msgid "Hyperlinks"
msgstr "Link ipertestuali"

msgid "By enabling this option, only parent menu items with <em>Expanded</em> option enabled will have their submenus appear."
msgstr "Abilitando questa opzione, i menu secondari verranno visualizzati solo per le voci del menu padre con l'opzione <em>Espanso</em> abilitata."

msgid "Take \"Expanded\" option into effect."
msgstr "Attivare l'opzione \"Espanso\"."

msgid "Add cloned parent links to the top of sub-menus."
msgstr "Aggiunge i link padre clonati nella parte superiore dei menu secondari."

msgid "Disable hyperlink descriptions (\"title\" attribute)"
msgstr "Disabilita le descrizioni dei link ipertestuali (attributo \"title\")"

msgid "Insert hyperlink descriptions (\"title\" attribute) into hyperlink texts."
msgstr "Inserire le descrizioni dei link ipertestuali (attributo \"title\") nei testi dei link ipertestuali."

msgid "Add item depth classes to menu items and their hyperlinks."
msgstr "Aggiungere le classi di profondità dell'elemento alle voci di menu ed ai relativi link ipertestuali."

msgid "Custom classes"
msgstr "Classi personalizzate"

msgid "(Space separated, without dots)"
msgstr "(Separato mediante spazio, senza punti)"

msgid "For the main UL"
msgstr "Per la UL principale"

msgid "For the list items"
msgstr "Per gli elementi dell'elenco"

msgid "For the hyperlinks"
msgstr "Per i link ipertestuali"

msgid "Unacceptable value entered for the \"Animation speed\" option."
msgstr "Valore non accettabile immesso per l'opzione \"Velocità animazione\"."

msgid "Unacceptable value entered for the \"Mouse delay\" option."
msgstr "Valore non accettabile immesso per l'opzione \"Ritardo del mouse\"."

msgid "\"sfTouchscreen Breakpoint\" option cannot be empty."
msgstr "L'opzione \"Punto di interruzione sfTouchscreen\" non può essere vuota."

msgid "Unacceptable value enterd for the \"sfTouchscreen Breakpoint\" option."
msgstr "Valore non accettabile immesso per l'opzione \"Punto di interruzione sfTouchscreen\"."

msgid "List of the touch-screen user agents cannot be empty."
msgstr "L'elenco degli agent utente del touch-screen non può essere vuoto."

msgid "\"sfSmallscreen Breakpoint\" option cannot be empty."
msgstr "L'opzione \"Punto di interruzione sfSmallscreen\" non può essere vuota."

msgid "Unacceptable value entered for the \"sfSmallscreen Breakpoint\" option."
msgstr "Valore non accettabile immesso per l'opzione \"Punto di interruzione sfSmallscreen\"."

msgid "List of the small-screen user agents cannot be empty."
msgstr "L'elenco degli agent utente small-screen non può essere vuoto."

msgid "Unacceptable value entered for the \"Supersubs minimum width\" option."
msgstr "Valore non accettabile immesso per l'opzione \"Larghezza minima supersubs\"."

msgid "Unacceptable value entered for the \"Supersubs maximum width\" option."
msgstr "Valore non accettabile immesso per l'opzione \"Larghezza massima supersubs\"."

msgid "Supersubs \"maximum width\" has to be bigger than the \"minimum width\"."
msgstr "La \"larghezza massima\" supersubs deve essere maggiore della \"larghezza minima\"."

msgid "Expand"
msgstr "Espandi"

msgid "Collapse"
msgstr "Comprimi"

