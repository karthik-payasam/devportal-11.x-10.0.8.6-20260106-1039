msgstr "Медиасущность Twitter"

msgid "Media Entity Twitter provider."
msgstr "Провайдер медиасущности Twitter."

msgid "Media"
msgstr "Мультимедиа"

msgid "Media entity Twitter settings"
msgstr "Параметры медиасущности Twitter"

msgid "Base folder for thumbnails"
msgstr "Базовый каталог для уменьшенных копий"

msgid "\"Twitter\" media source configuration"
msgstr "Конфигурация источника медиаобъекта \"Twitter\""

msgid "Whether to use twitter api or not"
msgstr "Использовать API twitter или нет"

