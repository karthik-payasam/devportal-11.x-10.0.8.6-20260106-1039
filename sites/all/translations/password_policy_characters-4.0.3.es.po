msgid "Password Characters of Type Policy"
msgstr "Caracteres de contraseña de política de tipo"

msgid "Minimum characters of a particular type the password must contain."
msgstr "El mínimo de caracteres de un tipo concreto que debe contener la contraseña."

msgid "Security"
msgstr "Seguridad"

msgid "Number of characters"
msgstr "Número de caracteres"

msgid "Character type"
msgstr "Tipo de carácter"

msgid "Uppercase"
msgstr "Mayúsculas"

msgid "Lowercase"
msgstr "Minúsculas"

msgid "Letter"
msgstr "Letra"

msgid "Numeric"
msgstr "Numérico"

msgid "Special Character"
msgstr "Carácter especial"

msgid "The number of characters must be a positive number."
msgstr "El número de caracteres tiene que ser un número positivo."

msgid "Password must contain at least 1 uppercase character."
msgid_plural "Password must contain at least @count unique uppercase characters."
msgstr[0] "La contraseña debe contener al menos 1 carácter en mayúsculas."
msgstr[1] "La contraseña debe contener al menos @count caracteres exclusivos en mayúsculas."

msgid "Password must contain at least 1 lowercase character."
msgid_plural "Password must contain at least @count unique lowercase characters."
msgstr[0] "La contraseña debe contener al menos 1 carácter en minúsculas."
msgstr[1] "La contraseña debe contener al menos @count caracteres exclusivos en minúsculas."

msgid "Password must contain at least 1 letter character."
msgid_plural "Password must contain at least @count unique letter characters."
msgstr[0] "La contraseña debe contener al menos 1 carácter de letra."
msgstr[1] "La contraseña debe contener al menos @count caracteres exlusivos de letra."

msgid "Password must contain at least 1 special character."
msgid_plural "Password must contain at least @count unique special characters."
msgstr[0] "La contraseña debe contener al menos 1 carácter especial."
msgstr[1] "La contraseña debe contener al menos @count caracteres especiales exclusivos."

msgid "Password must contain at least 1 numeric character."
msgid_plural "Password must contain at least @count unique numeric characters."
msgstr[0] "La contraseña debe contener al menos 1 carácter numérico."
msgstr[1] "La contraseña debe contener al menos @count caracteres numéricos exclusivos."

msgid "Password character type"
msgstr "Tipo de carácter de contraseña"

msgid "Verifying that a password has a specific number of characters"
msgstr "Verificando que una contraseña tiene un determinado número de caracteres"

msgid "The password does not contain a the correct number of certain characters."
msgstr "La contraseña no contiene el número correcto de determinados caracteres."

