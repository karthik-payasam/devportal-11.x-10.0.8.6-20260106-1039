msgid "Rules HTTP Client"
msgstr "Rules HTTP Client"

msgid "Provides an action for making http requests."
msgstr "Proporciona una acción para realizar solicitudes http."

msgid "Rules"
msgstr "Reglas"

msgid "Error while requsting url as Error code: %code and Message: %message."
msgstr "Error al solicitar URL como código de error %code y mensaje %message."

msgid "Request HTTP data"
msgstr "Solicitar datos HTTP"

msgid "Data"
msgstr "Datos"

msgid "URL"
msgstr "URL"

msgid "Url address where to post, get and delete request send."
msgstr "Dirección URL a la que enviar solicitudes POST, GET y DELETE."

msgid "Headers"
msgstr "Cabeceras"

msgid "Request headers to send as 'name: value' pairs, one per line (e.g., Accept: text/plain). See <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a> for more information."
msgstr "Cabeceras de solicitud para enviar como pares 'nombre: valor', una por línea (p. ej., Accept: text/plain). Consulte <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a> para obtener más información."

msgid "Method"
msgstr "Método"

msgid "The HTTP request methods like'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH' etc."
msgstr "Los métodos de solicitud HTTP como por ejemplo 'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH', etc."

msgid "The request body, formatter as 'param=value&param=value&...' or one 'param=value' per line.."
msgstr "El cuerpo de solicitud, formateador como 'parámetro=valor&parámetro=valor&...' o un 'parámetro=valor' por línea.."

msgid "Max Redirect"
msgstr "Número máximo de redirecciones"

msgid "How many times a redirect may be followed."
msgstr "Cuántas veces se puede seguir una redirección."

msgid "Timeout"
msgstr "Tiempo de espera"

msgid "The maximum number of seconds the request may take.."
msgstr "El número máximo de segundos que puede tardar la solicitud.."

msgid "HTTP data"
msgstr "Datos HTTP"

