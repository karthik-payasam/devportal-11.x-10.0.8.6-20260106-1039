msgstr "대체 패턴"

msgid "The following tokens are available. You may use Twig syntax in this field."
msgstr "다음 토큰이 사용 가능합니다. 이 필드에서 Twig 구문을 사용할 수 있습니다."

msgid "Meta tags"
msgstr "메타 태그"

msgid "Overridden"
msgstr "대체됨"

msgid "Using defaults"
msgstr "기본값 사용"

