msgstr "제출"

msgid "Metatags for @view : @display have been saved."
msgstr "@view에 대한 메타 태그: @display이(가) 저장되었습니다."

msgid "Do you want to revert meta tags for @view_name : @display_name?"
msgstr "@view_name : @display_name에 대한 메타 태그를 되돌리시겠습니까?"

msgid "You are about to revert the custom meta tags for the %display_name display on the %view_name view. This action cannot be undone."
msgstr "%view_name 보기에 있는 %display_name 표시에 대한 사용자 정의 메타 태그를 되돌리려 합니다. 이 조치를 실행 취소할 수 없습니다."

msgid "Cancel"
msgstr "취소"

msgid "Reverted meta tags for @view_name : @display_name"
msgstr "@view_name : @display_name에 대한 되돌린 메타 태그"

msgid "Edit @language translation for %view: %display metatags"
msgstr "%view: %display 메타 태그에 대한 @language 번역 편집"

msgid "Successfully updated @language translation."
msgstr "@language 번역이 업데이트되었습니다."

msgid "The meta tags for this display"
msgstr "이 표시에 대한 메타 태그"

msgid "Use replacement tokens from the first row"
msgstr "첫 번째 행에서 대체 토큰 사용"

