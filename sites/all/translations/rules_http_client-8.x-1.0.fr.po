msgid "Rules HTTP Client"
msgstr "Règles du client HTTP"

msgid "Provides an action for making http requests."
msgstr "Fournit une action pour effectuer des demandes HTTP."

msgid "Rules"
msgstr "Rules"

msgid "Error while requsting url as Error code: %code and Message: %message."
msgstr "Erreur lors de la demande d'URL. Code d'erreur : %code et message : %message."

msgid "Request HTTP data"
msgstr "Demande de données HTTP"

msgid "Data"
msgstr "Données"

msgid "URL"
msgstr "URL"

msgid "Url address where to post, get and delete request send."
msgstr "Adresse URL où poster, obtenir et supprimer l'envoi de la demande."

msgid "Headers"
msgstr "Entêtes"

msgid "Request headers to send as 'name: value' pairs, one per line (e.g., Accept: text/plain). See <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a> for more information."
msgstr "En-tête de demande à envoyer en tant que paires 'name: value', une par ligne (par exemple, Accept: text/plain). Pour plus d'informations, voir <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a>."

msgid "Method"
msgstr "Méthode"

msgid "The HTTP request methods like'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH' etc."
msgstr "Méthodes de demande HTTP comme 'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH', etc."

msgid "The request body, formatter as 'param=value&param=value&...' or one 'param=value' per line.."
msgstr "Corps de la demande, au format 'param=value&param=value&...' ou une paire 'param=value' par ligne."

msgid "Max Redirect"
msgstr "Nombre max de réacheminements"

msgid "How many times a redirect may be followed."
msgstr "Nombre de fois où un réacheminement peut être suivi."

msgid "Timeout"
msgstr "Temps limite"

msgid "The maximum number of seconds the request may take.."
msgstr "Durée maximale, en secondes, du traitement de la demande."

msgid "HTTP data"
msgstr "Données HTTP"

