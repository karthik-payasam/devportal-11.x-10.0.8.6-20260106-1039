msgid "Allowlist skipping ban: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Lista de elementos permitidos que omiten la prohibición: %ip para el error de %type en %form <br />Origen: % source<br /> Agente de usuario: %browser"

msgid "Banned: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Prohibido: %ip para %type anómalo en %form <br />Origen: %source <br /> Agente de usuario: %browser"

msgid "Drupal Perimeter Defence"
msgstr "Drupal Perimeter Defence"

msgid "Immediately ban hackers when they try to scan the site."
msgstr "Vetar inmediatamente a los piratas informáticos cuando intentan explorar el sitio."

msgid "Perimeter defence settings"
msgstr "Valores de defensa perimetral"

msgid "Configure the settings for Drupal Perimeter Defence."
msgstr "Configure los valores para la defensa perimetral de Drupal."

msgid "Bypass Perimeter Defence ban rules"
msgstr "Ignorar reglas de prohibición de defensa perimetral"

msgid "Allow users to bypass the rules defined by Perimeter Defence module."
msgstr "Permitir a los usuarios ignorar las reglas definidas por el módulo de defensa perimetral."

msgid "Perimeter settings"
msgstr "Configuración de perímetro"

msgid "Perimeter Settings"
msgstr "Configuración de perímetro"

msgid "A list of regex patterns"
msgstr "Una lista de patrones de expresiones regulares"

msgid "A regex pattern"
msgstr "Un patrón de expresión regular"

msgid "Banned: %ip for requesting %pattern <br />Source: %source <br /> User Agent: %browser"
msgstr "Vetado: %ip por solicitar %pattern <br />Origen: %source <br /> Agente de usuario: %browser"

msgid "Perimeter will ban any user that generates \"404 - File not found\" for requesting any of the following url pattern"
msgstr "El perímetro prohibirá cualquier usuario que genere \"404 - Archivo no encontrado\" para solicitar cualquiera de los siguientes patrones de URL"

msgid "Ban URL patterns"
msgstr "Prohibir patrones de URL"

msgid "A list of regex patterns, each pattern on a separate line"
msgstr "Una lista de patrones de expresión regula, cada patrón en una línea separada"

