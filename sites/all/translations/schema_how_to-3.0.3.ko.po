msgid "Schema.org HowTo"
msgstr "Schema.org 방법"

msgid "Adds Schema.org/HowTo to the JSON LD array."
msgstr "Schema.org/HowTo를 JSON LD 배열에 추가합니다."

msgid "SEO"
msgstr "SEO"

