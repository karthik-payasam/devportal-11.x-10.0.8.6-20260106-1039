msgid "In order to use the Simple XML Sitemap Views module, the Views URL generator must be <a href=\"@url\">added</a> to a sitemap type."
msgstr "Damit das Modul 'Simple XML Sitemap Views' verwendet werden kann, muss der URL-Generator für Ansichten einem Sitemap-Typ <a href=\"@url\">hinzugefügt</a> werden."

msgid "Simple XML Sitemap (Views)"
msgstr "Einfache XML-Sitemap (Ansichten)"

msgid "Provides integration of the Simple XML Sitemap module with the Views module."
msgstr "Stellt die Integration des Moduls 'Einfache XML-Sitemap' in das Modul 'Ansichten' bereit."

msgid "SEO"
msgstr "SEO"

msgid "Views"
msgstr "Ansichten"

msgid "Simple XML Sitemap"
msgstr "Einfache XML-Sitemap"

msgid "Variants"
msgstr "Varianten"

msgid "Index"
msgstr "Index"

msgid "Priority"
msgstr "Priorität"

msgid "Change frequency"
msgstr "Änderungshäufigkeit"

msgid "Indexed arguments"
msgstr "Indexierte Argumente"

msgid "Max links"
msgstr "Maximale Anzahl an Links"

msgid "View"
msgstr "Anzeigen"

msgid "Display"
msgstr "Anzeigen"

msgid "Sitemaps"
msgstr "Sitemaps"

msgid "Operations"
msgstr "Operationen"

msgid "No view displays are set to be indexed yet. <a href=\"@url\">Edit a view.</a>"
msgstr "Es sind noch keine Ansichtsanzeigen für die Indexierung festgelegt. <a href=\"@url\">Bearbeiten Sie eine Ansicht.</a>"

msgid "Please configure at least one <a href=\"@sitemaps_url\">sitemap</a> to be of a <a href=\"@types_url\">type</a> that implements the views URL generator."
msgstr "Konfigurieren Sie mindestens eine <a href=\"@sitemaps_url\">Sitemap</a> mit einem <a href=\"@types_url\">Typ</a>, der den URL-Generator für Ansichten implementiert."

msgid "Edit"
msgstr "Bearbeiten"

msgid "Garbage collection in the simple_sitemap_views table"
msgstr "Aufräumfunktion in der Tabelle 'simple_sitemap_views'"

msgid "Views URL generator"
msgstr "Generator für Ansichten-URLs"

msgid "Generates URLs for views."
msgstr "Generiert URLs für Ansichten."

msgid "Index this display in sitemap <em>@variant_label</em>"
msgstr "Diese Anzeige in Sitemap indexieren <em>@variant_label</em>"

msgid "The priority this display will have in the eyes of search engine bots."
msgstr "Die Priorität, die diese Anzeige für Suchmaschinen-Bots haben wird."

msgid "The frequency with which this display changes. Search engine bots may take this as an indication of how often to index it."
msgstr "Die Häufigkeit, mit der sich diese Anzeige ändert. Suchmaschinen-Bots können dies als einen Hinweis darauf sehen, wie häufig sie indexiert werden soll."

msgid "Maximum display variations"
msgstr "Maximale Anzeigevariationen"

msgid "The maximum number of link variations to be indexed for this display. If left blank, each argument will create link variations for this display. Use with caution, as a large number of argument values​can significantly increase the number of sitemap links."
msgstr "Die maximale Anzahl an Linkvariationen, die für diese Anzeige indexiert werden sollen. Wenn das Feld leer bleibt, erstellt jedes Argument Linkvariationen für diese Anzeige. Verwenden Sie diese Option mit Vorsicht, da eine große Anzahl an Argumentwerten die Anzahl an Sitemap-Links beträchtlich vergrößern kann."

msgid "Simple XML Sitemap settings for this display"
msgstr "Einstellungen für einfache XML-Sitemaps für diese Anzeige"

msgid "Included in sitemaps: @variants"
msgstr "In Sitemaps enthalten: @variants"

msgid "Excluded from all sitemaps"
msgstr "Aus allen Sitemaps ausgeschlossen"

msgid "To enable indexing of an argument, you must enable indexing of all previous arguments."
msgstr "Um die Indexierung eines Arguments zu aktivieren, müssen Sie die Indexierung aller vorherigen Argumente aktivieren."

msgid "Simple XML Sitemap settings for this view."
msgstr "Einstellungen für einfache XML-Sitemaps für diese Ansicht."

