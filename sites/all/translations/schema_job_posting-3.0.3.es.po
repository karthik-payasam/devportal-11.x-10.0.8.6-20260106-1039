msgid "Schema.org: JobPosting"
msgstr "Schema.org: JobPosting"

msgid "baseSalary"
msgstr "baseSalary"

msgid "RECOMMENDED BY GOOGLE. The base salary of the position."
msgstr "RECOMENDADO POR GOOGLE. El salario base del puesto."

msgid "REQUIRED BY GOOGLE. Date and time when the job was posted."
msgstr "NECESARIO PARA GOOGLE. Fecha y hora en que se ofreció el trabajo."

msgid "REQUIRED BY GOOGLE. The description of the position."
msgstr "NECESARIO PARA GOOGLE. La descripción de la posición."

msgid "RECOMMENDED BY GOOGLE. The employment type of the jobPosting. Should be one of FULL_TIME, PART_TIME, CONTRACTOR, TEMPORARY, INTERN, VOLUNTEER, PER_DIEM, OTHER."
msgstr "RECOMENDADO POR GOOGLE. El tipo de empleo de jobPosting. Debería ser uno de FULL_TIME, PART_TIME, CONTRACTOR, TEMPORARY, INTERN, VOLUNTEER, PER_DIEM, OTHER."

msgid "REQUIRED BY GOOGLE. The organization offering the job position"
msgstr "NECESARIO PARA GOOGLE. La organización que ofrece el puesto de trabajo"

msgid "Globally unique id of the job posting, usually a url."
msgstr "ID exclusivo global de la publicación de trabajo, normalmente un url."

msgid "RECOMMENDED BY GOOGLE. The internal identifier of the position."
msgstr "RECOMENDADO POR GOOGLE. El identificador interno del puesto."

msgid "The industry the job belongs to."
msgstr "La industria a la que pertenece el trabajo."

msgid "The benefits of the position."
msgstr "Los beneficios del puesto."

msgid "location"
msgstr "ubicación"

msgid "REQUIRED BY GOOGLE. The location of the job."
msgstr "NECESARIO PARA GOOGLE. La ubicación del puesto."

msgid "The necessary qualifications of the candidate."
msgstr "Las cualificaciones necesarias del candidato."

msgid "The responsibilities in the job."
msgstr "Las responsabilidades del trabajo."

msgid "REQUIRED BY GOOGLE. The title of the job."
msgstr "NECESARIO PARA GOOGLE. El título del trabajo."

msgid "REQUIRED. The type of jobPosting."
msgstr "OBLIGATORIO. El tipo de jobPosting."

msgid "REQUIRED BY GOOGLE. The date after which this job posting is not valid anymore."
msgstr "NECESARIO PARA GOOGLE. La fecha después de la cuál esta oferta de trabajo ya no es válida."

