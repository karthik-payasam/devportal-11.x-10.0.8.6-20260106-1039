msgid "About"
msgstr "Информация"

msgid "View Password module will help the user to see what password they entered."
msgstr "Модуль просмотра пароля позволяет пользователю просматривать вводимый пароль."

msgid "Show password"
msgstr "Показать пароль"

msgid "Hide password"
msgstr "Скрыть пароль"

msgid "View Password"
msgstr "Показать пароль"

msgid "Allows the users to see the contents of the password fields on selected forms before submission."
msgstr "Позволяет пользователям видеть содержимое полей пароля в выбранных формах перед отправкой."

msgid "View Password Settings"
msgstr "Параметры просмотра пароля"

msgid "Lets you see password for the selected forms."
msgstr "Позволяет просматривать пароль в выбранных формах."

msgid "Administer View password"
msgstr "Администрирование просмотра пароля"

msgid "Configure the View password settings."
msgstr "Настройка параметров просмотра пароля."

msgid "View password config"
msgstr "Конфигурация просмотра пароля"

msgid "Do not want to display the password for this forms."
msgstr "Не показывать пароль в этих формах."

msgid "Enter the form class here."
msgstr "Введите здесь класс формы."

