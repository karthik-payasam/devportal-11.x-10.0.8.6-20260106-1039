msgid "Schema.org: Product"
msgstr "Schema.org: Produkt"

msgid "RECOMMENDED BY GOOGLE. The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Celkové hodnocení založené na kolekci revizí nebo hodnocení položky."

msgid "RECOMMENDED BY GOOGLE. The brand of the product."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Značka produktu."

msgid "RECOMMENDED BY GOOGLE. The category of the product."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Kategorie produktu."

msgid "RECOMMENDED BY GOOGLE. A description of the item."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Popis položky."

msgid "RECOMMENDED BY GOOGLE. Populate one of sku, gtin8, gtin12, gtin13, gtin14, isbn, or mpn."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Naplňte některý z typů čísel sku, gtin8, gtin12, gtin13, gtin14, isbn nebo mpn."

msgid "Globally unique ID of the product in the form of a URL. It does not have to be a working link."
msgstr "Globálně jedinečné ID produktu ve formátu adresy URL. Nemusí se jednat o pracovní odkaz."

msgid "REQUIRED BY GOOGLE. The primary image for this item."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Primární obrázek pro tuto položku."

msgid "REQUIRED BY GOOGLE. The name of the product."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Název produktu."

msgid "RECOMMENDED BY GOOGLE. Offers associated with the product."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Nabídky přidružené k produktu."

msgid "RECOMMENDED BY GOOGLE. Reviews of this item."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Recenze této položky."

msgid "REQUIRED. The type of product."
msgstr "POŽADOVÁNO. Typ produktu."

msgid "RECOMMENDED BY GOOGLE. The url of the product."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Adresa URL produktu."

