msgid "The password has a score of @password-score but the policy requires a score of at least @policy-score"
msgstr "La contraseña tiene una puntuación de @password-score, pero la política necesita una puntuación de @policy-score como mínimo"

msgid "Password Strength Minimum Score"
msgstr "Puntuación mínima de Fortaleza de contraseña"

msgid "Password Strength minimum score of @score"
msgstr "Puntuación mínima de Fortaleza de contraseña de @score"

msgid "PasswordStrength is a password strength estimator using pattern matching and minimum entropy calculation. Scores range from 0 to 4, 4 being the strongest password."
msgstr "PasswordStrength es un estimador de fortaleza de contraseña que utiliza la coincidencia de patrones y el cálculo de entropía mínima. Las puntuaciones van de 0 a 4, siendo 4 la contraseña más fuerte."

msgid "Your password lacks strength and has too many common patterns."
msgstr "La contraseña carece de fuerza y tiene demasiados patrones comunes."

