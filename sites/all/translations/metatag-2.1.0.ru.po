msgid "These tags are not part of the Metadata Element Set but may be useful for certain scenarios."
msgstr "Эти теги не входят в набор элементов метаданных, но могут быть полезны в некоторых случаях."

msgid "A summary of the resource."
msgstr "Краткое описание ресурса."

msgid "Access Rights"
msgstr "Права доступа"

msgid "Information about who can access the resource or an indication of its security status. Access Rights may include information regarding access or restrictions based on privacy, security, or other policies."
msgstr "Информация о том, кто имеет доступ к ресурсу, или о его состоянии защиты. Права доступа могут включать информацию о правах доступа или ограничениях, определенных конфиденциальностью, безопасностью или другими стратегиями."

msgid "Accrual Method"
msgstr "Метод добавления"

msgid "The method by which items are added to a collection."
msgstr "Метод добавления элементов в набор."

msgid "Accrual Periodicity"
msgstr "Периодичность добавления"

msgid "The frequency with which items are added to a collection."
msgstr "Частота добавления элементов в набор."

msgid "Accrual Policy"
msgstr "Стратегия добавления"

msgid "The policy governing the addition of items to a collection."
msgstr "Политика, управляющая добавлением элементов в набор."

msgid "Alternative Title"
msgstr "Альтернативный заголовок"

msgid "An alternative name for the resource. The distinction between titles and alternative titles is application-specific."
msgstr "Альтернативное имя ресурса. Различие между заголовками и альтернативными заголовками определяется конкретным приложением."

msgid "Audience"
msgstr "Аудитория"

msgid "A class of entity for whom the resource is intended or useful."
msgstr "Класс сущности, для которого предназначен или полезен ресурс."

msgid "Date Available"
msgstr "Дата доступности"

msgid "Date (often a range) that the resource became or will become available."
msgstr "Дата (часто период), когда ресурс стал или станет доступен."

msgid "Bibliographic Citation"
msgstr "Библиографическая цитата"

msgid "A bibliographic reference for the resource. Recommended practice is to include sufficient bibliographic detail to identify the resource as unambiguously as possible."
msgstr "Библиографическая ссылка для ресурса. Рекомендуется добавить достаточное количество библиографических сведений для максимально однозначной идентификации ресурса."

msgid "Conforms To"
msgstr "Соответствует"

msgid "An established standard to which the described resource conforms."
msgstr "Установленный стандарт, которому соответствует описываемый ресурс."

msgid "Date Created"
msgstr "Дата создания"

msgid "Date of creation of the resource."
msgstr "Дата создания ресурса."

msgid "Date Accepted"
msgstr "Дата принятия"

msgid "Date of acceptance of the resource. Examples of resources to which a Date Accepted may be relevant are a thesis (accepted by a university department) or an article (accepted by a journal)."
msgstr "Дата принятия ресурса. Примерами ресурсов, для которых может иметь смысл дата принятия, является диссертация (принимаемая университетом) или статья (принимаемая журналом)."

msgid "Date Copyrighted"
msgstr "Дата авторских прав"

msgid "Date of copyright."
msgstr "Дата авторских прав."

msgid "Date Submitted"
msgstr "Дата отправки"

msgid "Date of submission of the resource. Examples of resources to which a Date Submitted may be relevant are a thesis (submitted to a university department) or an article (submitted to a journal)."
msgstr "Дата отправки ресурса. Примерами ресурсов, для которых может иметь смысл дата отправки, является диссертация (сдаваемая в университет) или статья (сдаваемая в журнал)."

msgid "Audience Education Level"
msgstr "Уровень образования аудитории"

msgid "A class of entity, defined in terms of progression through an educational or training context, for which the described resource is intended."
msgstr "Класс сущности, определенный в терминах прохождения этапов обучения или подготовки, для которого предназначен описываемый ресурс."

msgid "Extent"
msgstr "Величина"

msgid "The size or duration of the resource."
msgstr "Размер или продолжительность ресурса."

msgid "Has Format"
msgstr "Имеет формат"

msgid "A related resource that is substantially the same as the pre-existing described resource, but in another format."
msgstr "Связанный ресурс, который в значительной степени совпадает с уже существующим описанным ресурсом, но в другом формате."

msgid "Has Part"
msgstr "Имеет часть"

msgid "A related resource that is included either physically or logically in the described resource."
msgstr "Связанный ресурс, который включен физически или логически в описываемый ресурс."

msgid "Has Version"
msgstr "Имеет версию"

msgid "A related resource that is a version, edition, or adaptation of the described resource."
msgstr "Связанный ресурс, который представляет собой версию, издание или адаптацию описываемого ресурса."

msgid "Instructional Method"
msgstr "Метод обучения"

msgid "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support. Instructional Method will typically include ways of presenting instructional materials or conducting instructional activities, patterns of learner-to-learner and learner-to-instructor interactions, and mechanisms by which group and individual levels of learning are measured. Instructional methods include all aspects of the instruction and learning processes from planning and implementation through evaluation and feedback."
msgstr "Процесс, используемый для формирования знаний, отношений и навыков, для поддержки которых предназначен описываемый ресурс. Метод обучения, как правило, включает способы представления учебных материалов или проведения учебных мероприятий, шаблоны взаимодействия обучаемых между собой и с преподавателем, а также механизмы оценки группы и отдельных уровней знаний. Методы обучения включают все аспекты процесса преподавания и обучения, начиная с планирования и реализации и заканчивая оценкой и обратной связью."

msgid "Is Format Of"
msgstr "Является форматом"

msgid "A related resource that is substantially the same as the described resource, but in another format."
msgstr "Связанный ресурс, который в значительной степени совпадает с описываемым ресурсом, но в другом формате."

msgid "Is Part Of"
msgstr "Является частью"

msgid "A related resource in which the described resource is physically or logically included."
msgstr "Связанный ресурс, в состав которого физически или логически входит описываемый ресурс."

msgid "Is Referenced By"
msgstr "Есть ссылки от"

msgid "A related resource that references, cites, or otherwise points to the described resource."
msgstr "Связанный ресурс, который ссылается на описываемый ресурс, цитирует его или как-либо указывает на него."

msgid "Is Replaced By"
msgstr "Заменен на"

msgid "A related resource that supplants, displaces, or supersedes the described resource."
msgstr "Связанный ресурс, заменяющий или замещающий описываемый ресурс."

msgid "Is Required By"
msgstr "Требуется для"

msgid "A related resource that requires the described resource to support its function, delivery, or coherence."
msgstr "Связный ресурс, которому требуется описываемый ресурс для поддержки своих функции, доставки или согласованности."

msgid "Is Version Of"
msgstr "Является версией"

msgid "A related resource of which the described resource is a version, edition, or adaptation. Changes in version imply substantive changes in content rather than differences in format."
msgstr "Связанный ресурс, для которого описываемый ресурс является версией, изданием или адаптацией. Изменения в версии подразумевают существенные изменения в содержимом, а не различия в формате."

msgid "Date Issued"
msgstr "Дата выпуска"

msgid "Date of formal issuance (e.g., publication) of the resource."
msgstr "Дата официального выпуска, например публикации, ресурса."

msgid "License"
msgstr "Лицензия"

msgid "A legal document giving official permission to do something with the resource."
msgstr "Юридический документ, который дает официальное разрешение на использование ресурса."

msgid "Mediator"
msgstr "Посредник"

msgid "An entity that mediates access to the resource and for whom the resource is intended or useful. In an educational context, a mediator might be a parent, teacher, teaching assistant, or care-giver."
msgstr "Сущность, которая обеспечивает доступ к ресурсу или для которой данный ресурс предназначен или полезен. В образовательном контексте посредник может быть родителем, учителем, помощником преподавателя или попечителем."

msgid "Medium"
msgstr "Средний"

msgid "The material or physical carrier of the resource."
msgstr "Материал или физический носитель ресурса."

msgid "Date Modified"
msgstr "Дата изменения"

msgid "Date on which the resource was changed."
msgstr "Дата, когда ресурс был изменен."

msgid "Provenance"
msgstr "Происхождение"

msgid "A statement of any changes in ownership and custody of the resource since its creation that are significant for its authenticity, integrity, and interpretation. The statement may include a description of any changes successive custodians made to the resource."
msgstr "Информация о любых изменениях принадлежности ресурса с момента его создания, которые являются существенными с точки зрения подлинности, целостности и интерпретации. Эта информация может включать описание всех изменений, которые вносили последовательные владельцы в ресурс."

msgid "References"
msgstr "Ссылки"

msgid "A related resource that is referenced, cited, or otherwise pointed to by the described resource."
msgstr "Связанный ресурс, на который описываемый ресурс ссылается, цитирует его или как-либо указывает на него."

msgid "Replaces"
msgstr "Заменяет"

msgid "A related resource that is supplanted, displaced, or superseded by the described resource."
msgstr "Связанный ресурс, заменяемый или замещаемый описываемым ресурсом."

msgid "Requires"
msgstr "Требует"

msgid "A related resource that is required by the described resource to support its function, delivery, or coherence."
msgstr "Связный ресурс, требуемый описываемому ресурсу для поддержки своих функции, доставки или согласованности."

msgid "Rights Holder"
msgstr "Правообладатель"

msgid "A person or organization owning or managing rights over the resource."
msgstr "Лицо или организация, владеющие правами собственности или управления по отношению к ресурсу."

msgid "Spatial Coverage"
msgstr "Пространственный охват"

msgid "Spatial characteristics of the resource."
msgstr "Пространственные характеристики ресурса."

msgid "Table Of Contents"
msgstr "Содержание"

msgid "A list of subunits of the resource."
msgstr "Список подъединиц ресурса."

msgid "Temporal Coverage"
msgstr "Временной охват"

msgid "Temporal characteristics of the resource."
msgstr "Временные характеристики ресурса."

msgid "Date Valid"
msgstr "Дата действительности"

msgid "Date (often a range) of validity of a resource."
msgstr "Дата (часто период) действительности ресурса."

