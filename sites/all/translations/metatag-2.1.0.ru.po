msgstr "Twitter Cards: Данные 2"

msgid "Twitter Cards: Description"
msgstr "Twitter Cards: Описание"

msgid "Twitter Cards: Do Not Track"
msgstr "Twitter Cards: Не отслеживать"

msgid "Twitter Cards: 1st gallery image"
msgstr "Twitter Cards: 1-е изображение галереи"

msgid "Twitter Cards: 2nd gallery image"
msgstr "Twitter Cards: 2-е изображение галереи"

msgid "Twitter Cards: 3rd gallery image"
msgstr "Twitter Cards: 3-е изображение галереи"

msgid "Twitter Cards: 4th gallery image"
msgstr "Twitter Cards: 4-е изображение галереи"

