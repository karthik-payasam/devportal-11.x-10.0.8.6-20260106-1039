msgstr "Twitter Cards: URL медиапотока MP4"

msgid "Twitter Cards: MP4 media straem MIME-type"
msgstr "Twitter Cards: Тип MIME медиапотока MP4"

msgid "Twitter Cards: Media player width"
msgstr "Twitter Cards: Ширина медиаплеера"

msgid "Twitter Cards: Site's Twitter account"
msgstr "Twitter Cards: Учетная запись сайта в Twitter"

msgid "Twitter Cards: Site's Twitter account ID"
msgstr "Twitter Cards: ИД учетной записи сайта в Twitter"

msgid "Twitter Cards: Title"
msgstr "Twitter Cards: Заголовок"

msgid "Twitter Cards: Type"
msgstr "Twitter Cards: Тип"

msgid "Twitter Cards"
msgstr "Twitter Cards"

msgid "A set of meta tags specially for controlling the summaries displayed when content is shared on <a href='https://twitter.com/'>Twitter</a>."
msgstr "Набор метатегов специально для управления краткой информацией, отображаемой при совместном доступе к содержимому в <a href='https://twitter.com/'>Twitter</a>."

msgid "Google Play app ID"
msgstr "ИД приложения Google Play"

msgid "iPad app ID"
msgstr "ИД приложения iPad"

msgid "String value, should be the numeric representation of your iPad app's ID in the App Store."
msgstr "Строковое значение, должно быть числовым представлением ИД приложения iPad в App Store."

msgid "iPhone app ID"
msgstr "ИД приложения iPhone"

msgid "String value, should be the numeric representation of your iPhone app's ID in the App Store."
msgstr "Строковое значение, должно быть числовым представлением ИД приложения iPhone в App Store."

msgid "Google Play app name"
msgstr "Имя приложения Google Play"

msgid "The name of the app in the Google Play app store."
msgstr "Имя приложения в Google Play."

msgid "The name of the iPad app."
msgstr "Имя приложения iPad."

msgid "The name of the iPhone app."
msgstr "Имя приложения iPhone."

msgid "App store country"
msgstr "Страна App Store"

msgid "If your application is not available in the US App Store, you must set this value to the two-letter country code for the App Store that contains your application."
msgstr "Если приложение отсутствует в американском App Store, необходимо указать здесь двухбуквенный код страны магазина App Store, где находится приложение."

msgid "Google Play app's custom URL scheme"
msgstr "Пользовательская схема URL приложения Google Play"

msgid "iPad app's custom URL scheme"
msgstr "Пользовательская схема URL приложения iPad"

msgid "iPhone app's custom URL scheme"
