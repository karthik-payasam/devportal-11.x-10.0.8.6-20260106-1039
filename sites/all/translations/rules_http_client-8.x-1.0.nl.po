msgid "Rules HTTP Client"
msgstr "Regels HTTP-client"

msgid "Provides an action for making http requests."
msgstr "Levert een actie voor het aanmaken van HTTP-aanvragen."

msgid "Rules"
msgstr "Regels"

msgid "Error while requsting url as Error code: %code and Message: %message."
msgstr "Fout bij opvragen van URL als Foutcode: %code en Bericht: %message."

msgid "Request HTTP data"
msgstr "HTTP-gegevens aanvragen"

msgid "Data"
msgstr "Gegevens"

msgid "URL"
msgstr "URL"

msgid "Url address where to post, get and delete request send."
msgstr "URL-adres waar de te verzenden aanvraag moet worden gepost, opgehaald en gewist."

msgid "Headers"
msgstr "Headers"

msgid "Request headers to send as 'name: value' pairs, one per line (e.g., Accept: text/plain). See <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a> for more information."
msgstr "Opdrachtheaders die moeten worden verzonden als 'naam: waarde'-paren, één per regel(bijv. Accept: text/plain). Zie <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a> voor meer informatie."

msgid "Method"
msgstr "Methode"

msgid "The HTTP request methods like'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH' etc."
msgstr "De HTTP-aanvraagmethode, zoals 'HEAD', 'POST', 'PUT', 'DELETE', 'TRACE', 'OPTIONS', 'CONNECT', 'PATCH' etc."

msgid "The request body, formatter as 'param=value&param=value&...' or one 'param=value' per line.."
msgstr "De lopende tekst van de aanvraag, opgemaakt als 'param=waarde&param=waarde&...' of one 'param=waarde' per regel."

msgid "Max Redirect"
msgstr "Max Redirect"

msgid "How many times a redirect may be followed."
msgstr "Geeft aan hoe vaak er een redirect mag worden gevolgd."

msgid "Timeout"
msgstr "Time-out"

msgid "The maximum number of seconds the request may take.."
msgstr "Het maximum aantal seconden dat de aanvraag mag duren."

msgid "HTTP data"
msgstr "HTTP-gegevens"

