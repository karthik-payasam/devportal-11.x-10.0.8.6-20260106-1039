msgid "Schema.org Article"
msgstr "Článek Schema.org"

msgid "Adds Schema.org/Article to the JSON LD array. Creates Article, BlogPosting, SocialMediaPosting, Report, ScholarlyArticle, TechArticle or APIReference."
msgstr "Přidává Schema.org/Article do pole JSON LD. Vytvoří Article, BlogPosting, SocialMediaPosting, Report, ScholarlyArticle, TechArticle nebo APIReference."

