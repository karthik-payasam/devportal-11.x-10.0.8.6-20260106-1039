msgid "Schema.org: Article"
msgstr "Schema.org: Článek"

msgid "Comma separated list of what the article is about, for instance taxonomy terms or categories."
msgstr "Čárkami oddělený seznam toho, o čem se pojednává článek, například taxonomické termíny nebo kategorie."

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "Celkové hodnocení založené na kolekci revizí nebo hodnocení položky."

msgid "REQUIRED BY GOOGLE. Author of the article."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Autor článku."

msgid "RECOMMENDED BY GOOGLE. Date the article was last modified."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Datum, kdy byl článek naposledy změněn."

msgid "REQUIRED BY GOOGLE. Date the article was published."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Datum, kdy byl článek publikován."

msgid "RECOMMENDED BY GOOGLE. A description of the item."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Popis položky."

msgid "REQUIRED BY GOOGLE. Headline of the article."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Nadpis článku."

msgid "Globally unique id of the article, usually a url."
msgstr "Globálně jedinečné ID článku, obvykle adresa URL."

msgid "REQUIRED BY GOOGLE. The primary image for this item."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Primární obrázek pro tuto položku."

msgid "RECOMMENDED BY GOOGLE. The canonical URL of the article page. Specify mainEntityOfPage when the article is the primary topic of the article page."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Kanonická adresa URL stránky článku. Zadejte položku mainEntityOfPage, je-li článek primárním tématem stránky článku."

msgid "Name (usually the headline of the article)."
msgstr "Název (obvykle nadpis článku)."

msgid "REQUIRED BY GOOGLE. Publisher of the article."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Vydavatel článku."

msgid "Reviews of this item."
msgstr "Recenze této položky."

msgid "Speakable property."
msgstr "Vlastnost Speakable."

msgid "REQUIRED. The type of article."
msgstr "POŽADOVÁNO. Typ článku."

