msgid "Password Character Types Policy"
msgstr "Politica Tipi di carattere della password"

msgid "Minimum number of different character types the password must contain."
msgstr "Il numero minimo di tipi di caratteri differenti che la password deve contenere."

msgid "Security"
msgstr "Sicurezza"

msgid "Character Types"
msgstr "Tipi di carattere"

msgid "Invalid plugin configuration."
msgstr "Configurazione plugin non valida."

msgid "Password must contain at least @types types of characters from the following character types: lowercase letters, uppercase letters, digits, special characters."
msgstr "La password deve contenere almeno @types tipi di caratteri tra i seguenti: lettere minuscole, lettere maiuscole, numeri, caratteri speciali."

msgid "Minimum number of character types"
msgstr "Numero massimo di tipi di carattere"

msgid "Select the minimum number of character types which must be found in a password. The four supported character types are given as: lowercase letters, uppercase letters, digits, special characters."
msgstr "Selezionare il numero minimo di tipi di caratteri che devono essere presenti in una password. I quattro tipi di caratteri supportati sono: lettere minuscole, lettere maiuscole, numeri, caratteri speciali."

msgid "The number of character types must be between 2 and 4."
msgstr "Il numero di tipi di carattere deve essere compreso tra 2 e 4."

msgid "Minimum password character types: @types"
msgstr "Numero minimo di tipi di carattere della password: @types"

msgid "Password character types"
msgstr "Tipi di carattere della password"

msgid "Verifying that a password has a minimum number of character types."
msgstr "Verifica che la password contenga un numero minimo di tipi di carattere."

msgid "Your password must have different character types."
msgstr "La password deve contenere tipi di carattere differenti."

