msgid "Schema.org Article"
msgstr "Article Schema.org"

msgid "Adds Schema.org/Article to the JSON LD array. Creates Article, BlogPosting, SocialMediaPosting, Report, ScholarlyArticle, TechArticle or APIReference."
msgstr "Ajoute Schema.org/Article au tableau JSON LD. Crée les entrées Article, BlogPosting, SocialMediaPosting, Report, ScholarlyArticle, TechArticle ou APIReference."

msgid "SEO"
msgstr "optimisation pour les moteurs de recherche"

