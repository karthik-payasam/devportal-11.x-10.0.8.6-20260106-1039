msgid "Schema.org: Article"
msgstr "Schema.org : Article"

msgid "Comma separated list of what the article is about, for instance taxonomy terms or categories."
msgstr "Liste séparée par des virgules du sujet de l'article, par exemple des termes de taxonomie ou des catégories."

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "Evaluation globale de l'élément, basée sur une collection de révisions ou d'évaluations."

msgid "REQUIRED BY GOOGLE. Author of the article."
msgstr "REQUIS PAR GOOGLE. Auteur de l'article."

msgid "RECOMMENDED BY GOOGLE. Date the article was last modified."
msgstr "RECOMMANDE PAR GOOGLE. Date de la dernière modification de l'article."

msgid "REQUIRED BY GOOGLE. Date the article was published."
msgstr "REQUIS PAR GOOGLE. Date de publication de l'article."

msgid "RECOMMENDED BY GOOGLE. A description of the item."
msgstr "RECOMMANDE PAR GOOGLE. Description de l'élément."

msgid "REQUIRED BY GOOGLE. Headline of the article."
msgstr "REQUIS PAR GOOGLE. Titre de l'article."

msgid "Globally unique id of the article, usually a url."
msgstr "ID global unique de l'article, généralement une URL."

msgid "REQUIRED BY GOOGLE. The primary image for this item."
msgstr "REQUIS PAR GOOGLE. Image principale de cet élément."

msgid "RECOMMENDED BY GOOGLE. The canonical URL of the article page. Specify mainEntityOfPage when the article is the primary topic of the article page."
msgstr "RECOMMANDE PAR GOOGLE. URL canonique de la page de l'article. Spécifiez mainEntityOfPage lorsque l'article est la rubrique principale de la page de l'article."

msgid "Name (usually the headline of the article)."
msgstr "Nom (généralement le titre de l'article)."

msgid "REQUIRED BY GOOGLE. Publisher of the article."
msgstr "REQUIS PAR GOOGLE. Editeur de l'article."

msgid "Reviews of this item."
msgstr "Révisions de cet élément."

msgid "Speakable property."
msgstr "Propriété Speakable."

msgid "REQUIRED. The type of article."
msgstr "Obligatoire. Type d'article."

