msgid "About"
msgstr "À propos"

msgid "Drupal Proxy Module"
msgstr "Module proxy Drupal"

msgid "Drupal Proxy"
msgstr "Proxy Drupal"

msgid "Proxy"
msgstr "Proxy"

msgid "Proxy Settings"
msgstr "Paramètres du proxy"

msgid "ProxySettingForm"
msgstr "Formulaire des paramètres du proxy"

msgid "Https or Https"
msgstr "Https ou Https"

msgid "type of Scheme"
msgstr "Type de schéma"

msgid "Proxy Server"
msgstr "Serveur proxy"

msgid "The IP address or hostname of the proxy server."
msgstr "Adresse IP ou nom d'hôte du serveur proxy."

msgid "Port"
msgstr "Port"

msgid "The port number used by the proxy server for client connections."
msgstr "Numéro de port utilisé par le serveur proxy pour les connexions client."

msgid "Proxy Username"
msgstr "Nom d'utilisateur du proxy"

msgid "A username used of proxy server for Authentication."
msgstr "Nom d'utilisateur utilisé pour l'authentification du serveur proxy."

msgid "Proxy Password"
msgstr "Mot de passe du proxy"

msgid "Password of proxy server used for Authentication."
msgstr "Mot de passe utilisé pour l'authentification du serveur proxy."

msgid "Proxy User Agent"
msgstr "Agent utilisateur du proxy"

msgid "A string which can be used by the proxy server to identify connection requests."
msgstr "Chaîne pouvant être utilisée par le serveur proxy pour identifier les demandes de connexion."

msgid "Proxy Exceptions"
msgstr "Exceptions du proxy"

msgid "Specify exceptions using either IP addresses or hostnames. Enter one exception per line. Exceptions will be accessed directly, not via proxy."
msgstr "Spécifiez des exceptions à l'aide d'adresses IP ou de noms d'hôte. Entrez une exception par ligne. Les exceptions seront accessibles directement, non via le proxy."

