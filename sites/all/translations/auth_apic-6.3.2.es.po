msgstr "Error al suprimir la organización (%org_url). Póngase en contacto con el administrador de sistemas para obtener ayuda."

msgid "Account successfully deleted."
msgstr "La cuenta se ha suprimido correctamente."

msgid "Error deleting user. Please contact your system administrator for assistance."
msgstr "Error al suprimir el usuario. Póngase en contacto con el administrador de sistemas para obtener ayuda."

msgid "Organization successfully deleted from ApicUserDeleteForm."
msgstr "La organización se ha suprimido satisfactoriamente de ApicUserDeleteForm."

