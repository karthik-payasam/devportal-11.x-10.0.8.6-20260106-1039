msgid "Finished @num elements and @num_translations translations created successfully."
msgstr "@num elementos concluídos e @num_translations traduções criadas com sucesso."

msgid "Finished @num elements created successfully."
msgstr "Concluída a criação de @num elementos com sucesso."

msgid "Finished with an error."
msgstr "Finalizado com erro."

msgid "Generate @label"
msgstr "Gerar @label"

msgid "Generate"
msgstr "Gerar"

msgid "Generate realistic items (content, users, menus, etc) to assist your site development and testing."
msgstr "Gere itens realistas (conteúdo, usuários, menus, etc.) para auxiliar o desenvolvimento e o teste do seu site."

msgid "Devel generate"
msgstr "Geração de desenvolvimento"

msgid "Devel Generate"
msgstr "Geração de desenvolvimento"

msgid "Generate test users, nodes, menus, taxonomy terms..."
msgstr "Gerar usuários de teste, nós, menus, termos de taxonomia..."

msgid "Development"
msgstr "Desenvolvimento"

msgid "Administer devel_generate"
msgstr "Administrar devel_generate"

msgid "Language"
msgstr "Idioma"

msgid "Select the primary language(s) for @items"
msgstr "Selecione um ou mais idiomas principais para @itens"

msgid "Disabled - requires Language module"
msgstr "Desativado - requer módulo de idioma"

msgid "Select the language(s) for translated @items"
msgstr "Selecione um ou mais idiomas para @itens traduzidos"

msgid "Translated @items will be created for each language selected."
msgstr "@items traduzidos serão criados para cada idioma selecionado."

msgid "Disabled - requires Content Translation module."
msgstr "Desativado - requer módulo de tradução de conteúdo."

msgid "@permission"
msgstr "@permission"

msgid "Failed to generate elements due to \"%error\"."
msgstr "Falha ao gerar elementos devido a \"%error\"."

msgid "You do not have any content types that can be generated. <a href=\":create-type\">Go create a new content type</a>"
msgstr "Você não tem nenhum tipo de conteúdo que possa ser gerado. <a href=\":create-type\">Criar um novo tipo de conteúdo</a>"

msgid "Hidden"
msgstr "Ocultos"

msgid "Closed"
msgstr "Fechada"

msgid "Open"
msgstr "Aberta"

msgid "No comment fields"
msgstr "Nenhum campo de comentários"

msgid "Content type"
msgstr "Tipo de conteúdo"

msgid "Comments"
msgstr "Comments"

msgid "<strong>Delete all content</strong> in these content types before generating new content."
msgstr "<strong>Apagar todos os conteúdos</strong> nestes tipos de conteúdos antes de gerar novos conteúdos."

msgid "How many nodes would you like to generate?"
msgstr "Quantos nodes você gostaria de gerar?"

msgid "Now"
msgstr "Agora"

msgid "ago"
msgstr "atrás"

msgid "How far back in time should the nodes be dated?"
msgstr "Até que ponto no passado os nós devem ser datados?"

msgid "Node creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "As datas de criação de nó serão distribuídas aleatoriamente a partir do horário atual, até voltar ao horário selecionado."

msgid "Maximum number of comments per node."
msgstr "Número máximo de comentários por node."

msgid "You must also enable comments for the content types you are generating. Note that some nodes will randomly receive zero comments. Some will receive the max."
msgstr "Deve-se também ativar comentários para os tipos de conteúdo que você está gerando. Observe que alguns nós receberão zero comentários aleatoriamente. Alguns receberão o máximo."

msgid "Maximum number of words in titles"
msgstr "Número máximo de palavras nos títulos"

msgid "Fields to leave empty"
msgstr "Campos para deixar vazio"

msgid "Enter the field names as a comma-separated list. These will be skipped and have a default value in the generated content."
msgstr "Insira os nomes do campo como uma lista separada por vírgula. Eles serão ignorados e terão um valor padrão no conteúdo gerado."

msgid "Base fields to populate"
msgstr "Campos base a serem preenchidos"

msgid "Enter the field names as a comma-separated list. These will be populated."
msgstr "Insira os nomes do campo como uma lista separada por vírgula. Eles serão preenchidos."

msgid "Prefix the title with the content type label."
msgstr "Prefixar o título com o rótulo do tipo de conteúdo."

msgid "This will not count against the maximum number of title words specified above."
msgstr "Isso não contará para o número máximo de palavras de título especificado acima."

msgid "Requires path.module"
msgstr "Requer path.module"

msgid "Add an url alias for each node."
msgstr "Inclua um alias de URL para cada nó."

msgid "Add statistics for each node (node_counter table)."
msgstr "Adicionar estatísticas para cada node (tabela node_counter)."

msgid "User ID"
msgstr "ID do Usuário"

msgid "Name"
msgstr "Nome"

msgid "Role(s)"
msgstr "Função(ões)"

msgid "Users"
msgstr "Usuários"

msgid "Select users for randomly assigning as authors of the generated content. Leave all unchecked to use a random selection of up to 50 users."
msgstr "Selecione usuários a serem designados aleatoriamente como autores do conteúdo gerado. Deixe tudo desmarcado para usar uma seleção aleatória de até 50 usuários."

msgid "Please select at least one content type"
msgstr "Selecione pelo menos um tipo de conteúdo"

msgid "Generating Content"
msgstr "Gerando conteúdo"

msgid "Deleted %count nodes."
msgstr "%count nós excluídos."

msgid "Completed @feedback nodes (@rate nodes/min)"
msgstr "@feedback nós concluídos (@rate nós/min)"

msgid "No content types available"
msgstr "Nenhum tipo de conteúdo disponível"

msgid "To delete content, please provide the content types (--bundles)"
msgstr "Para excluir o conteúdo, forneça os tipos de conteúdo (--bundles)"

msgid "One or more content types have been entered that don't exist on this site"
msgstr "Foram inseridos um ou mais tipos de conteúdo que não existem neste site"

msgid "Created 1 node"
msgid_plural "Created @count nodes"
msgstr[0] "Criado um nó"
msgstr[1] "Criados @count nós"

msgid "Created 1 node translation"
msgid_plural "Created @count node translations"
msgstr[0] "Criada uma tradução de nó"
msgstr[1] "Criadas @count traduções de nós"

msgid "content"
msgstr "conteúdo"

msgid "Generate a given number of content. Optionally delete current content."
msgstr "Gere um determinado número de conteúdo. Como opção, exclua o conteúdo atual."

msgid "You do not have any media types that can be generated. <a href=\":url\">Go create a new media type</a>"
msgstr "Você não tem nenhum tipo de mídia que possa ser gerado. <a href=\":url\">Criar um novo tipo de mídia</a>"

msgid "Media type"
msgstr "Tipo de mídia"

msgid "<strong>Delete all media</strong> in these types before generating new media."
msgstr "<strong>Exclua todas as mídias</strong> nestes tipos antes de gerar novas mídias."

msgid "How many media items would you like to generate?"
msgstr "Quantos itens de mídia você deseja gerar?"

msgid "How far back in time should the media be dated?"
msgstr "A mídia deve ser datada retroativamente até quando?"

msgid "Media creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "As datas de criação da mídia serão distribuídas aleatoriamente no horário atual, retroativamente até o horário selecionado."

msgid "Maximum number of words in names"
msgstr "Número máximo de palavras nos nomes"

msgid "Set language on media"
msgstr "Configurar idioma na mídia"

msgid "Requires locale.module"
msgstr "Requer locale.module"

msgid "Please select at least one media type"
msgstr "Selecione pelo menos um tipo de mídia"

msgid "Generating media items"
msgstr "Gerando itens de mídia"

msgid "Deleted %count media items."
msgstr "Excluídos %count itens de mídia."

msgid "Completed !feedback media items (!rate media/min)"
msgstr "Os itens de mídia de !feedback foram concluídos (!rate mídia/min)"

msgid "No media types available"
msgstr "Nenhum tipo de mídia disponível"

msgid "1 media item created."
msgid_plural "Finished creating @count media items."
msgstr[0] "Um item de mídia criado."
msgstr[1] "A criação de @count itens de mídia foi concluída."

msgid "media"
msgstr "mídia"

msgid "Generate a given number of media entities."
msgstr "Gerar um determinado número de entidades de mídia."

msgid "Create new menu(s)"
msgstr "Criar novos menus"

msgid "Generate links for these menus"
msgstr "Gerar links para estes menus"

msgid "Number of new menus to create"
msgstr "Número de novos menus para criar"

msgid "Number of links to generate"
msgstr "Número de links para gerar."

msgid "Maximum length for menu titles and menu links"
msgstr "Comprimento máximo para os títulos de menu e para os links do menu"

msgid "Text will be generated at random lengths up to this value. Enter a number between 2 and 128."
msgstr "O texto será gerado em comprimentos aleatórios até este valor. Digite um número entre 2 e 128."

msgid "Types of links to generate"
msgstr "Tipos de links a serem gerados"

msgid "Nodes"
msgstr "Nós"

msgid "Front page"
msgstr "Primeira página"

msgid "External"
msgstr "Externo"

msgid "Maximum link depth"
msgstr "Profundidade máxima do link"

msgid "Maximum menu width"
msgstr "Largura máxima do menu"

msgid "Limit the width of the generated menu's first level of links to a certain number of items."
msgstr "Limite a largura do primeiro nível de links do menu gerado para um determinado número de itens."

msgid "Delete existing custom generated menus and menu links before generating new ones."
msgstr "Exclua menus gerados e links de menus customizados existentes antes de gerar novos."

msgid "Deleted @menus_deleted menu(s) and @links_deleted other link(s)."
msgstr "Excluídos @menus_deleted menus e @links_deleted outros links."

msgid "Description of @name"
msgstr "Descrição de @name"

msgid "Description of @title."
msgstr "Descrição de @title."

msgid "Invalid number of menus"
msgstr "Número inválido de menus"

msgid "Invalid number of links"
msgstr "Número inválido de links"

msgid "Invalid maximum link depth. Use a value between 1 and 9"
msgstr "Profundidade máxima do link inválida. Usar um valor entre um e nove"

msgid "Invalid maximum menu width. Use a positive numeric value."
msgstr "Largura máxima do menu inválida. Utilize um valor numérico positivo."

msgid "Created the following 1 new menu: @menus"
msgid_plural "Created the following @count new menus: @menus"
msgstr[0] "Criado um novo menu a seguir: @menus"
msgstr[1] "Criados @count novos menus a seguir: @menus"

msgid "Created 1 new menu link."
msgid_plural "Created @count new menu links."
msgstr[0] "Criado um novo link de menu."
msgstr[1] "@count novos links de menus criados."

msgid "menus"
msgstr "menus"

msgid "Generate a given number of menus and menu links. Optionally delete current menus."
msgstr "Gerar um número específico de menus e links de menus. Opcionalmente apaga os menus atuais."

msgid "Vocabularies"
msgstr "Vocabulários"

msgid "Restrict terms to these vocabularies."
msgstr "Restrinja os termos para estes vocabulários."

msgid "Number of terms"
msgstr "Número de termos"

msgid "Maximum number of characters in term names"
msgstr "Número máximo de caracteres em nomes de termos"

msgid "Minimum depth for new terms in the vocabulary hierarchy"
msgstr "Profundidade mínima para novos termos na hierarquia do vocabulário"

msgid "Enter a value from 1 to 20."
msgstr "Digite um valor de 1 a 20."

msgid "Maximum depth for new terms in the vocabulary hierarchy"
msgstr "Profundidade máxima para novos termos na hierarquia do vocabulário"

msgid "Delete existing terms in specified vocabularies before generating new terms."
msgstr "Exclua termos existentes em vocabulários especificados antes de gerar novos termos."

msgid "In vocabulary @vlabel: @termlist"
msgstr "No vocabulário @vlabel: @termlist"

msgid "In vocabulary @vlabel: No terms created"
msgstr "No vocabulário @vlabel: nenhum termo criado"

msgid "Minimum depth changed from @min_depth to 1 because all terms were deleted"
msgstr "Profundidade mínima mudada de @min_depth para 1 porque todos os termos foram excluídos"

msgid "Please provide a vocabulary machine name (--bundles)."
msgstr "Forneça um nome de máquina de vocabulário (--bundles)."

msgid "Invalid vocabulary machine name: @name"
msgstr "Nome da máquina de vocabulário inválido: @name"

msgid "Invalid number of terms: @num"
msgstr "Número inválido de termos: @num"

msgid "The depth values must be in the range 1 to 20 and min-depth cannot be larger than max-depth (values given: min-depth @min, max-depth @max)"
msgstr "Os valores de profundidade devem estar na faixa de 1 a 20 e a profundidade mínima não pode ser maior do que a profundidade máxima (valores fornecidos: min-depth @min, max-depht @max)"

msgid "Created 1 new term"
msgid_plural "Created @count new terms"
msgstr[0] "Criado um novo termo"
msgstr[1] "Criados @count novos termos"

msgid "1 new term at level @level (@terms)"
msgid_plural "@count new terms at level @level (@terms)"
msgstr[0] "Um novo termo no nível @level (@terms)"
msgstr[1] "@count novos termos no nível @level (@terms)"

msgid "Created 1 term translation"
msgid_plural "Created @count term translations"
msgstr[0] "Criada uma tradução de termo"
msgstr[1] "Criadas @count traduções de termo"

msgid "Deleted 1 existing term"
msgid_plural "Deleted @count existing terms"
msgstr[0] "Excluído um termo existente"
msgstr[1] "Excluídos @count termos existentes"

msgid "terms"
msgstr "termos"

msgid "Generate a given number of terms. Optionally delete current terms."
msgstr "Gerar um determinado número de termos. Opcionalmente, remova os termos atuais."

msgid "How many users would you like to generate?"
msgstr "Quantos usuários que você gostaria de gerar?"

msgid "Delete all users (except user id 1) before generating new users."
msgstr "Excluas todos os usuários (exceto o ID do usuário 1) antes de gerar novos usuários."

msgid "Which roles should the users receive?"
msgstr "Quais funções os usuários devem receber?"

msgid "Users always receive the <em>authenticated user</em> role."
msgstr "Os usuários sempre recebem a função <em>usuário autenticado</em>."

msgid "Password to be set"
msgstr "Senha a ser configurada"

msgid "Leave this field empty if you do not need to set a password"
msgstr "Deixe este campo em branco se não precisar configurar uma senha"

msgid "How old should user accounts be?"
msgstr "Quantos anos as contas dos usuários devem ter?"

msgid "User ages will be distributed randomly from the current time, back to the selected time."
msgstr "As idades dos usuários serão distribuídas aleatoriamente a partir do horário atual, até voltar ao horário selecionado."

msgid "@num_users created."
msgstr "@num_users criados."

msgid "1 user deleted"
msgid_plural "@count users deleted."
msgstr[0] "Um usuário excluído"
msgstr[1] "@count usuários excluídos."

msgid "1 user"
msgid_plural "@count users"
msgstr[0] "Um usuário"
msgstr[1] "@count usuários"

msgid "users"
msgstr "Usuários"

msgid "Generate a given number of users. Optionally delete current users."
msgstr "Gere um determinado número de usuários. Como opção, exclua os usuários atuais."

msgid "Number of vocabularies?"
msgstr "Número de vocabulários?"

msgid "Maximum number of characters in vocabulary names"
msgstr "Número máximo de caracteres em nomes de vocabulários"

msgid "Delete existing vocabularies before generating new ones."
msgstr "Exclua vocabulários existentes antes de gerar novos."

msgid "Deleted existing vocabularies."
msgstr "Vocabulários existentes excluídos."

msgid "Created the following new vocabularies: @vocs"
msgstr "Os novos vocabulários a seguir foram criados: @vocs"

msgid "Invalid number of vocabularies: @num."
msgstr "Número inválido de vocabulários: @num"

msgid "vocabularies"
msgstr "vocabulários"

msgid "Generate a given number of vocabularies. Optionally delete current vocabularies."
msgstr "Gerar um determinado número de vocabulários. Opcionalmente, remova os vocabulários atuais."

