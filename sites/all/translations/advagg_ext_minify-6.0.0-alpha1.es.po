msgid "Advagg External Minification: PHP shell_exec"
msgstr "Advagg Minificación externa: PHP shell_exec"

msgid "PHP shell_exec is non-functional."
msgstr "PHP shell_exec no es funcional."

msgid "Check php.ini for safemode or <a href=\"@link\" target=\"_blank\">disable_functions</a>."
msgstr "Marque php.ini para la modalidad segura o <a href=\"@link\" target=\"_blank\">disable_functions</a>."

msgid "Enabled"
msgstr "Habilitado"

msgid "AdvAgg External Minification"
msgstr "AdvAgg Minificación externa"

msgid "Minify Javascript and/or CSS with a command line minifier."
msgstr "Minificar Javascript y/o CSS con un minificador de línea de mandatos."

msgid "Advanced CSS/JS Aggregation"
msgstr "Agregación de CSS/JS avanzada"

msgid "External Minification"
msgstr "Minificación externa"

msgid "AdvAgg external minification settings."
msgstr "Configuración de la AdvAgg minificación externa."

msgid "AdvAgg: External Minifiers"
msgstr "AdvAgg: Minificadores externos"

msgid "Settings"
msgstr "Valores"

msgid "Command line for external CSS minification."
msgstr "Línea de mandatos para la minificación CSS externa."

msgid "Whether to use the external CSS minifier if configured."
msgstr "Indica si se va a utilizar el minificador CSS externo, si está configurado."

msgid "Command line for external JavaScript minification."
msgstr "Línea de mandatos para la minificación JavaScript externa."

msgid "Whether to use the external JS minifier if configured."
msgstr "Indica si se va a utilizar el minificador JS externo, si está configurado."

msgid "CSS"
msgstr "CSS"

msgid "JavaScript"
msgstr "JavaScript"

msgid "Command Line"
msgstr "Línea de comandos"

msgid "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = input file. <br /> {%IN_URL_ENC%} = url pointing to the input file that has been url encoded. <br /> {%OUT%} = output file. <br /><br />"
msgstr "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = archivo de entrada. <br /> {%IN_URL_ENC%} = url que apunta al archivo de entrada que se ha codificado en el url. <br /> {%OUT%} = archivo de salida. <br /><br />"

msgid "Example using the <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"
msgstr "Ejemplo de utilización de <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "Ejemplo de utilización de <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"

msgid "Example using curl to minify via the <a href=\"@link1\">Online Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "Ejemplo de utilización de curl para minificar a través de <a href=\"@link1\">Google Closure Compiler en línea</a>. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">YUI Compressor</a>. <p><code>@code1</code></p>"
msgstr "Ejemplo de utilización del <a href=\"@link1\">Compresor de YUI</a>. <p><code>@code1</code></p>"

msgid "Example using curl to minify via an online <a href=\"@link1\">CSS Minifier</a>. <p><code>@code1</code></p>"
msgstr "Ejemplo de uso de curl para minificar a través de un <a href=\"@link1\">CSS Minifier</a> en línea. <p><code>@code1</code></p>"

msgid "Command to run"
msgstr "Mandato para ejecutar"

msgid "Enable external @type minification"
msgstr "Habilitar minificación @type externa"

