msgstr "Zkontrolujte, které jazyky by tento vzor měl použít. Ponechejte prázdné pro libovolnou možnost."

msgid "A short name to help you identify this pattern in the patterns list."
msgstr "Krátký název, který vám pomůže identifikovat tento vzor v seznamu vzorů."

msgid "Enabled"
msgstr "Zapnuto"

msgid "Language"
msgstr "Jazyk"

msgid "Pattern %label saved."
msgstr "Vzor %label byl uložen."

msgid "Are you sure you want to enable the pattern %label?"
msgstr "Opravdu chcete povolit vzor %label?"

msgid "Enable"
msgstr "Zapnout"

msgid "Enabled pattern %label."
msgstr "Povolený vzor %label."

msgid "Update URL alias of an entity"
msgstr "Aktualizovat alias adresy URL entity"

msgid "@label being aliased"
msgstr "@label s aliasem"

msgid "The name of the pattern's variable."
msgstr "Název proměnné šablony."

msgid "The value of the pattern's variable."
msgstr "Hodnota proměnné šablony."

msgid "Broken type"
msgstr "Přerušený typ"

msgid "Broken"
msgstr "Poškozeno"

msgid "Broken/Missing"
msgstr "Rozbitý/chybějící"

msgid "AliasType"
msgstr "AliasType"

msgid "Updated alias for %label @id."
msgstr "Aktualizovaný alias pro %label @id."

msgid "Updated 1 %label URL alias."
msgid_plural "Updated @count %label URL aliases."
msgstr[0] "Aktualizovaný 1 alias adresy URL %label."
msgstr[1] "Aktualizováno @count aliasů adresy URL %label."
msgstr[2] "Aktualizováno @count aliasů adresy URL %label."

msgid "Forum"
msgstr "Fórum"

