msgstr "%element-title používá následující neplatné znaky: @invalid-characters."

msgid "The %element-title doesn't allow the patterns ending with whitespace."
msgstr "%element-title neumožňuje, aby vzory končily prázdným znakem."

msgid "Entity of type @type was not processed. It defines the following patterns: @patterns"
msgstr "Entita typu @type nebyla zpracována. Definuje následující vzory: @patterns"

msgid "Unrecognized entity bundle @entity:@bundle was not processed. It defines the following patterns: @patterns"
msgstr "Nerozpoznaný balík entit @entity: @bundle nebyl zpracován. Definuje následující vzory: @patterns"

