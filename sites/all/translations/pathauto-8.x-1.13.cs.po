msgstr "Vymaže všechny aliasy. Počet aliasů, které budou smazány: %count."

msgid "Delete aliases for all @label. Number of aliases which will be deleted: %count."
msgstr "Vymazat všechny aliasy typu @label. Počet aliasů k vymazání: %count."

msgid "Delete options"
