msgid "Schema.org HowTo"
msgstr "Schema.org HowTo"

msgid "Adds Schema.org/HowTo to the JSON LD array."
msgstr "Ajoute Schema.org/HowTo au tableau JSON LD."

msgid "SEO"
msgstr "optimisation pour les moteurs de recherche"

msgid "@type"
msgstr "@type"

msgid "name"
msgstr "Nom"

msgid "step"
msgstr "étape"

msgid "description"
msgstr "Description"

msgid "@id"
msgstr "@id"

msgid "image"
msgstr "image"

msgid "estimatedCost"
msgstr "estimatedCost"

msgid "supply"
msgstr "fourniture"

msgid "tool"
msgstr "outil"

