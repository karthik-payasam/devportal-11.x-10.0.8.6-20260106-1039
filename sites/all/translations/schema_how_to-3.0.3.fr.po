msgstr "url"

msgid "Schema.org: HowTo"
msgstr "Schema.org : HowTo"

msgid "RECOMMENDED BY GOOGLE. A description of the how-to."
msgstr "RECOMMANDE PAR GOOGLE. Description de la procédure."

msgid "RECOMMENDED BY GOOGLE. The estimated cost of the supplies consumed when performing instructions."
msgstr "RECOMMANDE PAR GOOGLE. Coût estimé des fournitures consommées lors de l'exécution des instructions."

msgid "Globally unique id of the how to, usually a url."
msgstr "ID globalement unique de la procédure, généralement une URL."

msgid "RECOMMENDED BY GOOGLE. Image of the completed how-to."
msgstr "RECOMMANDE PAR GOOGLE. Image de la procédure terminée."

msgid "REQUIRED BY GOOGLE. The title of the how-to. For example, 'How to tie a tie'."
msgstr "REQUIS PAR GOOGLE. Titre de la procédure, par exemple 'Comment faire un noeud de cravate'."

msgid "REQUIRED BY GOOGLE. An array of HowToStep elements which comprise the full instructions of the how-to."
msgstr "REQUIS PAR GOOGLE. Tableau des éléments HowToStep qui contiennent les instructions complètes de la procédure."

msgid "RECOMMENDED BY GOOGLE. A supply consumed when performing instructions or a direction."
msgstr "RECOMMANDE PAR GOOGLE. Fourniture consommée lors de l'exécution d'instructions ou d'une directive."

msgid "RECOMMENDED BY GOOGLE. An object used (but not consumed) when performing instructions or a direction."
msgstr "RECOMMANDE PAR GOOGLE. Objet utilisé (mais non consommé) lors de l'exécution d'instructions ou d'une directive."

msgid "REQUIRED. The type of page."
msgstr "Obligatoire. Type de page."

msgid "The URL of the how-to."
msgstr "URL du mode de fonctionnement."

