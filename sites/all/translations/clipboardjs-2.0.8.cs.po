msgid "Download and install clipboard.js library."
msgstr "Stáhněte a nainstalujte knihovnu clipboard.js."

msgid "Skip installation of @name to @path."
msgstr "Přeskočte instalaci produktu @name na @path."

msgid "Unable to download @url."
msgstr "Nelze stáhnout @url."

msgid "The @name library has been downloaded to @path."
msgstr "Knihovna @name byla stažena do @path."

msgid "Unable to move @name library to @path."
msgstr "Nelze přesunout knihovnu @name do @path."

msgid "About"
msgstr "Popis"

msgid "Clipboard.js"
msgstr "Clipboard.js"

msgid "Click to copy"
msgstr "Klepnutím zkopírujete"

msgid "Copied!"
msgstr "Zkopírováno!"

msgid "A modern approach to copy text to clipboard."
msgstr "Moderní přístup ke kopírování textu do schránky."

msgid "Content display"
msgstr "Zobrazení obsahu"

msgid "Clipboard.js formatter settings"
msgstr "Nastavení formátovače Clipboard.js"

msgid "Label"
msgstr "Popisek"

msgid "Alert style"
msgstr "Styl výstrahy"

msgid "Alert text"
msgstr "Text výstrahy"

msgid "Clipboard.js Button formatter settings"
msgstr "Nastavení formátovače tlačítka Clipboard.js"

msgid "Clipboard.js Snippet formatter settings"
msgstr "Nastavení formátovače úseku kódu Clipboard.js"

msgid "Clipboard.js Textarea formatter settings"
msgstr "Nastavení formátovače textové oblasti Clipboard.js"

msgid "Clipboard.js Textfield formatter settings"
msgstr "Nastavení formátovače textového pole Clipboard.js"

msgid "Copied."
msgstr "Zkopírováno."

msgid "This device does not support HTML5 Clipboard Copying. Please copy manually."
msgstr "Toto zařízení nepodporuje kopírování schránky HTML5. Zkopírujte ji ručně."

msgid "Press ⌘-@key to @action"
msgstr "Stiskněte kombinaci kláves ⌘-@key pro @action"

msgid "Press Ctrl-@key to @action"
msgstr "Stiskněte kombinaci kláves Ctrl-@key pro @action."

msgid "The URL !url could not be downloaded."
msgstr "Adresu URL  !url nelze stáhnout."

msgid "Downloading library..."
msgstr "Stahování knihovny..."

msgid "Clipboard"
msgstr "Schránka"

msgid "The label on the button or hovertip."
msgstr "Popisek na tlačítku nebo nápovědné bublině."

msgid "The alert style e.g. <em>Tooltip</em>, <em>Alert</em> or <em>None</em>."
msgstr "Styl výstrahy, například <em>Popis</em>, <em>Výstraha</em> nebo <em>Žádná</em>."

msgid "The alert text, shown as tooltip or alert."
msgstr "Text výstrahy zobrazený jako popis nebo výstraha."

msgid "Label: @label"
msgstr "Popisek: @label"

msgid "Alert style: @alert_style"
msgstr "Styl výstrahy: @alert_style"

msgid "Alert text: @alert_text"
msgstr "Text výstrahy: @alert_text"

msgid "Clipboard.js Button"
msgstr "Tlačítko Clipboard.js"

msgid "Clipboard.js Snippet"
msgstr "Snippet Clipboard.js"

msgid "Clipboard.js Textarea"
msgstr "Textová oblast Clipboard.js"

msgid "Clipboard.js Textfield"
msgstr "Textové pole Clipboard.js"

