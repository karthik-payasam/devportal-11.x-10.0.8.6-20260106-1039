msgid "Password Characters of Type Policy"
msgstr "Znaki hasła dla strategii typu"

msgid "Minimum characters of a particular type the password must contain."
msgstr "Minimalna liczba znaków określonego typu w haśle."

msgid "Security"
msgstr "Zabezpieczenia"

msgid "Number of characters"
msgstr "Liczba znaków"

msgid "Character type"
msgstr "Typ znaku"

msgid "Uppercase"
msgstr "Wielkie litery"

msgid "Lowercase"
msgstr "Małe litery"

msgid "Letter"
msgstr "Litera"

msgid "Numeric"
msgstr "Liczbowe"

msgid "Special Character"
msgstr "Znak specjalny"

msgid "The number of characters must be a positive number."
msgstr "Liczba znaków musi być liczbą dodatnią."

msgid "Password must contain at least 1 uppercase character."
msgid_plural "Password must contain at least @count unique uppercase characters."
msgstr[0] "Hasło musi zawierać przynajmniej jedną wielką literę."
msgstr[1] "Hasło musi zawierać przynajmniej następującą liczbę niepowtarzalnych wielkich liter: @count."
msgstr[2] "Hasło musi zawierać przynajmniej następującą liczbę niepowtarzalnych wielkich liter: @count."

msgid "Password must contain at least 1 lowercase character."
msgid_plural "Password must contain at least @count unique lowercase characters."
msgstr[0] "Hasło musi zawierać przynajmniej jedną małą literę."
msgstr[1] "Hasło musi zawierać przynajmniej następującą liczbę niepowtarzalnych małych liter: @count."
msgstr[2] "Hasło musi zawierać przynajmniej następującą liczbę niepowtarzalnych małych liter: @count."

msgid "Password must contain at least 1 letter character."
msgid_plural "Password must contain at least @count unique letter characters."
msgstr[0] "Hasło musi zawierać przynajmniej jedną literę."
msgstr[1] "Hasło musi zawierać przynajmniej następującą liczbę niepowtarzalnych liter: @count."
msgstr[2] "Hasło musi zawierać przynajmniej następującą liczbę niepowtarzalnych liter: @count."

msgid "Password must contain at least 1 special character."
msgid_plural "Password must contain at least @count unique special characters."
msgstr[0] "Hasło musi zawierać przynajmniej jeden znak specjalny."
msgstr[1] "Hasło musi zawierać przynajmniej następującą liczbę niepowtarzalnych znaków specjalnych: @count."
msgstr[2] "Hasło musi zawierać przynajmniej następującą liczbę niepowtarzalnych znaków specjalnych: @count."

msgid "Password must contain at least 1 numeric character."
msgid_plural "Password must contain at least @count unique numeric characters."
msgstr[0] "Hasło musi zawierać przynajmniej jedną cyfrę."
msgstr[1] "Hasło musi zawierać przynajmniej następującą liczbę niepowtarzalnych cyfr: @count."
msgstr[2] "Hasło musi zawierać przynajmniej następującą liczbę niepowtarzalnych cyfr: @count."

msgid "Password character type"
msgstr "Typ znaku hasła"

msgid "Verifying that a password has a specific number of characters"
msgstr "Sprawdzanie, czy hasło zawiera określoną liczbę znaków"

msgid "The password does not contain a the correct number of certain characters."
msgstr "Hasło nie zawiera poprawnej liczby niektórych znaków."

