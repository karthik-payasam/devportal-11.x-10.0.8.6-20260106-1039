msgid "About"
msgstr "Popis"

msgid "Drupal Proxy Module"
msgstr "Moduly proxy Drupal "

msgid "Drupal Proxy"
msgstr "Proxy Drupal "

msgid "Proxy"
msgstr "Proxy"

msgid "Proxy Settings"
msgstr "Nastavení proxy"

msgid "ProxySettingForm"
msgstr "ProxySettingForm"

msgid "Https or Https"
msgstr "Https nebo Https"

msgid "type of Scheme"
msgstr "typ schématu"

msgid "Proxy Server"
msgstr "Server proxy"

msgid "The IP address or hostname of the proxy server."
msgstr "Adresa IP nebo názvu hostitele serveru proxy."

msgid "Port"
msgstr "Port"

msgid "The port number used by the proxy server for client connections."
msgstr "Číslo portu použité serverem proxy pro připojení klienta."

msgid "Proxy Username"
msgstr "Jméno uživatele serveru proxy "

msgid "A username used of proxy server for Authentication."
msgstr "Jméno uživatele použité pro server proxy pro ověření."

msgid "Proxy Password"
msgstr "Heslo pro server proxy"

msgid "Password of proxy server used for Authentication."
msgstr "Heslo serveru proxy použité pro ověření."

msgid "Proxy User Agent"
msgstr "Agent uživatele serveru proxy "

msgid "A string which can be used by the proxy server to identify connection requests."
msgstr "Řetězec, který může server proxy použít k identifikaci požadavků na připojení."

msgid "Proxy Exceptions"
msgstr "Výjimky serveru proxy"

msgid "Specify exceptions using either IP addresses or hostnames. Enter one exception per line. Exceptions will be accessed directly, not via proxy."
msgstr "Zadejte výjimky buď prostřednictvím adres IP, nebo názvů hostitelů. Na každý řádek zadejte jednu výjimku. K výjimkám se bude přistupovat přímo, nikoli přes server proxy."

