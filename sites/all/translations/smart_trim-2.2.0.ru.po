msgid "About"
msgstr "Информация"

msgid "Smart Trim implements a new field formatter for text fields (text, text_long, and text_with_summary, if you want to get technical) that improves upon the \"Summary or Trimmed\" formatter."
msgstr "Модуль Smart Trim реализует новую функцию форматирования текстовых полей (text, text_long и text_with_summary), усовершенствующую функцию форматирования \"Краткое описание или с отсечением\"."

msgid "More"
msgstr "Ещё"

msgid "Smart Trim"
msgstr "Smart Trim"

msgid "Provides a more robust alternative to \"summary or trimmed\" textfield format"
msgstr "Предоставляет более функциональную альтернативу формату текстовых полей \"Краткое описание или с отсечением\""

msgid "Fields"
msgstr "Поля"

msgid "Smart trim formatter settings"
msgstr "Параметры средства форматирования Smart trim"

msgid "Trim length"
msgstr "Длина обрезания"

msgid "Trim units"
msgstr "Единицы измерения отсекаемой части"

msgid "Suffix"
msgstr "Суффикс"

msgid "Wrap trimmed content"
msgstr "Заключить отсеченное содержимое в теги"

msgid "Wrapped content class"
msgstr "Класс отсеченного содержимого"

msgid "Display more link"
msgstr "Показать ссылку Дополнительно"

msgid "Open link in new window"
msgstr "Открывать ссылку в новом окне"

msgid "More link class"
msgstr "Класс ссылки Дополнительно"

msgid "More link text"
msgstr "Текст ссылки \"Ещё\""

msgid "Summary handler"
msgstr "Обработчик краткого описания"

msgid "Additional options"
msgstr "Дополнительные опции"

msgid "Strip HTML"
msgstr "Удалить HTML"

msgid "Honor a zero trim length"
msgstr "Разрешить длину отсечения, равную 0"

msgid "Characters"
msgstr "Символы"

msgid "Words"
msgstr "Слова"

msgid "Summary"
msgstr "Сводка"

msgid "Use summary if present, and do not trim"
msgstr "Использовать краткое описание (при наличии) и не усекать"

msgid "Use summary if present, honor trim settings"
msgstr "При наличии используйте краткое описание с учетом параметров отсечения"

msgid "Do not use summary"
msgstr "Не использовать краткое описание"

msgid "Wrap trimmed content?"
msgstr "Заключить отсеченное содержимое в теги?"

msgid "Wrapped content class."
msgstr "Класс отсеченного содержимого."

msgid "If wrapping, define the class name here."
msgstr "Если используется оболочка, определите здесь имя класса."

msgid "Displays a link to the entity (if one exists)"
msgstr "Отображает ссылку на сущность (при ее наличии)"

msgid "words"
msgstr "слова"

msgid "characters"
msgstr "символов"

msgid "Smart trimmed"
msgstr "Усечено с помощью Smart trim"

