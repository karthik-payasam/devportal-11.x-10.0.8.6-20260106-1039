msgid "Batch"
msgstr "Batch"

msgid "Exports under one request. Best fit for small exports."
msgstr "Exporta em uma solicitação. Mais adequado para pequenas exportações."

msgid "Exports data in sequences. Should be used when large amount of data is exported (> 2000 rows)."
msgstr "Exporta dados em sequências. Deve ser usado quando uma grande quantia de dados é exportada (> 2000 linhas)."

msgid "The number of rows to process under a request."
msgstr "O número de linhas a ser processadas em uma solicitação."

msgid "The maximum amount of rows to export. 0 means unlimited."
msgstr "A quantia máxima de linhas a exportar. 0 significa ilimitado."

msgid "File Storage/Download Settings"
msgstr "Armazenamento de arquivos/Configurações de download"

msgid "Filename"
msgstr "Nome do arquivo"

msgid "The filename that will be suggested to the browser for downloading purposes. You may include replacement patterns from the list below."
msgstr "O nome do arquivo que será sugerido para o navegador para fins de download. É possível incluir padrões de substituição a partir da lista abaixo."

msgid "Store file in public files directory"
msgstr "Armazenar o arquivo em diretório de arquivos públicos"

msgid "Check this if you want to store the export files in the public:// files directory instead of the private:// files directory."
msgstr "Marque se você desejar armazenar os arquivos de exportação no diretório de arquivos public://, em vez de no diretório de arquivos private://."

msgid "<strong>The private:// file system is not configured so the exported files will be stored in the public:// files directory. Click <a href=\"@link\" target=\"_blank\">here</a> for instructions on configuring the private files in the settings.php file.</strong>"
msgstr "<strong>O sistema de arquivos private:// não está configurado, portanto, os arquivos exportados serão armazenados no diretório de arquivos public://. Clique em <a href=\"@link\" target=\"_blank\">aqui</a> para obter instruções sobre como configurar os arquivos privados no arquivo settings.php.</strong>"

msgid "Check this if you want to download the file immediately after it is created. Does <strong>NOT</strong> work for JSON data exports."
msgstr "Marque se você desejar fazer download do arquivo imediatamente após a criação dele. <strong>NÃO</strong> funciona para exportações de dados JSON."

msgid "Check this if you want to configure a custom redirect path."
msgstr "Marque isso se você desejar configurar um caminho de redirecionamento customizado."

msgid "Select the display to redirect to after batch finishes. If None is selected the user will be redirected to the front page."
msgstr "Selecione a exibição para a qual redirecionar após a conclusão do lote. Se Nenhum for selecionado, o usuário será redirecionado para a primeira página."

msgid "Enter custom path to redirect user after batch finishes."
msgstr "Insira o caminho customizado para redirecionar o usuário após a conclusão do lote."

msgid "Check this if you want to include query string parameters on redirect."
msgstr "Marque isso se você desejar incluir parâmetros de sequência de consultas no redirecionamento."

msgid "Displays"
msgstr "Exibições"

msgid "The data export icon will be available only to the selected displays."
msgstr "O ícone de exportação de dados estará disponível apenas para as exibições selecionadas."

msgid "Choose the facet source used to alter data export. This should be the display that this data export is attached to."
msgstr "Escolha a origem de máscara usada para alterar a exportação de dados. Essa deve ser a exibição à qual essa exportação de dados está anexada."

msgid "Could not write to temporary output file for result export (@file). Check permissions."
msgstr "Não foi possível gravar no arquivo de saída temporário para exportação de resultado (@file). Verifique as permissões."

msgid "Export complete. Download the file <a download href=\":download_url\"  data-download-enabled=\"false\" id=\"vde-automatic-download\">here</a>."
msgstr "Exportação concluída. Faça download do arquivo <a download href=\":download_url\"  data-download-enabled=\"false\" id=\"vde-automatic-download\">aqui</a>."

msgid "Export complete. Download the file <a download href=\":download_url\" data-download-enabled=\"true\" id=\"vde-automatic-download\">here</a> if file is not automatically downloaded."
msgstr "Exportação concluída. Faça download do arquivo <a download href=\":download_url\" data-download-enabled=\"true\" id=\"vde-automatic-download\">aqui</a> se o arquivo não for transferido por download automaticamente."

msgid "Export failed. Make sure the private file system is configured and check the error log."
msgstr "Falha na exportação. Certifique-se de que o sistema de arquivos privado esteja configurado e verifique o log de erro."

msgid "Data export"
msgstr "Exportação de dados"

msgid "Export the view results to a file. Can handle very large result sets."
msgstr "Exportar os resultados da visualização para um arquivo. É possível manipular conjuntos de resultados muito grandes."

msgid "Indicates the character used to delimit fields. Defaults to a comma (<code>,</code>). For tab-separation use <code>\\t</code> characters."
msgstr "Indica o caractere utilizado para delimitar os campos. Padronizado para uma vírgula (<code>,</code>). Use caracteres <code>\\t</code> para separação por tabulação."

msgid "Indicates the character used for field enclosure. Defaults to a double quote (<code>\"</code>)."
msgstr "Indica o caractere usado para o gabinete de campo. Padronizado para aspas duplas (<code>\"</code>)."

msgid "Indicates the character used for escaping. Defaults to a backslash (<code>\\</code>)."
msgstr "Indica o caractere usado para escapar. Padronizado para uma barra invertida (<code>\\</code>)."

msgid "Strips HTML tags from CSV cell values."
msgstr "Remove tags HTML de valores de célula CSV."

msgid "Trims whitespace from beginning and end of CSV cell values."
msgstr "Remove espaço em branco do início e do final de valores de célula CSV."

msgid "Determines the encoding used for CSV cell values."
msgstr "Determina a codificação usada para os valores de célula CSV."

msgid "UTF-8"
msgstr "utf-8"

msgid "Include unicode signature (<a href=\"@bom\" target=\"_blank\">BOM</a>)."
msgstr "Incluir assinatura do Unicode (<a href=\"@bom\" target=\"_blank\">BOM</a>)."

msgid "Only use Symfony serializer->encode method"
msgstr "Usar somente o serializador Symfony -> método de codificação"

msgid "Skips the symfony data normalize method when rendering data export to increase performance on large datasets. <strong>(Only use when not exporting nested data)</strong>"
msgstr "Ignore o método de normalização de dados do Symfony ao renderizar a exportação de dados para aumentar o desempenho em conjuntos de dados grandes. <strong>(Use somente quando não estiver exportando dados aninhados)</strong>"

msgid "Configurable row output for data exports."
msgstr "Saída de linha configurável para exportações de dados."

msgid "Download @format"
msgstr "Fazer download do @format"

