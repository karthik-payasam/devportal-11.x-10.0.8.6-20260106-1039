msgid "Schema.org: Article"
msgstr "Schema.org: artigo"

msgid "Comma separated list of what the article is about, for instance taxonomy terms or categories."
msgstr "Lista separada por vírgula dos assuntos do artigo, por exemplo, termos ou categorias de taxonomia."

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "A classificação geral do item, com base em uma coleção de revisões ou classificações."

msgid "REQUIRED BY GOOGLE. Author of the article."
msgstr "REQUERIDO POR GOOGLE. Autor do artigo."

msgid "RECOMMENDED BY GOOGLE. Date the article was last modified."
msgstr "RECOMENDADO POR Google. Data do artigo foi modificado pela última vez."

msgid "REQUIRED BY GOOGLE. Date the article was published."
msgstr "REQUERIDO POR GOOGLE. Data do artigo foi publicado."

msgid "RECOMMENDED BY GOOGLE. A description of the item."
msgstr "RECOMENDADO POR Google. Uma descrição do item."

msgid "REQUIRED BY GOOGLE. Headline of the article."
msgstr "REQUERIDO POR GOOGLE. Título do artigo."

msgid "Globally unique id of the article, usually a url."
msgstr "ID globalmente exclusivo do artigo, geralmente uma URL."

msgid "REQUIRED BY GOOGLE. The primary image for this item."
msgstr "REQUERIDO POR GOOGLE. A imagem principal para este item."

msgid "RECOMMENDED BY GOOGLE. The canonical URL of the article page. Specify mainEntityOfPage when the article is the primary topic of the article page."
msgstr "RECOMENDADO POR Google. A URL canônica da página do artigo. Especifique mainEntityOfPage quando o artigo é o tópico primário da página do artigo."

msgid "Name (usually the headline of the article)."
msgstr "Nome (geralmente o título do artigo)."

msgid "REQUIRED BY GOOGLE. Publisher of the article."
msgstr "REQUERIDO POR GOOGLE. Publicador do artigo."

msgid "Reviews of this item."
msgstr "Revisões deste item."

msgid "Speakable property."
msgstr "Propriedade descritível."

msgid "REQUIRED. The type of article."
msgstr "REQUIRED. O tipo de artigo."

