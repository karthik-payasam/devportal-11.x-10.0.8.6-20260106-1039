msgid "VotingAPI tokens"
msgstr "Jetons VotingAPI"

msgid "Dynamic Tokens for VotingAPI."
msgstr "Jetons dynamiques pour VotingAPI."

msgid "Vote count"
msgstr "Nombre de votes"

msgid "Number of votes."
msgstr "Décompte des votes."

msgid "Average Result"
msgstr "Moyenne des votes"

msgid "Average result of votes."
msgstr "Résultats moyens des votes."

msgid "Best Vote"
msgstr "Meilleur vote"

msgid "Best Vote cast."
msgstr "Meilleur vote exprimé."

msgid "Worst Vote"
msgstr "Plus mauvais vote"

msgid "Worst Vote cast."
msgstr "Pire vote exprimé."

msgid "About"
msgstr "A propos de"

msgid "This module enables tokens for all entity types that has <kbd>voting_api_field</kbd>."
msgstr "Ce module active les jetons pour tous les types d'entité ayant un champ <kbd>voting_api_field</kbd>."

msgid "Usage"
msgstr "Utilisation"

msgid "Tokens are dynamic and you have to pass <emph>vote_type</emph> as the last parameter. Module defines four tokens:"
msgstr "Les jetons sont dynamiques et vous devez transmettre le <emph>vote_type</emph> comme dernier paramètre. Le module définit quatre jetons :"

msgid "<ul><li>Vote count :: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"
msgstr "<ul><li>Nombre de votes :: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"

msgid "<li>Vote average :: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"
msgstr "<li>Moyenne des votes :: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"

msgid "<li>Best vote :: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"
msgstr "<li>Meilleur vote :: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"

msgid "<li>Worst vote :: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"
msgstr "<li>Plus mauvais vote :: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"

msgid "Voting API Tokens"
msgstr "Tokens d'API de vote"

msgid "Token support for Voting API"
msgstr "Prise en charge des jetons pour l'API de vote"

msgid "Voting"
msgstr "Vote"

