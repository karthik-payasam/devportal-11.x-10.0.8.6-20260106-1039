msgid "Finished @num elements and @num_translations translations created successfully."
msgstr "@num elements zijn voltooid en @num_translations zijn gemaakt."

msgid "Finished @num elements created successfully."
msgstr "Voltooid: @num-elementen gemaakt."

msgid "Finished with an error."
msgstr "Beëindigd met een fout."

msgid "Generate @label"
msgstr "@label genereren"

msgid "Generate"
msgstr "Genereren"

msgid "Generate realistic items (content, users, menus, etc) to assist your site development and testing."
msgstr "Realistische items (content, gebruikers, menu's, etc) genereren ter ondersteuning van de ontwikkeling en het testen van uw site."

msgid "Devel generate"
msgstr "Devel genereren"

msgid "Devel Generate"
msgstr "Devel genereren"

msgid "Generate test users, nodes, menus, taxonomy terms..."
msgstr "Test-gebruikers, knooppunten, menu's, taxonomie-termen genereren ..."

msgid "Development"
msgstr "Ontwikkeling"

msgid "Administer devel_generate"
msgstr "devel_generate beheren"

msgid "Language"
msgstr "Taal"

msgid "Select the primary language(s) for @items"
msgstr "Selecteer de primaire taal/talen voor @items"

msgid "Disabled - requires Language module"
msgstr "Uitgeschakeld - module Language vereist"

msgid "Select the language(s) for translated @items"
msgstr "Selecteer de taal/talen voor vertaalde @items"

msgid "Translated @items will be created for each language selected."
msgstr "Vertaalde @items wordt gemaakt voor elke geselecteerde taal."

msgid "Disabled - requires Content Translation module."
msgstr "Uitgeschakeld - module Content Translation vereist"

msgid "@permission"
msgstr "@permission"

msgid "Failed to generate elements due to \"%error\"."
msgstr "Genereren van elementen als gevolg van \"%error\" is mislukt."

msgid "You do not have any content types that can be generated. <a href=\":create-type\">Go create a new content type</a>"
msgstr "U hebt geen contenttypen die kunnen worden gegenereerd. <a href=\":create-type\">Nieuw contenttype maken</a>"

msgid "Hidden"
msgstr "Verborgen"

msgid "Closed"
msgstr "Gesloten"

msgid "Open"
msgstr "Openen"

msgid "No comment fields"
msgstr "Geen velden voor reacties"

msgid "Content type"
msgstr "Contenttype"

msgid "Comments"
msgstr "Commentaar"

msgid "<strong>Delete all content</strong> in these content types before generating new content."
msgstr "<strong>Verwijder alle content</strong> in deze contenttypen voordat nieuwe content wordt gegenereerd."

msgid "How many nodes would you like to generate?"
msgstr "Hoeveel knooppunten wilt u genereren?"

msgid "Now"
msgstr "Nu"

msgid "ago"
msgstr "geleden"

msgid "How far back in time should the nodes be dated?"
msgstr "Hoever terug in de tijd dienen de knooppunten gedateerd te zijn?"

msgid "Node creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "De aanmaakdatums van knooppunten worden willekeurig gedistribueerd vanaf het huidige tijdstip, terug naar het geselecteerde tijdstip."

msgid "Maximum number of comments per node."
msgstr "Maximumaantal reacties per knooppunt."

msgid "You must also enable comments for the content types you are generating. Note that some nodes will randomly receive zero comments. Some will receive the max."
msgstr "U moet ook reacties inschakelen voor de contenttypen die u genereert. Houd er rekening mee dat sommige knooppunten een willekeurig aantal van nul reacties ontvangen. Sommige knooppunten ontvangen het maximumaantal."

msgid "Maximum number of words in titles"
msgstr "Maximumaantal woorden in titels"

msgid "Fields to leave empty"
msgstr "Lege velden om leeg te laten"

msgid "Enter the field names as a comma-separated list. These will be skipped and have a default value in the generated content."
msgstr "Geef de veldnamen op als een door komma's gescheiden lijst. Deze worden overgeslagen en hebben een standaardwaarde in de gegenereerde content."

msgid "Base fields to populate"
msgstr "Basisvelden om te vullen"

msgid "Enter the field names as a comma-separated list. These will be populated."
msgstr "Geef de veldnamen op als een door komma's gescheiden lijst. Deze worden gevuld."

msgid "Prefix the title with the content type label."
msgstr "Label van het contenttype als voorvoegsel aan titel toevoegen."

msgid "This will not count against the maximum number of title words specified above."
msgstr "Dit wordt niet meegeteld bij het maximum aantal woorden in de titel dat hierboven is opgegeven."

msgid "Requires path.module"
msgstr "Path-module vereist."

msgid "Add an url alias for each node."
msgstr "Voeg een URL-alias voor elk knooppunt toe."

msgid "Add statistics for each node (node_counter table)."
msgstr "Statistieken voor elk knooppunt toevoegen (node_counter-tabel)."

msgid "User ID"
msgstr "Gebruikers-ID"

msgid "Name"
msgstr "Naam"

msgid "Role(s)"
msgstr "Rol(len)"

msgid "Users"
msgstr "Gebruikers"

msgid "Select users for randomly assigning as authors of the generated content. Leave all unchecked to use a random selection of up to 50 users."
msgstr "Selecteer gebruikers om willekeurig toe te wijzen als auteurs van de gegenereerde content. Laat alles  gedeselecteerd om een willekeurige selectie van maximaal 50 gebruikers te gebruiken."

msgid "Please select at least one content type"
msgstr "Selecteer minimaal één contenttype."

msgid "Generating Content"
msgstr "Content genereren"

msgid "Deleted %count nodes."
msgstr "%count knooppunten verwijderd."

msgid "Completed @feedback nodes (@rate nodes/min)"
msgstr "Voltooide @feedback-knooppunten (@rate knooppunten/min)"

msgid "No content types available"
msgstr "Er zijn geen contenttypen aanwezig"

msgid "To delete content, please provide the content types (--bundles)"
msgstr "Om content te wissen, moet u de contenttypen opgeven (-- bundles)"

msgid "One or more content types have been entered that don't exist on this site"
msgstr "Er zijn een of meer contenttypen opgegeven die niet voorkomen op deze site"

msgid "Created 1 node"
msgid_plural "Created @count nodes"
msgstr[0] "1 knooppunt gemaakt"
msgstr[1] "@count knooppunten gemaakt"

msgid "Created 1 node translation"
msgid_plural "Created @count node translations"
msgstr[0] "1 knooppuntvertaling gemaakt"
msgstr[1] "Vertalingen van @count knooppunten gemaakt"

msgid "content"
msgstr "content"

msgid "Generate a given number of content. Optionally delete current content."
msgstr "Genereer een aantal contentitems. Verwijder desgewenst ook de bestaande content."

msgid "You do not have any media types that can be generated. <a href=\":url\">Go create a new media type</a>"
msgstr "U hebt geen mediatypen die kunnen worden gegenereerd. <a href=\":url\">Een nieuw type media maken</a>"

msgid "Media type"
msgstr "Opslagmediumtype"

msgid "<strong>Delete all media</strong> in these types before generating new media."
msgstr "<strong>Verwijder alle media</strong> in deze typen voordat u nieuwe media genereert."

msgid "How many media items would you like to generate?"
msgstr "Hoeveel media-items wilt u genereren?"

msgid "How far back in time should the media be dated?"
msgstr "Hoe ver terug in de tijd moet de media worden gedateerd?"

msgid "Media creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "De datums voor het maken van media worden willekeurig verdeeld vanaf de huidige tijd, tot aan de geselecteerde tijd."

msgid "Maximum number of words in names"
msgstr "Maximum aantal woorden in namen"

msgid "Set language on media"
msgstr "Taal instellen voor media"

msgid "Requires locale.module"
msgstr "Locale-module vereist"

msgid "Please select at least one media type"
msgstr "Selecteer minimaal één mediatype"

msgid "Generating media items"
msgstr "Media-items genereren"

msgid "Deleted %count media items."
msgstr "%count media-items verwijderd."

msgid "Completed !feedback media items (!rate media/min)"
msgstr "!feedback media-items voltooid (!rate media/min)"

msgid "No media types available"
msgstr "Geen mediatypen beschikbaar"

msgid "1 media item created."
msgid_plural "Finished creating @count media items."
msgstr[0] "1 media-item gemaakt."
msgstr[1] "Maken van @count media-items is voltooid."

msgid "media"
msgstr "media"

msgid "Generate a given number of media entities."
msgstr "Een bepaald aantal media-entiteiten genereren."

msgid "Create new menu(s)"
msgstr "Nieuwe menu('s) maken"

msgid "Generate links for these menus"
msgstr "Links voor deze menu's genereren"

msgid "Number of new menus to create"
msgstr "Aantal nieuwe menu's om te genereren"

msgid "Number of links to generate"
msgstr "Aantal links om te genereren"

msgid "Maximum length for menu titles and menu links"
msgstr "Maximumlengte voor menutitels en menulinks"

msgid "Text will be generated at random lengths up to this value. Enter a number between 2 and 128."
msgstr "Tekst wordt met willekeurige lengte gegenereerd op basis van deze waarde. Voer een getal tussen 2 en 128 in."

msgid "Types of links to generate"
msgstr "Linktypen om te genereren"

msgid "Nodes"
msgstr "Knooppunten"

msgid "Front page"
msgstr "Voorpagina"

msgid "External"
msgstr "Extern"

msgid "Maximum link depth"
msgstr "Maximale linkdiepte"

msgid "Maximum menu width"
msgstr "Maximale menubreedte"

msgid "Limit the width of the generated menu's first level of links to a certain number of items."
msgstr "Beperk de breedte van het eerste niveau van links voor het gegenereerde menu tot een bepaald aantal items."

msgid "Delete existing custom generated menus and menu links before generating new ones."
msgstr "Verwijder bestaande aangepaste, gegenereerde menu's en menulinks voordat er nieuwe worden gegenereerd."

msgid "Deleted @menus_deleted menu(s) and @links_deleted other link(s)."
msgstr "@menus_deleted menu('s) en @links_deleted andere link(s) verwijderd."

msgid "Description of @name"
msgstr "Beschrijving van @name"

msgid "Description of @title."
msgstr "Beschrijving van @title."

msgid "Invalid number of menus"
msgstr "Ongeldig aantal menu's"

msgid "Invalid number of links"
msgstr "Ongeldig aantal links"

msgid "Invalid maximum link depth. Use a value between 1 and 9"
msgstr "Ongeldige maximumdiepte van link. Gebruik een waarde tussen 1 en 9."

msgid "Invalid maximum menu width. Use a positive numeric value."
msgstr "Ongeldige maximumbreedte van menu. Gebruik een positieve numerieke waarde."

msgid "Created the following 1 new menu: @menus"
msgid_plural "Created the following @count new menus: @menus"
msgstr[0] "Het volgende nieuwe menu is gemaakt: @menus"
msgstr[1] "De volgende @count nieuwe menu's zijn gemaakt: @menus"

msgid "Created 1 new menu link."
msgid_plural "Created @count new menu links."
msgstr[0] "Er is 1 nieuwe menulink gemaakt."
msgstr[1] "@count nieuwe menulinks gemaakt."

msgid "menus"
msgstr "menu's"

msgid "Generate a given number of menus and menu links. Optionally delete current menus."
msgstr "Genereer een bepaald aantal menu's en menulinks. Desgewenst kunt u de huidige menu's verwijderen."

msgid "Vocabularies"
msgstr "Vocabulaires"

msgid "Restrict terms to these vocabularies."
msgstr "Termen beperken tot deze vocabulaires."

msgid "Number of terms"
msgstr "Aantal termen"

msgid "Maximum number of characters in term names"
msgstr "Maximaal aantal tekens in term-namen"

msgid "Minimum depth for new terms in the vocabulary hierarchy"
msgstr "Minimumdiepte voor nieuwe termen in de vocabulairehiërarchie"

msgid "Enter a value from 1 to 20."
msgstr "Geef een waarde tussen 1 en 20 op."

msgid "Maximum depth for new terms in the vocabulary hierarchy"
msgstr "Maximale diepte voor nieuwe termen in de vocabulairehiërarchie"

msgid "Delete existing terms in specified vocabularies before generating new terms."
msgstr "Wis bestaande termen in de opgegeven vocabulaires voordat u nieuwe termen genereert."

msgid "In vocabulary @vlabel: @termlist"
msgstr "In vocabulaire @vlabel: @termlist"

msgid "In vocabulary @vlabel: No terms created"
msgstr "In vocabulaire @vlabel: Geen termen gemaakt"

msgid "Minimum depth changed from @min_depth to 1 because all terms were deleted"
msgstr "Minimale diepte is gewijzigd van @min_depth in 1 omdat alle termen zijn gewist"

msgid "Please provide a vocabulary machine name (--bundles)."
msgstr "Geef een machinenaam op voor de vocabulaire (--bundles)."

msgid "Invalid vocabulary machine name: @name"
msgstr "Ongeldige machinenaam van vocabulaire: @name"

msgid "Invalid number of terms: @num"
msgstr "Ongeldig aantal termen: @num"

msgid "The depth values must be in the range 1 to 20 and min-depth cannot be larger than max-depth (values given: min-depth @min, max-depth @max)"
msgstr "De dieptewaarden moeten tussen 1 en 20 liggen en min-depth kan niet groter zijn dan max-depth (opgegeven waarden: min-depth @min, max-depth @max)"

msgid "Created 1 new term"
msgid_plural "Created @count new terms"
msgstr[0] "1 nieuwe term gemaakt"
msgstr[1] "@count nieuwe termen gemaakt"

msgid "1 new term at level @level (@terms)"
msgid_plural "@count new terms at level @level (@terms)"
msgstr[0] "1 nieuwe term op niveau @level (@terms)"
msgstr[1] "@count nieuwe termen op niveau @level (@terms)"

msgid "Created 1 term translation"
msgid_plural "Created @count term translations"
msgstr[0] "Vertaling van 1 term gemaakt"
msgstr[1] "Vertalingen van @count termen gemaakt"

msgid "Deleted 1 existing term"
msgid_plural "Deleted @count existing terms"
msgstr[0] "1 bestaande term gewist"
msgstr[1] "@count bestaande termen gewist"

msgid "terms"
msgstr "termen"

msgid "Generate a given number of terms. Optionally delete current terms."
msgstr "Genereer een aantal termen. Verwijder desgewenst ook de bestaande termen."

msgid "How many users would you like to generate?"
msgstr "Hoeveel gebruikers wilt u genereren?"

msgid "Delete all users (except user id 1) before generating new users."
msgstr "Verwijder alle gebruikers (met uitzondering van gebruikers-ID 1) voordat er nieuwe gebruikers worden gegenereerd."

msgid "Which roles should the users receive?"
msgstr "Welke rollen moeten de gebruikers krijgen?"

msgid "Users always receive the <em>authenticated user</em> role."
msgstr "Gebruiker krijgt altijd de rol van <em>geverifieerde gebruiker</em>."

msgid "Password to be set"
msgstr "Wachtwoord moet worden ingesteld"

msgid "Leave this field empty if you do not need to set a password"
msgstr "Laat dit veld leeg als u geen wachtwoord hoeft in te stellen"

msgid "How old should user accounts be?"
msgstr "Hoe oud moeten de gebruikersaccounts zijn?"

msgid "User ages will be distributed randomly from the current time, back to the selected time."
msgstr "De ouderdom van gebruikersaccounts wordt willekeurig gedistribueerd vanaf het huidige tijdstip, terug naar het geselecteerde tijdstip."

msgid "@num_users created."
msgstr "@num_users gemaakt."

msgid "1 user deleted"
msgid_plural "@count users deleted."
msgstr[0] "1 gebruiker verwijderd"
msgstr[1] "@count gebruikers verwijderd"

msgid "1 user"
msgid_plural "@count users"
msgstr[0] "1 gebruiker"
msgstr[1] "@count gebruikers"

msgid "users"
msgstr "gebruikers"

msgid "Generate a given number of users. Optionally delete current users."
msgstr "Genereer een aantal gebruikers. Verwijder optioneel alle huidige gebruikers."

msgid "Number of vocabularies?"
msgstr "Aantal woordenlijsten?"

msgid "Maximum number of characters in vocabulary names"
msgstr "Maximaal aantal tekens in de woordenlijstnamen"

msgid "Delete existing vocabularies before generating new ones."
msgstr "Verwijder bestaande vocabulaires voordat er nieuwe worden gegenereerd."

msgid "Deleted existing vocabularies."
msgstr "Bestaande vocabulaires verwijderd."

msgid "Created the following new vocabularies: @vocs"
msgstr "Volgende nieuwe vocabulaires gemaakt: @vocs"

msgid "Invalid number of vocabularies: @num."
msgstr "Ongeldig aantal vocabulaires: @num"

msgid "vocabularies"
msgstr "vocabulaires"

msgid "Generate a given number of vocabularies. Optionally delete current vocabularies."
msgstr "Genereer een aantal vocabulaires. Verwijder desgewenst ook bestaande vocabulaires."

