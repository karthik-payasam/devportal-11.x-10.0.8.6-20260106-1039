msgid "About"
msgstr "关于"

msgid "The Security.txt module provides an implementation of the new <a href=\":site\">Security.txt standard</a> which is currently a <a href=\":rfc\">draft RFC</a>. The purpose is to allow people to easily get in touch to report security issues."
msgstr "Security.txt 模块实现了新的 <a href=\":site\">Security.txt 标准</a>，该标准目前是<a href=\":rfc\"> RFC 草案</a>。目的是便于用户取得联系以报告安全问题。"

msgid "Uses"
msgstr "使用"

msgid "Configuring and signing security.txt"
msgstr "配置和签署 security.txt"

msgid "The Security.txt module provides pages for <a href=\":configure\">configuring</a> and <a href=\":sign\">signing</a> a security.txt file. A user must have the <a href=\":permission\">'Administer security.txt' permission</a> to access these administration pages."
msgstr "Security.txt 模块提供了用于<a href=\":configure\">配置</a>和<a href=\":sign\">签署</a> security.txt 文件的页面。用户必须具有<a href=\":permission\">“管理 security.txt”权限</a>，才能访问这些管理页面。"

msgid "Viewing security.txt and security.txt.sig"
msgstr "查看 security.txt 和 security.txt.sig"

msgid "The Security.txt module, when correctly configured, provides the /.well-known/security.txt and /.well-known/security.txt.sig paths to users with the <a href=\":permission\">'View security.txt' permission</a>. <strong>You will almost certinaly want to grant this permission to both the Anonymous and Authenticated user roles.</strong>"
msgstr "在正确配置的情况下，Security.txt 模块向具有<a href=\":permission\">“查看 security.txt”权限</a>的用户提供 /.well-known/security.txt 和 /.well-known/security.txt.sig 路径。<strong>您几乎肯定会希望将此权限同时授予匿名用户角色和已认证的用户角色。</strong>"

msgid "A security.txt file provides a standard way for people to find out how to safely report security issues with your site. The new <a href=\":site\">Security.txt standard</a> is currently a <a href=\":rfc\">draft RFC</a>."
msgstr "Security.txt 文件为人们提供了一种标准方法，以了解如何安全地向您的站点报告安全问题。新的 <a href=\":site\">Security.txt 标准</a>当前是<a href=\":rfc\">草稿 RFC</a>。"

msgid "In order to ensure the authenticity of your security.txt file, you should provide a signature."
msgstr "为确保 security.txt 文件的真实性，您应提供签名。"

msgid "Security.txt"
msgstr "Security.txt"

msgid "Provides a security.txt file for your site."
msgstr "为站点提供 security.txt 文件。"

msgid "Security"
msgstr "安全"

msgid "Configure and sign the site security.txt file."
msgstr "配置并签署站点的 security.txt 文件。"

msgid "Configure"
msgstr "配置"

msgid "Sign"
msgstr "签名"

msgid "Administer security.txt"
msgstr "管理 security.txt"

msgid "Allows configuring and signing of the security.txt file."
msgstr "允许配置并签署 security.txt 文件。"

msgid "View security.txt"
msgstr "查看 security.txt"

msgid "Allows access to the security.txt and security.txt.sig files. You will almost certinaly want to grant this permission to both the Anonymous and Authenticated user roles."
msgstr "允许访问 security.txt 和 security.txt.sig 文件。您几乎肯定会希望将此权限同时授予匿名用户角色和已认证的用户角色。"

msgid "Security.txt configure"
msgstr "Security.txt 配置"

msgid "Security.txt sign"
msgstr "Security.txt 签名"

msgid "Security.txt settings"
msgstr "Security.txt 设置"

msgid "Enable security.txt"
msgstr "启用 security.txt"

msgid "Enable Signature"
msgstr "启用签名"

msgid "Contact email"
msgstr "联系邮件"

msgid "Contact phone"
msgstr "联系电话"

msgid "Contact page URL"
msgstr "联系页面 URL"

msgid "Public key URL"
msgstr "公用密钥 URL"

msgid "Expiry date"
msgstr "到期日期"

msgid "Security policy URL"
msgstr "安全策略 URL"

msgid "Acknowledgment page URL"
msgstr "确认页面 URL"

msgid "Plain text PGP signature of security.txt"
msgstr "Security.txt 的纯文本 PGP 签名"

msgid "Enable the security.txt file for your site"
msgstr "为站点启用 security.txt 文件"

msgid "When enabled the security.txt file will be accessible to all users with the \"view securitytxt\" permission, you will almost certinaly want to give this permission to everyone i.e. authenticated and anonymous users."
msgstr "启用后，具有“查看 security.txt”权限的所有用户都可以访问 security.txt 文件，您几乎肯定会希望将此权限授予所有人，即已认证的用户和匿名用户。"

msgid "Enable the security.txt.sig line"
msgstr "启用 security.txt.sig 行"

msgid "When enabled, the signature line will display in the security.txt file. Leave this disabled if you are not going to create a sig file."
msgstr "启用时，签名行将显示在 security.txt 文件中。 如果您不打算创建签名文件，请将此选项保留禁用状态。"

msgid "Contact"
msgstr "联络表"

msgid "You must provide at least one means of contact: email, phone or contact page URL."
msgstr "您至少应提供一种联系方式：电子邮件、电话或联系页面 URL。"

msgid "Email"
msgstr "电子邮件"

msgid "Typically this would be of the form <kbd>security@example.com</kbd>. Leave it blank if you do not want to provide an email address."
msgstr "通常，格式为 <kbd>security@example.com</kbd>。如果您不想提供电子邮件地址，请将其留空。"

msgid "Phone"
msgstr "电话"

msgid "Use full international format e.g. <kbd>+1-201-555-0123</kbd>. Leave it blank if you do not want to provide a phone number."
msgstr "使用完整的国际格式，例如：<kbd>+1-201-555-0123</kbd>。如果您不想提供电话号码，请将其留空。"

msgid "URL"
msgstr "网址"

msgid "The URL of a contact page which should be loaded over HTTPS. Leave it blank if you do not want to provide a contact page."
msgstr "应通过 HTTPS 加载的联系页面 URL。如果您不想提供联系页面，请将其留空。"

msgid "Encryption"
msgstr "加密"

msgid "Allow people to send you encrypted messages by providing your public key."
msgstr "允许用户通过提供公用密钥来发送加密消息。"

msgid "The URL of your public key file, or a page which contains your public key. This URL should use the HTTPS protocol."
msgstr "公用密钥文件的 URL，或包含公用密钥的页面。 此 URL 应使用 HTTPS 协议。"

msgid "Expires"
msgstr "到期"

msgid "An expiry date can help security researchers know if your security.txt file is still valid."
msgstr "到期日期可帮助安全研究人员了解 security.txt 文件是否仍然有效。"

msgid "Set an expiry date to show in your security.txt file."
msgstr "设置要在 security.txt 文件中显示的到期日期。"

msgid "Policy"
msgstr "策略"

msgid "A security and/or disclosure policy can help security researchers understand  how to work with you when reporting security vulnerabilities."
msgstr "安全性和/或披露策略可以帮助安全研究人员了解如何在报告安全漏洞时与您合作。"

msgid "The URL of a page which provides details of your security and/or disclosure policy. Leave it blank if you do not have such a page."
msgstr "提供安全性和/或披露策略详细信息的页面 URL。如果您没有此类页面，请将其留空。"

msgid "Acknowledgement"
msgstr "确认"

msgid "A security acknowldgements page should list the individuals or companies that have disclosed security vulnerabilities and worked with you to fix them."
msgstr "安全确认页面应列出已披露安全漏洞并与您合作修复这些漏洞的个人或公司。"

msgid "Acknowledgements page URL"
msgstr "确认页面 URL"

msgid "The URL of your security acknowledgements page. Leave it blank if you do not have such a page."
msgstr "安全确认页面的 URL。如果您没有此类页面，请将其留空。"

msgid "You must specify at least one method of contact."
msgstr "至少应指定一种联系方式。"

msgid "Your contact URL should really be loaded over HTTPS."
msgstr "实际上应通过 HTTPS 加载联系 URL。"

msgid "Your public key URL should really be loaded over HTTPS."
msgstr "实际上应通过 HTTPS 加载公用密钥 URL。"

msgid "You should now <a href=\":sign\">sign your security.txt file</a>."
msgstr "您现在应签署 <a href=\":sign\">security.txt 文件</a>。"

msgid "You must <a href=\":configure\">configure and enable</a> your security.txt file before you can sign it."
msgstr "您必须<a href=\":configure\">先配置并启用</a> security.txt 文件，然后才能进行签名。"

msgid "<a href=\":download\" download=\"security.txt\">Download</a> your security.txt file."
msgstr "<a href=\":download\" download=\"security.txt\">下载</a> security.txt 文件。"

msgid "Signature"
msgstr "签名"

