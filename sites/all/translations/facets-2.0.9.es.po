msgid "Date"
msgstr "Fecha"

msgid "Numeric query with set granularity"
msgstr "Consulta numérica con granularidad establecida"

msgid "Range"
msgstr "Rango"

msgid "String"
msgstr "Cadena de caracteres"

msgid "Query string"
msgstr "Cadena de consulta"

msgid "Query string is the default Facets URL processor, and uses GET parameters, for example ?f[0]=brand:drupal&f[1]=color:blue"
msgstr "La serie de consulta es el procesador de URL de Facetas predeterminado y utiliza parámetros GET, por ejemplo ?f[0]=brand:drupal&f[1]=color:blue"

msgid "Array with raw results"
msgstr "Matriz con resultados en bruto"

msgid "A widget that builds an array with results. This widget is not supposed to display any results, but it is needed for rest integration."
msgstr "Un widget que construye una matriz con resultados. Se supone que este widget no debe mostrar ningún resultado, pero es necesario para la integración de REST."

msgid "List of checkboxes"
msgstr "Lista de recuadros de selección"

msgid "A configurable widget that shows a list of checkboxes"
msgstr "Un widget configurable que muestra una lista de recuadros de selección"

msgid "To achieve the standard behavior of a dropdown, you need to enable the facet setting below <em>\"Ensure that only one result can be displayed\"</em>."
msgstr "Para conseguir el comportamiento estándar de un desplegable, debe habilitar el valor de faceta debajo de <em>\"Garantizar que solo se pueda visualizar un resultado\"</em>."

msgid "Dropdown"
msgstr "Desplegable"

msgid "A configurable widget that shows a dropdown."
msgstr "Un widget configurable que muestra un desplegable."

msgid "Show all"
msgstr "Mostrar todo"

msgid "Limit the number of displayed facets via JavaScript."
msgstr "Limitar el número de facetas visualizadas a través de JavaScript."

msgid "This text will be used for \"Show less\" link."
msgstr "Este texto se utilizará para el enlace \"Mostrar menos\"."

msgid "This text will be used for \"Show more\" link."
msgstr "Este texto se utilizará para el enlace \"Mostrar más\"."

msgid "Reset text"
msgstr "Restablecer texto"

msgid "List of links"
msgstr "Lista de enlaces"

msgid "A simple widget that shows a list of links"
msgstr "Un widget simple que muestra una lista de enlaces"

msgid "Pre query stage"
msgstr "Etapa previa a consulta"

msgid "Post query stage"
msgstr "Etapa posterior a consulta"

msgid "Sort stage"
msgstr "Etapa de clasificación"

msgid "Sort order"
msgstr "Método de ordenación"

msgid "Ascending"
msgstr "Ascendente"

msgid "Descending"
msgstr "Descendente"

msgid "Show the amount of results"
msgstr "Mostrar la cantidad de resultados"

