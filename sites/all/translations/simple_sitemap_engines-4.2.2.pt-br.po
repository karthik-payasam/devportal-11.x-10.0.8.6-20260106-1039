msgid "IndexNow notification"
msgstr "Notificação de IndexNow"

msgid "IndexNow notification checkbox"
msgstr "Caixa de seleção de notificação de IndexNow"

msgid "Simple XML Sitemap IndexNow"
msgstr "IndexNow do Simple XML Sitemap"

msgid "Verification key in Drupal State"
msgstr "Chave de verificação no estado Drupal"

msgid "Verification key not available"
msgstr "Chave de verificação não disponível"

msgid "In order to generate a verification key for the IndexNow service and choose which sitemaps are to be submitted to search engines, visit <a href=\"@url\">this</a> configuration page."
msgstr "Para gerar uma chave de verificação para o serviço IndexNow e escolher quais mapas do site devem ser enviados para mecanismos de procura, visite <a href=\"@url\">esta</a> página de configuração."

msgid "Simple XML Sitemap (Search engines)"
msgstr "Mapa do site XML simples (mecanismos de procura)"

msgid "Submits sitemaps to search engines and notifies IndexNow compatible engines about changes to entities."
msgstr "Envia mapas do site para mecanismos de procura e notifica mecanismos compatíveis com IndexNow sobre mudanças em entidades."

msgid "SEO"
msgstr "SEO"

msgid "Search engines"
msgstr "Mecanismos de Pesquisa"

msgid "Status"
msgstr "Status"

msgid "Settings"
msgstr "Configurações"

msgid "Index entity on save"
msgstr "Entidade de índice no salvamento"

msgid "Allows optionally sending a change notice to IndexNow compatible search engines on entity form save."
msgstr "Permite, opcionalmente, enviar um aviso de mudança para mecanismos de procura compatíveis com IndexNow no salvamento do formulário de entidade."

msgid "Simple XML Sitemap"
msgstr "Mapa do site XML simples"

msgid "Search engine"
msgstr "Mecanismo de procura"

msgid "Search engine ID"
msgstr "ID do mecanismo de procura"

msgid "Label"
msgstr "Rótulo"

msgid "Submission URL"
msgstr "URL de envio"

msgid "IndexNow URL"
msgstr "URL do IndexNow"

msgid "Sitemap variants"
msgstr "Variantes do mapa do site"

msgid "Sitemap variant"
msgstr "Variante do mapa do site"

msgid "IndexNow bundle settings"
msgstr "Configurações de pacote configurável do IndexNow"

msgid "IndexNow"
msgstr "IndexNow"

msgid "Sitemap search engine submission settings"
msgstr "Configurações de envio do mecanismo de procura do mapa do site"

msgid "Sitemap submission enabled"
msgstr "Envio do mapa do site ativado"

msgid "Sitemap submission frequency"
msgstr "Frequência de envio do mapa do site"

msgid "IndexNow submission enabled"
msgstr "Envio do IndexNow ativado"

msgid "Selected engine for IndexNow submissions"
msgstr "Mecanismo selecionado para envios do IndexNow"

msgid "IndexNow on entity save"
msgstr "IndexNow no salvamento de entidade"

msgid "Sitemap submission status"
msgstr "Status de envio do mapa do site"

msgid "Name"
msgstr "Nome"

msgid "Sitemaps"
msgstr "Mapas do site"

msgid "Last submitted"
msgstr "Último envio"

msgid "There are no @label yet."
msgstr "Não há nenhum @label ainda."

msgid "Submission settings can be configured <a href=\"@url\">here</a>."
msgstr "As configurações de envio podem ser configuradas <a href=\"@url\">aqui</a>."

msgid "Never"
msgstr "Nunca"

msgid "No search engines supporting sitemap submission have been found."
msgstr "Nenhum mecanismo de procura que suporte o envio do mapa do site foi localizado."

msgid "Sitemap submission is disabled."
msgstr "O envio do mapa do site está desativado."

msgid "IndexNow status"
msgstr "Status do IndexNow."

msgid "The last IndexNow submission was <em>@entity</em> to @engine_label on @time"
msgstr "O último envio do IndexNow foi <em>@entity</em> para @engine_label em @time"

msgid "IndexNow settings can be configured <a href=\"@url\">here</a>."
msgstr "As configurações do IndexNow podem ser definidas <a href=\"@url\">aqui</a>."

msgid "No search engines supporting IndexNow have been found."
msgstr "Nenhum mecanismo de procura que suporte o IndexNow foi localizado."

msgid "IndexNow submission is disabled."
msgstr "O envio do IndexNow está desativado."

msgid "Excluded"
msgstr "Excluded"

msgid "Sitemap submission settings"
msgstr "Configurações de envio do mapa do site"

msgid "Submit sitemaps to search engines"
msgstr "Enviar mapas do site para mecanismos de procura"

msgid "This enables/disables sitemap submission; don't forget to choose sitemaps below."
msgstr "Isso ativa/desativa o envio do mapa do site; não se esqueça de escolher os mapas do site abaixo."

msgid "Submission interval"
msgstr "Intervalo de envio"

msgid "Engines"
msgstr "Mecanismos"

msgid "Choose which sitemaps are to be submitted to which search engines.<br>Sitemaps can be configured <a href=\"@url\">here</a>."
msgstr "Escolha quais mapas do site devem ser enviados para quais mecanismos de procura.<br>Os mapas do site podem ser configurados <a href=\"@url\">aqui</a>."

msgid "IndexNow settings"
msgstr "Configurações do IndexNow"

msgid "Submit changes to IndexNow capable engines"
msgstr "Enviar mudanças para mecanismos com capacidade para o IndexNow"

msgid "Send change notice to IndexNow compatible search engines right after submitting entity forms. Changes include creating, deleting and updating of an entity.<br/>This behaviour can be overridden on entity forms. Don't forget to <a href=\"@inclusion_url\">include entities</a>."
msgstr "Envie um aviso de mudança para mecanismos de procura compatíveis com o IndexNow logo depois de enviar formulários de entidade. As mudanças incluem a criação, exclusão e atualização de uma entidade.<br/>Esse comportamento pode ser substituído em formulários de entidade. Não se esqueça de <a href=\"@inclusion_url\">incluir entidades</a>."

msgid "Preferred IndexNow engine"
msgstr "Mecanismo do IndexNow preferencial"

msgid "All IndexNow requests will be sent to the engine selected here. Only one engine needs to be notified, as it will notify other IndexNow compatible engines for you.<br/>For the sake of equality of opportunity, <strong>consider leaving this at <em>Random</em></strong>, so a random engine can be picked on each submission."
msgstr "Todas as solicitações do IndexNow serão enviadas ao mecanismo selecionado aqui. Somente um mecanismo precisa ser notificado, pois ele notificará outros mecanismos compatíveis com o IndexNow para você.<br/>Por causa da igualdade de oportunidade, <strong>considere deixar isso em <em>Aleatório</em></strong>, para que um mecanismo aleatório possa ser selecionado em cada envio."

msgid "Random"
msgstr "Aleatório"

msgid "Index on every entity save operation"
msgstr "Índice em cada operação de salvamento de entidade"

msgid "If checked, all entity save operations for <a href=\"@inclusion_url\">included entities</a> will trigger notification of IndexNow search engines.<br/>If unchecked, this will only be possible by adding/altering/deleting an entity through a form.<br/>This should be unchecked if there are mass operations performed on entities that are irrelevant to indexing."
msgstr "Se marcado, todas as operações de salvamento de entidade para <a href=\"@inclusion_url\">entidades incluídas</a> acionarão a notificação dos mecanismos de procura do IndexNow.<br/>Se desmarcado, isso só será possível incluindo/alterando/excluindo uma entidade por meio de um formulário.<br/>Isso deverá ser desmarcado se houver operações em massa executadas em entidades que são irrelevantes para a indexação."

msgid "Remove verification key from state"
msgstr "Remover chave de verificação do estado"

msgid "Generate verification key"
msgstr "Gerar chave de verificação"

msgid "The IndexNow verification key is saved in <em>settings.php</em>: @key"
msgstr "A chave de verificação do IndexNow é salva em <em>settings.php</em>: @key"

msgid "The IndexNow verification key is defined in <em>Drupal state</em>: @key"
msgstr "A chave de verificação do IndexNow é definida no <em>estado do Drupal</em>: @key"

msgid "The IndexNow verification key is saved in <em>Drupal state</em>. Consider defining it in <em>settings.php</em> like so:<br/>@code"
msgstr "A chave de verificação do IndexNow é salva no <em>estado do Drupal</em>. Considere defini-lo em <em>settings.php</em> assim: <br/>@code"

msgid "The IndexNow verification key is saved in <em>settings.php</em> and can be safely removed from <em>Drupal state</em>."
msgstr "A chave de verificação do IndexNow é salva em <em>settings.php</em> e pode ser removida com segurança do <em>estado do Drupal</em>."

msgid "An IndexNow verification key needs to be generated and optionally added to <em>settings.php</em> in order for IndexNow engines to get notified about changes. This warning only applies to the production environment."
msgstr "Uma chave de verificação do IndexNow precisa ser gerada e, opcionalmente, incluída em <em>settings.php</em> para que os mecanismos do IndexNow sejam notificados sobre mudanças. Este aviso aplica-se somente ao ambiente de produção."

msgid "No sitemaps have been selected for submission."
msgstr "Nenhum mapa do site foi selecionado para o envio."

msgid "Notify IndexNow search engines of changes <em>now</em>"
msgstr "Notificar os mecanismos de procura do IndexNow sobre as mudanças <em>agora</em>"

msgid "Send change notice to IndexNow compatible search engines right after submitting this form."
msgstr "Envie um aviso de mudança para mecanismos de procura compatíveis com o IndexNow logo depois de enviar este formulário."

msgid "Notify IndexNow search engines of changes <em>by default</em>"
msgstr "Notificar os mecanismos de procura do IndexNow sobre as mudanças <em>por padrão</em>"

msgid "Send change notice to IndexNow compatible search engines right after submitting entity forms of this type.<br/>Changes include creating, deleting and updating of an entity. This setting can be overridden on the entity form."
msgstr "Envie um aviso de mudança para os mecanismos de procura compatíveis com o IndexNow logo depois de enviar formulários de entidade desse tipo.<br/>As mudanças incluem criar, excluir e atualizar uma entidade. Essa configuração pode ser substituída no formulário de entidade."

msgid "Sitemap search engine submission"
msgstr "Envio do mecanismo de procura do mapa do site"

