msgid "File key provider settings updated."
msgstr "Se han actualizado los valores de proveedor de claves de archivo."

msgid "Key configuration overrides updated."
msgstr "Se han actualizado las alteraciones temporales de configuración de clave."

msgid "Key"
msgstr "Clave"

msgid "Provides the ability to manage site-wide keys."
msgstr "Proporciona la capacidad de gestionar claves de todo el sitio."

msgid "Security"
msgstr "Seguridad"

msgid "Add Key"
msgstr "Añadir clave"

msgid "Add Override"
msgstr "Añadir alteración temporal"

msgid "Keys"
msgstr "Claves"

msgid "Manage site-wide keys."
msgstr "Gestionar claves de todo el sitio."

msgid "Key Overrides"
msgstr "Alteraciones temporales de clave"

msgid "Administer keys"
msgstr "Administrar claves"

msgid "Create, edit, and delete site-wide keys."
msgstr "Crear, editar y suprimir claves de todo el sitio."

msgid "Administer key configuration overrides"
msgstr "Administrar alteraciones temporales de configuración de clave"

msgid "Add key"
msgstr "Añadir clave"

msgid "Edit key"
msgstr "Editar clave"

msgid "Delete Key"
msgstr "Suprimir clave"

msgid "Key Configuration Overrides"
msgstr "Alteraciones temporales de configuración de clave"

msgid "Add a key configuration override"
msgstr "Añadir una alteración temporal de configuración de clave"

msgid "Delete Key Configuration Override"
msgstr "Suprimir alteración temporal de configuración de clave"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "Etiqueta"

msgid "Description"
msgstr "Descripción"

msgid "Key type"
msgstr "Tipo de clave"

msgid "Key type settings"
msgstr "Valores de tipo de clave"

msgid "Key provider"
msgstr "Proveedor de claves"

msgid "Key provider settings"
msgstr "Valores de proveedor de claves"

msgid "Key input"
msgstr "Entrada de clave"

msgid "Key input settings"
msgstr "Valores de entrada de clave"

msgid "Encryption key type settings"
msgstr "Valores de tipo de clave de cifrado"

msgid "Key size"
msgstr "Tamaño de clave"

msgid "Configuration key provider settings"
msgstr "Valores de proveedor de claves de configuración"

msgid "Key value"
msgstr "Valor de clave"

msgid "Base64-encoded"
msgstr "Codificado en Base64"

msgid "File key provider settings"
msgstr "Valores de proveedor de claves de archivo"

msgid "File location"
msgstr "Ubicación de archivo"

msgid "Strip trailing line breaks"
msgstr "Eliminar saltos de línea finales"

msgid "Environment key provider settings"
msgstr "Configuración del proveedor de claves de entorno"

msgid "Environment variable"
msgstr "Variable de entorno"

msgid "Text field key input settings"
msgstr "Valores de entrada de clave de campo de texto"

msgid "Textarea field key input settings"
msgstr "Valores de entrada de clave de campo de área de texto"

msgid "Generate key input settings"
msgstr "Valores de entrada de Generar clave"

msgid "Generated"
msgstr "Generada"

msgid "Display once"
msgstr "Visualizar una vez"

msgid "Key Configuration Override"
msgstr "Alteración temporal de configuración de clave"

msgid "Configuration type"
msgstr "Tipo de configuración"

msgid "Configuration prefix"
msgstr "Prefijo de configuración"

msgid "Configuration name"
msgstr "Nombre de la configuración"

msgid "Configuration item"
msgstr "Elemento de configuración"

msgid "Key ID"
msgstr "ID de clave"

msgid "Commands for managing keys"
msgstr "Mandos para gestionar claves"

msgid "Save a key. If a key value is defined and the key provider supports setting values, it will be saved. If any options are omitted, default values will be used."
msgstr "Guardar una clave. Si hay un valor de clave definido y el proveedor de claves admite el establecimiento de valores, el valor se guardará. Si se omiten opciones, se utilizarán los valores predeterminados."

msgid "Save a key."
msgstr "Guardar una clave."

msgid "The ID (machine name) of the key to save."
msgstr "El ID (nombre de máquina) de la clave a guardar."

msgid "A key value to save. May or may not be allowed or required, depending on the key provider"
msgstr "Un valor de clave a guardar. Puede o no estar permitido o ser necesario, según el proveedor de claves"

msgid "Delete a key."
msgstr "Suprimir una clave."

msgid "The ID (machine name) of the key to delete."
msgstr "El ID (nombre de máquina) de la clave a suprimir."

msgid "Display a list of available keys."
msgstr "Visualizar una lista de claves disponibles."

msgid "An optional, comma-delimited list of key types. To see a list of available key types, use `drush key-type-list`."
msgstr "Una lista de tipos de clave delimitados por comas. Para ver una lista de tipos de clave disponibles, utilice `drush key-type-list`."

msgid "An optional, comma-delimited list of key providers. To see a list of available key providers, use `drush key-provider-list`."
msgstr "Una lista de proveedores de claves delimitados por comas. Para ver una lista de proveedores de claves disponibles, utilice `drush key-provider-list`."

msgid "Display a list of available key types."
msgstr "Visualiza una lista de tipos de clave disponibles."

msgid "An optional key type group on which to filter."
msgstr "Un grupo de tipos de clave opcional por el que filtrar."

msgid "Display a list of available key providers."
msgstr "Visualiza una lista de proveedores de clave disponibles."

msgid "An optional key provider storage method on which to filter."
msgstr "Un método de almacenamiento de proveedor de claves opcional por el que filtrar."

msgid "Get a key value."
msgstr "Obtener un valor de clave."

msgid "The ID (machine name) of the key whose value should be retrieved."
msgstr "El ID (nombre de máquina) de la clave cuyo valor se debe recuperar."

msgid "Base64-encode the key value. This is useful in the case of binary encryption keys that would otherwise not be displayed in a readable way."
msgstr "Codificar en Base64 el valor de clave. Esto es útil en el caso de claves de cifrado binario que de otro modo no se visualizarían de forma legible."

msgid "Print just the key value, and nothing else."
msgstr "Imprimir solo el valor de clave y nada más."

msgid "The human-readable label of the key."
msgstr "La etiqueta legible de la clave."

msgid "A short description of the key."
msgstr "Una descripción abreviada de la clave."

msgid "The key type. To see a list of available key types, use `drush key-type-list`."
msgstr "El tipo de clave. Para ver una lista de tipos de clave disponibles, utilice `drush key-type-list`."

msgid "Settings specific to the defined key type, in JSON format."
msgstr "Valores específicos del tipo de clave definido en formato JSON."

msgid "The key provider. To see a list of available key providers, use `drush key-provider-list`."
msgstr "El proveedor de claves. Para ver una lista de proveedores de claves disponibles, utilice `drush key-provider-list`."

msgid "Settings specific to the defined key provider, in JSON format."
msgstr "Valores específicos del proveedor de claves definido en formato JSON."

msgid "The key input method."
msgstr "El método de entrada de clave."

msgid "Settings specific to the defined key input, in JSON format."
msgstr "Valores específicos de la entrada de clave definida en formato JSON."

msgid "Key !id does not exist."
msgstr "La clave !id no existe."

msgid "Be extremely careful when deleting a key! It may result in losing access to a service or making encrypted data unreadable."
msgstr "¡Tenga mucho cuidado al suprimir una clave! Puede provocar la pérdida del acceso a un servicio o hacer ilegibles los datos cifrados."

msgid "The following key will be deleted: !id"
msgstr "La clave siguiente se suprimirá: !id"

msgid "Do you really want to continue?"
msgstr "¿De verdad desea continuar?"

msgid "Key !id was not deleted."
msgstr "La clave !id no se ha suprimido."

msgid "Key !id was deleted successfully."
msgstr "La clave !id se ha suprimido satisfactoriamente."

msgid "Key !id exists; specify --overwrite to overwrite."
msgstr "La clave !id existe; especifique --overwrite para sobrescribirla."

msgid "Be extremely careful when overwriting a key! It may result in losing access to a service or making encrypted data unreadable."
msgstr "¡Tenga mucho cuidado al sobrescribir una clave! Puede provocar la pérdida del acceso a un servicio o hacer ilegibles los datos cifrados."

msgid "The following key will be saved: !id"
msgstr "La clave siguiente se guardará: !id"

msgid "Key !id was not saved."
msgstr "La clave !id no se ha guardado."

msgid "Key !id was saved successfully."
msgstr "La clave !id se ha guardado satisfactoriamente."

msgid "User name"
msgstr "Nombre de usuario"

msgid "Password"
msgstr "Contraseña"

msgid "The following key will be overwritten: !id"
msgstr "La clave siguiente se sobrescribirá: !id"

msgid "Do you want to continue?"
msgstr "¿Quiere continuar?"

msgid "The key type. To see a list of available key types, use `drush key:type-list`."
msgstr "El tipo de clave. Para ver una lista de tipos de clave disponibles, utilice `drush key:type-list`."

msgid "The key provider. To see a list of available key providers, use `drush key:provider-list`."
msgstr "El proveedor de claves. Para ver una lista de proveedores de claves disponibles, utilice `drush key:provider-list`."

msgid "Override name"
msgstr "Alterar temporalmente nombre"

msgid "Configuration"
msgstr "Configuración"

msgid "No key configuration overrides are available. <a href=\":link\">Add an override</a>."
msgstr "No hay alteraciones temporales de configuración de clave disponibles. <a href=\":link\">Añadir una alteración temporal</a>."

msgid "Type"
msgstr "Tipo"

msgid "Provider"
msgstr "Proveedor"

msgid "Overrides"
msgstr "Sobreescrituras"

msgid "Add Config Override"
msgstr "Añadir alteración temporal de configuración"

msgid "No keys are available. <a href=\":link\">Add a key</a>."
msgstr "No hay claves disponibles. <a href=\":link\">Añadir una clave</a>."

msgid "- Select a key -"
msgstr "- Seleccionar una clave -"

msgid "Choose an available key. If the desired key is not listed, <a href=\":link\">create a new key</a>."
msgstr "Elija una clave disponible. Si la clave deseada no aparece en la lista, <a href=\":link\">cree una clave nueva</a>."

msgid "Key configuration override name"
msgstr "Nombre de alteración temporal de configuración de clave"

msgid "A human readable name for this override."
msgstr "Un nombre legible para esta alteración temporal."

msgid "Simple configuration"
msgstr "Configuración sencilla"

msgid "Clear overridden value"
msgstr "Borrar valor alterado temporalmente"

msgid "Check this field to clear any existing value for the overridden configuration item. This is important to make sure potentially sensitive data is removed from the configuration."
msgstr "Marque este campo para borrar cualquier valor existente para el elemento de configuración alterado temporalmente. Esto es importante para garantizar que los datos que puedan ser confidenciales se eliminan de la configuración."

msgid "- Select -"
msgstr "- Seleccionar -"

msgid "@label (@id)"
msgstr "@label (@id)"

msgid "Are you sure you want to delete the override %name?"
msgstr "¿Está seguro de que desea suprimir la alteración temporal %name?"

msgid "Delete"
msgstr "Eliminar"

msgid "The override %name has been deleted."
msgstr "Se ha suprimido la alteración temporal %name."

msgid "Are you sure you want to delete the key %key?"
msgstr "¿Está seguro de que desea suprimir la clave %key?"

msgid "The key %label has been deleted."
msgstr "Se ha suprimido la clave %label."

msgid "Edit key %label"
msgstr "Editar clave %label"

msgid "Be extremely careful when editing a key! It may result in broken site functionality. Are you sure you want to edit this key?"
msgstr "¡Tenga mucho cuidado al editar una clave! Puede dañar la funcionalidad del sitio. ¿Está seguro de que desea editar este clave?"

msgid "Edit"
msgstr "Editar"

msgid "Cancel"
msgstr "Cancelar"

msgid "Key name"
msgstr "Nombre de clave"

msgid "Type settings"
msgstr "Valores de tipo"

msgid "Provider settings"
msgstr "Valores de proveedor"

msgid "Value"
msgstr "Valor"

msgid "Key value settings"
msgstr "Valores de valor de clave"

msgid "The key %name has been updated."
msgstr "Se ha actualizado la clave %name."

msgid "The key %name has been added."
msgstr "Se ha añadido la clave %name."

msgid "The key value has already been generated and will not be changed."
msgstr "El valor de clave ya se ha generado y no se cambiará."

msgid "The key value will be automatically generated using the selected key type settings."
msgstr "El valor de clave se generará automáticamente con los valores de tipo de clave seleccionados."

msgid "Display value"
msgstr "Visualizar valor"

msgid "Check this to display the generated value once."
msgstr "Marque esta opción para visualizar una vez el valor generado."

msgid "A key value of the requested type has been generated and is displayed below as a Base64-encoded string. You will need to decode it to get the actual key value, which may or may not be human-readable. The key value will not be displayed again, so take note of it now, if necessary.<br>%key_value"
msgstr "Se ha generado un valor de clave del tipo solicitado y se visualiza más abajo como serie codificada en Base64. Deberá decodificarlo para obtener el valor de clave real que puede o no ser legible. El valor de clave no se volverá a visualizar, así que anótelo si es necesario.<br>%key_value"

msgid "Generate"
msgstr "Crear"

msgid "A key input that generates a key value."
msgstr "Una entrada de clave que genera un valor de clave."

msgid "The selected key provider does not accept a value. See the provider's description for instructions on how and where to store the key value."
msgstr "El proveedor de clave seleccionado no acepta un valor. Consulte la descripción del proveedor para obtener instrucciones sobre cómo y dónde almacenar el valor de clave."

msgid "None"
msgstr "Ninguno"

msgid "A key input for providers that don't accept a value."
msgstr "Una entrada de clave para proveedores que no aceptan un valor."

msgid "Check this if the key value being submitted has been Base64-encoded."
msgstr "Marque esta opción si el valor de clave que se envía está codificado en Base64."

msgid "Text field"
msgstr "Campo de texto"

msgid "A simple text field."
msgstr "Un campo de texto simple."

msgid "Textarea field"
msgstr "Campo de área de texto"

msgid "A simple textarea field."
msgstr "Un campo de área de texto simple."

msgid "Checking this will store the key with Base64 encoding."
msgstr "Si se marca esta opción, la clave se almacenará con codificación Base64."

msgid "The Configuration key provider stores the key in Drupal's configuration system."
msgstr "El proveedor de claves de configuración almacena la clave en el sistema de configuración de Drupal."

msgid "Name of the environment variable."
msgstr "Nombre de la variable de entorno."

msgid "Check this to remove any trailing line breaks from the variable. Leave unchecked if there is a chance that a line break could be a valid character in the key."
msgstr "Marque esta opción para eliminar saltos de línea finales de la variable. Déjala sin marcar si existe la posibilidad de que un salto de línea pudiera ser un carácter válido en la clave."

msgid "Check this if the key in the variable is Base64-encoded."
msgstr "Marque esta opción si la clave de la variable está codificada en Base64."

msgid "The environment variable does not exist or it is empty."
msgstr "La variable de entorno no existe o está vacía."

msgid "Environment"
msgstr "Entorno"

msgid "The Environment key provider allows a key to be retrieved from an environment variable."
msgstr "El proveedor de claves de entorno permite que se recupere una clave de una variable de entorno."

msgid "The location of the file in which the key will be stored. The path may be absolute (e.g., %abs), relative to the Drupal directory (e.g., %rel), or defined using a stream wrapper (e.g., %str)."
msgstr "La ubicación del archivo donde se almacenará la clave. La vía de acceso puede ser absoluta (p. ej., %abs), relativa al directorio de Drupal (p. ej., %rel) o estar definida con un derivador de ruta (p. ej., %str)."

msgid "Check this to remove any trailing line breaks from the file. Leave unchecked if there is a chance that a line break could be a valid character in the key."
msgstr "Marque esta opción para eliminar saltos de línea finales del archivo. Déjala sin marcar si existe la posibilidad de que un salto de línea pudiera ser un carácter válido en la clave."

msgid "Check this if the key in the file is Base64-encoded."
msgstr "Marque esta opción si la clave del archivo está codificada en Base64."

msgid "There is no file at the specified location."
msgstr "No hay ningún archivo en la ubicación especificada."

msgid "The file at the specified location is not readable."
msgstr "El archivo en la ubicación especificada no es legible."

msgid "File"
msgstr "Archivo"

msgid "The File key provider allows a key to be stored in a file, preferably outside of the web root."
msgstr "El proveedor de claves de archivo permite almacenar una clave en un archivo, preferiblemente fuera de la raíz web."

msgid "Authentication"
msgstr "Autentificación"

msgid "A generic key type to use for a password or API key that does not belong to any other defined key type."
msgstr "Un tipo de clave genérico a utilizar para una clave de contraseña o de API que no pertenece a ningún otro tipo de clave definido."

msgid "The key value does not contain valid JSON."
msgstr "El valor de clave no contiene ningún JSON válido."

msgid "The key value is missing the field %field."
msgstr "Al valor de clave le falta el campo %field."

msgid "The key value field %field is empty."
msgstr "El campo %field del valor de clave está vacío."

msgid "Authentication (Multivalue)"
msgstr "Autenticación (multivalor)"

msgid "A generic key type to use for an authentication key that contains multiple values."
msgstr "Un tipo de clave genérico a utilizar para una clave de autenticación que contiene varios valores."

msgid "The size of the key in bits, with 8 bits per byte."
msgstr "El tamaño de la clave en bits, con 8 por byte."

msgid "Other"
msgstr "Otro(s)"

msgid "Key size (other value)"
msgstr "Tamaño de clave (otro valor)"

msgid "Enter a custom key size in bits."
msgstr "Especifique un tamaño de clave personalizado en bits."

msgid "The selected key size does not match the actual size of the key."
msgstr "El tamaño de clave seleccionado no coincide con el tamaño real de la clave."

msgid "Encryption"
msgstr "Cifrado"

msgid "A generic key type to use for an encryption key that does not belong to any other defined key type."
msgstr "Un tipo de clave genérico a utilizar para una clave de cifrado que no pertenece a ningún otro tipo de clave definido."

msgid "User/password"
msgstr "Usuario/contraseña"

msgid "A key type to store a user/password pair."
msgstr "Un tipo de clave para almacenar un par usuario/contraseña."

