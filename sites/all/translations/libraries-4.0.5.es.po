msgid "Lists registered library information."
msgstr "Lista información de biblioteca registrada."

msgid ""
"Downloads a registered library into the libraries directory for the active site.\n"
"\n"
"See libraries-list for a list of registered libraries."
msgstr ""
"Descarga una biblioteca registrada en el directorio de bibliotecas del sitio activo. \n"
"\n"
"Consulte la lista de bibliotecas (libraries-list) para obtener la lista de bibliotecas registradas."

msgid "Name"
msgstr "Nombre"

msgid "Status"
msgstr "Estado"

msgid "Version"
msgstr "Versión"

msgid "Variants"
msgstr "Variantes"

msgid "Dependencies"
msgstr "Dependencias"

msgid "OK"
msgstr "OK"

msgid "Missing dependency: unzip. Install it before using this command."
msgstr "Falta dependencia: unzip. Instálelo antes de usar este comando."

msgid "Directory @path was created"
msgstr "Se ha creado el directorio @path"

msgid "A existing Colorbox plugin was overwritten at @path"
msgstr "Se ha sobrescrito un plugin de Colorbox en @path"

msgid "Colorbox plugin has been downloaded to @path"
msgstr "Se ha descargado un plugin de Colorbox en @path"

msgid "Drush was unable to download the Colorbox plugin to @path"
msgstr "Drush no ha podido descargar el plugin de Colorbox en @path"

msgid "The %dependency library, which the %library library depends on, is not installed."
msgstr "La librería %dependency, de la que depende la librería %library, no está instalada."

msgid "The version %dependency_version of the %dependency library is not compatible with the %library library."
msgstr "La versión %dependency_version de la librería %dependency no es compatible con la librería %library."

msgid "The %library library could not be found."
msgstr "No se encontró la librería %library."

msgid "The version of the %library library could not be detected."
msgstr "No se ha podido detectar la versión de la librería %library."

msgid "The installed version %version of the %library library is not supported."
msgstr "La versión %version instalada de la librería %library no es compatible."

msgid "The %variant variant of the %library library could not be found."
msgstr "No se encontró la variante %variant de la librería %library."

msgid "The following external libraries could not successfully be registered with Drupal core: @libs. See earlier log entries for more details. Once these issues are addressed please be sure to clear your Drupal library cache to ensure external library detection is run again."
msgstr "Las siguientes bibliotecas externas no se han podido registrar satisfactoriamente en el núcleo de Drupal: @libs. Consulte las entradas de registro anteriores para obtener más detalles. Una vez resueltos estos problemas, asegúrese de limpiar la caché de bibliotecas de Drupal para forzar que se vuelva a ejecutar la detección de bibliotecas externas."

msgid "Libraries"
msgstr "Bibliotecas"

msgid "Allows version-dependent and shared usage of external libraries."
msgstr "Permite el uso compartido y dependientes de la versión de bibliotecas externas."

msgid "Libraries API settings"
msgstr "Parámetros del API de bibliotecas"

msgid "Library definition settings"
msgstr "Parámetros de definición de bibliotecas"

msgid "Local"
msgstr "Local"

msgid "Local path"
msgstr "Ruta local"

msgid "Enable remote fetching of library definitions"
msgstr "Habilitar recuperación remota de definiciones de biblioteca"

msgid "A list of remote library registry URLs"
msgstr "Lista de URLs de registro de bibliotecas remotas"

msgid "The URL of a remote library registry"
msgstr "URL de un registro de biblioteca remota"

msgid "URI locator configuration"
msgstr "Configuración de ubicadores de URI"

msgid "The locator URI"
msgstr "El URI del ubicador"

msgid "Assets"
msgstr "Activos"

msgid "Provides access to asset library files."
msgstr "Proporciona acceso a los archivos de biblioteca de activo."

msgid "Library definitions"
msgstr "Definiciones de biblioteca"

msgid "Provides access to library definition files."
msgstr "Proporciona acceso a los archivos de definición de biblioteca."

msgid "PHP library files"
msgstr "Archivos de biblioteca PHP"

msgid "Provides access to PHP library files."
msgstr "Proporciona acceso a los archivos de biblioteca de PHP."

