msgid "Changed key type from \"aes_encryption\" to \"encryption\" for existing keys."
msgstr "Изменен тип ключа с \"aes_encryption\" на \"encryption\" для существующих ключей."

msgid "No changes to existing keys were made because there were no keys defined with the \"aes_encryption\" key type."
msgstr "Никаких изменений в существующие ключи не внесено, так как не было ключей с типом \"aes_encryption\"."

msgid "Added configuration dependencies on keys for existing profiles."
msgstr "Добавлены зависимости конфигурации от ключей для существующих профайлов."

msgid "No changes were made because there were no profiles without a configuration dependency on their key."
msgstr "Никаких изменений не внесено, так как не было профайлов без зависимости конфигурации от их ключа."

msgid "Encrypt"
msgstr "Шифрование"

msgid "Provides an API for two-way encryption."
msgstr "Предоставляет API для двустороннего шифрования."

msgid "Encryption"
msgstr "Шифрование"

msgid "Add Encryption Profile"
msgstr "Добавить профайл шифрования"

msgid "Encryption profiles"
msgstr "Профайлы шифрования"

msgid "Manage profiles that can be used to encrypt and decrypt data."
msgstr "Управление профайлами, которые можно использовать для шифрования и расшифровки данных."

msgid "List"
msgstr "Список"

msgid "Settings"
msgstr "Настройки"

msgid "Administer encryption settings"
msgstr "Управление параметрами шифрования"

msgid "Change encryption settings (does not let them view encrypted data)."
msgstr "Изменить параметры шифрования (не позволяет просматривать зашифрованные данные)."

msgid "Add encryption profile"
msgstr "Добавить профайл шифрования"

msgid "Edit encryption profile"
msgstr "Изменить профайл шифрования"

msgid "Delete encryption profile"
msgstr "Удалить профайл шифрования"

msgid "Test encryption profile"
msgstr "Проверить профайл шифрования"

msgid "Encrypt settings"
msgstr "Параметры шифрования"

msgid "Encrypt Profile"
msgstr "Зашифровать профайл"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "Метка"

msgid "Encryption method selected for encryption profile"
msgstr "Метод шифрования, выбранный для профайла шифрования"

msgid "Encryption method configuration"
msgstr "Конфигурация метода шифрования"

msgid "Key ID for encryption profile"
msgstr "ИД ключа для профайла шифрования"

msgid "Encryption method config"
msgstr "Конфигурация метода шифрования"

msgid "Encrypt Settings"
msgstr "Параметры шифрования"

msgid "Check profile validation status."
msgstr "Проверьте состояние проверки профайла."

msgid "Deprecated encryption plugins allowed."
msgstr "Устаревшие модули шифрования разрешены."

msgid "Encrypt commands"
msgstr "Зашифровать команды"

msgid "Interact with the encryption service."
msgstr "Взаимодействия со службой шифрования."

msgid "Encryption profile \"@name\" could not be loaded."
msgstr "Не удалось загрузить профайл шифрования \"@name\"."

msgid "Please specify the encryption profile and the text to be encrypted"
msgstr "Укажите профайл шифрования и текст, который требуется зашифровать"

msgid "Please specify the decryption profile and the encrypted text to be decrypted"
msgstr "Укажите профайл расшифровки и зашифрованный текст, который требуется расшифровать"

msgid "Please specify the encryption profile to be validated"
msgstr "Укажите профайл шифрования для проверки"

msgid "Encryption profile validates successfully."
msgstr "Профайл шифрования успешно прошел проверку."

msgid "Encryption profile @profile could not be loaded."
msgstr "Не удалось загрузить профайл шифрования @profile."

msgid "Encryption method"
msgstr "Метод шифрования"

msgid "Key"
msgstr "Ключ"

msgid "Status"
msgstr "Статус"

msgid "Error loading encryption method"
msgstr "Ошибка при загрузке метода шифрования"

msgid "Error loading key"
msgstr "Ошибка при загрузке ключа"

msgid "The encryption plugin used in this encryption profile is deprecated."
msgstr "Модуль шифрования из профайла шифрования устарел."

msgid "OK"
msgstr "OK"

msgid "Test"
msgstr "Тест"

msgid "No encryption profiles are available. <a href=\":link\">Add a profile</a>."
msgstr "Нет профайлов шифрования. <a href=\":link\">Добавьте профайл</a>."

msgid "No encryption method selected."
msgstr "Не выбран метод шифрования."

msgid "No encryption key selected."
msgstr "Не выбран ключ шифрования."

msgid "The encryption method linked to this encryption profile does not exist."
msgstr "Метод шифрования, связанный с этим профайлом шифрования, не существует."

msgid "The key linked to this encryption profile does not exist."
msgstr "Ключ, связанный с этим профайлом шифрования, не существует."

msgid "The selected key cannot be used with the selected encryption method."
msgstr "Выбранный ключ не может использоваться с выбранным методом шифрования."

msgid "Encryption Profile"
msgstr "Профайл шифрования"

msgid "Show the validation status of encryption profiles."
msgstr "Показать состояние проверки профайлов шифрования."

msgid "On the encryption profiles overview page, automatically validate each encryption profile to check if there are problems with it. Disable when you have a lot of encryption profiles and are encountering performance issues, or if you do not want encryption keys to be loaded by the status check."
msgstr "На странице обзора профайлов шифрования автоматически проверить каждый профайл шифрования на наличие неполадок. Выключите этот параметр, если профайлов шифрования много и есть проблемы с производительностью или если нежелательно, чтобы при проверке состояния загружались ключи шифрования."

msgid "Allow the use of deprecated plugins."
msgstr "Разрешить использование устаревших модулей."

msgid "Enable this setting to allow the use of deprecated encryption plugins in new profiles. Leave disabled to only allow their use in existing profiles"
msgstr "Выберите этот параметр, чтобы разрешить использование устаревших модулей шифрования в новых профайлах. Не выбирайте его, чтобы разрешить их использование только в имеющихся профайлах"

msgid "Are you sure you want to delete %name?"
msgstr "Вы уверены, что хотите удалить %name?"

msgid "Delete"
msgstr "Удалить"

msgid "content @type: deleted @label."
msgstr "содержимое @type: удалено @label."

msgid "Be extremely careful when editing an encryption profile! It may result in making data encrypted with this profile unreadable. Are you sure you want to edit this profile?"
msgstr "При изменении профайла шифрования следует соблюдать предельную осторожность! Это может привести к тому, что данные, зашифрованные этим профайлом, будет невозможно прочитать. Вы действительно хотите изменить этот профайл?"

msgid "Label for the encryption profile."
msgstr "Метка для профайла шифрования."

msgid "Encryption Method"
msgstr "Метод шифрования"

msgid "Select the method used for encryption"
msgstr "Выберите метод, используемый для шифрования"

msgid "Encryption method settings"
msgstr "Параметры метода шифрования"

msgid "Encryption Key"
msgstr "Ключ шифрования"

msgid "Edit"
msgstr "Редактировать"

msgid "Cancel"
msgstr "Отмена"

msgid "Saved the %label encryption profile."
msgstr "Сохранен профайл шифрования %label."

msgid "The %label encryption profile was not saved."
msgstr "Профайл шифрования %label не сохранен."

msgid "Encryption test"
msgstr "Проверка шифрования"

msgid "Text to encrypt"
msgstr "Текст для шифрования"

msgid "Specify the text you want to encrypt with this encryption profile. The result of the encryption will be shown below."
msgstr "Укажите текст, который требуется зашифровать с помощью этого профайла шифрования. Результат шифрования будет показан внизу."

msgid "Base64-encode the encrypted text."
msgstr "Преобразовать зашифрованный текст в кодировку Base64."

msgid "Encrypted text"
msgstr "Зашифрованный текст"

msgid "Decryption test"
msgstr "Проверка расшифровки"

msgid "Text to decrypt"
msgstr "Текст для расшифровки"

msgid "Specify the text you want to decrypt with this encryption profile. The result of the decryption will be shown below."
msgstr "Укажите текст, который требуется расшифровать с помощью этого профайла шифрования. Результат расшифровки будет показан внизу."

msgid "Base64-decode the encrypted text before decrypting."
msgstr "Преобразовать зашифрованный текст из кодировки Base64 перед расшифровкой."

msgid "Decrypt"
msgstr "Расшифровать"

msgid "Decrypted text"
msgstr "Расшифрованный текст"

