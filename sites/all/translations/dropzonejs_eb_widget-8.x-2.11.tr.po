msgid "DropzoneJS entity browser widget"
msgstr "DropzoneJS varlık tarayıcı pencere bileşeni"

msgid "DropzoneJS Entity browser widget."
msgstr "DropzoneJS Varlık tarayıcı pencere bileşeni."

msgid "Media"
msgstr "Ortam"

msgid "DropzoneJS widget configuration"
msgstr "DropzoneJS pencere bileşeni yapılandırması"

msgid "Submit button text"
msgstr "Gönder düğmesi metni"

msgid "Automatically submit selection"
msgstr "Seçimi otomatik olarak gönder"

msgid "Upload location"
msgstr "Karşıya yükleme konumu"

msgid "Dropzone drag-n-drop zone text"
msgstr "Dropzone sürükle-bırak alanı metni"

msgid "Maximum size of files"
msgstr "Dosyaların maksimum boyutu"

msgid "Allowed file extensions"
msgstr "İzin verilen dosya uzantıları"

msgid "Use clientside resize"
msgstr "İstemci tarafı yeniden boyutlandırma kullan"

msgid "Maximum width"
msgstr "Genişlik üst sınırı"

msgid "Maximum height"
msgstr "Yükseklik üst sınırı"

msgid "Resize quality"
msgstr "Yeniden boyutlandırma kalitesi"

msgid "Method used for resizing"
msgstr "Yeniden boyutlandırma için kullanılan yöntem"

msgid "Method used for generating the thumbnail"
msgstr "Küçük resmi oluşturmak için kullanılan yöntem"

msgid "Media Entity DropzoneJS widget configuration"
msgstr "Media Entity DropzoneJS pencere bileşeni yapılandırması"

msgid "Media type"
msgstr "Ortam tipi"

msgid "Media Entity DropzoneJS with edit widget configuration"
msgstr "Pencere bileşeni yapılandırmasını düzenlemeyi içeren Media Entity DropzoneJS"

msgid "Form mode"
msgstr "Form kipi"

msgid "Drop files here to upload them"
msgstr "Karşıya yüklemek için dosyaları buraya bırakın"

msgid "File upload"
msgstr "Dosya karşıya yükleme"

msgid "Files could not be uploaded because the destination directory %destination is not configured correctly."
msgstr "Hedef dizin %destination düzgün yapılandırılmadığından dosyalar karşıya yüklenemedi."

msgid "Some files that you are trying to upload did not pass validation. Requirements are: max file %size, allowed extensions are %extensions"
msgstr "Karşıya yüklemeye çalıştığınız bazı dosyalar doğrulamayı geçemedi. Gereksinimler: maksimum dosya %size, izin verilen uzantılar: %extensions"

msgid "At least one valid file should be uploaded."
msgstr "En az bir geçerli dosya karşıya yüklenmelidir."

msgid "MB"
msgstr "MB"

msgid "A space separated list of file extensions"
msgstr "Dosya uzantılarının boşlukla ayrılmış listesi"

msgid "Use client side resizing"
msgstr "İstemci tarafı yeniden boyutlandırması kullan"

msgid "Requires droopzone version v4.4.0 or higher and the <a href=\"@exif\" target=\"_blank\">exif</a> library."
msgstr "droopzone v4.4.0 veya üzeri bir sürüm ve <a href=\"@exif\" target=\"_blank\">exif</a> kitaplığını gerektirir."

msgid "Max width"
msgstr "Genişlik üst sınırı"

msgid "Max height"
msgstr "Yükseklik üst sınırı"

msgid "Resize method"
msgstr "Yeniden boyutlandırma yöntemi"

msgid "Contain (scale)"
msgstr "İçerir (ölçek)"

msgid "Crop"
msgstr "Kırp"

msgid "Thumbnail method"
msgstr "Küçük resim yöntemi"

msgid "Invalid extension list format."
msgstr "Geçersiz uzantı listesi biçimi."

msgid "DropzoneJS"
msgstr "DropzoneJS"

msgid "Adds DropzoneJS upload integration."
msgstr "DropzoneJS karşıya yükleme bütünleştirmesi ekler."

msgid "Missing requirement: in order to use this widget you have to install Inline entity form module first"
msgstr "Eksik gereksinim: Bu pencere bileşenini kullanmak için öncelikle Inline varlık formu modülünü kurmanız gerekir"

msgid "Edit"
msgstr "Düzenle"

msgid "Media Entity DropzoneJS with edit"
msgstr "Düzenleme içeren Media Entity DropzoneJS"

msgid "Adds DropzoneJS upload integration that saves Media entities and allows to edit them."
msgstr "Ortam varlıklarını kaydeden ve bunların düzenlenmesini sağlayan DropzoneJS karşıya yükleme bütünleştirmesi ekler."

msgid "The type of media entity to create from the uploaded file(s)."
msgstr "Karşıya yüklenen dosyadan/dosyalardan oluşturulacak ortam varlığı tipi."

msgid "You must @create_media_type before using this widget."
msgstr "Bu pencere bileşenini kullanmadan önce @create_media_type"

msgid "create a media type"
msgstr "bir ortam tipi oluşturun"

msgid "Media Entity DropzoneJS"
msgstr "Media Entity DropzoneJS"

msgid "Adds DropzoneJS upload integration that saves Media entities."
msgstr "Ortam varlıklarını kaydeden DropzoneJS karşıya yükleme bütünleştirmesini ekler."

