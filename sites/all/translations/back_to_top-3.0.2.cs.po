msgid "Back To Top"
msgstr "Zpět nahoru"

msgid "Back To Top adds a button that hovers in the bottom of your screen and allow users to smoothly scroll up the page using jQuery."
msgstr "Modul Zpět nahoru přidá (s pomocí knihovny jQuery) na stránku  tlačítko, které se nachází ve spodní části obrazovky a umožňuje uživatelům hladce posunout stránku zpět nahoru."

msgid "User interface"
msgstr "Uživatelské rozhraní"

msgid "Back to Top"
msgstr "Zpět nahoru"

msgid "Administer Back To Top settings."
msgstr "Spravujte nastavení Na začátek."

msgid "Back to top settings"
msgstr "Nastavení Na začátek"

msgid "Access Back to top settings"
msgstr "Přístup k nastavení Na začátek"

msgid "Prevent on mobile and touch devices"
msgstr "Nezobrazovat na mobilních a dotykových zařízeních"

msgid "Prevent on administration pages and node edit"
msgstr "Zabránit na stránkách administrace a úprav uzlu"

msgid "Prevent on front page"
msgstr "Nezobrazovat na titulní straně"

msgid "Trigger"
msgstr "Spouštěč"

msgid "Placement"
msgstr "Umístění"

msgid "Button text"
msgstr "Text tlačítka"

msgid "Button type"
msgstr "Typ tlačítka"

msgid "Background color"
msgstr "Barva pozadí"

msgid "Border color"
msgstr "Barva okraje"

msgid "Hover color"
msgstr "Barva po najetí kurzorem"

msgid "Text color"
msgstr "Barva textu"

msgid "Back to top"
msgstr "Zpět nahoru"

msgid "Don´t show Back To Top-button on screen width up to 760px."
msgstr "Nezobrazovat tlačítko Zpět nahoru na šířku obrazovky až 760px."

msgid "Do you want to prevent Back To Top on admin pages?"
msgstr "Chcete zabránit zobrazení tlačítka Na začátek na stránkách administrace?"

msgid "Do you want to prevent Back To Top on front page?"
msgstr "Chcete zabránit zobrazení tlačítka Na začátek na titulním straně?"

msgid "Set the number of pixel which trigger the Back To Top button default 100"
msgstr "Nastavit počet pixelů, které spouštějí tlačítko Zpět na začátek, výchozí hodnota 100"

msgid "Where should the Back To Top button appear?"
msgstr "Kde by se mělo zobrazit tlačítko Zpět na nahoru?"

msgid "Bottom right"
msgstr "Dolní pravý"

msgid "Bottom left"
msgstr "Dolní levý"

msgid "Bottom center"
msgstr "Dole uprostřed"

msgid "Top right"
msgstr "Horní pravý"

msgid "Top left"
msgstr "Horní levý"

msgid "Top center"
msgstr "Nahoře uprostřed"

msgid "Mid right"
msgstr "V pravé polovině"

msgid "Mid left"
msgstr "V levé polovině"

msgid "Mid center"
msgstr "Ve středu"

msgid "Set the text of the Back To Top button"
msgstr "Nastavit text tlačítka Na začátek"

msgid "Do you want Back To Top to use a PNG-24 image or a Text/Css button?"
msgstr "Chcete, aby funkce Zpět nahoru využila pro zobrazení tlačítka obrázek ve formátu PNG-24 nebo Text/Css?"

msgid "Image (default)"
msgstr "Obrázek (výchozí)"

msgid "Text/Css"
msgstr "Text/Css"

msgid "Text/Css button settings"
msgstr "Nastavení tlačítka pro formát Text/Css"

msgid "Button background color default #F7F7F7"
msgstr "Výchozí barva pozadí tlačítka #F7F7F7"

msgid "Border color default #CCCCCC"
msgstr "Výchozí barva okraje tlačítka #CCCCCC"

msgid "Hover color default #EEEEEE"
msgstr "Výchozí barva události hover #EEEEEE"

msgid "Text color default #333333"
msgstr "Výchozí barva textu  #333333"

