msgid "About"
msgstr "Over"

msgid "The FAQ Field module defines a field for storing frequently asked questions, for use with the Field module. See the <a href=\":field_ui\">Field module help page</a> for more information about fields."
msgstr "Met de module FAQ Field definieert u een veld voor het opslaan van veelgestelde vragen, te gebruiken in combinatie met de module Field. Zie de <a href=\":field_ui\">Help-pagina van de module Field</a> voor meer informatie over velden."

msgid "FAQ Field"
msgstr "FAQ-veld"

msgid "Provides a field for frequently asked questions."
msgstr "Biedt een veld voor veelgestelde vragen. "

msgid "Field types"
msgstr "Veldtypes"

msgid "FAQ Field jQuery Accordion format settings"
msgstr "Instellingen voor jQuery harmonica-indeling FAQ-veld"

msgid "Index of active element starting from 0. Leave empty to display none at start."
msgstr "Index van actieve elementen, vanaf 0. Laat dit leeg om er aanvankelijk geen af te beelden."

msgid "Controls the height of the accordion and each panel."
msgstr "Bepaalt de hoogte van de harmonica en elk scherm. "

msgid "Whether an opened question can be collapsed (by the triggering event)."
msgstr "Bepaalt of een geopende vraag kan worden samengevouwen (door de triggerevent). "

msgid "Event on which to trigger the accordion."
msgstr "Event waarbij de harmonica wordt getriggerd."

msgid "Animation options for the accordion formatter."
msgstr "Animatieopties voor de harmonicaformatter."

msgid "Name of easing to use when the event is triggered."
msgstr "Naam van de easing die moet worden gebruikt wanneer de event wordt getriggerd."

msgid "Animation duration in milliseconds with the selected easing."
msgstr "Duur van animatie (in milliseconden) voor de geselecteerde easing."

msgid "FAQ Field HTML anchor list format settings"
msgstr "Instellingen voor HTML-ankerlijstindeling van FAQ-veld"

msgid "The type of HTML list used for the anchor link list."
msgstr "Het type HTML-lijst dat wordt gebruikt voor de lijst van ankerlinks."

msgid "FAQ Field default widget settings"
msgstr "Instellingen voor standaardwidget van FAQ-veld"

msgid "What form widget to use for answer input."
msgstr "Welke formulierwidget er wordt gebruikt voor de invoer van het antwoord."

msgid "Custom title of question input."
msgstr "Aangepaste titel van vraaginvoer."

msgid "Custom title of answer input."
msgstr "Aangepaste titel van antwoordinvoer."

msgid "Question field is required."
msgstr "Het vraagveld is verplicht."

msgid "Answer field is required."
msgstr "Het antwoordveld is verplicht."

msgid "Advanced options of the FAQ Field default widget."
msgstr "Geavanceerde opties van de standaardwidget voor FAQ-velden."

msgid "Maximum length of questions."
msgstr "Maximumlengte van vragen. "

msgid "Size the question widget."
msgstr "Grootte van de vraagwidget."

msgid "Number of rows used for the question widget."
msgstr "Aantal rijen dat voor de vraagwidget wordt gebruikt. "

msgid "Number of rows used for the answer widget."
msgstr "Aantal rijen dat voor de antwoordwidget wordt gebruikt. "

msgid "FAQ Field field settings"
msgstr "Instellingen voor FAQ-velden"

msgid "Default text format"
msgstr "Indeling standaardtekst"

msgid "Default active"
msgstr "Standaard actief"

msgid "None"
msgstr "Geen"

msgid "Index of the active question starting from 0. If left empty and <em>Fully collapsible</em> is on, no question will be opened by default."
msgstr "Index van de actieve vraag, vanaf 0. Indien deze leeg is en <em>Volledig samenvouwbaar</em> ingeschakeld is, wordt er standaard geen vraag geopend. "

msgid "Height style"
msgstr "Stijl voor hoogte"

msgid "Auto : All panels will be set to the height of the tallest question."
msgstr "Auto: Alle vensters worden ingesteld op de hoogte van de langste vraag."

msgid "Fill : Expand to the available height based on the accordions question height."
msgstr "Opvullen: Er wordt uitgevouwen tot de beschikbare hoogte, op basis van de hoogte van de harmonica."

msgid "Content : Each panel will be only as tall as its question."
msgstr "Content: Elk scherm wordt slechts zo groot als de vraag die erin wordt afgebeeld."

msgid "Fully collapsible"
msgstr "Volledig samenvouwbaar"

msgid "Whether all the questions can be closed at once. Allows collapsing the active section."
msgstr "Geeft aan of alle vragen in één keer kunnen worden gesloten. Maakt het mogelijk om de actieve sessie samen te vouwen."

msgid "Event"
msgstr "Evenement"

msgid "The event on which to open a question. Multiple events can be specified, separated by a space."
msgstr "De event waarbij er een vraag moet worden geopend. Er kunnen meerdere events worden opgegeven, van elkaar gescheiden door een spatie."

msgid "Animation settings"
msgstr "Animatie-instellingen"

msgid "Duration"
msgstr "Tijdsduur"

msgid "Easing"
msgstr "Easing"

msgid "Name of <a href=\"@link\">easing</a> to use when the event is triggered."
msgstr "Naam van de <a href=\"@link\">easing</a> die moet worden gebruikt wanneer de event wordt getriggerd."

msgid "Default active: @element"
msgstr "Standaard actief: @element"

msgid "Auto"
msgstr "Automatisch"

msgid "Fill"
msgstr "Opvullen"

msgid "Content"
msgstr "Inhoud"

msgid "Height style : @style"
msgstr "Hoogtestijl: @style"

msgid "Event: @event"
msgstr "Event: @event"

msgid "jQuery Accordion"
msgstr "jQuery-harmonica"

msgid "Anchor link list type"
msgstr "Type voor lijst van ankerlinks"

msgid "<ul> - Bullet list"
msgstr "<ul> - Ongenummerde lijst"

msgid "<ol> - Numeric list"
msgstr "<ol> - Genummerde lijst"

msgid "Bullet list"
msgstr "Opsommingslijst"

msgid "Numeric list"
msgstr "Genummerde lijst"

msgid "HTML anchor list"
msgstr "Lijst van HTML-ankers"

msgid "HTML definition list"
msgstr "Lijst van HTML-definities"

msgid "HTML details"
msgstr "HTML-details"

msgid "Simple text"
msgstr "Platte tekst"

msgid "Question value"
msgstr "Waarde van vraag"

msgid "Answer value"
msgstr "Waarde van antwoord"

msgid "Answer text format"
msgstr "Indeling antwoordtekst"

msgid "Default text format to filter FAQ field answer content."
msgstr "Indeling van standaardtekst voor het filteren van de antwoordcontent van het FAQ-veld."

msgid "Question"
msgstr "Vraag"

msgid "Answer"
msgstr "Antwoord"

msgid "Answer widget"
msgstr "Antwoordwidget"

msgid "Textarea"
msgstr "Tekstvlak"

msgid "Formatable textarea"
msgstr "Opmaakbaar tekstgebied"

msgid "Textfield"
msgstr "Tekstveld"

msgid "What form widget to use for answer input. Formatable textarea is needed for WYSIWYG editors."
msgstr "Welke formulierwidget er wordt gebruikt voor de invoer van het antwoord.Opmaakbaar tekstgebied is vereist voor WYSIWYG-editors."

msgid "Question widget title"
msgstr "Titel van vraagwidget"

msgid "Custom title of question widget."
msgstr "Aangepaste titel van vraagwidget. "

msgid "Answer widget title"
msgstr "Titel van antwoordwidget"

msgid "Custom title of answer widget."
msgstr "Aangepaste titel van antwoordwidget. "

msgid "Required Field Question"
msgstr "Vraag verplicht veld"

msgid "Set field question required."
msgstr "Stel veldvraag in als verplicht"

msgid "Required Field Answer"
msgstr "Antwoord verplicht veld"

msgid "Set field answer required ."
msgstr "Stel veldantwoord in als verplicht"

msgid "Advanced settings"
msgstr "Geavanceerde instellingen"

msgid "Question length"
msgstr "Lengte van vraag"

msgid "Maximum length of questions (Between 1 and 255)."
msgstr "Maximumlengte van vragen (tussen 1 en 255)."

msgid "Question field size"
msgstr "Grootte van vraagveld"

msgid "Width of the question widget."
msgstr "Breedte van de vraagwidget."

msgid "Question widget"
msgstr "Vraagwidget"

msgid "Fieldset"
msgstr "Veldengroep"

msgid "Textarea, 1 row"
msgstr "Tekstgebied, 1 rij"

msgid "Textarea, 2 row"
msgstr "Tekstgebied, 2 rijen"

msgid "Textarea, 3 row"
msgstr "Tekstgebied, 3 rijen"

msgid "Textarea, 4 row"
msgstr "Tekstgebied, 4 rijen"

msgid "Number of rows used for the question textfield/textarea."
msgstr "Aantal rijen dat wordt gebruikt voor het tekstveld/tekstgebied van de vraag."

msgid "Answer rows"
msgstr "Antwoordrijen"

msgid "Number of rows used for the answer textarea."
msgstr "Aantal rijen dat wordt gebruikt voor het tekstgebied voor antwoorden. "

msgid "Answer widget : @answer"
msgstr "Antwoordwidget: @answer"

msgid "Answer widget title: @title"
msgstr "Titel antwoordwidget: @title"

msgid "Question widget title: @title"
msgstr "Titel vraagwidget: @title"

