msgid "AdvAgg Bundler"
msgstr "Programme de mise en bundle AdvAgg"

msgid "Customize the number of aggregates to be created."
msgstr "Personnalisez le nombre d'agrégats à créer."

msgid "Advanced CSS/JS Aggregation"
msgstr "Agrégation CSS/JS avancée"

msgid "Bundler"
msgstr "Programme de mise en bundle"

msgid "AdvAgg Bundler settings."
msgstr "Paramètres du programme de mise en bundle AdvAgg."

msgid "AdvAgg: Bundler"
msgstr "AdvAgg : Programme de mise en bundle"

msgid "Settings"
msgstr "Paramètres"

msgid "Whether to run the bundler options."
msgstr "Indique si les options du programme de mise en bundle doivent être exécutées."

msgid "Settings for CSS bundling."
msgstr "Paramètres de mise en bundle CSS."

msgid "Maximum target css aggregates."
msgstr "Nombre maximal d'agrégats CSS cible."

msgid "The logic to use for bundling the CSS Files."
msgstr "Logique à utiliser pour la mise en bundle des fichiers CSS."

msgid "Settings for JavaScript bundling."
msgstr "Paramètres de mise en bundle JavaScript."

msgid "Maximum target JavaScript aggregates."
msgstr "Nombre maximal d'agrégats JavaScript cible."

msgid "The logic to use for bundling the JS Files."
msgstr "Logique à utiliser pour la mise en bundle des fichiers JS."

msgid "Bundler is Active"
msgstr "Le programme de mise en bundle est actif"

msgid "If not checked, the bundler will not split up aggregates."
msgstr "Si cette option n'est pas cochée, le programme de mise en bundle ne fractionnera pas les agrégats."

msgid "CSS Bundling options."
msgstr "Options de mise en bundle CSS."

msgid "Target Number Of CSS Bundles Per Page"
msgstr "Nombre cible de bundles CSS par page"

msgid "If 0 is selected then the bundler is disabled"
msgstr "Si la valeur 0 est sélectionnée, le programme de mise en bundle est désactivé"

msgid "Grouping logic"
msgstr "Logique de groupement"

msgid "File count"
msgstr "Nombre de fichiers"

msgid "File size"
msgstr "Taille de fichier"

msgid "If file count is selected then each bundle will try to have a similar number of original files aggregated inside of it. If file size is selected then each bundle will try to have a similar file size."
msgstr "Si l'option Nombre de fichiers est sélectionnée, chaque bundle devra essayer de comporter un nombre similaire de fichiers originaux agrégés. Si l'option Taille de fichier est sélectionnée, chaque bundle devra essayer d'avoir une taille de fichier similaire."

msgid "JavaScript Bundling options."
msgstr "Options de mise en bundle JavaScript."

msgid "Target Number Of JS Bundles Per Page"
msgstr "Nombre cible de bundles JS par page"

