msgid "Facets summary (Experimental)"
msgstr "Podsumowanie aspektów (eksperymentalne)"

msgid "Exposes a Facets block summary showing the current search."
msgstr "Prezentuje podsumowanie blokowe aspektów przedstawiające bieżące wyszukiwanie."

msgid "Search"
msgstr "Szukaj"

msgid "Add facet summary"
msgstr "Dodaj podsumowanie aspektów"

msgid "Edit facets summary"
msgstr "Edytuj podsumowanie aspektów"

msgid "Edit"
msgstr "Edytuj"

msgid "Facet Summary settings"
msgstr "Ustawienia podsumowania aspektów"

msgid "Facet"
msgstr "Aspekt"

msgid "ID"
msgstr "Identyfikator"

msgid "Name"
msgstr "Nazwa"

msgid "Facet source id"
msgstr "Identyfikator źródła aspektu"

msgid "Processor settings"
msgstr "Ustawienia procesora"

msgid "A processor"
msgstr "Procesor"

msgid "The plugin ID of the processor"
msgstr "Identyfikator wtyczki procesora"

msgid "The processors weight for this stage"
msgstr "Waga procesorów dla tego etapu"

msgid "the weight"
msgstr "Waga"

msgid "Facets configuration"
msgstr "Konfiguracja aspektów"

msgid "Is this facet enabled"
msgstr "Czy ten aspekt został włączony"

msgid "Label"
msgstr "Etykieta"

msgid "Results separator"
msgstr "Separator wyników"

msgid "Show count on items"
msgstr "Pokazuj licznik elementów"

msgid "Facet Weight"
msgstr "Waga aspektu"

msgid "No results behavior"
msgstr "Zachowanie w przypadku braku wyników"

msgid "The text to show when there is no current search"
msgstr "Tekst, który jest pokazywany, gdy nie ma bieżącego wyszukiwania"

msgid "Reset facets link"
msgstr "Odsyłacz Resetuj aspekty"

msgid "The text to show for the reset link."
msgstr "Tekst wyświetlany w przypadku odsyłacza resetowania."

msgid "Position of the reset link."
msgstr "Pozycja odsyłacza resetowania."

msgid "Processor @id specifies a non-existing @class."
msgstr "Procesor @id określa nieistniejącą klasę @class."

msgid "Facet summary"
msgstr "Podsumowanie aspektów"

msgid "Edit %label facets summary"
msgstr "Edytuj podsumowanie aspektów %label"

msgid "Enabled facets"
msgstr "Włączone aspekty"

msgid "Separator"
msgstr "Separator"

msgid "Show counts"
msgstr "Pokazuj liczniki"

msgid "Weight"
msgstr "Waga"

msgid "Select the facets to be shown in the summary block. You can reorder them."
msgstr "Wybierz aspekty wyświetlane w bloku podsumowania. Możesz zmieniać ich kolejność."

msgid "Weight for @title"
msgstr "Waga elementu @title"

msgid "No facets found."
msgstr "Nie znaleziono żadnego aspektu."

msgid "Facets Summary settings"
msgstr "Ustawienia podsumowania aspektów"

msgid "%processor settings"
msgstr "Ustawienia procesora %processor"

msgid "Advanced settings"
msgstr "Ustawienia zaawansowane"

msgid "Processor order"
msgstr "Kolejność procesorów"

msgid "Weight for processor %title"
msgstr "Waga procesora %title"

msgid "Facets Summary %name has been updated."
msgstr "Podsumowanie aspektów %name zostało zaktualizowane."

msgid "Add facets summary"
msgstr "Dodaj podsumowanie aspektów"

msgid "Facets settings for %label"
msgstr "Ustawienia aspektów źródła %label"

msgid "You currently have no facet sources defined. You should start by adding a facet source before creating facets."
msgstr "Nie zdefiniowano żadnych źródeł aspektów. Należy rozpocząć od dodania źródła aspektów (jeszcze przed utworzeniem aspektów)."

msgid "Facet source"
msgstr "Źródło aspektu"

msgid "The source where this summary will be built from."
msgstr "Źródło, na podstawie którego tworzone będzie to podsumowanie."

msgid "The administrative name used for this summary."
msgstr "Nazwa administracyjna tego podsumowania."

msgid "Facet Summary %name has been created. Go to the <a href=\":block_overview\">Block overview page</a> to place the new block in the desired region."
msgstr "Podsumowanie aspektów %name zostało utworzone. Przejdź do <a href=\":block_overview\">strony przeglądu blokowego</a>, aby umieścić nowy blok w żądanym regionie."

msgid "Facet %name has been updated."
msgstr "Aspekt %name został zaktualizowany."

msgid "Caching of view %view has been disabled."
msgstr "Buforowanie widoku %view zostało wyłączone."

msgid "Facet Summary: :facet_summary"
msgstr "Podsumowanie aspektów: podsumowanie_aspektów"

msgid "Facets Summary"
msgstr "Podsumowanie aspektów"

msgid "In preview"
msgstr "W podglądzie"

msgid "Hide Summary when Facet Source is not rendered"
msgstr "Ukrywaj podsumowanie, gdy źródło aspektu nie jest wyświetlane"

msgid "When checked, this facet will only be rendered when the facet source is rendered. If you want to show facets on other pages too, you need to uncheck this setting."
msgstr "Jeśli zaznaczysz tę opcję, ten aspekt będzie wyświetlany tylko wtedy, gdy będzie wyświetlane źródło aspektu. Jeśli chcesz, aby aspekty były wyświetlane też na innych stronach, musisz usunąć zaznaczenie tej opcji."

msgid "Reset"
msgstr "Przywróć"

msgid "Reset facets link text"
msgstr "Tekst odsyłacza Resetuj aspekty"

msgid "Show reset link before facets links"
msgstr "Pokaż odsyłacz resetowania przed odsyłaczami aspektów"

msgid "Show reset link after facets links"
msgstr "Pokaż odsyłacz resetowania po odsyłaczach aspektów"

msgid "Show only reset link"
msgstr "Pokaż tylko odsyłacz resetowania"

msgid "Position"
msgstr "Pozycja"

msgid "Set position of the link to display it before, after or instead of facets links."
msgstr "Ustaw pozycję odsyłacza, aby wyświetlić go przed, po lub zamiast odsyłaczy aspektów."

msgid "Adds reset facets link."
msgstr "Dodaje odsyłacz do resetowania aspektów."

msgid "When checked, this facet will add a link to reset enabled facets."
msgstr "Jeśli zaznaczysz tę opcję, aspekt doda odsyłacz do resetowania włączonych aspektów."

msgid "Show a summary of how many results were found"
msgstr "Pokazuj podsumowanie liczby znalezionych wyników"

msgid "When checked, this will show the amount of results found."
msgstr "Jeśli opcja jest zaznaczona, będzie wyświetlana liczba znalezionych wyników."

msgid "Show a summary of all selected facets"
msgstr "Pokazuj podsumowanie wszystkich wybranych aspektów"

msgid "When checked, this facet will show an imploded list of all selected facets."
msgstr "Jeśli zaznaczysz tę opcję, ten aspekt będzie wyświetlać implodowaną listę wszystkich wybranych aspektów."

msgid "Empty text"
msgstr "Pusty tekst"

msgid "No results found."
msgstr "Nie znaleziono żadnych wyników."

msgid "Show a text when there are no results"
msgstr "Pokazuj tekst, gdy nie ma żadnych wyników"

msgid "Show a text when there are no results, otherwise it will hide the block."
msgstr "Pokazuj tekst, gdy nie ma żadnych wyników. W przeciwnym razie ukrywaj blok."

msgid "Build stage"
msgstr "Etap budowania"

msgid "1 result found"
msgid_plural "@count results found"
msgstr[0] "Znaleziono 1 wynik"
msgstr[1] "Znalezione wyniki: @count"
msgstr[2] "Znalezione wyniki: @count"

