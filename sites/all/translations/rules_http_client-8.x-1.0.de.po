msgid "Rules HTTP Client"
msgstr "Regelt den HTTP-Client"

msgid "Provides an action for making http requests."
msgstr "Stellt eine Aktion zum Stellen von HTTP-Anforderungen bereit."

msgid "Rules"
msgstr "Rules"

msgid "Error while requsting url as Error code: %code and Message: %message."
msgstr "Fehler beim Anfordern von URL. Fehlercode: %code und Nachricht: %message."

msgid "Request HTTP data"
msgstr "HTTP-Daten anfordern"

msgid "Data"
msgstr "Daten"

msgid "URL"
msgstr "URL"

msgid "Url address where to post, get and delete request send."
msgstr "Die URL, an die POST-, GET- und DELETE-Anforderungen gesendet werden sollen."

msgid "Headers"
msgstr "Kopfzeilen"

msgid "Request headers to send as 'name: value' pairs, one per line (e.g., Accept: text/plain). See <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a> for more information."
msgstr "Anforderungsheader zum Senden als Name:Wert-Paare, eines pro Zeile (z. B. Accept: text/plain). Weitere Informationen finden Sie unter <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a>."

msgid "Method"
msgstr "Methode"

msgid "The HTTP request methods like'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH' etc."
msgstr "Die HTTP-Anforderungsmethoden wie 'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH' usw."

msgid "The request body, formatter as 'param=value&param=value&...' or one 'param=value' per line.."
msgstr "Der Anforderungshauptteil, formatiert als 'Parameter=Wert&Parameter=Wert&...' oder mit einem 'Parameter=Wert'-Paar pro Zeile."

msgid "Max Redirect"
msgstr "Max. Umleitung"

msgid "How many times a redirect may be followed."
msgstr "Gibt an, wie oft einer Umleitung gefolgt werden kann."

msgid "Timeout"
msgstr "Zeitüberschreitung"

msgid "The maximum number of seconds the request may take.."
msgstr "Die maximale Anzahl an Sekunden, die die Anforderung dauern kann."

msgid "HTTP data"
msgstr "HTTP-Daten"

