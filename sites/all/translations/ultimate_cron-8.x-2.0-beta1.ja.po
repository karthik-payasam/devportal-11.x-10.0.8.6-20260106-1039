msgstr "シリアル"

msgid "Launches scheduled jobs in the same thread and runs them consecutively."
msgstr "スケジュールに入れられたジョブを同じスレッドで起動し、連続的に実行します。"

msgid "Stores the last log entry (and only the last) in the cache."
msgstr "最新ログ項目 (のみ) をキャッシュに保管します。"

msgid "Lock #@original_lid was already closed and logged. Creating a new log entry #@lid"
msgstr "ロック #@original_lid は既に閉じられ、ログに記録されました。新規ログ項目 #@lid を作成しています"

msgid "@count_entries log entries removed for @jobs_count jobs"
msgstr "@jobs_count 個のジョブに関する @count_entries 個のログ項目が削除されました"

msgid "Invalid cleanup method: @method"
msgstr "クリーンアップ方法が無効です: @method"

msgid "Stores logs in the database."
msgstr "ログをデータベースに保管します。"

msgid "Next scheduled run at @datetime"
msgstr "次回実行予定: @datetime"

msgid "Comma separated list of crontab rules."
msgstr "crontab ルールのコンマ区切りリスト。"

msgid "Rule is invalid"
msgstr "ルールが無効です"

msgid "Use crontab rules for scheduling jobs."
msgstr "crontab ルールを使用してジョブのスケジュールを行います。"

msgid "Every @interval"
msgstr "@interval ごと"

msgid "Provides a set of predefined intervals for scheduling."
msgstr "スケジューリングのための一連の定義済み間隔を提供します。"

