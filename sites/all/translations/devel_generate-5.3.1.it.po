msgid "Finished @num elements and @num_translations translations created successfully."
msgstr "Elementi @num terminati e traduzioni @num_translations create correttamente."

msgid "Finished @num elements created successfully."
msgstr "Completata correttamente la creazione di @num elementi."

msgid "Finished with an error."
msgstr "Terminato con un errore."

msgid "Generate @label"
msgstr "Genera @label"

msgid "Generate"
msgstr "Genera"

msgid "Generate realistic items (content, users, menus, etc) to assist your site development and testing."
msgstr "Genera elementi realistici (contenuto, utenti, menu) per assistere lo sviluppo e l'esecuzione del test del sito."

msgid "Devel generate"
msgstr "Generazione Devel"

msgid "Devel Generate"
msgstr "Generazione Devel"

msgid "Generate test users, nodes, menus, taxonomy terms..."
msgstr "Genera utenti, nodi, menu, termini di tassonomia di test..."

msgid "Development"
msgstr "Sviluppo"

msgid "Administer devel_generate"
msgstr "Gestisci devel_generate"

msgid "Language"
msgstr "Lingua"

msgid "Select the primary language(s) for @items"
msgstr "Selezionare la lingua/e primarie per @items"

msgid "Disabled - requires Language module"
msgstr "Disabilitato - richiede il modulo Language"

msgid "Select the language(s) for translated @items"
msgstr "Selezionare le lingue per gli @items tradotti"

msgid "Translated @items will be created for each language selected."
msgstr "Gli @items tradotti verranno creati per ogni lingua selezionata."

msgid "Disabled - requires Content Translation module."
msgstr "Disabilitato - richiede il modulo Content Translation."

msgid "@permission"
msgstr "@permission"

msgid "Failed to generate elements due to \"%error\"."
msgstr "Impossibile generare gli elementi a causa di \"%error\"."

msgid "You do not have any content types that can be generated. <a href=\":create-type\">Go create a new content type</a>"
msgstr "Non è presente alcun tipo di contenuto che possa essere generati. <a href=\":create-type\">Crea un nuovo tipo di contenuto</a>"

msgid "Hidden"
msgstr "Nascosto"

msgid "Closed"
msgstr "Chiuso"

msgid "Open"
msgstr "Apri"

msgid "No comment fields"
msgstr "Nessun campo di commento"

msgid "Content type"
msgstr "Tipo di contenuto"

msgid "Comments"
msgstr "Commenti"

msgid "<strong>Delete all content</strong> in these content types before generating new content."
msgstr "<strong>Eliminare tutto il contenuto</strong> in questi tipi di contenuto prima di generare nuovi contenuti."

msgid "How many nodes would you like to generate?"
msgstr "Quanti nodi si desidera creare?"

msgid "Now"
msgstr "Adesso"

msgid "ago"
msgstr "fa"

msgid "How far back in time should the nodes be dated?"
msgstr "A quando tempo fa devono risalire i contenuti?"

msgid "Node creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "Le date di creazione dei nodi verranno distribuite in modo casuale dalla data e ora correnti a quelle selezionate."

msgid "Maximum number of comments per node."
msgstr "Numero massimo di commenti per nodo."

msgid "You must also enable comments for the content types you are generating. Note that some nodes will randomly receive zero comments. Some will receive the max."
msgstr "Occorre inoltre abilitare i commenti per i tipi di contenuto che si sta generando. Alcuni nodi riceveranno in modo casuale zero commenti. Alcuni riceveranno il numero massimo."

msgid "Maximum number of words in titles"
msgstr "Numero massimo di parole nei titoli"

msgid "Fields to leave empty"
msgstr "Campi da lasciare vuoti"

msgid "Enter the field names as a comma-separated list. These will be skipped and have a default value in the generated content."
msgstr "Immettere i nomi campo come elenco separato da virgole. Questi verranno ignorati e avranno un valore predefinito nel contenuto generato."

msgid "Base fields to populate"
msgstr "Campi di base da popolare"

msgid "Enter the field names as a comma-separated list. These will be populated."
msgstr "Immettere i nomi campo come elenco separato da virgole. Questi verranno popolati."

msgid "Prefix the title with the content type label."
msgstr "Anteporre un prefisso al titolo con l'etichetta di tipo contenuto."

msgid "This will not count against the maximum number of title words specified above."
msgstr "Questo non verrà conteggiato rispetto al numero massimo delle parole del titolo specificato sopra."

msgid "Requires path.module"
msgstr "Richiede path.module"

msgid "Add an url alias for each node."
msgstr "Aggiunge un alias URL per ogni nodo."

msgid "Add statistics for each node (node_counter table)."
msgstr "Aggiunge statistiche per ogni nodo (tabella node_counter)."

msgid "User ID"
msgstr "ID utente"

msgid "Name"
msgstr "Nome"

msgid "Role(s)"
msgstr "Ruoli"

msgid "Users"
msgstr "Utenti"

msgid "Select users for randomly assigning as authors of the generated content. Leave all unchecked to use a random selection of up to 50 users."
msgstr "Selezionare gli utenti per assegnarli in modo casuale come autori del contenuto generato. Lasciare tutto deselezionato per utilizzare una selezione casuale fino a 50 utenti."

msgid "Please select at least one content type"
msgstr "Seleziona almeno un tipo di contenuto"

msgid "Generating Content"
msgstr "Generazione del contenuto"

msgid "Deleted %count nodes."
msgstr "Eliminati %count nodi."

msgid "Completed @feedback nodes (@rate nodes/min)"
msgstr "Nodi @feedback completati (@rate nodi/min)"

msgid "No content types available"
msgstr "Nessun tipo di contenuto disponibile"

msgid "To delete content, please provide the content types (--bundles)"
msgstr "Per eliminare il contenuto, fornire i tipi di contenuto (--bundle)"

msgid "One or more content types have been entered that don't exist on this site"
msgstr "Immesso uno o più tipi di contenuto che non esistono su questo sito"

msgid "Created 1 node"
msgid_plural "Created @count nodes"
msgstr[0] "Creato il nodo 1"
msgstr[1] "Creati @count nodi"

msgid "Created 1 node translation"
msgid_plural "Created @count node translations"
msgstr[0] "Creata la traduzione del nodo 1"
msgstr[1] "Create le traduzioni di @count nodi"

msgid "content"
msgstr "contenuto"

msgid "Generate a given number of content. Optionally delete current content."
msgstr "Generare un dato numero di contenuti. È possibile eliminare il contenuto corrente."

msgid "You do not have any media types that can be generated. <a href=\":url\">Go create a new media type</a>"
msgstr "Non si dispone di tipi di supporto che possono essere generati. <a href=\":url\">Passare a Crea un nuovo tipo di supporto</a>"

msgid "Media type"
msgstr "Tipo di contenuto multimediale"

msgid "<strong>Delete all media</strong> in these types before generating new media."
msgstr "<strong>Elimina tutti i supporti</strong> in questi tipi prima di generare nuovi supporti."

msgid "How many media items would you like to generate?"
msgstr "Quanti elementi supporto si desidera generare?"

msgid "How far back in time should the media be dated?"
msgstr "A quale data devono risalire i supporti?"

msgid "Media creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "Le date di creazione dei supporti verranno distribuite in modo casuale dal momento corrente, andando indietro nel tempo selezionato."

msgid "Maximum number of words in names"
msgstr "Numero massimo di parole nei nomi"

msgid "Set language on media"
msgstr "Imposta lingua sui supporti"

msgid "Requires locale.module"
msgstr "Richiede locale.module"

msgid "Please select at least one media type"
msgstr "Selezionare almeno un tipo di supporto."

msgid "Generating media items"
msgstr "Generazione elementi supporto"

msgid "Deleted %count media items."
msgstr "Eliminati %count elementi multimediali."

msgid "Completed !feedback media items (!rate media/min)"
msgstr "Completati !feedback elementi supporto (!velocità supporti/min)"

msgid "No media types available"
msgstr "Non è disponibile nessun tipo di supporto"

msgid "1 media item created."
msgid_plural "Finished creating @count media items."
msgstr[0] "Creato elemento supporto 1"
msgstr[1] "Terminata la creazione di @count elementi supporto"

msgid "media"
msgstr "supporti"

msgid "Generate a given number of media entities."
msgstr "Generare un determinato numero di entità di supporto"

msgid "Create new menu(s)"
msgstr "Crea nuovi menu"

msgid "Generate links for these menus"
msgstr "Genera link per tali menu"

msgid "Number of new menus to create"
msgstr "Numero di menu da creare"

msgid "Number of links to generate"
msgstr "Numero di link da generare"

msgid "Maximum length for menu titles and menu links"
msgstr "Lunghezza massima per i titoli del menu e per i link del menu"

msgid "Text will be generated at random lengths up to this value. Enter a number between 2 and 128."
msgstr "Il testo verrà generato di lunghezza casuale fino a questo valore. Immettere un numero compreso tra 2 e 128."

msgid "Types of links to generate"
msgstr "Tipi di link da generare"

msgid "Nodes"
msgstr "Nodi"

msgid "Front page"
msgstr "Prima pagina"

msgid "External"
msgstr "Esterno"

msgid "Maximum link depth"
msgstr "Profondità massima del link"

msgid "Maximum menu width"
msgstr "Larghezza massima del menu"

msgid "Limit the width of the generated menu's first level of links to a certain number of items."
msgstr "Limita la larghezza di primo livello del menu di link generato ad un determinato numero di elementi."

msgid "Delete existing custom generated menus and menu links before generating new ones."
msgstr "Elimina i menu generati in modo personalizzato esistenti ed i link dei menu prima di generare nuovi menu."

msgid "Deleted @menus_deleted menu(s) and @links_deleted other link(s)."
msgstr "Eliminati @menus_deleted menu e altri @links_deleted link."

msgid "Description of @name"
msgstr "Descrizione di @name"

msgid "Description of @title."
msgstr "Descrizione di @title."

msgid "Invalid number of menus"
msgstr "Numero di menu non valido"

msgid "Invalid number of links"
msgstr "Numero di link non valido"

msgid "Invalid maximum link depth. Use a value between 1 and 9"
msgstr "Profondità massima di link non valida. Utilizzare un valore compreso tra 1 e 9"

msgid "Invalid maximum menu width. Use a positive numeric value."
msgstr "Larghezza massimo del menu non valida. Utilizzare un valore numerico positivo."

msgid "Created the following 1 new menu: @menus"
msgid_plural "Created the following @count new menus: @menus"
msgstr[0] "Creato il seguente nuovo menu 1: @menus"
msgstr[1] "Creato i seguenti @count nuovi menu: @menus"

msgid "menus"
msgstr "menu"

msgid "Generate a given number of menus and menu links. Optionally delete current menus."
msgstr "Generare un determinato numero di menu e link di menu. È possibile eliminare i menu correnti."

msgid "Vocabularies"
msgstr "Vocabolari"

msgid "Restrict terms to these vocabularies."
msgstr "Limitare i termini a questi vocabolari."

msgid "Number of terms"
msgstr "Numero di termini"

msgid "Maximum number of characters in term names"
msgstr "Numero massimo di caratteri nei nomi dei termini"

msgid "Minimum depth for new terms in the vocabulary hierarchy"
msgstr "Profondità massima per i nuovi termini nella gerarchia del vocabolario"

msgid "Enter a value from 1 to 20."
msgstr "Immettere un valore da 1 a 20"

msgid "Maximum depth for new terms in the vocabulary hierarchy"
msgstr "Profondità massima per nuovi termini nella gerarchia del vocabolario"

msgid "Delete existing terms in specified vocabularies before generating new terms."
msgstr "Eliminare i termini esistenti nei vocabolari specificati prima di generare nuovi termini."

msgid "In vocabulary @vlabel: @termlist"
msgstr "Nel vocabolario @vlabel: @termlist"

msgid "In vocabulary @vlabel: No terms created"
msgstr "Nel vocabolario @vlabel: nessun termine creato"

msgid "Minimum depth changed from @min_depth to 1 because all terms were deleted"
msgstr "La profondità minima è stata modificata da @min_depth a 1 perché tutti i termini sono stati eliminati"

msgid "Please provide a vocabulary machine name (--bundles)."
msgstr "Fornire un nome macchina vocabolario (--bundle)."

msgid "Invalid vocabulary machine name: @name"
msgstr "Nome macchina vocabolario non valido: @name"

msgid "Invalid number of terms: @num"
msgstr "Numero non valido di termini: @num"

msgid "The depth values must be in the range 1 to 20 and min-depth cannot be larger than max-depth (values given: min-depth @min, max-depth @max)"
msgstr "I valori della profondità devono essere compresi nell'intervallo da 1 a 20 e la profondità minima non può essere superiore alla lunghezza massima (valori forniti: min-depth @min, max-depth @max)"

msgid "Created 1 new term"
msgid_plural "Created @count new terms"
msgstr[0] "Creato 1 nuovo termine"
msgstr[1] "Creati @count nuovi termini"

msgid "1 new term at level @level (@terms)"
msgid_plural "@count new terms at level @level (@terms)"
msgstr[0] "1 nuovo termine a livello @level (@terms)"
msgstr[1] "@count nuovi termini a livello @level (@terms)"

msgid "Created 1 term translation"
msgid_plural "Created @count term translations"
msgstr[0] "Creata la traduzione del termine 1"
msgstr[1] "Create @count traduzioni del termine"

msgid "Deleted 1 existing term"
msgid_plural "Deleted @count existing terms"
msgstr[0] "Eliminato 1 termine esistente"
msgstr[1] "Eliminati @count termini esistenti"

msgid "terms"
msgstr "termini"

msgid "Generate a given number of terms. Optionally delete current terms."
msgstr "Generare un dato numero di termini. È possibile eliminare i termini correnti."

msgid "How many users would you like to generate?"
msgstr "Quanti nodi si desidera generare?"

msgid "Delete all users (except user id 1) before generating new users."
msgstr "Eliminare tutti gli utenti (tranne id utente 1) prima di generare nuovi utenti."

msgid "Which roles should the users receive?"
msgstr "Quali ruoli devono ricevere gli utenti?"

msgid "Users always receive the <em>authenticated user</em> role."
msgstr "Gli utenti ricevono sempre il ruolo <em>utente autenticato</em>."

msgid "Password to be set"
msgstr "Password da impostare"

msgid "Leave this field empty if you do not need to set a password"
msgstr "Lasciare questo campo vuoto se non è necessario impostare una password"

msgid "How old should user accounts be?"
msgstr "A quando devono risalire gli account utente?"

msgid "User ages will be distributed randomly from the current time, back to the selected time."
msgstr "Le date di creazione degli utenti verranno distribuite in modo casuale dalla data e ora correnti a quelle selezionate."

msgid "@num_users created."
msgstr "@num_users creati."

msgid "1 user deleted"
msgid_plural "@count users deleted."
msgstr[0] "1 utente eliminato"
msgstr[1] "@count utenti eliminati."

msgid "1 user"
msgid_plural "@count users"
msgstr[0] "1 utente"
msgstr[1] "@count users"

msgid "users"
msgstr "utenti"

msgid "Generate a given number of users. Optionally delete current users."
msgstr "Generare un determinato numero di utenti. È possibile eliminare gli utenti correnti."

msgid "Number of vocabularies?"
msgstr "Numero di vocabolari?"

msgid "Maximum number of characters in vocabulary names"
msgstr "Numero massimo di caratteri nei nomi del vocabolario"

msgid "Delete existing vocabularies before generating new ones."
msgstr "Eliminare i vocabolari esistenti prima di generarne di nuovi."

msgid "Deleted existing vocabularies."
msgstr "Vocabolari esistenti eliminati."

msgid "Created the following new vocabularies: @vocs"
msgstr "Creati i seguenti nuovi vocabolari: @vocs"

msgid "Invalid number of vocabularies: @num."
msgstr "Numero non valido di vocabolari: @num"

msgid "vocabularies"
msgstr "vocabolari"

msgid "Generate a given number of vocabularies. Optionally delete current vocabularies."
msgstr "Generare un determinato numero di vocabolari. È possibile eliminare i vocabolari correnti."

