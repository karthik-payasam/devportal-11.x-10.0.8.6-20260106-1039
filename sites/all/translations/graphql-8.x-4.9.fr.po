msgid "About"
msgstr "À propos"

msgid ""
"\n"
"<p>This module generates and exposes a\n"
"  <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a> schema for\n"
"  <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a> entities,\n"
"  and allows you to expose your own custom schema in a consistent way and with\n"
"  minimal effort.</p>"
msgstr ""
"\n"
"<p>Ce module génère et expose un schéma\n"
"  <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a> pour des entités\n"
"  <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a>,\n"
"  et vous permet d'exposer votre propre schéma personnalisé de façon cohérente et avec un\n"
"  minimum d'efforts.</p>"

