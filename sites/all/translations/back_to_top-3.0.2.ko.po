msgid "Back To Top"
msgstr "맨 위로 돌아가기"

msgid "Back To Top adds a button that hovers in the bottom of your screen and allow users to smoothly scroll up the page using jQuery."
msgstr "맨 위로 돌아가기는 마우스로 가리킬 때 화면의 맨 아래에 표시되는 단추를 추가하며 사용자가 jQuery를 사용하여 페이지를 원활하게 위로 스크롤할 수 있도록 합니다."

msgid "User interface"
msgstr "사용자 환경"

msgid "Back to Top"
msgstr "맨 위로 돌아가기"

msgid "Administer Back To Top settings."
msgstr "맨 위로 돌아가기 설정을 관리합니다."

msgid "Back to top settings"
msgstr "맨 위로 돌아가기 설정"

msgid "Access Back to top settings"
msgstr "맨 위로 돌아가기 설정 액세스"

msgid "Prevent on mobile and touch devices"
msgstr "모바일 및 터치 디바이스에서 금지"

msgid "Prevent on administration pages and node edit"
msgstr "관리 페이지 및 노드 편집에서 금지"

msgid "Prevent on front page"
msgstr "프론트 페이지에서 금지"

msgid "Trigger"
msgstr "트리거(Trigger)"

msgid "Placement"
msgstr "배치"

msgid "Button text"
msgstr "단추 텍스트"

msgid "Button type"
msgstr "단추 유형"

msgid "Background color"
msgstr "배경색"

msgid "Border color"
msgstr "테두리 색상"

msgid "Hover color"
msgstr "풍선 색상"

msgid "Text color"
msgstr "텍스트 색깔"

msgid "Back to top"
msgstr "맨 위로 돌아가기"

msgid "Don´t show Back To Top-button on screen width up to 760px."
msgstr "스크린 너비가 760px 이하인 경우 맨 위로 돌아가기 버튼을 표시하지 않습니다."

msgid "Do you want to prevent Back To Top on admin pages?"
msgstr "관리 페이지에서 맨 위로 돌아가기를 금지하시겠습니까?"

msgid "Do you want to prevent Back To Top on front page?"
msgstr "프론트 페이지에서 맨 위로 돌아가기를 금지하시겠습니까?"

msgid "Set the number of pixel which trigger the Back To Top button default 100"
msgstr "맨 위로 돌아가기 단추를 트리거하는 픽셀 수 설정(기본값 100)"

msgid "Where should the Back To Top button appear?"
msgstr "맨 위로 돌아가기가 어디에 표시되어야 합니까?"

msgid "Bottom right"
msgstr "하단 우측"

msgid "Bottom left"
msgstr "하단 좌측"

msgid "Bottom center"
msgstr "하단 가운데"

msgid "Top right"
msgstr "상단 우측"

msgid "Top left"
msgstr "상단 좌측"

msgid "Top center"
msgstr "상단 가운데"

msgid "Mid right"
msgstr "오른쪽 중간"

msgid "Mid left"
msgstr "왼쪽 중간"

msgid "Mid center"
msgstr "정가운데"

msgid "Set the text of the Back To Top button"
msgstr "맨 위로 돌아가기 단추의 텍스트 설정"

msgid "Do you want Back To Top to use a PNG-24 image or a Text/Css button?"
msgstr "맨 위로 돌아가기가 PNG-24 이미지 또는 텍스트/CSS 단추를 사용하도록 하시겠습니까?"

msgid "Image (default)"
msgstr "이미지(기본값)"

msgid "Text/Css"
msgstr "텍스트/CSS"

msgid "Text/Css button settings"
msgstr "텍스트/CSS 단추 설정"

msgid "Button background color default #F7F7F7"
msgstr "단추 배경색 기본값 #F7F7F7"

msgid "Border color default #CCCCCC"
msgstr "테두리 색상 기본값 #CCCCCC"

msgid "Hover color default #EEEEEE"
msgstr "풍선 색상 기본값 #EEEEEE"

msgid "Text color default #333333"
msgstr "텍스트 색상 기본값 #333333"

