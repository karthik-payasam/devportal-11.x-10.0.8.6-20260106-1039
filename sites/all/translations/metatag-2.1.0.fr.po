msgstr "Les routes d'administration ne doivent pas comporter de balises meta."

msgid "The entities routes metatags must be added by fields. @entity_type - @id"
msgstr "Les balises meta des routes d'entités doivent être ajoutées par zones. @entity_type - @id"

