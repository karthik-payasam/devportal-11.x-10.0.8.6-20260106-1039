msgid "All Product entries deleted."
msgstr "Tutte le voci del prodotto eliminate."

msgid "Drush @func No Product provided"
msgstr "@func di Drush, nessun prodotto fornito"

msgid "Drush DeleteProduct deleted Product @prod"
msgstr "DeleteProduct di Drush ha eliminato il prodotto @prod"

msgid "Drush DeleteProduct could not find Product @prod"
msgstr "DeleteProduct di Drush non trova il prodotto @prod"

msgid "Drush DeleteProduct deleted retired API @api"
msgstr "DeleteProduct di Drush ha eliminato l'API ritirata @api"

msgid "Drush DeleteProduct No Product provided."
msgstr "DeleteProduct di Drush non ha fornito alcun prodotto."

msgid "Drush product supersede : found a product in a strange lifecycle state '@state'. Expected 'published' or 'deprecated'."
msgstr "Sostituzione prodotto Drush : trovato un prodotto in uno stato ciclo di vita sconosciuto '@state'.. Previsto 'pubblicato' o 'obsoleto'."

msgid "Drush SupersedeProduct deleted retired API @api"
msgstr "Drush SupersedeProduct ha eliminato l'API ritirata @api"

msgid "Drush product supersede : incorrect number of applications with url '@url' found. Should be 1 but was @count."
msgstr "Sostituzione prodotto Drush : è stato rilevato un numero non corretto di applicazioni con URL '@url'. Deve essere 1 ma era @count."

msgid "Drush product supersede : incorrect number of products found. Should be 2 but was @count."
msgstr "Sostituzione prodotto Drush: rilevato un numero non corretto di prodotti. Dovrebbe essere 2, ma era @count."

msgid "Drush product supersede : no content provided."
msgstr "Sostituzione prodotto Drush: nessun contenuto fornito."

msgid "Drush ReplaceProduct deleted retired API @api"
msgstr "Drush ReplaceProduct ha eliminato l'API ritirata @api"

msgid "Drush product replace : found a product in a strange lifecycle state '@state'. Expected 'published', 'deprecated' or 'retired'."
msgstr "Sostituzione prodotto Drush : trovato un prodotto in uno stato ciclo di vita imprevisto '@state'. Previsto 'published', 'deprecated' o 'retired'."

msgid "Drush product replace : incorrect number of products found. Should be 2 but was @count."
msgstr "Sostituzione prodotto Drush: rilevato un numero non corretto di prodotti. Dovrebbe essere 2, ma era @count."

msgid "Invalid plan found with empty plan name. Contact your system administrator"
msgstr "Trovato un piano non valido con un nome piano vuoto. Rivolgersi all'amministratore del sistema."

