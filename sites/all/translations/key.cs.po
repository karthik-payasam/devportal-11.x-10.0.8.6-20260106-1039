msgid "File key provider settings updated."
msgstr "Byla aktualizována nastavení poskytovatele souborových klíčů."

msgid "Key configuration overrides updated."
msgstr "Byla aktualizována potlačení konfigurace klíčů."

msgid "Key"
msgstr "Klíč"

msgid "Provides the ability to manage site-wide keys."
msgstr "Umožňuje spravovat klíče pro celý web."

msgid "Security"
msgstr "Bezpečnost"

msgid "Add Key"
msgstr "Přidat klíč"

msgid "Add Override"
msgstr "Přidat potlačení"

msgid "Keys"
msgstr "Klíče"

msgid "Manage site-wide keys."
msgstr "Spravovat klíče pro celý web."

msgid "Key Overrides"
msgstr "Potlačení klíčů"

msgid "Administer keys"
msgstr "Spravovat klíče"

msgid "Create, edit, and delete site-wide keys."
msgstr "Vytvářejte, upravujte a odstraňujte klíče pro celý web."

msgid "Administer key configuration overrides"
msgstr "Spravovat potlačení konfigurace klíčů"

msgid "Add key"
msgstr "Přidat klíč"

msgid "Edit key"
msgstr "Upravit klíč"

msgid "Delete Key"
msgstr "Odstranit klíč"

msgid "Key Configuration Overrides"
msgstr "Potlačení konfigurace klíčů"

msgid "Add a key configuration override"
msgstr "Přidat potlačení konfigurace klíčů"

msgid "Delete Key Configuration Override"
msgstr "Odstranit potlačení konfigurace klíčů"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "Popisek"

msgid "Description"
msgstr "Popis"

msgid "Key type"
msgstr "Typ klíče"

msgid "Key type settings"
msgstr "Nastavení typu klíče"

msgid "Key provider"
msgstr "Poskytovatel klíčů"

msgid "Key provider settings"
msgstr "Nastavení poskytovatele klíčů"

msgid "Key input"
msgstr "Vstup klíče"

msgid "Key input settings"
msgstr "Nastavení vstupu klíče"

msgid "Encryption key type settings"
msgstr "Nastavení typu šifrovacího klíče"

msgid "Key size"
msgstr "Velikost klíče"

msgid "Configuration key provider settings"
msgstr "Nastavení poskytovatele konfiguračního klíče"

msgid "Key value"
msgstr "Hodnota klíče"

msgid "Base64-encoded"
msgstr "V kódování Base64"

msgid "File key provider settings"
msgstr "Nastavení poskytovatele souborových klíčů"

msgid "File location"
msgstr "Umístění souboru"

msgid "Strip trailing line breaks"
msgstr "Oříznout koncová zalomení řádku"

msgid "Environment key provider settings"
msgstr "Nastavení poskytovatele klíčů prostředí"

msgid "Environment variable"
msgstr "Proměnná prostředí"

msgid "Text field key input settings"
msgstr "Nastavení vstupu klíče textového pole"

msgid "Textarea field key input settings"
msgstr "Nastavení vstupu klíče pole textové oblasti"

msgid "Generate key input settings"
msgstr "Vygenerovat nastavení vstupu klíče"

msgid "Generated"
msgstr "Vygenerováno"

msgid "Display once"
msgstr "Zobrazit jednou"

msgid "Key Configuration Override"
msgstr "Potlačení konfigurace klíče"

msgid "Configuration type"
msgstr "Typ konfigurace"

msgid "Configuration prefix"
msgstr "Předpona konfigurace"

msgid "Configuration name"
msgstr "Název konfigurace"

msgid "Configuration item"
msgstr "Položka konfigurace"

msgid "Key ID"
msgstr "ID klíče"

msgid "Commands for managing keys"
msgstr "Příkazy pro správu klíčů"

msgid "Save a key. If a key value is defined and the key provider supports setting values, it will be saved. If any options are omitted, default values will be used."
msgstr "Uložit klíč. Je-li hodnota klíče definována a poskytovatel klíče podporuje nastavení hodnot, bude uložena. Při vynechání kterékoli z voleb bude použita výchozí hodnota."

msgid "Save a key."
msgstr "Uložit klíč. "

msgid "The ID (machine name) of the key to save."
msgstr "ID (počítačový název) klíče, který má být uložen."

msgid "A key value to save. May or may not be allowed or required, depending on the key provider"
msgstr "Hodnota klíče, který má být uložen. V závislosti na poskytovateli klíče může a nemusí být povolena a vyžadována"

msgid "Delete a key."
msgstr "Odstranit klíč."

msgid "The ID (machine name) of the key to delete."
msgstr "ID klíče (počítačový název) klíče, který má být odstraněn."

msgid "Display a list of available keys."
msgstr "Zobrazit seznam dostupných klíčů."

msgid "An optional, comma-delimited list of key types. To see a list of available key types, use `drush key-type-list`."
msgstr "Volitelný seznam typů klíčů s položkami oddělenými čárkou. Seznam dostupných typů klíčů zobrazíte příkazem `drush key-type-list`."

msgid "An optional, comma-delimited list of key providers. To see a list of available key providers, use `drush key-provider-list`."
msgstr "Volitelný seznam poskytovatelů klíčů s položkami oddělenými čárkou. Seznam dostupných poskytovatelů klíčů zobrazíte příkazem `drush key-provider-list`."

msgid "Display a list of available key types."
msgstr "Zobrazit seznam dostupných typů klíčů."

msgid "An optional key type group on which to filter."
msgstr "Volitelná skupina typů klíčů, která má být použita k filtrování."

msgid "Display a list of available key providers."
msgstr "Zobrazit seznam dostupných poskytovatelů klíčů."

msgid "An optional key provider storage method on which to filter."
msgstr "Volitelná metoda uložení poskytovatele klíčů, která má být použita k filtrování."

msgid "Get a key value."
msgstr "Získat hodnotu klíče."

msgid "The ID (machine name) of the key whose value should be retrieved."
msgstr "ID (počítačový název) klíče, jehož hodnota má být načtena."

msgid "Base64-encode the key value. This is useful in the case of binary encryption keys that would otherwise not be displayed in a readable way."
msgstr "Zakódovat hodnotu klíče kódováním Base64. To je užitečné pro binárně zašifrované klíče, které by jinak nebylo možné zobrazit v čitelné podobě."

msgid "Print just the key value, and nothing else."
msgstr "Vytisknout pouze hodnotu klíče a nic jiného."

msgid "The human-readable label of the key."
msgstr "Popisek klíče čitelný člověkem."

msgid "A short description of the key."
msgstr "Krátký popis klíče."

msgid "The key type. To see a list of available key types, use `drush key-type-list`."
msgstr "Typ klíče. Seznam dostupných typů klíčů zobrazíte příkazem `drush key-type-list`."

msgid "Settings specific to the defined key type, in JSON format."
msgstr "Nastavení specifická pro definovaný typ klíče uvedená ve formátu JSON."

msgid "The key provider. To see a list of available key providers, use `drush key-provider-list`."
msgstr "Poskytovatel klíče. Seznam dostupných poskytovatelů klíčů zobrazíte příkazem `drush key-provider-list`."

msgid "Settings specific to the defined key provider, in JSON format."
msgstr "Nastavení specifická pro definovaného poskytovatele klíče uvedená ve formátu JSON."

msgid "The key input method."
msgstr "Metoda vstupu klíče."

msgid "Settings specific to the defined key input, in JSON format."
msgstr "Nastavení specifická pro definovaný vstup klíče uvedená ve formátu JSON."

msgid "Key !id does not exist."
msgstr "!id klíče neexistuje."

msgid "Be extremely careful when deleting a key! It may result in losing access to a service or making encrypted data unreadable."
msgstr "Při odstraňování klíče postupujte velmi obezřetně! Výsledkem může být ztráta přístupu k určité službě nebo znečitelnění zašifrovaných dat."

msgid "The following key will be deleted: !id"
msgstr "Bude odstraněn tento klíč: !id"

msgid "Do you really want to continue?"
msgstr "Opravdu chcete pokračovat?"

msgid "Key !id was not deleted."
msgstr "Klíč !id nebyl odstraněn."

msgid "Key !id was deleted successfully."
msgstr "Klíč !id byl úspěšně odstraněn."

msgid "Key !id exists; specify --overwrite to overwrite."
msgstr "Klíč !id existuje. Chcete-li jej přepsat, zadejte volbu --overwrite."

msgid "Be extremely careful when overwriting a key! It may result in losing access to a service or making encrypted data unreadable."
msgstr "Při přepisování klíče postupujte velmi obezřetně! Výsledkem může být ztráta přístupu k určité službě nebo znečitelnění zašifrovaných dat."

msgid "The following key will be saved: !id"
msgstr "Bude uložen tento klíč: !id"

msgid "Key !id was not saved."
msgstr "Klíč !id nebyl uložen."

msgid "Key !id was saved successfully."
msgstr "Klíč !id byl úspěšně uložen."

msgid "User name"
msgstr "Uživatelské jméno"

msgid "Password"
msgstr "Heslo"

msgid "The following key will be overwritten: !id"
msgstr "Tento klíč bude přepsán: !id"

msgid "Do you want to continue?"
msgstr "Chcete pokračovat?"

msgid "The key type. To see a list of available key types, use `drush key:type-list`."
msgstr "Typ klíče. Seznam dostupných typů klíčů zobrazíte příkazem `drush key:type-list`."

msgid "The key provider. To see a list of available key providers, use `drush key:provider-list`."
msgstr "Poskytovatel klíče. Seznam dostupných poskytovatelů klíčů zobrazíte příkazem `drush key:provider-list`."

msgid "Override name"
msgstr "Název potlačení"

msgid "Configuration"
msgstr "Nastavení"

msgid "No key configuration overrides are available. <a href=\":link\">Add an override</a>."
msgstr "Nejsou k dispozici žádná potlačení konfigurace klíčů. <a href=\":link\">Přidat potlačení</a>."

msgid "Type"
msgstr "Typ"

msgid "Provider"
msgstr "Poskytovatel"

msgid "Overrides"
msgstr "Potlačuje"

msgid "Add Config Override"
msgstr "Přidat potlačení konfigurace"

msgid "No keys are available. <a href=\":link\">Add a key</a>."
msgstr "Nejsou k dispozici žádné klíče. <a href=\":link\">Přidat klíč</a>."

msgid "- Select a key -"
msgstr "- Vyberte klíč -"

msgid "Choose an available key. If the desired key is not listed, <a href=\":link\">create a new key</a>."
msgstr "Vyberte dostupný klíč. Pokud se požadovaný klíč nezobrazuje, <a href=\":link\">vytvořte nový klíč</a>."

msgid "Key configuration override name"
msgstr "Název potlačení konfigurace klíčů"

msgid "A human readable name for this override."
msgstr "Název tohoto potlačení čitelný pro člověka."

msgid "Simple configuration"
msgstr "Jednoduchá konfigurace"

msgid "Clear overridden value"
msgstr "Vymazat potlačenou hodnotu"

msgid "Check this field to clear any existing value for the overridden configuration item. This is important to make sure potentially sensitive data is removed from the configuration."
msgstr "Zaškrtnutím tohoto pole vymažete veškeré existující hodnoty pro položku potlačené konfigurace. To je důležité k bezpečnému odstranění potenciálně citlivých dat z konfigurace."

msgid "- Select -"
msgstr "- Vyberte -"

msgid "@label (@id)"
msgstr "@label (@id)"

msgid "Are you sure you want to delete the override %name?"
msgstr "Opravdu chcete odstranit potlačení %name?"

msgid "Delete"
msgstr "Smazat"

msgid "The override %name has been deleted."
msgstr "Potlačení %name bylo odstraněno."

msgid "Are you sure you want to delete the key %key?"
msgstr "Opravdu chcete odstranit klíč %key?"

msgid "The key %label has been deleted."
msgstr "Klíč %label byl odstraněn."

msgid "Edit key %label"
msgstr "Upravit klíč %label"

msgid "Be extremely careful when editing a key! It may result in broken site functionality. Are you sure you want to edit this key?"
msgstr "Při upravování klíče postupujte velmi obezřetně! Může dojít k poškození funkcí webu. Opravdu chcete provést úpravu tohoto klíče?"

msgid "Edit"
msgstr "Upravit"

msgid "Cancel"
msgstr "Zrušit"

msgid "Key name"
msgstr "Název klíče"

msgid "Type settings"
msgstr "Nastavení typu"

msgid "Provider settings"
msgstr "Nastavení poskytovatele"

msgid "Value"
msgstr "Hodnota"

msgid "Key value settings"
msgstr "Nastavení hodnoty klíče"

msgid "The key %name has been updated."
msgstr "Klíč %name byl aktualizován."

msgid "The key %name has been added."
msgstr "Klíč %name byl přidán."

msgid "The key value has already been generated and will not be changed."
msgstr "Hodnota klíče již byla vygenerována a nebude změněna."

msgid "The key value will be automatically generated using the selected key type settings."
msgstr "Hodnota klíče bude automaticky vygenerována s použitím zvolených nastavení typu klíče."

msgid "Display value"
msgstr "Zobrazit hodnotu"

msgid "Check this to display the generated value once."
msgstr "Zaškrtnete-li tuto volbu, vygenerovaná hodnota se jednou zobrazí."

msgid "A key value of the requested type has been generated and is displayed below as a Base64-encoded string. You will need to decode it to get the actual key value, which may or may not be human-readable. The key value will not be displayed again, so take note of it now, if necessary.<br>%key_value"
msgstr "Hodnota klíče požadovaného typu byla vygenerována a zobrazuje se jako řetězec zakódovaný kódem Base64. Budete-li chtít získat skutečnou hodnotu kódu, musíte tento řetězec dekódovat. Je možné, že poté kód nebude možné zobrazit. Hodnota klíče se již nezobrazí, takže si ji nyní podle potřeby poznamenejte.<br>%key_value"

msgid "Generate"
msgstr "Generovat"

msgid "A key input that generates a key value."
msgstr "Vstup klíče, který generuje hodnotu klíče."

msgid "The selected key provider does not accept a value. See the provider's description for instructions on how and where to store the key value."
msgstr "Vybraný poskytovatel klíče neakceptuje určitou hodnotu. Pokyny k metodě a místě uložení hodnoty klíče naleznete v pokynech poskytovatele."

msgid "None"
msgstr "Žádné"

msgid "A key input for providers that don't accept a value."
msgstr "Vstup klíče pro poskytovatele, kteří neakceptují určitou hodnotu."

msgid "Check this if the key value being submitted has been Base64-encoded."
msgstr "Tuto volbu zaškrtněte, pokud je zadávaná hodnota klíče zakódovaná kódem Base64."

msgid "Text field"
msgstr "Textové pole"

msgid "A simple text field."
msgstr "Jednoduché textové pole."

msgid "Textarea field"
msgstr "Pole Textová oblast"

msgid "A simple textarea field."
msgstr "Jednoduché pole textové oblasti."

msgid "Checking this will store the key with Base64 encoding."
msgstr "Zaškrtnete-li tuto volbu, dojde k uložení klíče v kódování Base64."

msgid "The Configuration key provider stores the key in Drupal's configuration system."
msgstr "Poskytovatel klíče konfigurace ukládá klíč do konfiguračního systému Drupal."

msgid "Name of the environment variable."
msgstr "Název proměnné prostředí."

msgid "Check this to remove any trailing line breaks from the variable. Leave unchecked if there is a chance that a line break could be a valid character in the key."
msgstr "Tuto volbu zaškrtněte, chcete-li z této proměnné odebrat všechna koncová zalomení řádku. Ponechte volbu nezaškrtnutou, je-li možnost, že konec řádku je platným znakem klíče."

msgid "Check this if the key in the variable is Base64-encoded."
msgstr "Tuto volbu zaškrtněte, je-li klíč v proměnné zakódován kódem Base64."

msgid "The environment variable does not exist or it is empty."
msgstr "Proměnná prostředí neexistuje nebo je prázdná."

msgid "Environment"
msgstr "Prostředí"

msgid "The Environment key provider allows a key to be retrieved from an environment variable."
msgstr "Poskytovatel klíčů prostředí umožňuje načtení klíče z proměnné prostředí."

msgid "The location of the file in which the key will be stored. The path may be absolute (e.g., %abs), relative to the Drupal directory (e.g., %rel), or defined using a stream wrapper (e.g., %str)."
msgstr "Umístění souboru, v němž bude klíč uložen. Cesta může být absolutní (např. %abs), relativní vzhledem k adresáři Drupal (např. relative %rel) nebo definovaná pomocí obálky proudu (např. %str)."

msgid "Check this to remove any trailing line breaks from the file. Leave unchecked if there is a chance that a line break could be a valid character in the key."
msgstr "Tuto volbu zaškrtněte, chcete-li z tohoto souboru odebrat všechna koncová zalomení řádku. Ponechte volbu nezaškrtnutou, je-li možnost, že konec řádku je platným znakem klíče."

msgid "Check this if the key in the file is Base64-encoded."
msgstr "Tuto volbu zaškrtněte, je-li klíč v souboru zakódován kódem Base64."

msgid "There is no file at the specified location."
msgstr "V zadaném umístění není žádný soubor."

msgid "The file at the specified location is not readable."
msgstr "Soubor v zadaném umístění nelze číst."

msgid "File"
msgstr "Soubor"

msgid "The File key provider allows a key to be stored in a file, preferably outside of the web root."
msgstr "Poskytovatel souborového klíče umožňuje uložení klíče do souboru, nejlépe mimo kořenový adresář webu."

msgid "Authentication"
msgstr "Ověření"

msgid "A generic key type to use for a password or API key that does not belong to any other defined key type."
msgstr "Generický typ klíče k použití pro heslo nebo klíč rozhraní API, který nepatří do žádného jiného definovaného typu klíče."

msgid "The key value does not contain valid JSON."
msgstr "Hodnota klíče neobsahuje platný kód JSON."

msgid "The key value is missing the field %field."
msgstr "Hodnota klíče postrádá pole %field."

msgid "The key value field %field is empty."
msgstr "Pole hodnoty klíče %field je prázdné."

msgid "Authentication (Multivalue)"
msgstr "Ověření (vícehodnotové)"

msgid "A generic key type to use for an authentication key that contains multiple values."
msgstr "Generický typ klíče, který se má použít jako ověřovací klíč a který obsahuje více hodnot."

msgid "The size of the key in bits, with 8 bits per byte."
msgstr "Velikost klíče v bitech s 8 bity v bajtu."

msgid "Other"
msgstr "Jiné"

msgid "Key size (other value)"
msgstr "Velikost klíče (jiná hodnota)"

msgid "Enter a custom key size in bits."
msgstr "Zadejte vlastní velikost klíče v bitech."

msgid "The selected key size does not match the actual size of the key."
msgstr "Vybraná velikost klíče neodpovídá skutečné velikosti klíče."

msgid "Encryption"
msgstr "Šifrování"

msgid "A generic key type to use for an encryption key that does not belong to any other defined key type."
msgstr "Generický typ klíče, který má být použit pro šifrovací klíč, který nepatří do žádného jiného definovaného typu klíče."

msgid "User/password"
msgstr "Uživatel/heslo"

msgid "A key type to store a user/password pair."
msgstr "Typ klíče k uložení páru uživatel/klíč."

