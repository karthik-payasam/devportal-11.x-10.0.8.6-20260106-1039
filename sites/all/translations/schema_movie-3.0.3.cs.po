msgid "RECOMMENDED BY GOOGLE. The names of Actors."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Jména aktérů."

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "Celkové hodnocení založené na kolekci revizí nebo hodnocení položky."

msgid "RECOMMENDED BY GOOGLE. The date on which the work was created or was added to a DataFeed."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Datum vytvoření nebo přidání práce do datového kanálu."

msgid "RECOMMENDED BY GOOGLE. A description of the work."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Popis práce."

msgid "RECOMMENDED BY GOOGLE. The name of Director."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Jméno ředitele."

msgid "RECOMMENDED for Movie. Runtime of the work in ISO 8601 format (for example, 'PT2H22M' (142 minutes))."
msgstr "DOPORUČENO pro Film. Běhové prostředí práce ve formátu ISO 8601 (např. 'PT2H22M' (142 min))."

msgid "REQUIRED BY GOOGLE for TVEpisode."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE pro TVEpisode."

msgid "RECOMMENDED BY GOOGLE. Short videos related to the Movie (use Clip), TVEpisode, TVSeries or TVSeason (use TVClip)."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Krátká videa související s filmem (použít Clip), TVEpisode, TVSeries nebo TVSeason (použít TVClip)."

msgid "RECOMMENDED BY GOOGLE. Globally unique ID of the work in the form of a URL. The ID should be stable and not change over time. The URL is treated as an opaque string and does not have to be a working link."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Globálně jedinečné ID práce ve formě adresy URL. ID by mělo být stabilní a nemělo by se měnit v průběhu času. Adresa URL je považována za neprůhledný řetězec a nesmí se jednat o pracovní odkaz."

msgid "RECOMMENDED BY GOOGLE. The primary image for this work."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Primární obrázek pro tuto práci."

msgid "The composer of the work."
msgstr "Sestavovatel práce."

msgid "REQUIRED BY GOOGLE. The name of the work."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Název práce."

msgid "REQUIRED BY GOOGLE for TVEpisode, TVSeason."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE pro TVEpisode, TVSeason."

msgid "REQUIRED BY GOOGLE. Potential action provided by this work."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Potenciální akce poskytovaná touto prací."

msgid "The producer of the work."
msgstr "Producent práce."

msgid "The production company or studio that made the work."
msgstr "Produkční společnost nebo studio, které práci uskutečnily."

msgid "RECOMMENDED BY GOOGLE. Details about the original release of the work. Google expects only the country of the location."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Podrobnosti o původním vydání práce. Google očekává pouze zemi lokality."

msgid "RECOMMENDED BY GOOGLE. URL to a reference web page that unambiguously identifies the work. Example: IMDB, Wikipedia"
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Adresa URL odkazující na webovou stránku, která jednoznačně identifikuje práci. Příklad: IMDB, Wikipedia"

msgid "REQUIRED BY GOOGLE for TVSeason."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE pro TVSeason."

msgid "REQUIRED. The type of work."
msgstr "POŽADOVÁNO. Typ práce."

msgid "RECOMMENDED BY GOOGLE. URL to partner's landing page for the work."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Adresa URL pro cílovou stránku partnera pro práci."

