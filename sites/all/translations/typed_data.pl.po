msgid "Typed Data"
msgstr "Typed Data"

msgid "Extends the core Typed Data API with new APIs and features."
msgstr "Rozszerza podstawowy interfejs API danych określonego typu o nowe funkcje API i opcje. "

msgid "Missing arguments for filter %filter_id"
msgstr "Brak argumentów filtru %filter_id."

msgid "Entity machine names:"
msgstr "Nazwy maszyn jednostki:"

msgid "Global context variables:"
msgstr "Zmienne kontekstu globalnego:"

msgid "Available TypedData data types:"
msgstr "Dostępne typy danych TypedData:"

msgid "Text"
msgstr "Tekst"

msgid "The count filter counts the number of characters in the input string."
msgstr "Filtr count zlicza liczbę znaków w łańcuchu wejściowym."

msgid "Applies a default value if there is no value."
msgstr "Stosuje wartość domyślną, jeśli nie ma wartości. "

msgid "Provides the URL of an entity."
msgstr "Udostępnia adres URL jednostki."

msgid "Unkown date format %format given."
msgstr "Wprowadzono nieznany format daty (%format)."

msgid "If a custom date format is supplied, 'custom' must be passed as date format."
msgstr "Jeśli wprowadzono niestandardowy format daty, jako format daty musi zostać przekazana wartość 'custom' (niestandardowy). "

msgid "If 'custom' is given as date type, a custom date formatting string must be provided; e.g., 'Y-m-d H:i:s'."
msgstr "Jeśli jako typ daty podano wartość 'custom' (niestandardowy), należy wprowadzić niestandardowy łańcuch formatowania daty (np. r-m-d g:m:s)."

msgid "Formats a date, using a configured date type or a custom date format string."
msgstr "Formatuje datę przy użyciu skonfigurowanego typu daty lub niestandardowego łańcucha formatu daty. "

msgid "The format_text filter passes the text through the given filter."
msgstr "Filtr format_text przekazuje tekst z użyciem podanego filtru."

msgid "Converts a string to lower case."
msgstr "Przekształca litery w łańcuchu na małe."

msgid "The replace filter replaces all occurrences of the text given in the first argument with the text given in the second argument."
msgstr "Filtr zastępujący zastępuje wszystkie wystąpienia tekstu podanego w pierwszym argumencie tekstem podanym w drugim argumencie."

msgid "The striptags filter strips SGML/XML tags and replace adjacent whitespace by one space."
msgstr "Filtr striptags usuwa znaczniki SGML/XML i zamienia sąsiadujące białe znaki na jedną spację."

msgid "The trim filter removes whitespace from both the beginning and the end of an input string."
msgstr "Filtr trim usuwa białe znaki z początku i końca łańcucha wejściowego."

msgid "The upper filter converts the entire input string to upper case."
msgstr "Filtr upper przekształca cały łańcuch wejściowy w wielkie litery."

msgid "No widget exists for this data type."
msgstr "Nie ma widgetu dla tego typu danych."

msgid "The field %field_label consists of the data type %data_type which cannot be input or a widget for this data type is not implemented yet."
msgstr "Pole %field_label dotyczy typu danych %data_type, a danych tego typu nie można wprowadzić, lub widget dla tego typu danych nie jest jeszcze zaimplementowany."

msgid "Label"
msgstr "Etykieta"

msgid "Broken widget"
msgstr "Uszkodzony widget"

msgid "A widget for everything that cannot be input or if a widget for a data type is not yet implemented."
msgstr "Widget dla wszystkich elementów, których nie można wprowadzić, lub widget dla typu danych nie jest jeszcze zaimplementowany."

msgid "currently in daylight saving mode"
msgstr "obecnie w trybie czasu letniego"

msgid "not in daylight saving mode"
msgstr "nie jest w trybie czasu letniego"

msgid "Timezone : %timezone %daylight_saving."
msgstr "Strefa czasowa: %timezone %daylight_saving."

msgid "Start date"
msgstr "Data początkowa"

msgid "End date"
msgstr "Data końcowa"

msgid "Description"
msgstr "Opis"

msgid "The @title end date cannot be before the start date"
msgstr "Data końcowa @title nie może być wcześniejsza niż data początkowa"

msgid "Datetime Range"
msgstr "Zakres daty i czasu"

msgid "A datetime range input widget, containing two datetime values, for the start and end of the range."
msgstr "Widget wejściowy zakresu daty i godziny, który zawiera dwie wartości daty i godziny, dla początku i końca zakresu."

msgid "Datetime"
msgstr "Data i godzina"

msgid "A datetime input widget."
msgstr "Widget wejściowy daty i godziny."

msgid "Empty option label"
msgstr "Etykieta pustej opcji"

msgid "Allows overriding the label of the empty option"
msgstr "Zezwala na przesłonięcie etykiety pustej opcji"

msgid "Select"
msgstr "Wybierz"

msgid "A simple select box."
msgstr "Proste pole wyboru."

msgid "Placeholder value"
msgstr "Wartość symbolu zastępczego"

msgid "Input field size"
msgstr "Wielkość pola wejściowego"

msgid "Maximum text length"
msgstr "Maksymalna długość tekstu"

msgid "Text input"
msgstr "Wprowadzanie tekstu"

msgid "A simple, one-line text input widget."
msgstr "Prosty, jednowierszowy widget wprowadzania tekstu."

msgid "Number of rows in the text box"
msgstr "Liczba wierszy w polu tekstowym"

msgid "Number of columns in the text box"
msgstr "Liczba kolumn w polu tekstowym"

msgid "Controls whether the text area is resizable"
msgstr "Steruje możliwością zmiany wielkości obszaru tekstowego"

msgid "Allowed values are \"none\", \"vertical\", \"horizontal\", or \"both\"."
msgstr "Dozwolone wartości to „none”, „vertical”, „horizontal” lub „both”."

msgid "Textarea"
msgstr "Obszar tekstowy"

msgid "A multi-line text input widget."
msgstr "Wielowierszowy widget wprowadzania tekstu."

