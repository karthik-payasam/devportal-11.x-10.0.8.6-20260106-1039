msgid "Pretty paths coder"
msgstr "Codierer für Pretty-Pfade"

msgid "Facets Pretty Paths"
msgstr "Pretty-Pfade für Facetten"

msgid "Pretty paths for Facets."
msgstr "Pretty-Pfade für Facetten."

msgid "Search"
msgstr "Suche"

msgid "Facet Pretty Paths third party settings on the Facet config"
msgstr "Einstellungen anderer Anbieter für Facet Pretty Paths in der Facet-Konfiguration"

msgid "The coder plugin ID"
msgstr "Die Plug-in-ID des Codierers"

msgid "Home"
msgstr "Startseite"

msgid "Pretty paths"
msgstr "Pretty-Pfade"

msgid "Pretty paths uses slashes as separator, e.g. /brand/drupal/color/blue"
msgstr "Pretty-Pfade verwenden Schrägstriche als Trennzeichen. Beispiel: /brand/drupal/color/blue"

msgid "Default"
msgstr "Standard"

msgid "Use the raw value, no special processing is done, e.g. /color/<strong>2</strong>"
msgstr "Rohwert verwenden, es erfolgt keine spezielle Verarbeitung. Beispiel: /color/<strong>2</strong>"

msgid "Node title + id"
msgstr "Knoten-Titel + -ID"

msgid "Use node title with entity id, e.g. /color/<strong>blue-2</strong>"
msgstr "Knotentitel mit Entitäts-ID verwenden, wie z. B. /color/<strong>blue-2</strong>"

msgid "Taxonomy term name + id"
msgstr "Taxonomiebegriffsname + ID"

msgid "Use term name with term id, e.g. /color/<strong>blue-2</strong>"
msgstr "Begriffsnamen mit Begriffs-ID verwenden. Beispiel: /color/<strong>blue-2</strong>"

