msgid "This module manages language icons for multilingual sites:"
msgstr "Deze module beheert taalpictogrammen voor meertalige sites:"

msgid "Automatically adds icons to language links."
msgstr "Hiermee worden pictogrammen automatisch toegevoegd aan taallinks."

msgid "Provides related theme functions."
msgstr "Levert gerelateerde themafuncties."

msgid "For more information, please see <a href=\"@handbook\">the online handbook section</a>."
msgstr "Zie de <a href=\"@handbook\">online handleiding</a> voor meer informatie."

msgid "To enable multilingual support for specific content types go to <a href=\"@configure_content_types\">configure content types</a>."
msgstr "Om meertaligheid te ondersteunen voor specifieke inhoudstypen, ga naar <a href=\"@configure_content_types\">Inhoudstypes instellen</a>."

msgid "Language Icons"
msgstr "Taalpictogrammen"

msgid "Adds icons to language links."
msgstr "Hiermee worden pictogrammen toegevoegd aan taallinks."

msgid "Multilingual"
msgstr "Meertalig"

msgid "Language icons"
msgstr "Taalpictogrammen"

msgid "Configure the Language Icons module."
msgstr "De module Taalpictogrammen configureren."

msgid "Icons"
msgstr "Pictogrammen"

msgid "Language Icons settings"
msgstr "Instellingen voor taalpictogrammen"

msgid "Show the icons on a node"
msgstr "De pictogrammen op een knooppunt afbeelden"

msgid "Show the icons on the language switcher block"
msgstr "De pictogrammen in het vak voor taalkeuze afbeelden"

msgid "Add language icons"
msgstr "Taalpictogrammen toevoegen"

msgid "Link types to add language icons."
msgstr "Typen links voor het toevoegen van taalpictogrammen."

msgid "Node links"
msgstr "Node-links"

msgid "Language switcher block"
msgstr "Vak voor keuze van taal"

msgid "These options are currently disabled due to <a href=\":issue_url\">a bug</a> that cannot currently be resolved. They may be reintroduced at a later stage."
msgstr "Deze opties zijn momenteel uitgeschakeld vanwege <a href=\":issue_url\">een bug</a> die nog niet kan worden opgelost. Mogelijk worden ze later opnieuw ingeschakeld."

msgid "Icon placement"
msgstr "Plaatsing van pictogram"

msgid "Before link"
msgstr "Voor de link"

msgid "After link"
msgstr "Na de link"

msgid "Replace link"
msgstr "Link vervangen"

msgid "Where to display the icon, relative to the link title."
msgstr "Waar het pictogram wordt afgebeeld, ten opzichte van de linktitel."

msgid "Icons file path"
msgstr "Bestandspad voor pictogrammen"

msgid "Path for language icons, relative to Drupal installation. \"*\" is a placeholder for language code."
msgstr "Pad voor taalpictogrammen, relatief in de Drupal-installatie. \"*\" is een plaatshouder voor de taalcode."

msgid "Image size"
msgstr "Grootte van de afbeelding"

msgid "Image size for language icons, in the form \"width x height\"."
msgstr "Afbeeldingsgrootte van de taalpictogrammen, in de vorm 'breedte x hoogte'."

