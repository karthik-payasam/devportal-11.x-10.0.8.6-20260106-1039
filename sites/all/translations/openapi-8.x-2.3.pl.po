msgid "OpenAPI"
msgstr "OpenAPI"

msgid "Connects Drupal to the OpenAPI Javascript Library"
msgstr "Łączy system Drupal z biblioteką JavaScript OpenAPI"

msgid "Available OpenAPI Documentation."
msgstr "Dostępna dokumentacja interfejsu OpenAPI."

msgid "Access API Docs"
msgstr "Uzyskaj dostęp do dokumentów interfejsu API"

msgid "Access documentation page for the REST API"
msgstr "Uzyskaj dostęp do strony dokumentacji interfejsu REST API"

msgid "OpenAPI Schema Download"
msgstr "Pobieranie schematu modułu OpenAPI"

msgid "OpenAPI Resources"
msgstr "Zasoby OpenAPI"

msgid "OpenAPI Documentation"
msgstr "Dokumentacja interfejsu OpenAPI"

msgid "%label OpenApi Schema Download"
msgstr "Pobieranie schematu modułu OpenApi %label"

msgid "The specifications provide the documentation on some of Drupal's apis following <a href=':openapi_spec'>OpenAPI (aka Swagger)</a> standards."
msgstr "Specyfikacje udostępniają dokumentację dotyczącą niektórych interfejsów API produktu Drupal, które są zgodne ze standardami <a href=':openapi_spec'>OpenAPI (znanymi także jako Swagger)</a>."

msgid "These json files can be used in tools such as the <a href=\":swagger_editor\">Swagger Editor</a> to provide a more detailed version of the API documentation or <a href=\":swagger_codegen\">Swagger Codegen</a> to create an api client."
msgstr "Te pliki json mogą być używane w narzędziach takich jak <a href=\":swagger_editor\">edytor Swagger</a> do udostępniania bardziej szczegółowej wersji dokumentacji interfejsu API oraz generator kodu <a href=\":swagger_codegen\">Swagger Codegen</a> do tworzenia klienta API."

msgid "Module"
msgstr "Moduł"

msgid "Specification"
msgstr "Specyfikacja"

msgid "Explore"
msgstr "Eksploruj"

msgid "Please visit the <a href=':openapi_ui_link'>OpenAPI UI module</a> for information on these interfaces and to discover others."
msgstr "Informacje na temat tych i innych interfejsów można znaleźć na stronie <a href=':openapi_ui_link'>OpenAPI UI module</a> (Moduł OpenAPI IU)."

msgid "No UI plugins available"
msgstr "Brak dostępnych wtyczek interfejsu użytkownika"

msgid "There are no plugins available for exploring the OpenAPI documentation."
msgstr "Brak dostępnych wtyczek do eksplorowania dokumentacji interfejsu OpenAPI."

msgid "You can install one of the below projects to view the API Specifications from with your site."
msgstr "Aby przeglądać specyfikacje API z poziomu serwisu, można zainstalować jeden z poniższych projektów."

msgid "View/Download"
msgstr "Wyświetl/pobierz"

msgid "Explore with %interface"
msgstr "Eksploruj przy użyciu interfejsu %interface"

msgid "No UI available."
msgstr "Brak dostępnych interfejsów użytkownika."

msgid "No OpenApi generator plugins are currently available."
msgstr "Obecnie nie są dostępne żadne wtyczki generatora modułu OpenApi."

msgid "You must enable a REST or API module which supports OpenApi Downloads, such as the <a href=\":rest_link\">Core Rest</a> and <a href=\":jsonapi_link\">JSON:API</a> modules."
msgstr "Należy włączyć moduł REST lub API obsługujący moduły pobierania modułu OpenApi, takie jak <a href=\":rest_link\">Core Rest</a> i <a href=\":jsonapi_link\">JSON:API</a>."

msgid "%generator OpenApi Documentation"
msgstr "Dokumentacja interfejsu OpenAPI generatora %generator"

