msgstr "E"

msgid "AND filters are exclusive and narrow the result set. OR filters are inclusive and widen the result set."
msgstr ""
"Filtros AND são exclusivos e restringem o conjunto de resultados.\r\n"
"Filtros OR são inclusivos e ampliam o conjunto de resultados."

msgid "No limit"
msgstr "Sem limite"

