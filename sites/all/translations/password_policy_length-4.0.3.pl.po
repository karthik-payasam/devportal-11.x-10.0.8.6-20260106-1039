msgid "Password Character Length Policy"
msgstr "Strategia dotycząca długości hasła"

msgid "Sets up a character length constraint for passwords."
msgstr "Konfiguruje ograniczenie długości haseł."

msgid "Security"
msgstr "Zabezpieczenia"

msgid "Number of characters"
msgstr "Liczba znaków"

msgid "Operation"
msgstr "Operacja"

msgid "Minimum length"
msgstr "Długość minimalna"

msgid "Maximum length"
msgstr "Maksymalna długość"

msgid "The character length must be a positive number."
msgstr "Długość hasła musi być liczbą dodatnią."

msgid "at least"
msgstr "przynajmniej"

msgid "at most"
msgstr "co najwyżej"

msgid "Password length must be at least 1 character."
msgid_plural "Password length must be at least @count characters."
msgstr[0] "Długość hasła musi wynosić przynajmniej jeden znak."
msgstr[1] "Długość hasła musi wynosić przynajmniej następującą liczbę znaków: @count."
msgstr[2] "Długość hasła musi wynosić przynajmniej następującą liczbę znaków: @count."

msgid "Password length must not exceed 1 character."
msgid_plural "Password length must not exceed @count characters."
msgstr[0] "Długość hasła nie może być większa niż jeden znak."
msgstr[1] "Długość hasła nie może przekraczać następującej liczby znaków: @count."
msgstr[2] "Długość hasła nie może przekraczać następującej liczby znaków: @count."

msgid "Password character length of @operation 1 character"
msgid_plural "Password character length of @operation @characters characters"
msgstr[0] "Długość hasła w znakach dla @operation: 1 znak"
msgstr[1] "Długość hasła w znakach dla @operation: @characters zn."
msgstr[2] "Długość hasła w znakach dla @operation: @characters zn."

msgid "Password character length"
msgstr "Liczba znaków w haśle"

msgid "Verifying that a password has a minimum character length"
msgstr "Sprawdzanie, czy hasło ma minimalną długość."

msgid "The length of your password is too short."
msgstr "Hasło jest zbyt krótkie."

