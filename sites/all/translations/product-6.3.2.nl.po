msgstr "Verdringing van Drush-product: geen content aangeleverd."

msgid "Drush ReplaceProduct deleted retired API @api"
msgstr "Drush ReplaceProduct heeft ingetrokken API @api verwijderd"

msgid "Drush product replace : found a product in a strange lifecycle state '@state'. Expected 'published', 'deprecated' or 'retired'."
msgstr "Vervanging van Drush-product: er is een product aangetroffen met de vreemde levenscyclusstatus '@state'. Verwacht werd: 'published', 'deprecated' of 'retired'."

msgid "Drush product replace : incorrect number of products found. Should be 2 but was @count."
msgstr "Vervanging van Drush-product: onjuist aantal producten aangetroffen. Het moeten er twee zijn, maar het aantal was @count."

