msgid "Download and install clipboard.js library."
msgstr "clipboard.js 라이브러리를 다운로드하여 설치하십시오. "

msgid "Skip installation of @name to @path."
msgstr "@path(으)로 @name 설치를 건너뜁니다."

msgid "Unable to download @url."
msgstr "@url을(를) 다운로드할 수 없습니다."

msgid "The @name library has been downloaded to @path."
msgstr "@name 라이브러리가 @path에 다운로드되었습니다."

msgid "Unable to move @name library to @path."
msgstr "@name 라이브러리를 @path(으)로 이동할 수 없습니다."

msgid "About"
msgstr "소개"

msgid "Clipboard.js"
msgstr "Clipboard.js"

msgid "Click to copy"
msgstr "복사하려면 클릭"

msgid "Copied!"
msgstr "복사됨!"

msgid "A modern approach to copy text to clipboard."
msgstr "텍스트를 클립보드에 복사하는 최신 접근 방식입니다. "

msgid "Content display"
msgstr "컨텐츠 표시"

msgid "Clipboard.js formatter settings"
msgstr "Clipboard.js 포맷터 설정"

msgid "Label"
msgstr "레이블"

msgid "Alert style"
msgstr "경보 스타일"

msgid "Alert text"
msgstr "경보 텍스트"

msgid "Clipboard.js Button formatter settings"
msgstr "Clipboard.js 단추 포맷터 설정"

msgid "Clipboard.js Snippet formatter settings"
msgstr "Clipboard.js 스니펫 포맷터 설정"

msgid "Clipboard.js Textarea formatter settings"
msgstr "Clipboard.js 텍스트 영역 포맷터 설정"

msgid "Clipboard.js Textfield formatter settings"
msgstr "Clipboard.js 텍스트 필드 포맷터 설정"

msgid "Copied."
msgstr "복사했습니다."

msgid "This device does not support HTML5 Clipboard Copying. Please copy manually."
msgstr "이 디바이스는 HTML5 클립보드 복사를 지원하지 않습니다. 수동으로 복사하십시오."

msgid "Press ⌘-@key to @action"
msgstr "@action을(를) 수행하려면 ⌘-@key을(를) 누르십시오"

msgid "Press Ctrl-@key to @action"
msgstr "@action을(를) 수행하려면 Ctrl-@key을(를) 누르십시오"

msgid "The URL !url could not be downloaded."
msgstr "URL !url을(를) 다운로드할 수 없습니다."

msgid "Downloading library..."
msgstr "라이브러리 다운로드 중..."

msgid "Clipboard"
msgstr "클립보드"

msgid "The label on the button or hovertip."
msgstr "단추 또는 호버팁에 있는 레이블입니다."

msgid "The alert style e.g. <em>Tooltip</em>, <em>Alert</em> or <em>None</em>."
msgstr "경보 스타일입니다(예: <em>도구 팁</em>, <em>경보</em> 또는 <em>없음</em>)."

msgid "The alert text, shown as tooltip or alert."
msgstr "경보 텍스트로, 도구 팁 또는 경보로서 표시됩니다."

msgid "Label: @label"
msgstr "레이블: @label"

msgid "Alert style: @alert_style"
msgstr "경보 스타일: @alert_style"

msgid "Alert text: @alert_text"
msgstr "경보 텍스트: @alert_text"

msgid "Clipboard.js Button"
msgstr "Clipboard.js 단추"

msgid "Clipboard.js Snippet"
msgstr "Clipboard.js 스니펫"

msgid "Clipboard.js Textarea"
msgstr "Clipboard.js 텍스트 영역"

msgid "Clipboard.js Textfield"
msgstr "Clipboard.js 텍스트 필드"

