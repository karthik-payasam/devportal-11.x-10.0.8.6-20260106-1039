msgstr "이메일 목록 삭제"

msgid "Mail Subscriber Settings"
msgstr "메일 등록자 설정"

msgid "Number of messages sent per cron run"
msgstr "cron 실행마다 발송된 메시지 수"

msgid "How many days messages are retained in the spool after successfull sending"
msgstr "발송 완료 이후 메시지가 스풀에 보관되는 기간(일)"

msgid "Log all outgoing mesages in the system log"
msgstr "시스템 로그에 모든 출력 메시지 로그"

