msgid "Autocomplete Deluxe"
msgstr "Autocomplete Deluxe"

msgid "Enhanced autocomplete using Jquery UI autocomplete."
msgstr "Autocompletado mejorado usando jQuery UI autocomplete."

msgid "User interface"
msgstr "Interfaz de usuario"

msgid "None"
msgstr "Ninguno"

msgid "The entity '@term' will be added."
msgstr "Se añadirá la entidad '@term'."

msgid "No terms could be found. Please type in order to add a new term."
msgstr "No se han podido encontrar términos. Por favor, escriba en orden para añadir un término nuevo."

msgid "No results found"
msgstr "No se han encontrado resultados"

msgid "Autocomplete Deluxe widget settings"
msgstr "Cumplimentar automáticamente valores del widget Deluxe"

msgid "Match Operator"
msgstr "Operador de coincidencias"

msgid "Route Name"
msgstr "Nombre de la ruta"

msgid "Size"
msgstr "Tamaño"

msgid "Selection Handler"
msgstr "Manejador de selecciones"

msgid "Limit"
msgstr "Límite"

msgid "Min Length"
msgstr "Longitud mínima"

msgid "Delimiter"
msgstr "Delimitador"

msgid "Allow \"Not Found\" message"
msgstr "Permitir mensaje \"No encontrado\""

msgid "\"Not Found\" Message"
msgstr "Mensaje \"No encontrado\""

msgid "Allow New Terms"
msgstr "Permitir términos nuevos"

msgid "No Empty Message"
msgstr "Mensaje No vacío"

msgid "Match operator"
msgstr "Operador de coincidencia"

msgid "Specify the matcting operator."
msgstr "Especifique el operador de coincidencia."

msgid "Limit of the output."
msgstr "Límite de la salida."

msgid "If set to zero no limit will be used"
msgstr "Si se establace a 0 no se empleara un límite"

msgid "Minimum length."
msgstr "Longitud mínima."

msgid "The minimum length of characters to enter to open the suggestion list."
msgstr "La longitud mínima de caracteres a introducir para abrir la lista de sugerencias."

msgid "Delimiter."
msgstr "Delimitador."

msgid "A character which should be used beside the enter key, to separate terms."
msgstr "Un carácter que debe utilizarse junto a la clave de entrada, para separar términos."

msgid "Show Term not found message"
msgstr "Mostrar mensaje Término no encontrado"

msgid "If this is enabled, a message will be displayed when the term is not found."
msgstr "Si se habilita, se visualizará un mensaje cuando no se encuentre el término."

msgid "Term not found message."
msgstr "Mensaje de término no encontrado."

msgid "A message text which will be displayed, if the entered term was not found."
msgstr "Un mensaje de texto que se mostrará, si no se ha encontrado el término introducido."

msgid "Allow new terms"
msgstr "Permitir términos nuevos"

msgid "Should it be allowed, that user enter new terms?"
msgstr "¿Se debe permitir que el usuario especifique términos nuevos?"

msgid "Empty value message."
msgstr "Mensaje de valor vacío."

msgid "A text message that will be displayed when the field is focused and it does not contain values."
msgstr "Mensaje de texto que se mostrará cuando el campo esté en foco y no contenga valores."

msgid "Match operator: @match_operator"
msgstr "Operador de coincidencia: @match_operator"

msgid "Limit: @limit"
msgstr "Límite: @limit"

msgid "Min length: @min_length"
msgstr "Longitud mínima: @min_length"

msgid "Delimiter: @delimiter"
msgstr "Delimitador: @delimiter"

msgid "Allow Not Found message: @not_found_message_allow"
msgstr "Mensaje de permitir no encontrado: @not_found_message_allow"

msgid "Not Found message: @not_found_message"
msgstr "Mensaje de No encontrado: @not_found_message"

msgid "Allow new terms: @new_terms"
msgstr "Permitir términos nuevos: @new_terms"

msgid "Empty value message: @no_empty_message"
msgstr "Mensaje de valor vacío: @no_empty_message"

msgid "@not_found_message"
msgstr "@not_found_message"

msgid "@no_empty_message"
msgstr "@no_empty_message"

msgid "Starts with"
msgstr "Comienza con"

msgid "Contains"
msgstr "Contiene"

