msgid "Client-side Hierarchical Select"
msgstr "Seleção hierárquica do lado do cliente"

msgid "A simple client-side hierarchical select widget for taxonomy terms."
msgstr "Um widget de seleção hierárquica do lado do cliente simples para termos de taxonomia."

msgid "Widgets"
msgstr "Widgets"

msgid "CSHS field widget settings"
msgstr "Configurações do widget de campo CSHS"

msgid "Save lineage"
msgstr "Salvar linhagem"

msgid "Force selection of deepest level"
msgstr "Force a seleção do nível mais profundo"

msgid "Parent"
msgstr "Pai"

msgid "Labels per hierarchy-level"
msgstr "Rótulos por nível de hierarquia"

msgid "Hierarchy depth"
msgstr "Profundidade da hierarquia"

msgid "Required depth"
msgstr "Profundidade necessária"

msgid "The \"no selection\" label"
msgstr "O rótulo \"sem seleção\""

msgid "Client-side Hierarchical Select: Menu Link"
msgstr "Seleção hierárquica do lado do cliente: link de menu"

msgid "A client-side hierarchical selection of parents for the menu link. Works for node and term forms (with \"taxonomy_menu_ui\" enabled)."
msgstr "Uma seleção hierárquica do lado do cliente de pais para o link de menu. Funciona para nós e termos de formulário (com \"taxonomy_menu_ui\" ativado)."

msgid "Deepest"
msgstr "Mais profundo"

msgid "None"
msgstr "Nenhum"

msgid "Yes"
msgstr "True"

msgid "No"
msgstr "Não"

msgid "Parent: @parent"
msgstr "Pai: @parent"

msgid "Force deepest: @force_deepest"
msgstr "Forçar mais profundo: @force_deepest"

msgid "Save lineage: @save_lineage"
msgstr "Salvar linhagem: @save_lineage"

msgid "Level labels: @level_labels"
msgstr "Rótulos de nível: @level_labels"

msgid "The \"no selection\" label: @none_label"
msgstr "O rótulo \"sem seleção\": @none_label"

msgid "Select a parent term to use only a subtree of a vocabulary for this field."
msgstr "Selecione um termo pai para usar apenas uma subárvore de um vocabulário para este campo."

msgid "Force the deepest level selection"
msgstr "Forçar a seleção de nível mais profundo"

msgid "If checked the user will be forced to select terms from the deepest level."
msgstr "Se marcado, o usuário será forçado a selecionar termos do nível mais profundo."

msgid "Enter labels for each hierarchy-level separated by comma."
msgstr "Insira rótulos para cada nível de hierarquia separados por vírgula."

msgid "The label for an empty option."
msgstr "O rótulo para uma opção vazia."

msgid "The hierarchy depth cannot be @actual because the selection list has @levels levels."
msgstr "A profundidade da hierarquia não pode ser @actual porque a lista de seleção tem @levels níveis."

msgid "The required depth cannot be greater than the hierarchy depth."
msgstr "A profundidade necessária não pode ser maior que a profundidade da hierarquia."

msgid "Format"
msgstr "Formato"

msgid "Specify a format for each field item by using tokens."
msgstr "Especifique um formato para cada item de campo usando tokens."

msgid "Clear Tokens"
msgstr "Limpar tokens"

msgid "Remove token from final text if no replacement value is generated"
msgstr "Remover token do texto final se nenhum valor de substituição for gerado"

msgid "Format: @format"
msgstr "Formato: @format"

msgid "Flexible hierarchy"
msgstr "Hierarquia flexível"

msgid "Allows to specify the output with tokens."
msgstr "Permite especificar a saída com tokens."

msgid "Link to term page"
msgstr "Link para página de termo"

msgid "Reverse order view"
msgstr "Inverter ordem de visualização"

msgid "Outputs hierarchy in reverse order (the deepest level first)."
msgstr "Hierarquia de saídas em ordem inversa (o primeiro nível mais profundo)."

msgid "Linked to term page: @linked"
msgstr "Vinculado à página do termo: @linked"

msgid "Reverse order view: @reverse"
msgstr "Inverter ordem de visualização: @reverse"

msgid "Separator"
msgstr "Separador"

msgid "Specify a separator which will be placed in between the different hierarchy levels."
msgstr "Especifique um separador que será colocado entre os diferentes níveis de hierarquia."

msgid "Separator: @separator"
msgstr "Separador: @separator"

msgid "Full hierarchy"
msgstr "Hierarquia completa"

msgid "Display the full hierarchy of the taxonomy term."
msgstr "Exibir a hierarquia completa do termo de taxonomia."

msgid "Sorting"
msgstr "Classificação"

msgid "Depth"
msgstr "Profundidade"

msgid "The maximum hierarchy depth. Use 0 to not limit or 1 to display just the root term (or the last if reverse order selected)."
msgstr "A profundidade máxima da hierarquia. Use 0 para não limitar ou 1 para exibir apenas o termo raiz (ou o último se a ordem reversa tiver sido selecionada)."

msgid "Last child"
msgstr "Último filho"

msgid "Show only the root term and its deepest child."
msgstr "Mostrar apenas o termo root e seu filho mais profundo."

msgid "Sorting: @value"
msgstr "Classificação: @value"

msgid "Depth: @value"
msgstr "Profundidade: @value"

msgid "Last child only"
msgstr "Último filho apenas"

msgid "Unlimited"
msgstr "Ilimitado"

msgid "Hierarchy grouped by root"
msgstr "Hierarquia agrupada por raiz"

msgid "Display the hierarchy of the taxonomy term grouped by root."
msgstr "Exibir a hierarquia do termo de taxonomia agrupado por raiz."

msgid "Client-side hierarchical select"
msgstr "Seleção hierárquica do lado do cliente"

msgid "An invalid vocabulary is selected. Please change it in the options."
msgstr "Um vocabulário inválido é selecionado. Mude-o nas opções."

msgid "About"
msgstr "Sobre"

msgid "Settings"
msgstr "Configurações"

msgid "Multi-lingual"
msgstr "Multilíngue"

msgid "Supports multi-lingual terms localized with i18n_taxonomy module (Which is part of the i18n package)."
msgstr "Suporta termos multilíngues localizados com o módulo i18n_taxonomy (que faz parte do pacote i18n)."
