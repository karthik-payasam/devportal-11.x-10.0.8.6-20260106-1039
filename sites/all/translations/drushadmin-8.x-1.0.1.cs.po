msgid "APIC Drush Administration commands"
msgstr "Příkazy administrace modulu APIC Drush"

msgid "Additional drush admin commands"
msgstr "Další příkazy administrace modulu drush"

msgid "IBM API Developer Portal"
msgstr "IBM API Developer Portal"

msgid "@theme_name deleted."
msgstr "@theme_name odstraněn."

msgid "@module_name deleted."
msgstr "@module_name odstraněn."

msgid "All bans cleared."
msgstr "Všechny zákazy byly vymazány."

msgid "Processing batch delete of users..."
msgstr "Zpracování dávkového odstranění uživatelů..."

msgid "@theme_name not deleted. It is either still activated or is not a custom theme."
msgstr "@theme_name neodstraněn. Je buď stále aktivován, nebo se nejedná o vlastní motiv."

msgid "@module_name not deleted. It is either still activated or is not a custom module."
msgstr "@module_name neodstraněn. Je buď stále aktivován, nebo se nejedná o vlastní modul."

msgid "Unknown entity type"
msgstr "Neznámý typ entity"

msgid "All entities of type %type deleted."
msgstr "Všechny entity typu %type byly odstraněny."

msgid "All nodes of type %type deleted."
msgstr "Všechny uzly typu %type byly odstraněny."

msgid "All users from user registry %type have been deleted."
msgstr "Všichni uživatelé z registru uživatelů %type byli odstraněni."

msgid "All users (except admin) have been deleted."
msgstr "Všichni uživatelé (kromě administrátora) byli odstraněni."

