msgid "External Authentication Map"
msgstr "Mappa di autenticazione esterna"

msgid "Provider"
msgstr "Fonte esterna"

msgid "The name of the authentication provider providing the authname."
msgstr "Il nome del provider di autenticazione che fornisce authname."

msgid "Authname"
msgstr "Authname"

msgid "Unique authentication name provided by authentication provider."
msgstr "Nome di autenticazione univoco fornito dal provider di autenticazione."

msgid "Drupal User ID"
msgstr "ID utente Drupal"

msgid "The user linked to the authname."
msgstr "L'utente collegato all'authname."

msgid "Linked Drupal user"
msgstr "Utente Drupal collegato"

msgid "Link to delete @label entry"
msgstr "Link per eliminare la voce @label"

msgid "Provide a link to delete the @label entry."
msgstr "Fornire un link per eliminare la voce @label."

msgid "About"
msgstr "Informazioni"

msgid "Authenticates users using an external site / service and stores identification details."
msgstr "Autentica gli utenti utilizzando un sito o un servizio esterno e memorizza i dettagli dell'identificazione."

msgid "External Authentication"
msgstr "Autenticazione esterna"

msgid "Helper module to authenticate users using an external site / service and storing identification details"
msgstr "Modulo di supporto per autenticare gli utenti utilizzando un sito o servizio esterno e memorizzare i dettagli di identificazione"

msgid "User authentication"
msgstr "Autenticazione utente"

msgid "View external authentication data"
msgstr "Visualizza dati di autenticazione esterni"

msgid "Delete external authentication data"
msgstr "Elimina dati di autenticazione esterni"

msgid "Delete authmap entry"
msgstr "Elimina voce authmap"

msgid "Authmap change (%old => %new) for user %name with uid %uid from provider %provider"
msgstr "Modifica Authmap (%old => %new) per l'utente %name con uid %uid dal provider %provider"

msgid "External registration of user %name from provider %provider and authname %authname"
msgstr "Registrazione esterna dell'utente %name dal provider %provider e nome di autenticazione %authname "

msgid "External login of user %name"
msgstr "Accesso esterno dell'utente %name"

msgid "Are you sure you want to delete the link between authentication name %id and Drupal user %user?"
msgstr "Si è sicuri di voler eliminare il link tra il nome di autenticazione %id e l'utente Drupal %user?"

msgid "No authmap record found for provider @provider / uid @uid."
msgstr "Nessun record authmap trovato per il provider @provider o l'UID @uid."

msgid "The link has been deleted."
msgstr "Il link è stato eliminato."

msgid "User’s users.uid."
msgstr "users.uid dell'utente."

msgid "Unique authentication name."
msgstr "Nome di autenticazione univoco."

msgid "Module which is controlling the authentication."
msgstr "Modulo di controllo dell'autenticazione."

msgid "delete"
msgstr "elimina"

msgid "Output the URL as text"
msgstr "Emetti in output l'URL come testo"

msgid "Use absolute link (begins with \"http://\")"
msgstr "Usa percorso assoluto (inizia con \"http://\")"

msgid "Enable this option to output an absolute link. Required if you want to use the path as a link destination."
msgstr "Abilitare questa opzione per generare un link assoluto. Obbligatorio se si desidera utilizzare il percorso come destinazione del link."

