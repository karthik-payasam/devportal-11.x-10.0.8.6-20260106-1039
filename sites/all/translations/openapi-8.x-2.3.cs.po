msgid "OpenAPI"
msgstr "OpenAPI"

msgid "Connects Drupal to the OpenAPI Javascript Library"
msgstr "Připojí Drupal ke knihovně OpenAPI JavaScript"

msgid "Available OpenAPI Documentation."
msgstr "Dostupná dokumentace OpenAPI."

msgid "Access API Docs"
msgstr "Přístup k dokumentům rozhraní API"

msgid "Access documentation page for the REST API"
msgstr "Přistoupit ke stránce dokumentace pro rozhraní REST API"

msgid "OpenAPI Schema Download"
msgstr "Stažení schématu OpenAPI"

msgid "OpenAPI Resources"
msgstr "Prostředky OpenAPI "

msgid "OpenAPI Documentation"
msgstr "Dokumentace OpenAPI "

msgid "%label OpenApi Schema Download"
msgstr "Stažení schématu %label OpenApi"

msgid "The specifications provide the documentation on some of Drupal's apis following <a href=':openapi_spec'>OpenAPI (aka Swagger)</a> standards."
msgstr "Specifikace poskytují dokumentaci k některým rozhraním API Drupal, která se řídí standardy <a href=':openapi_spec'>OpenAPI (aka Swagger)</a>."

msgid "These json files can be used in tools such as the <a href=\":swagger_editor\">Swagger Editor</a> to provide a more detailed version of the API documentation or <a href=\":swagger_codegen\">Swagger Codegen</a> to create an api client."
msgstr "Tyto soubory JSON lze použít v nástrojích, jako je <a href=\":swagger_editor\">Editor Swagger</a>, k zajištění podrobnější verze dokumentace rozhraní API, nebo <a href=\":swagger_codegen\">Swagger Codegen</a> k vytvoření klienta API."

msgid "Module"
msgstr "Modul"

msgid "Specification"
msgstr "Specifikace"

msgid "Explore"
msgstr "Prozkoumat"

msgid "Please visit the <a href=':openapi_ui_link'>OpenAPI UI module</a> for information on these interfaces and to discover others."
msgstr "Navštivte <a href=':openapi_ui_link'>modul UI OpenAPI</a>, kde najdete informace o těchto rozhraních a objevíte další."

msgid "No UI plugins available"
msgstr "Nejsou k dispozici žádné moduly plug-in uživatelského rozhraní"

msgid "There are no plugins available for exploring the OpenAPI documentation."
msgstr "Nejsou k dispozici žádné moduly plug-in pro prozkoumání dokumentace OpenAPI."

msgid "You can install one of the below projects to view the API Specifications from with your site."
msgstr "Chcete-li prohlížet Specifikace rozhraní API ze svých stránek, můžete nainstalovat jeden z níže uvedených projektů."

msgid "View/Download"
msgstr "Zobrazit/stáhnout"

msgid "Explore with %interface"
msgstr "Prozkoumat pomocí rozhraní %interface"

msgid "No UI available."
msgstr "Není k dispozici žádné uživatelské rozhraní"

msgid "No OpenApi generator plugins are currently available."
msgstr "V současné době nejsou k dispozici žádné moduly plug-in generátoru OpenApi."

msgid "You must enable a REST or API module which supports OpenApi Downloads, such as the <a href=\":rest_link\">Core Rest</a> and <a href=\":jsonapi_link\">JSON:API</a> modules."
msgstr "Je třeba povolit modul REST nebo API, který podporuje OpenApi ke stažení, jako například <a href=\":rest_link\">základní modul Rest</a> a <a href=\":jsonapi_link\">JSON:API</a>."

msgid "%generator OpenApi Documentation"
msgstr "Dokumentace %generator OpenApi "

