msgstr "ビューズ"

msgid "Enable history"
msgstr "履歴を有効にする"

msgid "AJAX history"
msgstr "AJAX 履歴"

msgid "Enable Views AJAX history."
msgstr "Views AJAX 履歴を有効にします。"

