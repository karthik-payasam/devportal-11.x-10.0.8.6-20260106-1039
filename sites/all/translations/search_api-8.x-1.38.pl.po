msgstr "Proponuj zakończenia dla obecnie wprowadzanego słowa."

msgid "Suggest additional words"
msgstr "Proponuj dodatkowe słowa"

msgid "Suggest additional words the user might want to search for."
msgstr "Proponuj dodatkowe słowa, które użytkownik może chcieć wyszukać."

msgid "None selected yet"
msgstr "Jeszcze nie wybrano"

msgid "none"
msgstr "brak"

msgid "Autocomplete suggestions"
msgstr "Automatyczne uzupełnianie propozycji"

msgid "No valid search keys were present in the query."
msgstr "W pytaniu nie ma poprawnych kluczy wyszukiwania."

msgid "Unknown sort order @order. Assuming \"@default\"."
msgstr "Nieznany porządek sortowania @order. Przyjęto \"@default\"."

msgid "Unknown facet field @field."
msgstr "Nieznane pole aspektu @field."

msgid "Facets on location fields are currently not supported."
msgstr "Aspekty w polach lokalizacji obecnie nie są obsługiwane."

msgid "Unknown field @field: please check (and re-save) the index's fields settings."
msgstr "Nieznane pole @field: sprawdź (i ponownie zapisz) ustawienia pól indeksowania."

msgid "An overlong word (more than 50 characters) was encountered while indexing: %word.<br />Since database search servers currently cannot index words of more than 50 characters, the word was truncated for indexing. If this should not be a single word, please make sure the \"Tokenizer\" processor is enabled and configured correctly for index %index."
msgstr "Podczas indeksowania napotkano zbyt długie słowo (ponad 50 znaków): %word.<br />Ponieważ serwery wyszukiwania bazy danych nie mogą obecnie indeksować słów o długości przekraczającej 50 znaków, słowo zostało obcięte na potrzeby indeksowania. Jeśli nie powinno to być pojedyncze słowo, upewnij się, że procesor \"Dzielenie na leksemy\" jest włączony i poprawnie skonfigurowany dla indeksu %index."

msgid "An overlong value (more than 255 characters) was encountered while indexing: %value.<br />Database search servers currently cannot index such values correctly – the value was therefore trimmed to the allowed length."
msgstr "Podczas indeksowania napotkano zbyt długą wartość (ponad 255 znaków): %value.<br />Serwery wyszukiwania bazy danych obecnie nie mogą poprawnie indeksować takich wartości — wartość została zatem obcięta do dozwolonej długości."

msgid "Error while adding facets: only \"item_id\" field should be used, used are: @fields."
msgstr "Wystąpił błąd podczas dodawania aspektów: można używać tylko pola \"item_id\", a użyto: @fields."

msgid "Indexes items in the database. Supports several advanced features, but should not be used for large sites."
msgstr "Indeksuje elementy w bazie danych. Obsługiwanych jest szereg zaawansowanych funkcji, ale nie należy ich używać w dużych serwisach."

msgid "Completed about @percentage% of the indexing operation (@current of @total)."
msgstr "Wykonano około @percentage% operacji indeksowania (@current z @total)."

msgid "An error occurred during indexing on @index: @message"
msgstr "Wystąpił błąd podczas indeksowania w @index: @message"

msgid "Couldn't index items. Check the logs for details."
msgstr "Nie można zindeksować zawartości. Sprawdź zapis dziennika."

msgid "An error occurred while trying to index items. Check the logs for details."
msgstr "Wystąpił błąd podczas próby indeksowania elementów. Szczegółowe informacje znajdują się w dziennikach."

msgid "Successfully indexed 1 item on @index."
msgid_plural "Successfully indexed @count items on @index."
msgstr[0] "Pomyślnie zindeksowano jeden element w @index. "
msgstr[1] "Pomyślnie zindeksowano w @index następującą liczbę elementów: @count."
msgstr[2] "Pomyślnie zindeksowano w @index następującą liczbę elementów: @count."

msgid "Successfully indexed 1 item."
msgid_plural "Successfully indexed @count items."
msgstr[0] "Pomyślnie poindeksowano 1 element."
msgstr[1] "Pomyślnie poindeksowano następującą liczbę elementów: @count."

msgid "1 item could not be indexed. Check the logs for details."
msgid_plural "@count items could not be indexed. Check the logs for details."
msgstr[0] "Nie można poindeksować 1 elementu. Szczegółowe informacje znajdują się w dziennikach."
msgstr[1] "Nie można poindeksować następującej liczby elementów: @count. Szczegółowe informacje znajdują się w dziennikach."

msgid "The required Node module is not installed on your site. Database Search Defaults module could not be installed."
msgstr "Wymagany moduł Węzeł nie jest zainstalowany w serwisie. Nie można zainstalować modułu Database Search Defaults."

msgid "Content type @content_type not found. Database Search Defaults module could not be installed."
msgstr "Nie znaleziono typu treści @content_type. Nie można zainstalować modułu Database Search Defaults."

msgid "Field @field in content type @node_type not found. Database Search Defaults module could not be installed"
msgstr "Nie znaleziono pola @field w typie treści @node_type. Nie można zainstalować modułu Database Search Defaults"

msgid "It looks like the default setup provided by this module already exists on your site. Cannot re-install module."
msgstr "Wygląda na to, że domyślna konfiguracja udostępniona przez ten moduł już istnieje w serwisie. Nie można reinstalować modułu."

