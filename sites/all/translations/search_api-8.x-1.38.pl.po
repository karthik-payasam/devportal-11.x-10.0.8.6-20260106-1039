msgstr "Zapisz zmiany"

msgid "%field_id is a reserved value and cannot be used as the machine name of a normal field."
msgstr "%field_id jest wartością zastrzeżoną. Nie można jej używać jako nazwy w formie zapisu maszynowego w zwykłym polu."

msgid "Field IDs have to contain non-underscore characters."
msgstr "Identyfikatory pól muszą zawierać znaki inne niż podkreślenia."

msgid "Field IDs must contain only lowercase letters, numbers and underscores."
msgstr "Identyfikatory pól mogą zawierać tylko małe litery, cyfry i znaki podkreślenia."

msgid "Field ID %field_id is used multiple times. Field IDs must be unique."
msgstr "Identyfikator pola %field_id jest używany wielokrotnie. Identyfikatory pól muszą być unikalne."

msgid "The field with ID %field_id does not exist anymore."
msgstr "Pole o identyfikatorze %field_id już nie istnieje."

msgid "The type of field %field (%field_id) cannot be changed."
msgstr "Nie można zmienić typu pola %field (%field_id)."

msgid "The changes were successfully saved."
msgstr "Zmiany zostały pomyślnie zapisane."

msgid "All content was scheduled for <a href=\":url\">reindexing</a> so the new settings can take effect."
msgstr "Zaplanowano <a href=\":url\">ponowne indeksowanie</a> całej treści, aby nowe ustawienia zostały uwzględnione."

msgid "Add search index"
msgstr "Dodaj indeks wyszukiwania"

