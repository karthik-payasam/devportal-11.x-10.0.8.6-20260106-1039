msgid "About"
msgstr "O programu"

msgid "The Admin Toolbar Search module add a search option to the toolbar for site administrative tasks."
msgstr "Modul vyhledávání panelu nástrojů pro administraci přidá do panelu nástrojů volbu hledání pro administrativní úlohy serveru."

msgid "Search"
msgstr "Hledat"

msgid "Admin Toolbar quick search"
msgstr "Rychlé vyhledávání panelu nástrojů pro administraci"

msgid "Admin Toolbar Search"
msgstr "Vyhledávání panelu nástrojů pro administraci"

msgid "Provides search of Admin Toolbar items."
msgstr "Poskytuje vyhledávání položek panelu nástrojů pro administraci."

msgid "Administration"
msgstr "Administrace"

msgid "Configure the Admin Toolbar Search module."
msgstr "Nakonfigurujte modul vyhledávání panelu nástrojů pro administraci."

msgid "Use Admin Toolbar search"
msgstr "Použít vyhledávání v panelu nástrojů pro administraci"

msgid "Admin toolbar search settings"
msgstr "Nastavení vyhledávání v panelu nástrojů pro administraci"

msgid "Admin Toolbar Search settings"
msgstr "Nastavení vyhledávání v panelu nástrojů pro administraci"

msgid "How the search input will be displayed"
msgstr "Jak se zobrazí vstup vyhledávání"

msgid "@entity_type > @bundle"
msgstr "@entity_type > @bundle"

msgid "Edit"
msgstr "Upravit"

msgid "Manage fields"
msgstr "Spravovat pole"

msgid "Manage form display"
msgstr "Spravovat zobrazení formuláře"

msgid "Manage display"
msgstr "Spravovat zobrazení"

msgid "Devel"
msgstr "Vývoj"

msgid "Delete"
msgstr "Odstranit"

msgid "Menus > @menu_label"
msgstr "Nabídky > @menu_label"

