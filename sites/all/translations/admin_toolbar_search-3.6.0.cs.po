msgstr "Nabídky > @menu_label > Přidat odkaz"

msgid "Menus > @menu_label > Delete"
msgstr "Nabídky > @menu_label > Odstranit"

msgid "Menus > @menu_label > Devel"
msgstr "Nabídky > @menu_label > Vývoj"

msgid "Display the search input as a menu item."
msgstr "Zobrazte vstup vyhledávání jako položku nabídky."

msgid "If set, instead of displaying a text input field, it displays a menu item in the toolbar so the user has to click on it to toggle the search input."
msgstr "Je-li tato volba nastavena, zobrazí v panelu nástrojů místo zobrazení textového vstupního pole položka nabídky, takže na ni musí uživatel klepnout a přepnout vstup vyhledávání."

