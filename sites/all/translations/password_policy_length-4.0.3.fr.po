msgid "Password Character Length Policy"
msgstr "Règle sur la longueur des mots de passe"

msgid "Sets up a character length constraint for passwords."
msgstr "Configure une contrainte de longueur pour les mots de passe."

msgid "Security"
msgstr "Sécurité"

msgid "Number of characters"
msgstr "Nombre de caractères"

msgid "Operation"
msgstr "Opération"

msgid "Minimum length"
msgstr "Longueur minimale"

msgid "Maximum length"
msgstr "Longueur maximale"

msgid "The character length must be a positive number."
msgstr "La longueur doit être un nombre positif."

msgid "at least"
msgstr "minimum"

msgid "at most"
msgstr "maximum"

msgid "Password character length of @operation 1 character"
msgid_plural "Password character length of @operation @characters characters"
msgstr[0] "Longueur du mot de passe de @operation - 1 caractère"
msgstr[1] "Longueur du mot de passe de @operation - @characters caractères"

msgid "Password character length"
msgstr "Longueur des mots de passe"

msgid "Verifying that a password has a minimum character length"
msgstr "Le système vérifie qu'un mot de passe comporte le nombre de caractères minimal requis."

msgid "The length of your password is too short."
msgstr "Votre mot de passe est trop court."

