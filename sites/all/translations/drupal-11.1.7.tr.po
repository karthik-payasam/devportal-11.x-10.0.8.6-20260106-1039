msgstr "Anonim kullanıcılar için <q>giriş yap</q>"

msgid "logged in users only"
msgstr "sadece giriş yapmış kullanıcılar"

msgid "Enable @title menu link"
msgstr "@title menü bağlantısını etkinleştir"

msgid "%capital_name contains 1 menu link with pending revisions. Manipulation of a menu tree having links with pending revisions is not supported, but you can re-enable manipulation by getting each menu link to a published state."
msgid_plural "%capital_name contains @count menu links with pending revisions. Manipulation of a menu tree having links with pending revisions is not supported, but you can re-enable manipulation by getting each menu link to a published state."
msgstr[0] "%capital_name, beklemede düzeltmeleri olan 1 menü bağlantısı içeriyor. Beklemede düzeltmeleri olan bağlantılar içeren bir menü ağacının işlenmesi desteklenmez, ancak her bir menü bağlantısını yayınlandı durumuna getirerek işlemeyi yeniden etkinleştirebilirsiniz."
msgstr[1] "%capital_name, beklemede düzeltmeleri olan @count menü bağlantısı içeriyor. Beklemede düzeltmeleri olan bağlantılar içeren bir menü ağacının işlenmesi desteklenmez, ancak her bir menü bağlantısını yayınlandı durumuna getirerek işlemeyi yeniden etkinleştirebilirsiniz."

