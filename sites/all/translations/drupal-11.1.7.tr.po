msgstr "Kullanılabilir değişkenler: [site:name], [site:url], [user:display-name], [user:account-name], [user:mail], [site:login-url], [site:url-brief], [user:edit-url], [user:one-time-login-url], [user:cancel-url]."

msgid "Edit the welcome email messages sent to new member accounts created by an administrator."
