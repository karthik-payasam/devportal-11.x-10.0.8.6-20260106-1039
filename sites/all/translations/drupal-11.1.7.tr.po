msgid "Search looks for exact, case-insensitive keywords; keywords shorter than a minimum length are ignored."
msgstr "Büyük/küçük harflere duyarsız tam anahtar sözcükler aranır; uzunluk alt sınırından kısa olan anahtar sözcükler yoksayılır."

msgid "Use upper-case OR to get more results. Example: cat OR dog (content contains either \"cat\" or \"dog\")."
