msgid "Content translation synchronized fields"
msgstr "İçerik çevirisi eşitlenen alanlar"

msgid "Non-translatable field elements can only be changed when updating the current revision."
msgstr "Çevrilemeyen alan öğeleri yalnızca geçerli düzeltme güncellenirken değiştirilebilir."

msgid "Non-translatable field elements can only be changed when updating the original language."
msgstr "Çevrilemeyen alan öğeleri yalnızca özgün dil güncellenirken değiştirilebilir."

