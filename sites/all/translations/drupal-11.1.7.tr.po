msgstr "%toolbar_item araç çubuğu öğesi, görüntü yüklemelerinin etkinleştirilmesini gerektirir."

msgid "The %toolbar_item toolbar item requires the %filter filter to be enabled."
msgstr "%toolbar_item araç çubuğu öğesi, %filter filtresinin etkinleştirilmesini gerektirir."

msgid "The %toolbar_item toolbar item requires the %plugin plugin to be enabled."
msgstr "%toolbar_item araç çubuğu öğesi, %plugin eklentisinin etkinleştirilmesini gerektirir."

