msgid_plural "This synchronization will delete data from the fields: %fields."
msgstr[0] "Bu eşitleme sonucunda %fields alanından veriler silinecek."
msgstr[1] "Bu eşitleme sonucunda %fields alanlarından veriler silinecek."

