msgid_plural "@count new posts<span class=\"visually-hidden\"> in topic %title</span>"
msgstr[0] "<span class=\"visually-hidden\">%title konusunda</span> 1 yeni gönderi"
msgstr[1] "<span class=\"visually-hidden\">%title konusunda</span> @count yeni gönderi"

