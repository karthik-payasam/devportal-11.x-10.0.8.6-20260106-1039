msgstr[0] "1 elemento correttamente indicizzato. "
msgstr[1] "@count elementi correttamente indicizzati. "

msgid "1 item could not be indexed. Check the logs for details."
msgid_plural "@count items could not be indexed. Check the logs for details."
msgstr[0] "Impossibile indicizzare 1 elemento. Consultare i log per i dettagli. "
msgstr[1] "Impossibile indicizzare @count elementi. Consultare i log per i dettagli. "

msgid "The required Node module is not installed on your site. Database Search Defaults module could not be installed."
msgstr "Il modulo nodo richiesto non è installato sul proprio sito. Impossibile installare il modulo Valori predefiniti ricerca database."

msgid "Content type @content_type not found. Database Search Defaults module could not be installed."
msgstr "Tipo di contenuto @content_type non trovato. Impossibile installare il modulo Valori predefiniti ricerca database. "

msgid "Field @field in content type @node_type not found. Database Search Defaults module could not be installed"
msgstr "Campo @field nel tipo di contenuto @node_type non trovato. Impossibile installare il modulo Valori predefiniti ricerca database "

msgid "It looks like the default setup provided by this module already exists on your site. Cannot re-install module."
msgstr "La configurazione predefinita fornita da questo modulo sembra già esistere sul sito. Impossibile reinstallare il modulo. "

