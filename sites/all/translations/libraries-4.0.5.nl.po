msgid "Lists registered library information."
msgstr "Geeft informatie van geregistreerde bibliotheken weer."

msgid ""
"Downloads a registered library into the libraries directory for the active site.\n"
"\n"
"See libraries-list for a list of registered libraries."
msgstr ""
"Hiermee downloadt u een geregistreerde bibliotheek naar de bibliotheekdirectory voor de actieve site.\n"
" \n"
"Zie libraries-list voor een lijst van geregistreerde bibliotheken."

msgid "Name"
msgstr "Naam"

msgid "Status"
msgstr "Status"

msgid "Version"
msgstr "Versie"

msgid "Variants"
msgstr "Varianten"

msgid "Dependencies"
msgstr "Afhankelijkheden"

msgid "OK"
msgstr "Ok"

msgid "Missing dependency: unzip. Install it before using this command."
msgstr "Ontbrekende dependency: unzip. Installeer het voordat u deze opdracht gebruikt."

msgid "Directory @path was created"
msgstr "Map @path is aangemaakt"

msgid "A existing Colorbox plugin was overwritten at @path"
msgstr "Een bestaande Colorbox-plugin is overschreven bij @path"

msgid "Colorbox plugin has been downloaded to @path"
msgstr "De Colorbox-plugin is gedownload naar @path"

msgid "Drush was unable to download the Colorbox plugin to @path"
msgstr "Drush is niet in staat de Colorbox-plugin te downloaden naar @path"

msgid "The %dependency library, which the %library library depends on, is not installed."
msgstr "De bibliotheek %dependency, waar de bibiotheek %library van afhankelijk is, is niet geïnstalleerd."

msgid "The version %dependency_version of the %dependency library is not compatible with the %library library."
msgstr "De versie %dependency_version van de bibiotheek %dependency is niet compatible met de bibliotheek %library."

msgid "The %library library could not be found."
msgstr "De bibiotheek %library werd niet gevonden."

msgid "The version of the %library library could not be detected."
msgstr "De versie van de bibiotheek %library werd niet gedetecteerd."

msgid "The installed version %version of the %library library is not supported."
msgstr "De geïnstalleerde versie %version van de bibiotheek %library wordt niet ondersteund."

msgid "The %variant variant of the %library library could not be found."
msgstr "De variant %variant van de bibiotheek %library werd niet gevonden."

msgid "The following external libraries could not successfully be registered with Drupal core: @libs. See earlier log entries for more details. Once these issues are addressed please be sure to clear your Drupal library cache to ensure external library detection is run again."
msgstr "De volgende externe bibliotheken kunnen niet worden geregistreerd bij de Drupal-core: @libs. Zie eerdere logboekitems voor meer informatie. Wanneer u deze problemen hebt opgelost, vergeet dan niet om de cache van de Drupal-bibliotheek leeg te maken om ervoor te zorgen dat de detectie van externe bibliotheken opnieuw wordt uitgevoerd."

msgid "Libraries"
msgstr "Bibliotheken"

msgid "Allows version-dependent and shared usage of external libraries."
msgstr "Maakt versie-afhankelijk en gedeeld gebruik van externe bibliotheken mogelijk."

msgid "Libraries API settings"
msgstr "API-instellingen voor bibliotheken"

msgid "Library definition settings"
msgstr "Instellingen voor bibliotheekdefinities"

msgid "Local"
msgstr "Lokaal"

msgid "Local path"
msgstr "Lokaal pad"

msgid "Enable remote fetching of library definitions"
msgstr "Ophalen van bibliotheekdefinities op afstand inschakelen"

msgid "A list of remote library registry URLs"
msgstr "Een lijst van URL's voor bibliotheekregister op afstand"

msgid "The URL of a remote library registry"
msgstr "De URL van een bibliotheekregister op afstand"

msgid "URI locator configuration"
msgstr "Configuratie URI-locator"

msgid "The locator URI"
msgstr "De URI van de locator"

msgid "Assets"
msgstr "Bedrijfsmiddelen"

msgid "Provides access to asset library files."
msgstr "Biedt toegang tot assetbibliotheekbestanden."

msgid "Library definitions"
msgstr "Bibliotheekdefinities"

msgid "Provides access to library definition files."
msgstr "Biedt toegang tot bibliotheekdefinitiebestanden."

msgid "PHP library files"
msgstr "PHP-bibliotheekbestanden"

msgid "Provides access to PHP library files."
msgstr "Biedt toegang tot PHP-bibliotheekbestanden."

