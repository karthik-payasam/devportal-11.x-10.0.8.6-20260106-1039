msgid "Facets range slider"
msgstr "Регулятор диапазона фасетов"

msgid "The jquery ui slider pips library is not installed."
msgstr "Библиотека jQuery UI Slider Pips не установлена."

msgid "The range slider library is not installed, check the <a href=\":readme\">README.txt for more information</a> and <a href=\":docs\">the documentation for information on how to install a library</a>."
msgstr "Библиотека регулятора диапазона не установлена, инструкции по установке библиотеки приведены в файле <a href=\":readme\">README.txt</a> и <a href=\":docs\">документации</a>."

msgid "Facets Range Widget"
msgstr "Виджет диапазона фасетов"

msgid "Provides a range widget and solid slider."
msgstr "Предоставляет виджет диапазона и сплошной ползунок."

msgid "Search"
msgstr "Поиск"

msgid "List of range widget configuration"
msgstr "Конфигурация виджета Список диапазонов"

msgid "Prefix"
msgstr "Префикс"

msgid "Suffix"
msgstr "Суффикс"

msgid "Minimum type"
msgstr "Тип минимума"

msgid "Minimum value"
msgstr "Минимальное значение"

msgid "Maximum type"
