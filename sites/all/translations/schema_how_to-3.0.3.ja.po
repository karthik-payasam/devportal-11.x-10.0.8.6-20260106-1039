msgid "Schema.org HowTo"
msgstr "Schema.org HowTo"

msgid "Adds Schema.org/HowTo to the JSON LD array."
msgstr "Schema.org/HowTo を JSON LD 配列に追加します。"

msgid "SEO"
msgstr "SEO"

msgid "@type"
msgstr "@type"

msgid "name"
msgstr "名前"

msgid "step"
msgstr "step"

msgid "description"
msgstr "説明"

msgid "@id"
msgstr "@id"

msgid "image"
msgstr "イメージ"

