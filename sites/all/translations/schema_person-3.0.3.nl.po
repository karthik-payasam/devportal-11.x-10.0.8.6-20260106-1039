msgid "Schema.org: Person"
msgstr "Schema.org: Person"

msgid "An additional name for a Person, can be used for a middle name."
msgstr "Een extra naam voor een persoon. Kan worden gebruikt als tweede voornaam."

msgid "Physical address of the person."
msgstr "Het fysieke adres van de persoon."

msgid "An organization that this person is affiliated with. For example, a school/university, a club, or a team."
msgstr "Een organisatie waaraan deze persoon gelieerd is. Bijvoorbeeld: een school/universiteit, een club of een team."

msgid "An alias for the person."
msgstr "Een alias voor de persoon."

msgid "birthDate"
msgstr "birthDate"

msgid "Date of birth of the person in ISO 8601 format, 2017-12-31."
msgstr "De geboortedatum van de persoon in ISO 8601-indeling, 2017-12-31."

msgid "The brand of the person."
msgstr "Het merk van de persoon."

msgid "A description of the person."
msgstr "Een beschrijving van de persoon."

msgid "The email address of the person."
msgstr "Het e-mailadres van de persoon."

msgid "familyName"
msgstr "familyName"

msgid "Family name. In the U.S., the last name of an Person. This can be used along with givenName instead of the name property."
msgstr "De familienaam. In de VS, de achternaam van een persoon. Kan, in plaats van de eigenschap name, worden gebruikt in combinatie met givenName."

msgid "Gender of the person."
msgstr "Het geslacht van de persoon."

msgid "givenName"
msgstr "givenName"

msgid "Given name. In the U.S., the first name of a Person. This can be used along with familyName instead of the name property."
msgstr "De gegeven naam. In de VS, de voornaam van een persoon. Kan, in plaats van de eigenschap name, worden gebruikt in combinatie met familyName."

msgid "Globally unique id of the person, usually a url."
msgstr "Globaal uniek ID van de persoon, meestal een url."

msgid "The primary image for the person."
msgstr "De primaire afbeelding voor de persoon."

msgid "jobTitle"
msgstr "jobTitle"

msgid "The job title of the person (for example, Financial Manager)."
msgstr "De functie van de persoon (bijvoorbeeld: Financieel Manager)."

msgid "memberOf"
msgstr "memberOf"

msgid "An Organization (or ProgramMembership) to which this Person belongs."
msgstr "Een organisatie (of ProgramMembership) waartoe deze persoon behoort."

msgid "REQUIRED BY GOOGLE. The name of the person."
msgstr "VEREIST DOOR GOOGLE. De naam van de persoon."

msgid "REQUIRED BY GOOGLE. A single or an [array] of URLs for the person's official social media profile page(s)."
msgstr "VEREIST DOOR GOOGLE. Eén URL of een [array] van URL's voor de officiële profielpagina('s) van de persoon op sociale media."

msgid "The telephone number of the person."
msgstr "Het telefoonnummer van de persoon."

msgid "REQUIRED. The type of person (fixed by standard)."
msgstr "VEREIST. Het type persoon (standaard vastgesteld)."

msgid "REQUIRED BY GOOGLE. The URL for the person's official website."
msgstr "VEREIST DOOR GOOGLE. De URL voor de officiële website van de persoon."

msgid "worksFor"
msgstr "worksFor"

msgid "Organizations that the person works for."
msgstr "Organisaties waar de persoon voor werkt."

