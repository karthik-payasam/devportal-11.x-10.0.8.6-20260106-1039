msgstr "Sommige bestanden die u probeert te uploaden, zijn niet gevalideerd. De vereisten zijn: maximumgrootte bestand %size, toegestane extensies zijn %extensions"

msgid "At least one valid file should be uploaded."
msgstr "Er moet ten minste één geldig bestand worden geüpload."

msgid "MB"
msgstr "MB"

msgid "A space separated list of file extensions"
msgstr "Een door spaties gescheiden lijst van bestandsextensies"

msgid "Use client side resizing"
msgstr "Formaatwijziging op de client gebruiken"

msgid "Requires droopzone version v4.4.0 or higher and the <a href=\"@exif\" target=\"_blank\">exif</a> library."
msgstr "Hiervoor is droopzone versie v4.4.0 of hoger vereist, plus de <a href=\"@exif\" target=\"_blank\">exif</a>-bibliotheek."

msgid "Max width"
msgstr "Max. breedte"

msgid "Max height"
msgstr "Max. hoogte"

msgid "Resize method"
msgstr "Methode voor formaatwijziging"

