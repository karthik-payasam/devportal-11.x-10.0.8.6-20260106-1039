msgid "About"
msgstr "Acerca de"

msgid "Secure File Upload Mime Detect"
msgstr "Detección de Mime para carga segura de archivos"

msgid "Fileinfo extension"
msgstr "Extensión Fileinfo"

msgid "Found"
msgstr "Encontrado"

msgid "Fileinfo extension not available"
msgstr "La extensión Fileinfo no está disponible"

msgid "File upload secure validator module uses Fileinfo extension. It seems as if Fileinfo extension is not loaded/enabled. If you are using Windows, may be, you should uncomment php_fileinfo.dll in php.ini file."
msgstr "El módulo validador seguro de carga de archivos usa la extensión Fileinfo. Parece que la extensión Fileinfo no está cargada/habilitada. Si está usando Windows, puede que tenga que descomentar php_fileinfo.dll en el archivo php.ini."

msgid "File Upload Secure Validator"
msgstr "Validador seguro de carga de archivos"

msgid "Secure Mime Detect"
msgstr "Detección de MIME seguro"

msgid "Security"
msgstr "Seguridad"

msgid "Manage the list of MIME types equivalence groups."
msgstr "Gestionar la lista de grupos de equivalencia de tipos MIME."

msgid "Administer File Upload Secure Validator configuration"
msgstr "Administrar configuración de validador seguro de carga de archivos"

msgid "Allow user to administer File Upload Secure Validator configuration."
msgstr "Permitir al usuario administrar la configuración del validador seguro de carga de archivos."

msgid "SettingsForm"
msgstr "SettingsForm"

msgid "MIME types equivalence groups"
msgstr "Grupos de equivalencia de tipos MIME"

msgid "MIME types equivalence group"
msgstr "Grupo de equivalencia de tipos MIME"

msgid "MIME type"
msgstr "Tipo MIME"

msgid "MIME types equivalence group(s)"
msgstr "Grupo(s) de equivalencia de tipos MIME"

msgid "A CSV-like list of MIME types groups; if two MIME types are part of the same group, then, File Upload Secure Validator will not protest."
msgstr "Una lista de tipo CSV de grupos de tipos MIME; si dos tipos MIME forman parte del mismo grupo, el validador de carga segura de archivos no protestará."

msgid "Caught an InvalidArgumentException; cannot validate missing file requested as @path"
msgstr "Se ha capturado una excepción InvalidArgument; no se puede validar el archivo que falta solicitado como @path"

msgid "There was a problem with this file. The uploaded file is of type @extension but the real content seems to be @real_extension"
msgstr "Ha habido un problema con este archivo. El archivo cargado es del tipo @extension, pero el contenido real parece ser @real_extension"

msgid "Error while uploading file: MimeTypeGuesser guessed '%mime_by_fileinfo' and fileinfo '%mime_by_filename'"
msgstr "Error al cargar el archivo: estimación de MimeTypeGuesser '%mime_by_fileinfo' e información de archivo '%mime_by_filename'"

