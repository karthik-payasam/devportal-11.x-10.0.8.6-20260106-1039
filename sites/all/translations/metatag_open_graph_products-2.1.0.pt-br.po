msgid "About"
msgstr "Sobre"

msgid "Provides additional Open Graph Protocol meta tags for describing products."
msgstr "Fornece metatags adicionais do Protocolo Open Graph para descrever produtos."

msgid "Metatag: Open Graph Products"
msgstr "Metatag: produtos Open Graph"

msgid "SEO"
msgstr "SEO"

msgid "Open Graph Product: Price availability"
msgstr "Produto Open Graph: disponibilidade de preço"

msgid "Open Graph Product: Product condition"
msgstr "Produto Open Graph: condição do produto"

msgid "Open Graph Product: Price amount"
msgstr "Produto gráfico aberto: valor do preço"

msgid "Open Graph Product: Price currency"
msgstr "Produto gráfico aberto: moeda do preço"

msgid "Open Graph Product: Retailer Item ID"
msgstr "Produto Open Graph: ID do item varejista"

msgid "Open Graph - Products"
msgstr "Open Graph - Produtos"

msgid "These <a href='https://ogp.me/'>Open Graph meta tags</a> are for describing products.<br><br>The Facebook <a href='https://developers.facebook.com/tools/debug/'>Sharing Debugger</a> lets you preview how your content will look when it's shared to Facebook and debug any issues with your Open Graph tags."
msgstr "Estas <a href='https://ogp.me/'>Meta tags do Open Graph</a> são para descrever produtos.<br><br>O <a href='https://developers.facebook.com/tools/debug/'>Sharing Debugger</a> do Facebook permite visualizar como seu conteúdo se parecerá quando for compartilhado no Facebook e depurar problemas com suas tags do Open Graph."

msgid "Product availability"
msgstr "Disponibilidade do produto"

msgid "The availability of the product."
msgstr "A disponibilidade do produto."

msgid "Product condition"
msgstr "Condição do produto"

msgid "The condition of the product."
msgstr "A condição do produto."

msgid "Product price amount"
msgstr "Valor do preço do produto"

msgid "The price amount of the product."
msgstr "O valor do preço do produto."

msgid "Product price currency"
msgstr "Moeda do preço do produto"

msgid "The price currency of the product."
msgstr "A moeda do preço do produto."

msgid "Retailer Item ID"
msgstr "ID do item varejista"

msgid "The ID of the product as provided by the retailer."
msgstr "O ID do produto conforme fornecido pelo varejista."

