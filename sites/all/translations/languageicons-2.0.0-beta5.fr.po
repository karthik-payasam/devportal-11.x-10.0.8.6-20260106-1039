msgid "This module manages language icons for multilingual sites:"
msgstr "Ce module gère les icônes de langue pour les sites multilingues&nbsp;:"

msgid "Automatically adds icons to language links."
msgstr "Ajoute automatiquement les icônes aux liens de langue."

msgid "Provides related theme functions."
msgstr "Fournit des fonctions relatives au thème."

msgid "For more information, please see <a href=\"@handbook\">the online handbook section</a>."
msgstr "Pour plus d'information, voir la <a href=\"@handbook\">section du manuel en ligne</a>."

msgid "To enable multilingual support for specific content types go to <a href=\"@configure_content_types\">configure content types</a>."
msgstr "Pour activer la prise en charge multilingue par type de contenu <a href=\"@configure_content_types\">configurez les types de contenu</a> directement."

msgid "Language Icons"
msgstr "Icônes de langue"

msgid "Adds icons to language links."
msgstr "Ajoute les icônes aux liens de langue."

msgid "Multilingual"
msgstr "Multilingue"

msgid "Language icons"
msgstr "Icônes de langue"

msgid "Configure the Language Icons module."
msgstr "Configurez le module Icônes de langue."

msgid "Icons"
msgstr "Icônes"

msgid "Language Icons settings"
msgstr "Paramètres Icônes de langue"

msgid "Show the icons on a node"
msgstr "Afficher les icônes sur un noeud"

msgid "Show the icons on the language switcher block"
msgstr "Afficher les icônes sur le bloc sélecteur de langue"

msgid "Add language icons"
msgstr "Ajouter les icônes de langue"

msgid "Link types to add language icons."
msgstr "Types de liens sur lesquels ajouter les icônes de langue."

msgid "Node links"
msgstr "Liens de nœuds"

msgid "Language switcher block"
msgstr "Bloc du sélecteur de langue"

msgid "These options are currently disabled due to <a href=\":issue_url\">a bug</a> that cannot currently be resolved. They may be reintroduced at a later stage."
msgstr "Ces options sont actuellement désactivées en raison d'<a href=\":issue_url\">un bogue</a> qui ne peut pas être résolu pour l'instant. Elles pourront être réintroduites ultérieurement."

msgid "Icon placement"
msgstr "Placement de l'icône"

msgid "Before link"
msgstr "Avant le lien"

msgid "After link"
msgstr "Après le lien"

msgid "Replace link"
msgstr "Remplacer le lien"

msgid "Where to display the icon, relative to the link title."
msgstr "Où afficher l'icône, relatif au titre du lien."

msgid "Icons file path"
msgstr "Chemin des icônes"

msgid "Path for language icons, relative to Drupal installation. \"*\" is a placeholder for language code."
msgstr "Chemin pour les icônes de langue, relatif au chemin d'installation de Drupal. '*' est un joker pour le code de la langue."

msgid "Image size"
msgstr "Taille de l'image"

msgid "Image size for language icons, in the form \"width x height\"."
msgstr "Taille de l'image pour les icônes de langue, sous la forme de \"largeur x hauteur\"."

