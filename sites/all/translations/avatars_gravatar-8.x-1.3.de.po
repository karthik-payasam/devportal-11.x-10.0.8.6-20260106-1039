msgid "Gravatar"
msgstr "Gravatar"

msgid "Adds Gravatar.com avatar generators for Avatar Kit."
msgstr "Fügt Gravatar.com-Avatar-Generatoren für Avatar Kit hinzu."

msgid "Avatars"
msgstr "Avatare"

msgid "Maximum content rating"
msgstr "Maximaleinstufung"

msgid "Gravatar generator"
msgstr "Gravatar-Generator"

msgid "Type"
msgstr "Typ"

msgid "Unrestricted"
msgstr "Unbeschränkt"

msgid "G: suitable for display on all websites with any audience type."
msgstr "G: geeignet für die Anzeige auf allen Websites mit beliebigen Zielgruppen."

msgid "PG: may contain rude gestures, provocatively dressed individuals, the lesser swear words, or mild violence."
msgstr "PG: kann rüde Gesten, aufreizend gekleidete Personen, mildere Kraftausdrücke oder moderate Darstellungen von Gewalt enthalten."

msgid "R: may contain such things as harsh profanity, intense violence, nudity, or hard drug use."
msgstr "R: kann obszöne Ausdrücke, intensive Gewaltanwendung, Nacktheit und schweren Drogengebrauch enthalten."

msgid "X: may contain hardcore sexual imagery or extremely disturbing violence."
msgstr "X: kann extreme pornografische Bilder oder extrem verstörende Gewaltszenen enthalten."

msgid "Maximum rating: @maximum_rating"
msgstr "Maximaleinstufung: @maximum_rating"

msgid "Universal avatar uploaded to Gravatar.com"
msgstr "Allgemeiner Avatar auf Gravatar.com hochgeladen"

msgid "Identicon"
msgstr "Identicon"

msgid "Monster ID"
msgstr "Monster-ID"

msgid "Wavatar"
msgstr "Wavatar"

msgid "8-bit style avatar"
msgstr "8-Bit-Avatar"

msgid "Missing Configuration"
msgstr "Fehlende Konfiguration"

msgid "Type: @type"
msgstr "Typ: @type"

msgid "Identicon, MonsterID, Retro, and Wavatar avatar generators."
msgstr "Identicon-, MonsterID-, Retro- und Wavatar-Avatar-Generatoren."

