msgid "Schema.org: Product"
msgstr "Schema.org: Ürün"

msgid "RECOMMENDED BY GOOGLE. The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Öğenin, inceleme ya da değerlendirme toplamına dayalı genel notu."

msgid "RECOMMENDED BY GOOGLE. The brand of the product."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Ürünün markası."

msgid "RECOMMENDED BY GOOGLE. The category of the product."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Ürünün kategorisi."

msgid "RECOMMENDED BY GOOGLE. A description of the item."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Öğenin açıklaması."

msgid "RECOMMENDED BY GOOGLE. Populate one of sku, gtin8, gtin12, gtin13, gtin14, isbn, or mpn."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. sku, gtin8, gtin12, gtin13, gtin14, isbn veya mpn alanlarından birini doldurun."

msgid "Globally unique ID of the product in the form of a URL. It does not have to be a working link."
msgstr "Ürünün URL biçimindeki genel olarak benzersiz tanıtıcısı. Çalışan bir bağlantı olması gerekmez."

msgid "REQUIRED BY GOOGLE. The primary image for this item."
msgstr "GOOGLE İÇİN ZORUNLU. Bu öğe için birincil resim."

msgid "REQUIRED BY GOOGLE. The name of the product."
msgstr "GOOGLE İÇİN ZORUNLU. Ürünün adı."

msgid "RECOMMENDED BY GOOGLE. Offers associated with the product."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Ürünle ilişkili teklifler."

msgid "RECOMMENDED BY GOOGLE. Reviews of this item."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Bu öğenin incelemeleri."

msgid "REQUIRED. The type of product."
msgstr "ZORUNLU. Ürünün tipi."

msgid "RECOMMENDED BY GOOGLE. The url of the product."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Ürünün URL'si."

