msgid "Schema.org: Organization"
msgstr "Schema.org: Organization"

msgid "RECOMMENDED BY GOOGLE for food establishments, True or False. If True, the best practice is to also define potentialAction."
msgstr "RECOMENDADO POR para establecimientos alimentarios, Verdadero o Falso. Si es Verdadero, el procedimiento recomendado es definir también potentialAction."

msgid " An additional type for the item, typically used for adding more specific types from external vocabularies in microdata syntax. This is a relationship between something and a class that the thing is in."
msgstr " Un tipo adicional para el elemento, utilizado normalmente para añadir tipos más específicos de vocabularios externos en sintaxis de microdatos. Esta es una relación entre algo y una clase en la que está la cosa."

msgid "REQUIRED BY GOOGLE. The address of the organization."
msgstr "NECESARIO PARA GOOGLE. La dirección de la organización."

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "La valoración general, basada en una recopilación de revisiones o valoraciones del elemento."

msgid "The brand of the organization."
msgstr "La marca de la organización."

msgid "RECOMMENDED BY GOOGLE. A description of the item."
msgstr "RECOMENDADO POR GOOGLE. Una descripción del elemento."

msgid "RECOMMENDED BY GOOGLE. The geographic coordinates of a place or event."
msgstr "RECOMENDADO POR GOOGLE. Las coordenadas geográficas de un lugar o un evento."

msgid "REQUIRED BY GOOGLE. Globally unique @id, usually a url, used to to link other properties to this object."
msgstr "NECESARIO PARA GOOGLE. @id exclusivo global, normalmente un URL, utilizado para enlazar otras propiedades a este objeto."

msgid "The primary image for this item."
msgstr "La imagen primaria de este elemento."

msgid "The logo for this organization."
msgstr "El logotipo de esta organización."

msgid "An Organization (or ProgramMembership) to which this Organization belongs."
msgstr "Una organización (o ProgramMembership) a la que esta organización pertenece."

msgid "RECOMMENDED BY GOOGLE for food establishments, the fully-qualified URL of the menu."
msgstr "RECOMENDADO POR para establecimientos alimentarios, el URL completo del menú."

msgid "REQUIRED BY GOOGLE. The name of the organization."
msgstr "NECESARIO PARA GOOGLE. El nombre de la organización."

msgid "RECOMMENDED BY GOOGLE. Hours during which the business location is open."
msgstr "RECOMENDADO POR GOOGLE. Horas durante las que la ubicación del negocio está abierta."

msgid "RECOMMENDED BY GOOGLE. Potential action provided by this organization."
msgstr "RECOMENDADO POR GOOGLE. Posible acción proporcionada por esta organización."

msgid "The price range of products of the organization."
msgstr "El rango de precios de los productos de la organización."

msgid "Reviews of this organization."
msgstr "Revisiones de esta organización."

msgid "Url linked to the web site, such as wikipedia page or social profiles."
msgstr "URL relacionado con el sitio web, como por ejemplo la página de Wikipedia o los perfiles sociales."

msgid "An official rating for a lodging business or food establishment, e.g. from national associations or standards bodies."
msgstr "Una valoración oficial de un negocio de alojamiento o un establecimiento alimentario, p. ej. de asociaciones nacionales o cuerpos de estándares."

msgid "RECOMMENDED BY GOOGLE. A business phone number meant to be the primary contact method for customers. Be sure to include the country code and area code in the phone number."
msgstr "RECOMENDADO POR GOOGLE. Un número de teléfono del negocio que sea el método de contacto primario de los clientes. Asegúrese de incluir el código de país y el código de área en el número de teléfono."

msgid "REQUIRED. The type of organization."
msgstr "OBLIGATORIO. El tipo de organización."

msgid "RECOMMENDED BY GOOGLE. The url of the organization."
msgstr "RECOMENDADO POR GOOGLE. El URL de la organización."

