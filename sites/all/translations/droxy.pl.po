msgid "About"
msgstr "O stronie"

msgid "Drupal Proxy Module"
msgstr "Moduł Drupal Proxy"

msgid "Drupal Proxy"
msgstr "Drupal Proxy"

msgid "Proxy"
msgstr "Proxy"

msgid "Proxy Settings"
msgstr "Ustawienia proxy"

msgid "ProxySettingForm"
msgstr "ProxySettingForm"

msgid "Https or Https"
msgstr "Https lub Https"

msgid "type of Scheme"
msgstr "typ schematu"

msgid "Proxy Server"
msgstr "Serwer proxy"

msgid "The IP address or hostname of the proxy server."
msgstr "Adres IP lub nazwa hosta serwera proxy."

msgid "Port"
msgstr "Port"

msgid "The port number used by the proxy server for client connections."
msgstr "Numer portu używany przez serwer proxy na potrzeby połączeń klientów."

msgid "Proxy Username"
msgstr "Nazwa użytkownika proxy"

msgid "A username used of proxy server for Authentication."
msgstr "Nazwa użytkownika używana przez serwer proxy do uwierzytelniania."

msgid "Proxy Password"
msgstr "Hasło proxy"

msgid "Password of proxy server used for Authentication."
msgstr "Hasło serwera proxy używanego do uwierzytelniania."

msgid "Proxy User Agent"
msgstr "Agent użytkownika proxy"

msgid "A string which can be used by the proxy server to identify connection requests."
msgstr "Łańcuch, który może być używany przez serwer proxy do identyfikowania żądań połączenia."

msgid "Proxy Exceptions"
msgstr "Wyjątki proxy"

msgid "Specify exceptions using either IP addresses or hostnames. Enter one exception per line. Exceptions will be accessed directly, not via proxy."
msgstr "Podaj wyjątki przy użyciu adresów IP lub nazw hostów. W każdym wierszu wprowadź jeden wyjątek. Dostęp do wyjątków będzie odbywał się bezpośrednio, a nie za pośrednictwem proxy."

