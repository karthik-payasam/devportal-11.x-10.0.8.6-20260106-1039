msgctxt "Validation"
msgid "Unique path alias."
msgstr "Unikalny alias ścieżki."

msgid "The alias %alias is already in use in this language."
msgstr "Alias %alias już istnieje w tym języku."

msgid "The alias %alias could not be added because it is already in use in this language with different capitalization: %stored_alias."
msgstr "Alias %alias nie mógł zostać dodany ponieważ istnieje w tej wersji językowej ale z użyciem innego zestawu wielkich/małych liter, jako: %stored_alias."

msgctxt "Validation"
msgid "Valid path."
msgstr "Poprawna ścieżka."

msgid "Either the path '%link_path' is invalid or you do not have access to it."
msgstr "Ścieżka '%link_path' jest nieprawidłowa lub nie masz do niej dostępu."

msgid "Select a @context value:"
msgstr "Wybierz wartość @context:"

msgctxt "Validation"
msgid "Plugin exists"
msgstr "Wtyczka istnieje"

msgid "The '@plugin_id' plugin does not exist."
msgstr "Wtyczka '@plugin_id' nie istnieje."

msgid "The '@plugin_id' plugin must implement or extend @interface."
msgstr "Wtyczka '@plugin_id' musi implementować lub rozszerzać interfejs @interface."

msgid "%name must be a valid color."
msgstr "%name musi być prawidłowym kolorem."

msgid "Required"
msgstr "Wymagane"

msgid "The email address %mail is not valid."
msgstr "Adres e-mial %mail nie jest prawidłowy."

msgid "%name field is not in the right format."
msgstr "Format pola %name jest nieprawidłowy."

msgid "Machine-readable name"
msgstr "Nazwa wewnętrzna"

msgid "A unique machine-readable name. Can only contain lowercase letters, numbers, and underscores."
msgstr "Unikalna nazwa wewnętrzna. Może zawierać jedynie małe litery, cyfry i łączniki."

msgid "Machine name"
msgstr "Identyfikator systemowy"

msgid "The machine-readable name must contain unique characters."
msgstr "Nazwa wewnętrzna musi zawierać unikalne znaki."

msgid "The machine-readable name must contain only lowercase letters, numbers, and hyphens."
msgstr "Nazwa wewnętrzna może zawierać jedynie małe litery, liczby i dywizy."

msgid "The machine-readable name must contain only lowercase letters, numbers, and underscores."
msgstr "Nazwa wykorzystywana wewnętrznie może zawierać jedynie małe litery, znaki podkreślenia oraz liczby."

msgid "The machine-readable name is already in use. It must be unique."
msgstr "Podana nazwa wewnętrzna jest już w użyciu. Musi być ona unikalna."

msgid "More"
msgstr "Więcej"

msgid "%name must be a number."
msgstr "%name musi być liczbą."

msgid "%name must be higher than or equal to %min."
msgstr "Wartość elementu %name musi być większa lub równa %min."

msgid "%name must be lower than or equal to %max."
msgstr "Wartość elementu %name musi być mniejsza lub równa %max."

msgid "%name is not a valid number."
msgstr "Wartość elementu %name nie jest prawidłowym numerem."

msgid "Confirm password"
msgstr "Potwierdź hasło"

msgid "The specified passwords do not match."
msgstr "Podane hasła nie są jednakowe."

msgid "Password field is required."
msgstr "Pole Hasło jest wymagane."

msgid "You cannot use an external URL, please enter a relative path."
msgstr "Nie można używać zewnętrznego adresu URL, prosimy wprowadzić ścieżkę względną."

msgid "This path does not exist or you do not have permission to link to %path."
msgstr "Ścieżka nie istnieje lub brak uprawnień do tworzenia odnośnika do %path."

msgid "- Select -"
msgstr "- Wybierz -"

msgid "Status message"
msgstr "Komunikat"

msgid "Error message"
msgstr "Komunikat o błędzie"

msgid "Warning message"
msgstr "Ostrzeżenie"

