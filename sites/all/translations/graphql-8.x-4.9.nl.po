msgid "About"
msgstr "Over"

msgid ""
"\n"
"<p>This module generates and exposes a\n"
"  <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a> schema for\n"
"  <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a> entities,\n"
"  and allows you to expose your own custom schema in a consistent way and with\n"
"  minimal effort.</p>"
msgstr ""
"\n"
"<p>Deze module genereert een\n"
"  <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a>-schema voor\n"
"  <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a>-entiteiten, maakt dit zichtbaar\n"
"  en stelt u in staat om uw eigen, aangepaste schema op een consequente manier zichtbaar te maken, \n"
"  met minimale inspanning.</p>"

