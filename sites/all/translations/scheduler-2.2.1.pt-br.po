msgstr "Digite uma data. A hora é opcional."

msgid "The default time is @default_time."
msgstr "A hora padrão é @default_time."

msgid "Enter a date and time."
msgstr "Digite uma data e hora."

msgid "Leave the date blank for no scheduled publishing."
msgstr "Deixe a data em branco para nenhuma publicação planejada."

msgid "Leave the date blank for no scheduled unpublishing."
msgstr "Deixe a data em branco para não agendar uma despublicação."

