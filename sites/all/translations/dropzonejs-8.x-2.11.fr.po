msgid "About"
msgstr "À propos"

msgid "DropzoneJS"
msgstr "DropzoneJS"

msgid "or"
msgstr "ou"

msgid "Select file"
msgid_plural "Select files"
msgstr[0] "Sélectionner un fichier"
msgstr[1] "Sélectionner des fichiers"

msgid "Dropzone library missing"
msgstr "Bibliothèque Dropzone manquante "

msgid ""
"Dropzonejs requires the dropzone.min.js library.\n"
"        Download it (https://github.com/enyo/dropzone) and place it in the\n"
"        libraries folder (/libraries)"
msgstr ""
"Dropzonejs requiert la bibliothèque dropzone.min.js.\n"
"        Téléchargez-la (https://github.com/enyo/dropzone) et placez-la dans le\n"
"        dossier des bibliothèques (/libraries). "

msgid "dropzonejs"
msgstr "dropzonejs"

msgid "The Drupal integration for DropzoneJS."
msgstr "Intégration de Drupal pour DropzoneJS."

msgid "Media"
msgstr "Média"

msgid "Dropzone upload files"
msgstr "Fichiers de téléchargement de Dropzone "

msgid "Allow uploading of files via dropzonejs."
msgstr "Autorisez le téléchargement de fichiers via dropzonejs."

msgid "DropzoneJS settings"
msgstr "Paramètres DropzoneJS "

msgid "Upload scheme"
msgstr "Schéma de téléchargement "

msgid "Transliterate names of uploaded files"
msgstr "Translitérer les noms des fichiers téléchargés"

msgid "Upload timeout"
msgstr "Délai de téléchargement"

msgid "Drop files here to upload"
msgstr "Déposer des fichiers ici pour les transférer"

msgid "Your browser does not support drag'n'drop file uploads."
msgstr "Votre navigateur ne prend pas en charge les transferts de fichiers par glisser-déposer."

msgid "Please use the fallback form below to upload your files like in the olden days."
msgstr "Utilisez le formulaire de rétromigration ci-dessous pour transférer vos fichiers comme par le passé."

msgid "File is too big ({{filesize}}MiB). Max filesize: {{maxFilesize}}MiB."
msgstr "Fichier trop volumineux ({{filesize}} Mio). Taille de fichier max. : {{maxFilesize}} Mio. "

msgid "You can't upload files of this type."
msgstr "Vous ne pouvez pas transférer de fichiers de ce type."

msgid "Server responded with {{statusCode}} code."
msgstr "Le serveur a répondu avec le code {{statusCode}}."

msgid "Cancel upload"
msgstr "Annuler le transfert"

msgid "Are you sure you want to cancel this upload?"
msgstr "Voulez-vous vraiment annuler ce transfert ?"

msgid "Remove file"
msgstr "Supprimer le fichier"

msgid "You can not upload any more files."
msgstr "Vous ne pouvez plus transférer de fichiers."

msgid "TB"
msgstr "TB"

msgid "GB"
msgstr "GB"

msgid "MB"
msgstr "Mo"

msgid "KB"
msgstr "Ko"

msgid "b"
msgstr "b"

msgid "DropzoneJS entity browser widget"
msgstr "Widget d'afficheur d'entité DropzoneJS "

msgid "DropzoneJS Entity browser widget."
msgstr "Widget d'afficheur d'entité DropzoneJS."

msgid "DropzoneJS widget configuration"
msgstr "Configuration du widget DropzoneJS "

msgid "Submit button text"
msgstr "Texte du bouton de soumission"

msgid "Automatically submit selection"
msgstr "Soumettre automatiquement la sélection "

msgid "Upload location"
msgstr "Transférer l'emplacement"

msgid "Dropzone drag-n-drop zone text"
msgstr "Texte pour le glisser-déposer dans une zone Dropzone "

msgid "Maximum size of files"
msgstr "Taille maximale des fichiers "

msgid "Allowed file extensions"
msgstr "Extensions de fichier autorisées"

msgid "Use clientside resize"
msgstr "Utiliser le redimensionnement côté client"

msgid "Maximum width"
msgstr "Largeur maximum"

msgid "Maximum height"
msgstr "Hauteur maximum"

msgid "Resize quality"
msgstr "Qualité du redimensionnement"

msgid "Method used for resizing"
msgstr "Méthode utilisée pour le redimensionnement"

msgid "Method used for generating the thumbnail"
msgstr "Méthode utilisée pour la génération de la miniature"

msgid "Media Entity DropzoneJS widget configuration"
msgstr "Configuration du widget DropzoneJS des entités de média"

msgid "Media type"
msgstr "Type de média"

msgid "Media Entity DropzoneJS with edit widget configuration"
msgstr "Configuration du widget DropzoneJS des entités de média avec édition "

msgid "Form mode"
msgstr "Mode de saisie"

msgid "Drop files here to upload them"
msgstr "Déposez les fichiers ici pour les télécharger "

msgid "File upload"
msgstr "Transfert de fichier"

msgid "Files could not be uploaded because the destination directory %destination is not configured correctly."
msgstr "Les fichiers n'ont pas pu être téléchargés car le répertoire de destination %destination n'est pas configuré correctement. "

msgid "Some files that you are trying to upload did not pass validation. Requirements are: max file %size, allowed extensions are %extensions"
msgstr "Certains fichiers que vous tentez de télécharger n'ont pas été validés. Les exigences sont les suivantes : taille maximale des fichiers : %size, extensions admises : %extensions"

msgid "At least one valid file should be uploaded."
msgstr "Un fichier valide au moins doit être téléchargé. "

msgid "A space separated list of file extensions"
msgstr "Liste d'extensions de fichier séparées par un espace "

msgid "Use client side resizing"
msgstr "Utiliser le redimensionnement côté client"

msgid "Requires droopzone version v4.4.0 or higher and the <a href=\"@exif\" target=\"_blank\">exif</a> library."
msgstr "Requiert droopzone version v4.4.0 ou suivante et la bibliothèque <a href=\"@exif\" target=\"_blank\">exif</a>."

msgid "Max width"
msgstr "Largeur maximale"

msgid "Max height"
msgstr "Hauteur max"

msgid "Resize method"
msgstr "Méthode de redimensionnement"

msgid "Contain (scale)"
msgstr "Contenir (mettre à l'échelle)"

msgid "Crop"
msgstr "Recadrer"

msgid "Thumbnail method"
msgstr "Méthode de miniature"

msgid "Invalid extension list format."
msgstr "Format de la liste d'extensions non valide "

msgid "Adds DropzoneJS upload integration."
msgstr "Ajoute l'intégration du téléchargement DropzoneJS. "

msgid "Missing requirement: in order to use this widget you have to install Inline entity form module first"
msgstr "Condition requise manquante : pour pouvoir utiliser ce widget, vous devez d'abord installer le module Formulaire d'entité en ligne. "

msgid "Edit"
msgstr "Modifier"

msgid "Media Entity DropzoneJS with edit"
msgstr "Widget DropzoneJS des entités de média avec édition "

msgid "Adds DropzoneJS upload integration that saves Media entities and allows to edit them."
msgstr "Ajoute l'intégration du téléchargement DropzoneJS qui sauvegarde les entités de média et permet de les éditer "

msgid "The type of media entity to create from the uploaded file(s)."
msgstr "Type d'entité de média à créer depuis le ou les fichiers téléchargés. "

msgid "You must @create_media_type before using this widget."
msgstr "Vous devez @create_media_type avant d'utiliser ce widget."

msgid "create a media type"
msgstr "créer un type de média"

msgid "Media Entity DropzoneJS"
msgstr "DropzoneJS des entités de média "

msgid "Adds DropzoneJS upload integration that saves Media entities."
msgstr "Ajoute l'intégration du téléchargement DropzoneJS qui sauvegarde les entités de média. "

msgid "For security reasons, your upload has been renamed to %filename."
msgstr "Pour des raisons de sécurité, votre fichier a été renommé en %filename."

msgid "The specified file %name could not be uploaded."
msgstr "Le fichier spécifié %name n'a pas pu être transféré."

msgid "The file could not be uploaded because the destination %destination is invalid."
msgstr "Le fichier %file n'a pas pu être transféré car la destination %destination n'est pas valide."

msgid "File upload error. Could not move uploaded file."
msgstr "Erreur de transfert de fichier. Impossible de déplacer le fichier transféré."

msgid "Upload error. Could not move uploaded file %file to destination %destination."
msgstr "Erreur de transfert. Impossible de déplacer le fichier transféré (%file) vers la destination (%destination)."

msgid "The file could not be saved because it exceeds the maximum allowed size for uploads."
msgstr "Le fichier n'a pas pu être sauvegardé car sa taille est supérieure à la taille maximale autorisée pour les téléchargements. "

msgid "The file could not be saved because the upload did not complete."
msgstr "Le fichier n'a pas pu être sauvegardé car le téléchargement n'a pas abouti. "

msgid "The file could not be saved. An unknown error has occurred."
msgstr "Le fichier n'a pas pu être sauvegardé. Une erreur inconnue s'est produite."

msgid "There was a problem while processing the file named @name"
msgstr "Un problème est survenu lors du traitement du fichier nommé @name"

msgid "You don't have sufficent permissions to use the DropzoneJS uploader. Contact your system administrator"
msgstr "Vous ne disposez pas de droits suffisants pour pouvoir utiliser le programme de téléchargement DropzoneJS. Prenez contact avec l'administrateur système."

msgid "A maximum of @count files can be uploaded."
msgstr "Un maximum de @count fichiers peuvent être transférés."

msgid "Drop file here to upload it"
msgid_plural "Drop files here to upload them"
msgstr[0] "Déposez le fichier ici pour le transférer"
msgstr[1] "Déposez les fichiers ici pour les télécharger"

