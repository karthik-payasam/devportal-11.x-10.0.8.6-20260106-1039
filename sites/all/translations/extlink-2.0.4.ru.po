msgid "You can now <a href=\"@extlink_admin\">configure the External Links module</a> for your site."
msgstr "Теперь можно <a href=\"@extlink_admin\">настроить модуль Внешние ссылки</a> для сайта."

msgid "External Links is used to differentiate between internal and external links. Using jQuery, it will find all external links on a page and add an external icon indicating it will take you offsite or a mail icon for mailto links."
msgstr "Модуль Внешние ссылки используется для различения внутренних и внешних ссылок. С помощью jQuery он ищет все внешние ссылки на странице и добавляет значок внешней ссылки, указывающий на то, что ссылка ведет на внешний сайт, или значок почты для ссылок mailto:."

msgid "This link will take you to an external web site. We are not responsible for their content."
msgstr "Эта ссылка ведёт на внешний веб-сайт. Мы не несём ответственности за его содержание."

msgid "(link is external)"
msgstr "(внешняя ссылка)"

msgid "(link sends email)"
msgstr "(ссылка отправляет сообщение электронной почты)"

msgid "External Links"
msgstr "Внешние ссылки"

msgid "Modify behavior and appearance of external links."
msgstr "Изменить поведение и внешний вид внешних ссылок."

msgid "User interface"
msgstr "Интерфейс пользователя"

msgid "External Links administration page."
msgstr "Страница администрирования Внешние ссылки."

msgid "Settings"
msgstr "Настройки"

msgid "Administer External Links"
msgstr "Администрирование внешних ссылок"

msgid "External Links Settings"
msgstr "Настройки внешних ссылок"

msgid "Load exclusions and inclusions externally"
msgstr "Внешняя загрузка исключений и включений"

msgid "Disable module on admin routes."
msgstr "Выключить модуль для административных маршрутов."

msgid "Open external links in a new tab"
msgstr "Открывать внешние ссылки в новой вкладке"

msgid "Do not override target=\"*\" if set"
msgstr "Не переопределять значение target=\"*\", если задано"

msgid "Tag external links as \"no follow\""
msgstr "Пометить внешние ссылки как \"no follow\""

msgid "Tag external links as \"noreferrer\""
msgstr "Пометить внешние ссылки как \"noreferrer\""

msgid "Do not override rel=\"follow\" if set"
msgstr "Не переопределять rel=\"follow\", если задано"

msgid "Consider subdomains internal"
msgstr "Считает поддомены внутренними"

msgid "Enable Pop-up warnings"
msgstr "Включить всплывающие предупреждения"

msgid "Message to display when Pop-up warning is shown"
msgstr "Сообщение, выводимое при показе всплывающего предупреждения"

msgid "Exclude links matching the pattern"
msgstr "Исключать ссылки, попадающие под шаблон"

msgid "Include links matching the pattern"
msgstr "Включать ссылки, попадающие под шаблон"

msgid "Add icon to external links"
msgstr "Добавить значок ко внешним ссылкам"

msgid "Alternative text for external link icon"
msgstr "Альтернативный текст для значка Внешняя ссылка"

msgid "Treat images wrapped in an anchor tag as external links"
msgstr "Считать изображения в теге anchor внешними ссылками"

msgid "Comma-separated list of CSS selectors to exclude"
msgstr "Список исключаемых селекторов CSS через запятую"

msgid "Comma-separated list of CSS selectors to include"
msgstr "Список включаемых селекторов CSS через запятую"

msgid "Add icon to mailto links"
msgstr "Добавить значок к ссылкам на email"

msgid "Alternative text for mailto icon"
msgstr "Альтернативный текст для значка mailto"

msgid "Use Font Awesome icons instead of images."
msgstr "Использовать значки Font Awesome вместо изображений. "

msgid "Font Awesome icon classes"
msgstr "Классы значков Font Awesome"

msgid "External link classes"
msgstr "Классы внешних ссылок"

msgid "Mailto link classes"
msgstr "Классы ссылок mailto"

msgid "Add icon in front of any processed link."
msgstr "Добавлять значки перед обработанными ссылками. "

msgid "Whitelisted domains"
msgstr "Разрешенные домены"

msgid "Domain"
msgstr "Домен"

msgid "Disable on admin routes."
msgstr "Выключить для административных маршрутов."

msgid "Whether the extlink module should be disabled on admin routes."
msgstr "Следует ли выключить модуль extlink для административных маршрутов."

msgid "Load exclusions and inclusions externally."
msgstr "Внешняя загрузка исключений и включений. "

msgid "Whether the extlink JS settings should be added to the page via an external settings file. In the case of a large number of patterns, this will reduce the amount of markup added to each page."
msgstr "Указывает, следует ли добавлять параметры JS внешних ссылок на страницу с помощью внешнего файла параметров. Такой подход позволяет уменьшить размер страниц с большим числом шаблонов. "

msgid "Place an icon next to external links."
msgstr "Поместить значок рядом с внешними ссылками."

msgid "Places an <span class=\"ext\"> </span>&nbsp; icon next to external links."
msgstr "Помещает <span class=\"ext\"> </span>&nbsp; значок рядом с внешними ссылками."

msgid "Place an icon next to mailto links."
msgstr "Поместить значок рядом с ссылками mailto."

msgid "Places an <span class=\"mailto\"> </span>&nbsp; icon next to mailto links."
msgstr "Помещает <span class=\"mailto\"> </span>&nbsp; значок рядом с ссылками mailto."

msgid "Place an icon next to image links."
msgstr "Поместить значок рядом с ссылками на изображения."

msgid "If checked, images wrapped in an anchor tag will be treated as external links."
msgstr "Если включен этот переключатель, изображения в теге anchor, будут считаться внешними ссылками."

msgid "Add Font Awesome classes to the link as well as an i tag rather than images."
msgstr "Позволяет вместо изображений добавить в ссылку классы Font Awesome, а также тег i. "

msgid "Font Awesome External Links Classes"
msgstr "Классы внешних ссылок Font Awesome"

msgid "Font Awesome mailto Links Classes"
msgstr "Классы ссылок mailto Font Awesome"

msgid "Before"
msgstr "До"

msgid "Append"
msgstr "Добавить"

msgid "After"
msgstr "После"

msgid "Exclude links with the same primary domain."
msgstr "Исключить ссылки с одинаковым первичным доменом."

msgid "For example, a link from 'www.example.com' to the subdomain of 'my.example.com' would be excluded."
msgstr "Например, ссылка из 'www.example.com' в субдомен 'my.example.com' будет исключена."

msgid "Open external links in a new window or tab."
msgstr "Открывать внешние ссылки в новом окне или вкладке. "

msgid "A link will open in a new window or tab (depending on which web browser is used and how it is configured)."
msgstr "Ссылка открывается в новом окне или вкладке (в зависимости от типа и конфигурации веб-сервера). "

msgid "Do not alter links with a default target value"
msgstr "Не изменять ссылки с целевым значением по умолчанию"

msgid "A link that specifies target='_self' will not be changed to target='_blank'."
msgstr "Ссылка, в которой указано target='_self', не меняется на target= '_blank'."

msgid "Tag external links as \"noreferrer\"."
msgstr "Пометить внешние ссылки как \"noreferrer\"."

msgid "Tag external links as \"no follow\"."
msgstr "Пометить внешние ссылки как \"no follow\"."

msgid "Do not override rel=\"follow\", if set"
msgstr "Не переопределять rel=\"follow\", если задано"

msgid "Display a pop-up warning when any external link is clicked."
msgstr "Показывать всплывающее предупреждение при щелчке на любую внешнюю ссылку."

msgid "Text to display in the pop-up warning box."
msgstr "Текст, показываемый в окне всплывающего предупреждения."

msgid "Text to display in the pop-up external link warning box."
msgstr "Текст для отображения во всплывающем окне предупреждения о внешней ссылке."

msgid "Whitelisted domains."
msgstr "Разрешенные домены. "

msgid "Enter a line-separated list of whitelisted domains (ie \"example.com\")."
msgstr "Введите разрешенные домены по одному в каждой строке (например, \"example.com\")."

msgid "Matches example.com."
msgstr "Совпадения типа example.com."

msgid "Multiple patterns can be strung together by using a pipe. Matches example.com OR example.net."
msgstr "Множественные шаблоны могут быть объединены. Например example.com OR example.net."

msgid "Matches links that go through the <a target=\"Links-module\" href=\"http://drupal.org/project/links\">Links module</a> redirect."
msgstr "Определяет ссылки, перенаправляемые через <a target=\"Links-module\" href=\"http://drupal.org/project/links\">модуль Ссылки</a>. "

msgid "Matches any character."
msgstr "Совпадение с любым символом."

msgid "The previous character or set is optional."
msgstr "Предыдущий символ или набор можно не указывать."

msgid "Matches any digit (0-9)."
msgstr "Совпадение с любой цифрой (0-9)"

msgid "Brackets may be used to match a custom set of characters. This matches any alphabetic letter."
msgstr "Скобки могут быть использованы для совпадения с пользовательским набором символов. Используйте любые буквы."

msgid "Pattern matching."
msgstr "Сопоставление с шаблоном."

msgid "External links uses patterns (regular expressions) to match the \"href\" property of links."
msgstr "External links использует шаблоны (регулярные выражения) для анализа свойства ссылок \"href\"."

msgid "Here are some common patterns."
msgstr "Ниже приведено несколько общих шаблонов."

msgid "Common special characters:"
msgstr "Общие специальные симолы:"

msgid "All special characters (<code>@characters</code>) must also be escaped with backslashes. Patterns are not case-sensitive. Any <a target=\"pattern supported by JavaScript\" href=\"http://www.javascriptkit.com/javatutors/redev2.shtml\">pattern supported by JavaScript</a> may be used."
msgstr "Перед всеми специальными символами (<code>@characters</code>) тоже должны ставиться символы обратной косой черты (обратная косая). В шаблонах не учитывается регистр символов. Можно использовать любой <a target=\"pattern supported by JavaScript\" href=\"http://www.javascriptkit.com/javatutors/redev2.shtml\">шаблон, поддерживаемый JavaScript </a>."

msgid "Exclude links matching the pattern."
msgstr "Исключить ссылки, соответствующие шаблону."

msgid "Enter a regular expression for links that you wish to exclude from being considered external."
msgstr "Введите регулярное выражение для ссылок, которые не должны считаться внешними."

msgid "Include links matching the pattern."
msgstr "Включить ссылки, соответствующие шаблону."

msgid "Enter a regular expression for internal links that you wish to be considered external."
msgstr "Введите регулярное выражение для внутренних ссылок, которые должны расцениваться как внешние."

msgid "CSS Matching."
msgstr "Сопоставление CSS."

msgid "Use CSS selectors to exclude entirely or only look inside explicitly specified classes and IDs for external links.  These will be passed straight to jQuery for matching."
msgstr "Используйте селекторы CSS, чтобы исключить полностью или только просмотр явно указанных классов и идентификаторов для внешних ссылок. Они передаются непосредственно в jQuery для сопоставления."

msgid "Exclude links inside these CSS selectors."
msgstr "Исключить ссылки внутри этих селекторов CSS."

msgid "Enter a comma-separated list of CSS selectors (ie \"#block-block-2 .content, ul.menu\")."
msgstr "Введите список селекторов CSS через запятую (например, \" #block-block-2 .content, ul.menu \")."

msgid "Only look for links inside these CSS selectors."
msgstr "Искать ссылки только в этих селекторах CSS."

