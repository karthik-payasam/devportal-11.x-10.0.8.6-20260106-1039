msgid "No destination directory provided."
msgstr "Aucun répertoire de destination fourni."

msgid "About"
msgstr "À propos"

msgid "Helper module to quickly import a list of terms with parent structure."
msgstr "Module d'aide permettant d'importer rapidement une liste de termes avec une structure parent."

msgid "Term CSV Export/Import"
msgstr "Exportation/Importation de terme au format CSV"

msgid "Import and Export Taxonomy terms as csv."
msgstr "Importez et exportez les termes de taxonomie au format CSV."

msgid "Taxonomy"
msgstr "Taxonomie"

msgid "Import and Export Taxonomy Terms as CSV"
msgstr "Importer et exporter les termes de taxonomie au format CSV"

msgid "Term CSV Import"
msgstr "Importation de terme au format CSV"

msgid "Term CSV Export"
msgstr "Exportation de terme au format CSV"

msgid "Administer CSV Term Import"
msgstr "Administrer les importations de terme au format CSV"

msgid "Allows a user to import taxonomy terms."
msgstr "Permet à un utilisateur d'importer des termes de taxonomie."

msgid "CSV Term Import"
msgstr "Administrer les importations de terme au format CSV"

msgid "CSV Term Export"
msgstr "Administrer les importations de terme au format CSV"

msgid "The header keys were not included in the import."
msgstr "Les clés d'en-tête n'étaient pas incluses dans l'importation."

msgid "Line with \"@part\" could not be parsed. Incorrect number of values: @count."
msgstr "La ligne contenant \"@part\" n'a pas pu être analysée. Nombre incorrect de valeurs : @count."

msgid "The term @name has multiple matches. Ignoring."
msgstr "Plusieurs correspondances ont été trouvées pour le terme @name. Ignorer."

msgid "The term with id @id already exists and preserve existing terms is checked. No modification has been made."
msgstr "Le terme avec l'ID @id existe déjà et l'option permettant de conserver les termes existants est sélectionnée. Aucune modification n'a été effectuée."

msgid "The Term ID already exists."
msgstr "L'ID de terme existe déjà."

msgid "More than 1 terms are named @name. Cannot distinguish by name. Try using id export/import."
msgstr "Plusieurs termes portent le nom @name. Impossible de les distinguer par leur nom. Essayez en utilisant la fonction d'exportation/importation d'ID."

msgid "The field data <em>@data</em> is not formatted correctly. Please use the export function."
msgstr "Les données de zone <em>@data</em> ne sont pas correctement formatées. Utilisez la fonction d'exportation."

msgid "The field data <em>@data</em> could not be imported. Please add the appropriate fields to the vocabulary you are importing into."
msgstr "Les données de zone <em>@data</em> n'ont pas pu être importées. Ajoutez les zones appropriées au vocabulaire dans lequel vous effectuez l'importation."

msgid "Imported @count terms."
msgstr "@count termes importés."

msgid "Include Term Ids in export."
msgstr "Inclure les ID de terme dans l'exportation."

msgid "Include Term Headers in export."
msgstr "Inclure les en-têtes de terme dans l'exportation."

msgid "Include extra fields in export."
msgstr "Inclure les zones supplémentaires dans l'exportation."

msgid "Note that fields are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"
msgstr "Notez que les zones sont converties en chaîne à l'aide de <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"

msgid "Export"
msgstr "Exporter"

msgid "CSV Data"
msgstr "Données CSV"

msgid "The formatted term data"
msgstr "Données de terme formatées"

msgid "Input"
msgstr "Entrée"

msgid "<p><strong>See CSV Export for an example.</strong></p><p>Enter in the form of: <pre>\"name,status,description,format,weight,parent_name,[any_additional_fields];</pre><pre>name,status,description,format,weight,parent_name[;parent_name1;parent_name2;...],[any_additional_fields]\"</pre> or <pre>\"tid,uuid,name,status,revision_id,description,format,weight,parent_name[;parent_name1;parent_name2;...],parent_tid[;parent_tid1;parent_tid2;...],[any_additional_fields];</pre><pre>tid,uuid,name,status,revision_id,description,format,weight,parent_name,parent_tid,[any_additional_fields]\"</pre> Note that <em>[any_additional_fields]</em> are optional and are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>If you need to export from Drupal 7, you can import and modify the view d7exportview.txt found at the root directory of this project</p>"
msgstr "<p><strong>Pour obtenir un exemple, reportez-vous à Exportation CSV.</strong></p><p>Entrez vos données au format suivant : <pre>\"name,status,description,format,weight,parent_name,[any_additional_fields];</pre><pre>name,status,description,format,weight,parent_name[;parent_name1;parent_name2;...],[any_additional_fields]\"</pre> ou <pre>\"tid,uuid,name,status,revision_id,description,format,weight,parent_name[;parent_name1;parent_name2;...],parent_tid[;parent_tid1;parent_tid2;...],[any_additional_fields];</pre><pre>tid,uuid,name,status,revision_id,description,format,weight,parent_name,parent_tid,[any_additional_fields]\"</pre> Notez que <em>[any_additional_fields]</em> renvoie à des zones qui sont facultatives et qui sont converties en chaîne à l'aide de <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>Si vous devez effectuer l'exportation à partir de Drupal 7, vous pouvez importer et modifier le fichier d7exportview.txt disponible dans le répertoire racine de ce projet</p>"

msgid "Preserve Vocabularies on existing terms."
msgstr "Conservez les vocabulaires sur les termes existants."

msgid "Preserve existing terms. This will prevent a term id collision if importing from another install."
msgstr "Conservez les termes existants. Cette action empêche la collision d'ID de terme en cas d'importation à partir d'une autre installation."

msgid "Next"
msgstr "Suivant"

msgid "Name"
msgstr "Nom"

msgid "Create New Vocabulary"
msgstr "Créer un nouveau vocabulaire"

msgid "Create Vocabulary"
msgstr "Créer un dictionnaire"

msgid "Are you sure you want to copy @count_terms terms into the vocabulary @vocabulary@preserve_vocabularies?"
msgstr "Voulez-vous vraiment copier @count_terms termes dans le vocabulaire @vocabulary@preserve_vocabularies ?"

msgid "Import"
msgstr "Importer"

