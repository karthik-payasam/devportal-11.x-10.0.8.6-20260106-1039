msgstr "Typ"

msgid "Unrestricted"
msgstr "Neomezené"

msgid "G: suitable for display on all websites with any audience type."
msgstr "G: vhodné k zobrazení na všech webech s libovolnou cílovou skupinou."

msgid "PG: may contain rude gestures, provocatively dressed individuals, the lesser swear words, or mild violence."
msgstr "PG: může obsahovat neslušná gesta, provokativně oděné osoby, mírnější nadávky a mírné formy násilí."

msgid "R: may contain such things as harsh profanity, intense violence, nudity, or hard drug use."
msgstr "R: může obsahovat drsné výrazivo, intenzivní násilí, nahotu a vyobrazení závažné narkomanie."

msgid "X: may contain hardcore sexual imagery or extremely disturbing violence."
msgstr "X: může obsahovat pornografický obsah a velmi drsné násilné scény."

msgid "Maximum rating: @maximum_rating"
msgstr "Maximální hodnocení: @maximum_rating"

msgid "Universal avatar uploaded to Gravatar.com"
msgstr "Univerzální avatar nahraný na server Gravatar.com"

