msgstr "Jak dlouho mají být dynamické avatary uchovávány v mezipaměti před obnovením."

msgid "seconds"
msgstr "sekund"

msgid "Static lifetime"
msgstr "Statická doba životnosti"

msgid "How long static avatars are cached. Only applies to avatars which are not the users preference."
msgstr "Jak dlouho jsou statické avatary uloženy v mezipaměti. Platí pouze pro avatary, které nejsou uživatelskou předvolbou."

msgid "Never delete"
msgstr "Nikdy nemazat"

msgid "Delete after"
msgstr "Odstranit po"

msgid "Settings saved."
msgstr "Nastavení byla uložena."

msgid "Broken/Missing"
msgstr "Rozbitý/chybějící"

