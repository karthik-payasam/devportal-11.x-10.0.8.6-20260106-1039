msgstr "이 지불 방법을 식별하는 데 사용할 제목을 제공하십시오."

msgid "Payment type"
msgstr "지불 유형"

msgid "Select what type of payment method to use."
msgstr "사용할 지불 방법의 유형을 선택하십시오."

msgid "Next"
msgstr "다음"

msgid "Successfully added your payment method"
msgstr "지불 방법 추가 완료"

msgid "Failed to add your payment method."
msgstr "지불 방법을 추가하지 못했습니다."

msgid "Received @code code while creating payment method."
msgstr "지불 방법을 작성하는 중에 @code 코드를 수신했습니다."

