msgid "About"
msgstr "Hakkında"

msgid ""
"\n"
"<p>This module generates and exposes a\n"
"  <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a> schema for\n"
"  <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a> entities,\n"
"  and allows you to expose your own custom schema in a consistent way and with\n"
"  minimal effort.</p>"
msgstr ""
"\n"
"<p>Bu modül \n"
"<a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a> varlıkları için bir <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a> şeması\n"
" oluşturur ve\n"
"  kendi özel şemanızı tutarlı bir biçimde\n"
" ve minimum zahmetle göstermenizi sağlar.</p>"

