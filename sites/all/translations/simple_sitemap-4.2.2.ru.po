msgstr "Генератор пользовательских URL"

msgid "Generates URLs set in admin/config/search/simplesitemap/custom."
msgstr "Создает набор URL в admin/config/search/simplesitemap/custom."

msgid "Menu link URL generator"
msgstr "Генератор URL ссылки меню"

msgid "Generates menu link URLs by overriding the 'entity' URL generator."
msgstr "Создает URL ссылок меню путем переопределения генератора URL 'сущностей'. "

msgid "Entity URL generator"
msgstr "Генератор URL сущностей"

msgid "Generates URLs for entity bundles and bundle overrides."
msgstr "Создает URL комплектов сущностей и переопределений комплектов. "

msgid "Generating XML sitemaps"
msgstr "Создание карт сайта XML"

