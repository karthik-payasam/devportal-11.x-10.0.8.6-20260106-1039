msgid "Which thread to run in when invoking with ?thread=N. Note: This setting only has an effect when cron is run through cron.php with an argument ?thread=N or through Drush with --options=thread=N."
msgstr "Které vlákno má být spuštěno při vyvolání s použitím ?thread=N. Poznámka: Toto nastavení má vliv pouze tehdy, když se program cron spouští prostřednictvím souboru cron.php s argumentem ?thread=N nebo prostřednictvím konzoly Drush s volbou --options=thread=N. "

msgid "%title must be greater than 0"
msgstr "%title musí být větší než 0"

msgid "Launched in thread @current_thread"
msgstr "Spuštěno ve vláknu @current_thread"

msgid "Invalid thread available for starting launch thread"
msgstr "Neplatné vlákno dostupné ke spuštění vlákna spuštění"

msgid "Thread @thread is already running"
msgstr "Vlákno @thread již je spuštěno"

msgid "No free threads available for launching jobs"
msgstr "Nejsou k dispozici žádná volná vlákna ke spuštění úloh"

msgid "Serial"
msgstr "Sériové číslo"

msgid "Launches scheduled jobs in the same thread and runs them consecutively."
msgstr "Spouští naplánované úlohy ve stejném vláknu a postupně. "

msgid "Stores the last log entry (and only the last) in the cache."
msgstr "Uchovává (výlučně) poslední položku protokolu v mezipaměti. "

msgid "Lock #@original_lid was already closed and logged. Creating a new log entry #@lid"
msgstr "Zámek #@original_lid již byl uzamknutý a zaprotokolovaný. Vytváří se nová položka protokolu #@lid"

msgid "@count_entries log entries removed for @jobs_count jobs"
msgstr "Bylo odebráno @count_entries položek protokolu pro @jobs_count úloh"

msgid "Invalid cleanup method: @method"
msgstr "Neplatná metoda vyčištění: @method"

msgid "Stores logs in the database."
msgstr "Uchovává protokoly v databázi"

msgid "Next scheduled run at @datetime"
msgstr "Následující naplánované spuštění v @datetime"

msgid "Comma separated list of crontab rules."
msgstr "Seznam pravidel crontab s položkami oddělenými čárkou. "

msgid "Rule is invalid"
msgstr "Pravidlo je neplatné"

msgid "Use crontab rules for scheduling jobs."
msgstr "Používat pravidla crontab pro naplánované úlohy. "

msgid "Every @interval"
msgstr "Každých @interval"

msgid "Provides a set of predefined intervals for scheduling."
msgstr "Poskytuje sadu předdefinovaných pravidel pro plánování. "

