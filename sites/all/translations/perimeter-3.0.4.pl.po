msgid "Allowlist skipping ban: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Lista dozwolonych dla pomijania blokady: %ip dla niepowodzenia typu %type w %form <br />Źródło: %source <br />Agent użytkownika: %browser"

msgid "Banned: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Zabronione: %ip dla niesprawnego %type w %form <br />Źródło: %source <br /> Agent użytkownika: %browser"

msgid "Drupal Perimeter Defence"
msgstr "Obrona graniczna systemu Drupal"

msgid "Immediately ban hackers when they try to scan the site."
msgstr "Natychmiastowe blokowanie hakerów, którzy próbują skanować serwis."

msgid "Perimeter defence settings"
msgstr "Ustawienia obrony granicznej"

msgid "Configure the settings for Drupal Perimeter Defence."
msgstr "Skonfiguruj ustawienia obrony granicznej systemu Drupal"

msgid "Bypass Perimeter Defence ban rules"
msgstr "Omiń reguły zakazu modułu Perimeter Defence"

msgid "Allow users to bypass the rules defined by Perimeter Defence module."
msgstr "Zezwalaj użytkownikom na ominięcie reguł zdefiniowanych przez moduł Perimeter Defence."

msgid "Perimeter settings"
msgstr "Ustawienia graniczne"

msgid "Perimeter Settings"
msgstr "Ustawienia graniczne"

msgid "A list of regex patterns"
msgstr "Lista wzorców wyrażeń regularnych"

msgid "A regex pattern"
msgstr "Wzorzec wyrażenia regularnego"

msgid "Banned: %ip for requesting %pattern <br />Source: %source <br /> User Agent: %browser"
msgstr "Zakazany: %ip dla żądania %pattern <br />Źródło: %source <br /> Agent użytkownika: %browser"

msgid "Perimeter will ban any user that generates \"404 - File not found\" for requesting any of the following url pattern"
msgstr "Ochrona graniczna zablokuje każdego użytkownika, który generuje błąd \"404 - nie znaleziono pliku\" poprzez żądanie dowolnego z następujących wzorców adresów URL"

msgid "Ban URL patterns"
msgstr "Zabronione wzorce adresów URL"

msgid "A list of regex patterns, each pattern on a separate line"
msgstr "Lista wzorców wyrażeń regularnych, każdy wzorzec w osobnym wierszu"

