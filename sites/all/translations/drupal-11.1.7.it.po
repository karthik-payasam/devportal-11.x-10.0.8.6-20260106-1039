msgid "Article"
msgstr "Articolo"

msgid "Use <em>articles</em> for time-sensitive content like news, press releases or blog posts."
msgstr "Usa gli <em>articoli</em> per contenuti come notizie, comunicati stampa o post di un blog."

msgid "Basic page"
msgstr "Pagina base"

msgid "Use <em>basic pages</em> for your static content, such as an 'About us' page."
msgstr "Utilizza <em>pagine di base</em> per i tuoi contenuti statici come ad esempio per una pagina 'Chi siamo'."

