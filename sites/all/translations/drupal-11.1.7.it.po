msgstr "Ripristina voce del menu"

msgid "Delete menu"
msgstr "Elimina menù"

msgid "Override parent selector"
msgstr "Sovrascrivi selettore parent"

msgid "Per-content type menu settings"
msgstr "Configurazione menu per tipo di contenuto"

msgid "Menu machine name"
msgstr "Nome macchina del menu"

msgid "Edit menu %label"
msgstr "Modifica il menu %label"

msgid "A unique name to construct the URL for the menu. It must only contain lowercase letters, numbers and hyphens."
msgstr "Un nome univoco da usare nella costruzione dell'URL per il menu. Deve contenere solo lettere minuscole, numeri e trattini."

msgid "Administrative summary"
msgstr "Sommario amministrativo"

msgid "Menu language"
msgstr "Lingua del menù"

msgid "Menu %label has been updated."
msgstr "Il menu %label è stato aggiornato."

msgid "Menu %label has been added."
msgstr "Il menù %label è stato aggiunto."

msgid "Menu link"
msgstr "Voce del menu"

msgid "There are no menu links yet. <a href=\":url\">Add link</a>."
msgstr "Non ci sono ancora link nel menu. <a href=\":url\">Aggiungi link</a>."

msgid "<q>Log in</q> for anonymous users"
msgstr "<q>Autenticazione</q> per utenti anonimi"

msgid "logged in users only"
msgstr "solo utenti autenticati"

msgid "Enable @title menu link"
msgstr "Attiva la voce del menu @title"

msgid "%capital_name contains 1 menu link with pending revisions. Manipulation of a menu tree having links with pending revisions is not supported, but you can re-enable manipulation by getting each menu link to a published state."
msgid_plural "%capital_name contains @count menu links with pending revisions. Manipulation of a menu tree having links with pending revisions is not supported, but you can re-enable manipulation by getting each menu link to a published state."
msgstr[0] "%capital_name contiene un link di menu con revisioni in sospeso. L'elaborazione di una struttura di menu con collegamenti con revisioni in sospeso non è supportata, ma è possibile riattivare l'elaborazione ottenendo il collegamento di ogni menu a uno stato pubblicato."
msgstr[1] "%capital_name contiene @count collegamenti ai menu con revisioni in sospeso. L'elaborazione di una struttura di menu con collegamenti con revisioni in sospeso non è supportata, ma è possibile riattivare l'elaborazione ottenendo il collegamento di ogni menu a uno stato pubblicato."

msgid "Deleted custom menu %title and all its menu links."
msgstr "Il menu personalizzato %title e tutti i suoi collegamenti sono stati eliminati."

msgid "<strong>Warning:</strong> There is currently 1 menu link in %title. It will be deleted (system-defined links will be reset)."
msgid_plural "<strong>Warning:</strong> There are currently @count menu links in %title. They will be deleted (system-defined links will be reset)."
msgstr[0] ""
msgstr[1] ""

msgid "Are you sure you want to reset the link %item to its default values?"
msgstr "Sei sicuro di voler ripristinare la voce %item ai valori predefiniti?"

msgid "Any customizations will be lost. This action cannot be undone."
msgstr "Qualsiasi personalizzazione andrà perduta. L'operazione non è reversibile."

