msgid ""
"\n"
"        <h2>Maintenance200 module.</h2>\n"
"        <h3>Instructions</h3>\n"
"        <p>Install the module as normal and enable in <strong>/admin/modules</strong>.</p>\n"
"        <p>On the module configuration form you will find a switch to turn on or off the rewriting of the HTTP code returned when the site is in maintenance mode, as well as a field where you\n"
"        can input the numeric HTTP which the site should return.</p>\n"
"      "
msgstr ""
"\n"
"        <h2>Modul 'Maintenance 200'.</h2>\n"
"        <h3>Anweisungen</h3> <p>Installieren Sie das Modul wie gewohnt und aktivieren Sie es in <strong>/admin/modules</strong>.</p>\n"
"        <p>Das Formular für die Konfiguration des Moduls enthält einen Schalter, mit dem Sie das Umschreiben des HTTP-Codes, der zurückgegeben wird, wenn sich die Website im Wartungsmodus befindet, wahlweise ein- oder ausschalten können, sowie ein Feld, in das Sie den numerischen HTTP-Wert eingeben können, den die Website zurückgeben soll.</p>\n"
"      "

msgid "Maintenance 200"
msgstr "Maintenance 200"

msgid "Allows the maintenance page to return a configurable HTTP status code rather than the standard 503 code."
msgstr "Ermöglicht der Wartungsseite, einen konfigurierbaren HTTP-Statuscode anstelle des Standardcodes 503 zurückzugeben."

msgid "Configure maintenance200"
msgstr "Maintenance 200 konfigurieren"

msgid "Maintenance200 Settings"
msgstr "Einstellungen für Maintenance 200"

msgid "Maintenance 200 settings"
msgstr "Einstellungen für Maintenance 200"

msgid "Enable custom status code during maintenance mode"
msgstr "Im Wartungsmodus benutzerdefinierten Statuscode aktivieren"

msgid "Status code to return during maintenance mode"
msgstr "Statuscode, der im Wartungsmodus zurückgegeben werden soll"

msgid "Change the status code during maintenance mode"
msgstr "Statuscode, der im Wartungsmodus zurückgegeben werden soll, ändern"

msgid "Status code to use"
msgstr "Zu verwendender Statuscode"

msgid "A valid HTTP status code is required. See the Wikipedia <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">HTTP status codes</a> page for a complete list."
msgstr "Ein gültiger HTTP-Statuscode ist erforderlich. Eine vollständige Liste enthält die Wikipedia-Seite <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">HTTP-Statuscode</a>."

msgid "A valid HTTP status code is required."
msgstr "Ein gültiger HTTP-Statuscode ist erforderlich."

msgid "You must provide an HTTP status code."
msgstr "Sie müssen einen HTTP-Statuscode angeben."

