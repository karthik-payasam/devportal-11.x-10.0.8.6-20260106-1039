msgid "Views Autocomplete Filters"
msgstr "Фильтры автоматического дополнения представлений"

msgid "Use Autocomplete for string field filters."
msgstr "Позволяет использовать автоматическое дополнение для фильтров строковых полей. "

msgid "Views"
msgstr "Представления"

msgid "Autocomplete for Combine fields filter"
msgstr "Автоматическое дополнение для фильтра комбинированных полей"

msgid "Exposed"
msgstr "Раскрытый"

msgid "Use Autocomplete"
msgstr "Использовать автодополнение"

msgid "Minimum number of characters to start filter"
msgstr "Минимальное число символов для фильтрации"

msgid "Maximum number of items in Autocomplete"
msgstr "Максимальное количество элементов в автодополнении"

msgid "Field with autocomplete results"
msgstr "Поле с результатами автоматического дополнения"

msgid "Unformatted suggestion"
msgstr "Неотформатированное предложение"

msgid "Unformatted dropdown"
msgstr "Неотформатированный выпадающий список"

msgid "Suggestions depend on other filter fields"
msgstr "Предлагаемые варианты зависят от других полей фильтров"

msgid "Autocomplete for Search API fulltext search filter"
msgstr "Автоматическое дополнение для фильтра полнотекстового поиска Search API"

msgid "Autocomplete for Search API text field filter"
msgstr "Автоматическое дополнение для фильтра текстового поля Search API"

msgid "Autocomplete for basic textfield filter"
msgstr "Автоматическое дополнение для фильтра простого текстового поля"

msgid "Field for autocomplete filter %label is not set in view %view, display %display"
msgstr "В отображении %display предстваления %view не указано поле для автодополнения фильтра %label"

msgid "Field for autocomplete filter %label not exists in view %view, display %display"
msgstr "В отображении %display предстваления %view не существует поля для автодополнения фильтра %label"

msgid "Use Autocomplete for this filter."
msgstr "Использовать автодополнение для этого фильтра."

msgid "Enter 0 for no limit."
msgstr "Введите 0 для снятия ограничения."

msgid "Autocomplete suggestions will be filtered by other filter fields"
msgstr "Варианты автоматического дополнения будут отфильтрованы по другим полям фильтров"

msgid "Use unformatted data from database for dropdown list instead of field formatter result. Value will be printed as plain text."
msgstr "Использовать в выпадающем списке неотформатированные данные из базы данных вместо результата функции форматирования. Значение отображается как обычный текст. "

msgid "The same as above, but for suggestion (text appearing inside textfield when item is selected)."
msgstr "Аналогичен предыдущему параметру, но действует для предложений (текст, который отображается в текстовом поле при выборе элемента). "

msgid "Add some fields to view"
msgstr "Добавить поля в представление"

