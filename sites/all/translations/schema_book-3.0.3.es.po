msgstr "workExample"

msgid "review"
msgstr "revisar"

msgid "aggregateRating"
msgstr "aggregateRating"

msgid "image"
msgstr "imagen"

msgid "Schema.org: Book"
msgstr "Schema.org: Book"

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "La valoración general, basada en una recopilación de revisiones o valoraciones del elemento."

msgid "REQUIRED BY GOOGLE. Author of the book."
msgstr "NECESARIO PARA GOOGLE. Autor del libro."

msgid "A description of the item."
msgstr "Una descripción del elemento."

msgid "RECOMMENDED BY GOOGLE. Globally unique @id, usually a url, used to to link other properties to this object."
msgstr "RECOMENDADO POR GOOGLE. @id exclusivo global, normalmente un URL, utilizado para enlazar otras propiedades a este objeto."

msgid "The primary image for this item."
msgstr "La imagen primaria de este elemento."

msgid "REQUIRED BY GOOGLE. The title of the book."
msgstr "NECESARIO PARA GOOGLE. El título del libro."

msgid "Reviews of this item."
msgstr "Revisiones de este elemento."

msgid "RECOMMENDED BY GOOGLE. URL of a reference Web page that unambiguously indicates the item's identity. E.g. the URL of the item's Wikipedia page, Wikidata entry, or official website."
msgstr "RECOMENDADO POR GOOGLE. URL de una página web de referencia que indica inequívocamente la identidad de tema. Por ej., el URL de la página de Wikipedia del elemento, la entrada de Wikidata o el sitio web oficial."

msgid "REQUIRED. The type of this Book"
msgstr "OBLIGATORIO. El tipo de este libro"

msgid "REQUIRED BY GOOGLE. URL to the page on your site about the book. The page may list all available editions."
msgstr "NECESARIO PARA GOOGLE. URL a la página del sitio acerca del libro. En la página puede haber una lista de todas las ediciones disponibles."

msgid "REQUIRED BY GOOGLE. An example of the book."
msgstr "NECESARIO PARA GOOGLE. Un ejemplo del libro."

