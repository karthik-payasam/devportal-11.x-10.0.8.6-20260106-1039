msgid "Schema.org Book"
msgstr "Schema.org Book"

msgid "Adds Schema.org/Book to the JSON LD array."
msgstr "Añade Schema.org/Book a la matriz JSON LD."

msgid "SEO"
msgstr "SEO (optimizador del motor de búsqueda)"

msgid "author"
msgstr "autor"

msgid "@id"
msgstr "@id"

msgid "name"
msgstr "name"

msgid "description"
msgstr "descripción"

msgid "sameAs"
msgstr "sameAs"

msgid "@type"
msgstr "@type"

msgid "url"
msgstr "url"

