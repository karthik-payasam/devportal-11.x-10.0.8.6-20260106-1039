msgid "Message sent to %mail."
msgstr "Wiadomość została wysłana na adres %mail."

msgid "PHP maximum execution time almost exceeded. Remaining e-mail messages will be sent during the next cron run. If this warning occurs regularly you should reduce the cron throttle setting."
msgstr "Niemal przekroczono maksymalny czas wykonywania kodu PHP. Pozostałe wiadomości e-mail zostaną wysłane podczas następnego uruchomienia zadania cron. Jeśli to ostrzeżenie występuje regularnie, należy zmniejszyć ustawienie przytłumiania zadania cron."

msgid "%ok messages sent in %sec seconds, %fail failed sending."
msgstr "Liczba wiadomości: %ok wysłanych w czasie %sec s, nie powiodło się wysłanie następującej liczby wiadomości: %fail."

msgid "User ID"
msgstr "ID użytkownika"

msgid "Timestamp"
msgstr "Znacznik czasu"

msgid "Sender's name"
msgstr "Nazwa nadawcy"

msgid "Sender's e-mail"
msgstr "Adres e-mail nadawcy"

msgid "Recipient's name"
msgstr "Nazwa odbiorcy"

msgid "Recipient's e-mail"
msgstr "Adres e-mail odbiorcy"

