msgstr "1 Jahr"

msgid "Toggle The \"aggregation bypass cookie\" For This Browser"
msgstr "Umgehungs-Cookie zur Aggregations für diesen Browser ein-/ausschalten"

msgid "Cron Maintenance Tasks"
msgstr "Cron-Wartungstasks"

msgid "The following operation is ran on cron but you can run it manually here."
msgstr "Die folgende Operation wird unter cron ausgeführt, aber Sie können sie hier manuell ausführen."

msgid "Clear Stale Files"
msgstr "Veraltete Dateien bereinigen"

msgid "Scan all files in the css/js optimized directories and remove outdated ones."
msgstr "Alle Dateien in den für CSS/JS optimierten Verzeichnissen scannen und veraltete Dateien entfernen."

msgid "Remove All Stale Files"
msgstr "Alle veralteten Dateien entfernen"

msgid "Drastic Measures"
msgstr "Drastische Maßnahmen"

msgid "The options below should normally never need to be done."
msgstr "Die unten stehenden Optionen sollten in der Regel nie genutzt werden."

msgid "Clear All Caches"
msgstr "Alle Caches löschen"

msgid "Remove all entries from the advagg cache and file information stores. Useful if you suspect a cache is not getting cleared."
msgstr "Alle Einträge aus dem Advagg-Cache und den Dateiinformationsspeichern entfernen. Dies ist nützlich, wenn Sie vermuten, dass ein Cache nicht gelöscht wird."

msgid "Clear All Caches & File Information"
msgstr "Alle Caches und Dateiinformationen löschen"

msgid "Force new files"
msgstr "Neue Dateien erzwingen"

msgid "Force the creation of all new optimized files by incrementing a global counter. Current value of counter: %value. This is useful if a CDN has cached a file incorrectly as it will force new ones to be used even if nothing else has changed."
msgstr "Erzwingen Sie die Erstellung aller neuen optimierten Dateien, indem Sie einen globalen Zähler inkrementieren. Aktueller Wert des Zählers: %value. Dies kann nützlich sein, wenn ein CDN eine Datei falsch in den Cache gestellt hat, da es die Verwendung von neuen Dateien erzwingt, auch wenn sich nichts sonst geändert hat."

msgid "Increment Global Counter"
msgstr "Globalen Zähler erhöhen"

msgid "Global counter is now set to %new_value"
msgstr "Globaler Zähler ist jetzt auf %new_value gesetzt"

msgid "AdvAgg Bypass Cookie Removed."
msgstr "AdvAgg-Umgehungs-Cookie wurde entfernt."

msgid "AdvAgg Bypass Cookie Set for %time."
msgstr "AdvAgg-Umgehungs-Cookie für %time festgelegt."

