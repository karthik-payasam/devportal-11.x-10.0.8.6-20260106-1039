msgid "Metatag: Pinterest"
msgstr "Metatag: Pinterest"

msgid "Provides support for Pinterest's custom meta tags."
msgstr "Pinterest'in özel meta etiketleri için destek sağlar."

msgid "SEO"
msgstr "SEO"

msgid "Pinterest: Description"
msgstr "Pinterest: Açıklama"

msgid "Pinterest: ID"
msgstr "Pinterest: Tanıtıcı"

msgid "Pinterest: Media"
msgstr "Pinterest: Ortam"

msgid "Pinterest: No hover"
msgstr "Pinterest: İmleç yok"

msgid "Pinterest: No pin"
msgstr "Pinterest: Sabitleme yok"

msgid "Pinterest: No search"
msgstr "Pinterest: Arama yok"

msgid "Pinterest: URL"
msgstr "Pinterest: URL"

msgid "Pinterest"
msgstr "Pinterest"

msgid "A set of meta tags used to control how the site's content is consumed by <a href='https://pinterest.com/'>Pinterest</a>."
msgstr "Site içeriğinin <a href='https://pinterest.com/'>Pinterest</a> tarafından nasıl kullanıldığını denetlemek için kullanılan meta etiketler kümesi."

msgid "Description"
msgstr "Açıklama"

msgid "A one to two sentence description of the content."
msgstr "İçeriğin bir iki cümlelik açıklaması."

msgid "Id"
msgstr "Tanıtıcı"

msgid "The Canonical Pinterest object to pin."
msgstr "Sabitlenecek Kurallı Pinterest nesnesi."

msgid "Media"
msgstr "Ortam"

msgid "The URL of media which should represent the content."
msgstr "İçeriği temsil etmesi gereken ortam URL adresi."

msgid "No hover"
msgstr "İmleç yok"

msgid "Do not show hovering Save or Search buttons, generated by the Pinterest browser extensions."
msgstr "Pinterest tarayıcı uzantılarının oluşturduğu Kaydet ya da Ara düğmeleri bağlantı vurgusunu gösterme."

msgid "No pin"
msgstr "Sabitleme yok"

msgid "Do not pin anything from this page. When selected, this option will take precedence over all options below."
msgstr "Bu sayfadan hiçbir öğe sabitlenmez. Seçildiğinde bu, aşağıdaki tüm seçeneklerin önüne geçer."

msgid "No search"
msgstr "Arama yok"

msgid "Do not allow Pinterest visual search to happen from this page."
msgstr "Pinterest görsel aramasının bu sayfadan olmasına izin verme."

msgid "URL"
msgstr "URL"

msgid "The URL which should represent the content."
msgstr "İçeriği temsil etmesi gereken URL adresi."

