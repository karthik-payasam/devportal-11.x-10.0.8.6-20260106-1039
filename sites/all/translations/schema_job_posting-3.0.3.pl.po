msgstr "Schema.org: JobPosting"

msgid "baseSalary"
msgstr "baseSalary"

msgid "RECOMMENDED BY GOOGLE. The base salary of the position."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Wynagrodzenie zasadnicze na danym stanowisku."

msgid "REQUIRED BY GOOGLE. Date and time when the job was posted."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Data i godzina opublikowania oferty pracy."

msgid "REQUIRED BY GOOGLE. The description of the position."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Opis stanowiska."

msgid "RECOMMENDED BY GOOGLE. The employment type of the jobPosting. Should be one of FULL_TIME, PART_TIME, CONTRACTOR, TEMPORARY, INTERN, VOLUNTEER, PER_DIEM, OTHER."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Typ zatrudnienia w ofercie pracy. Powinna to być jedna z następujących wartości: FULL_TIME, PART_TIME, CONTRACTOR, TEMPORARY, INTERN, VOLUNTEER, PER_DIEM, OTHER."

msgid "REQUIRED BY GOOGLE. The organization offering the job position"
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Organizacja oferująca stanowisko."

msgid "Globally unique id of the job posting, usually a url."
msgstr "Globalnie unikalny identyfikator ogłoszenia o pracę, zwykle adres URL."

msgid "RECOMMENDED BY GOOGLE. The internal identifier of the position."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Wewnętrzny identyfikator stanowiska."

msgid "The industry the job belongs to."
msgstr "Branża, do której należy stanowisko."

msgid "The benefits of the position."
msgstr "Korzyści płynące ze stanowiska."

msgid "location"
msgstr "lokalizacja"

msgid "REQUIRED BY GOOGLE. The location of the job."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Lokalizacja stanowiska."

msgid "The necessary qualifications of the candidate."
msgstr "Wymagane kwalifikacje kandydata."

msgid "The responsibilities in the job."
msgstr "Obowiązki w pracy."

msgid "REQUIRED BY GOOGLE. The title of the job."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Nazwa stanowiska."

msgid "REQUIRED. The type of jobPosting."
msgstr "WYMAGANE. Typ oferty pracy."

msgid "REQUIRED BY GOOGLE. The date after which this job posting is not valid anymore."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Data, po której ta oferta pracy traci ważność."

