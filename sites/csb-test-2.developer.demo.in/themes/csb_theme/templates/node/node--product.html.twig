<article id="node-{{ node.id }}" role="article" aria-label="{{ node.title[0].value }}">
   <div class="pageheading api-header-wrapper">
      <!-- added cross cutting product condition -->
       <h3 class="api-header-title">
         <span>{{- label -}}</span>
         <span class="api-header-count">{{apiCount}} APIs</span>
         <span> </span>
      </h3> 
      {% if not unenforcedOnly %}
        {% set multipleRates = false %}
        {% set requireApproval = false %}
        <div class="field plans">
          <h3 class="field__label label">{{ 'Plans'|t }}</h3>
          <div class="subHeading">
            {% if not userLoggedIn %}
              <div class="notLoggedIn">
                <p>
                  {% if selfSignUpEnabled %}
                    {% set register_path = path('user.register') %}
                    {% set login_path = path('user.login') %}
                    {% trans %}
                      In order to subscribe, you must <a href="{{ register_path }}">create an account</a> or <a
                        href="{{ login_path }}">sign in</a>.
                    {% endtrans %}
                  {% else %}
                    {% set login_path = path('user.login') %}
                    {% trans %}
                      In order to subscribe, you must <a href="{{ login_path }}">sign in</a>.
                    {% endtrans %}
                  {% endif %}</p>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
   </div>
   <div>
      <div class="api-desc-wrapper">
        <p class="api-desc-details">           
        {% if content.apic_summary['#items'][0].value is defined and content.apic_summary['#items'][0].value is not empty %}
            {{ content.apic_summary }}
          {% else %}
            {{ content.apic_description }}
          {% endif %}


        </p>
      </div>
   </div>
   <p>
      <br>
   </p>

     <ul class="nav nav-tabs" id="product-navbar" >
         {% for custom_field in custom_fields %}
      {% if content[custom_field]['#title'] is defined %}
      <li><a class="nav-link" data-toggle="tab" href="#{{ content[custom_field]["#field_name"] }}"  aria-expanded="true">{{ content[custom_field]['#title'] }}</a></li>
     {% endif %}
     {% endfor %}
      <li class="active"><a class="nav-link" data-toggle="tab" href="#apilist" aria-expanded="false">API List</a></li>
  {# Documentation tab - show only when documentation exists #}

  {% set has_embedded_docs = embedded_docs is defined and embedded_docs is not empty %}
  {% set has_docpages = docpages is defined and docpages is not empty %}
  {% set has_attachments = content.apic_attachments is defined and content.apic_attachments|render|striptags|trim is not empty %}

  {% if has_embedded_docs or has_docpages or has_attachments %}

    <li>
      <a
        class="nav-link"
        data-toggle="tab"
        href="#documentation"
        aria-expanded="false">
        Documentations
      </a>
    </li>

  {% endif %}
   </ul>
   <div class="tab-content">
     {% for custom_field in custom_fields %}
      {% if content[custom_field]['#title'] is defined %}
        <div id={{ content[custom_field]["#field_name"]}} class="tab-pane fade">
          {% if content[custom_field]["#field_name"] == "field_flow_chart" %}
            <div>
                <ul class="flow_chart_ul">
                {% for key, item in content.field_flow_chart %}
                {% if key starts with '#' %}
                 {# Skip metadata keys like '#theme', '#title', etc. #}
               {% else %}
                 <li>
                 {% if item['#type'] == 'inline_template' and item['#context'].value is defined %}
                 {{ item['#context'].value }}
                 {% elseif item['#theme'] == 'image_formatter' %}
                      {{ item }} {# Let Drupal render the image properly #}
                 {% else %}
                      {{ item }}
                  {% endif %}
                </li>
              {% endif %}
              {% endfor %}
            </ul>

         </div>
    
        {% elseif content[custom_field]["#field_name"] == "field_keyfeaturesdata" %}
            <div class="row">
             {% for paragraph_item in content.field_keyfeaturesdata %}
             {% set paragraph_entity = paragraph_item['#paragraph'] %}
             {% if paragraph_entity.field_key_feature_desc.value is not empty or paragraph_entity.field_key_feature_image.entity is defined %}
               <div class="col-md-4">
               <div class="d-flex align-items-center field_keyfeaturemargin" >
                  {% if paragraph_entity.field_key_feature_image.entity is defined %}
                  {% set image = paragraph_entity.field_key_feature_image.entity.fileuri|image_style('thumbnail') %}
                   <img src="{{ image }}" alt="Key Feature Image">
                  {% endif %}

               <div class="key-feature-desc-wrapper d-flex">
                  <p>
                    {{ paragraph_entity.field_key_feature_desc.value }}

                  </p>
               </div>
           </div>
         </div>
   
          {% endif %}
          {% endfor %}
     </div>
        {% elseif content[custom_field]["#field_name"] == "field_usecases" %}
          <div>
                
          <ul> 
             {% for key, item in content.field_usecases %}
              {% if key starts with '#' %}
             {# Skip metadata keys like '#theme', '#title', etc. #}
            {% else %}
            <li>
                 {% if item['#type'] == 'inline_template' and item['#context'].value is defined %}
                 {{ item['#context'].value|nl2br }}
                 {% elseif item['#theme'] == 'image_formatter' %}
                   {{ item }} {# Let Drupal render the image properly #}
               {% else %}
                  {{ item }}
             {% endif %}
           </li>
         {% endif %}
             {% endfor %}
        </ul>

      </div>
        {% endif %}
      </div>
     {% endif %}
     {% endfor %}
      <div id="apilist" class="tab-pane active">
         <div class="card">
            <div id="productcreativeapi">
               <div class="card-body">
                  <ul class="list-group">
                
                  {% for api in apiList %}
                      {% if api.node.apic_pathalias[0].value is defined and api.node.apic_pathalias[0].value is not empty %}
                        {% set apiNode = api.node.apic_pathalias[0].value %}
                      {% else %}
                        {% set apiNode = api.node.id %}
                      {% endif %}
                      <li class="list-group-item1" id="api-559" data-redirect-url="{{ path('product.api', {'prodNode': node.id, 'apiNode': apiNode}) }}"> 
                        <div class="list-group-item-div">
                           <span>
                              <a class="product_a" href="{{- path('product.api', {'prodNode': node.id, 'apiNode': apiNode}) -}}" rel="bookmark">
                                {{ api.node.title[0].value }}
                              </a>
                           </span>
                           <i class="fa fa-long-arrow-right" aria-hidden="true"></i>
                        </div>
                        <div class="views-field views-field-apic-description">
                           <div class="field-content">
                              {% if showVersions %}
                                <a href="{{- path('product.api', {'prodNode': node.id, 'apiNode': apiNode}) -}}" rel="bookmark">
                                <span class="apicProductApiVersion">{{ api.node.apic_version[0].value }}</span>
                              </a>
                            {% endif %}
                           </div>
                        </div>
                     </li> 
                  {% endfor %}   
                  
                  </ul>
               </div>
            </div>
         </div>
      </div>

   <!-- ===================================== -->
<!-- DOCUMENTATION TAB -->
<!-- ===================================== -->

<div id="documentation" class="tab-pane fade documentation-product">
  {% if userLoggedIn %}
 <div class="mainProductContent Pane vertical Pane2">
        {% if embedded_docs is defined and embedded_docs is not empty %}
          {% for embedded_doc_page in embedded_docs %}
            {% if embedded_doc_page.docs is defined %}
              {% for embedded_doc_child_page in embedded_doc_page.docs %}
                {% if embedded_doc_child_page.docs is defined %}
                  {% for embedded_doc_grandchild_page in embedded_doc_child_page.docs %}
                    <div
                        class="node__content apicProductBody {{ embedded_doc_grandchild_page.name|clean_class }}{% if embedded_doc_grandchild_page.name is not same as(initial_embeddeddoc) %} hidden{% endif %}">
                      {{ embedded_doc_grandchild_page.output|raw }}
                    </div>
                  {% endfor %}
                {% else %}
                  <div
                      class="node__content apicProductBody {{ embedded_doc_child_page.name|clean_class }}{% if embedded_doc_child_page.name is not same as(initial_embeddeddoc) %} hidden{% endif %}">
                    {{ embedded_doc_child_page.output|raw }}
                  </div>
                {% endif %}
              {% endfor %}
            {% else %}
              <div
                  class="node__content apicProductBody {{ embedded_doc_page.name|clean_class }}{% if embedded_doc_page.name is not same as(initial_embeddeddoc) %} hidden{% endif %}">
                {{ embedded_doc_page.output|raw }}
              </div>
            {% endif %}
          {% endfor %}
        {% endif %}
        <div
            class="node__content apicProductBody apisandplans {% if 'apisandplans' is not same as(initial_embeddeddoc) %}hidden{% endif %}">
          <div class="apicAttachments">
            {{ content.apic_attachments }}
          </div>
          {% if docpages is defined and docpages is not empty %}
            <div class="customDocPages">
              <div class="field--item">
                {% for docpage in docpages %}
                  <div class="docPage {{ docpage.title|clean_class }}">
                    <a href="{{ docpage.url }}">{{ docpage.title }}</a>
                  </div>
                {% endfor %}
              </div>
            </div>                  
          {% endif %}   
        </div>
      </div>
      
                  {% else %}

            {# ================================================== #}
            {# NOT LOGGED IN - SHOW RESTRICTED ACCESS             #}
            {# ================================================== #}

            <div class="restricted-access-wrapper">

              <div class="sign-in-icon">

                <img
                  src="/devcustportal/portal/sites/devcustportal.portal.developer.pronteff.com/files/inline-images/lock-icon-api-product.svg"
                  alt="Restricted access"
                  class="img-fluid"
                >

              </div>


              <h6>
                Restricted Access - Sign in to unlock and explore all API Documentations
              </h6>


              <a
                href="{{ path('user.login') }}"
                class="sign-in-btn">

                Sign in

              </a>

            </div>

          {% endif %}
</div>

</div>
</article>
