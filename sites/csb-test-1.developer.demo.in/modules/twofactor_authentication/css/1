/* Full-screen dark semi-transparent overlay backdrop */
.mfa-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.65);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 99999;
}

/* Centered white modal card */
.mfa-initiate-auth {
  background: #ffffff;
  width: 100%;
  max-width: 650px;
  padding: 40px 30px;
  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  text-align: center;
}

/* Form structure */
.mfa-creds {
  margin-bottom: 25px;
}

.as-copy h4 {
  color: #800033;
  font-size: 26px;
  font-weight: 700;
  margin: 0 0 10px 0;
  letter-spacing: 0.5px;
}

.mfa-otp__msg h5 {
  margin: 0 0 15px 0;
  font-size: 18px;
  font-weight: 600;
  color: #222222;
}

.mfa-email__msg .label {
  font-size: 15px;
  color: #444444;
  margin-bottom: 25px;
}

/* Input box styling */
#edit-otp {
  text-align: center;
  font-size: 20px;
  letter-spacing: 2px;
  width: 180px;
  height: 50px;
  margin: 0 auto;
  display: block;
  padding: 5px 10px;
  border: 1px solid #800033;
  border-radius: 6px;
  outline: none;
  box-shadow: none;
}

#edit-otp:focus {
  border-color: #800033;
  box-shadow: 0 0 0 2px rgba(128, 0, 51, 0.2);
}

/* Button container & layout */
.btn-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
  margin-top: 30px;
  flex-wrap: wrap;
}

/* Primary buttons (Generate OTP / Resend OTP) */
#edit-generate-otp,
#edit-submit:not(:disabled) {
  background-color: #800033 !important;
  color: #ffffff !important;
  border: none !important;
  padding: 12px 24px !important;
  font-size: 15px !important;
  font-weight: 600 !important;
  border-radius: 6px !important;
  cursor: pointer !important;
  min-width: 130px;
  transition: background-color 0.2s ease;
}

#edit-generate-otp:hover,
#edit-submit:hover:not(:disabled) {
  background-color: #600026 !important;
}

/* Disabled Proceed button */
#edit-submit:disabled {
  background-color: #800033 !important;
  opacity: 0.6;
  color: #ffffff !important;
  border: none !important;
  padding: 12px 24px !important;
  font-size: 15px !important;
  font-weight: 600 !important;
  border-radius: 6px !important;
  cursor: not-allowed !important;
  min-width: 130px;
}

/* Secondary button (Cancel and Logout) */
#mfa-cancel__btn {
  background-color: #5d5d5d !important;
  color: #ffffff !important;
  border: none !important;
  padding: 12px 24px !important;
  font-size: 15px !important;
  font-weight: 600 !important;
  border-radius: 6px !important;
  cursor: pointer !important;
  text-decoration: none !important;
  display: inline-block;
  min-width: 130px;
  transition: background-color 0.2s ease;
}

#mfa-cancel__btn:hover {
  background-color: #484848 !important;
}
