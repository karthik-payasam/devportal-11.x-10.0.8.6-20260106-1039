msgid "Favicons & touch icons"
msgstr "Oblíbené ikony a dotykové ikony"

msgid "A PNG image that is 60px wide by 60px high. Used with the non-Retina iPhone, iPod Touch, and Android 2.1+ devices."
msgstr "Obrázek PNG o šířce 60px a výšce 60px. Používá se pro zařízení iPhone a iPod Touch bez displeje Retina a Android 2.1+."

msgid "A PNG image that is 114px wide by 114px high. Used with iPhone with @2x display running iOS <= 6."
msgstr "Obrázek PNG o šířce 114px a výšce 114px. Používá se pro zařízení iPhone s displejem @2x a systémem iOS <= 6."

msgid "A PNG image that is 120px wide by 120px high. Used with iPhone with @2x display running iOS >= 7."
msgstr "Obrázek PNG o šířce 120px a výšce 120px. Používá se pro zařízení iPhone s displejem @2x a systémem iOS >= 7."

msgid "A PNG image that is 144px wide by 144px high. Used with iPad with @2x display running iOS <= 6."
msgstr "Obrázek PNG o šířce 144px a výšce 144px. Používá se pro zařízení iPad s displejem @2x a systémem iOS <= 6."

msgid "A PNG image that is 152px wide by 152px high. Used with iPad with @2x display running iOS >= 7."
msgstr "Obrázek PNG o šířce 152px a výšce 152px. Používá se pro zařízení iPad s displejem @2x a systémem iOS >= 7."

msgid "A PNG image that is 180px wide by 180px high. Used with iPhone 6 Plus with @3x display."
msgstr "Obrázek PNG o šířce 180px a výšce 180px. Používá se pro zařízení iPhone 6 Plus s displejem @3x."

msgid "A PNG image that is 72px wide by 72px high. Used with the iPad mini and the first- and second-generation iPad (@1x display) on iOS <= 6."
msgstr "Obrázek PNG o šířce 72px a výšce 72px. Používá se pro zařízení iPad mini a první i druhou generaci zařízení iPad (displej @1x) se systémem iOS <= 6."

msgid "A PNG image that is 76px wide by 76px high. Used with the iPad mini and the second-generation iPad (@1x display) on iOS >= 7."
msgstr "Obrázek PNG o šířce 76px a výšce 76px. Používá se pro zařízení iPad mini a druhou generaci zařízení iPad (displej @1x) se systémem iOS >= 7."

msgid "A PNG image that is 57px wide by 57px high. Used with the non-Retina iPhone, iPod Touch, and Android 2.1+ devices."
msgstr "Obrázek PNG o šířce 57px a výšce 57px. Používá se pro zařízení iPhone a iPod Touch bez displeje Retina a Android 2.1+."

msgid "A PNG image that is 16px wide by 16px high."
msgstr "Obrázek PNG o šířce 16px a výšce 16px."

msgid "A PNG image that is 192px wide by 192px high."
msgstr "Obrázek PNG o šířce 192px a výšce 192px."

msgid "A PNG image that is 32px wide by 32px high."
msgstr "Obrázek PNG o šířce 32px a výšce 32px."

msgid "A PNG image that is 96px wide by 96px high."
msgstr "Obrázek PNG o šířce 96px a výšce 96px."

msgid "Mask icon color"
msgstr "Barva ikony masky"

msgid "Color attribute for SVG (mask) icon in hexadecimal format, e.g. '#0000ff'. Setting it will break HTML validation. If not set macOS Safari ignores the Mask Icon entirely, making the Icon: SVG completely useless."
msgstr "Atribut barvy pro ikonu SVG (maska) v hexadecimálním formátu, například '#0000ff'. Jeho nastavení bude přerušovat ověření platnosti HTML. Pokud jej nenastavíte, prohlížeč macOS Safari ikonu masky zcela ignoruje, takže je ikona: SVG zcela nepoužitelná."

msgid "Mask icon (SVG)"
msgstr "Ikona masky (SVG)"

msgid "A grayscale scalable vector graphic (SVG) file."
msgstr "Soubor SVG (scalable vector graphic) s obrázkem ve stupních šedi."

msgid "Default icon"
msgstr "Výchozí ikona"

msgid "The traditional favicon, must be either a GIF, ICO, JPG/JPEG or PNG image."
msgstr "Tradiční ikona favicon musí být obrázkem GIF, ICO, JPG/JPEG nebo PNG."

