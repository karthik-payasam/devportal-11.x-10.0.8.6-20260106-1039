msgid "Autocomplete"
msgstr "Автодополнение"

msgid "Search API Autocomplete"
msgstr "Автодополнение API поиска"

msgid "Adds autocomplete functionality to searches."
msgstr "Добавляет возможность автодополнения строк для поиска."

msgid "Search"
msgstr "Поиск"

msgid "Administer Search API Autocomplete"
msgstr "Администрирование автодополнения API поиска"

msgid "Search API Autocomplete settings"
msgstr "Параметры автодополнения API поиска"

msgid "Enable the use of custom scripts as autocomplete callbacks"
msgstr "Разрешить использование пользовательских сценариев в качестве обратных вызовов автодополнения"

msgid "Autocomplete search"
msgstr "Поиск с автодополнением"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "Метка"

msgid "Index ID"
msgstr "ИД индекса"

msgid "Suggester settings"
msgstr "Параметры модуля Suggester"

msgid "The configuration for a single suggester"
msgstr "Конфигурация для одиночного модуля suggester"

msgid "Suggester weights"
msgstr "Весовые коэффициенты Suggester"

msgid "The weight for a single suggester"
msgstr "Весовой коэффициент одиночного suggester"

msgid "Suggester limits"
msgstr "Предельные значения модуля Suggester"

msgid "The limit for a single suggester"
msgstr "Предельные значения для одиночного suggester"

msgid "Search plugin settings"
msgstr "Параметры модуля поиска"

msgid "The configuration for the search entity's search plugin"
msgstr "Конфигурация модуля поиска объекта"

msgid "Options"
msgstr "Настройки"

msgid "Maximum number of suggestions"
msgstr "Максимальное число вариантов"

msgid "The minimum length of user input to trigger autocomplete"
msgstr "Минимальная длина введенной пользователем строки для включения автодополнения"

msgid "Whether to show a predicted result count for suggestions"
msgstr "Следует ли показывать спрогнозированное число результатов для вариантов"

msgid "The delay for triggering autocomplete after the user stopped typing"
msgstr "Задержка включения автодополнения после прекращения ввода текста пользователем"

msgid "A jQuery selector for finding the submit button in the search form"
msgstr "Селектор jQuery для поиска кнопки отправки в форме поиска"

msgid "Whether to automatically submit the search form when a suggestion is selected"
msgstr "Следует ли автоматически отправлять форму поиска при выборе варианта"

msgid "The path or URI of the custom autocomplete script"
msgstr "Путь или URI пользовательского сценария автодополнения"

msgid "The fields to use for autocompletion"
msgstr "Поля для автодополнения"

msgid "The fields to use for searching"
msgstr "Поля, используемые для поиска"

msgid "Whether to replace live results with a highlighted field"
msgstr "Следует ли заменять реальные результаты на выделенное поле"

msgid "The field to replace the live result"
msgstr "Поле для замены реального результата"

msgid "The view modes to use for displaying results"
msgstr "Режимы представления для отображения результатов"

msgid "The view modes to use for displaying results of a certain type"
msgstr "Режимы представления для отображения результатов определенного типа"

msgid "The view mode to use for displaying results of a certain bundle"
msgstr "Режим представления для отображения результатов определенного комплекта"

msgid "Displays"
msgstr "Отображения"

msgid "Whether to exclude (TRUE) or include (FALSE) the selected Views displays."
msgstr "Следует ли исключать (TRUE) или включать (FALSE) выбранные представления."

msgid "The selected Views displays"
msgstr "Выбранные представления"

msgid "A Views display machine name"
msgstr "Имя системы для отображения представления"

msgid "Use autocomplete for the %search search"
msgstr "Использовать автодополнение для поиска %search"

msgid "Autocomplete searches"
msgstr "Автодополнение условий поиска"

msgid "autocomplete search"
msgstr "автодополнение условия поиска"

msgid "autocomplete searches"
msgstr "автодополнение условий поиска"

msgid "Manage autocomplete for search index %label"
msgstr "Управление автодополнением для индекса поиска %label"

msgid "Operations"
msgstr "Операции"

msgid "Edit"
msgstr "Редактировать"

msgid "Delete"
msgstr "Удалить"

msgid "There are currently no searches known for this index. You need to create at least one search view."
msgstr "В данный момент для этого индекса нет операций поиска. Необходимо создать хотя бы одно представление поиска."

msgid "Save"
msgstr "Сохранить"

msgid "The settings have been saved."
msgstr "Настройки были сохранены."

msgid "The settings have been saved. Please remember to set the <a href=\":perm_url\">permissions</a> for the newly enabled searches."
msgstr "Параметры сохранены. Не забудьте указать <a href=\":perm_url\">права доступа</a> для новых операций поиска."

msgid "No values were changed."
msgstr "Значения не изменены."

msgid "Configure autocompletion for %search"
msgstr "Настроить автодополнение для %search"

msgid "Enabled"
msgstr "Включено"

msgid "No information about this search could be found. Unless this is a temporary problem for some reason, you are advised to delete this search configuration."
msgstr "Не удалось найти информацию об этом поиске. Если по какой-либо причине эта проблема сохраняется, рекомендуется удалить эту конфигурацию поиска."

msgid "The maximum number of autocomplete suggestions to display in total."
msgstr "Максимальное число отображаемых вариантов автодополнения в общей сложности."

msgid "Minimum length of keywords for autocompletion"
msgstr "Минимальная длина ключевых слов для автодополнения"

msgid "If the entered keywords are shorter than this, no autocomplete suggestions will be displayed."
msgstr "Если ключевые слова короче этого значения, варианты автодополнения не будут отображаться."

msgid "Display result count estimates"
msgstr "Показать оценки количества результатов"

msgid "Display the estimated number of result for each suggestion. This option might not have an effect for some servers or types of suggestion."
msgstr "Показать оценочное число результатов для каждого варианта. Эта опция может не работать для некоторых серверов или типов вариантов."

msgid "Advanced settings"
msgstr "Расширенные настройки"

msgid "Enable auto-submit"
msgstr "Включить автоматическую отправку"

msgid "When enabled, the search form will automatically be submitted when a selection is made by pressing \"Enter\"."
msgstr "Если включено, форма поиска будет автоматически отправлена после выбора варианта с помощью клавиши \"Enter\"."

msgid "Search button selector"
msgstr "Селектор кнопки поиска"

msgid "<a href=\"@jquery_url\">jQuery selector</a> identifying the button to use for submitting the search form. Use the ID attribute of the \"Search\" submit button to prevent issues when another button is present (e.g., \"Reset\"). The selector is evaluated relative to the form. The default value is \"@default\"."
msgstr "<a href=\"@jquery_url\">Селектор jQuery</a>, определяющий кнопку для отправки формы поиска. Следует использовать атрибут ИД кнопки отправки \"Найти\" для предотвращения ошибки при наличии другой кнопки (например \"Сброс\"). Селектор вычисляется относительно формы. Значение по умолчанию - \"@default\"."

msgid "Delay (in ms)"
msgstr "Задержка (в мс)"

msgid "The delay in milliseconds between when a keystroke occurs and when a search is performed. Low values will result in a more responsive experience for users, but can also cause a higher load on the server. Defaults to 300 ms."
msgstr "Задержка в миллисекундах между вводом ключевой строки и выполнением поиска. Меньшие значения повышают адаптивность интерфейса для пользователей, но могут привести к повышенной нагрузке на сервер. Значение по умолчанию - 300 мс."

msgid "Suggester plugins"
msgstr "Модули Suggester"

msgid "Suggester plugins represent methods for creating autocomplete suggestions from user input."
msgstr "Модули Suggester представляют способы для создания вариантов автодополнения при вводе текста пользователем."

msgid "Enabled suggesters"
msgstr "Включенные модули suggester"

msgid "Choose the suggester plugins to use for creating autocomplete suggestions."
msgstr "Выберите модули suggester, которые будут использоваться для создания вариантов автодополнения."

msgid "At most @num results"
msgstr "Не более @num результатов"

msgid "Weight for suggester %label"
msgstr "Весовой коэффициент для модуля suggester %label"

msgid "Configure suggester %label"
msgstr "Настроить модуль suggester %label"

msgid "The autocompletion settings for the search have been saved."
msgstr "Параметры автодополнения для поиска сохранены."

msgid "Suggester %id specifies a non-existing class %class."
msgstr "Модуль Suggester %id указывает на несуществующий класс %class."

msgid "Search pages"
msgstr "Страницы поиска"

msgid "Searches provided by the <em>Search pages</em> module"
msgstr "Операции поиска, предоставленные модулем <em>Найти страницы</em>"

msgid "For which Views displays should Autocomplete be active?"
msgstr "Для каких представлений должно быть активно автодополнение?"

msgid "All except those selected"
msgstr "Все кроме выбранных"

msgid "None except those selected"
msgstr "Только выбранные"

msgid "Could not load view @view."
msgstr "Не удалось загрузить представление @view."

msgid "Search views"
msgstr "Представления поиска"

msgid "Searches provided by Views"
msgstr "Операции поиска, предоставленные представлениями"

msgid "Custom script path"
msgstr "Путь к пользовательскому сценарию"

msgid "The internal path or external URL to use for autocompletion. A local path should start with a leading slash. For using an external URL, please take CSRF protection into account."
msgstr "Внутренний путь или внешний URL, используемый для автодополнения. Локальный путь должен начинаться с косой черты. Для использования внешнего URL учитывайте защиту CSRF."

msgid "The %field field is required."
msgstr "Требуется поле %field."

msgid "Use custom script"
msgstr "Применять пользовательский сценарий"

msgid "Specify the path to a PHP script file (or Drupal route) which should be used to generate autocomplete suggestions. This can be used to completely bypass Drupal for improved performance.<br />(<strong>Caution:</strong> If a non-Drupal script is used, Drupal's access restrictions will also be bypassed.)<br />(Note: Due to the nature of this suggester, some of the other settings for this search will be ignored (including other enabled suggesters).)"
msgstr "Укажите путь к файлу сценария PHP (или маршрут Drupal), который должен применяться для создания вариантов автодополнения. Такой подход позволяет полностью исключить Drupal для повышения быстродействия.<br />(<strong>Внимание:</strong> если используется сценарий, отличный от Drupal, ограничения доступа Drupal также будут исключены.)<br />(Примечание: из-за характера данного модуля suggester будут игнорироваться некоторые другие параметры поиска (включая другие включенные модули suggester).)"

msgid "Override used fields"
msgstr "Переопределить используемые поля"

msgid "Select the fields which should be searched for matches when looking for autocompletion suggestions. Leave blank to use the same fields as the underlying search."
msgstr "Выберите поля, в которых должен выполняться поиск совпадений во время поиска вариантов автодополнения. Если поля не будут выбраны, будут использоваться поля, применяемые для основного поиска."

msgid "View modes"
msgstr "Режимы отображения"

msgid "Please select the view modes to use for live results."
msgstr "Выберите режимы представления для отображения результатов в реальном времени."

msgid "Use only label"
msgstr "Использовать только метку"

msgid "Highlight"
msgstr "Подсвеченный"

msgid "Highlight live results"
msgstr "Выделить реальные результаты"

msgid "Replace the live result with the output of a highlighted field, if available. Requires the %highlight processor to be enabled."
msgstr "Заменить реальный результат на вывод выделенного поля (если он доступен). Требуется, чтобы был включен обработчик %highlight."

msgid "Enable highlighting of live results"
msgstr "Включить выделение реальных результатов"

msgid "Select the field to replace live result"
msgstr "Выберите поле для замены реального результата"

msgid "Only invalid fulltext fields set for suggester \"@suggester\" in autocomplete settings for search \"@search\" on index \"@index\"."
msgstr "Для модуля suggester \"@suggester\" в параметрах автодополнения для поиска \"@search\" в индексе \"@index\" заданы только недопустимые полнотекстовые поля."

msgid "Display live results"
msgstr "Показать результаты в реальном времени"

msgid "Display live results to visitors as they type. (Unless the server is configured to find partial matches, this will most likely only produce results once the visitor has finished typing.)"
msgstr "Показывать результаты в реальном времени посетителям по мере ввода ими текста. (Если сервер не настроен для поиска частичных совпадений, скорее всего результаты будут сформированы после окончания ввода.)"

msgid "Retrieve from server"
msgstr "Получить с сервера"

msgid "Make suggestions based on the data indexed on the server."
msgstr "Создать варианты на основе данных, проиндексированных на сервере."

msgid "Other searches"
msgstr "Другие операции поиска"

msgid "Searches not belonging to any specific group"
msgstr "Выполняет поиск, не относящийся к какой-либо конкретной группе"

msgid "Custom Search"
msgstr "Пользовательский поиск"

msgid "Custom-defined site-specific search."
msgstr "Определенный пользователем поиск для конкретного сайта."

msgid "My Suggester"
msgstr "Мой модуль Suggester"

msgid "Creates suggestions based on internet memes."
msgstr "Создает варианты на основе интернет-мемов."

