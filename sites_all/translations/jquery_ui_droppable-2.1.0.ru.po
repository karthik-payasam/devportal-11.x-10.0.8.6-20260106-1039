msgid "About"
msgstr "Информация"

msgid "Drupal 8 includes jQuery UI in core, however it is no longer actively maintained and has been marked deprecated. This module provides the jQuery UI Droppable library for any themes and modules that require it."
msgstr "В состав Drupal 8 входит модуль jQuery UI, однако он больше не поддерживается и считается устаревшим. Этот модуль предлагает библиотеку jQuery UI Droppable для любых тем и модулей, которым она требуется."

msgid "For more information about the deprecation of jQuery UI, see this <a href=\":change-record\">change record</a>"
msgstr "Дополнительная информация об устаревании jQuery UI приведена в этой <a href=\":change-record\">записи изменения</a>"

msgid "Visit the <a href=\":project_link\">jQuery UI Droppable project page</a> on Drupal.org for more information."
msgstr "Дополнительная информация приведена на <a href=\":project_link\">странице проекта jQuery UI Droppable</a> на сайте Drupal.org."

msgid "jQuery UI Droppable"
msgstr "jQuery UI Droppable"

msgid "Provides jQuery UI Droppable library."
msgstr "Предлагает библиотеку jQuery UI Droppable."

msgid "jQuery UI"
msgstr "jQuery UI"

