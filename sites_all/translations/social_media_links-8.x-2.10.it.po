msgstr "Orientamento "

msgid "vertical"
msgstr "verticale "

msgid "horizontal"
msgstr "orizzontale "

msgid "Show name"
msgstr "Mostra nome"

msgid "Show the platform name next to the icon."
msgstr "Mostra il nome della piattaforma accanto all'icona. "

msgid "Link attributes"
msgstr "Attributi del link"

msgid "Default target"
msgstr "Destinazione predefinita"

msgid "Remove target attribute"
msgstr "Rimuovi attributi di destinazione "

msgid "Open in a new browser window or tab (_blank)"
msgstr "Apri in una nuova scheda o finestra del browser (_blank)"

msgid "Open in the current window (_self)"
msgstr "Apri nella finestra corrente (_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "Apri nel frame superiore al frame che contiene il link (_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "Annulla tutti i frame ed apri in una finestra del browser completa (_top)"

msgid "Default rel"
msgstr "Rel predefinito "

msgid "Remove rel attribute"
msgstr "Rimuovi attributo rel "

msgid "Set nofollow"
msgstr "Imposta nofollow"

