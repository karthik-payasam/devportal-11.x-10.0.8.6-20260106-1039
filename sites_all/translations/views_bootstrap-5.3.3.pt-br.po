msgid "@style style will not display without the \"@field\" setting."
msgstr "O estilo @style não será exibido sem a configuração \"@field\"."

msgid "About"
msgstr "Sobre"

msgid "The <a href=\":bootstrap\">Views Bootstrap module</a> adds styles to Views to output the results of a view as several common <a href=\":components\">Twitter Bootstrap</a> components."
msgstr "O <a href=\":bootstrap\">Módulo de autoinicialização de visualizações</a> inclui estilos nas Visualizações para gerar os resultados de uma visualização como vários componentes comuns de <a href=\":components\">Autoinicialização do Twitter</a>."

msgid "Uses"
msgstr "Usos"

msgid "<a href=\":views\">Create a view</a> using one of the following styles:"
msgstr "<a href=\":views\">Criar uma visualização</a> usando um dos estilos a seguir:"

msgid "<a href=\":docs\">Accordion</a>"
msgstr "<a href=\":docs\">Acordeão</a>"

msgid "<a href=\":docs\">Cards</a>"
msgstr "<a href=\":docs\">Cartões</a>"

msgid "<a href=\":docs\">Carousel</a>"
msgstr "<a href=\":docs\">Carrossel</a>"

msgid "<a href=\":docs\">Dropdown</a>"
msgstr "<a href=\":docs\">Suspenso</a>"

msgid "<a href=\":docs\">Grid</a>"
msgstr "<a href=\":docs\">Grade</a>"

msgid "<a href=\":docs\">Thumbnails</a>"
msgstr "<a href=\":docs\">Miniaturas</a>"

msgid "<a href=\":docs\">Tables</a>"
msgstr "<a href=\":docs\">Tabelas</a>"

msgid "<a href=\":docs\">Tabs</a>"
msgstr "<a href=\":docs\">Tabulações</a>"

msgid "<a href=\":docs\">Media object</a>"
msgstr "<a href=\":docs\">Objeto de mídia</a>"

msgid "<a href=\":docs\">List group</a>"
msgstr "<a href=\":docs\">Grupo de Listas</a>"

msgid "Views Bootstrap"
msgstr "Visualiza o Bootstrap"

msgid "Views Twitter Bootstrap Components."
msgstr "Visualiza componentes de autoinicialização do Twitter."

msgid "Views"
msgstr "Views"

msgid "The Bootstrap accordion displays content in collapsible panels (<a href=\":docs\">see documentation</a>)."
msgstr "A sanfona do Bootstrap exibe o conteúdo em painéis reduzíveis (<a href=\":docs\">consulte a documentação</a>)."

msgid "Panel title field"
msgstr "Campo de título do painel"

msgid "Select the field that will be used as the accordion panel titles."
msgstr "Selecione o campo que será usado como os títulos do painel de sanfona."

msgid "Label field"
msgstr "Campo de rótulo"

msgid "- None -"
msgstr "- Nenhum -"

msgid "Select the field that will be used as the label."
msgstr "Selecione o campo que será usado como rótulo."

msgid "Collapse Options"
msgstr "Reduzir opções"

msgid "All Items Closed"
msgstr "Todos os itens fechados"

msgid "First Item Open"
msgstr "Primeiro item aberto"

msgid "All Items Open"
msgstr "Todos os itens abertos"

msgid "Default panel state for collapse behavior."
msgstr "Estado do painel padrão para comportamento de redução."

msgid "Bootstrap Accordion"
msgstr "Bootstrap em Sanfona"

msgid "Displays rows in a Bootstrap Accordion."
msgstr "Exibe linhas em um Bootstrap Sanfona. "

msgid "Card title field"
msgstr "Campo de título do cartão"

msgid "Select the field that will be used for the card title."
msgstr "Selecione o campo que será usado para o título do cartão."

msgid "Card content field"
msgstr "Campo de conteúdo do cartão"

msgid "Select the field that will be used for the card content."
msgstr "Selecione o campo que será usado para o conteúdo do cartão."

msgid "Card image field"
msgstr "Campo de imagem do cartão"

msgid "Select the field that will be used for the card image."
msgstr "Selecione o campo que será usado para a imagem do cartão."

msgid "Custom card group class"
msgstr "Classe de grupo de cartões customizados"

msgid "Additional classes to provide on the card group. Separated by a space."
msgstr "Classes adicionais a serem fornecidas no grupo de cartões. Separados por um espaço."

msgid "Additional classes to provide on each card. Separated by a space."
msgstr "Classes adicionais a serem fornecidas em cada cartão. Separados por um espaço."

msgid "Bootstrap Cards"
msgstr "Cartões do Bootstrap"

msgid "Displays rows in a Bootstrap Card Group layout"
msgstr "Exibe linhas em um layout de Grupo de Cartões do Bootstrap"

msgid "The Bootstrap carousel displays content as a slideshow (<a href=\":docs\">see documentation</a>)."
msgstr "O carrossel do Bootstrap exibe o conteúdo como uma exibição de slides (<a href=\":docs\">consulte a documentação</a>)."

msgid "<None>"
msgstr "«Nenhum»"

msgid "Interval"
msgstr "Intervalo"

msgid "The amount of time to delay between automatically cycling an item. If false, carousel will not automatically cycle."
msgstr "A quantidade de tempo de atraso entre ciclos automáticos de um item. Se false, o carrossel não entra em ciclo automaticamente."

msgid "Show navigation"
msgstr "Mostrar navegação"

msgid "Show indicators"
msgstr "Mostrar indicadores"

msgid "Pause on hover"
msgstr "Pausar na ajuda instantânea"

msgid "Pauses the cycling of the carousel on mouseenter and resumes the cycling of the carousel on mouseleave."
msgstr "Pausa o ciclo do carrossel no mouseenter e continua o ciclo do carrossel no mouseleave."

msgid "Wrap"
msgstr "Quebra"

msgid "The carousel should cycle continuously or have hard stops."
msgstr "O carrossel deve entrar em ciclo continuamente ou ter paradas imediatas."

msgid "Columns"
msgstr "Colunas"

msgid "The number of columns to include in the carousel."
msgstr "O número de colunas a incluir no carrossel."

msgid "Breakpoints"
msgstr "Pontos de interrupção"

msgid "The min-width breakpoint of the multicolumn carousel."
msgstr "O ponto de interrupção da largura mínima do carrossel com várias colunas."

msgid "Extra Small"
msgstr "Extrapequeno"

msgid "Small"
msgstr "&amp;amp;Pequeno"

msgid "Medium"
msgstr "Médio"

msgid "Large"
msgstr "Grande"

msgid "Display"
msgstr "Exibição"

msgid "Select by fields"
msgstr "Selecionar por campos"

msgid "Display fields as row content"
msgstr "Exibir campos como conteúdo de linha"

msgid "Displaying fields as row content will output the field rows as unformatted values within each carousel item."
msgstr "Exibir campos como conteúdo de linha produzirá a saída de linhas de campo como valores não formatados dentro de cada item de carrossel."

msgid "Image"
msgstr "Imagem"

msgid "Title"
msgstr "Título"

msgid "Description"
msgstr "Descrição"

msgid "Bootstrap Carousel"
msgstr "Carrossel de Autoinicialização"

msgid "Displays rows in a Bootstrap Carousel."
msgstr "Exibe linhas em um Carrossel de Autoinicialização."

msgid "The Bootstrap dropdown style displays a list of links in a drop-down menu format (<a href=\":docs\">see documentation</a>)."
msgstr "O estilo suspenso do Bootstrap exibe uma lista de links em um formato de menu suspenso (<a href=\":docs\">consulte a documentação</a>)."

msgid "Button text"
msgstr "Texto do botão"

msgid "Text label for the button that is the drop-down toggle."
msgstr "Rótulo de texto para o botão que é a alternância suspensa."

msgid "Button class"
msgstr "Classe de botão"

msgid "Classes for the button that is the drop-down toggle."
msgstr "Classes para o botão que é a alternância suspensa."

msgid "Default"
msgstr "Padrão"

msgid "Primary"
msgstr "Primário"

msgid "Success"
msgstr "Sucesso"

msgid "Info"
msgstr "Informações"

msgid "Warning"
msgstr "Aviso"

msgid "Danger"
msgstr "Perigo"

msgid "Wrapper class"
msgstr "Classe wrapper"

msgid "The class to provide on the wrapper, outside the list."
msgstr "A classe usada no elemento que envolve a lista, fora dela."

msgid "List class"
msgstr "Classe da lista"

msgid "The class to provide on the list element itself."
msgstr "A classe para ser inserida na lista."

msgid "Bootstrap Dropdown"
msgstr "Suspenso do Bootstrap"

msgid "Displays rows in a Bootstrap Dropdown."
msgstr "Exibe as linhas em um suspenso do Bootstrap."

msgid "The Bootstrap grid displays content in a responsive, mobile first fluid grid (<a href=\":docs\">see documentation</a>)."
msgstr "A grade do Bootstrap exibe o conteúdo em uma grade de primeiro fluido responsivo e móvel (<a href=\":docs\">Consulte a documentação</a>)."

msgid "Alignment"
msgstr "Alinhamento"

msgid "Horizontal"
msgstr "Horizontal"

msgid "Vertical"
msgstr "Vertical"

msgid ""
"Horizontal alignment will place items starting in the upper left and moving right.\n"
"      Vertical alignment will place items starting in the upper left and moving down."
msgstr ""
"O alinhamento horizontal colocará os itens que iniciam na parte superior esquerda e se movem para a direita.\n"
"      O alinhamento vertical vai fazer com que os itens sejam a partir do topo a esquerda, indo para baixo na mesma coluna."

msgid "Default column classes"
msgstr "Classes padrão das colunas"

msgid "Add the default views column classes like views-col, col-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Inclui classes de coluna de views padrão como views-col, col-1 e clearfix no resultado. Você pode usar isto para rapidamente reduzir a quantidade de marcação que a view oferece por padrão, ao custo de tornar mais difícil aplicar CSS."

msgid "Custom column class"
msgstr "Classe personalizada da coluna"

msgid "Additional classes to provide on each column. Separated by a space."
msgstr "Classes adicionais para cada coluna. Separados por um espaço."

msgid "You may use field tokens from as per the \"Replacement patterns\" used in \"Rewrite the output of this field\" for all fields."
msgstr "Você pode usar padrões de substituição tais como usados em \"Reescrever saída deste campo\" para todos os campos."

msgid "Default row classes"
msgstr "Classe padrão da linha"

msgid "Adds the default views row classes like views-row, row-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Inclui classes padrão de linhas de views como views-row, row-1 e clearfix no resultado. Você pode usar isto para rapidamente reduzir a quantidade de marcação que a view oferece por padrão, ao custo de tornar mais difícil aplicar CSS."

msgid "Custom row class"
msgstr "Classe personalizada da linha"

msgid "Additional classes to provide on each row. Separated by a space."
msgstr "Classes adicionais para cada linha. Separadas por espaço."

msgid "Base number of columns"
msgstr "Número base de colunas"

msgid "all"
msgstr "todos"

msgid "Choose the number of columns that views will wrap in a single row. This will be reflected in the HTML structure rendered regardless of the device size. If selecting \"all\" then use the alternative template."
msgstr "Escolha o número de colunas que as visualizações agruparão em uma única linha. Isso será refletido na estrutura HTML renderizada, independentemente do tamanho do dispositivo. Se selecionar \"todos\", use o modelo alternativo."

msgid "Number of columns (col-@size)"
msgstr "Número de colunas (col-@size)"

msgid "This adds col-@size to the div."
msgstr "Isso inclui col-@size na divisão."

msgid "Bootstrap Grid"
msgstr "Grade de Autoinicialização"

msgid "Displays rows in a Bootstrap Grid layout"
msgstr "Exibe linhas em um layout de Grade de Autoinicialização."

msgid "The Bootstrap list group displays content in an unordered list with list group classes (<a href=\":docs\">see documentation</a>)."
msgstr "O grupo de lista do Bootstrap exibe o conteúdo em uma listas não ordenadas com classes de grupo de listas (<a href=\":docs\">consulte a documentação</a>)."

msgid "Set group field in panel heading"
msgstr "Configurar campo de grupo no título do painel"

msgid "Title field"
msgstr "Campo de título"

msgid "Select the field that will be used as the title."
msgstr "Selecione o campo que será usado como o título."

msgid "Bootstrap List Group"
msgstr "Grupo de Lista de Autoinicialização"

msgid "Displays rows in a Bootstrap List Group."
msgstr "Exibe linhas em um Grupo de Lista de Autoinicialização."

msgid "The Bootstrap media object displays content with an image item lead with heading and text (<a href=\":docs\">see documentation</a>)."
msgstr "O objeto de mídia do Bootstrap exibe o conteúdo com um item de imagem inicial com título e texto (<a href=\":docs\">consulte a documentação</a>)."

msgid "Heading field"
msgstr "Campo de título"

msgid "Select the field that will be used as the media object heading. Exclude this field from display to prevent duplication."
msgstr "Selecione o campo que será usado como o título de objeto de mídia. Exclua este campo de exibição para evitar duplicação."

msgid "Image field"
msgstr "Campo de imagem"

msgid "Select the field that will be used as the media object image. Exclude this field from display to prevent duplication."
msgstr "Selecione o campo que será usado como a imagem de objeto de mídia. Exclua este campo de exibição para evitar duplicação."

msgid "Body field"
msgstr "Campo do corpo"

msgid "All fields that are not excluded from display will be shown as the body."
msgstr "Todos os campos que não forem excluídos de exibição serão mostrados como o corpo."

msgid "Image Alignment"
msgstr "Alinhamento da Imagem"

msgid "Left"
msgstr "Esquerda"

msgid "Right"
msgstr "Direita"

msgid "Middle"
msgstr "Meio"

msgid "Align the media object image left or right."
msgstr "Alinhar a imagem de objeto de mídia para a esquerda ou para a direita."

msgid "Bootstrap Media Object"
msgstr "Objeto de Mídia de Autoinicialização"

msgid "Displays rows in a Bootstrap Media Object."
msgstr "Exibe linhas em um Objeto de Mídia de Autoinicialização."

msgid "The Bootstrap panels displays content in a box with optional header and footer elements (<a href=\":docs\">see documentation</a>)."
msgstr "Os painéis do Bootstrap exibem o conteúdo em uma caixa com elementos de cabeçalho e rodapé opcionais (<a href=\":docs\">consulte a documentação</a>)."

msgid "Contextual class"
msgstr "Classe contextual"

msgid "<a href=\":docs\">see Bootstrap documentation</a>"
msgstr "<a href=\":docs\">Consulte a documentação do Bootstrap</a>"

msgid "Select the field that will be used as the panel heading titles."
msgstr "Selecione o campo que será usado como os títulos do painel."

msgid "Panel footer field"
msgstr "Campo de rodapé do painel"

msgid "Select the field that will be used as the panel footer."
msgstr "Selecione o campo que será usado como rodapé do painel."

msgid "Bootstrap Panels"
msgstr "Painéis do Bootstrap"

msgid "Displays rows in a Bootstrap Panel."
msgstr "Exibe as linhas em um painel do Bootstrap."

msgid "The Bootstrap tabs displays content with tab titles linked to dynamically displayed content (<a href=\":docs\">see documentation</a>)."
msgstr "As guias do Bootstrap exibem o conteúdo com títulos de guia vinculados a um conteúdo exibido dinamicamente (<a href=\":docs\">consulte a documentação</a>)."

msgid "Tab field"
msgstr "Campo de tabulação"

msgid "Select the field that will be used as the tab."
msgstr "Selecione o campo que será usado como a guia."

msgid "Tab Type"
msgstr "Tipo de Guia"

msgid "Tabs"
msgstr "Abas"

msgid "Pills"
msgstr "Comprimidos"

msgid "List"
msgstr "Lista"

msgid "Position of tabs"
msgstr "Posição das guias"

msgid "Tabs/pills on the top"
msgstr "Guias/pílulas na parte superior"

msgid "Tabs/pills on the left"
msgstr "Guias/pílulas à esquerda"

msgid "Tabs/pills on the right"
msgstr "Guias/pílulas à direita"

msgid "Tabs/pills on the bottom"
msgstr "Guias/pílulas na parte inferior"

msgid "Tabs/pills justified on the top"
msgstr "Guias/pílulas justificadas na parte superior"

msgid "Tabs/pills stacked"
msgstr "Guias/pílulas empilhadas"

msgid "Fade Effect"
msgstr "Efeito de fazer aparecer/desaparecer"

msgid "Add a fade in effect when tabs clicked"
msgstr "Inclua um efeito de fazer aparecer quando as guias forem clicadas"

msgid "Bootstrap Tabs"
msgstr "Guias do Bootstrap"

msgid "Displays rows in Bootstrap Tabs."
msgstr "Exibe linhas em Guias de Autoinicialização."

msgid "The Bootstrap table style adds default Bootstrap table classes and optional classes (<a href=\":docs\">see documentation</a>)."
msgstr "O estilo de tabela do Bootstrap inclui classes de tabela do Bootstrap padrão e classes opcionais (<a href=\":docs\">consulte a documentação</a>)."

msgid "Responsive"
msgstr "Responsivo"

msgid "To make a table scroll horizontally on small devices."
msgstr "Fazer com que uma tabela role horizontalmente em pequenos dispositivos."

msgid "Bootstrap styles"
msgstr "Estilos de Autoinicialização"

msgid "Striped"
msgstr "Com Striping"

msgid "Bordered"
msgstr "Com borda"

msgid "Hover"
msgstr "Ao passar do mouse"

msgid "Condensed"
msgstr "Condensado"

msgid "Caption for the table"
msgstr "Legenda para a tabela"

msgid "A title semantically associated with your table for increased accessibility."
msgstr "Um título semanticamente associado à sua tabgela para aumentar a acessibilidade."

msgid "Table details"
msgstr "Detalhes da tabela"

msgid "Summary title"
msgstr "Título do resumo"

msgid "Table description"
msgstr "Descrição da tabela"

msgid "Provide additional details about the table to increase accessibility."
msgstr "Forneça detalhes adicionais sobre a tabela para aumentar a acessibilidade."

msgid "Bootstrap Table"
msgstr "Tabela de Autoinicialização"

msgid "Displays rows in a Bootstrap table."
msgstr "Exibe linhas em uma Tabela de Autoinicialização."

msgid "The Bootstrap thumbnails extends the grid display with the thumbnail component to showcase linked images (<a href=\":docs\">see documentation</a>)."
msgstr "As miniaturas do Bootstrap estendem a exibição da grade com o componente de miniatura para mostrar imagens vinculadas (<a href=\":docs\">consulte a documentação</a>)."

msgid "Bootstrap Thumbnails"
msgstr "Miniaturas do Bootstrap"

msgid "Displays rows in a Bootstrap Grid layout with thumbnails"
msgstr "Exibe as linhas em um layout de Grade do Bootstrap com miniaturas"

msgid "Previous"
msgstr "Anterior"

msgid "Next"
msgstr "Próximo"

