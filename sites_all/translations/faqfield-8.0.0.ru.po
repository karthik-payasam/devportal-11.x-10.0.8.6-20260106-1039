msgid "About"
msgstr "Информация"

msgid "The FAQ Field module defines a field for storing frequently asked questions, for use with the Field module. See the <a href=\":field_ui\">Field module help page</a> for more information about fields."
msgstr "Модуль поля Вопросы и ответы определяет поле для хранения часто задаваемых вопросов, для использования с модулем Поле. Дополнительная информация о полях приведена на <a href=\":field_ui\">странице справки модуля Поле</a>."

msgid "FAQ Field"
msgstr "Поле Вопросы и ответы"

msgid "Provides a field for frequently asked questions."
msgstr "Предоставляет поле для часто задаваемых вопросов."

msgid "Field types"
msgstr "Типы полей"

msgid "FAQ Field jQuery Accordion format settings"
msgstr "Параметры формата Гармошки jQuery для поля Вопросы и ответы"

msgid "Index of active element starting from 0. Leave empty to display none at start."
msgstr "Индекс активного элемента начиная с 0. Оставьте пустым, чтобы ничего не отображалось при запуске."

msgid "Controls the height of the accordion and each panel."
msgstr "Управляет высотой гармошки и каждой панели."

msgid "Whether an opened question can be collapsed (by the triggering event)."
msgstr "Может ли быть свернут открытый вопрос (по триггерному событию)."

msgid "Event on which to trigger the accordion."
msgstr "Событие активации гармошки."

msgid "Animation options for the accordion formatter."
msgstr "Опции анимации для функции форматирования гармошки."

msgid "Name of easing to use when the event is triggered."
msgstr "Имя используемой функции плавности при активации события."

msgid "Animation duration in milliseconds with the selected easing."
msgstr "Продолжительность анимации (в миллисекундах) с выбранной функцией плавности."

msgid "FAQ Field HTML anchor list format settings"
msgstr "Параметры формата списка меток HTML поля Вопросы и ответы"

msgid "The type of HTML list used for the anchor link list."
msgstr "Тип списка HTML, используемого для списка ссылок на метки."

msgid "FAQ Field default widget settings"
msgstr "Параметры виджета по умолчанию поля Вопросы и ответы"

msgid "What form widget to use for answer input."
msgstr "Виджет формы, используемый для ввода ответа."

msgid "Custom title of question input."
msgstr "Пользовательский заголовок вопроса."

msgid "Custom title of answer input."
msgstr "Пользовательский заголовок ответа."

msgid "Question field is required."
msgstr "Необходимо указать вопрос."

msgid "Answer field is required."
msgstr "Необходимо указать ответ."

msgid "Advanced options of the FAQ Field default widget."
msgstr "Дополнительные опции виджета по умолчанию поля Вопросы и ответы."

msgid "Maximum length of questions."
msgstr "Максимальная длина вопросов."

msgid "Size the question widget."
msgstr "Размер виджета вопроса."

msgid "Number of rows used for the question widget."
msgstr "Число строк в виджете вопроса."

msgid "Number of rows used for the answer widget."
msgstr "Число строк в виджете ответа."

msgid "FAQ Field field settings"
msgstr "Параметры поля Вопросы и ответы"

msgid "Default text format"
msgstr "Текстовый формат по умолчанию"

msgid "Default active"
msgstr "Активный вопрос по умолчанию"

msgid "None"
msgstr "Нет"

msgid "Index of the active question starting from 0. If left empty and <em>Fully collapsible</em> is on, no question will be opened by default."
msgstr "Индекс активного вопроса начиная с 0. Если значение не указано и включен параметр <em>Полностью свернуть</em>, то по умолчанию вопрос открываться не будет."

msgid "Height style"
msgstr "Стиль высоты"

msgid "Auto : All panels will be set to the height of the tallest question."
msgstr "Auto: Все панели будут настроены по высоте вопроса с самой большой высотой."

msgid "Fill : Expand to the available height based on the accordions question height."
msgstr "Fill: Развернуть до доступной высоты в зависимости от высоты вопроса гармошки."

msgid "Content : Each panel will be only as tall as its question."
msgstr "Content: Каждая панель будет такой же высоты, как ее вопрос."

msgid "Fully collapsible"
msgstr "Полностью сворачиваемая"

msgid "Whether all the questions can be closed at once. Allows collapsing the active section."
msgstr "Можно ли закрыть сразу все вопросы. Позволяет свернуть активный раздел."

msgid "Event"
msgstr "Событие"

msgid "The event on which to open a question. Multiple events can be specified, separated by a space."
msgstr "Событие, открывающее вопрос. Можно указать несколько событий через пробел."

msgid "Animation settings"
msgstr "Настройки анимации"

msgid "Duration"
msgstr "Продолжительность"

msgid "Easing"
msgstr "Плавность"

msgid "Name of <a href=\"@link\">easing</a> to use when the event is triggered."
msgstr "Имя используемой <a href=\"@link\">функции плавности</a> при активации события."

msgid "Default active: @element"
msgstr "Активный по умолчанию: @element"

msgid "Auto"
msgstr "Авто"

msgid "Fill"
msgstr "Заливка"

msgid "Content"
msgstr "Содержимое"

msgid "Height style : @style"
msgstr "Стиль высоты: @style"

msgid "Event: @event"
msgstr "Событие: @event"

msgid "jQuery Accordion"
msgstr "Гармошка jQuery"

msgid "Anchor link list type"
msgstr "Тип списка ссылок на метки"

msgid "<ul> - Bullet list"
msgstr "<ul> - Маркированный список"

msgid "<ol> - Numeric list"
msgstr "<ol> - Нумерованный список"

msgid "Bullet list"
msgstr "Маркированный список"

msgid "Numeric list"
msgstr "Нумерованный список"

msgid "HTML anchor list"
msgstr "Список маркеров HTML"

msgid "HTML definition list"
msgstr "Список определений HTML"

msgid "HTML details"
msgstr "Сведения об HTML"

msgid "Simple text"
msgstr "Простой текст"

msgid "Question value"
msgstr "Значение вопроса"

msgid "Answer value"
msgstr "Значение ответа"

msgid "Answer text format"
msgstr "Текстовый формат ответа"

msgid "Default text format to filter FAQ field answer content."
msgstr "Текстовый формат по умолчанию для фильтрации содержимого ответа в поле Вопросы и ответы."

msgid "Question"
msgstr "Вопрос"

msgid "Answer"
msgstr "Ответ"

msgid "Answer widget"
msgstr "Виджет ответа"

msgid "Textarea"
msgstr "Текстовая область"

msgid "Formatable textarea"
msgstr "Форматируемая область текста"

msgid "Textfield"
msgstr "Текстовое поле"

msgid "What form widget to use for answer input. Formatable textarea is needed for WYSIWYG editors."
msgstr "Виджет формы, используемый для ввода ответа. Форматируемая область текста нужна для редакторов WYSIWYG."

msgid "Question widget title"
msgstr "Заголовок виджета вопроса"

msgid "Custom title of question widget."
msgstr "Пользовательский заголовок виджета вопроса."

msgid "Answer widget title"
msgstr "Заголовок виджета ответа"

msgid "Custom title of answer widget."
msgstr "Пользовательский заголовок виджета ответа."

msgid "Required Field Question"
msgstr "Обязательный вопрос"

msgid "Set field question required."
msgstr "Настроить вопрос как обязательный."

msgid "Required Field Answer"
msgstr "Обязательный ответ"

msgid "Set field answer required ."
msgstr "Настроить ответ как обязательный."

msgid "Advanced settings"
msgstr "Расширенные настройки"

msgid "Question length"
msgstr "Длина вопроса"

msgid "Maximum length of questions (Between 1 and 255)."
msgstr "Максимальная длина вопросов (от 1 до 255)."

msgid "Question field size"
msgstr "Размер поля вопроса"

msgid "Width of the question widget."
msgstr "Ширина виджета вопроса."

msgid "Question widget"
msgstr "Виджет вопроса"

msgid "Fieldset"
msgstr "Fieldset"

msgid "Textarea, 1 row"
msgstr "Область текста, строка 1"

msgid "Textarea, 2 row"
msgstr "Область текста, строка 2"

msgid "Textarea, 3 row"
msgstr "Область текста, строка 3"

msgid "Textarea, 4 row"
msgstr "Область текста, строка 4"

msgid "Number of rows used for the question textfield/textarea."
msgstr "Число строк в текстовом поле (области текста) вопроса."

msgid "Answer rows"
msgstr "Строки ответа"

msgid "Number of rows used for the answer textarea."
msgstr "Число строк в области текста ответа."

msgid "Answer widget : @answer"
msgstr "Виджет ответа: @answer"

msgid "Answer widget title: @title"
msgstr "Заголовок виджета ответа: @title"

msgid "Question widget title: @title"
msgstr "Заголовок виджета вопроса: @title"

