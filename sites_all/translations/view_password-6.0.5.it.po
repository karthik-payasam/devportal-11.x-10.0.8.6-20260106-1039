msgid "About"
msgstr "Informazioni"

msgid "View Password module will help the user to see what password they entered."
msgstr "La visualizzazione del modulo Password aiuterà l'utente a verificare quale password ha immesso. "

msgid "Show password"
msgstr "Mostra password"

msgid "Hide password"
msgstr "Nascondi password"

msgid "View Password"
msgstr "Visualizza password "

msgid "Allows the users to see the contents of the password fields on selected forms before submission."
msgstr "Consente agli utenti di visualizzare i contenuti dei campi della password nei moduli selezionati prima dell'inoltro."

msgid "View Password Settings"
msgstr "Visualizza impostazioni password "

msgid "Lets you see password for the selected forms."
msgstr "Consente di verificare la password per i moduli selezionati "

msgid "Administer View password"
msgstr "Gestisci Visualizza password "

msgid "Configure the View password settings."
msgstr "Configura le impostazioni per Visualizza password "

msgid "View password config"
msgstr "Visualizza configurazione password "

msgid "Do not want to display the password for this forms."
msgstr "Non si desidera visualizzare la password per questi moduli. "

msgid "Enter the form id(s) here."
msgstr "Immettere qui gli ID form."

msgid "<p>Please enter the form id(s) by separating it with a comma (<em>make sure there are no spaces between form ids</em>). For example, the usual form ids are <code>user_login_form</code> and <code>user_register_form</code>. .</p>"
msgstr "<p>Immettere gli ID form separandoli con una virgola (<em>verificare che non vi siano spazi tra gli ID form</em>). Ad esempio, gli ID form usuali sono <code>user_login_form</code> e <code>user_register_form</code>. .</p>"

msgid "Enter the form class here."
msgstr "Immettere qui la classe del modulo."

msgid "Please enter the icon span classes separated with a space."
msgstr "Immettere le classi span dell'icona separate da spazi."

