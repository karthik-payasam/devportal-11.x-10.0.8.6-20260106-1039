msgid "IndexNow notification"
msgstr "IndexNow-melding"

msgid "IndexNow notification checkbox"
msgstr "Selectievakje IndexNow-melding"

msgid "Simple XML Sitemap IndexNow"
msgstr "Simple XML Sitemap IndexNow"

msgid "Verification key in Drupal State"
msgstr "Verificatiesleutel in Drupal State"

msgid "Verification key not available"
msgstr "Verificatiesleutel niet beschikbaar"

msgid "In order to generate a verification key for the IndexNow service and choose which sitemaps are to be submitted to search engines, visit <a href=\"@url\">this</a> configuration page."
msgstr "Om een verificatiesleutel voor de IndexNow-service te genereren en te kiezen welke sitemaps moeten worden ingediend bij zoekprogramma's, gaat u naar <a href=\"@url\">deze</a> configuratiepagina."

msgid "Simple XML Sitemap (Search engines)"
msgstr "Simple XML Sitemap (zoekmachines)"

msgid "Submits sitemaps to search engines and notifies IndexNow compatible engines about changes to entities."
msgstr "Dient sitemaps in bij zoekprogramma's en stelt met IndexNow compatibele programma's op de hoogte van wijzigingen in entiteiten."

msgid "SEO"
msgstr "SEO"

msgid "Search engines"
msgstr "Zoekmachines"

msgid "Status"
msgstr "Status"

msgid "Settings"
msgstr "Instellingen"

msgid "Index entity on save"
msgstr "Indexeer entiteit bij opslaan"

msgid "Allows optionally sending a change notice to IndexNow compatible search engines on entity form save."
msgstr "Maakt het mogelijk om optioneel een wijzigingsmelding te sturen naar met IndexNow compatibele zoekprogramma's bij het opslaan van het entiteitsformulier."

msgid "Simple XML Sitemap"
msgstr "Eenvoudige XML-sitemap"

msgid "Search engine"
msgstr "Zoekmachine"

msgid "Search engine ID"
msgstr "ID zoekmachine"

