msgid "Typed Data"
msgstr "Tipo de dados"

msgid "Extends the core Typed Data API with new APIs and features."
msgstr "Estende a API Tipo de Dados principal com novas APIs e recursos."

msgid "Missing arguments for filter %filter_id"
msgstr "Argumentos ausentes para o filtro %filter_id\\"

msgid "Entity machine names:"
msgstr "Nomes da máquina da entidade:"

msgid "Global context variables:"
msgstr "Variáveis de contexto global:"

msgid "Available TypedData data types:"
msgstr "Tipos de dados TypedData disponíveis:"

msgid "Text"
msgstr "Texto"

msgid "The count filter counts the number of characters in the input string."
msgstr "O filtro de contagem conta o número de caracteres na sequência de entrada."

msgid "Applies a default value if there is no value."
msgstr "Aplica um valor padrão se não houver nenhum valor."

msgid "Provides the URL of an entity."
msgstr "Fornece a URL de uma entidade."

msgid "Unkown date format %format given."
msgstr "Formato de data %format desconhecido fornecido."

msgid "If a custom date format is supplied, 'custom' must be passed as date format."
msgstr "Se um formato de data customizado for fornecido, 'custom' deverá ser transmitido como formato de data."

msgid "If 'custom' is given as date type, a custom date formatting string must be provided; e.g., 'Y-m-d H:i:s'."
msgstr "Se 'custom' for fornecido como tipo de data, uma sequência de formatação de data customizada deverá ser fornecida; por exemplo, 'Y-m-d H:i:s'."

msgid "Formats a date, using a configured date type or a custom date format string."
msgstr "Formata uma data utilizando um tipo de data configurado ou uma sequência de formatação de data customizada."

msgid "The format_text filter passes the text through the given filter."
msgstr "O filtro format_text passa o texto por meio do filtro fornecido."

msgid "Converts a string to lower case."
msgstr "Converte uma cadeia em minúsculas."

msgid "The replace filter replaces all occurrences of the text given in the first argument with the text given in the second argument."
msgstr "O filtro de substituição substitui todas as ocorrências do texto fornecido no primeiro argumento pelo texto fornecido no segundo argumento."

msgid "The striptags filter strips SGML/XML tags and replace adjacent whitespace by one space."
msgstr "O filtro striptags separa as tags SGML/XML e substitui os espaços em branco adjacentes por um espaço."

msgid "The trim filter removes whitespace from both the beginning and the end of an input string."
msgstr "O filtro de apara remove espaço em branco tanto do início quanto do fim de uma sequência de entrada."

msgid "The upper filter converts the entire input string to upper case."
msgstr "O filtro superior converte toda a sequência de entrada em letras maiúsculas."

msgid "No widget exists for this data type."
msgstr "Não há widgets para este tipo de dados."

msgid "The field %field_label consists of the data type %data_type which cannot be input or a widget for this data type is not implemented yet."
msgstr "O campo %field_label consiste no tipo de dados %data_type que não pode ser inserido ou ainda não há um widget implementado para esse tipo de dados."

msgid "Label"
msgstr "Rótulo"

msgid "Broken widget"
msgstr "Widget Interrompido"

msgid "A widget for everything that cannot be input or if a widget for a data type is not yet implemented."
msgstr "Um widget para tudo que não pode ser inserido ou caso um widget para um tipo de dados ainda não esteja implementado."

msgid "currently in daylight saving mode"
msgstr "Atualmente em modo de horário de verão"

msgid "not in daylight saving mode"
msgstr "Não no modo de horário de verão"

msgid "Timezone : %timezone %daylight_saving."
msgstr "Fuso horário : %timezone %daylight_saving."

msgid "Start date"
msgstr "Data inicial"

msgid "End date"
msgstr "Data final"

msgid "Description"
msgstr "Descrição"

msgid "The @title end date cannot be before the start date"
msgstr "A data de encerramento @title não pode ser anterior à data de início"

msgid "Datetime Range"
msgstr "Intervalo de data/hora"

msgid "A datetime range input widget, containing two datetime values, for the start and end of the range."
msgstr "Um widget de entrada de intervalo de data/hora, contendo dois valores de data/hora, para o início e o fim do intervalo."

msgid "Datetime"
msgstr "Data e hora"

msgid "A datetime input widget."
msgstr "Um widget de entrada de data/hora."

msgid "Empty option label"
msgstr "Etiqueta de Opção Vaz"

msgid "Allows overriding the label of the empty option"
msgstr "Permite substituir o rótulo da opção vazia"

msgid "Select"
msgstr "Selecionar"

msgid "A simple select box."
msgstr "Uma simples caixa de seleção."

msgid "Placeholder value"
msgstr "Valor do marcador"

msgid "Input field size"
msgstr "Tamanho do campo de entrada"

msgid "Maximum text length"
msgstr "Comprimento máximo do texto"

msgid "Text input"
msgstr "Entrada de Texto"

msgid "A simple, one-line text input widget."
msgstr "Um widget de entrada de texto simples de linha única."

msgid "Number of rows in the text box"
msgstr "Número de linhas na caixa de texto"

msgid "Number of columns in the text box"
msgstr "Número de colunas na caixa de texto"

msgid "Controls whether the text area is resizable"
msgstr "Controla se a área de texto é redimensionável"

msgid "Allowed values are \"none\", \"vertical\", \"horizontal\", or \"both\"."
msgstr "Os valores permitidos são \"nenhum\", \"vertical\", \"horizontal\" ou \"ambos\"."

msgid "Textarea"
msgstr "Caixa de texto"

msgid "A multi-line text input widget."
msgstr "Um widget de entrada de texto multilinhas."

