msgid "About"
msgstr "关于"

msgid "<a href=':crop'>Crop</a> provides basic API for image cropping. This module won't do much by itself. Users should pick one of UI modules that utilize this API.</a>"
msgstr "<a href=':crop'>裁切</a>为图像裁切提供基本 API。此模块本身不执行太多操作。用户应该选取利用此 API 的一个 UI 模块。</a>"

msgid "Configuration"
msgstr "配置"

msgid "This is API module. In order to crop your images you need a UI module. There are currently two UI modules that use Crop API:"
msgstr "这是 API 模块。为裁切图像，您需要一个 UI 模块。当前有两个 UI 模块使用裁切 API："

msgid "<a href=\":image_widget_crop\">Image widget crop</a>"
msgstr "<a href=\":image_widget_crop\">图像窗口小部件裁切</a>"

msgid "<a href=\":focal_point\">Focal point</a>"
msgstr "<a href=\":focal_point\">焦点</a>"

msgid "Technical details"
msgstr "技术详细信息"

msgid "Initial discussion can be found on <a href=\":manual\">manual crop issue queue</a>."
msgstr "可以在<a href=\":manual\">手动裁切问题队列</a>上找到初始讨论。"

msgid "Crop configuration"
msgstr "裁切配置"

msgid "There are no file or image fields on this bundle at the moment. In order to configure crop add at least one such field and come back."
msgstr "此时在此捆绑软件上没有文件或图像字段。为了配置裁切，请至少添加一个此类字段并返回。"

msgid "Image field"
msgstr "图像字段"

msgid "- Skip field -"
msgstr "- 跳过字段 -"

msgid "Select field that stores image which needs to be cropped."
msgstr "选择用于存储需裁切的图像的字段。"

msgid "Crop API"
msgstr "裁切 API"

msgid "This branch of Crop API is not compatible with the version of Media Entity installed."
msgstr "此裁切 API 的分支与已安装的媒体实体版本不兼容。"

msgid "Provides storage and API for image crops."
msgstr "提供存储和 API 以进行图像裁切。"

msgid "Media"
msgstr "媒体"

msgid "Add crop type"
msgstr "添加裁切类型"

msgid "Crop types"
msgstr "裁切类型"

msgid "Manage crop types."
msgstr "管理裁切类型。"

msgid "Administer crop settings"
msgstr "管理裁切设置"

msgid "Administer the basic settings for Crop API."
msgstr "管理裁切 API 的基本设置。"

msgid "Administer crop types"
msgstr "管理裁切类型"

msgid "Administer crop types."
msgstr "管理裁切类型。"

