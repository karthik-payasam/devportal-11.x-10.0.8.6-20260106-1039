msgid "Password Blacklist Policy"
msgstr "Política de lista de bloqueio de senha"

msgid "Create a blacklist of phrases that cannot be used in passwords."
msgstr "Crie uma lista de bloqueio de frases que não podem ser usadas em senhas."

msgid "Security"
msgstr "Security"

msgid "Blacklist"
msgstr "Lista de bloqueio"

msgid "Password"
msgstr "Senha"

msgid "Match substrings"
msgstr "Corresponder subsequências"

msgid "There are restricted terms in your password. Please modify your password."
msgstr "Há termos restritos em sua senha. Modifique sua senha."

msgid "Your password is on the blacklist. Please choose a different password."
msgstr "Sua senha está na lista de bloqueio. Escolha uma senha diferente."

msgid "Also disallow passwords containing blacklisted passwords"
msgstr "Desaprovar também senhas contendo senhas incluídas na lista de bloqueio"

msgid "Blacklisted passwords"
msgstr "Senhas incluídas na lista de bloqueio"

msgid "Password cannot be a member of this list, ignoring case. Enter one password per line."
msgstr "A senha não pode ser um membro desta lista, ignorando maiúsculas e minúsculas. Insira uma senha por linha."

msgid "Password must not contain any restricted words or phrases."
msgstr "A senha não deve conter palavras ou frases restritas."

msgid "Password must not be on the blacklist."
msgstr "A senha não deve estar na lista de bloqueio."

msgid "Password Blacklist"
msgstr "Lista de bloqueio de senha"

msgid "Password cannot match certain disallowed passwords"
msgstr "A senha não pode corresponder a determinadas senhas desaprovadas"

msgid "Your password contains restricted words or phrases."
msgstr "Sua senha contém palavras ou frases restritas."

