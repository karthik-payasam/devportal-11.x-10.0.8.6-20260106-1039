msgid "About"
msgstr "Acerca de"

msgid "The FAQ Field module defines a field for storing frequently asked questions, for use with the Field module. See the <a href=\":field_ui\">Field module help page</a> for more information about fields."
msgstr "El módulo FAQ Field define un campo para almacenar preguntas frecuentes, para utilizarlo con el módulo Field. Consulte la <a href=\":field_ui\">página de ayuda del módulo Field</a> para obtener más información sobre los campos."

msgid "FAQ Field"
msgstr "FAQ Field"

msgid "Provides a field for frequently asked questions."
msgstr "Proporciona un campo para las preguntas más frecuentes."

msgid "Field types"
msgstr "Tipos de campo"

msgid "FAQ Field jQuery Accordion format settings"
msgstr "Valores de formato de Acordeón jQuery de FAQ Field"

msgid "Index of active element starting from 0. Leave empty to display none at start."
msgstr "Índice de elemento activo a partir de 0. Dejar vacío para no visualizar ninguno al empezar."

msgid "Controls the height of the accordion and each panel."
msgstr "Controla la altura del acordeón y cada panel."

msgid "Whether an opened question can be collapsed (by the triggering event)."
msgstr "Si una pregunta abierta se puede contraer (por parte del suceso desencadenante)."

msgid "Event on which to trigger the accordion."
msgstr "Suceso en el que desencadenar el acordeón."

msgid "Animation options for the accordion formatter."
msgstr "Opciones de animación para el formateador de acordeón."

msgid "Name of easing to use when the event is triggered."
msgstr "Nombre de suavizado a utilizar cuando se desencadena el suceso."

msgid "Animation duration in milliseconds with the selected easing."
msgstr "Duración de animación en milisegundos con el suavizado seleccionado."

msgid "FAQ Field HTML anchor list format settings"
msgstr "Valores de formato de lista de anclaje HTML de FAQ Field"

msgid "The type of HTML list used for the anchor link list."
msgstr "El tipo de lista HTML utilizado para la lista de enlace de anclaje."

msgid "FAQ Field default widget settings"
msgstr "Valores de widget predeterminado de FAQ Field"

msgid "What form widget to use for answer input."
msgstr "Qué widget de formulario se puede utilizar para responder la entrada."

msgid "Custom title of question input."
msgstr "Título personalizado de la entrada de pregunta."

msgid "Custom title of answer input."
msgstr "Título personalizado de la entrada de respuesta."

msgid "Question field is required."
msgstr "El campo de pregunta es obligatorio."

msgid "Answer field is required."
msgstr "El campo de respuesta es obligatorio."

msgid "Advanced options of the FAQ Field default widget."
msgstr "Opciones avanzadas del widget predeterminado de FAQ Field."

msgid "Maximum length of questions."
msgstr "Longitud máxima de preguntas."

msgid "Size the question widget."
msgstr "Dimensionar el widget de pregunta."

msgid "Number of rows used for the question widget."
msgstr "Número de filas utilizado para el widget de pregunta."

msgid "Number of rows used for the answer widget."
msgstr "Número de filas utilizado para el widget de respuesta."

msgid "FAQ Field field settings"
msgstr "El campo de preguntas más frecuentes (FAQ) es obligatorio"

msgid "Default text format"
msgstr "Formato de texto predeterminado"

msgid "Default active"
msgstr "Activo predeterminado"

msgid "None"
msgstr "Ninguno"

msgid "Index of the active question starting from 0. If left empty and <em>Fully collapsible</em> is on, no question will be opened by default."
msgstr "Índice de la pregunta activa a partir de 0. Si se deja vacío y la opción <em>Completamente contraíble</em> está activada, no se abrirá ninguna pregunta de forma predeterminada."

msgid "Height style"
msgstr "Estilo de altura"

msgid "Auto : All panels will be set to the height of the tallest question."
msgstr "Automático: todos los paneles se establecerán en la altura de la pregunta más alta."

msgid "Fill : Expand to the available height based on the accordions question height."
msgstr "Relleno: expandir a la altura disponible según la altura de la pregunta del acordeón."

msgid "Content : Each panel will be only as tall as its question."
msgstr "Contenido: cada panel solo será tan alto como la pregunta correspondiente."

msgid "Fully collapsible"
msgstr "Completamente contraíble"

msgid "Whether all the questions can be closed at once. Allows collapsing the active section."
msgstr "Si todas las preguntas se pueden cerrar a la vez. Permite contraer la sección activa."

msgid "Event"
msgstr "Evento"

msgid "The event on which to open a question. Multiple events can be specified, separated by a space."
msgstr "El suceso sobre el que abrir una pregunta. Se pueden especificar varios sucesos, separados por un espacio."

msgid "Animation settings"
msgstr "Valores de animación"

msgid "Duration"
msgstr "Duración"

msgid "Easing"
msgstr "Suavizado"

msgid "Name of <a href=\"@link\">easing</a> to use when the event is triggered."
msgstr "Nombre de un <a href=\"@link\">suavizado</a> a utilizar cuando se desencadena el suceso."

msgid "Default active: @element"
msgstr "Activo predeterminado: @element"

msgid "Auto"
msgstr "Automático"

msgid "Fill"
msgstr "Relleno"

msgid "Content"
msgstr "Contenido"

msgid "Height style : @style"
msgstr "Estilo de altura: @style"

msgid "Event: @event"
msgstr "Suceso: @event"

msgid "jQuery Accordion"
msgstr "Acordeón jQuery"

msgid "Anchor link list type"
msgstr "Tipo de lista de enlaces de anclaje"

msgid "<ul> - Bullet list"
msgstr "<ul> - Lista de viñetas"

msgid "<ol> - Numeric list"
msgstr "<ol> - Lista numérica"

msgid "Bullet list"
msgstr "Lista con viñetas"

msgid "Numeric list"
msgstr "Lista numérica"

msgid "HTML anchor list"
msgstr "Lista de anclajes HTML"

msgid "HTML definition list"
msgstr "Lista de definiciones HTML"

msgid "HTML details"
msgstr "Detalles de HTML"

msgid "Simple text"
msgstr "Texto sencillo"

msgid "Question value"
msgstr "Valor de pregunta"

msgid "Answer value"
msgstr "Valor de respuesta"

msgid "Answer text format"
msgstr "Formato de texto de respuesta"

msgid "Default text format to filter FAQ field answer content."
msgstr "Formato de texto predeterminado para filtrar contenido de respuesta de campo de preguntas más frecuentes"

msgid "Question"
msgstr "Pregunta"

msgid "Answer"
msgstr "Respuesta"

msgid "Answer widget"
msgstr "Widget de respuesta"

msgid "Textarea"
msgstr "Área de texto"

msgid "Formatable textarea"
msgstr "Área de texto formateable"

msgid "Textfield"
msgstr "Campo de texto"

msgid "What form widget to use for answer input. Formatable textarea is needed for WYSIWYG editors."
msgstr "Qué widget de formulario se va a utilizar para la entrada de respuesta. Se necesita un área de texto formateable para editores de estilo lo que se ve es lo que se obtiene."

msgid "Question widget title"
msgstr "Título de widget de pregunta"

msgid "Custom title of question widget."
msgstr "Título personalizado del widget de pregunta."

msgid "Answer widget title"
msgstr "Título de widget de respuesta"

msgid "Custom title of answer widget."
msgstr "Título personalizado de widget de respuesta."

msgid "Required Field Question"
msgstr "Campo de pregunta obligatorio"

msgid "Set field question required."
msgstr "Establecer campo de pregunta como obligatorio."

msgid "Required Field Answer"
msgstr "Campo de respuesta obligatorio"

msgid "Set field answer required ."
msgstr "Establecer campo de respuesta como obligatorio."

msgid "Advanced settings"
msgstr "Opciones avanzadas"

msgid "Question length"
msgstr "Longitud de pregunta"

msgid "Maximum length of questions (Between 1 and 255)."
msgstr "Longitud máxima de preguntas (entre 1 y 255)."

msgid "Question field size"
msgstr "Tamaño de campo de pregunta"

msgid "Width of the question widget."
msgstr "Anchura del widget de pregunta."

msgid "Question widget"
msgstr "Widget de pregunta"

msgid "Fieldset"
msgstr "Conjunto de campos"

msgid "Textarea, 1 row"
msgstr "Área de texto, 1 fila"

msgid "Textarea, 2 row"
msgstr "Área de texto, 2 fila"

msgid "Textarea, 3 row"
msgstr "Área de texto, 3 fila"

msgid "Textarea, 4 row"
msgstr "Área de texto, 4 fila"

msgid "Number of rows used for the question textfield/textarea."
msgstr "Número de filas utilizadas para la campo de texto/área de texto de la pregunta."

msgid "Answer rows"
msgstr "Filas de respuesta"

msgid "Number of rows used for the answer textarea."
msgstr "Número de filas utilizado para el área de texto de respuesta."

msgid "Answer widget : @answer"
msgstr "Widget de respuesta: @answer"

msgid "Answer widget title: @title"
msgstr "Título de widget de respuesta: @title"

msgid "Question widget title: @title"
msgstr "Título de widget de pregunta: @title"

