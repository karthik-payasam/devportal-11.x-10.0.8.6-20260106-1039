msgstr "Fornece um filtro para incluir rel=\"noopener\" em links externos e links no ckeditor."

msgid "Noopener filter settings"
msgstr "Configurações de filtro do Noopener"

msgid "Change settings for noopener filter"
msgstr "Mudar configurações para o filtro noopener"

msgid "Administer Noopener filter"
msgstr "Administrar filtro Noopener"

msgid "Enables the ability to change the noopener filter settings."
msgstr "Ativa a capacidade de mudar as configurações de filtro noopener."

msgid "Settings for Noopener filter"
msgstr "Configurações para o filtro Noopener"

msgid "Noopener"
msgstr "Noopener"

msgid "Filter links"
msgstr "Filtrar links"

msgid "Filter links through alter link hook."
msgstr "Filtrar links por meio do ganho de link de alteração."

msgid "Save"
msgstr "Salvar"

msgid "Add noopener to all links"
msgstr "Incluir noopener em todos os links"

