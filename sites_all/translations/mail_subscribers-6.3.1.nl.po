msgstr "E-mailbericht voor mailabonnees"

msgid "Tokens for Mail Subscribers e-mail message."
msgstr "Tokens voor e-mailbericht voor mailabonnees."

msgid "Sent @current of @total messages."
msgstr "@current van @total berichten zijn verzonden."

msgid "Sent email to owners subscribing to product %product"
msgstr "E-mail is verzonden naar eigenaren die een abonnement op product %product hebben"

msgid "Sent email to members subscribing to product %product"
msgstr "E-mail is verzonden naar leden die een abonnement op product %product hebben"

msgid "Sent email to owners subscribing to API %api"
msgstr "E-mail is verzonden naar eigenaren die een abonnement op API %api hebben"

msgid "Sent email to members subscribing to API %api"
msgstr "E-mail is verzonden naar leden die een abonnement op API %api hebben"

msgid "Sent email to all consumer organization owners"
msgstr "E-mail is verzonden naar alle eigenaren van een consumentorganisatie"

msgid "Sent email to all consumer organization members"
msgstr "E-mail is verzonden naar alle leden van een consumentorganisatie"

msgid "Did not find a user object for the recipient @to.  Any user tokens in the message subject or body will not be substituted"
msgstr "Geen gebruikersobject gevonden voor de ontvanger @to. Gebruikerstokens in het berichtonderwerp of de lopende tekst worden niet vervangen."

msgid "Did not find a plan with the name @plan in the product @product"
msgstr "Geen plan gevonden met de naam @plan in het product @product"

