msgid "Password Policy History"
msgstr "Strategia dotycząca historii haseł"

msgid "Sets up a password constraint to limit repeated use of the same password."
msgstr "Konfiguruje ograniczenie dotyczące powtórnego użycia tego samego hasła."

msgid "Security"
msgstr "Zabezpieczenia"

msgid "Previous passwords cannot be reused. Choose a different password."
msgstr "Poprzednie hasła nie mogą być ponownie wykorzystywane. Wybierz inne hasło."

msgid "Number of passwords that will be checked in the user password update history"
msgstr "Liczba haseł, które będą sprawdzane w historii aktualizacji haseł użytkownika"

msgid "A value of 0 represents that the user can not repeat any of the old passwords."
msgstr "Wartość 0 oznacza, że użytkownik nie może ponownie wykorzystać żadnego starego hasła."

msgid "The number of repeated passwords value must be zero or greater."
msgstr "Liczba powtórzonych haseł musi wynosić zero lub więcej."

msgid "Number of passwords that will be checked in the user password update history: @number-repeats"
msgstr "Liczba haseł, które będą sprawdzane w historii aktualizacji haseł użytkownika: @number-repeats"

msgid "The last @count password cannot be reused. Choose a different password."
msgid_plural "The last @count passwords cannot be reused. Choose a different password."
msgstr[0] "Nie można ponownie wykorzystać następującej liczby ostatnich haseł: @count. Wybierz inne hasło."
msgstr[1] "Nie można ponownie wykorzystać następującej liczby ostatnich haseł: @count. Wybierz inne hasło."
msgstr[2] "Nie można ponownie wykorzystać następującej liczby ostatnich haseł: @count. Wybierz inne hasło."

msgid "Password History"
msgstr "Historia haseł"

msgid "Provide restrictions on previously used passwords."
msgstr "Podaj ograniczenia dotyczące wcześniej używanych haseł."

msgid "You have used the same password previously and cannot."
msgstr "To samo hasło było już wcześniej używane i nie można go użyć ponownie."

