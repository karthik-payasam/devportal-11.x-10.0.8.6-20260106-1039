msgid "About"
msgstr "Über"

msgid "Drupal Proxy Module"
msgstr "Drupal-Proxy-Modul"

msgid "Drupal Proxy"
msgstr "Drupal-Proxy"

msgid "Proxy"
msgstr "Vertretung"

msgid "Proxy Settings"
msgstr "Proxy-Einstellungen"

msgid "ProxySettingForm"
msgstr "ProxySettingForm"

msgid "Https or Https"
msgstr "Https oder Https"

msgid "type of Scheme"
msgstr "Schema-Typ"

msgid "Proxy Server"
msgstr "Proxy-Server"

msgid "The IP address or hostname of the proxy server."
msgstr "Die IP-Adresse oder der Hostname des Proxy-Servers."

msgid "Port"
msgstr "Port"

msgid "The port number used by the proxy server for client connections."
msgstr "Die Portnummer, die der Proxy-Server für Clientverbindungen verwendet."

msgid "Proxy Username"
msgstr "Proxy-Benutzername"

msgid "A username used of proxy server for Authentication."
msgstr "Ein Benutzername, den der Proxy-Server für die Authentifizierung verwendet."

msgid "Proxy Password"
msgstr "Proxy-Passwort"

msgid "Password of proxy server used for Authentication."
msgstr "Ein Kennwort, das der Proxy-Server für die Authentifizierung verwendet."

msgid "Proxy User Agent"
msgstr "Proxy-Benutzeragent"

msgid "A string which can be used by the proxy server to identify connection requests."
msgstr "Eine Zeichenfolge, die der Proxy-Server zum Identifizieren von Verbindungsanforderungen verwenden kann."

msgid "Proxy Exceptions"
msgstr "Proxy-Ausnahmen"

msgid "Specify exceptions using either IP addresses or hostnames. Enter one exception per line. Exceptions will be accessed directly, not via proxy."
msgstr "Geben Sie Ausnahmen über IP-Adressen oder Hostnamen an. Geben Sie jeweils eine Ausnahme pro Zeile ein. Der Zugriff auf Ausnahmen erfolgt direkt, nicht über den Proxy."

