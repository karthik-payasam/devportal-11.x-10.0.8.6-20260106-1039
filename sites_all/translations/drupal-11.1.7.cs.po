msgstr "Textové formáty"

msgid "Forum"
msgstr "Fórum"

msgid "Forum content"
msgstr "Obsah fóra"

msgid "The content ID of the forum index entry."
msgstr "ID obsahu položky indexu fóra."

msgid "The content title."
msgstr "Nadpis obsahu"

msgid "Has taxonomy term ID"
msgstr "Má ID taxonomického termínu"

msgid "Display content if it has the selected taxonomy terms."
msgstr "Zobrazte obsah, pokud má vybrané taxonomické termíny."

msgid "Uncategorized"
msgstr "Nezařazeno"

msgid "Has taxonomy term"
msgstr "Má taxonomický termín"

msgid "Term"
msgstr "Termín"

msgid "The date the content was posted."
msgstr "Datum odeslání obsahu."

