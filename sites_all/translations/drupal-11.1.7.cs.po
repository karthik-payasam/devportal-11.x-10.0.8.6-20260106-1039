msgstr "Nelze načíst vzdálenou adresu URL (@url)."

msgid "oEmbed content"
msgstr "Obsah oEmbed"

msgid "You can link to media from the following services: @providers"
msgstr "Na média můžete odkazovat z následujících služeb: @providers"

msgid "oEmbed URL"
msgstr "Adresa URL oEmbed"

msgid "Default view mode"
msgstr "Výchozí režim zobrazení"

msgid "The view mode that an embedded media item should be displayed in by default. This can be overridden using the <code>data-view-mode</code> attribute."
msgstr "Režim zobrazení, ve kterém by měla být standardně zobrazena vložená položka média. Může být přepsána pomocí atributu <code>data-view-mode</code>."

msgid "If none are selected, all will be allowed."
msgstr "Není-li vybrána žádná volba, budou povoleny všechny."

msgid "View modes selectable in the 'Edit media' dialog"
msgstr "Volitelné režimy zobrazení v dialogovém okně 'Upravit média'"

msgid "If two or more view modes are selected, users will be able to update the view mode that an embedded media item should be displayed in after it has been embedded.  If less than two view modes are selected, media will be embedded using the default view mode and no view mode options will appear after a media item has been embedded."
msgstr "Jsou-li vybrány dva nebo více režimů zobrazení, uživatelé budou moci aktualizovat režim zobrazení, ve kterém by se vložená položka média měla zobrazit poté, co byla vložena. Jsou-li vybrány méně než dva režimy zobrazení, média budou vložena s použitím výchozího režimu zobrazení a po vložení položky média se nezobrazí žádné volby režimu zobrazení."

msgid "The referenced media source is missing and needs to be re-embedded."
msgstr "Chybí odkazovaný zdroj média a musí být znovu vložen."

msgid ""
"\n"
"      <p>You can embed media items:</p>\n"
"      <ul>\n"
"        <li>Choose which media item to embed: <code>&lt;drupal-media data-entity-uuid=\"07bf3a2e-1941-4a44-9b02-2d1d7a41ec0e\" /&gt;</code></li>\n"
"        <li>Optionally also choose a view mode: <code>data-view-mode=\"tiny_embed\"</code>, otherwise the default view mode is used.</li>\n"
"        <li>The <code>data-entity-type=\"media\"</code> attribute is required for consistency.</li>\n"
"      </ul>"
msgstr ""
"\n"
"      <p>Můžete vložit položky médií:</p>\n"
"      <ul>\n"
"        <li>Vyberte, které položka média se má vložit: <code>&lt;drupal-media data-entity-uuid=\"07bf3a2e-1941-4a44-9b02-2d1d7a41ec0e\" /&gt;</code></li>\n"
"        <li>Volitelně můžete také vybrat režim zobrazení: <code>data-view-mode=\"tiny_embed\"</code>, jinak se použije výchozí režim zobrazení.</li>\n"
"        <li>Atribut <code>data-entity-type=\"media\"</code> je vyžadován pro konzistenci.</li>\n"
"      </ul>"

msgid "You can embed media items (using the <code>&lt;drupal-media&gt;</code> tag)."
msgstr "Položky médií můžete vložit (pomocí značky <code>&lt;drupal-media&gt;</code>)."

msgid "During rendering of embedded media: recursive rendering detected for %entity_id. Aborting rendering."
msgstr "Během vykreslování vloženého média: bylo nalezeno rekurzivní vykreslení pro %entity_id. Vykreslení bylo předčasně ukončeno."

msgid "During rendering of embedded media: the media item with UUID \"@uuid\" does not exist."
msgstr "Během vykreslení vloženého média: položka média s UUID \"@uuid\" neexistuje."

