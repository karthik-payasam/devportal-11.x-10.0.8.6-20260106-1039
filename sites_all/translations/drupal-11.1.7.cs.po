msgid "Boolean indicating whether the translation is published (visible to non-administrators)."
msgstr "Logická hodnota označující, zda je překlad publikován (viditelný pro neadministrátory)."

msgid "A boolean indicating whether this translation needs to be updated."
msgstr "Logická hodnota označující, zda tento překlad vyžaduje aktualizaci."

msgid "The Unix timestamp when the translation was created."
msgstr "Časové razítko formátu Unix, kdy byl překlad vytvořen."

msgid "The Unix timestamp when the translation was most recently saved."
msgstr "Časové razítko formátu Unix, kdy byl překlad naposledy uložen."

msgid "No user"
msgstr "Žádný uživatel"

msgctxt "Sort order"
msgid "Numerical"
msgstr "Číselná hodnota"

msgid "Show the comment link in the form used on standard entity teasers, rather than the full entity form."
msgstr "Zobrazte odkaz na komentář ve formuláři, který se používá ve standardním teaseru entity, spíše než ve formuláři úplné entity."

msgid "Enable to override this field's links."
