msgstr "slovníky"

msgid "You can reorganize the terms in %capital_name using their drag-and-drop handles, and group terms under a parent term by sliding them under and to the right of the parent."
msgstr "Termíny v %capital_name můžete uspořádat pomocí drag-and-drop (táhni-a-pusť) rozhraní. Termíny můžete seskupit pod rodičovský termín tak, že myší uchopíte řádku s termínem za úchyt a přetáhnete ji pod něj a posunete směrem doprava."

msgid "%capital_name contains terms grouped under parent terms. You can reorganize the terms in %capital_name using their drag-and-drop handles."
msgstr "%capital_name obsahuje termíny seskupené pod rodičovskými termíny. Můžete je přeuspořádat pomocí drag-and-drop (táhni-a-pusť) rozhraní."

msgid "%capital_name contains terms with multiple parents. Drag and drop of terms with multiple parents is not supported, but you can re-enable drag-and-drop support by editing each term to include only a single parent."
msgstr "%capital_name obsahuje termíny s více rodiči. Rozhraní drag-and-drop (táhni-a-pusť) není pro tyto termíny podporováno. Jestliže chcete obnovit drag-and-drop podporu, upravte každý termín tak, aby měl pouze jednoho rodiče."

msgid "%capital_name contains the following terms."
msgstr "%capital_name obsahuje následující termíny."

msgid "%capital_name contains terms grouped under parent terms"
msgstr "%capital_name obsahuje termíny seskupené pod nadřízené termíny"

msgid "%capital_name contains terms with multiple parents."
msgstr "%capital_name obsahuje termíny s více nadřízenými prvky."

msgid "No terms available. <a href=\":link\">Add term</a>."
msgstr "Žádné termíny nejsou k dispozici. <a href=\":link\">Přidat termín</a>."

msgid "No terms available."
msgstr "Nejsou k dispozici termíny."

msgid "Weight for added term"
msgstr "Váha pro přidaný termín"

msgid "Reset to alphabetical"
msgstr "Vrátit do abecedního řazení"

msgid "The terms with updated parents have been modified by another user, the changes could not be saved."
msgstr "Termíny s aktualizovanými nadřízenými prvky byly upraveny jiným uživatelem, změny se nepodařilo uložit."

msgid "%capital_name contains 1 term with pending revisions. Drag and drop of terms with pending revisions is not supported, but you can re-enable drag-and-drop support by getting each term to a published state."
msgid_plural "%capital_name contains @count terms with pending revisions. Drag and drop of terms with pending revisions is not supported, but you can re-enable drag-and-drop support by getting each term to a published state."
msgstr[0] "%capital_name  obsahuje 1 termín s nevyřízenými revizemi. Přetažení termínů s nevyřízenými revizemi pomocí myši není podporováno, můžete ale podporu přetahování pomocí myši znovu povolit nastavením jednotlivých termínů do publikovaného stavu."
msgstr[1] "%capital_name obsahuje @count termínů s nevyřízenými revizemi. Přetažení termínů s nevyřízenými revizemi pomocí myši není podporováno, můžete ale podporu přetahování pomocí myši znovu povolit nastavením jednotlivých termínů do publikovaného stavu."
msgstr[2] "%capital_name obsahuje @count termínů s nevyřízenými revizemi. Přetažení termínů s nevyřízenými revizemi pomocí myši není podporováno, můžete ale podporu přetahování pomocí myši znovu povolit nastavením jednotlivých termínů do publikovaného stavu."

msgid "Deleting a term will delete all its children if there are any. This action cannot be undone."
msgstr "Při odstranění termínu se odstraní i všechny podřízené termíny. Tuto akci nelze vrátit zpět."

msgid "Deleted term %name."
msgstr "Smazán termín %name."

msgid "Are you sure you want to delete the vocabulary %title?"
msgstr "Opravdu odstranit slovník %title?"

msgid "Deleting a vocabulary will delete all the terms in it. This action cannot be undone."
msgstr "Při odstranění slovníku se odstraní také všechny termíny v něm. Tuto akci nelze vrátit zpět."

msgid "Deleted vocabulary %name."
msgstr "Slovník %name smazán."

msgid "Are you sure you want to reset the vocabulary %title to alphabetical order?"
msgstr "Opravdu vrátit slovník %title do abecedního pořadí?"

msgid "Resetting a vocabulary will discard all custom ordering and sort items alphabetically."
msgstr "Vrácení slovníku do abecedního pořadí zruší všechno vlastní seřazení a seřadí položky podle abecedy."

msgid "Reset vocabulary %name to alphabetical order."
msgstr "Vrátit slovník %name do abecedního pořadí."

msgid "Taxonomy Term selection"
msgstr "Výběr termínu taxonomie"

msgid "RSS category"
msgstr "kategorie RSS"

msgid "Display reference to taxonomy term in RSS."
msgstr "Zobrazte odkaz na taxonomický termín v RSS."

msgctxt "Validation"
msgid "Taxonomy term hierarchy."
msgstr "Hierarchie taxonomických termínů."

msgid "You can only change the hierarchy for the <em>published</em> version of this term."
msgstr "Hierarchii můžete změnit pouze pro <em>publikovanou</em> verzi tohoto termínu."

msgid "Existing term VID"
msgstr "Existující VID termínu"

msgid "The name of the term."
msgstr "Název termínu."

msgid "The term description."
msgstr "Popis termínu."

msgid "The Drupal term IDs of the term's parents."
msgstr "ID termínu Drupal nadřízených prvků termínu."

msgid "The term language."
msgstr "Jazyk termínu."

msgid "Translation ID."
msgstr "ID překladu."

msgid "Language for this term."
msgstr "Jazyk pro tento termín."

msgid "Term name translation."
msgstr "Překlad názvu termínu."

msgid "Term description translation."
msgstr "Překlad popisu termínu."

msgid "The node revision ID."
msgstr "ID revize uzlu."

msgid "The name of the vocabulary."
msgstr "Název slovníku."

msgid "The description of the vocabulary."
msgstr "Popis slovníku."

msgid "Help text to display for the vocabulary."
msgstr "Text nápovědy pro slovník."

msgid "Whether or not related terms are enabled within the vocabulary. (0 = disabled, 1 = enabled)"
msgstr "Zda jsou ve slovníku povolené příbuzné termíny (0 = nepovolené, 1 = povolené)"

msgid "The type of hierarchy allowed within the vocabulary. (0 = disabled, 1 = single, 2 = multiple)"
msgstr "Typ hierarchie, která je ve slovníku povolená. (0 = nepovolená, 1 = jedinečná, 2 = vícenásobná)"

msgid "Whether or not multiple terms from this vocabulary may be assigned to a node. (0 = disabled, 1 = enabled)"
msgstr "Zda z tohoto slovníku může být k uzlu přiřazeno více termínů (0 = nepovoleno, 1 = povoleno)"

msgid "Whether or not terms are required for nodes using this vocabulary. (0 = disabled, 1 = enabled)"
msgstr "Zda existují pro uzly používající tento slovník povinné termíny (0 = neexistují, 1 = existují)"

msgid "Whether or not free tagging is enabled for the vocabulary. (0 = disabled, 1 = enabled)"
msgstr "Zda je ve slovníku povoleno volné značení (0 = nepovoleno, 1 = povoleno)"

msgid "The weight of the vocabulary in relation to other vocabularies."
msgstr "Váha slovníky ve vztahu k ostatním slovníkům."

msgid "The names of the node types the vocabulary may be used with."
msgstr "Názvy typů uzlů, se kterými se může slovník používat."

msgid "Name of property being translated."
msgstr "Název překládané vlastnosti."

msgid "Vocabulary machine name"
msgstr "Název počítače slovníku"

msgid "Format of the term description."
msgstr "Formátujte popis termínu."

msgid "Module responsible for the vocabulary."
msgstr "Modul zodpovědný za slovník."

msgid "Unique machine name of the vocabulary."
msgstr "Jedinečný název počítače slovníku."

msgid "Internationalization mode."
msgstr "Režim internacionalizace."

msgid "Language from the taxonomy_vocabulary table."
msgstr "Jazyk z tabulky taxonomického slovníku."

msgid "Translation of either the name or the description."
msgstr "Překlad názvu nebo popisu."

msgid "Language code from locales_target table"
msgstr "Kód jazyka z tabulky locales_target"

msgid "The depth will match nodes tagged with terms in the hierarchy. For example, if you have the term \"fruit\" and a child term \"apple\", with a depth of 1 (or higher) then filtering for the term \"fruit\" will get nodes that are tagged with \"apple\" as well as \"fruit\". If negative, the reverse is true; searching for \"apple\" will also pick up nodes tagged with \"fruit\" if depth is -1 (or lower)."
msgstr "Hloubka se bude shodovat s uzly označenými výrazy v hierarchii. Máte-li například termín \"ovoce\" a podřízený termín \"jablko\" s hloubkou 1 (nebo vyšší), potom filtrování pro termín \"ovoce\" získá uzly označené \"jablko\" jako \"ovoce\". Je-li hloubka záporná, je pravý opak; vyhledávání slova \"jablko\" rovněž vyzvedne uzly označené slovem \"ovoce\", je-li hloubka -1 (nebo nižší)."

msgid "If selected, users can enter multiple values in the form of 1+2+3. Due to the number of JOINs it would require, AND will be treated as OR with this filter."
msgstr "Při výběru mohou uživatelé zadat více hodnot ve formátu 1+2+3. Protože může být zapotřebí provádět více spojení JOIN, bude se v tomto filtru s operátorem AND zacházet jako s operátorem OR."

msgid "No name"
msgstr "Beze jména"

msgid "No vocabulary"
msgstr "Žádný slovník"

msgid "Filter to items that share all terms"
msgstr "Filtrovat na položky, které sdílejí všechny termíny"

msgid "Filter to items that share any term"
msgstr "Filtrovat na položky, které sdílejí libovolný termín"

msgid "Taxonomy term name"
msgstr "Název taxonomického termínu"

msgid "The taxonomy term ID for the term."
msgstr "ID termínu taxonomie pro termín."

msgid "The taxonomy term name for the term."
msgstr "Název termínu taxonomie pro termín."

msgid "The machine name for the vocabulary the term belongs to."
msgstr "Název počítače pro slovník, do kterého termín patří."

msgid "The name for the vocabulary the term belongs to."
msgstr "Jméno slovníku, do kterého termín patří."

msgid "Select which vocabulary to show terms for in the regular options."
msgstr "Vyberte, ve kterém slovníku se mají zobrazovat termíny v pravidelných volbách."

msgid "Dropdown"
msgstr "Rozevírací"

msgid "An invalid vocabulary is selected. Please change it in the options."
msgstr "Je vybrán neplatný slovník. Změňte jej ve volbách."

msgid "Select terms from vocabulary @voc"
msgstr "Vybrané termíny ze slovníku @voc"

msgid "Select terms"
msgstr "Vybrané termíny"

msgid "Leave blank for all. Otherwise, the first selected term will be the default instead of \"Any\"."
msgstr "Ponechte pole prázdné pro všechny. Jinak bude první vybraný termín výchozí namísto \"Libovolný\"."

msgid "Is one of"
msgstr "Jeden z"

msgid "Choose which vocabularies you wish to relate. Remember that every term found will create a new record, so this relationship is best used on just one vocabulary that has only one term per node."
msgstr "Vyberte slovníky, které chcete dát do souvislosti. Pamatujte na to, že každý nalezený termín vytvoří nový záznam, takže tento vztah se nejlépe použije pouze na jeden slovník, který má pouze jeden termín na uzel."

msgid "The Telephone module allows you to create fields that contain telephone numbers. See the <a href=\":field\">Field module help</a> and the <a href=\":field_ui\">Field UI help</a> pages for general information on fields and how to create and manage them. For more information, see the <a href=\":telephone_documentation\">online documentation for the Telephone module</a>."
msgstr "Modul Telefon vám umožňuje vytvářet pole, která obsahují telefonní čísla. Viz stránky <a href=\":field\">nápovědy modulu Pole</a> a <a href=\":field_ui\">nápovědy uživatelského rozhraní pole</a>, kde naleznete obecné informace k polím a jak je vytvořit a spravovat. Další informace viz <a href=\":telephone_documentation\">dokumentace online pro modul Telefon</a>."

msgid "Managing and displaying telephone fields"
msgstr "Správa a zobrazení polí telefonu"

msgid "The <em>settings</em> and the <em>display</em> of the telephone field can be configured separately. See the <a href=\":field_ui\">Field UI help</a> for more information on how to manage fields and their display."
msgstr "<em>Nastavení</em> a <em>zobrazení</em> pole Telefon lze konfigurovat samostatně. Další informace, jak spravovat pole a jejich zobrazení viz <a href=\":field_ui\">nápověda uživatelského rozhraní pole</a>."

msgid "Displaying telephone numbers as links"
msgstr "Zobrazení telefonních čísel jako odkazů"

msgid "Telephone numbers can be displayed as links with the scheme name <em>tel:</em> by choosing the <em>Telephone</em> display format on the <em>Manage display</em> page. Any spaces will be stripped out of the link text. This semantic markup improves the user experience on mobile and assistive technology devices."
msgstr "Telefonní čísla lze zobrazit jako odkazy s názvem schématu <em>tel:</em> zvolením formátu zobrazení <em>Telefon</em> na stránce <em>Spravovat zobrazení</em>. Všechny mezery budou odstraněny z textu odkazu. Tento sémantický markup zlepšuje uživatelské zkušenosti na mobilních zařízeních a zařízeních s podpůrnou technologií."

msgid "Telephone"
msgstr "Telefon"

msgid "Defines a field type for telephone numbers."
msgstr "Definuje typ pole pro telefonní čísla."

msgid "Telephone link format settings"
msgstr "Nastavení formátu telefonní linky"

msgid "Title to replace basic numeric telephone number display"
msgstr "Titulek pro nahrazení základního numerického telefonního čísla"

msgid "Telephone default format settings"
msgstr "Výchozí nastavení formátu telefonu"

msgid "Link using text: @title"
msgstr "Propojit pomocí textu: @title"

msgid "Link using provided telephone number."
msgstr "Propojte se pomocí poskytnutého telefonního čísla."

msgid "Telephone link"
msgstr "Telefonní linka"

msgid "%name: the telephone number may not be longer than @max characters."
msgstr "%name: Telefonní číslo nesmí být delší než @max znaků."

msgid "Telephone number"
msgstr "Telefonní číslo"

msgid "This field stores a telephone number in the database."
msgstr "Toto pole ukládá telefonní číslo do databáze."

msgid "The Text module allows you to create short and long text fields with optional summaries. See the <a href=\":field\">Field module help</a> and the <a href=\":field_ui\">Field UI help</a> pages for general information on fields and how to create and manage them. For more information, see the <a href=\":text_documentation\">online documentation for the Text module</a>."
msgstr "Modul Text vám umožňuje vytvářet krátká a dlouhá textová pole s volitelnými souhrny. Viz stránky <a href=\":field\">nápovědy modulu Pole</a> a <a href=\":field_ui\">nápovědy uživatelského rozhraní pole</a>, kde naleznete obecné informace k polím a jak je vytvořit a spravovat. Další informace viz <a href=\":text_documentation\">dokumentace online pro modul Text</a>."

msgid "Managing and displaying text fields"
msgstr "Správa a zobrazení textových polí"

msgid "The <em>settings</em> and <em>display</em> of the text field can be configured separately. See the <a href=\":field_ui\">Field UI help</a> for more information on how to manage fields and their display."
msgstr "<em>Nastavení</em> a <em>zobrazení</em> textového pole lze konfigurovat samostatně. Další informace, jak spravovat pole a jejich zobrazení viz <a href=\":field_ui\">nápověda uživatelského rozhraní pole</a>."

msgid "Creating short text fields"
msgstr "Vytvoření krátkých textových polí"

msgid "If you choose <em>Text (plain)</em> or <em>Text (formatted)</em> as the field type on the <em>Manage fields</em> page, then a field with a single row is displayed. You can change the maximum text length in the <em>Field settings</em> when you set up the field."
msgstr "Zvolíte-li jako typ pole na stránce <em>Spravovat pole</em> <em>Text (prostý)</em> nebo <em>Text (formátovaný)</em>, zobrazí se pole s jedním řádkem. Maximální délku textu můžete změnit v poli <em>Nastavení pole</em>, když nastavujete pole."

msgid "Creating long text fields"
msgstr "Vytvoření dlouhých textových polí"

msgid "If you choose <em>Text (plain, long)</em>, <em>Text (formatted, long)</em>, or <em>Text (formatted, long, with summary)</em> on the <em>Manage fields</em> page, then users can insert text of unlimited length. On the <em>Manage form display</em> page, you can set the number of rows that are displayed to users."
msgstr "Zvolíte-li na stránce <em>Spravovat pole</em> <em>Text (prostý, dlouhý)</em>, <em>Text (formátovaný, dlouhý)</em> nebo <em>Text (formátovaný, dlouhý, se souhrnem)</em>, mohou uživatelé vkládat text s neomezenou délkou. Na stránce <em>Spravovat zobrazení formuláře</em> můžete nastavit počet řádků, které se zobrazí uživatelům."

msgid "Trimming the text length"
msgstr "Oříznutí délky textu"

msgid "On the <em>Manage display</em> page you can choose to display a trimmed version of the text, and if so, where to cut off the text."
msgstr "Na stránce <em>Spravovat zobrazení</em> můžete zvolit zobrazení oříznuté verze textu a případně v jakém místě textu má k oříznutí dojít."

msgid "Displaying summaries instead of trimmed text"
msgstr "Zobrazení souhrnů namísto oříznutého textu"

msgid "As an alternative to using a trimmed version of the text, you can enter a separate summary by choosing the <em>Text (formatted, long, with summary)</em> field type on the <em>Manage fields</em> page. Even when <em>Summary input</em> is enabled, and summaries are provided, you can display <em>trimmed</em> text nonetheless by choosing the appropriate format on the <em>Manage display</em> page."
msgstr "Jako alternativu k použití oříznuté verze textu můžete zadat samostatný souhrn zvolením typu pole <em>Text (formátovaný, dlouhý, se souhrnem)</em> na stránce <em>Spravovat pole</em>. I když je povolena volba <em>Vstup souhrnu</em> a jsou poskytnuty souhrny, můžete nicméně zobrazit <em>oříznutý</em> text výběrem odpovídajícího formátu na stránce <em>Spravovat zobrazení</em>."

msgid "Using text formats and editors"
msgstr "Použití textových formátů a editorů"

msgid "If you choose <em>Text (plain)</em> or <em>Text (plain, long)</em> you restrict the input to <em>Plain text</em> only. If you choose <em>Text (formatted)</em>, <em>Text (formatted, long)</em>, or <em>Text (formatted, long with summary)</em> you allow users to write formatted text. Which options are available to individual users depends on the settings on the <a href=\":formats\">Text formats and editors page</a>."
msgstr "Zvolíte-li volbu <em>Text (prostý)</em> nebo <em>Text (prostý, dlouhý)</em>, omezíte vstup pouze na <em>Prostý text</em>. Vyberete-li volbu <em>Text (formátovaný)</em>, <em>Text (formátovaný, dlouhý)</em> nebo <em>Text (formátovaný, dlouhý se souhrnem)</em>, umožníte uživatelům psát formátovaný text. Volby, které jsou k dispozici jednotlivým uživatelům, závisí na nastaveních na <a href=\":formats\">stránce textových formátů a editorů</a>."

msgid "Edit summary"
msgstr "Upravit souhrn"

msgid "Hide summary"
msgstr "Skrýt souhrn"

msgid "Defines field types for short and long text with optional summaries."
msgstr "Definuje typy polí pro krátký a dlouhý text s volitelnými souhrny."

msgid "Text settings"
msgstr "Nastavení textu"

msgid "Default summary length"
msgstr "Výchozí délka souhrnu"

msgid "Text (formatted) settings"
msgstr "Nastavení textu (formátovaný)"

msgid "Allowed text formats"
msgstr "Povolené formáty textu"

msgid "Text (formatted, long) settings"
msgstr "Nastavení textu (formátovaný, dlouhý)"

msgid "Text (formatted, long, with summary) settings"
msgstr "Nastavení textu (formátovaný, dlouhý, se souhrnem)"

msgid "Summary input"
msgstr "Zadávat upoutávku (souhrn)"

msgid "Require summary"
msgstr "Požadovat souhrn"

msgid "Formatted text default display format settings"
msgstr "Nastavení výchozího formátu zobrazení formátovaného textu"

msgid "Summary or trimmed formatted text display format settings"
msgstr "Nastavení formátu zobrazení souhrnu nebo oříznutého formátovaného textu"

msgid "Trim length"
msgstr "Délka oříznutí"

msgid "Trimmed text display format settings"
msgstr "Nastavení formátu zobrazení oříznutého textu"

msgid "Text area (multiple rows) display format settings"
msgstr "Nastavení formátu zobrazení oblasti textu (více řádků)"

msgid "Text area with a summary display format settings"
msgstr "Oblast textu s nastavením formátu zobrazení souhrnu"

msgid "Number of summary rows"
msgstr "Počet řádků souhrnu"

msgid "Always show summary"
msgstr "Vždy zobrazit souhrn"

msgid "Summary or trimmed"
msgstr "Shrnutí nebo oříznutí"

msgid "Trimmed limit"
msgstr "Oříznutý limit"

msgid "If the summary is not set, the trimmed %label field will end at the last full sentence before this character limit."
msgstr "Není-li souhrn nastaven, bude oříznuté pole %label ukončeno v poslední úplné větě před tímto omezením počtu znaků."

msgid "Trimmed limit: @trim_length characters"
msgstr "Oříznutý limit: @trim_length characters"

msgid "Trimmed"
msgstr "Oříznuté"

msgid "The selected text format is not allowed."
msgstr "Vybraný formát textu není povolen."

msgid "%name: the text may not be longer than @max characters."
msgstr "%name: Text nesmí být delší než @max znaků."

msgid "Text (formatted)"
msgstr "Text (formátovaný)"

msgid "This field stores a text with a text format."
msgstr "V tomto poli je uložen text s formátem textu."

msgid "Select the allowed text formats. If no formats are selected, all available text formats will be displayed to the user."
msgstr "Vyberte povolené formáty textu. Nejsou-li vybrány žádné formáty, uživateli se zobrazí všechny dostupné formáty textu."

msgid "Processed text"
msgstr "Zpracovaný text"

msgid "The text with the text format applied."
msgstr "Text s použitým formátem textu."

msgid "Text (formatted, long)"
msgstr "Text (formátovaný, dlouhý)"

msgid "This field stores a long text with a text format."
msgstr "V tomto poli je uložen dlouhý text s formátem textu."

msgid "This allows authors to input an explicit summary, to be displayed instead of the automatically trimmed text when using the \"Summary or trimmed\" display type."
msgstr "Typ zobrazení \"Shrnutí nebo oříznutí\" dovoluje autorům explicitně vložit shrnutí, které bude zobrazeno namísto automaticky oříznutého textu."

msgid "The summary will also be visible when marked as required."
msgstr "Souhrn bude také viditelný, je-li označen jako povinný."

msgid "The summary field is required for @name"
msgstr "Pole souhrnu je povinné pro @name"

msgid "Processed summary"
msgstr "Zpracovaný souhrn"

msgid "The summary text with the text format applied."
msgstr "Text souhrnu s použitým formátem textu."

msgid "Text (formatted, long, with summary)"
msgstr "Text (formátovaný, dlouhý, se souhrnem)"

msgid "This field stores long text with a format and an optional summary."
msgstr "V tomto poli je uložen dlouhý text s formátem a volitelným souhrnem."

msgid "Text editors may override this setting."
msgstr "Textové editory mohou toto nastavení potlačit."

