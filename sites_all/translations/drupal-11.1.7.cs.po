msgstr "Proměnné položky protokolu v serializovaném formátu."

msgid "Severity level"
msgstr "Úroveň závažnosti"

msgid "The severity level of the event; ranges from 0 (Emergency) to 7 (Debug)."
msgstr "Úroveň závažnosti události; rozsahy od 0 (stav nouze) do 7 (ladění)."

msgid "Operation links for the event."
msgstr "Odkazy na operaci pro událost."

msgid "Location"
