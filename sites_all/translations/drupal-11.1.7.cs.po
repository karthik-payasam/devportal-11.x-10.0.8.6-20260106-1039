msgstr "Popište tento typ media. Text bude zobrazen na stránce <em>Přidat nový objekt typu media</em>"

msgid "<em>The media source cannot be changed after the media type is created.</em>"
msgstr "<em>Zdroj objektu typu media nemůže být změněn poté, co byl media typ vytvořen."

msgid "Media source that is responsible for additional logic related to this media type."
msgstr "Zdroj objektu typu media, který je odpovědný za rozšiřující logiku spojenou s tímto media typem."

