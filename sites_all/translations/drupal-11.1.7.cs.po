msgid "Disallows usage of &lt;img&gt; tag sources that are not hosted on this site by replacing them with a placeholder image."
msgstr "U tagů &lt;img&gt; znemožní použití zdrojů umístěných mimo tento web a nahradí je zástupným obrázkem."

msgid "Lazy load images"
msgstr "Obrázky se zpožděným načtením"

msgid "Instruct browsers to lazy load images if dimensions are specified. Use in conjunction with and place after the 'Track images uploaded via a Text Editor' filter that adds image dimensions required for lazy loading. Results can be overridden by <code>&lt;img loading=&quot;eager&quot;&gt;</code>."
msgstr "Instruujte prohlížeče k pomalému načtení obrázků, pokud jsou zadány rozměry. Použijte ve spojení s filtrem 'Sledovat obrázky odeslané prostřednictvím textového editoru', který přidává rozměry obrázku požadované pro pomalé načtení, a umístěte je za ně. Výsledky lze přepsat pomocí <code>&lt;img loading=&quot;eager&quot;&gt;</code>."

msgid "Missing filter. All text is removed"
msgstr "Chybí filtr. Veškerý text je odebrán"

msgid "Missing filter plugin: %filter."
msgstr "Chybí modul plug-in filtru: %filter."

msgid "Provides a fallback for missing filters. Do not use."
msgstr "Poskytuje náhradní řešení pro chybějící filtry. Nepoužívejte."

msgid "Maximum link text length"
msgstr "Maximální délka textu odkazu"

msgid "characters"
msgstr "znaky"

msgid "URLs longer than this number of characters will be truncated to prevent long strings that break formatting. The link itself will be retained; just the text portion of the link will be truncated."
msgstr "URL delší než toto číslo budou zkráceny, aby se předešlo dlouhým textům, které ničí formátování. Samotný odkaz bude zachován, zkrátí se pouze textová část odkazu."

msgid "Web page addresses and email addresses turn into links automatically."
msgstr "Adresy webových stránek a e-mailové adresy se mění na odkazy automaticky."

msgid "Convert URLs into links"
