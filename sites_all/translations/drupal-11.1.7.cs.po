msgstr "Položka panelu nástrojů %toolbar_item vyžaduje povolení modulu plug-in %plugin"

msgid "The %toolbar_item toolbar item requires the %plugins plugins to be enabled."
msgstr "Položka panelu nástrojů %toolbar_item vyžaduje povolení modulů plug-in %plugins."

