msgid "The administrative email address for the site."
msgstr "E-mailová adresa pro hlavní administraci tohoto webu."

msgid "Base URL"
msgstr "Základní adresa URL"

msgid "The base URL of the site, currently: @base_url"
msgstr "Základní adresa URL webu, momentálně: @base_url"

msgid "Base path"
msgstr "Cesta k webu"

msgid "The base path of the site, currently: @base_path"
