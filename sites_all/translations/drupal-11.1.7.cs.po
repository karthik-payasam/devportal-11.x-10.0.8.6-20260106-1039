msgstr "Levý boční panel"

msgid "Right sidebar"
msgstr "Pravý boční panel"

msgid "Header"
msgstr "Hlavička"

msgid "Footer"
msgstr "Patička"

msgid "Highlighted"
msgstr "Zvýrazněno"

msgid "Page bottom"
msgstr "Dolní část stránky"

msgid "Drupal"
msgstr "Drupal"

msgid "Installation profile"
msgstr "Instalační profil"

msgid "%profile_name (%profile-%version)"
msgstr "%profile_name (%profile-%version)"

msgid "Experimental modules enabled"
msgstr "Experimentální moduly byly povoleny"

msgid "Experimental modules found: %module_list. <a href=\":url\">Experimental modules</a> are provided for testing purposes only. Use at your own risk."
msgstr "Experimentální moduly byly nalezeny: %module_list. <a href=\":url\">Experimentální moduly</a> jsou poskytovány pouze pro testovací účely. Použití je na vlastní riziko."

msgid "Deprecated modules enabled"
msgstr "Zamítnuté moduly povoleny"

msgid "Deprecated modules found: %module_list."
msgstr "Nalezené zamítnuté moduly: %module_list."

msgid "Experimental themes enabled"
msgstr "Experimentální motivy byly povoleny"

msgid "Experimental themes found: %theme_list. Experimental themes are provided for testing purposes only. Use at your own risk."
msgstr "Experimentální motivy byly nalezeny: %theme_list. Experimentální motivy jsou poskytovány pouze pro testovací účely. Použití je na vlastní riziko."

msgid "Deprecated themes enabled"
msgstr "Zamítnuté motivy povoleny"

msgid "Deprecated themes found: %theme_list."
msgstr "Nalezené zamítnuté motivy: %theme_list."

msgid "Obsolete extensions enabled"
msgstr "Zastaralá rozšíření povolena"

msgid "Obsolete extensions found: %extensions. Obsolete extensions are provided only so that they can be uninstalled cleanly. You should immediately <a href=\":uninstall_url\">uninstall these extensions</a> since they may be removed in a future release."
msgstr "Nalezená zastaralá rozšíření: %extensions. Zastaralá rozšíření jsou k dispozici pouze proto, aby mohla být čistě odinstalována. Měli byste okamžitě provést <a href=\":uninstall_url\">odinstalování těchto rozšíření</a>, protože mohou být v budoucím vydání odebrána."

msgid "Web server"
msgstr "Web server"

msgid "Apache version"
msgstr "Verze Apache"

msgid "Due to the settings for ServerTokens in httpd.conf, it is impossible to accurately determine the version of Apache running on this server. The reported value is @reported, to run Drupal without mod_rewrite, a minimum version of 2.2.16 is needed."
msgstr "Vzhledem k nastavení tokenů ServerTokens v souboru httpd.conf není možné přesně určit verzi serveru Apache, která je na tomto serveru spuštěna. Zjištěná hodnota je @reported ke spuštění Drupal bez mod_rewrite, zapotřebí je minimální verze 2.2.16."

msgid "The minimum version of Apache needed to run Drupal without mod_rewrite enabled is 2.2.16. See the <a href=\":link\">enabling clean URLs</a> page for more information on mod_rewrite."
msgstr "Minimální verze serveru Apache potřebná ke spuštění Drupal bez povoleného mod_rewrite je 2.2.16. Další informace k atributu mod_rewrite viz stránka <a href=\":link\">povolení hezkých (clean) adres URL</a>."

msgid "Clean URLs"
msgstr "Čistá URL"

msgid "Your server is capable of using clean URLs, but it is not enabled. Using clean URLs gives an improved user experience and is recommended. <a href=\":link\">Enable clean URLs</a>"
msgstr "Váš server je schopen používat hezké (clean) adresy URL, to ale není povoleno. Používání hezkých adres URL poskytuje příjemnější uživatelské zkušenosti, a je doporučeno. <a href=\":link\">Povolit hezké (clean) adresy URL</a>"

msgid "@phpversion (<a href=\":url\">more information</a>)"
msgstr "@phpversion (<a href=\":url\">více informací</a>)"

msgid "PHP"
msgstr "PHP"

msgid "Your PHP installation is too old. Drupal requires at least PHP %version. It is recommended to upgrade to PHP version %recommended or higher for the best ongoing support. See <a href=\"http://php.net/supported-versions.php\">PHP's version support documentation</a> and the <a href=\":php_requirements\">Drupal PHP requirements</a> page for more information."
msgstr ""

msgid "It is recommended to upgrade to PHP version %recommended or higher for the best ongoing support.  See <a href=\"http://php.net/supported-versions.php\">PHP's version support documentation</a> and the <a href=\":php_requirements\">Drupal PHP requirements</a> page for more information."
msgstr ""

msgid "PHP %version has <a href=\":bug_url\">an OPcache bug that can cause fatal errors with class autoloading</a>. This can be fixed by upgrading to PHP 8.1.6 or later. See <a href=\"http://php.net/supported-versions.php\">PHP's version support documentation</a> and the <a href=\":php_requirements\">Drupal PHP requirements</a> page for more information."
msgstr ""

msgid "PHP extensions"
msgstr "Rozšíření PHP"

msgid "Drupal requires you to enable the PHP extensions in the following list (see the <a href=\":system_requirements\">system requirements page</a> for more information):"
msgstr "Drupal vyžaduje, abyste povolili rozšíření PHP v následujícím seznamu (další informace viz <a href=\":system_requirements\">stránka požadavků na systém</a>):"

msgid "PHP OPcode caching can improve your site's performance considerably. It is <strong>highly recommended</strong> to have <a href=\"http://php.net/manual/opcache.installation.php\" target=\"_blank\">OPcache</a> installed on your server."
msgstr "Ukládání PHP OPcode do mezipaměti může výrazně zlepšit výkon vašeho webu. <strong>Důrazně se doporučuje</strong> instalace <a href=\"http://php.net/manual/opcache.installation.php\" target=\"_blank\">OPcache</a> na vašem serveru."

msgid "PHP OPcode caching"
msgstr "Ukládání PHP OPcode do mezipaměti "

msgid "PHP APCu caching"
msgstr "Ukládání PHP APCu do mezipaměti"

msgid "PHP APCu available caching"
msgstr "Dostupné ukládání do mezipaměti PHP APCu"

msgid "Enabled (@size)"
msgstr "Povoleno (@size)"

msgid "Depending on your configuration, Drupal can run with a @apcu_size APCu limit. However, a @apcu_default_size APCu limit (the default) or above is recommended, especially if your site uses additional custom or contributed modules."
msgstr "V závislosti na vaší konfiguraci může být Drupal spuštěn s limitem @apcu_size APCu. Omezení @apcu_default_size APCu (výchozí nastavení) nebo vyšší je doporučeno, zvláště pokud váš web používá další vlastní nebo přidané moduly."

msgid "APCu is using over 90% of its allotted memory (@apcu_actual_size). To improve APCu performance, consider increasing this limit."
msgstr "APCu používá více než 90 % přidělené paměti (@apcu_actual_size). Chcete-li zlepšit výkon APCu, zvažte zvýšení tohoto limitu."

msgid "APCu is using over 75% of its allotted memory (@apcu_actual_size). To improve APCu performance, consider increasing this limit."
msgstr "APCu využívá více než 75 % přidělené paměti (@apcu_actual_size). Chcete-li zlepšit výkon APCu, zvažte zvýšení tohoto limitu."

msgid "Memory available: @available."
msgstr "Dostupná paměť: @available."

msgid "PHP APCu caching can improve your site's performance considerably. It is <strong>highly recommended</strong> to have <a href=\"https://www.php.net/manual/apcu.installation.php\" target=\"_blank\">APCu</a> installed on your server."
msgstr "Ukládání PHP APCu do mezipaměti může výrazně zlepšit výkon vašeho webu. <strong>Důrazně se doporučuje</strong> instalace <a href=\"https://www.php.net/manual/apcu.installation.php\" target=\"_blank\">APCu</a> na vašem serveru."

msgid "Random number generation"
msgstr "Generování náhodných čísel"

msgid "Successful"
msgstr "Úspěšné"

msgid "Drupal is unable to generate highly randomized numbers, which means certain security features like password reset URLs are not as secure as they should be. Instead, only a slow, less-secure fallback generator is available. The most likely cause is that open_basedir restrictions are in effect and /dev/urandom is not on the whitelist. See the <a href=\":drupal-php\">system requirements</a> page for more information. %exception_message"
msgstr "Drupal není schopen generovat vysoce randomizovaná čísla, což znamená, že určité funkce zabezpečení, jako jsou například adresy URL pro resetování hesla, nejsou tak bezpečné, jak by měly být. Místo toho je k dispozici pouze pomalý, méně bezpečný náhradní generátor. Nejpravděpodobnější příčinou je, že se uplatňují omezení open_basedir a že /dev/urandom není na seznamu povolených cest. Další informace viz stránka <a href=\":drupal-php\">požadavků na systém</a>. %exception_message"

msgid "Drupal is unable to generate highly randomized numbers, which means certain security features like password reset URLs are not as secure as they should be. Instead, only a slow, less-secure fallback generator is available. See the <a href=\":drupal-php\">system requirements</a> page for more information. %exception_message"
msgstr "Drupal není schopen generovat vysoce randomizovaná čísla, což znamená, že určité funkce zabezpečení, jako jsou například adresy URL pro resetování hesla, nejsou tak bezpečné, jak by měly být. Místo toho je k dispozici pouze pomalý, méně bezpečný náhradní generátor. Další informace viz stránka <a href=\":drupal-php\">požadavků na systém</a>. %exception_message"

msgid "Less secure"
msgstr "Méně zabezpečené"

msgid "Database support"
msgstr "Podpora databáze"

msgid "Your web server does not appear to support PDO (PHP Data Objects). Ask your hosting provider if they support the native PDO extension. See the <a href=\":link\">system requirements</a> page for more information."
msgstr "Zdá se, že váš webový server nepodporuje CHOP (datové objekty PHP). Požádejte svého poskytovatele hostingu, pokud podporuje nativní rozšíření PDO. Další informace viz stránka <a href=\":link\">požadavků na systém</a>."

msgid "Your web server does not appear to support any common PDO database extensions. Check with your hosting provider to see if they support PDO (PHP Data Objects) and offer any databases that <a href=\":drupal-databases\">Drupal supports</a>."
msgstr "Váš webový server zřejmě nepodporuje žádná obecná rozšíření databáze PDO. Kontaktujte svého poskytovatele hostingu, abyste zjistili, zda podporují PDO (PHP Data Objects), a nabízejí jakékoli databáze, které <a href=\":drupal-databases\">Drupal podporuje</a>."

msgid "Your web server seems to have the wrong version of PDO installed. Drupal requires the PDO extension from PHP core. This system has the older PECL version. See the <a href=\":link\">system requirements</a> page for more information."
msgstr "Zdá se, že váš webový server má nainstalovánu nesprávnou verzi objektu PDO. Drupal vyžaduje rozšíření PDO z jádra PHP. Tento systém má starší verzi PECL. Další informace viz stránka <a href=\":link\">požadavků na systém</a>."

msgid "Database system"
msgstr "Databázový systém"

msgid "Database system version"
msgstr "Verze databázového systému"

msgid "Database support for JSON"
msgstr "Podpora databáze pro JSON"

msgid "Is required in Drupal 10.0."
msgstr "Je požadována v Drupal 10.0."

msgid "Not available"
msgstr "Není k dispozici"

msgid "PHP memory limit"
msgstr "PHP memory limit"

msgid "-1 (Unlimited)"
msgstr "-1 (Neomezené)"

msgid "Consider increasing your PHP memory limit to %memory_minimum_limit to help prevent errors in the installation process."
msgstr "Pro předejití problémů je třeba zvážit zvýšení PHP memory limitu na alespoň %memory_minimum_limit."

msgid "Consider increasing your PHP memory limit to %memory_minimum_limit to help prevent errors in the update process."
msgstr "Pro předejití chybám zvažte zvýšení PHP memory limitu alespoň na %memory_minimum_limit."

msgid "Depending on your configuration, Drupal can run with a %memory_limit PHP memory limit. However, a %memory_minimum_limit PHP memory limit or above is recommended, especially if your site uses additional custom or contributed modules."
msgstr "V závislosti na konfiguraci lze Drupal provozovat s PHP memory limitem %memory_limit. Nicméně limit alespoň %memory_minimum_limit je doporučen, zvláště pokud tento web používá další moduly."

msgid "Increase the memory limit by editing the memory_limit parameter in the file %configuration-file and then restart your web server (or contact your system administrator or hosting provider for assistance)."
msgstr "Zvyšte memory limit změnou parametru memory_limit v souboru %configuration-file a poté restartujte Váš webový server (nebo kontaktujte  administrátora systému či poskytovatele webhostingu)."

msgid "Contact your system administrator or hosting provider for assistance with increasing your PHP memory limit."
msgstr "Pro zvýšení PHP memory limitu kontaktujte administrátora systému či poskytovatele webhostingu."

msgid "For more information, see the online handbook entry for <a href=\":memory-limit\">increasing the PHP memory limit</a>."
msgstr "Další informace viz položka příručky online pro <a href=\":memory-limit\">zvýšení mezní hodnoty hodnoty PHP</a>."

msgid "Protection disabled"
msgstr "Ochrana je zakázána"

msgid "Not protected"
msgstr "Není chráněný"

msgid "The directory %file is not protected from modifications and poses a security risk. You must change the directory's permissions to be non-writable."
msgstr "Adresář %file není chráněn proti změnám, což představuje bezpečnostní riziko. Je třeba změnit oprávnění adresáře tak, aby nebyl zapisovatelný."

msgid "The file %file is not protected from modifications and poses a security risk. You must change the file's permissions to be non-writable."
msgstr "Soubor %file není chráněn proti změnám a proto je bezpečnostním rizikem. Je třeba změnit práva tohoto souboru, aby nebyl zapisovatelný pro všechny."

msgid "Protected"
msgstr "Chráněný"

msgid "Configuration files"
msgstr "Konfigurační soubory"

msgid "Not fully protected"
msgstr "Není plně chráněno"

msgid "See <a href=\":url\">@url</a> for information about the recommended .htaccess file which should be added to the %directory directory to help protect against arbitrary code execution."
msgstr "Viz <a href=\":url\">@url</a>, kde naleznete informace o doporučeném souboru .htaccess, který by měl být přidán do adresáře %directory k ochraně před případným spuštěním kódu."

msgid "Last run @time ago"
msgstr "Naposledy spuštěno před @time"

msgid "Cron maintenance tasks"
msgstr "Údržba webu pomocí cron"

msgid "Cron has not run recently."
msgstr "Cron nebyl v poslední době spuštěn."

msgid "For more information, see the online handbook entry for <a href=\":cron-handbook\">configuring cron jobs</a>."
msgstr "Další informace viz položka příručky online pro <a href=\":cron-handbook\">konfiguraci úloh cron</a>."

msgid "more information"
msgstr "více informací"

msgid "Run cron"
msgstr "Spustit cron"

msgid "An automated attempt to create the directory %directory failed, possibly due to a permissions problem. To proceed with the installation, either create the directory and modify its permissions manually or ensure that the installer has the permissions to create it automatically. For more information, see INSTALL.txt or the <a href=\":handbook_url\">online handbook</a>."
msgstr "Automatický pokus o vytvoření adresáře %directory se nezdařil, pravděpodobně kvůli problému s oprávněním. Chcete-li pokračovat v instalaci, vytvořte buď adresář a upravte oprávnění ručně, nebo se ujistěte, že instalační program má oprávnění k jeho automatickému vytvoření. Další informace viz INSTALL.txt nebo <a href=\":handbook_url\">příručka online</a>."

msgid "Not present"
msgstr "Není přítomen"

msgid "Your %file file must define the %setting setting as a string containing the directory in which configuration files can be found."
msgstr "Soubor %file musí definovat nastavení %setting jako řetězec obsahující adresář, ve kterém lze nalézt konfigurační soubory."

msgid "File system"
msgstr "Systém souborů"

msgid "Not writable"
msgstr "Není zapisovatelný"

msgid "You may need to set the correct directory at the <a href=\":admin-file-system\">file system settings page</a> or change the current directory's permissions so that it is writable."
msgstr "Možná budete muset nastavit správný adresář na <a href=\":admin-file-system\">stránce nastavení systému souborů</a> nebo změnit oprávnění aktuálního adresáře tak, aby do něj bylo možné zapisovat."

msgid "Writable (<em>public</em> download method)"
msgstr "Zapisovatelný (<em>veřejný</em> přístup)"

msgid "Writable (<em>private</em> download method)"
msgstr "Zapisovatelný (<em>neveřejný</em> přístup)"

msgid "Database updates"
msgstr "Aktualizace databáze"

msgid "Out of date"
msgstr "Zastaralý"

msgid "Some modules have database schema updates to install. You should run the <a href=\":update\">database update script</a> immediately."
msgstr "Některé moduly mají aktualizace schématu databáze pro instalaci. Okamžitě byste měli spustit <a href=\":update\">aktualizační skript databáze</a>."

msgid "Entity/field definitions"
msgstr "Definice entity/pole"

msgid "Mismatched entity and/or field definitions"
msgstr "Neshoda definic entity anebo pole"

msgid "The following changes were detected in the entity type and field definitions. @updates"
msgstr "V definicích typu entity a pole byly zjištěny následující změny. @updates"

msgid "The update.php script is accessible to everyone without authentication check, which is a security risk. You must change the @settings_name value in your settings.php back to FALSE."
msgstr "Skript update.php je přístupný komukoli bez ověření identity, což představuje bezpečnostní riziko. Změňte hodnotu @settings_name v souboru settings.php zpět na FALSE."

msgid "Access to update.php"
msgstr "Přistup k update.php"

msgid "Unresolved dependency"
msgstr "Nevyřešená závislost"

msgid "@name requires this module."
msgstr "@name vyžaduje tento modul."

msgid "@required_name (Missing)"
msgstr "@required_name (Chybí)"

msgid "@name requires this module and version. Currently using @required_name version @version"
msgstr "@name vyžaduje tento modul a verzi. Nyní používáte @required_name verze @version"

msgid "@required_name (Version @compatibility required)"
msgstr "@required_name (Verze @compatibility vyžadována)"

msgid "<a href=\":url\">@module</a>"
msgstr "<a href=\":url\">@module</a>"

msgid "<a href=\":url\">@theme</a>"
msgstr "<a href=\":url\">@theme</a>"

msgid "Standard PHP"
msgstr "Standardní PHP"

msgid "PHP Mbstring Extension"
msgstr "PHP Mbstring rozšíření"

msgid "Unicode library"
msgstr "Unicode knihovna"

msgid "Operations on Unicode strings are emulated on a best-effort basis. Install the <a href=\"http://php.net/mbstring\">PHP mbstring extension</a> for improved Unicode support."
msgstr "Operace na řetězcích Unicode jsou emulovány na základě nejlepšího výkonu. Chcete-li zlepšit podporu Unicode, nainstalujte <a href=\"http://php.net/mbstring\">příponu PHP mbstring</a>."

msgid "Multibyte string input conversion in PHP is active and must be disabled. Check the php.ini <em>mbstring.encoding_translation</em> setting. Please refer to the <a href=\"http://php.net/mbstring\">PHP mbstring documentation</a> for more information."
msgstr "Převod vstupu vícebajtového řetězce v PHP je aktivní a musí být zakázána. Zkontrolujte nastavení php.ini <em>mbstring.encoding_translation</em>. Další informace viz <a href=\"http://php.net/mbstring\">Dokumentace PHP mbstring</a>."

msgid "Update notifications are not enabled. It is <strong>highly recommended</strong> that you enable the Update Manager module from the <a href=\":module\">module administration page</a> in order to stay up-to-date on new releases. For more information, <a href=\":update\">Update status handbook page</a>."
msgstr "Upozornění na aktualizace není povoleno. Je <strong>silně doporučeno</strong> povolit modul \"Update Manager\" na <a href=\":module\">stránce správy modulů</a>, abyste měli informace o nově vydaných verzích. Pro více informací navštivte <a href=\":update\">stránku s příručkou ke kontrole aktualizací</a>."

msgid "Rebuild access"
msgstr "Znovu vytvořit přístup"

msgid "The rebuild_access setting is enabled in settings.php. It is recommended to have this setting disabled unless you are performing a rebuild."
msgstr "Nastavení rebuild_access je povoleno v settings.php. Doporučuje se mít toto nastavení zakázáno, dokud nebude provedeno znovusestavení."

msgid "Not set"
msgstr "Nenastaveno"

msgid "SameSite cookie attribute"
msgstr "Atribut souboru cookie SameSite"

msgid "This attribute should be explicitly set to Lax, Strict or None. If set to None then the request must be made via HTTPS. See <a href=\":url\" target=\"_blank\">PHP documentation</a>"
msgstr "Tento atribut by měl být explicitně nastaven na hodnotu Lax, Strict nebo Žádný. Je-li nastaven na hodnotu Žádný, pak musí být požadavek učiněn přes HTTPS. Viz <a href=\":url\" target=\"_blank\">dokumentace k PHP</a>"

msgid "Trusted Host Settings"
msgstr "Nastavení důvěryhodného hostitele"

msgid "The trusted_host_patterns setting is not configured in settings.php. This can lead to security vulnerabilities. It is <strong>highly recommended</strong> that you configure this. See <a href=\":url\">Protecting against HTTP HOST Header attacks</a> for more information."
msgstr "V souboru settings.php není nastavena hodnota trusted_host_patterns. To může vést ke zranitelnosti webu. Je <strong>silně doporučeno</strong> tuto hodnotu nastavit. Pro více informací navštivte stránku <a href=\":url\">Ochrana proti útoku typu \"HTTP HOST Header attack\"</a>."

msgid "The trusted_host_patterns setting is set to allow %trusted_host_patterns"
msgstr "Nastavení trusted_host_patterns je nastaveno pro povolení %trusted_host_patterns"

msgid "Database driver provided by module"
msgstr "Ovladač databáze poskytnutý modulem"

msgid "The current database driver is provided by the module: %module. The module is currently not enabled. You should immediately <a href=\":enable\">enable</a> the module."
msgstr "Aktuální ovladač databáze je poskytován modulem: %module. Modul není momentálně povolen. Měli byste okamžitě <a href=\":enable\">povolit</a> modul."

msgid "Xdebug settings"
msgstr "Nastavení Xdebug"

msgid "xdebug.max_nesting_level is set to %value."
msgstr "Úroveň xdebug.max_nesting_level je nastavena na %value."

msgid "Set <code>xdebug.max_nesting_level=@level</code> in your PHP configuration as some pages in your Drupal site will not work when this setting is too low."
msgstr "Nastavte <code>xdebug.max_nesting_level=@level</code> v konfiguraci PHP, protože některé stránky na webu Drupal nebudou pracovat, když je toto nastavení příliš nízké."

msgid "Windows installation depth"
msgstr "Hloubka instalace Windows"

msgid "The public files directory path is %depth characters. Paths longer than 120 characters will cause problems on Windows."
msgstr "Cesta k adresáři veřejných souborů má %depth znaků. Cesty delší než 120 znaků způsobí problémy v systému Windows."

msgid "Limited date range"
msgstr "Omezený rozsah dat"

msgid "Your PHP installation has a limited date range."
msgstr "Vaše instalace PHP má omezený rozsah dat."

msgid "You are running on a system where PHP is compiled or limited to using 32-bit integers. This will limit the range of dates and timestamps to the years 1901-2038. Read about the <a href=\":url\">limitations of 32-bit PHP</a>."
msgstr "Pracujete na systému, kde je PHP kompilováno nebo omezeno na používání 32bitových celých čísel. Tím se omezí rozsah dat a časových razítek na roky 1901-2038. Přečtěte si více o <a href=\":url\">omezeních 32bitového PHP</a>."

msgid "Configuration install"
msgstr "Instalace konfigurace"

msgid "The selected profile has a hook_install() implementation and therefore can not be installed from configuration."
msgstr "Vybraný profil má implementaci hook_install(), a proto nemůže být instalován z konfigurace."

msgid "Install profile in settings"
msgstr "Instalovat profil v nastavení"

msgid "Drupal 9 no longer uses the $settings['install_profile'] value in settings.php and it should be removed."
msgstr "Drupal 9 již nepoužívá hodnotu $settings['install_profile'] v settings.php, a může být odstraněn."

msgid "The version of Drupal you are trying to update from is too old"
msgstr "Verze Drupal, ze které se pokoušíte aktualizovat, je příliš stará"

msgid "Updating to Drupal @current_major is only supported from Drupal version @required_min_version or higher. If you are trying to update from an older version, first update to the latest version of Drupal @previous_major. (<a href=\":url\">Drupal upgrade guide</a>)"
msgstr "Aktualizace na Drupal @current_major je podporována pouze z verze Drupal @required_min_version nebo vyšší. Pokud se pokoušíte aktualizovat ze starší verze, nejprve proveďte aktualizaci na nejnovější verzi Drupal @previous_major. (Příručka upgradu <a href=\":url\">Drupal</a>)"

msgid "Unsupported schema version: @module"
msgstr "Nepodporovaná verze schématu: @module"

msgid "The installed version of the %module module is too old to update. Update to an intermediate version first (last removed version: @last_removed_version, installed version: @installed_version)."
msgstr "Nainstalovaná verze modulu %module je příliš stará pro aktualizaci. Nejdříve aktualizujte na intermediační verzi (poslední odebraná verze: @last_removed_version, nainstalovaná verze: @installed_version)."

msgid "Missing updates for: @module"
msgstr "Chybí aktualizace pro: @module"

msgid "Twig development mode"
msgstr "Režim vývoje Twig"

msgid "Twig development mode settings are turned on. Go to @link to disable them."
msgstr "Nastavení režimu vývoje Twig jsou zapnuta. Chcete-li je zakázat, přejděte na téma @link."

msgid "Markup caching disabled"
msgstr "Ukládání markupů do mezipaměti zakázáno"

msgid "Render cache, dynamic page cache, and page cache are bypassed. Go to @link to enable them."
msgstr "Mezipaměť vykreslení, dynamická mezipaměť stránky a mezipaměť stránky jsou vynechány. Chcete-li je povolit, přejděte na téma @link."

msgid "Critical security announcements"
msgstr "Kritická oznámení zabezpečení"

msgid "Review the <a href=\":url\"> suggestions for resolving this incompatibility</a> to repair your installation, and then re-run update.php."
msgstr "Zrevidujte návrhy <a href=\":url\"> na vyřešení této nekompatibility</a>, abyste opravili svou instalaci, a potom znovu spusťte update.php."

msgid "For more information read the <a href=\":url\">documentation on deprecated modules.</a>"
msgstr "Další informace naleznete v <a href=\":url\">dokumentaci na zamítnutých modulech.</a>"

