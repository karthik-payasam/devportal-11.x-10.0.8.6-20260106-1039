msgstr "Chybové stránky"

msgid "This page is displayed when the requested document is denied to the current user. Leave blank to display a generic \"access denied\" page."
msgstr "Tato stránka bude zobrazena, když bude uživateli odmítnut přístup k dokumentu. Necháte-li prázdné, zobrazí se výchozí stránka \"přístup odepřen\"."

msgid "This page is displayed when no other content matches the requested document. Leave blank to display a generic \"page not found\" page."
msgstr "Tato stránka bude zobrazena, když nebude nalezen požadovaný dokument. Necháte-li prázdné, zobrazí se výchozí stránka \"stránka nenalezena\"."

msgid "The path '%path' has to start with a slash."
msgstr "Cesta '%path' musí začínat lomítkem."

