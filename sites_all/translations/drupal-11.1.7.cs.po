msgid "@warning <a href=\"@edit_url\">Edit the text format %format</a> to modify the attributes that can be overridden."
msgstr "@warning <a href=\"@edit_url\">Upravte formát textu %format</a> pro úpravu atributů, které lze přepsat."

msgid "It is potentially insecure to display oEmbed content in a frame that is served from the same domain as your main Drupal site, as this may allow execution of third-party code. Refer to <a href=\"https://oembed.com/#section3\">oEmbed Security Considerations</a>."
msgstr "Zobrazovat obsah oEmbed v rámci, který je obsluhován ze stejné domény jako hlavní server Drupal, je potenciálně nebezpečné, protože to může umožnit zpracování kódu třetí strany. Viz <a href=\"https://oembed.com/#section3\">Aspekty zabezpečení oEmbed</a>."

msgid "Displaying media assets from third-party services, such as YouTube or Twitter, can be risky. This is because many of these services return arbitrary HTML to represent those assets, and that HTML may contain executable JavaScript code. If handled improperly, this can increase the risk of your site being compromised."
msgstr "Zobrazení aktiv médií ze služeb jiných dodavatelů, jako jsou YouTube nebo Twitter, může být rizikové. Důvodem je skutečnost, že mnohé z těchto služeb vracejí libovolný kód HTML, který má představovat tato aktiva, a tento kód HTML může obsahovat spustitelný kód jazyka JavaScript. Pokud není správně ošetřen, může to zvýšit riziko napadení vašeho serveru."

msgid "In order to mitigate the risks, third-party assets are displayed in an iFrame, which effectively sandboxes any executable code running inside it. For even more security, the iFrame can be served from an alternate domain (that also points to your Drupal site), which you can configure on this page. This helps safeguard cookies and other sensitive information."
msgstr "V zájmu snížení rizika jsou aktiva třetích stran zobrazována v sekci iFrame, což de facto izoluje spustitelný kód, který je v ní spuštěn, v sandboxu. Pro ještě lepší zabezpečení může být iFrame obsluhován z alternativní domény (která také ukazuje na váš server Drupal), kterou můžete nakonfigurovat na této stránce. To pomáhá chránit soubory cookie a další citlivé informace."

msgid "Security"
msgstr "Bezpečnost"

msgid "iFrame domain"
msgstr "Doména iFrame"

msgid "Enter a different domain from which to serve oEmbed content, including the <em>http://</em> or <em>https://</em> prefix. This domain needs to point back to this site, or existing oEmbed content may not display correctly, or at all."
msgstr "Zadejte jinou doménu, ze které se má poskytovat obsah oEmbed, včetně předpony <em>http://</em> nebo <em>https://</em>. Tato doména musí ukazovat zpět na tento server, jinak se existující obsah oEmbed nemusí zobrazit správně, případně se nezobrazí vůbec."

msgid "Standalone media URL"
msgstr "Adresa URL samostatného média"

msgid "Allow users to access @media-entities at /media/{id}."
msgstr "Povolit uživatelům přístup k @media-entities v /media/{id}."

msgid "%type is used by @count media item on your site. You can not remove this media type until you have removed all of the %type media items."
msgid_plural "%type is used by @count media items on your site. You can not remove this media type until you have removed all of the %type media items."
msgstr[0] "%type je používán @count položkami médií na vašem webu. Tento typ média nemůžete odebrat, dokud neodeberete všechny položky médií %type."
msgstr[1] "%type je používán @count položkami médií na vašem webu. Tento typ média nemůžete odebrat, dokud neodeberete všechny položky médií %type."
msgstr[2] "%type je používán @count položkami médií na vašem webu. Tento typ média nemůžete odebrat, dokud neodeberete všechny položky médií %type."

msgid "Remote oEmbed providers could not be retrieved due to error: @error. Using previously stored data. This may contain out of date information."
msgstr "Vzdálení poskytovatelé oEmbed nebyli načteni kvůli chybě: @error. Použití dříve uložených dat. Mohou obsahovat zastaralé informace."

msgid "Remote oEmbed providers database returned invalid or empty list. Using previously stored data. This may contain out of date information."
msgstr "Vzdálená databáze poskytovatelů oEmbed vrátila neplatný nebo prázdný seznam. Použití dříve uložených dat. Mohou obsahovat zastaralé informace."

msgid "Media selection"
msgstr "Výběr médií"

msgid "Media item"
msgstr "Položka média"

msgid "Linked to media item"
msgstr "Propojeno s položkou média"

msgid "oEmbed loading"
msgstr "Načítání oEmbed"

msgid "Lazy render oEmbed with native loading attribute (<em>loading=\"lazy\"</em>). This improves performance by allowing browsers to lazily load assets."
msgstr "Zpomalené vykreslení oEmbed s atributem nativního načtení (<em>loading=\"lazy\"</em>). Zvyšuje výkon tím, že umožňuje prohlížečům zpomalené načtení aktiv."

msgid "oEmbed loading attribute"
msgstr "Načítání atributu oEmbed"

msgid "Select the loading attribute for oEmbed. <a href=\":link\">Learn more about the loading attribute for oEmbed.</a>"
msgstr "Vyberte atribut načtení pro oEmbed. <a href=\":link\">Další informace o atributu načtení pro oEmbed.</a>"

msgid "Delays loading the resource until that section of the page is visible in the browser. When in doubt, lazy loading is recommended."
msgstr "Zpozdí načtení prostředku do té doby, než je tato část stránky viditelná v prohlížeči. Jste-li na pochybách, doporučuje se načtení typu lazy."

msgid "Force browsers to download a resource as soon as possible. This is the browser default for legacy reasons. Only use this option when the resource is always expected to render."
msgstr "Přinuťte prohlížeče stáhnout prostředek co nejdříve. Jedná se o výchozí nastavení prohlížeče z historických důvodů. Tuto volbu použijte pouze v případě, že se vždy očekává vykreslení prostředku."

msgid "Maximum size: %max_width x %max_height pixels"
msgstr "Maximální velikost: %max_width x %max_height pixelů"

msgid "Maximum width: %max_width pixels"
msgstr "Maximální šířka: %max_width pixelů"

msgid "Maximum height: %max_height pixels"
msgstr "Maximální výška: %max_height pixelů"

