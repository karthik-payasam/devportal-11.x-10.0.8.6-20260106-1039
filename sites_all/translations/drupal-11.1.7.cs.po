msgstr "Název shortcut_set.set_name, který bude zobrazen pro tohoto uživatele."

msgid "The SQLite module provides the connection between Drupal and a SQLite database. For more information, see the <a href=\":sqlite\">online documentation for the SQLite module</a>."
msgstr ""

msgid "SQLite"
msgstr "SQLite"

msgid "Provides the SQLite database driver."
msgstr "Poskytuje ovladač databáze SQLite."

msgid "Database file"
msgstr "Databázový soubor"

msgid "The absolute path to the file where @drupal data will be stored. This must be writable by the web server and should exist outside of the web root."
msgstr "Absolutní cesta k souboru, kde budou @drupal data uložena. Soubor musí být zapisovatelný pro webový server a měl by být uložen mimo webový kořen."

msgid "Failed to open or create database file %database. The database engine reports the following message when attempting to create the database: %error."
msgstr "Nezdařilo se otevřít nebo vytvořit databázový soubor %database. Jádro databáze ohlásí následující zprávu při pokusu o vytvoření databáze: %error."

msgid "Failed to connect to database. The database engine reports the following message: %error.<ul><li>Does the database file exist?</li><li>Does web server have permission to write to the database file?</li>Does the web server have permission to write to the directory the database file should be created in?</li></ul>"
msgstr "Připojení k databázi se nezdařilo. Jádro databáze ohlásí následující zprávu: %error.<ul><li>Existuje databázový soubor?</li><li>Má webový server oprávnění k zápisu do databázového souboru?</li>Má webový server oprávnění k zápisu do adresáře, ve kterém by měl být vytvořen databázový soubor?</li></ul>"

msgid "Number of views"
msgstr "Počet shlédnutí"

msgid "The number of visitors who have read the node."
msgstr "Počet návštěvníků, kteří zobrazili daný uzel."

msgid "Views today"
msgstr "Zobrazení dnes"

msgid "The number of visitors who have read the node today."
msgstr "Počet návštěvníků, kteří dnes zobrazili daný uzel."

msgid "Last view"
msgstr "Poslední zobrazení"

msgid "The date on which a visitor last read the node."
msgstr "Datum, kdy návštěvník naposledy zobrazil daný uzel."

msgid "Content statistics"
msgstr "Statistiky obsahu"

msgid "Total views"
msgstr "Celkový počet zobrazení"

msgid "The total number of times the node has been viewed."
msgstr "Celkový počet zobrazení uzlu."

msgid "The total number of times the node has been viewed today."
msgstr "Celkový počet dnešních zobrazení uzlu."

msgid "Most recent view"
msgstr "Nejnovější zobrazení"

msgid "The most recent time the node has been viewed."
msgstr "Čas kdy byl uzel naposledy prohlížen."

msgid "The Statistics module shows you how often content is viewed. This is useful in determining which pages of your site are most popular. For more information, see the <a href=\":statistics_do\">online documentation for the Statistics module</a>."
msgstr "Modul Statistika zobrazuje, jak často se zobrazuje obsah. To je užitečné při určování, které stránky vašeho webu jsou nejoblíbenější. Další informace viz <a href=\":statistics_do\">dokumentace online pro modul Statistika</a>."

msgid "Displaying popular content"
msgstr "Zobrazení oblíbeného obsahu"

msgid "The module includes a <em>Popular content</em> block that displays the most viewed pages today and for all time, and the last content viewed. To use the block, enable <em>Count content views</em> on the <a href=\":statistics-settings\">Statistics page</a>, and then you can enable and configure the block on the <a href=\":blocks\">Block layout page</a>."
msgstr "Modul obsahuje blok <em>Oblíbený obsah</em>, který vypisuje nejnavštěvovanější stránky pro aktuální den a celkem, a dále naposledy zobrazený obsah. Pro použití tohoto bloku povolte <em>Počet zobrazení obsahu</em> na stránce <a href=\":statistics-settings\">Statistiky</a>. Blok následně můžete povolit a nastavit na stránce <a href=\":blocks\">Umístění bloků</a>."

msgid "Page view counter"
msgstr "Počítadlo zobrazení stránek"

msgid "The Statistics module includes a counter for each page that increases whenever the page is viewed. To use the counter, enable <em>Count content views</em> on the <a href=\":statistics-settings\">Statistics page</a>, and set the necessary <a href=\":permissions\">permissions</a> (<em>View content hits</em>) so that the counter is visible to the users."
msgstr "Modul Statistika zahrnuje čítač pro každou stránku, která se zvýší při každém zobrazení stránky. Chcete-li použít čítač, povolte <em>Počet zobrazení obsahu</em> na <a href=\":statistics-settings\">stránce statistiky</a> a nastavte nezbytná <a href=\":permissions\">oprávnění </a> (<em>Zobrazit přístup k obsahu</em>) tak, aby byl čítač viditelný uživatelům."

msgid "Settings for the statistical information that Drupal will keep about the site."
msgstr "Nastavení pro statistické informace, které Drupal bude uchovávat o serveru."

msgid "1 view"
msgid_plural "@count views"
msgstr[0] "1 zobrazení"
msgstr[1] "@count zobrazení"
msgstr[2] "@count zobrazení"

msgid "Statistics"
msgstr "Statistiky"

msgid "Logs how many times content is viewed."
msgstr "Protokoluje, kolikrát je obsah zobrazen."

msgid "Configure the logging of content statistics."
msgstr "Nakonfigurujte protokolování statistiky obsahu."

msgid "Administer statistics"
msgstr "Spravovat statistiky"

msgid "View content hits"
msgstr "Zobrazit počítadlo přístupů"

msgid "Statistics settings"
msgstr "Nastavení statistiky"

msgid "Count content views"
msgstr "Počítadlo zobrazení obsahu"

msgid "How long any statistics may be cached, i.e. the refresh interval"
msgstr "Jak dlouho může být statistika ukládána do mezipaměti, tj. obnovovací interval"

msgid "Popular content block settings"
msgstr "Nastavení populárních bloků obsahu"

msgid "Number of day\\s top views to display"
msgstr "Počet dnů zobrazení top pohledů\\"

msgid "Number of all time views to display"
msgstr "Počet zobrazovaných návštěv za celé období"

msgid "Number of most recent views to display"
msgstr "Počet zobrazovaných posledních návštěv"

msgid "Numeric values from the statistics module"
msgstr "Číselné hodnoty z modulu Statistika"

msgid "The most recent time the node has been viewed"
msgstr "Nejnovější čas, kdy byl uzel zobrazen"

msgid "Tracking and displaying popular content"
msgstr "Sledování a zobrazení populárního obsahu"

msgid "Configure and display tracking of how many times content has been viewed on your site, assuming that the core Statistics module is currently installed."
msgstr "Nakonfigurujte a zobrazte sledování počtu zobrazení obsahu na vašem webu za předpokladu, že je aktuálně nainstalován základní modul Statistika."

msgid "What are the options for displaying popularity tracking?"
msgstr "Jaké jsou volby pro zobrazení sledování popularity?"

msgid "You can display a <em>content hits</em> counter of how many times a content item has been viewed, at the bottom of content item pages. You can also place a <em>Popular content</em> block in a region of your theme, which shows a list of the most popular and most recently-viewed content."
msgstr "Můžete zobrazit čítač <em>přístupů k obsahu</em>, kolikrát byla položka obsahu zobrazena, a to ve spodní části stránek položek obsahu. Můžete také umístit blok <em>Populární obsah</em> do oblasti vašeho motivu, který zobrazuje seznam nejoblíbenějšího a naposledy prohlíženého obsahu."

msgid "In the <em>Manage</em> administrative menu, navigate to <em>Configuration</em> &gt; <em>System</em> &gt; <em>@statistics_settings_link</em>."
msgstr "V administrativní nabídce <em>Spravovat</em> přejděte na položku <em>Konfigurace</em> &gt; <em>Systém</em> &gt; <em>@statistics_settings_link</em>."

msgid "Check <em>Count content views</em> and click <em>Save configuration</em>."
msgstr "Zaškrtněte položku <em>Počet zobrazení obsahu</em> a klepněte na volbu <em>Uložit konfiguraci</em>."

msgid "In the <em>Statistics</em> section, check or uncheck the <em>View content hits</em> permission for each role. Click <em>Save permissions</em>."
msgstr "V sekci <em>Statistika</em> zaškrtněte nebo zrušte zaškrtnutí oprávnění <em>Zobrazit přístupy k obsahu</em> pro každou roli. Klepněte na volbu <em>Uložit oprávnění</em>."

msgid "Optionally, in the <em>Manage</em> administrative menu, navigate to <em>Structure</em> &gt; <em>Block layout</em>. Place the <em>Popular content</em> block in a region in your theme (you will need to have the core Block module installed; see related topic for more details on block placement)."
msgstr "Volitelně můžete v administrativní nabídce <em>Správa</em> přejít na volbu <em>Struktura</em> &gt; <em>Rozvržení bloku</em>. Umístěte blok <em>Populární obsah</em> do oblasti ve vašem motivu (budete muset nainstalovat hlavní modul Blok; viz související téma, kde získáte další podrobnosti o umístění bloku)."

msgid "Content viewing counter settings"
msgstr "Nastavení počítadla zobrazení obsahu"

msgid "Increment a counter each time content is viewed."
msgstr "Při každém zobrazení obsahu zvednout počítadlo."

msgid "Number of day's top views to display"
msgstr "Počet zobrazovaných denních návštěv"

msgid "How many content items to display in \"day\" list."
msgstr "Kolik položek se má zobrazovat v seznamu „den“."

msgid "How many content items to display in \"all time\" list."
msgstr "Kolik položek se má zobrazovat v seznamu „za celé období“."

msgid "How many content items to display in \"recently viewed\" list."
msgstr "Kolik položek se má zobrazovat v seznamu „nedávno zobrazeno“."

msgid "Today's:"
msgstr "Dnes:"

msgid "All time:"
msgstr "Za celé období:"

msgid "Last viewed:"
msgstr "Naposledy zobrazeno:"

msgid "Popular content"
msgstr "Oblíbený obsah"

msgid "The ID of the node to which these statistics apply."
msgstr "ID uzlu, na který se tato statistika vztahuje."

msgid "The node ID."
msgstr "ID uzlu."

msgid "The Syslog module logs events by sending messages to the logging facility of your web server's operating system. Syslog is an operating system administrative logging tool that provides valuable information for use in system management and security auditing. Most suited to medium and large sites, Syslog provides filtering tools that allow messages to be routed by type and severity. For more information, see the <a href=\":syslog\">online documentation for the Syslog module</a>, as well as PHP's documentation pages for the <a href=\"http://php.net/manual/function.openlog.php\">openlog</a> and <a href=\"http://php.net/manual/function.syslog.php\">syslog</a> functions."
msgstr "Modul Syslog protokoluje události odesíláním zpráv do protokolovacího zařízení operačního systému vašeho webového serveru. Systémový protokol je nástroj pro administrativní protokolování operačního systému, který poskytuje cenné informace pro použití ve správě systémů a auditování zabezpečení. Nejvhodnější pro střední a velké weby, funkce Syslog poskytuje nástroje pro filtrování, které umožňují směrování zpráv podle typu a závažnosti. Další informace viz <a href=\":syslog\">dokumentace online pro modul Syslog</a> a také stránky dokumenty PHP pro funkce <a href=\"http://php.net/manual/function.openlog.php\">openlog</a> a <a href=\"http://php.net/manual/function.syslog.php\">syslog</a>."

msgid "Logging for UNIX, Linux, and Mac OS X"
msgstr "Logování v systémech UNIX, Linux a Mac OS X"

msgid "On UNIX, Linux, and Mac OS X, you will find the configuration in the file <em>/etc/syslog.conf</em>, or in <em>/etc/rsyslog.conf</em> or in the directory <em>/etc/rsyslog.d</em>. These files define the routing configuration. Messages can be flagged with the codes <code>LOG_LOCAL0</code> through <code>LOG_LOCAL7</code>. For information on Syslog facilities, severity levels, and how to set up <em>syslog.conf</em> or <em>rsyslog.conf</em>, see the <em>syslog.conf</em> or <em>rsyslog.conf</em> manual page on your command line."
msgstr "V systémech UNIX, Linux a Mac OS X najdete konfiguraci v souboru <em>/etc/syslog.conf</em> nebo <em>/etc/rsyslog.conf</em> nebo v adresáři <em>/etc/rsyslog.d</em>. Tyto soubory definují konfiguraci směrování. Zprávy mohou být označeny pomocí kódů <code>LOG_LOCAL0</code> až <code>LOG_LOCAL7</code>. Informace o zařízeních Syslog, úrovních závažnosti a o tom, jak nastavit soubor <em>syslog.conf</em> nebo <em>rsyslog.conf</em>, naleznete na stránce příručky <em>syslog.conf</em> nebo <em>rsyslog.conf</em> na příkazovém řádku."

msgid "Logging for Microsoft Windows"
msgstr "Logování v systému Microsoft Windows"

msgid "On Microsoft Windows, messages are always sent to the Event Log using the code <code>LOG_USER</code>."
msgstr "V systému Microsoft Windows jsou zprávy vždy odesílány do Logu událostí s kódem <code>LOG_USER</code>."

msgid "More information"
msgstr "Více informací"

msgid "Syslog identity"
msgstr "Identita systémového logu"

msgid "A string that will be prepended to every message logged to Syslog. If you have multiple sites logging to the same Syslog log file, a unique identity per site makes it easy to tell the log entries apart."
msgstr "Řetězec, který bude připojen před každou logovanou událost odeslanou do Syslogu. Jestliže máte více stránek, které logují do stejného souboru Syslogu , unikátní identifikátor stránky vám usnadní roztřídit záznamy."

msgid "Syslog facility"
msgstr "Syslog příslušenství (facility)"

msgid "Depending on the system configuration, Syslog and other logging tools use this code to identify or filter messages from within the entire system log."
msgstr "V závislosti na systémové konfiguraci, Syslog a jiné logovací nástroje používají tento kód k identifikování nebo filtrování zpráv v celém systémovém logu."

msgid "Syslog format"
msgstr "Formát systémového logu."

msgid "Specify the format of the syslog entry. Available variables are: <dl><dt><code>!base_url</code></dt><dd>Base URL of the site.</dd><dt><code>!timestamp</code></dt><dd>Unix timestamp of the log entry.</dd><dt><code>!type</code></dt><dd>The category to which this message belongs.</dd><dt><code>!ip</code></dt><dd>IP address of the user triggering the message.</dd><dt><code>!request_uri</code></dt><dd>The requested URI.</dd><dt><code>!referer</code></dt><dd>HTTP Referer if available.</dd><dt><code>!severity</code></dt><dd>The severity level of the event; ranges from 0 (Emergency) to 7 (Debug).</dd><dt><code>!uid</code></dt><dd>User ID.</dd><dt><code>!link</code></dt><dd>A link to associate with the message.</dd><dt><code>!message</code></dt><dd>The message to store in the log.</dd></dl>"
msgstr "Určete formát položky syslog. Dostupné proměnné jsou: <dl><dt><code>!base_url</code></dt><dd>Základní adresa URL webu.</dd><dt><code>!timestamp</code></dt><dd>Časové razítko formátu Unix položky protokolu.</dd><dt><code>!type</code></dt><dd>Kategorie, do které tato zpráva patří.</dd><dt><code>!ip</code></dt><dd>Adresa IP uživatele spouštějícího zprávu.</dd><dt><code>!request_uri</code></dt><dd>Požadovaný identifikátor URI.</dd><dt><code>!referer</code></dt><dd>Odkazující web HTTP, je-li dostupný.</dd><dt><code>!severity</code></dt><dd>Úroveň závažnosti události; rozsahy od 0 (stav nouze) do 7 (ladění).</dd><dt><code>!uid</code></dt><dd>ID uživatele.</dd><dt><code>!link</code></dt><dd>Odkaz, který se má přidružit ke zprávě.</dd><dt><code>!message</code></dt><dd>Zpráva pro uložení do protokolu.</dd></dl>"

msgid "Syslog"
msgstr "Syslog"

msgid "Logs events to the web server's system log."
msgstr "Protokoluje události do systémového protokolu webového serveru."

