msgid "In order to use the Simple XML Sitemap Views module, the Views URL generator must be <a href=\"@url\">added</a> to a sitemap type."
msgstr "Para usar o módulo Simple XML Sitemap Views, o gerador de URL de visualizações deve ser <a href=\"@url\">incluído</a> em um tipo de mapa do site."

msgid "Simple XML Sitemap (Views)"
msgstr "Mapa do site XML simples (visualizações)"

msgid "Provides integration of the Simple XML Sitemap module with the Views module."
msgstr "Fornece a integração do módulo Mapa do Site XML Simples com o módulo Visualizações."

msgid "SEO"
msgstr "SEO"

msgid "Views"
msgstr "Visualizações"

msgid "Simple XML Sitemap"
msgstr "Mapa do site XML simples"

msgid "Variants"
msgstr "Variantes"

msgid "Index"
msgstr "Index"

msgid "Priority"
msgstr "Prioridade"

msgid "Change frequency"
msgstr "Mude a frequência"

msgid "Indexed arguments"
msgstr "Argumentos indexados"

msgid "Max links"
msgstr "Máximo de links"

msgid "View"
msgstr "Visualizar"

msgid "Display"
msgstr "Exibição"

msgid "Sitemaps"
msgstr "Mapas do site"

msgid "Operations"
msgstr "Operações"

msgid "No view displays are set to be indexed yet. <a href=\"@url\">Edit a view.</a>"
msgstr "Nenhuma exibição de visualização está configurada para ser indexada ainda. <a href=\"@url\">Editar uma visualização.</a>"

msgid "Please configure at least one <a href=\"@sitemaps_url\">sitemap</a> to be of a <a href=\"@types_url\">type</a> that implements the views URL generator."
msgstr "Configure pelo menos um <a href=\"@sitemaps_url\">mapa do site</a> para ser de um <a href=\"@types_url\">tipo</a> que implementa o gerador de URL de visualizações."

msgid "Edit"
msgstr "Editar"

msgid "Garbage collection in the simple_sitemap_views table"
msgstr "Coleta de lixo na tabela simple_sitemap_views"

msgid "Views URL generator"
msgstr "Gerador de URL de visualizações"

msgid "Generates URLs for views."
msgstr "Gera URLs para visualizações."

msgid "Index this display in sitemap <em>@variant_label</em>"
msgstr "Indexar esta exibição no mapa do site <em>@variant_label</em>"

msgid "The priority this display will have in the eyes of search engine bots."
msgstr "A prioridade que esta exibição terá na visão dos robôs de mecanismo de procura."

msgid "The frequency with which this display changes. Search engine bots may take this as an indication of how often to index it."
msgstr "A frequência com a qual esta exibição muda. Os robôs do mecanismo de procura podem usar isso como uma indicação da frequência com a qual a entidade deverá ser indexada."

msgid "Maximum display variations"
msgstr "Variações máximas de exibição"

msgid "The maximum number of link variations to be indexed for this display. If left blank, each argument will create link variations for this display. Use with caution, as a large number of argument values​can significantly increase the number of sitemap links."
msgstr "O número máximo de variações de link a serem indexadas para esta exibição. Se deixado em branco, cada argumento criará variações de link para esta exibição. Use com cuidado, pois um grande número de valores do argumento pode aumentar significativamente o número de links do mapa do site."

msgid "Simple XML Sitemap settings for this display"
msgstr "Configurações do mapa do site XML simples para esta exibição"

msgid "Included in sitemaps: @variants"
msgstr "Incluído em mapas do site: @variants"

msgid "Excluded from all sitemaps"
msgstr "Excluído de todos os mapas do site"

msgid "To enable indexing of an argument, you must enable indexing of all previous arguments."
msgstr "Para ativar a indexação de um argumento, é necessário ativar a indexação de todos os argumentos anteriores."

msgid "Simple XML Sitemap settings for this view."
msgstr "Configurações do mapa do site XML simples para esta visualização."

