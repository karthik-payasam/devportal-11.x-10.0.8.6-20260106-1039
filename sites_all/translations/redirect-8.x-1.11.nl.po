msgstr "Overzicht van 404-foutpaden waaraan nog geen omleiding toegewezen is."

msgid "Path"
msgstr "Pad"

msgid "The path of the request."
msgstr "Het pad van de aanvraag."

msgid "The language of this request."
msgstr "De taal van deze aanvraag."

msgid "Count"
msgstr "Aantal"

msgid "The number of requests with that path and language."
msgstr "Het aantal aanvragen met dat pad en die taal."

msgid "Daily count"
msgstr "Dagelijks aantal"

msgid "The number of requests with that path and language in a day."
msgstr "Het aantal aanvragen met dat pad en die taal in een dag."

msgid "Timestamp"
msgstr "Tijdstip"

