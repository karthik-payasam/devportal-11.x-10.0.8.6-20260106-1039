msgstr "De datum waarop de omleiding is gemaakt."

msgid "Redirect loop identified at %path for redirect %rid"
msgstr "Omleidingslus vastgesteld op %path voor omleiding %rid"

msgid "Are you sure you want to delete the URL redirect from %source to %redirect?"
msgstr "Weet u zeker dat u de URL-omleiding van %source naar %redirect wilt verwijderen?"

msgid "Delete"
msgstr "Verwijderen"

msgid "The redirect %redirect has been deleted."
msgstr "De omleiding %redirect is gewist."

