msgid "Autocomplete Deluxe"
msgstr "Automaticky dokončit Deluxe"

msgid "Enhanced autocomplete using Jquery UI autocomplete."
msgstr "Rozšířené automatické dokončování pomocí automatického dokončování Jquery UI."

msgid "User interface"
msgstr "Uživatelské rozhraní"

msgid "None"
msgstr "Žádné"

msgid "The entity '@term' will be added."
msgstr "Bude přidána entita '@term'."

msgid "No terms could be found. Please type in order to add a new term."
msgstr "Nebyly nalezeny žádné termíny. Zadejte, chcete-li přidat nový termín."

msgid "No results found"
msgstr "Nebyly nalezeny žádné výsledky"

msgid "Autocomplete Deluxe widget settings"
msgstr "Nastavení automatického dokončování modulu widget Deluxe"

msgid "Match Operator"
msgstr "Operátor shody"

msgid "Route Name"
msgstr "Jméno cesty"

msgid "Size"
msgstr "Velikost"

msgid "Selection Handler"
msgstr "Obslužná rutina výběru"

msgid "Limit"
msgstr "Limit"

msgid "Min Length"
msgstr "Minimální délka"

msgid "Delimiter"
msgstr "Oddělovač"

msgid "Allow \"Not Found\" message"
msgstr "Povolit zprávu \"Nenalezeno\" "

msgid "\"Not Found\" Message"
msgstr "Zpráva \"Nenalezeno\" "

msgid "Allow New Terms"
msgstr "Povolit nové termíny"

msgid "No Empty Message"
msgstr "Žádná prázdná zpráva"

msgid "Match operator"
msgstr "Operátor shody"

msgid "Specify the matcting operator."
msgstr "Uveďte operátor shody."

msgid "Limit of the output."
msgstr "Limit výstupu."

msgid "If set to zero no limit will be used"
msgstr "Při nastavení na nulu nebude použit žádný limit"

msgid "Minimum length."
msgstr "Minimální délka."

msgid "The minimum length of characters to enter to open the suggestion list."
msgstr "Minimální délka znaků, které se mají zadat k otevření seznamu návrhů."

msgid "Delimiter."
msgstr "Oddělovač."

msgid "A character which should be used beside the enter key, to separate terms."
msgstr "Znak, který by měl být použit vedle klávesy Enter za účelem oddělení termínů."

msgid "Show Term not found message"
msgstr "Zobrazit zprávu Termín nenalezen"

msgid "If this is enabled, a message will be displayed when the term is not found."
msgstr "Pokud je tato volba povolena, zobrazí se zpráva, když není hledaný termín nalezen."

msgid "Term not found message."
msgstr "Zpráva Termín nenalezen."

msgid "A message text which will be displayed, if the entered term was not found."
msgstr "Text zprávy, který se zobrazí v případě, že zadaný termín nebyl nalezen."

msgid "Allow new terms"
msgstr "Povolit nové termíny"

msgid "Should it be allowed, that user enter new terms?"
msgstr "Mělo by to být povoleno, když uživatel zadává nové termíny?"

msgid "Empty value message."
msgstr "Zpráva Prázdná hodnota."

msgid "A text message that will be displayed when the field is focused and it does not contain values."
msgstr "Textová zpráva, která se zobrazí, když pole, na němž je fokus, neobsahuje hodnoty."

msgid "Match operator: @match_operator"
msgstr "Operátor shody: @match_operator"

msgid "Limit: @limit"
msgstr "Limit: @limit"

msgid "Min length: @min_length"
msgstr "Minimální délka: @min_length"

msgid "Delimiter: @delimiter"
msgstr "Oddělovač: @delimiter"

msgid "Allow Not Found message: @not_found_message_allow"
msgstr "Povolit zprávu Nenalezeno: @not_found_message_allow"

msgid "Not Found message: @not_found_message"
msgstr "Zpráva Nenalezeno: @not_found_message"

msgid "Allow new terms: @new_terms"
msgstr "Povolit nové termíny: @new_terms"

msgid "Empty value message: @no_empty_message"
msgstr "Zpráva Prázdná hodnota: @no_empty_message"

msgid "@not_found_message"
msgstr "@not_found_message"

msgid "@no_empty_message"
msgstr "@no_empty_message"

msgid "Starts with"
msgstr "Začíná na"

msgid "Contains"
msgstr "Obsahuje"

