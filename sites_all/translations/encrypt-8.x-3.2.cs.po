msgid "Changed key type from \"aes_encryption\" to \"encryption\" for existing keys."
msgstr "Typ klíče byl pro existující klíče změněn z \"aes_encryption\" na \"encryption\"."

msgid "No changes to existing keys were made because there were no keys defined with the \"aes_encryption\" key type."
msgstr "Nebyly provedeny žádné změny existujících klíčů, protože nebyly definované žádné klíče s typem klíče \"aes_encryption\"."

msgid "Added configuration dependencies on keys for existing profiles."
msgstr "Přidány závislosti konfigurace na klíčích pro existující profily."

msgid "No changes were made because there were no profiles without a configuration dependency on their key."
msgstr "Nebyly provedeny žádné změny, protože nebyly k dispozici žádné profily bez závislosti konfigurace na jejich klíči."

msgid "Encrypt"
msgstr "Šifrovat"

msgid "Provides an API for two-way encryption."
msgstr "Poskytuje rozhraní API pro obousměrné šifrování."

msgid "Encryption"
msgstr "Šifrování"

msgid "Add Encryption Profile"
msgstr "Přidat šifrovací profil"

msgid "Encryption profiles"
msgstr "Šifrovací profily"

msgid "Manage profiles that can be used to encrypt and decrypt data."
msgstr "Spravovat profily, které lze použít k šifrování a dešifrování dat."

msgid "List"
msgstr "Seznam"

msgid "Settings"
msgstr "Nastavení"

msgid "Administer encryption settings"
msgstr "Spravovat nastavení šifrování"

msgid "Change encryption settings (does not let them view encrypted data)."
msgstr "Změnit nastavení šifrování (neumožní zobrazit šifrovaná data)."

msgid "Add encryption profile"
msgstr "Přidat šifrovací profil"

msgid "Edit encryption profile"
msgstr "Upravit šifrovací profil"

msgid "Delete encryption profile"
msgstr "Odstranit šifrovací profil"

msgid "Test encryption profile"
msgstr "Testovat šifrovací profil"

msgid "Encrypt settings"
msgstr "Nastavení šifrování"

msgid "Encrypt Profile"
msgstr "Šifrovací profil"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "Popisek"

msgid "Encryption method selected for encryption profile"
msgstr "Metoda šifrování vybraná pro šifrovací profil"

msgid "Encryption method configuration"
msgstr "Konfigurace metody šifrování"

msgid "Key ID for encryption profile"
msgstr "ID klíče pro šifrovací profil"

msgid "Encryption method config"
msgstr "Konfigurace metody šifrování"

msgid "Encrypt Settings"
msgstr "Nastavení šifrování"

msgid "Check profile validation status."
msgstr "Zkontrolovat stav ověření platnosti profilu."

msgid "Deprecated encryption plugins allowed."
msgstr "Povolené zamítnuté moduly plug-in šifrování."

msgid "Encrypt commands"
msgstr "Šifrovat příkazy"

msgid "Interact with the encryption service."
msgstr "Zajistit interakci se šifrovací službou."

msgid "Encryption profile \"@name\" could not be loaded."
msgstr "Šifrovací profil \"@name\" nebylo možné načíst."

msgid "Please specify the encryption profile and the text to be encrypted"
msgstr "Zadejte šifrovací profil a text, který se má zašifrovat"

msgid "Please specify the decryption profile and the encrypted text to be decrypted"
msgstr "Zadejte dešifrovací profil a zašifrovaný text, který se má dešifrovat"

msgid "Please specify the encryption profile to be validated"
msgstr "Uveďte šifrovací profil, který se má ověřit"

msgid "Encryption profile validates successfully."
msgstr "Šifrovací profil byl úspěšně ověřen."

msgid "Encryption profile @profile could not be loaded."
msgstr "Šifrovací profil @profile nelze načíst."

msgid "Encryption method"
msgstr "Metoda šifrování"

msgid "Key"
msgstr "Klíč"

msgid "Status"
msgstr "Stav"

msgid "Error loading encryption method"
msgstr "Chyba při načítání metody šifrování"

msgid "Error loading key"
msgstr "Chyba při načítání klíče"

msgid "The encryption plugin used in this encryption profile is deprecated."
msgstr "Šifrovací modul plug-in použitý v tomto šifrovacím profilu je zamítnutý."

msgid "OK"
msgstr "OK"

msgid "Test"
msgstr "Test"

msgid "No encryption profiles are available. <a href=\":link\">Add a profile</a>."
msgstr "K dispozici nejsou žádné šifrovací profily. <a href=\":link\">Přidat profil</a>."

msgid "No encryption method selected."
msgstr "Není vybrána žádná metoda šifrování."

msgid "No encryption key selected."
msgstr "Není vybrán žádný šifrovací klíč."

msgid "The encryption method linked to this encryption profile does not exist."
msgstr "Metoda šifrování propojená s tímto šifrovacím profilem neexistuje."

msgid "The key linked to this encryption profile does not exist."
msgstr "Klíč propojený s tímto šifrovacím profilem neexistuje."

msgid "The selected key cannot be used with the selected encryption method."
msgstr "Vybraný klíč nelze použít s vybranou metodou šifrování."

msgid "Encryption Profile"
msgstr "Šifrovací profil"

msgid "Show the validation status of encryption profiles."
msgstr "Zobrazit stav ověření platnosti šifrovacích profilů."

msgid "On the encryption profiles overview page, automatically validate each encryption profile to check if there are problems with it. Disable when you have a lot of encryption profiles and are encountering performance issues, or if you do not want encryption keys to be loaded by the status check."
msgstr "Na stránce přehledu šifrovacích profilů automaticky ověřte každý šifrovací profil, abyste zkontrolovali, zda s ním jsou nějaké problémy. Zakažte, pokud máte mnoho šifrovacích profilů a máte problémy s výkonem nebo nechcete, aby byly šifrovací klíče načteny kontrolou stavu."

msgid "Allow the use of deprecated plugins."
msgstr "Povolte použití zamítnutých modulů plug-in."

msgid "Enable this setting to allow the use of deprecated encryption plugins in new profiles. Leave disabled to only allow their use in existing profiles"
msgstr "Povolte toto nastavení, chcete-li povolit použití zamítnutých modulů plug-in šifrování v nových profilech. Ponecháte-li je zakázané, povolte jejich použití v existujících profilech"

msgid "Are you sure you want to delete %name?"
msgstr "Opravdu smazat %name?"

msgid "Delete"
msgstr "Smazat"

msgid "content @type: deleted @label."
msgstr "obsah @type: smazán @label"

msgid "Be extremely careful when editing an encryption profile! It may result in making data encrypted with this profile unreadable. Are you sure you want to edit this profile?"
msgstr "Při úpravě šifrovacího profilu buďte velmi opatrní! Může to vést k tomu, že data zašifrovaná pomocí tohoto profilu budou nečitelná. Opravdu chcete tento profil upravit?"

msgid "Label for the encryption profile."
msgstr "Označení šifrovacího profilu."

msgid "Encryption Method"
msgstr "Metoda šifrování"

msgid "Select the method used for encryption"
msgstr "Vyberte metodu použitou pro šifrování"

msgid "Encryption method settings"
msgstr "Nastavení metody šifrování"

msgid "Encryption Key"
msgstr "Šifrovací klíč"

msgid "Edit"
msgstr "Upravit"

msgid "Cancel"
msgstr "Zrušit"

msgid "Saved the %label encryption profile."
msgstr "Uložený šifrovací profil %label."

msgid "The %label encryption profile was not saved."
msgstr "Šifrovací profil %label nebyl uložen."

msgid "Encryption test"
msgstr "Test šifrování"

msgid "Text to encrypt"
msgstr "Text k zašifrování"

msgid "Specify the text you want to encrypt with this encryption profile. The result of the encryption will be shown below."
msgstr "Zadejte text, který chcete zašifrovat pomocí tohoto šifrovacího profilu. Výsledek šifrování bude zobrazen níže."

msgid "Base64-encode the encrypted text."
msgstr "Kódování Base64 zašifrovaného textu."

msgid "Encrypted text"
msgstr "Zašifrovaný text"

msgid "Decryption test"
msgstr "Test dešifrování"

msgid "Text to decrypt"
msgstr "Text k dešifrování"

msgid "Specify the text you want to decrypt with this encryption profile. The result of the decryption will be shown below."
msgstr "Uveďte text, který chcete dešifrovat pomocí tohoto šifrovacího profilu. Výsledek dešifrování bude zobrazen níže."

msgid "Base64-decode the encrypted text before decrypting."
msgstr "Dekódování Base64 zašifrovaného textu před dešifrováním."

msgid "Decrypt"
msgstr "Dešifrovat"

msgid "Decrypted text"
msgstr "Dešifrovaný text"

