msgid "About"
msgstr "소개"

msgid "<a href=':crop'>Crop</a> provides basic API for image cropping. This module won't do much by itself. Users should pick one of UI modules that utilize this API.</a>"
msgstr "<a href=':crop'>Crop</a>은 이미지를 자르기 위한 기본 API를 제공합니다. 이 모듈은 단독으로 많은 작업을 수행하지 않습니다. 사용자가 이 API를 활용하는 UI 모듈 중 하나를 선택해야 합니다.</a>"

msgid "Configuration"
msgstr "환경 설정"

msgid "This is API module. In order to crop your images you need a UI module. There are currently two UI modules that use Crop API:"
msgstr "이는 API 모듈입니다. 이미지를 자르려면 UI 모듈이 필요합니다. 현재 Crop API를 사용하는 두 개의 UI 모듈이 있습니다."

msgid "<a href=\":image_widget_crop\">Image widget crop</a>"
msgstr "<a href=\":image_widget_crop\">이미지 위젯 자르기</a>"

msgid "<a href=\":focal_point\">Focal point</a>"
msgstr "<a href=\":focal_point\">초점</a>"

msgid "Technical details"
msgstr "기술 세부사항"

msgid "Initial discussion can be found on <a href=\":manual\">manual crop issue queue</a>."
msgstr "<a href=\":manual\">수동 자르기 문제 큐</a>에서 초기 토론을 찾을 수 있습니다."

msgid "Crop configuration"
msgstr "자르기 구성"

msgid "There are no file or image fields on this bundle at the moment. In order to configure crop add at least one such field and come back."
msgstr "바로 지금 이 번들에 파일이나 이미지 필드가 없습니다. 자르기를 구성하려면 하나 이상의 그런 필드를 추가하고 돌아오십시오. "

msgid "Image field"
msgstr "이미지 필드"

msgid "- Skip field -"
msgstr "- 필드 건너뛰기 -"

msgid "Select field that stores image which needs to be cropped."
msgstr "자를 필요가 있는 이미지를 저장하는 필드를 선택하십시오. "

msgid "Crop API"
msgstr "자르기 API"

msgid "This branch of Crop API is not compatible with the version of Media Entity installed."
msgstr "이 Crop API 분기는 설치된 Media Entity 버전과 호환되지 않습니다."

msgid "Provides storage and API for image crops."
msgstr "이미지 자르기를 위한 스토리지와 API를 제공합니다. "

msgid "Media"
msgstr "미디어"

msgid "Add crop type"
msgstr "자르기 유형 추가"

msgid "Crop types"
msgstr "자르기 유형"

msgid "Manage crop types."
msgstr "매체 자르기 유형입니다. "

msgid "Administer crop settings"
msgstr "자르기 설정 관리"

msgid "Administer the basic settings for Crop API."
msgstr "자르기 API의 기본 설정을 관리합니다. "

msgid "Administer crop types"
msgstr "자르기 유형 관리"

msgid "Administer crop types."
msgstr "자르기 유형을 관리합니다. "

msgid "Delete"
msgstr "삭제하기"

msgid "Crop type"
msgstr "자르기 유형"

msgid "Name"
msgstr "이름"

msgid "Machine-readable name"
msgstr "기계명"

msgid "Description"
msgstr "설명"

msgid "Aspect ratio"
msgstr "가로 세로 비율"

msgid "Soft limit width"
msgstr "소프트 한계 너비"

msgid "Soft limit height"
msgstr "소프트 한계 높이"

msgid "Hard limit width"
msgstr "하드 한계 너비"

msgid "Hard limit height"
msgstr "하드 한계 높이"

msgid "Third party settings"
msgstr "서드 파티 설정"

msgid "Crop settings"
msgstr "자르기 설정"

msgid "Field storing image to be cropped"
msgstr "자를 이미지를 저장하는 필드"

msgid "Crop effect configuration"
msgstr "자르기 영향 구성"

msgid "Automatic crop provider"
msgstr "자동 크롭 제공자"

msgid "Crop API settings"
msgstr "자르기 API 설정"

msgid "Indicates whether to flush image derivatives when a crop entity is change"
msgstr "자르기 엔티티가 변경될 때 이미지 변종을 비울지 여부를 나타냅니다. "

msgid "Media entity crop"
msgstr "매체 엔티티 자르기"

msgid "Deprecated."
msgstr "더 이상 사용되지 않습니다."

msgid "Aspect Ratio"
msgstr "가로 세로 비율"

msgid "Used in"
msgstr "사용 위치"

msgid "@first, @second and @count more"
msgstr "@first, @second 및 @count 추가"

msgid "No crop types available. <a href=\"@link\">Add crop type</a>."
msgstr "사용 가능한 자르기 유형이 없습니다. <a href=\"@link\">자르기 유형을 추가</a>하십시오. "

msgid "Entity provider @id not found."
msgstr "엔티티 제공자 @id를 찾을 수 없습니다. "

msgid "Crop ID"
msgstr "자르기 ID"

msgid "The crop ID."
msgstr "자르기 ID입니다. "

msgid "UUID"
msgstr "UUID"

msgid "The crop UUID."
msgstr "자르기 UUID입니다. "

msgid "Revision ID"
msgstr "개정본 ID"

msgid "The crop revision ID."
msgstr "자르기 개정 ID입니다. "

msgid "Type"
msgstr "종류"

msgid "The crop type."
msgstr "자르기 유형입니다. "

msgid "Language code"
msgstr "언어 코드"

msgid "The node language code."
msgstr "노드 언어 코드입니다. "

msgid "Entity ID"
msgstr "엔터티 ID"

msgid "ID of entity crop belongs to."
msgstr "자르기가 속하는 엔티티의 ID입니다. "

msgid "Entity type"
msgstr "엔터티 유형"

msgid "The type of entity crop belongs to."
msgstr "자르기가 속하는 엔티티의 유형입니다. "

msgid "URI"
msgstr "URI"

msgid "The URI of the image crop belongs to."
msgstr "자르기가 속하는 이미지의 URI입니다. "

msgid "Height"
msgstr "높이"

msgid "The crop height."
msgstr "자르기 높이입니다. "

msgid "Width"
msgstr "너비"

msgid "The crop width."
msgstr "자르기 너비입니다. "

msgid "X coordinate"
msgstr "X 좌표"

msgid "The crop's X coordinate."
msgstr "자르기의 X 좌표입니다. "

msgid "Y coordinate"
msgstr "Y 좌표"

msgid "The crop's Y coordinate."
msgstr "자르기의 Y 좌표입니다. "

msgid "Revision timestamp"
msgstr "개정판 생성 타임스탬프"

msgid "The time that the current revision was created."
msgstr "현재 개정판이 작성된 시간입니다."

msgid "Revision author ID"
msgstr "개정판 작성자 ID"

msgid "The user ID of the author of the current revision."
msgstr "현재 개정판 작성자의 사용자 ID입니다."

msgid "Revision Log"
msgstr "개정 로그"

msgid "The log entry explaining the changes in this revision."
msgstr "이 개정판에서 변경사항을 설명하는 로그 항목입니다."

msgid "Crop"
msgstr "자르기"

msgid "Are you sure you want to delete the crop type %type?"
msgstr "자르기 유형 %type을(를) 삭제하시겠습니까? "

msgid "The crop type %name has been deleted."
msgstr "자르기 유형 %name이(가) 삭제되었습니다. "

msgid "Deleted crop type %name."
msgstr "자르기 유형 %name을(를) 삭제했습니다. "

msgid "%type is used by 1 piece of content on your site. You can not remove this content type until you have removed all of the %type content."
msgid_plural "%type is used by @count pieces of content on your site. You may not remove %type until you have removed all of the %type content."
msgstr[0] "%type이(가) 사이트에서 컨텐츠의 @count개 부분에서 사용됩니다. %type을(를) 제거하려면 모든 %type 컨텐츠를 제거해야 합니다. "

msgid "Edit %label crop type"
msgstr "%label 자르기 유형 편집"

msgid "The human-readable name of this crop type. This name must be unique."
msgstr "이 자르기 유형의 사람이 읽을 수 있는 이름입니다. 이 이름은 고유해야 합니다. "

msgid "A unique machine-readable name for this crop type. It must only contain lowercase letters, numbers, and underscores."
msgstr "이 자르기 유형에 대한 고유한 머신 판독 가능 이름입니다. 이는 소문자, 숫자 및 밑줄만을 포함해야 합니다. "

msgid "Describe this crop type."
msgstr "이 자르기 유형을 설명합니다. "

msgid "Set an aspect ratio <b>eg: 16:9</b> or leave this empty for arbitrary aspect ratio"
msgstr "가로 세로 비율(<b>예: 16:9</b>)을 설정하거나 임의 가로 세로 비율의 경우 공백으로 두십시오. "

msgid "Soft limit"
msgstr "소프트 한계"

msgid "Define crop size soft limit. Warning will be displayed if crop smaller than that is selected."
msgstr "자르기 크기 소프트 한계를 정의하십시오. 그보다 작은 자르기가 선택되는 경우 경고가 표시됩니다. "

msgid "Limit for width."
msgstr "너비 한계입니다. "

msgid "Limit for height."
msgstr "높이 한계입니다. "

msgid "Hard limit"
msgstr "하드 한계"

msgid "Define crop size hard limit. User is not allowed to make a smaller selection than defined here."
msgstr "자르기 크기 하드 한계를 정의하십시오. 사용자는 여기에서 정의된 것보다 작은 선택을 할 수 없습니다. "

msgid "Limit for width"
msgstr "너비 한계"

msgid "Save crop type"
msgstr "자르기 유형 저장"

msgid "Delete crop type"
msgstr "자르기 유형 삭제"

msgid "The crop type %name has been updated."
msgstr "자르기 유형 %name이(가) 업데이트되었습니다. "

msgid "The crop type %name has been added."
msgstr "자르기 유형 %name이(가) 추가되었습니다. "

msgid "View"
msgstr "화면"

msgid "Added crop type %name."
msgstr "자르기 유형 %name을(를) 추가했습니다. "

msgid "File"
msgstr "파일"

msgid "Provides crop integration for core files."
msgstr "코어 파일에 대한 자르기 통합을 제공합니다. "

msgid "Provides crop integration for media."
msgstr "매체에 대해 크롭 통합을 제공합니다."

msgid "Crop type to be used for the image style."
msgstr "이미지 스타일에 사용될 자르기 유형입니다. "

msgid "- Select a Provider -"
msgstr "- 제공자 선택 -"

msgid "The name of automatic crop provider to use if crop is not set for an image."
msgstr "이미지에 대해 크롭이 설정되지 않은 경우에 사용할 자동 크롭 제공자의 이름입니다."

msgid "Manual image crop failed due to misconfigured crop type on %path."
msgstr "%path에서 잘못 구성된 자르기 유형으로 인해 수동 이미지 자르기에 실패했습니다. "

msgid "Manual image crop failed using the %toolkit toolkit on %path (%mimetype, %width x %height)"
msgstr "%path(%mimetype, %width x %height)에서 %toolkit 툴킷을 사용한 수동 이미지 자르기에 실패했습니다. "

msgid "Manual crop"
msgstr "수동 자르기"

msgid "Applies manually provided crop to the image."
msgstr "이미지에 수동으로 제공되는 자르기를 적용합니다. "

msgctxt "Validation"
msgid "Crop Type aspect ratio"
msgstr "자르기 유형 가로 세로 비율"

msgid "Invalid aspect ratio format. Should be defined in H:W form."
msgstr "올바르지 않은 가로 세로 비율 형식입니다. H:W 양식으로 정의되어야 합니다. "

msgctxt "Validation"
msgid "Crop Type machine name"
msgstr "자르기 유형 머신 이름"

msgid "Invalid machine-readable name."
msgstr "올바르지 않은 머신 판독 가능 이름입니다. "

msgid "uses <em>@data.crop_type</em> crop type"
msgstr "<em>@data.crop_type</em> 자르기 유형을 사용합니다. "

