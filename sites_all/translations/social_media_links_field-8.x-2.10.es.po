msgid "Social Media Links Field"
msgstr "Campo de enlaces a redes sociales"

msgid "The module provides a field type to capture social media profiles."
msgstr "El módulo proporciona un tipo de campo para capturar los perfiles de las redes sociales."

msgid "Platform"
msgstr "Plataforma"

msgid "Appearance"
msgstr "Aspecto"

msgid "Orientation"
msgstr "Orientación"

msgid "vertical"
msgstr "vertical"

msgid "horizontal"
msgstr "horizontal"

msgid "Show name"
msgstr "Mostrar nombre"

msgid "Show the platform name next to the icon."
msgstr "Mostrar el nombre de la plataforma junto al icono."

msgid "Link attributes"
msgstr "Atributos del enlace"

msgid "Default target"
msgstr "Destino predeterminado"

msgid "Remove target attribute"
msgstr "Eliminar atributo de destino"

msgid "Open in a new browser window or tab (_blank)"
msgstr "Abrir en una nueva ventana o pestaña de navegador (_blank)"

msgid "Open in the current window (_self)"
msgstr "Abrir en la ventana actual (_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "Abrir en el marco que es superior al marco en el que se encuentra el enlace (_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "Cancelar todos los marcos y abrir en una ventana completa del navegador (_top)"

msgid "Default rel"
msgstr "Rel predeterminada"

msgid "Remove rel attribute"
msgstr "Eliminar atributo rel"

msgid "Set nofollow"
msgstr "Establecer nofollow"

msgid "Orientation: @orientation"
msgstr "Orientación: @orientation"

msgid "Yes"
msgstr "Sí"

msgid "No"
msgstr "No"

msgid "Show name: @show_name"
msgstr "Mostrar nombre: @show_name"

msgid "Default"
msgstr "Valor predeterminado"

msgid "Value"
msgstr "Valor"

msgid "Platform Values"
msgstr "Valores de plataforma"

msgid "Icon Style"
msgstr "Estilo de icono"

msgid "Description"
msgstr "Descripción"

msgid "Weight"
msgstr "Peso"

msgid "Platforms"
msgstr "Plataformas"

msgid "The platforms that are allowed to be used in this field. Select none to allow all platforms."
msgstr "Las plataformas que pueden utilizarse en este campo. No seleccione ninguna para permitir todas las plataformas."

msgid "The description is used for the title and WAI-ARIA attribute."
msgstr "Descripción usada en el título y en el atributo WAI-ARIA."

msgid "Find / Follow us on %platform"
msgstr "Encuéntrenos / Síganos en %platform"

msgid "Weight for type @type"
msgstr "Peso del tipo @type"

msgid "Handle links to social media profiles."
msgstr "Manejar enlaces a perfiles de redes sociales."

msgid "List with all available platforms"
msgstr "Listar con todas las plataformas disponibles"

msgid "One available platform (selectable)"
msgstr "Una plataforma disponible (seleccionable)"

