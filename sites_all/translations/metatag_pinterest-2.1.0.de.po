msgid "Metatag: Pinterest"
msgstr "Metatag: Pinterest"

msgid "Provides support for Pinterest's custom meta tags."
msgstr "Bietet Unterstützung für die angepassten Meta-Tags von Pinterest."

msgid "SEO"
msgstr "SEO"

msgid "Pinterest: Description"
msgstr "Pinterest: Description"

msgid "Pinterest: ID"
msgstr "Pinterest: ID"

msgid "Pinterest: Media"
msgstr "Pinterest: Media"

msgid "Pinterest: No hover"
msgstr "Pinterest: No hover"

msgid "Pinterest: No pin"
msgstr "Pinterest: No pin"

msgid "Pinterest: No search"
msgstr "Pinterest: No search"

msgid "Pinterest: URL"
msgstr "Pinterest: URL"

msgid "Pinterest"
msgstr "Pinterest"

msgid "A set of meta tags used to control how the site's content is consumed by <a href='https://pinterest.com/'>Pinterest</a>."
msgstr "Eine Gruppe von Meta-Tags, die verwendet werden, um zu steuern, wie der Inhalt der Site von <a href='https://pinterest.com/'>Pinterest</a> verarbeitet wird."

msgid "Description"
msgstr "Beschreibung"

msgid "A one to two sentence description of the content."
msgstr "Eine Beschreibung des Inhalts in ein bis zwei Sätzen."

msgid "Id"
msgstr "ID"

msgid "The Canonical Pinterest object to pin."
msgstr "Das zu verlinkende kanonische Pinterest-Objekt."

msgid "Media"
msgstr "Medien"

msgid "The URL of media which should represent the content."
msgstr "Die URL von Medien, die den Inhalt darstellen sollte."

msgid "No hover"
msgstr "No hover"

msgid "Do not show hovering Save or Search buttons, generated by the Pinterest browser extensions."
msgstr "Keine von den Pinterest-Browsererweiterungen generierten 'Speichern'- oder 'Suchen'-Kurzinfoschaltflächen anzeigen."

msgid "No pin"
msgstr "No pin"

msgid "Do not pin anything from this page. When selected, this option will take precedence over all options below."
msgstr "Nichts aus dieser Seite pinnen. Wenn diese Option ausgewählt ist, hat sie Vorrang vor allen Optionen unten."

msgid "No search"
msgstr "No search"

msgid "Do not allow Pinterest visual search to happen from this page."
msgstr "Nicht zulassen, dass eine visuelle Pinterest-Suche von dieser Seite aus erfolgt."

msgid "URL"
msgstr "URL"

msgid "The URL which should represent the content."
msgstr "Die URL, die den Inhalt darstellen sollte."

