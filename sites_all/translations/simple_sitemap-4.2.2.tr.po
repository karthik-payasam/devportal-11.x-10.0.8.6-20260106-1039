msgstr "Varsayılan site haritası üreteci"

msgid "Generates a standard conform hreflang sitemap of your content."
msgstr "İçeriğinizin standart uyumlu hreflang site haritasını oluşturur."

msgid "Sitemap index generator"
msgstr "Site haritası dizin oluşturucu"

msgid "Generates an index of your sitemaps."
msgstr "Site haritalarınızın dizinini oluşturur."

msgid "Arbitrary URL generator"
msgstr "Rastgele URL oluşturucu"

msgid "Generates URLs from data sets collected in the hook_arbitrary_links_alter hook."
msgstr "hook_arbitrary_links_alter hook içinde toplanan veri kümelerinden URL'ler oluşturur."

msgid "Custom URL generator"
msgstr "Özel URL oluşturucu"

msgid "Generates URLs set in admin/config/search/simplesitemap/custom."
msgstr "admin/config/search/simplesitemap/custom dizininde ayarlanan URL'ler oluşturur."

msgid "Menu link URL generator"
msgstr "Menü bağlantısı URL oluşturucu"

msgid "Generates menu link URLs by overriding the 'entity' URL generator."
msgstr "'entity' URL oluşturucusunu geçersiz kılarak menü bağlantısı URL'leri oluşturur."

msgid "Entity URL generator"
msgstr "Varlık URL'si oluşturucu"

msgid "Generates URLs for entity bundles and bundle overrides."
msgstr "Varlık paketleri ve paket geçersiz kılmaları için URL'ler oluşturur."

msgid "Sitemap URL generator"
msgstr "Site haritası URL oluşturucu"

msgid "Generates sitemap URLs for a sitemap index."
msgstr "Bir site haritası dizini için site haritası URL'lerini oluşturur."

