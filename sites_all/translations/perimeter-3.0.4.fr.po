msgid "Allowlist skipping ban: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Interdiction d'ignorer la liste autorisée : %ip pour %type défectueux sur %form <br />Source : %source <br /> Agent utilisateur : %browser"

msgid "Banned: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Interdit : %ip pour l'échec de %type sur %form <br />Source : %source <br /> Agent utilisateur : %browser"

msgid "Drupal Perimeter Defence"
msgstr "Défense du périmètre Drupal"

msgid "Immediately ban hackers when they try to scan the site."
msgstr "Interdit immédiatement l'accès aux pirates informatiques lorsqu'ils essaient d'analyser le site."

msgid "Perimeter defence settings"
msgstr "Paramètres de Perimeter Defence"

msgid "Configure the settings for Drupal Perimeter Defence."
msgstr "Configurer les paramètres pour Drupal Perimeter Defence."

msgid "Bypass Perimeter Defence ban rules"
msgstr "Passer outre les règles d'interdiction de Perimeter Defence"

msgid "Allow users to bypass the rules defined by Perimeter Defence module."
msgstr "Permettre aux utilisateurs de passer outre les règles définies par le module Perimeter Defence."

msgid "Perimeter settings"
msgstr "Paramètres de Perimeter"

msgid "Perimeter Settings"
msgstr "Paramètres de Perimeter"

msgid "A list of regex patterns"
msgstr "Liste des modèles d'expression régulière"

msgid "A regex pattern"
msgstr "Modèle d'expression régulière"

msgid "Banned: %ip for requesting %pattern <br />Source: %source <br /> User Agent: %browser"
msgstr "Interdit : %ip pour demander %pattern <br />Source : %source <br /> Agent utilisateur : %browser"

msgid "Perimeter will ban any user that generates \"404 - File not found\" for requesting any of the following url pattern"
msgstr "Perimeter interdit tout utilisateur qui génère une erreur \"404 - File not found\" pour avoir demandé l'un des masques d'URL suivants"

msgid "Ban URL patterns"
msgstr "Interdire des masques d'URL"

msgid "A list of regex patterns, each pattern on a separate line"
msgstr "Liste des modèles d'expression régulière, chaque modèle sur une ligne distincte"

