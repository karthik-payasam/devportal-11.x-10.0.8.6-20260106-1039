msgid "Schema.org: Person"
msgstr "Schema.org: Person"

msgid "An additional name for a Person, can be used for a middle name."
msgstr "Un nombre adicional para una persona, se puede utilizar como segundo nombre."

msgid "Physical address of the person."
msgstr "Dirección física de la persona."

msgid "An organization that this person is affiliated with. For example, a school/university, a club, or a team."
msgstr "Una organización a la que esta persona está afiliada. Por ejemplo, una escuela/universidad, un club o un equipo."

msgid "An alias for the person."
msgstr "Un alias de la persona."

msgid "birthDate"
msgstr "birthDate"

msgid "Date of birth of the person in ISO 8601 format, 2017-12-31."
msgstr "Fecha de nacimiento de la persona en formato ISO 8601, 2017-12-31."

msgid "The brand of the person."
msgstr "La marca de la persona."

msgid "A description of the person."
msgstr "Una descripción de la persona."

msgid "The email address of the person."
msgstr "La dirección de correo electrónico de la persona."

msgid "familyName"
msgstr "familyName"

msgid "Family name. In the U.S., the last name of an Person. This can be used along with givenName instead of the name property."
msgstr "Nombre de familia. En los Estados Unidos, el apellido de una persona. Esto se puede utilizar conjuntamente con givenName en lugar de la propiedad name."

msgid "Gender of the person."
msgstr "Sexo de la persona."

msgid "givenName"
msgstr "givenName"

msgid "Given name. In the U.S., the first name of a Person. This can be used along with familyName instead of the name property."
msgstr "Nombre de pila. En los Estados Unidos, el nombre de una persona. Esto se puede utilizar conjuntamente con familyName en lugar de la propiedad name."

msgid "Globally unique id of the person, usually a url."
msgstr "ID exclusivo global de la persona, normalmente un url."

msgid "The primary image for the person."
msgstr "La imagen primaria de la persona."

msgid "jobTitle"
msgstr "jobTitle"

msgid "The job title of the person (for example, Financial Manager)."
msgstr "El puesto de trabajo de la persona (por ejemplo, Gestor financiero)."

msgid "memberOf"
msgstr "memberOf"

msgid "An Organization (or ProgramMembership) to which this Person belongs."
msgstr "Una organización (o ProgramMembership) a la que esta persona pertenece."

msgid "REQUIRED BY GOOGLE. The name of the person."
msgstr "NECESARIO PARA GOOGLE. El nombre de la persona."

msgid "REQUIRED BY GOOGLE. A single or an [array] of URLs for the person's official social media profile page(s)."
msgstr "NECESARIO PARA GOOGLE. Un solo URL o una [matriz] de ellos para la página o las páginas de perfil de redes sociales oficial de la persona."

msgid "The telephone number of the person."
msgstr "El número de teléfono de la persona."

msgid "REQUIRED. The type of person (fixed by standard)."
msgstr "OBLIGATORIO. El tipo de persona (fijado por estándar)."

msgid "REQUIRED BY GOOGLE. The URL for the person's official website."
msgstr "NECESARIO PARA GOOGLE. El URL del sitio web oficial de la persona."

msgid "worksFor"
msgstr "worksFor"

msgid "Organizations that the person works for."
msgstr "Organizaciones para las que la persona trabaja."

