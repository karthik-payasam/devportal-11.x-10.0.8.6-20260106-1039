msgid "Chaos Tools Views"
msgstr "Visualizações de Ferramentas do Chaos"

msgid "A set of improvements to the core Views code that allows for greater control over Blocks."
msgstr "Um conjunto de melhorias para o código das Visualizações principais que permite mais controle sobre Blocos."

msgid "Chaos tool suite (Experimental)"
msgstr "Conjunto de ferramentas Chaos (Experimental)"

msgid "Items per page"
msgstr "Itens por página"

msgid "Pager offset"
msgstr "Deslocamento do paginador"

msgid "Pager type"
msgstr "Tipo de paginador"

msgid "Hide fields"
msgstr "Ocultar campos"

msgid "Reorder fields"
msgstr "Reordenar campos"

msgid "Configure filters"
msgstr "Configurar filtros"

msgid "Disable filters"
msgstr "Desativar filtros"

msgid "Configure sorts"
msgstr "Configurar classificações"

msgid "Allow settings"
msgstr "Permitir configurações"

msgid "None"
msgstr "Nenhum"

msgid "For example, set this to 3 and the first 3 items will not be displayed."
msgstr "Por exemplo, configure-o para 3 e os três primeiros itens não serão exibidos."

msgid "Inherit from view"
msgstr "Herdar da visualização"

msgid "Display a specified number of items"
msgstr "Exibir um número específico de itens"

msgid "Display all items"
msgstr "Exibir todos os itens"

msgid "Pager"
msgstr "Pager"

msgid "Hide"
msgstr "Ocultar"

msgid "Label"
msgstr "Rótulo"

msgid "Weight"
msgstr "Peso"

msgid "Weight for @title"
msgstr "Peso para @title"

msgid "Exposed filter values"
msgstr "Valores de filtro expostos"

msgid "If a value is set for an exposed filter, it will be removed from the block display."
msgstr "Se um valor for configurado para um filtro exposto, ele será removido da exibição de bloco."

msgid "Expose filter value to user"
msgstr "Expor o valor de filtro ao usuário"

msgid "Expose this filter value to visitors? If so, the value set here will be the default."
msgstr "Expor este valor de filtro aos visitantes? Se sim, o valor configurado aqui será o padrão."

msgid "Expose filter operator to user"
msgstr "Expor o operador de filtro ao usuário"

msgid "Expose this filter's operator to visitors? If so, the operator set here will be the default."
msgstr "Expor o operador deste filtro aos visitantes? Neste caso, o operador configurado aqui será o padrão."

msgid "Disable filter: @handler"
msgstr "Desativar filtro: @handler"

msgid "Sort ascending"
msgstr "Classificar Ascendente"

msgid "Sort descending"
msgstr "Classificar na ordem descendente"

msgid "Order"
msgstr "Pedido"

