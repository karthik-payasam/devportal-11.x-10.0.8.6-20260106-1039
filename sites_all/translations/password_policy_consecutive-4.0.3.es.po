msgid "Password Consecutive Characters Policy"
msgstr "Política de caracteres consecutivos de contraseña"

msgid "Sets up a consecutive characters constraint for passwords."
msgstr "Configura una restricción de caracteres consecutivos para contraseñas."

msgid "Security"
msgstr "Seguridad"

msgid "Maximum consecutive character count"
msgstr "Recuento máximo de caracteres consecutivos"

msgid "Invalid plugin configuration."
msgstr "Configuración de plugin no válida."

msgid "No consecutive identical characters are allowed."
msgstr "No se permiten caracteres idénticos consecutivos."

msgid "Password must have fewer than @max consecutive identical characters. This is case sensitive."
msgstr "La contraseña debe tener menos de @max caracteres idénticos consecutivos. Esto es sensible a las mayúsculas y minúsculas."

msgid "Consecutive identical characters fewer than: @max"
msgstr "Caracteres idénticos consecutivos menores que: @max"

msgid "Consecutive identical characters fewer than"
msgstr "Caracteres idénticos consecutivos menores que"

msgid "This many or more consecutive identical characters will not be allowed in the password."
msgstr "No se permitirá esta cantidad, o más, de caracteres idénticos consecutivos en la contraseña."

msgid "The number of consecutive identical characters must be higher than 1 otherwise all passwords will fail."
msgstr "El número de caracteres idénticos consecutivos debe ser mayor que 1, de lo contrario todas las contraseñas fallarán."

msgid "Consecutive characters"
msgstr "Caracteres consecutivos"

msgid "Verifying that a password has a maximum number of consecutive identical characters."
msgstr "Verificando que una contraseña tiene un número máximo de caracteres idénticos consecutivos."

msgid "Your password has too many consecutive characters."
msgstr "La contraseña tiene demasiados caracteres consecutivos."

