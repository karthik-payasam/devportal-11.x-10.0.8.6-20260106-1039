msgid "Client-side Hierarchical Select"
msgstr "Selección jerárquica del lado del cliente"

msgid "A simple client-side hierarchical select widget for taxonomy terms."
msgstr "Widget de selección jerárquica del lado del cliente de términos taxonómicos."

msgid "Widgets"
msgstr "Controles"

msgid "CSHS field widget settings"
msgstr "Valores del widget del campo CSHS"

msgid "Save lineage"
msgstr "Guardar linaje"

msgid "Force selection of deepest level"
msgstr "Forzar selección del nivel más profundo"

msgid "Parent"
msgstr "Padre"

msgid "Labels per hierarchy-level"
msgstr "Etiquetas por nivel jerárquico"

msgid "Hierarchy depth"
msgstr "Profundidad de jerarquía"

msgid "Required depth"
msgstr "Profundidad necesaria"

msgid "The \"no selection\" label"
msgstr "La etiqueta \"no selection\""

msgid "Client-side Hierarchical Select: Menu Link"
msgstr "Selección jerárquica del lado del cliente: Enlace de menú"

msgid "A client-side hierarchical selection of parents for the menu link. Works for node and term forms (with \"taxonomy_menu_ui\" enabled)."
msgstr "Una selección jerárquica del lado del cliente de los padres para el enlace de menú. Funciona para los formularios de nodo y término (con \"taxonomy_menu_ui\" habilitado)."

msgid "Deepest"
msgstr "Más profundo"

msgid "None"
msgstr "Ninguno"

msgid "Yes"
msgstr "Sí"

msgid "No"
msgstr "No"

msgid "Parent: @parent"
msgstr "Padre: @parent"

msgid "Force deepest: @force_deepest"
msgstr "Forzar profundidad máxima: @force_deepest"

msgid "Save lineage: @save_lineage"
msgstr "Guardar linaje: @save_lineage"

msgid "Level labels: @level_labels"
msgstr "Etiquetas de nivel: @level_labels"

msgid "The \"no selection\" label: @none_label"
msgstr "La etiqueta \"no selection\": @none_label"

msgid "Select a parent term to use only a subtree of a vocabulary for this field."
msgstr "Seleccione un término padre para usar únicamente subárbol de un vocabulario para este campo."

msgid "Force the deepest level selection"
msgstr "Forzar la selección de nivel más profundo"

msgid "If checked the user will be forced to select terms from the deepest level."
msgstr "Si se selecciona, se forzará al usuario a seleccionar términos del nivel más profundo."

msgid "Enter labels for each hierarchy-level separated by comma."
msgstr "Especifique etiquetas para cada nivel jerárquico separadas por comas."

msgid "The label for an empty option."
msgstr "La etiqueta para una opción vacía."

msgid "The hierarchy depth cannot be @actual because the selection list has @levels levels."
msgstr "La profundidad de jerarquía no puede ser @actual porque la lista de selección tiene @levels niveles."

msgid "The required depth cannot be greater than the hierarchy depth."
msgstr "La profundidad necesaria no puede ser mayor que la profundidad de la jerarquía."

msgid "Format"
msgstr "Formato"

msgid "Specify a format for each field item by using tokens."
msgstr "Especifique un formato para cada elemento de campo utilizando tokens."

msgid "Clear Tokens"
msgstr "Borrar señales"

msgid "Remove token from final text if no replacement value is generated"
msgstr "Eliminar señal del texto final si no se genera ningún valor de sustitución"

msgid "Format: @format"
msgstr "Formato: @format"

msgid "Flexible hierarchy"
msgstr "Jerarquía flexible"

msgid "Allows to specify the output with tokens."
msgstr "Permite especificar la salida con tokens."

msgid "Link to term page"
msgstr "Enlazar la pagina del termino"

msgid "Reverse order view"
msgstr "Vista de orden inverso"

msgid "Outputs hierarchy in reverse order (the deepest level first)."
msgstr "Genera una jerarquía en orden inverso (el nivel más profundo en primer lugar)."

msgid "Linked to term page: @linked"
msgstr "Enlazado a página de términos: @linked"

msgid "Reverse order view: @reverse"
msgstr "Vista de orden inverso: @reverse"

msgid "Separator"
msgstr "Separador"

msgid "Specify a separator which will be placed in between the different hierarchy levels."
msgstr "Especifique el separador que se va a colocar entre los distintos niveles jerárquicos."

msgid "Separator: @separator"
msgstr "Separador: @separator"

msgid "Full hierarchy"
msgstr "Jerarquía completa"

msgid "Display the full hierarchy of the taxonomy term."
msgstr "Mostrar la jerarquía completa del término de taxonomía."

msgid "Sorting"
msgstr "Ordenando"

msgid "Depth"
msgstr "Profundidad"

msgid "The maximum hierarchy depth. Use 0 to not limit or 1 to display just the root term (or the last if reverse order selected)."
msgstr "La profundidad máxima de jerarquía. Utilice 0 para no limitar o 1 para mostrar sólo el término raíz (o el último si se ha seleccionado el orden inverso)."

msgid "Last child"
msgstr "Último hijo"

msgid "Show only the root term and its deepest child."
msgstr "Mostrar solo el término raíz y su hijo más profundo."

msgid "Sorting: @value"
msgstr "Ordenación: @value"

msgid "Depth: @value"
msgstr "Profundidad: @value"

msgid "Last child only"
msgstr "Solo último hijo"

msgid "Unlimited"
msgstr "Ilimitado"

msgid "Hierarchy grouped by root"
msgstr "Jerarquía agrupada por raíz"

msgid "Display the hierarchy of the taxonomy term grouped by root."
msgstr "Mostrar la jerarquía del término de taxonomía agrupada por raíz."

msgid "Client-side hierarchical select"
msgstr "Selección jerárquica del lado del cliente"

msgid "An invalid vocabulary is selected. Please change it in the options."
msgstr "Se ha seleccionado un vocabulario no válido. Por favor, cambielo en las opciones."

msgid "About"
msgstr "Acerca de"

msgid "Settings"
msgstr "Configuración"

msgid "Multi-lingual"
msgstr "Multilingüe"

msgid "Supports multi-lingual terms localized with i18n_taxonomy module (Which is part of the i18n package)."
msgstr "Soporta términos multilingües localizados con el módulo i18n_taxonomy (que forma parte del paquete i18n)."

