msgid "Field encryption"
msgstr "Šifrování pole"

msgid "Warning: changing field encryption settings may cause data corruption!<br />When changing these settings, existing fields will be (re)encrypted in batch according to the new settings. <br />Make sure you have a proper backup, and do not perform this action in an environment where the data will be changing during the batch operation, to avoid data loss."
msgstr "Varování: Změna nastavení šifrování pole může způsobit poškození dat! <br />Při změně těchto nastavení budou existující pole v dávce zašifrována podle nových nastavení. <br />Ujistěte se, že máte řádnou zálohu, a neprovádějte tuto akci v prostředí, kde se data během dávkové operace mění, aby se zabránilo ztrátě dat. "

msgid "Encrypt field"
msgstr "Zašifrovat pole"

msgid "Makes the field storage encrypted."
msgstr "Zajišťuje zašifrování úložného prostoru pole."

msgid "Properties"
msgstr "Vlastnosti"

msgid "Specify the field properties to encrypt."
msgstr "Zadejte vlastnosti pole k zašifrování."

msgid "Field Encrypt"
msgstr "Šifrování pole"

msgid "Update to field_encrypt version 3 is not supported."
msgstr "Aktualizace na pole field_encrypt verze 3 není podporována."

msgid "In order to upgrade you need to decrypt all your data on the previous version and uninstall the module."
msgstr "Chcete-li přejít na vyšší verzi, musíte dešifrovat všechna data na předchozí verzi a odinstalovat modul."

msgid "Field Encrypt entity hooks"
msgstr "Háčky entity Šifrování pole"

msgid "Unable to dynamically create entity hooks"
msgstr "Nelze dynamicky vytvořit háčky entit"

msgid "In order to use Field Encrypt the following methods need to be defined:@functions"
msgstr "Chcete-li použít Šifrování pole, je třeba definovat následující metody: @functions"

msgid "Extends the Field API to allow encryption of fields."
msgstr "Rozšiřuje rozhraní API Field, aby bylo povoleno šifrování polí."

msgid "Encryption"
msgstr "Šifrování"

msgid "Field Encrypt settings"
msgstr "Nastavení šifrování pole"

msgid "Manage field encryption settings"
msgstr "Spravovat nastavení šifrování pole"

msgid "Settings"
msgstr "Nastavení"

msgid "Encrypted fields overview"
msgstr "Přehled šifrovaných polí"

msgid "Encrypted fields entity type settings"
msgstr "Nastavení typu entity šifrovaných polí"

msgid "Process queues"
msgstr "Fronty procesů"

msgid "Administer field encryption"
msgstr "Spravovat šifrování pole"

msgid "Allows fields to be individually encrypted so that their data is better protected."
msgstr "Umožňuje šifrování jednotlivých polí v zájmu lepší ochrany jejich dat."

msgid "Field Encrypt entity type settings"
msgstr "Nastavení typu entity Šifrování pole"

msgid "Process queued updates"
msgstr "Zpracovat aktualizace ve frontě"

msgid "Field encrypt setting"
msgstr "Nastavení šifrování pole"

msgid "Encrypt"
msgstr "Šifrovat "

msgid "Property"
msgstr "Vlastnost"

msgid "Properties placeholders"
msgstr "Zástupné symboly vlastností"

msgid "Placeholder"
msgstr "Zástupný řetězec"

msgid "Field Encrypt Settings"
msgstr "Nastavení šifrování pole"

msgid "Encryption profile"
msgstr "Šifrovací profil"

msgid "Exclude from persistent caches"
msgstr "Vyloučit z trvalých mezipamětí"

msgid "Field types"
msgstr "Typy polí"

msgid "Properties to encrypt"
msgstr "Vlastnosti k zašifrování"

msgid "Property name"
msgstr "Název vlastnosti"

msgid "Batch size"
msgstr "Velikost dávky"

msgid "Entity type ID"
msgstr "ID typu entity"

msgid "Encrypted base fields"
msgstr "Šifrovaná základní pole"

msgid "Base field"
msgstr "Základní pole"

msgid "Base field property"
msgstr "Základní vlastnost pole"

msgid "Encrypted data"
msgstr "Šifrovaná data"

msgid "Stores data from encrypted fields."
msgstr "Ukládá data ze šifrovaných polí."

msgid "Field"
msgstr "Pole"

msgid "Entity type"
msgstr "Typ entity"

msgid "Operations"
msgstr "Operace"

msgid "There are no encrypted fields."
msgstr "Nejsou zašifrována žádná pole."

msgid "Decrypt"
msgstr "Dešifrovat"

msgid "Updates to @entity_type with existing data been queued to be processed. You should immediately <a href=\":url\">run this process manually</a>. Alternatively, the updates will be performed automatically by cron."
msgstr "Aktualizace pro @entity_type s existujícími daty byly zařazeny do fronty ke zpracování. Měli byste okamžitě <a href=\":url\">spustit tento proces ručně</a>. Aktualizace se také provedou automaticky pomocí programu cron."

msgid "Updates to entities with existing data for this field have been queued to be processed. You should immediately <a href=\":url\">run this process manually</a>. Alternatively, the updates will be performed automatically by cron."
msgstr "Aktualizace entit s existujícími daty pro toto pole byly zařazeny do fronty ke zpracování. Tento proces musíte okamžitě <a href=\":url\">ručně spustit</a>. Další možností je automatické provedení aktualizací pomocí programu cron. "

msgid "Are you sure you want to remove encryption for field %field on %entity_type?"
msgstr "Opravdu chcete odebrat šifrování pro pole %field v %entity_type?"

msgid "Remove field encryption"
msgstr "Odebrat šifrování pole"

msgid "This action removes field encryption from the specified field. Existing field data will be decrypted through a batch process."
msgstr "Tato akce odebere šifrování pole z uvedeného pole. Existující data pole budou dešifrována pomocí dávkového zpracování. "

msgid "Select a entity type to configure"
msgstr "Vyberte typ entity ke konfiguraci"

msgid "Base fields to encrypt"
msgstr "Základní pole pro šifrování"

msgid "Note that encrypted fields can not be filtered on in SQL queries or joined against."
msgstr "Všimněte si, že šifrovaná pole nemohou být filtrována v dotazech SQL, nebo s nimi spojena."

msgid "Save configuration"
msgstr "Uložit nastavení"

msgid "@label properties"
msgstr "Vlastnosti @label"

msgid "Specify the base field properties to encrypt. If none are selected the base field will not be encrypted."
msgstr "Uveďte vlastnosti základního pole, které se mají šifrovat. Nejsou-li žádné vybrány, nebude základní pole šifrováno."

msgid "Updated encryption settings for %entity_type base fields."
msgstr "Aktualizovaná nastavení šifrování pro základní pole %entity_type."

msgid "Update encryption profile"
msgstr "Aktualizovat profil šifrování"

msgid "Usages"
msgstr "Využití"

msgid "If the field encryption profile is changed entities can be updated to use the new encryption profile."
msgstr "Pokud je profil šifrování pole změněn, mohou být entity aktualizovány tak, aby používaly nový profil šifrování."

msgid "Process updates"
msgstr "Aktualizace procesu"

msgid "Field encryption updates"
msgstr "Aktualizace šifrování polí"

msgid "Cannot claim an item - unable to process the batch"
msgstr "Nelze nárokovat položku - nelze zpracovat dávku."

msgid "There is one entity queued for updating to use the latest field encryption settings."
msgid_plural "There are @count entities queued for updating to use the latest field encryption settings."
msgstr[0] "Existuje jedna entita zařazená do fronty pro aktualizaci pro použití nejnovějších nastavení šifrování pole."
msgstr[1] "Existuje @count entit zařazených do fronty pro aktualizaci pro použití nejnovějších nastavení šifrování pole."
msgstr[2] "Existuje @count entit zařazených do fronty pro aktualizaci pro použití nejnovějších nastavení šifrování pole."

msgid "One entity updated."
msgid_plural "@count entities updated."
msgstr[0] "Jedna entita aktualizována."
msgstr[1] "@count entit aktualizováno."
msgstr[2] "@count entit aktualizováno."

msgid "Select the encryption profile to use for encrypting fields. New entities and revisions will always use this profile. Existing entities and revisions can be updated via <a href=\":link\">Encrypted fields entity type settings</a>"
msgstr "Vyberte šifrovací profil, který se má použít pro šifrování polí. Nové entity a revize budou vždy používat tento profil. Existující entity a revize lze aktualizovat prostřednictvím <a href=\":link\">Nastavení typu entity šifrovaných polí</a>"

msgid "Exclude entities from persistent caches"
msgstr "Vyloučit entity z trvalých mezipamětí"

msgid "This ensures unencrypted data is not exposed in the cache. However, it negatively impacts performance because it prevents caching of all entity types for which field encryption is enabled, even entity bundles that do not have any encrypted fields."
msgstr "Tím zajistíte, že v mezipaměti nebudou odkryta nezašifrovaná data. Tato volba má však negativní dopad na výkon, protože zabraňuje ukládání do mezipaměti všech typů entit, pro které je šifrování pole povoleno, dokonce i balíků entit, které nemají žádná šifrovaná pole."

msgid "Default properties"
msgstr "Výchozí vlastnosti "

msgid "Select which field properties will be checked by default on the field encryption settings form, per field type. Note that this does not change existing field settings, but merely sets sensible defaults."
msgstr "Vyberte, které vlastnosti pole budou standardně kontrolovány ve formuláři nastavení šifrování polí pro každý typ pole. Mějte na zřeteli, že toto nastavení nemění stávající nastavení pole, ale pouze nastavuje rozumné výchozí hodnoty. "

msgid "@field_type properties"
msgstr "Vlastnosti typu pole @field"

msgid "Specify the default properties to encrypt for this field type."
msgstr "Zadejte výchozí vlastnosti, které se mají šifrovat pro tento typ pole. "

msgid "Batch update settings"
msgstr "Nastavení dávkové aktualizace"

msgid "Configure behaviour of the batch field update feature. When changing field encryption settings for fields that already contain data, a batch process will be started that updates the existing field values according to the new settings."
msgstr "Nakonfigurujte chování funkce dávkové aktualizace pole. Při změně nastavení šifrování pro pole, která již obsahují data, se spustí dávkový proces, který aktualizuje stávající hodnoty polí s použitím nových nastavení."

msgid "Specify the number of entities to process on each field update batch execution. It is recommended to keep this number low, to avoid timeouts."
msgstr "Určete počet entit, které mají být zpracovány při každém provedení dávkové aktualizace. Doporučuje se ponechat toto číslo nízké, aby nedošlo k vypršení časového limitu. "

msgid "Are you sure you want to update the encryption profile from %from to %to for %entity_type_plural?"
msgstr "Jste si jisti, že chcete aktualizovat šifrovací profil z %fm na %to pro %entity_type_plural?"

msgid "Existing entities will be updated through a batch process."
msgstr "Existující entity budou aktualizovány prostřednictvím dávkového zpracování."

msgid "Queued one %entity_type update. You should immediately <a href=\":url\">run this process manually</a>. Alternatively, the update will be performed automatically by cron."
msgid_plural "Queued @count @entity_type updates. You should immediately <a href=\":url\">run this process manually</a>. Alternatively, the updates will be performed automatically by cron."
msgstr[0] "Jedna aktualizace %entity_type zařazena do fronty. Měli byste okamžitě <a href=\":url\">spustit tento proces ručně</a>. Případně bude aktualizace provedena automaticky pomocí programu cron."
msgstr[1] "@count aktualizací @entity_type zařazeno do fronty. Měli byste okamžitě <a href=\":url\">spustit tento proces ručně</a>. Případně budou aktualizace provedeny automaticky pomocí programu cron."
msgstr[2] "@count aktualizací @entity_type zařazeno do fronty. Měli byste okamžitě <a href=\":url\">spustit tento proces ručně</a>. Případně budou aktualizace provedeny automaticky pomocí programu cron."

msgid "Decrypted data"
msgstr "Dešifrovaná data"

msgid "Encrypted field storage"
msgstr "Úložiště šifrovaných polí"

msgid "Stores encrypted field data."
msgstr "Ukládá data šifrovaných polí."

msgid "Updating @entity_type with ID @entity_id to use the latest field encryption settings"
msgstr "Aktualizace @entity_type s ID @entity_id pro použití nejnovějších nastavení šifrování polí"

msgid "Field encrypt: update encrption profile."
msgstr "Šifrování polí: aktualizace profilu šifrování."

