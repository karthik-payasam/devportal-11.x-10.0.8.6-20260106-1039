msgstr "Příznak záložky"

msgid "Provides an example bookmark flag and supporting views."
msgstr "Poskytuje příklad příznaku záložky a podpůrných pohledů."

msgid "Flag Count"
msgstr "Počet příznaků"

msgid "Provides an example on how to display flag counts"
msgstr "Poskytuje příklad, jak zobrazit počty příznaků"

msgid "Count link"
msgstr "Odkaz na počet"

msgid "Flag Follower"
msgstr "Označit příznakem sledujícího uživatele"

msgid "Provides an example user flag and supporting views."
msgstr "Poskytuje příklad příznaku uživatele a podpůrné pohledy."

msgid "Flagging"
msgstr "Označení příznakem"

msgid "Flagging count"
msgstr "Počet označení příznakem"

msgid "The number of flaggings an entity has."
msgstr "Počet označení příznakem, která entita má."

msgid "Last flagging"
msgstr "Poslední označení příznakem"

msgid "Last time this entity has been flagged."
msgstr "Kdy byla tato entita naposledy označena příznakem."

msgid "Flag link"
msgstr "Odkaz na příznak"

msgid "Display flag/unflag link."
msgstr "Zobrazit odkaz na příznak/zrušení příznaku."

msgid "Flagged"
msgstr "Označeno příznakem"

msgid "A boolean field to show whether the flag is set or not."
msgstr "Logické pole, které má zobrazit, zda je příznak nastaven či nikoli."

msgid "Filter to ensure content has or has not been flagged."
msgstr "Filtrujte, chcete-li zajistit, že obsah byl nebo nebyl označen příznakem."

msgid "Sort by whether entities have or have not been flagged."
msgstr "Seřaďte podle toho, zda entity byly nebo nebyly označeny příznakem."

msgid "Flag Type"
msgstr "Typ příznaku"

msgid "Roles"
msgstr "Role"

msgid "Entity Bundles"
msgstr "Balíky entit"

msgid "Scope"
msgstr "rozsah"

msgid "Status"
msgstr "Stav"

msgid "None"
msgstr "Není"

msgid "All"
msgstr "Vše"

