msgid "About"
msgstr "Sobre"

msgid "Enables metatags for custom routes"
msgstr "Ativa metatags para rotas customizadas"

msgid "Metatag Custom Routes (Paths)"
msgstr "Rotas customizadas de metatag (caminhos)"

msgid "Allows assigning meta tags to be used on custom routes, equivalent to custom paths."
msgstr "Permite designar as meta tags a serem usadas em rotas customizadas, equivalentes a caminhos customizados."

msgid "SEO"
msgstr "SEO"

msgid "Add meta tag for custom route"
msgstr "Incluir meta tag para rota customizada"

msgid "Add custom metatag"
msgstr "Incluir metatag customizada"

msgid "Route / Path"
msgstr "Rota/Caminho"

msgid "Enter the route (path) for this new configuration, starting with a leading slash.<br />Note: this must already exist as a path in Drupal."
msgstr "Insira a rota (caminho) para esta nova configuração, começando com uma barra inicial.<br />Nota: isso já deve existir como um caminho no Drupal."

msgid "Submit"
msgstr "Enviar"

msgid "The path must begin with /"
msgstr "O caminho deve começar com /"

msgid "The admin routes should not have metatags."
msgstr "As rotas de administrador não devem ter metatags."

msgid "The entities routes metatags must be added by fields. @entity_type - @id"
msgstr "As metatags de rotas de entidades devem ser incluídas por campos. @entity_type - @id"

msgid "There are already metatags created for this route."
msgstr "Já existem metatags criadas para esta rota."

msgid "The path does not exist as an internal Drupal route."
msgstr "O caminho não existe como uma rota interna do Drupal."

msgid "Created metatags for the path: @url. Internal route: @route."
msgstr "Criamos metatags para o caminho: @url. Rota interna: @route."

msgid "The metatags could not be created for the path: @url."
msgstr "As metatags não puderam ser criadas para o caminho: @url."

