msgid "currently in daylight saving mode"
msgstr "в режиме перехода на летнее время"

msgid "not in daylight saving mode"
msgstr "не в режиме перехода на летнее время"

msgid "In most cases the server time should match Coordinated Universal Time (UTC) / Greenwich Mean Time (GMT)."
msgstr "В большинстве случаев время сервера должно соответствовать UTC/GMT."

msgid "Default timezone: %date_default_timezone (%date_default_code), offset from UTC/GMT by %date_default_offset hours. This timezone can be <a href=\"@admin_regional_settings\">changed by admin users</a> with the appropriate access."
msgstr "Часовой пояс по умолчанию: %date_default_timezone (%date_default_code), разность со временем UTC/GMT составляет %date_default_offset ч. Этот часовой пояс может быть <a href=\"@admin_regional_settings\">изменен администраторами</a> с соответствующими правами доступа."

msgid "Local time: %localtime (%daylight_saving). You can change this via your <a href=\"@account_edit\">user account</a>."
msgstr "Местное время: %localtime (%daylight_saving). Это значение можно изменить в <a href=\"@account_edit\">учетной записи пользователя</a>."

msgid "Note: The user timezone has not been stored, so defaulting to the website timezone."
msgstr "Примечание: часовой пояс пользователя не сохранен, поэтому по умолчанию используется часовой пояс веб-сайта."

msgid "Your local time is %localtime (%daylight_saving). This is not configurable by you."
msgstr "Местное время - %localtime (%daylight_saving). Не настраивается."

