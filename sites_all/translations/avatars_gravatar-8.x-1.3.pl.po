msgid "Gravatar"
msgstr "Gravatar"

msgid "Adds Gravatar.com avatar generators for Avatar Kit."
msgstr "Dodaje generatory awatarów z serwisu Gravatar.com do zestawu awatarów."

msgid "Avatars"
msgstr "Awatary"

msgid "Maximum content rating"
msgstr "Maksymalna ocena treści"

msgid "Gravatar generator"
msgstr "Generator Gravatar"

msgid "Type"
msgstr "Typ"

msgid "Unrestricted"
msgstr "Nieograniczony"

msgid "G: suitable for display on all websites with any audience type."
msgstr "G: nadaje się do wyświetlania we wszystkich serwisach WWW, z których korzystają różni odbiorcy."

msgid "PG: may contain rude gestures, provocatively dressed individuals, the lesser swear words, or mild violence."
msgstr "PG: może zawierać nieprzyzwoite gesty, prowokacyjnie ubrane osoby, łagodne wulgaryzmy i przekleństwa lub umiarkowaną przemoc."

msgid "R: may contain such things as harsh profanity, intense violence, nudity, or hard drug use."
msgstr "R: może zawierać ostre wulgaryzmy i przekleństwa, nagość lub intensywną przemoc i przedstawiać zażywanie twardych narkotyków."

msgid "X: may contain hardcore sexual imagery or extremely disturbing violence."
msgstr "X: może zawierać pornografię lub brutalną przemoc."

msgid "Maximum rating: @maximum_rating"
msgstr "Maksymalna ocena: @maximum_rating"

msgid "Universal avatar uploaded to Gravatar.com"
msgstr "Uniwersalny awatar przesłany do serwisu Gravatar.com"

msgid "Identicon"
msgstr "Identicon"

msgid "Monster ID"
msgstr "Monster ID"

msgid "Wavatar"
msgstr "Wavatar"

msgid "8-bit style avatar"
msgstr "Awatar 8-bitowy"

msgid "Missing Configuration"
msgstr "Brakująca konfiguracja"

msgid "Type: @type"
msgstr "Typ: @type"

msgid "Identicon, MonsterID, Retro, and Wavatar avatar generators."
msgstr "Generatory awatarów Identicon, MonsterID, Retro i Wavatar"

