msgid "Policy"
msgstr "Zásada"

msgid "Status"
msgstr "Stav"

msgid "Constraint"
msgstr "Omezení"

msgid "There are no constraints for the selected user roles"
msgstr "Pro vybrané uživtelské role neexistují žádná omezení."

msgid "The password does not satisfy the password policies."
msgstr "Heslo nesplňuje vyžadované zásady."

msgid "Your password has expired. Please visit the following link to reset your password: :link"
msgstr "Platnost vašeho hesla vypršela. Navštivte prosím následující odkaz a resetujte vašeho heslo: :link"

msgid "Your password will expire in less than :pending days. Please visit the following link to reset your password: :link"
msgstr "Platnost vašeho hesla vyprší za méně než: nevyřízené dny. Navštivte prosím následující odkaz a resetujte vašeho heslo: :link"

msgid "You need to reset your password."
msgstr "Je třeba resetovat vaše heslo."

msgid "Your password will expire soon."
msgstr "Platnost vašeho hesla brzy vyprší."

msgid "The Password Policy module has updated user accounts. Total update count: @count"
msgstr "Modul Zásady hesla má aktualizované uživatelské účty. Celkový počet aktualizací: @count"

msgid "Password Policy"
msgstr "Zásady pro hesla"

msgid "Sets up constraints and expiration of passwords."
msgstr "Nastavit omezení a platnost hesel."

msgid "Security"
msgstr "Bezpečnost"

msgid "Add Policy"
msgstr "Přidat zásadu"

msgid "Configuring security settings."
msgstr "Nastavení zabezpečení."

msgid "Create password policies."
msgstr "Vytvořit zásady pro hesla."

msgid "Manage password reset"
msgstr "Spravovat resetování hesla"

msgid "Be able to manually override user password reset dates."
msgstr "Možnost ručně přepsat data resetování uživatelských hesel."

msgid "Force Password Reset"
msgstr "Vynutit reset hesla"

msgid "Delete policy"
msgstr "Smazat zásadu"

msgid "Password Policies"
msgstr "Zásady pro hesla"

msgid "Edit password_policy"
msgstr "Upravit password_policy"

msgid "Add Password Policy"
msgstr "Přidat zásadu hesla"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "Popisek"

msgid "Password reset"
msgstr "Reset hesla"

msgid "Password reset send email"
msgstr "Odeslat e-mail při resetování hesla"

msgid "Password reset pending days"
msgstr "Nevyřízené dny resetování hesla"

msgid "Password reset pending day"
msgstr "Nevyřízený den resetování hesla"

msgid "Language"
msgstr "Jazyk"

msgid "Constraints"
msgstr "Omezení"

msgid "Show policy table"
msgstr "Zobrazit tabulku zásad"

msgid "Roles"
msgstr "Role"

msgid "Role"
msgstr "Role"

msgid "Constraint settings"
msgstr "Nastavení omezení"

msgid "Password Policy settings"
msgstr "Nastavení zásad pro hesla"

msgid "Cron threshold"
msgstr "Prahová hodnota Cron"

msgid "Password Blacklist Policy"
msgstr "Zásada seznamu zakázaných hesel"

msgid "Create a blacklist of phrases that cannot be used in passwords."
msgstr "Vytvořte seznam zakázaných frází, které nelze použít v heslech."

msgid "Blacklist"
msgstr "Blacklist"

msgid "Password"
msgstr "Heslo"

msgid "Match substrings"
msgstr "Porovnat podřetězce"

msgid "There are restricted terms in your password. Please modify your password."
msgstr "Ve vašem heslu jsou vyhrazené výrazy. Upravte prosím heslo."

msgid "Your password is on the blacklist. Please choose a different password."
msgstr "Vaše heslo je v seznamu zakázaných hesel. Vyberte prosím jiné heslo."

msgid "Also disallow passwords containing blacklisted passwords"
msgstr "Také zakázat hesla obsahující zakázaná hesla"

msgid "Blacklisted passwords"
msgstr "Zakázaná hesla"

msgid "Password cannot be a member of this list, ignoring case. Enter one password per line."
msgstr "Heslo nemůže být členem tohoto seznamu, ignoruje se velikost písmen. Zadejte jedno heslo na řádek."

msgid "Password must not contain any restricted words or phrases."
msgstr "Heslo nesmí obsahovat žádná omezená slova nebo fráze."

msgid "Password must not be on the blacklist."
msgstr "Heslo nesmí být na seznamu zakázaných hesel."

msgid "Password Blacklist"
msgstr "Seznam zakázaných hesel"

msgid "Password cannot match certain disallowed passwords"
msgstr "Heslo nemůže odpovídat určitým nepovolených heslům"

msgid "Your password contains restricted words or phrases."
msgstr "Vaše heslo obsahuje vyhrazená slova nebo fráze."

msgid "Password Character Types Policy"
msgstr "Zásada Typy znaků pro heslo"

msgid "Minimum number of different character types the password must contain."
msgstr "Minimální množství odlišných typů znaků, které heslo musí obsahovat."

msgid "Character Types"
msgstr "Typy znaků"

msgid "Invalid plugin configuration."
msgstr "Neplatné nastavení pluginu."

msgid "Password must contain at least @types types of characters from the following character types: lowercase letters, uppercase letters, digits, special characters."
msgstr "Heslo musí obsahovat minimálně @types typů znaků z následujících: malá písmena, velká písmena, číslovky, speciální znaky."

msgid "Minimum number of character types"
msgstr "Minimální množství typů znaků"

msgid "Select the minimum number of character types which must be found in a password. The four supported character types are given as: lowercase letters, uppercase letters, digits, special characters."
msgstr "Vyberte minimální množství typů znaků které musí být přítomné v heslu. Vybírejte z: malá písmena, velká písmena, číslovky, speciální znaky."

msgid "The number of character types must be between 2 and 4."
msgstr "Počet typů znaků musí být mezi 2 a 4."

msgid "Minimum password character types: @types"
msgstr "Minimální množství typů znaků: @types"

msgid "Password character types"
msgstr "Typy znaků pro heslo"

msgid "Verifying that a password has a minimum number of character types."
msgstr "Ověřování že heslo má minimální počet typů znaků."

msgid "Your password must have different character types."
msgstr "Vaše heslo musí mít rozdílné typy znaků."

msgid "Password Characters of Type Policy"
msgstr "Zásada Typy znaků pro heslo"

msgid "Minimum characters of a particular type the password must contain."
msgstr "Minimální počet znaků určitého typu, které musí heslo obsahovat."

msgid "Number of characters"
msgstr "Počet znaků"

msgid "Character type"
msgstr "Typ znaku"

msgid "Uppercase"
msgstr "Velká písmena"

msgid "Lowercase"
msgstr "Malá písmena"

msgid "Letter"
msgstr "Letter"

msgid "Numeric"
msgstr "Číselné"

msgid "Special Character"
msgstr "Speciální znak"

msgid "The number of characters must be a positive number."
msgstr "Počet znaků musí být kladné číslo."

msgid "Password character type"
msgstr "Typy znaků pro heslo"

msgid "Verifying that a password has a specific number of characters"
msgstr "Ověřování, že heslo má požadovaný počet znaků."

msgid "The password does not contain a the correct number of certain characters."
msgstr "Heslo neobsahuje správný počet určitých znaků."

msgid "Password Consecutive Characters Policy"
msgstr "Zásada hesla Opakující se znaky"

msgid "Sets up a consecutive characters constraint for passwords."
msgstr "Nastavit zásadu hesla pro za sebou se opakující znaky."

msgid "Maximum consecutive character count"
msgstr "Maximální počet po sobě jdoucích znaků"

msgid "No consecutive identical characters are allowed."
msgstr "Nejsou povoleny žádné následné identické znaky."

msgid "Password must have fewer than @max consecutive identical characters. This is case sensitive."
msgstr "Heslo musí mít méně než @max po sobě jdoucích stejných znaků. Rozlišují se velká a malá písmena."

msgid "Consecutive identical characters fewer than: @max"
msgstr "Následné identické znaky menší než: @max"

msgid "Consecutive identical characters fewer than"
msgstr "Následné identické znaky menší než"

msgid "This many or more consecutive identical characters will not be allowed in the password."
msgstr "Těchto mnoho nebo více následných identických znaků nebude v hesle povoleno."

msgid "The number of consecutive identical characters must be higher than 1 otherwise all passwords will fail."
msgstr "Počet po sobě jdoucích identických znaků musí být vyšší než 1, jinak se všechna hesla nezdaří."

msgid "Consecutive characters"
msgstr "Za sebou se opakující znaky"

msgid "Verifying that a password has a maximum number of consecutive identical characters."
msgstr "Ověřuje se, že heslo má maximální počet po sobě jdoucích identických znaků."

msgid "Your password has too many consecutive characters."
msgstr "Vaše heslo obsahuje příliš mnoho za sebou se opakujících znaků."

msgid "Password Policy Delay"
msgstr "Prodleva zásady hesla"

msgid "Sets up a password constraint to limit how soon before a password can be reset again."
msgstr "Nastaví omezení pro heslo, aby bylo omezeno, za jak dlouho může být heslo znovu resetováno."

msgid "Hours until next password reset may be performed."
msgstr "Počet hodin, než může být proveden další reset hesla."

msgid ""
"Not enough time has passed\n"
"          since this password was last reset."
msgstr ""
"Od posledního resetování tohoto hesla neuplynul dostatek času.\n"
""

msgid "Hours until password can be reset again."
msgstr "Počet hodin, než může být proveden další reset hesla."

msgid "A value of 0 represents no delay"
msgstr "Hodnota 0 znamená bez prodlevy"

msgid "The delay value must be zero or greater."
msgstr "Hodnota prodlevy musí být nula nebo větší."

msgid "Delay in hours until password can be reset: @delay"
msgstr "Prodleva v hodinách, než může být proveden další reset hesla: @delay"

msgid "Password Delay"
msgstr "Prodleva hesela"

msgid "Provide delay before password can be reset again."
msgstr "Zadejte prodlevu, než může být proveden další reset hesla."

msgid "You cannot reset your password until the delay has as elapsed."
msgstr "Heslo nemůžete resetovat, dokud neuplyne prodleva."

msgid "Password Policy History"
msgstr "Historie zásad hesel"

msgid "Sets up a password constraint to limit repeated use of the same password."
msgstr "Nastaví omezení hesla pro omezení opakovaného použití stejného hesla."

msgid "Previous passwords cannot be reused. Choose a different password."
msgstr "Předchozí hesla nelze použít znovu. Vyberte jiné heslo."

msgid "Number of passwords that will be checked in the user password update history"
msgstr "Počet hesel, která se budou kontrolovat v historii aktualizace hesla uživatele"

msgid "A value of 0 represents that the user can not repeat any of the old passwords."
msgstr "Hodnota 0 znamená, že uživatel nemůže opakovat žádné staré heslo."

msgid "The number of repeated passwords value must be zero or greater."
msgstr "Počet opakování hesel musí být nula nebo vyšší."

msgid "Number of passwords that will be checked in the user password update history: @number-repeats"
msgstr "Počet hesel, která se budou kontrolovat v historii aktualizace hesla uživatele: @number-repeats"

msgid "Password History"
msgstr "Historie hesel"

msgid "Provide restrictions on previously used passwords."
msgstr "Poskytuje omezení pro předchozí použitá hesla."

msgid "You have used the same password previously and cannot."
msgstr "Toto heslo jste již použili."

msgid "Password Character Length Policy"
msgstr "Zásada hesla Počet znaků"

msgid "Sets up a character length constraint for passwords."
msgstr "Nastaví omezení počtu znaků v hesle."

msgid "Operation"
msgstr "Operace"

msgid "Minimum length"
msgstr "Minimální délka"

msgid "Maximum length"
msgstr "Maximální délka"

msgid "The character length must be a positive number."
msgstr "Počet znaků musí být kladné číslo."

msgid "at least"
msgstr "alespoň"

msgid "at most"
msgstr "většina"

msgid "Password length must be at least 1 character."
msgid_plural "Password length must be at least @count characters."
msgstr[0] "Délka hesla musí být alespoň 1 znak."
msgstr[1] "Délka hesla musí být alespoň @count znaků."
msgstr[2] "Délka hesla musí být alespoň @count znaků."

msgid "Password length must not exceed 1 character."
msgid_plural "Password length must not exceed @count characters."
msgstr[0] "Délka hesla nesmí překročit 1 znak."
msgstr[1] "Délka hesla nesmí překročit @count znaků."
msgstr[2] "Délka hesla nesmí překročit @count znaků."

msgid "Password character length of @operation 1 character"
msgid_plural "Password character length of @operation @characters characters"
msgstr[0] "Délka znaku hesla @operation 1 znak"
msgstr[1] "Délka znaku hesla @operation @characters znaků"
msgstr[2] "Délka znaku hesla @operation @characters znaků"

msgid "Password character length"
msgstr "Počet znaků hesla"

msgid "Verifying that a password has a minimum character length"
msgstr "Ověřování, že heslo má minimální počet znaků"

msgid "The length of your password is too short."
msgstr "Vaše heslo je příliš krátké."

msgid "Password Username Policy"
msgstr "Zásada hesla Uživatelské jméno"

msgid "Restrict users from having their username in their password."
msgstr "Nedovoluje uživatelům použít v heslu uživatelské jméno."

msgid "Disallow username"
msgstr "Nepovolit Uživatelské jméno"

msgid "Password must not contain the username."
msgstr "Heslo nesmí obsahovat uživatelské jméno."

msgid "Prevent user from having a password containing their username."
msgstr "Zamezit uživatelům ve vytvoření hesla s uživatelským jménem."

msgid "Password must not contain the user's username."
msgstr "Heslo nesmí obsahovat uživatelské jméno."

msgid "Password username"
msgstr "Jméno uživatele pro heslo"

msgid "Password must not contain their username"
msgstr "Heslo nesmí obsahovat jejich uživatelské jméno"

msgid "Your password contains your username."
msgstr "Vaše heslo obsahuje vaše uživatelské jméno."

msgid "@message"
msgstr "@message"

msgid "Pass"
msgstr "Úspěšně dokončeno"

msgid "New role was added or existing password policy changed. Please update your password."
msgstr "Nová role byla přidána nebo byla změněna existující zásada hesla. Aktualizujte heslo."

msgid "Fail - @message"
msgstr "Chyba – @message"

msgid "Machine name"
msgstr "Strojový název"

msgid "password policy"
msgstr "zásada hesla"

msgid "password policies"
msgstr "zásady hesla"

msgid "Your password has expired, please update it"
msgstr "Platnost vašeho hesla vypršela, prosím aktualizujte jej."

msgid "Are you sure you want to delete the @label constraint?"
msgstr "Jste si jisti, že chcete odebrat omezení @label?"

msgid "Save"
msgstr "Uložit"

msgid "Are you sure you want to delete the %name policy?"
msgstr "Jste si jistí, že chcete odebrat zásadu %name?"

msgid "Delete"
msgstr "Smazat"

msgid "The @label password policy has been deleted."
msgstr "Zásada @label byla odebrána."

msgid "PASSWORD POLICY"
msgstr "Zásada hesla"

msgid "Policy Name"
msgstr "Název zásady"

msgid "Enter label for this context."
msgstr "Zadejte popisek pro tento kontext."

msgid "Password Reset Days"
msgstr "Dny pro reset hesla"

msgid "User password will reset after the selected number of days. 0 days indicates that passwords never expire."
msgstr "Heslo uživatele se resetuje po zvoleném počtu dní. 0 dní označuje, že platnost hesel nikdy nevyprší."

msgid "Send email upon password expiring"
msgstr "Odeslat e-mail při vypršení platnosti hesla"

msgid "If checked, an email will go to each user when their password expires, with a link to the request password reset email page."
msgstr "Pokud je tato volba zaškrtnuta, odešle se e-mail každému uživateli, jakmile platnost jejich hesla vyprší, s odkazem na stránku požadavku na e-mail s resetováním hesla."

msgid "Send pending email days before"
msgstr "Odeslat e-mail o nevyřízení dny před"

msgid "Send password expiration pending email X days before expiration. 0 days indicates this email will not be sent. The box above must also be checked. Separate by comma if sending multiple notifications."
msgstr "Odeslat e-mail o nevyřízeném vypršení platnosti hesla X dní před vypršením platnosti. 0 dní znamená, že tento e-mail nebude odeslán. Dále musí být zaškrtnut výše uvedený rámeček. Pokud odesíláte více oznámení, oddělte je čárkami."

msgid "Indicate whether this policy should show the password policy table on the user add/edit form."
msgstr "Označuje, zda by tato zásada měla zobrazit tabulku zásad hesla ve formuláři pro přidání/úpravu uživatele."

msgid "The password policy %label has been added."
msgstr "Zásada hesla %label byla přidána."

msgid "The password policy was not saved."
msgstr "Zásada hesla nebyla uložena."

msgid "No password constraint available. Enable one of the modules that has password constraints."
msgstr "Není k dispozici žádné omezení hesla. Povolte jeden z modulů, které mají omezení hesla."

msgid "Add Constraint"
msgstr "Přidat omezení"

msgid "Configure Constraint Settings"
msgstr "Nastavení omezení"

msgid "Policy Constraints"
msgstr "Zásady omezení"

msgid "Plugin Id"
msgstr "ID modulu plug-in"

msgid "Summary"
msgstr "Souhrn"

msgid "Operations"
msgstr "Operace"

msgid "No constraints have been configured."
msgstr "Žádné omezení nebylo nastaveno."

msgid "Apply to Roles"
msgstr "Použít na role"

msgid "Select Roles to which this policy applies."
msgstr "Vyberte role, pro které platí tato zásada."

msgid "Edit"
msgstr "Upravit"

msgid "Configure Required Context"
msgstr "Nastavit požadovaný kontext"

msgid "Force password reset of selected roles."
msgstr "Vynutit reset hesla pro vybrané role."

msgid "Exclude Myself"
msgstr "Vyloučit sebe"

msgid "Exclude your account if you are included in the roles."
msgstr "Vyloučit vlastní účet, pokud je zahrnutý v rolích."

msgid "No roles selected."
msgstr "Nebyly vybrány žádné role."

msgid "Reset the %roles role."
msgid_plural "Reset the %roles roles."
msgstr[0] "Resetujte roli %roles."
msgstr[1] "Resetujte role %roles."
msgstr[2] "Resetujte role %roles."

