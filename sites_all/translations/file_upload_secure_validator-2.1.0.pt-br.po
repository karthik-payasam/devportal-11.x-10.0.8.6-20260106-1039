msgid "About"
msgstr "Sobre"

msgid "Secure File Upload Mime Detect"
msgstr "Detecção de Mime de upload de arquivo seguro"

msgid "Fileinfo extension"
msgstr "Extensão de Fileinfo"

msgid "Found"
msgstr "Encontrado"

msgid "Fileinfo extension not available"
msgstr "Extensão Fileinfo não disponível"

msgid "File upload secure validator module uses Fileinfo extension. It seems as if Fileinfo extension is not loaded/enabled. If you are using Windows, may be, you should uncomment php_fileinfo.dll in php.ini file."
msgstr "O módulo do validador seguro de upload de arquivo usa a extensão Fileinfo. Parece que a extensão Fileinfo não está carregada/ativada. Se estiver usando o Windows, poderá ser necessário remover o comentário de php_fileinfo.dll no arquivo php.ini."

msgid "File Upload Secure Validator"
msgstr "Validador seguro de upload de arquivo"

msgid "Secure Mime Detect"
msgstr "Detecção de mime seguro"

msgid "Security"
msgstr "Segurança"

msgid "Manage the list of MIME types equivalence groups."
msgstr "Gerencie a lista de grupos de equivalência de tipos MIME."

msgid "Administer File Upload Secure Validator configuration"
msgstr "Administrar configuração do Validador seguro de upload de arquivo"

msgid "Allow user to administer File Upload Secure Validator configuration."
msgstr "Permita que o usuário administre a configuração Validador seguro de upload de arquivo."

msgid "SettingsForm"
msgstr "SettingsForm"

msgid "MIME types equivalence groups"
msgstr "Grupos de equivalência de tipos MIME"

msgid "MIME types equivalence group"
msgstr "Grupo de equivalência de tipos MIME"

msgid "MIME type"
msgstr "Tipo MIME"

msgid "MIME types equivalence group(s)"
msgstr "Grupos de equivalência de tipos MIME"

msgid "A CSV-like list of MIME types groups; if two MIME types are part of the same group, then, File Upload Secure Validator will not protest."
msgstr "Uma lista em formato CSV de grupos de tipos MIME; se dois tipos MIME fizerem parte do mesmo grupo, o Validador seguro de upload de arquivo não protestará."

msgid "Caught an InvalidArgumentException; cannot validate missing file requested as @path"
msgstr "Capturada uma InvalidArgumentException; não é possível validar o arquivo ausente solicitado como @path"

msgid "There was a problem with this file. The uploaded file is of type @extension but the real content seems to be @real_extension"
msgstr "Houve um problema com este arquivo. O arquivo transferido por upload é do tipo @extension, mas o conteúdo real parece ser @real_extension"

msgid "Error while uploading file: MimeTypeGuesser guessed '%mime_by_fileinfo' and fileinfo '%mime_by_filename'"
msgstr "Erro ao fazer upload do arquivo: MimeTypeGuesser estimou '%mime_by_fileinfo' e 'fileinfo %mime_by_filename'"

