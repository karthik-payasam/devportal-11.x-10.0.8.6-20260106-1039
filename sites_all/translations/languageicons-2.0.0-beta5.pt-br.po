msgid "This module manages language icons for multilingual sites:"
msgstr "Este módulo gerencia ícones de idioma para sites multilíngues:"

msgid "Automatically adds icons to language links."
msgstr "Inclui ícones automaticamente nos links de idioma."

msgid "Provides related theme functions."
msgstr "Fornece funções de tema relacionadas."

msgid "For more information, please see <a href=\"@handbook\">the online handbook section</a>."
msgstr "Para obter mais informações, consulte <a href=\"@handbook\">a seção de manual on-line</a>."

msgid "To enable multilingual support for specific content types go to <a href=\"@configure_content_types\">configure content types</a>."
msgstr "Para ativar o suporte multilíngue para tipos de conteúdo específicos, acesse <a href=\"@configure_content_types\">configurar tipos de conteúdo</a>."

msgid "Language Icons"
msgstr "Ícones de Idioma"

msgid "Adds icons to language links."
msgstr "Inclui ícones nos links de idioma."

msgid "Multilingual"
msgstr "Multi-idioma"

msgid "Language icons"
msgstr "Ícones de idioma"

msgid "Configure the Language Icons module."
msgstr "Configurar o módulo Ícones de Idioma."

msgid "Icons"
msgstr "Ícones"

msgid "Language Icons settings"
msgstr "Configurações de Ícones de Idioma"

msgid "Show the icons on a node"
msgstr "Mostrar os ícones em um nó"

msgid "Show the icons on the language switcher block"
msgstr "Mostrar os ícones no bloco de alternador de idioma"

msgid "Add language icons"
msgstr "Adicionar ícones de idiomas"

msgid "Link types to add language icons."
msgstr "Tipos de links onde adicionar ícones de idiomas."

msgid "Node links"
msgstr "Links do conteúdo"

msgid "Language switcher block"
msgstr "Bloco de alteração de idiomas"

msgid "These options are currently disabled due to <a href=\":issue_url\">a bug</a> that cannot currently be resolved. They may be reintroduced at a later stage."
msgstr "Essas opções estão atualmente desativadas devido a <a href=\":issue_url\">um erro</a> que não pode ser resolvido no momento. Elas podem ser introduzidas novamente em um estágio posterior."

msgid "Icon placement"
msgstr "Localização do ícone"

msgid "Before link"
msgstr "Antes do link"

msgid "After link"
msgstr "Depois do link"

msgid "Replace link"
msgstr "Trocar link"

msgid "Where to display the icon, relative to the link title."
msgstr "Onde apresentar o ícone, relativo ao título do link."

msgid "Icons file path"
msgstr "Caminho dos arquivos de ícones"

msgid "Path for language icons, relative to Drupal installation. \"*\" is a placeholder for language code."
msgstr "Caminho para ícones de idiomas relativo a instalação do Drupal. \"*\" é um coringa para o código do idioma."

msgid "Image size"
msgstr "Tamanho da imagem"

msgid "Image size for language icons, in the form \"width x height\"."
msgstr "Tamanho das imagens para ícones de idiomas, no formato \"largura\" x \"altura\"."

