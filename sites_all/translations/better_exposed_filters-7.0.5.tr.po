msgstr "Gönder düğmesini gizle"

msgid "Only display results after the user has selected a filter option"
msgstr "Sonuçları yalnızca kullanıcı bir süzgeç seçeneği belirledikten sonra görüntüle"

msgid "Enable secondary exposed form options"
msgstr "Gösterilen ikincil form seçeneklerini etkinleştir"

msgid "Secondary options label"
msgstr "İkincil seçenekler etiketi"

msgid "Secondary options is open"
msgstr "İkincil seçenekler açık"

