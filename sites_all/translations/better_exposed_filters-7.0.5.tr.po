msgstr "Eklenti tanıtıcısı"

msgid "Sort filter options alphabetically"
msgstr "Süzgeç seçeneklerini alfabetik olarak sırala"

msgid "Placeholder text for the filter"
msgstr "Süzgeç için yer tutucu metin"

msgid "Rewrite filter options"
msgstr "Süzgeç seçeneklerini yeniden yaz"

msgid "Rewrite filter option"
msgstr "Süzgeç seçeneğini yeniden yaz"

msgid "Make sort options collapsible"
msgstr "Sıralama seçeneklerini daraltılabilir yap"

msgid "This filter is a secondary option"
msgstr "Bu süzgeç ikincil bir seçenektir"

msgid "Exposed filter BEF settings"
msgstr "Gösterilen süzgeç BEF ayarları"

msgid "Default"
msgstr "Varsayılan"

msgid "Checkboxes/Radio Buttons"
msgstr "Onay Kutuları/Radyo Düğmeleri"

msgid "Add select all/none links"
msgstr "Tümünü ekle/hiçbirini ekleme bağlantıları ekle"

msgid "Add select all/none links to hierarchical lists"
msgstr "Sıradüzensel listeler için tümünü seç/hiçbirini seçme bağlantıları ekle"

msgid "Display checkbox/radio options inline"
msgstr "Yerleşik onay kutusu/radyo seçeneklerini görüntüle"

msgid "Links"
msgstr "Bağlantılar"

msgid "Hidden"
msgstr "Gizli"

msgid "jQuery UI Slider"
msgstr "jQuery UI Kaydırıcı"

msgid "Range minimum"
msgstr "Minimum aralık"

msgid "Range maximum"
msgstr "Maksimum aralık"

msgid "Step"
msgstr "Adım"

