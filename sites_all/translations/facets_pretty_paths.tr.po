msgid "Pretty paths coder"
msgstr "Pretty Paths kodlayıcı"

msgid "Facets Pretty Paths"
msgstr "Facets Pretty Paths"

msgid "Pretty paths for Facets."
msgstr "Facets modülü için Pretty Paths özelliği."

msgid "Search"
msgstr "Ara"

msgid "Facet Pretty Paths third party settings on the Facet config"
msgstr "Boyut yapılandırmasında Facet Pretty Paths üçüncü taraf ayarları"

msgid "The coder plugin ID"
msgstr "Kodlayıcı eklentisi tanıtıcısı"

msgid "Home"
msgstr "Ana Sayfa"

msgid "Pretty paths"
msgstr "Pretty Paths"

msgid "Pretty paths uses slashes as separator, e.g. /brand/drupal/color/blue"
msgstr "Pretty Paths özelliğinde, ayrıcı olarak eğik çizgi kullanılır; örn. /brand/drupal/color/blue"

msgid "Default"
msgstr "Varsayılan"

msgid "Use the raw value, no special processing is done, e.g. /color/<strong>2</strong>"
msgstr "İşlenmemiş değeri kullanın, özel bir işlem yapılmaz; örn. /color/<strong>2</strong>"

msgid "Node title + id"
msgstr "Düğüm başlığı + tanıtıcı"

msgid "Use node title with entity id, e.g. /color/<strong>blue-2</strong>"
msgstr "Varlık tanıtıcısı ile düğüm başlığını kullan; örn. /color/<strong>blue-2</strong>"

msgid "Taxonomy term name + id"
msgstr "Taksonomi terimi adı + tanıtıcısı"

msgid "Use term name with term id, e.g. /color/<strong>blue-2</strong>"
msgstr "Terim adını terim tanıtıcısı ile birlikte kullan, örn. /color/<strong>blue-2</strong>"

