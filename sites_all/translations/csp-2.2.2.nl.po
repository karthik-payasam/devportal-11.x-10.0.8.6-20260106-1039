msgstr "Beleid @policyType resetten naar standaardwaarden"

msgid "No policies are currently enabled."
msgstr "Momenteel is er geen enkel beleid ingeschakeld."

msgid "%policy %directive has a hash source configured, which may block functionality that relies on inline code."
msgstr "Voor %policy %directive is een hashsource geconfigureerd; dit kan de functionaliteit blokkeren die afhankelijk is van inline code."

msgid "%policy %directive is enabled without a fallback directive for non-supporting browsers."
msgstr "%policy %directive is ingeschakeld zonder een fallback-instructie voor niet-ondersteunde browsers."

msgid "<a href=\":docUrl\">Nonces must be a unique value for each request</a>, so cannot be set in configuration."
msgstr "<a href=\":docUrl\">Nonces moet een unieke waarde zijn voor elke aanvraag</a>, dus kan niet worden ingesteld in de configuratie."

