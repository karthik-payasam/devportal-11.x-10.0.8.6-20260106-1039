msgid "This module manages language icons for multilingual sites:"
msgstr "Este módulo gestiona los iconos de idioma para los sitios multilingües:"

msgid "Automatically adds icons to language links."
msgstr "Añade automáticamente los iconos a los enlaces de idioma."

msgid "Provides related theme functions."
msgstr "Proporciona funciones temáticas relacionadas."

msgid "For more information, please see <a href=\"@handbook\">the online handbook section</a>."
msgstr "Para más información, por favor vea <a href=\"@handbook\">la sección del manual en línea</a>."

msgid "To enable multilingual support for specific content types go to <a href=\"@configure_content_types\">configure content types</a>."
msgstr "Para activar el soporte multi idioma en tipos de contenidos específicos, vaya a la <a href=\"@configure_content_types\">configuración de tipos de contenido</a>."

msgid "Language Icons"
msgstr "Iconos de Idioma"

msgid "Adds icons to language links."
msgstr "Adiciona iconos a los enlaces de idioma."

msgid "Multilingual"
msgstr "Multi idioma"

msgid "Language icons"
msgstr "Iconos de idioma"

msgid "Configure the Language Icons module."
msgstr "Configurar el módulo Iconos de idioma."

msgid "Icons"
msgstr "Iconos"

msgid "Language Icons settings"
msgstr "Configuración de Iconos de idioma"

msgid "Show the icons on a node"
msgstr "Mostrar los iconos en un nodo"

msgid "Show the icons on the language switcher block"
msgstr "Mostrar los iconos en el bloque del conmutador de idiomas"

msgid "Add language icons"
msgstr "Añadir iconos de idioma"

msgid "Link types to add language icons."
msgstr "Tipos de enlace a los que añadir iconos de idioma."

msgid "Node links"
msgstr "Enlaces del nodo"

msgid "Language switcher block"
msgstr "Bloque de cambio de idioma"

msgid "These options are currently disabled due to <a href=\":issue_url\">a bug</a> that cannot currently be resolved. They may be reintroduced at a later stage."
msgstr "Actualmente, estas opciones están inhabilitadas debido a un <a href=\":issue_url\">error</a> que ahora no se puede resolver. Se pueden volver a introducir en una fase posterior."

msgid "Icon placement"
msgstr "Colocación del icono"

msgid "Before link"
msgstr "Después del enlace"

msgid "After link"
msgstr "Antes del enlace"

msgid "Replace link"
msgstr "Reemplazar enlace"

msgid "Where to display the icon, relative to the link title."
msgstr "Dónde mostrar el icono, relativo al título del enlace."

msgid "Icons file path"
msgstr "Ruta del archivo de iconos"

msgid "Path for language icons, relative to Drupal installation. \"*\" is a placeholder for language code."
msgstr "Ruta para los iconos de idioma, relativa a la instalación de Drupal. \"*\" es el lugar para el código de idioma."

msgid "Image size"
msgstr "Tamaño de la imagen"

msgid "Image size for language icons, in the form \"width x height\"."
msgstr "Tamaño de la imagen para los iconos de idioma, en el formato \"anchura x altura\""

