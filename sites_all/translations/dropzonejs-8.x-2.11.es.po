msgid "About"
msgstr "Acerca de"

msgid "DropzoneJS"
msgstr "DropzoneJS"

msgid "or"
msgstr "o"

msgid "Select file"
msgid_plural "Select files"
msgstr[0] "Seleccionar archivo"
msgstr[1] "Seleccionar archivos"

msgid "Dropzone library missing"
msgstr "Falta la biblioteca Dropzone"

msgid ""
"Dropzonejs requires the dropzone.min.js library.\n"
"        Download it (https://github.com/enyo/dropzone) and place it in the\n"
"        libraries folder (/libraries)"
msgstr ""
"Dropzonejs requiere la biblioteca dropzone.min.js.\n"
"        Descárquela (https://github.com/enyo/dropzone) y colóquela en la\n"
"        carpeta de bibliotecas (/libraries)"

msgid "dropzonejs"
msgstr "dropzonejs"

msgid "The Drupal integration for DropzoneJS."
msgstr "La integración de Drupal para DropzoneJS."

msgid "Media"
msgstr "Multimedia"

msgid "Dropzone upload files"
msgstr "Archivos de subida de Dropzone"

msgid "Allow uploading of files via dropzonejs."
msgstr "Permitir subida de archivos vía dropzonejs."

msgid "DropzoneJS settings"
msgstr "Configuración de DropzoneJS"

msgid "Upload scheme"
msgstr "Subir esquema"

msgid "Transliterate names of uploaded files"
msgstr "Transliterar nombres de archivos cargados"

msgid "Upload timeout"
msgstr "Tiempo de espera de carga"

msgid "Drop files here to upload"
msgstr "Soltar archivos aquí para cargarlos"

msgid "Your browser does not support drag'n'drop file uploads."
msgstr "El navegador no da soporte a cargas de archivo de tipo arrastrar y soltar."

msgid "Please use the fallback form below to upload your files like in the olden days."
msgstr "Utilice el formulario de reserva siguiente para cargar los archivos como en el pasado."

msgid "File is too big ({{filesize}}MiB). Max filesize: {{maxFilesize}}MiB."
msgstr "El archivo es demasiado grande ({{filesize}}MiB). Tamaño máximo de archivo: {{maxFilesize}}MiB."

msgid "You can't upload files of this type."
msgstr "No puede cargar archivos de este tipo."

msgid "Server responded with {{statusCode}} code."
msgstr "El servidor ha respondido con el código {{statusCode}}."

msgid "Cancel upload"
msgstr "Cancelar carga"

msgid "Are you sure you want to cancel this upload?"
msgstr "¿Está seguro de que desea cancelar esta carga?"

msgid "Remove file"
msgstr "Eliminar archivo"

msgid "You can not upload any more files."
msgstr "No puede cargar más archivos."

msgid "TB"
msgstr "TB"

msgid "GB"
msgstr "GB"

msgid "MB"
msgstr "MB"

msgid "KB"
msgstr "KB"

msgid "b"
msgstr "b"

msgid "DropzoneJS entity browser widget"
msgstr "Widget de navegador de entidades de DropzoneJS"

msgid "DropzoneJS Entity browser widget."
msgstr "Widget de navegador de entidades de DropzoneJS."

msgid "DropzoneJS widget configuration"
msgstr "Configuración del widget de DropzoneJS"

msgid "Submit button text"
msgstr "Texto del botón de envío"

msgid "Automatically submit selection"
msgstr "Enviar automáticamente la selección"

msgid "Upload location"
msgstr "Subir ubicación"

msgid "Dropzone drag-n-drop zone text"
msgstr "Texto de zona de arrastrar y soltar de Dropzone"

msgid "Maximum size of files"
msgstr "Tamaño máximo de los archivos"

msgid "Allowed file extensions"
msgstr "Extensiones de archivos permitidos"

msgid "Use clientside resize"
msgstr "Utilizar redimensionamiento del lado del cliente"

msgid "Maximum width"
msgstr "Ancho máximo"

msgid "Maximum height"
msgstr "Alto máximo"

msgid "Resize quality"
msgstr "Calidad de redimensionamiento"

msgid "Method used for resizing"
msgstr "Método utilizado para redimensionar"

msgid "Method used for generating the thumbnail"
msgstr "Método utilizado para generar la miniatura"

msgid "Media Entity DropzoneJS widget configuration"
msgstr "Configuración del widget Media Entity de DropzoneJS"

msgid "Media type"
msgstr "Tipos multimedia"

msgid "Media Entity DropzoneJS with edit widget configuration"
msgstr "Configuración del widget Media Entity de DropzoneJS con edición"

msgid "Form mode"
msgstr "Formulario de modo"

msgid "Drop files here to upload them"
msgstr "Suelte los archivos aquí para subirlos"

msgid "File upload"
msgstr "Subida de archivo"

msgid "Files could not be uploaded because the destination directory %destination is not configured correctly."
msgstr "No se pueden subir los archivos porque el directorio de destino %destination no está configurado correctamente."

msgid "Some files that you are trying to upload did not pass validation. Requirements are: max file %size, allowed extensions are %extensions"
msgstr "Algunos de los archivos que está intentando subir no han pasado la validación. Los requisitos son: archivo máximo %size, las extensiones permitidas son %extensions"

msgid "At least one valid file should be uploaded."
msgstr "Hay que subir al menos un archivo válido."

msgid "A space separated list of file extensions"
msgstr "Lista separada por espacios de extensiones de archivo"

msgid "Use client side resizing"
msgstr "Utilizar redimiensionamiento del lado del cliente"

msgid "Requires droopzone version v4.4.0 or higher and the <a href=\"@exif\" target=\"_blank\">exif</a> library."
msgstr "Necesita droopzone versión v4.4.0 o superior y la biblioteca <a href=\"@exif\" target=\"_blank\">exif</a>."

msgid "Max width"
msgstr "Ancho máximo"

msgid "Max height"
msgstr "Altura máxima"

msgid "Resize method"
msgstr "Método de redimensionamiento"

msgid "Contain (scale)"
msgstr "Contener (escalar)"

msgid "Crop"
msgstr "Recortar"

msgid "Thumbnail method"
msgstr "Método de miniatura"

msgid "Invalid extension list format."
msgstr "Formato de la lista de extensiones no válidas."

msgid "Adds DropzoneJS upload integration."
msgstr "Añade integración de subida de DropzoneJS."

msgid "Missing requirement: in order to use this widget you have to install Inline entity form module first"
msgstr "Falta requisito: Para poder usar este widget hay que instalar antes el módulo Inline Entity Form. "

msgid "Edit"
msgstr "Editar"

msgid "Media Entity DropzoneJS with edit"
msgstr "Media Entity de DropzoneJS con edición"

msgid "Adds DropzoneJS upload integration that saves Media entities and allows to edit them."
msgstr "Añade integración de subida de DropzoneJS que guarda entidades de medio y permite editarlas."

msgid "The type of media entity to create from the uploaded file(s)."
msgstr "Tipo de entidad de medio que se crea a partir de el/los archivo(s) subido(s)."

msgid "You must @create_media_type before using this widget."
msgstr "Debe @create_media_type antes de utilizar este widget."

msgid "create a media type"
msgstr "crear un tipo de medio"

msgid "Media Entity DropzoneJS"
msgstr "Media Entity DropzoneJS"

msgid "Adds DropzoneJS upload integration that saves Media entities."
msgstr "Añade integración de subida de DropzoneJS que guarda entidades de medio."

msgid "For security reasons, your upload has been renamed to %filename."
msgstr "Por razones de seguridad, el archivo que ha subido se ha renombrado como %filename."

msgid "The specified file %name could not be uploaded."
msgstr "El archivo especificado %name no se pudo subir."

msgid "The file could not be uploaded because the destination %destination is invalid."
msgstr "El archivo no se pudo subir porque el destino %destination no es válido."

msgid "File upload error. Could not move uploaded file."
msgstr "Error al subir el archivo. No se puede mover el archivo subido."

msgid "Upload error. Could not move uploaded file %file to destination %destination."
msgstr "Error de subida. No se ha podido mover el archivo %file al destino %destination."

msgid "The file could not be saved because it exceeds the maximum allowed size for uploads."
msgstr "El archivo no se ha podido guardar porque sobrepasa el tamaño máximo permitido de las subidas."

msgid "The file could not be saved because the upload did not complete."
msgstr "El archivo no se ha podido guardar porque la subida no se ha completado."

msgid "The file could not be saved. An unknown error has occurred."
msgstr "No se ha podido guardar el archivo. Ha ocurrido un error desconocido."

msgid "There was a problem while processing the file named @name"
msgstr "Ha habido un problema al procesar el archivo llamado @name"

msgid "You don't have sufficent permissions to use the DropzoneJS uploader. Contact your system administrator"
msgstr "No tiene permisos suficientes para utilizar el cargador de DropzoneJS. Póngase en contacto con el administrador del sistema"

msgid "A maximum of @count files can be uploaded."
msgstr "Pueden subirse un máximo de @count archivos."

msgid "Drop file here to upload it"
msgid_plural "Drop files here to upload them"
msgstr[0] "Suelte el archivo aquí para cargarlo"
msgstr[1] "Suelte los archivos aquí para subirlos"

