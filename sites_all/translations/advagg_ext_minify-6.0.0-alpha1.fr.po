msgid "Advagg External Minification: PHP shell_exec"
msgstr "Minimisation externe d'Advagg : PHP shell_exec"

msgid "PHP shell_exec is non-functional."
msgstr "PHP shell_exec est inopérant."

msgid "Check php.ini for safemode or <a href=\"@link\" target=\"_blank\">disable_functions</a>."
msgstr "Vérifiez si php.ini est en mode sécurisé ou <a href=\"@link\" target=\"_blank\">désactivez les fonctions</a>."

msgid "Enabled"
msgstr "Activé"

msgid "AdvAgg External Minification"
msgstr "Minimisation externe d'Advagg"

msgid "Minify Javascript and/or CSS with a command line minifier."
msgstr "Minimisez Javascript et/ou CSS à l'aide d'un programme de minimisation avec ligne de commande."

msgid "Advanced CSS/JS Aggregation"
msgstr "Agrégation CSS/JS avancée"

msgid "External Minification"
msgstr "Minimisation externe"

msgid "AdvAgg external minification settings."
msgstr "Paramètres de minimisation externe d'AdvAgg."

msgid "AdvAgg: External Minifiers"
msgstr "AdvAgg : Programmes de minimisation externes"

msgid "Settings"
msgstr "Paramètres"

msgid "Command line for external CSS minification."
msgstr "Ligne de commande pour la minimisation externe de CSS."

msgid "Whether to use the external CSS minifier if configured."
msgstr "Indique si le programme de minimisation externe de CSS doit être utilisé s'il est configuré."

msgid "Command line for external JavaScript minification."
msgstr "Ligne de commande pour la minimisation externe de JavaScript."

msgid "Whether to use the external JS minifier if configured."
msgstr "Indique si le programme de minimisation externe de JS doit être utilisé s'il est configuré."

msgid "CSS"
msgstr "CSS"

msgid "JavaScript"
msgstr "JavaScript"

msgid "Command Line"
msgstr "Ligne de commande"

msgid "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = input file. <br /> {%IN_URL_ENC%} = url pointing to the input file that has been url encoded. <br /> {%OUT%} = output file. <br /><br />"
msgstr "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = fichier d'entrée. <br /> {%IN_URL_ENC%} = URL pointant vers le fichier d'entrée qui a été codé en URL. <br /> {%OUT%} = fichier de sortie. <br /><br />"

msgid "Example using the <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"
msgstr "Exemple d'utilisation de <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "Exemple d'utilisation du <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"

msgid "Example using curl to minify via the <a href=\"@link1\">Online Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "Exemple d'utilisation de curl pour la minimisation via <a href=\"@link1\">Online Google Closure Compiler</a>. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">YUI Compressor</a>. <p><code>@code1</code></p>"
msgstr "Exemple d'utilisation de <a href=\"@link1\">YUI Compresseur</a>. <p><code>@code1</code></p>"

msgid "Example using curl to minify via an online <a href=\"@link1\">CSS Minifier</a>. <p><code>@code1</code></p>"
msgstr "Exemple d'utilisation de curl pour la minimisation via un <a href=\"@link1\">CSS Minifier</a> en ligne. <p><code>@code1</code></p>"

msgid "Command to run"
msgstr "Commande à exécuter"

msgid "Enable external @type minification"
msgstr "Activer la minimisation @type externe"

