msgid "Back To Top"
msgstr "Başa Dön"

msgid "Back To Top adds a button that hovers in the bottom of your screen and allow users to smoothly scroll up the page using jQuery."
msgstr "Başa Dön, imleci ekranınızın altına getiren ve kullanıcıların jQuery kullanarak sayfayı kolayca yukarı doğru kaydırmasını sağlayan bir düğme ekler. "

msgid "User interface"
msgstr "Kullanıcı arayüzü"

msgid "Back to Top"
msgstr "En üste git"

msgid "Administer Back To Top settings."
msgstr "Başa Dön ayarlarını yönetin."

msgid "Back to top settings"
msgstr "Başa dön ayarları"

msgid "Access Back to top settings"
msgstr "Başa dön ayarlarına erişin"

msgid "Prevent on mobile and touch devices"
msgstr "Mobil ve dokunmatik aygıtlarda önle"

msgid "Prevent on administration pages and node edit"
msgstr "Yönetim sayfalarında ve düğüm düzenlemede önle"

msgid "Prevent on front page"
msgstr "Ön sayfada önle"

msgid "Trigger"
msgstr "Tetikleyici"

msgid "Placement"
msgstr "Yerleşim"

msgid "Button text"
msgstr "Buton metni"

msgid "Button type"
msgstr "Düğme tipi"

msgid "Background color"
msgstr "Arkaplan rengi"

msgid "Border color"
msgstr "Kenarlık rengi"

msgid "Hover color"
msgstr "İmlec rengi"

msgid "Text color"
msgstr "Yazı rengi"

msgid "Back to top"
msgstr "Başa dön"

msgid "Don´t show Back To Top-button on screen width up to 760px."
msgstr "760 piksele kadar ekran genişliğinde Başa Dön düğmesini gösterme."

msgid "Do you want to prevent Back To Top on admin pages?"
msgstr "Yönetim sayfalarında Başa Dön özelliğini önlemek istiyor musunuz?"

msgid "Do you want to prevent Back To Top on front page?"
msgstr "Ön sayfada Başa Dön özelliğini önlemek istiyor musunuz?"

msgid "Set the number of pixel which trigger the Back To Top button default 100"
msgstr "Başa Dön düğmesini tetikleyen piksel sayısını varsayılan 100 olarak ayarla"

msgid "Where should the Back To Top button appear?"
msgstr "Başa Dön düğmesi nerede görünmelidir?"

msgid "Bottom right"
msgstr "Alt sağ"

msgid "Bottom left"
msgstr "Alt sol"

msgid "Bottom center"
msgstr "Alt orta"

msgid "Top right"
msgstr "Üst sağ"

msgid "Top left"
msgstr "Üst sol"

msgid "Top center"
msgstr "Üst orta"

msgid "Mid right"
msgstr "Orta sağ"

msgid "Mid left"
msgstr "Orta sol"

msgid "Mid center"
msgstr "Orta"

msgid "Set the text of the Back To Top button"
msgstr "Başa Dön düğmesinin metnini ayarla"

msgid "Do you want Back To Top to use a PNG-24 image or a Text/Css button?"
msgstr "Başa Dön düğmesinin PNG-24 resim veya Metin/Css düğmesi mi kullanmasını istiyorsunuz?"

msgid "Image (default)"
msgstr "Resim (varsayılan)"

msgid "Text/Css"
msgstr "Metin/Css"

msgid "Text/Css button settings"
msgstr "Metin/Css düğmesi ayarları"

msgid "Button background color default #F7F7F7"
msgstr "Düğme arka plan rengi varsayılan değeri #F7F7F7"

msgid "Border color default #CCCCCC"
msgstr "Kenarlık rengi varsayılan değeri #CCCCCC"

msgid "Hover color default #EEEEEE"
msgstr "İmleç rengi varsayılan değeri #EEEEEE"

msgid "Text color default #333333"
msgstr "Metin rengi varsayılan değeri #333333"

