msgid "Client-side Hierarchical Select"
msgstr "客户机端分层选择"

msgid "A simple client-side hierarchical select widget for taxonomy terms."
msgstr "分类术语的简单客户机端分层选择窗口小部件。"

msgid "Widgets"
msgstr "微件"

msgid "CSHS field widget settings"
msgstr "CSHS 字段窗口小部件设置"

msgid "Save lineage"
msgstr "保存沿袭"

msgid "Force selection of deepest level"
msgstr "强制选择最深的级别"

msgid "Parent"
msgstr "父级"

msgid "Labels per hierarchy-level"
msgstr "每个层次结构级别的标签"

msgid "Hierarchy depth"
msgstr "层次结构深度"

msgid "Required depth"
msgstr "所需深度"

msgid "The \"no selection\" label"
msgstr "“无选择”标签"

msgid "Client-side Hierarchical Select: Menu Link"
msgstr "客户机端分层选择：菜单链接"

msgid "A client-side hierarchical selection of parents for the menu link. Works for node and term forms (with \"taxonomy_menu_ui\" enabled)."
msgstr "菜单链接父项的客户机端分层选择。适用于节点和术语表单（已启用“taxonomy_menu_ui”）。"

msgid "Deepest"
msgstr "最深"

msgid "None"
msgstr "无"

msgid "Yes"
msgstr "是"

msgid "No"
msgstr "否"

msgid "Parent: @parent"
msgstr "父项：@parent"

msgid "Force deepest: @force_deepest"
msgstr "强制最深：@force_deepest"

msgid "Save lineage: @save_lineage"
msgstr "保存沿袭：@save_lineage"

msgid "Level labels: @level_labels"
msgstr "级别标签：@level_labels"

msgid "The \"no selection\" label: @none_label"
msgstr "“无选择”标签：@none_label"

msgid "Select a parent term to use only a subtree of a vocabulary for this field."
msgstr "选择父级术语，以仅为此字段使用词汇表子树。"

msgid "Force the deepest level selection"
msgstr "强制最深层选择"

msgid "If checked the user will be forced to select terms from the deepest level."
msgstr "勾选后，将强制用户从最深的级别选择术语。"

msgid "Enter labels for each hierarchy-level separated by comma."
msgstr "为逗号分隔的每个层次结构级别输入标签。"

msgid "The label for an empty option."
msgstr "空选项的标签。"

msgid "The hierarchy depth cannot be @actual because the selection list has @levels levels."
msgstr "层次结构深度不能为 @actual，因为选择列表具有 @levels 个级别。"

msgid "The required depth cannot be greater than the hierarchy depth."
msgstr "所需的深度不能大于层次结构深度。"

msgid "Format"
msgstr "格式"

msgid "Specify a format for each field item by using tokens."
msgstr "通过使用令牌为每个字段项指定格式。"

msgid "Clear Tokens"
msgstr "清除令牌"

msgid "Remove token from final text if no replacement value is generated"
msgstr "如果未生成替换值，那么从最终文本中除去令牌"

msgid "Format: @format"
msgstr "格式：@format"

msgid "Flexible hierarchy"
msgstr "弹性层次结构"

msgid "Allows to specify the output with tokens."
msgstr "允许使用令牌指定输出。"

msgid "Link to term page"
msgstr "链接到术语页面"

msgid "Reverse order view"
msgstr "倒序视图"

msgid "Outputs hierarchy in reverse order (the deepest level first)."
msgstr "倒序输出层次结构（首先是最深的级别）。"

msgid "Linked to term page: @linked"
msgstr "链接到术语页面：@linked"

msgid "Reverse order view: @reverse"
msgstr "倒序视图：@reverse"

msgid "Separator"
msgstr "分隔符"

msgid "Specify a separator which will be placed in between the different hierarchy levels."
msgstr "指定将在不同的层次结构级别间放入的分隔符。"

msgid "Separator: @separator"
msgstr "分隔符：@separator"

msgid "Full hierarchy"
msgstr "完全层次结构"

msgid "Display the full hierarchy of the taxonomy term."
msgstr "显示分类术语的完全层次结构。"

msgid "Sorting"
msgstr "排序"

msgid "Depth"
msgstr "深度"

msgid "The maximum hierarchy depth. Use 0 to not limit or 1 to display just the root term (or the last if reverse order selected)."
msgstr "最大层次结构深度。 使用 0 至不限制或 1 仅显示根项（如果选择了反向顺序，则使用最后一个）。"

msgid "Last child"
msgstr "最后一个子代"

msgid "Show only the root term and its deepest child."
msgstr "仅显示根术语及其最深的子代。"

msgid "Sorting: @value"
msgstr "排序：@value"

msgid "Depth: @value"
msgstr "深度：@value"

msgid "Last child only"
msgstr "仅最后一个子代"

msgid "Unlimited"
msgstr "不限"

msgid "Hierarchy grouped by root"
msgstr "按根目录对层次结构分组"

msgid "Display the hierarchy of the taxonomy term grouped by root."
msgstr "显示按根目录分组的分类术语层次结构。"

msgid "Client-side hierarchical select"
msgstr "客户端分层选择"

msgid "An invalid vocabulary is selected. Please change it in the options."
msgstr "选择了一个无效的词汇表.请在选项中进行修改."

msgid "About"
msgstr "关于"

msgid "Settings"
msgstr "设置"

msgid "Multi-lingual"
msgstr "多语言"

msgid "Supports multi-lingual terms localized with i18n_taxonomy module (Which is part of the i18n package)."
msgstr "支持使用 i18n_taxonomy 模块（为 i18n 包的一部分）本地化的多语言术语。"

