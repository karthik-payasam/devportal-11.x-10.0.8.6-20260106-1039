msgstr "başlık"

msgid "The title of the email list."
msgstr "E-posta listesinin başlığı."

msgid "Description"
msgstr "Açıklama"

msgid "The description of the email list."
msgstr "E-posta listesinin açıklaması."

msgid "Data"
msgstr "Veriler"

msgid "The email list data."
msgstr "E-posta listesi verileri."

