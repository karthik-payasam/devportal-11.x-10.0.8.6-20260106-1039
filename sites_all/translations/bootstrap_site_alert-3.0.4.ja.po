msgid "Bootstrap Site Alert"
msgstr "ブートストラップ・サイト・アラート"

msgid "This module is for rendering alerts site wide using the power of Bootstrap"
msgstr "このモジュールは、ブートストラップの機能を使用してサイト全体でアラートをレンダリングするためのものです"

msgid "Other"
msgstr "その他"

msgid "Bootstrap Site Alert Configuration"
msgstr "ブートストラップ・サイト・アラート構成"

msgid "Configure the Bootstrap Site Wide Alert Settings"
msgstr "サイト全体のブートストラップ・アラート設定の構成"

msgid "Administer Bootstrap Site Alert"
msgstr "ブートストラップ・サイト・アラートの管理"

msgid "View Bootstrap Site Alert"
msgstr "ブートストラップ・サイト・アラートの表示"

msgid "Settings"
msgstr "設定"

msgid ""
"<h3>Use this form to setup the bootstrap site alert(s).</h3>\n"
"                  <p>Make sure you select the checkbox if you want to turn the alerts on</p>"
msgstr ""
"<h3>ブートストラップ・サイト・アラートをセットアップするには、このフォームを使用します。</h3>\n"
"                  <p>アラートをオンにする場合は、必ずこのチェック・ボックスを選択してください。</p>"

msgid "Select Bootstrap Version"
msgstr "ブートストラップ・バージョンの選択"

msgid "3"
msgstr "3"

msgid "4"
msgstr "4"

msgid "- SELECT -"
msgstr "- 選択 -"

msgid "Save Bootstrap Version"
msgstr "ブートストラップ・バージョンの保存"

msgid "Success"
msgstr "成功"

msgid "Info"
msgstr "Info"

msgid "Warning"
msgstr "警告"

msgid "Danger"
msgstr "危険"

msgid "Primary"
msgstr "プライマリー"

msgid "Secondary"
msgstr "セカンダリー"

msgid "Light"
msgstr "明るい"

msgid "Dark"
msgstr "濃い"

msgid "If Checked, Bootstrap Site Alert is Active."
msgstr "チェック・マークを付けると、ブートストラップ・サイト・アラートはアクティブになります。"

msgid "Severity"
msgstr "重大度"

msgid "Make this alert dismissable?"
msgstr "このアラートを消去可能にしますか?"

msgid "Hide this alert on admin pages?"
msgstr "このアラートを管理ページに表示しないようにしますか?"

msgid "Only Show On Certain Pages?"
msgstr "特定のページのみに表示しますか?"

msgid "Path(s) to show on"
msgstr "表示先のパス"

msgid "Specify pages by using their paths. Enter one path per line. The '*' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page."
msgstr "パスでページを指定します。1行に1つのパスを入力してください。'*' の文字はワイルドカードです。%user-wildcard とした場合はすべてのユーザーページが対象となります。%front はフロントページを表します。"

msgid "Alert Message"
msgstr "アラート・メッセージ"

msgid "Add Another Alert"
msgstr "別のアラートを追加"

msgid "Remove Last Alert"
msgstr "最後のアラートを削除"

msgid "Save Alert Message(s)"
msgstr "アラート・メッセージの保存"

