msgid "Bootstrap Site Alert"
msgstr "Bootstrap Site Alert"

msgid "This module is for rendering alerts site wide using the power of Bootstrap"
msgstr "Этот модуль предназначен для вывода предупреждений на всем сайте с помощью функций Bootstrap"

msgid "Other"
msgstr "Другое"

msgid "Bootstrap Site Alert Configuration"
msgstr "Конфигурация предупреждения Bootstrap для сайта"

msgid "Configure the Bootstrap Site Wide Alert Settings"
msgstr "Настроить параметры предупреждений Bootstrap для всего сайта"

msgid "Administer Bootstrap Site Alert"
msgstr "Администрировать предупреждение Bootstrap для сайта"

msgid "View Bootstrap Site Alert"
msgstr "Показать предупреждение Bootstrap для сайта"

msgid "Settings"
msgstr "Настройки"

msgid ""
"<h3>Use this form to setup the bootstrap site alert(s).</h3>\n"
"                  <p>Make sure you select the checkbox if you want to turn the alerts on</p>"
msgstr ""
"<h3>Используйте эту форму для настройки предупреждений bootstrap для сайта.</h3>\n"
"                  <p>Для включения предупреждений включите переключатель</p>"

msgid "Select Bootstrap Version"
msgstr "Выбрать версию Bootstrap"

msgid "3"
msgstr "3"

msgid "4"
msgstr "4"

msgid "- SELECT -"
msgstr "- Выбрать -"

msgid "Save Bootstrap Version"
msgstr "Сохранить версию Bootstrap"

msgid "Success"
msgstr "Успешно"

msgid "Info"
msgstr "Инфо"

msgid "Warning"
msgstr "Предупреждение"

msgid "Danger"
msgstr "Опасность"

msgid "Primary"
msgstr "Первичный"

msgid "Secondary"
msgstr "Вторичный"

msgid "Light"
msgstr "Светлая"

msgid "Dark"
msgstr "Темный"

msgid "If Checked, Bootstrap Site Alert is Active."
msgstr "Если включен, то модуль Bootstrap Site Alert активен."

msgid "Severity"
msgstr "Важность"

msgid "Make this alert dismissable?"
msgstr "Указать для этого предупреждения возможность закрытия?"

msgid "Hide this alert on admin pages?"
msgstr "Скрыть это предупреждение на страницах администрирования?"

msgid "Only Show On Certain Pages?"
msgstr "Показывать только на конкретных страницах?"

msgid "Path(s) to show on"
msgstr "Пути для отображения"

msgid "Specify pages by using their paths. Enter one path per line. The '*' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page."
msgstr "Укажите адреса страниц. Укажите по одному адресу на строку. Знак '*' означает любой набор символов после него. Например, путь %user-wildcard страницы всех пользователей. %front - главная страница."

msgid "Alert Message"
msgstr "Сообщение предупреждения"

msgid "Add Another Alert"
msgstr "Добавить другое предупреждение"

msgid "Remove Last Alert"
msgstr "Удалить последнее предупреждение"

msgid "Save Alert Message(s)"
msgstr "Сохранить сообщения предупреждений"

