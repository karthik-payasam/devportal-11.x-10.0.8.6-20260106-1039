msgid "Policy"
msgstr "Politica"

msgid "Status"
msgstr "Stato"

msgid "Constraint"
msgstr "Vincolo"

msgid "There are no constraints for the selected user roles"
msgstr "Non vi sono vincoli per i ruoli utente selezionati"

msgid "The password does not satisfy the password policies."
msgstr "La password non soddisfa le politiche della password. "

msgid "Your password has expired. Please visit the following link to reset your password: :link"
msgstr "La password è scaduta. Visitare il seguente link per reimpostare la password: :link"

msgid "Your password will expire in less than :pending days. Please visit the following link to reset your password: :link"
msgstr "La password scadrà tra meno di :pending giorni. Visitare il seguente link per reimpostare la password: :link"

msgid "You need to reset your password."
msgstr "È necessario reimpostare la password."

msgid "Your password will expire soon."
msgstr "La password scadrà a breve."

msgid "The Password Policy module has updated user accounts. Total update count: @count"
msgstr "Il modulo Politica della password contiene account utente aggiornati. Conteggio totale di aggiornamenti: @count"

msgid "Password Policy"
msgstr "Politica di password"

msgid "Sets up constraints and expiration of passwords."
msgstr "Imposta i vincoli e la scadenza delle password."

msgid "Security"
msgstr "Sicurezza"

msgid "Add Policy"
msgstr "Aggiungi politica"

msgid "Configuring security settings."
msgstr "Configurazione delle impostazioni di sicurezza."

msgid "Create password policies."
msgstr "Creare le politiche di password."

msgid "Manage password reset"
msgstr "Gestisci reimpostazione password"

msgid "Be able to manually override user password reset dates."
msgstr "Possibilità di sostituire manualmente le date di reimpostazione della password utente."

msgid "Force Password Reset"
msgstr "Forza reimpostazione della password"

msgid "Delete policy"
msgstr "Elimina politica"

msgid "Password Policies"
msgstr "Politiche di password"

msgid "Edit password_policy"
msgstr "Modifica password_policy"

msgid "Add Password Policy"
msgstr "Aggiungi politica della password"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "Etichetta"

msgid "Password reset"
msgstr "Reimpostazione password "

msgid "Password reset send email"
msgstr "Invia email di reimpostazione della password"

msgid "Password reset pending days"
msgstr "Giorni rimasti per la reimpostazione della password"

msgid "Password reset pending day"
msgstr "Giorno rimasto per la reimpostazione della password"

msgid "Language"
msgstr "Lingua"

msgid "Constraints"
msgstr "Vincoli"

msgid "Show policy table"
msgstr "Mostra tabella della politica"

msgid "Roles"
msgstr "Ruoli"

msgid "Role"
msgstr "Ruolo"

msgid "Constraint settings"
msgstr "Impostazioni dei vincoli"

msgid "Password Policy settings"
msgstr "Impostazioni della politica della password "

msgid "Cron threshold"
msgstr "Soglia Cron "

msgid "Password Blacklist Policy"
msgstr "Politica blacklist password"

msgid "Create a blacklist of phrases that cannot be used in passwords."
msgstr "Creare una blacklist di frasi che non possono essere utilizzate nelle password."

msgid "Blacklist"
msgstr "Blacklist"

msgid "Password"
msgstr "Password"

msgid "Match substrings"
msgstr "Corrispondenza sottostringhe"

msgid "There are restricted terms in your password. Please modify your password."
msgstr "La password contiene termini con limitazioni. Modificare la password."

msgid "Your password is on the blacklist. Please choose a different password."
msgstr "La password è nella blacklist. Scegliere una password diversa."

msgid "Also disallow passwords containing blacklisted passwords"
msgstr "Inoltre, non consentire password contenenti le password inserite nella blacklist"

msgid "Blacklisted passwords"
msgstr "Password inserite nella blacklist"

msgid "Password cannot be a member of this list, ignoring case. Enter one password per line."
msgstr "La password non può essere un membro di questo elenco, ignorando maiuscolo/minuscolo. Immettere una password per riga."

msgid "Password must not contain any restricted words or phrases."
msgstr "La password non deve contenere parole o frasi con limitazioni."

msgid "Password must not be on the blacklist."
msgstr "La password non deve essere nella blacklist."

msgid "Password Blacklist"
msgstr "Blacklist delle password"

msgid "Password cannot match certain disallowed passwords"
msgstr "La password non può corrispondere a determinate password non consentite"

msgid "Your password contains restricted words or phrases."
msgstr "La password contiene parole o frasi con limitazioni."

msgid "Password Character Types Policy"
msgstr "Politica Tipi di carattere della password"

msgid "Minimum number of different character types the password must contain."
msgstr "Il numero minimo di tipi di caratteri differenti che la password deve contenere. "

msgid "Character Types"
msgstr "Tipi di carattere"

msgid "Invalid plugin configuration."
msgstr "Configurazione plugin non valida."

msgid "Password must contain at least @types types of characters from the following character types: lowercase letters, uppercase letters, digits, special characters."
msgstr "La password deve contenere almeno @types tipi di caratteri tra i seguenti: lettere minuscole, lettere maiuscole, numeri, caratteri speciali. "

msgid "Minimum number of character types"
msgstr "Numero massimo di tipi di carattere"

msgid "Select the minimum number of character types which must be found in a password. The four supported character types are given as: lowercase letters, uppercase letters, digits, special characters."
msgstr "Selezionare il numero minimo di tipi di caratteri che devono essere presenti in una password. I quattro tipi di caratteri supportati sono: lettere minuscole, lettere maiuscole, numeri, caratteri speciali. "

msgid "The number of character types must be between 2 and 4."
msgstr "Il numero di tipi di carattere deve essere compreso tra 2 e 4. "

msgid "Minimum password character types: @types"
msgstr "Numero minimo di tipi di carattere della password: @types"

msgid "Password character types"
msgstr "Tipi di carattere della password"

msgid "Verifying that a password has a minimum number of character types."
msgstr "Verifica che la password contenga un numero minimo di tipi di carattere."

msgid "Your password must have different character types."
msgstr "La password deve contenere tipi di carattere differenti."

msgid "Password Characters of Type Policy"
msgstr "Politica Caratteri password di tipo "

msgid "Minimum characters of a particular type the password must contain."
msgstr "Numero minimo di caratteri di un particolare tipo che la password deve contenere. "

msgid "Number of characters"
msgstr "Numero di caratteri"

msgid "Character type"
msgstr "Tipo di carattere"

msgid "Uppercase"
msgstr "Maiuscolo"

msgid "Lowercase"
msgstr "Minuscolo"

msgid "Letter"
msgstr "Lettera"

msgid "Numeric"
msgstr "Numerico"

msgid "Special Character"
msgstr "Carattere speciale"

msgid "The number of characters must be a positive number."
msgstr "Il numero di caratteri deve essere un numero positivo. "

msgid "Password must contain at least 1 uppercase character."
msgid_plural "Password must contain at least @count unique uppercase characters."
msgstr[0] "La password deve contenere almeno 1 carattere maiuscolo."
msgstr[1] "la password deve contenere almeno @count caratteri maiuscoli univoci."

msgid "Password must contain at least 1 lowercase character."
msgid_plural "Password must contain at least @count unique lowercase characters."
msgstr[0] "La password deve contenere almeno 1 carattere minuscolo."
msgstr[1] "La password deve contenere almeno @count caratteri minuscoli univoci."

msgid "Password must contain at least 1 letter character."
msgid_plural "Password must contain at least @count unique letter characters."
msgstr[0] "La password deve contenere almeno 1 carattere lettera."
msgstr[1] "La password deve contenere almeno @count caratteri lettera univoci."

msgid "Password must contain at least 1 special character."
msgid_plural "Password must contain at least @count unique special characters."
msgstr[0] "La password deve contenere almeno 1 carattere speciale."
msgstr[1] "La password deve contenere almeno @count caratteri speciali univoci."

msgid "Password must contain at least 1 numeric character."
msgid_plural "Password must contain at least @count unique numeric characters."
msgstr[0] "La password deve contenere almeno 1 carattere numerico."
msgstr[1] "La password deve contenere almeno @count caratteri numerici univoci."

msgid "Password character type"
msgstr "Tipo di carattere della password"

msgid "Verifying that a password has a specific number of characters"
msgstr "Verifica che la password contenga un numero specifico di caratteri"

msgid "The password does not contain a the correct number of certain characters."
msgstr "La password non contiene il numero corretto di determinati caratteri."

msgid "Password Consecutive Characters Policy"
msgstr "Politica caratteri consecutivi password "

msgid "Sets up a consecutive characters constraint for passwords."
msgstr "Imposta un vincolo di caratteri consecutivi per le password. "

msgid "Maximum consecutive character count"
msgstr "Numero massimo di caratteri consecutivi "

msgid "No consecutive identical characters are allowed."
msgstr "Non sono consentiti caratteri identici consecutivi."

msgid "Password must have fewer than @max consecutive identical characters. This is case sensitive."
msgstr "La password deve contenere meno di @max caratteri identici consecutivi. Questa opzione è sensibile al maiuscolo/minuscolo. "

msgid "Consecutive identical characters fewer than: @max"
msgstr "Caratteri identici consecutivi inferiori a: @max"

msgid "Consecutive identical characters fewer than"
msgstr "Caratteri identici consecutivi inferiori a"

msgid "This many or more consecutive identical characters will not be allowed in the password."
msgstr "Nella password non sarà consentito un numero di caratteri identici consecutivi uguale o superiore a questo numero."

msgid "The number of consecutive identical characters must be higher than 1 otherwise all passwords will fail."
msgstr "Il numero caratteri identici consecutivi deve essere maggiore di 1, in caso contrario tutte le password avranno esito negativo. "

msgid "Consecutive characters"
msgstr "Caratteri consecutivi "

msgid "Verifying that a password has a maximum number of consecutive identical characters."
msgstr "Verifica che la password contenga un numero massimo di caratteri identici consecutivi. "

msgid "Your password has too many consecutive characters."
msgstr "La password contiene troppi caratteri consecutivi. "

msgid "Password Policy Delay"
msgstr "Ritardo politica della password"

msgid "Sets up a password constraint to limit how soon before a password can be reset again."
msgstr "Imposta un vincolo di password per limitare il tempo prima che una password possa essere reimpostata di nuovo."

msgid "Hours until next password reset may be performed."
msgstr "Numero di ore prima che venga eseguita la successiva reimpostazione della password."

msgid ""
"Not enough time has passed\n"
"          since this password was last reset."
msgstr ""
"Non è trascorso abbastanza tempo \n"
"dall'ultima reimpostazione di questa password."

msgid "Hours until password can be reset again."
msgstr "Numero di ore prima che la password possa essere reimpostata di nuovo."

msgid "A value of 0 represents no delay"
msgstr "Il valore 0 rappresenta nessun ritardo"

msgid "The delay value must be zero or greater."
msgstr "Il valore di ritardo deve essere maggiore o uguale a zero."

msgid "Delay in hours until password can be reset: @delay"
msgstr "Ritardo in ore prima che sia possibile reimpostare la password: @delay"

msgid "Password Delay"
msgstr "Ritardo password"

msgid "Provide delay before password can be reset again."
msgstr "Fornire un ritardo prima che la password possa essere reimpostata."

msgid "You cannot reset your password until the delay has as elapsed."
msgstr "Non è possibile reimpostare la password fino a quando il ritardo non è trascorso."

msgid "Password Policy History"
msgstr "Cronologia politica della password"

msgid "Sets up a password constraint to limit repeated use of the same password."
msgstr "Imposta un vincolo della password per limitare l'utilizzo ripetuto della stessa password."

msgid "Previous passwords cannot be reused. Choose a different password."
msgstr "Le password precedenti non possono essere riutilizzate. Scegliere una password differente."

msgid "Number of passwords that will be checked in the user password update history"
msgstr "Numero di password che verranno inserite nella cronologia di aggiornamento della password dell'utente"

msgid "A value of 0 represents that the user can not repeat any of the old passwords."
msgstr "Il valore 0 indica che l'utente non può ripetere nessuna delle vecchie password."

msgid "The number of repeated passwords value must be zero or greater."
msgstr "Il numero di password ripetute deve essere un numero maggiore o uguale a zero."

msgid "Number of passwords that will be checked in the user password update history: @number-repeats"
msgstr "Numero di password che verranno inserite nella cronologia di aggiornamento della password dell'utente: @number-repeats"

msgid "The last @count password cannot be reused. Choose a different password."
msgid_plural "The last @count passwords cannot be reused. Choose a different password."
msgstr[0] "Non è possibile utilizzare @count password precedente. Scegliere una password diversa."
msgstr[1] "Non è possibile utilizzare @count password precedenti. Scegliere una password diversa."

msgid "Password History"
msgstr "Cronologia password"

msgid "Provide restrictions on previously used passwords."
msgstr "Fornire le limitazioni per le password utilizzate in precedenza."

msgid "You have used the same password previously and cannot."
msgstr "La stessa password è già stata utilizzata in precedenza e non può essere riutilizzata."

msgid "Password Character Length Policy"
msgstr "Politica Lunghezza caratteri password"

msgid "Sets up a character length constraint for passwords."
msgstr "Imposta un vincolo per la lunghezza dei caratteri per le password."

msgid "Operation"
msgstr "Operazione"

msgid "Minimum length"
msgstr "Lunghezza minima "

msgid "Maximum length"
msgstr "Lunghezza massima"

msgid "The character length must be a positive number."
msgstr "La lunghezza dei caratteri deve essere un numero positivo. "

msgid "at least"
msgstr "almeno"

msgid "at most"
msgstr "al massimo"

msgid "Password length must be at least 1 character."
msgid_plural "Password length must be at least @count characters."
msgstr[0] "La lunghezza della password deve essere almeno 1 carattere."
msgstr[1] "La lunghezza della password deve essere almeno @count caratteri."

msgid "Password length must not exceed 1 character."
msgid_plural "Password length must not exceed @count characters."
msgstr[0] "La lunghezza della password non deve superare 1 carattere."
msgstr[1] "La lunghezza della password non deve superare @count caratteri."

msgid "Password character length of @operation 1 character"
msgid_plural "Password character length of @operation @characters characters"
msgstr[0] "Lunghezza carattere password di @operation 1 carattere"
msgstr[1] "Lunghezza carattere password di caratteri @characters "

msgid "Password character length"
msgstr "Lunghezza caratteri password "

msgid "Verifying that a password has a minimum character length"
msgstr "Verifica che la password contenga una lunghezza minima di caratteri"

msgid "The length of your password is too short."
msgstr "La password è troppo breve. "

msgid "Password Username Policy"
msgstr "Politica Nome utente password "

msgid "Restrict users from having their username in their password."
msgstr "Impedire agli utenti di utilizzare il proprio nome utente nella password."

msgid "Disallow username"
msgstr "Non consentire nome utente"

msgid "Password must not contain the username."
msgstr "La password non deve contenere il nome utente."

msgid "Prevent user from having a password containing their username."
msgstr "Impedire agli utenti di utilizzare una password che contiene il proprio nome utente."

msgid "Password must not contain the user's username."
msgstr "La password non deve contenere il nome utente."

msgid "Password username"
msgstr "Nome utente password"

msgid "Password must not contain their username"
msgstr "La password non deve contenere il nome utente"

msgid "Your password contains your username."
msgstr "La password contiene il nome utente."

msgid "@message"
msgstr "@message"

msgid "Pass"
msgstr "Superato"

msgid "New role was added or existing password policy changed. Please update your password."
msgstr "È stato aggiunto un nuovo ruolo o la politica di password esistente è stata modificata. Aggiornare la password. "

msgid "Fail - @message"
msgstr "Errore - @message"

msgid "Machine name"
msgstr "Nome ad uso interno"

