msgstr "Vincoli politica "

msgid "Plugin Id"
msgstr "ID plugin"

msgid "Summary"
msgstr "Sommario"

msgid "Operations"
msgstr "Operazioni"

msgid "No constraints have been configured."
msgstr "Non è stato configurato alcun vincolo."

msgid "Apply to Roles"
msgstr "Applica ai ruoli"

msgid "Select Roles to which this policy applies."
msgstr "Selezionare i ruoli a cui viene applicata questa politica."

msgid "Edit"
msgstr "Modifica"

msgid "Configure Required Context"
msgstr "Configura contesto richiesto"

msgid "Force password reset of selected roles."
msgstr "Forzare la reimpostazione della password dei ruoli selezionati."

msgid "Exclude Myself"
msgstr "Escludi account personale"

msgid "Exclude your account if you are included in the roles."
msgstr "Esclude il proprio account se contenuto nei ruoli."

msgid "No roles selected."
msgstr "Nessun ruolo selezionato."

msgid "Reset the %roles role."
msgid_plural "Reset the %roles roles."
msgstr[0] "Reimposta il ruolo %roles . "
msgstr[1] "Reimposta i ruoli %roles ."

