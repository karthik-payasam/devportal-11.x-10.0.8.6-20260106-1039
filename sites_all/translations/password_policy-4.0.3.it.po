msgstr "politica di password"

msgid "password policies"
msgstr "politiche di password "

msgid "Your password has expired, please update it"
msgstr "La password è scaduta, aggiornarla"

msgid "Are you sure you want to delete the @label constraint?"
msgstr "Si è sicuri di voler eliminare il vincolo @label?"

msgid "Save"
msgstr "Salva"

msgid "Are you sure you want to delete the %name policy?"
msgstr "Si è sicuri di voler eliminare la politica %name ?"

