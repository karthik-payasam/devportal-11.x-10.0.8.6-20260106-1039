msgid "Instana EUM"
msgstr "Instana EUM"

msgid "Configures Instana End User Monitoring (EUM) beacon module."
msgstr "Nakonfiguruje modul majáku produktu Instana EUM (End User Monitoring)."

msgid "Monitoring"
msgstr "Monitorování"

msgid "Instana EUM Configuration"
msgstr "Konfigurace produktu Instana EUM"

msgid "Setup Instana EUM connection parameters."
msgstr "Nastavte parametry připojení produktu Instana EUM."

msgid "Configure the Instana EUM module"
msgstr "Konfigurace modulu produktu Instana EUM"

msgid "Setup the parameters to connect Drupal to Instana."
msgstr "Nastavte parametry pro připojení produktu Drupal k produktu Instana."

msgid "Instana EUM Settings"
msgstr "Nastavení produktu Instana EUM"

msgid "The API Key for the Instana server"
msgstr "Klíč rozhraní API pro server Instana"

msgid "The reporting URL of the Instana server"
msgstr "Adresa URL vytvářející sestavy serveru Instana"

msgid "Allow Instana to monitor page views, load times and JS errors for individual pages"
msgstr "Povolit produktu Instana monitorovat pohledy stránek, časy načtení a chyby JS pro jednotlivé stránky"

msgid "Enable monitoring of admin pages."
msgstr "Povolit monitorování stránek administrace."

msgid "Advanced settings for the Instana server configuration"
msgstr "Rozšířená nastavení pro konfiguraci serveru Instance"

msgid "Configures Instana End User Monitoring (EUM) beacon module. Please see the <a href=\"https://www.instana.com/docs/website_monitoring/\" target=\"_blank\">official documentation</a> for further details."
msgstr "Nakonfiguruje modul majáku produktu Instana EUM (End User Monitoring). Další podrobnosti naleznete v <a href=\"https://www.instana.com/docs/website_monitoring/\" target=\"_blank\">oficiální dokumentaci</a>."

msgid "API Key"
msgstr "Klíč API"

msgid "Enter the API key for your Instana server."
msgstr "Zadejte klíč rozhraní API pro váš server Instana."

msgid "Reporting URL"
msgstr "Adresa URL vytváření sestav"

msgid "Enter the Instana server reporting URL."
msgstr "Zadejte adresu URL vytváření sestav serveru Instana."

msgid "Track individual pages"
msgstr "Sledovat jednotlivé stránky"

msgid "Isolate specific pages and analyze their performance to find pages with the most traffic, or the slowest response times."
msgstr "Izolovat specifické stránky a analyzovat jejich výkon při vyhledání stránek s největším provozem nebo nejpomalejší dobou odezvy."

msgid "Admin page tracking"
msgstr "Sledování stránky administrace"

msgid "Include monitoring of pages with /admin in the url."
msgstr "Zahrnout monitorování stránek pomocí /admin v adrese URL."

msgid "You can use this to set additional EUM settings."
msgstr "Tuto volbu můžete použít k nastavení dalších nastavení EUM."

msgid "See documentation here"
msgstr "Viz dokumentace zde"

msgid "Examples:"
msgstr "Příklady:"

msgid "Advanced Settings"
msgstr "Rozšířená nastavení"

