msgstr "(@filename)"

msgid "(@export_format)"
msgstr "(@export_format)"

msgid "Batch"
msgstr "Dávka"

msgid "Exports under one request. Best fit for small exports."
msgstr "Exportuje v jednom požadavku. Nejvhodnější pro malé exporty."

msgid "Exports data in sequences. Should be used when large amount of data is exported (> 2000 rows)."
msgstr "Exportuje data v posloupnostech. Měl by být použit při exportu velkého množství dat (> 2000 řádků)."

msgid "The number of rows to process under a request."
msgstr "Počet řádků ke zpracování v rámci požadavku."

msgid "The maximum amount of rows to export. 0 means unlimited."
msgstr "Maximální množství řádků k exportu. 0 znamená bez omezení."

msgid "File Storage/Download Settings"
msgstr "Nastavení paměti souborů/stahování"

msgid "Filename"
msgstr "Název souboru"

msgid "The filename that will be suggested to the browser for downloading purposes. You may include replacement patterns from the list below."
msgstr "Název souboru, který bude navržen prohlížeči pro účely stažení. Můžete vložit vzory nahrazení ze seznamu níže. "

msgid "Store file in public files directory"
msgstr "Uložit soubor do adresáře veřejných souborů"

msgid "Check this if you want to store the export files in the public:// files directory instead of the private:// files directory."
msgstr "Zaškrtněte toto, chcete-li uložit soubory exportu do adresáře souborů public:// adresáře souborů private://."

msgid "<strong>The private:// file system is not configured so the exported files will be stored in the public:// files directory. Click <a href=\"@link\" target=\"_blank\">here</a> for instructions on configuring the private files in the settings.php file.</strong>"
msgstr "<strong>Systém souborů private:// není nakonfigurován tak, aby byly vyexportované soubory uloženy do adresáře souborů public://. Klepnutím <a href=\"@link\" target=\"_blank\">sem</a> zobrazíte pokyny pro konfiguraci soukromých souborů v souboru settings.php.</strong>"

msgid "Check this if you want to download the file immediately after it is created. Does <strong>NOT</strong> work for JSON data exports."
msgstr "Zaškrtněte toto, chcete-li stáhnout soubor okamžitě po jeho vytvoření. <strong>NEFUNGUJE</strong> pro exporty dat JSON."

msgid "Check this if you want to configure a custom redirect path."
msgstr "Zaškrtněte, chcete-li konfigurovat vlastní cestu k přesměrování."

msgid "Select the display to redirect to after batch finishes. If None is selected the user will be redirected to the front page."
msgstr "Vyberte zobrazení, které se má přesměrovat po dokončení dávky. Je-li vybrána volba Není, bude uživatel přesměrován na titulní stranu."

msgid "Enter custom path to redirect user after batch finishes."
msgstr "Zadejte vlastní cestu k přesměrování uživatele po dokončení dávky."

msgid "Check this if you want to include query string parameters on redirect."
msgstr "Zaškrtněte, chcete-li zahrnout parametry řetězce dotazu do přesměrování."

msgid "Displays"
msgstr "Zobrazení"

msgid "The data export icon will be available only to the selected displays."
msgstr "Ikona exportu dat bude k dispozici pouze pro vybrané displeje. "

msgid "Choose the facet source used to alter data export. This should be the display that this data export is attached to."
msgstr "Vyberte zdroj fazet používaný ke změně exportu dat. Mělo by se jednat o zobrazení, ke kterému je tento export dat připojen."

msgid "Could not write to temporary output file for result export (@file). Check permissions."
msgstr "Nelze zapisovat do dočasného výstupního souboru pro export výsledků (@file). Zkontrolujte oprávnění."

msgid "Export complete. Download the file <a download href=\":download_url\"  data-download-enabled=\"false\" id=\"vde-automatic-download\">here</a>."
msgstr "Export byl dokončen. Stáhněte soubor <a download href=\":download_url\"  data-download-enabled=\"false\" id=\"vde-automatic-download\">sem</a>."

msgid "Export complete. Download the file <a download href=\":download_url\" data-download-enabled=\"true\" id=\"vde-automatic-download\">here</a> if file is not automatically downloaded."
msgstr "Export byl dokončen. Stáhněte soubor <a download href=\":download_url\" data-download-enabled=\"true\" id=\"vde-automatic-download\">sem</a>, pokud není soubor automaticky stažen."

msgid "Export failed. Make sure the private file system is configured and check the error log."
msgstr "Export se nezdařil. Ujistěte se, že je soukromý systém souborů nakonfigurován a zkontrolujte protokol chyb."

msgid "Data export"
msgstr "Export dat"

msgid "Export the view results to a file. Can handle very large result sets."
msgstr "Exportovat výsledky pohledu do souboru. Lze zpracovávat velmi objemné sady výsledků. "

msgid "Indicates the character used to delimit fields. Defaults to a comma (<code>,</code>). For tab-separation use <code>\\t</code> characters."
msgstr "Určuje znak používaný k oddělování polí. Výchozí hodnotou je čárka (<code>,</code>). Pro oddělování tabulátorem použijte řetězec <code>\\t</code>. "

msgid "Indicates the character used for field enclosure. Defaults to a double quote (<code>\"</code>)."
msgstr "Určuje znak používaný k ohrazení pole. Výchozí hodnotou je dvojitá uvozovka (<code>\"</code>). "

msgid "Indicates the character used for escaping. Defaults to a backslash (<code>\\</code>)."
msgstr "Určuje znak používaný ke změně interpretace. Výchozí hodnotou je zpětné lomítko (<code>\\</code>). "

msgid "Strips HTML tags from CSV cell values."
msgstr "Odstraňuje znaky HTML z hodnot buněk CSV. "

msgid "Trims whitespace from beginning and end of CSV cell values."
msgstr "Odstraňuje mezery ze začátku a konce hodnot buněk CSV. "

msgid "Determines the encoding used for CSV cell values."
msgstr "Určuje kódování použité v hodnotách buněk CSV. "

msgid "UTF-8"
msgstr "UTF-8"

msgid "Include unicode signature (<a href=\"@bom\" target=\"_blank\">BOM</a>)."
msgstr "Zahrnout podpis unicode (<a href=\"@bom\" target=\"_blank\">BOM</a>)."

msgid "Only use Symfony serializer->encode method"
msgstr "Použití pouze serializační modul Symfony -> zakódovat metodu"

msgid "Skips the symfony data normalize method when rendering data export to increase performance on large datasets. <strong>(Only use when not exporting nested data)</strong>"
msgstr "Přeskočí metodu normalizace dat Symfony při vykreslování exportu dat za účelem zvýšení výkonu u velkých datových sad. <strong>(Použít pouze při neexportování vnořených dat)</strong>"

msgid "Configurable row output for data exports."
msgstr "Konfigurovatelný výstup řádku pro exportovaná data. "

msgid "Download @format"
msgstr "Stáhnout @format"

