msgstr "Поле, содержащее изображение, которое требуется обрезать"

msgid "Crop effect configuration"
msgstr "Конфигурация эффекта обрезки"

msgid "Crop API settings"
msgstr "Параметры API обрезки"

msgid "Indicates whether to flush image derivatives when a crop entity is change"
msgstr "Указывает, следует ли очищать производные изображения при изменении сущности обрезки"

msgid "Media entity crop"
msgstr "Обрезка медиасущности"

msgid "Deprecated."
msgstr "Устарела."

msgid "Aspect Ratio"
msgstr "Отношение ширины к высоте"

msgid "Used in"
msgstr "Используется в"

msgid "@first, @second and @count more"
msgstr "@first, @second и еще @count"

msgid "No crop types available. <a href=\"@link\">Add crop type</a>."
msgstr "Нет доступных типов обрезки. <a href=\"@link\">Добавить тип обрезки</a>."

msgid "Entity provider @id not found."
msgstr "Провайдер объектов @id не найден. "

msgid "Crop ID"
msgstr "ИД обрезки"

msgid "The crop ID."
msgstr "ИД обрезки. "

msgid "UUID"
msgstr "UUID"

msgid "The crop UUID."
msgstr "UUID обрезки."

msgid "Revision ID"
msgstr "ID редакции"

msgid "The crop revision ID."
msgstr "ИД ревизии обрезки. "

msgid "Type"
msgstr "Тип"

msgid "The crop type."
msgstr "Тип обрезки. "

msgid "Language code"
msgstr "Код языка"

msgid "The node language code."
msgstr "Код языка материала."

msgid "Entity ID"
msgstr "Идентификатор сущности"

msgid "ID of entity crop belongs to."
msgstr "ИД сущности, которой принадлежит обрезка. "

msgid "Entity type"
msgstr "Тип сущности"

msgid "The type of entity crop belongs to."
msgstr "Тип сущности, которой принадлежит обрезка."

msgid "URI"
msgstr "URI"

msgid "The URI of the image crop belongs to."
msgstr "URI изображения, которому принадлежит обрезка. "

msgid "Height"
msgstr "Высота"

msgid "The crop height."
msgstr "Высота обрезки. "

msgid "Width"
msgstr "Ширина"

msgid "The crop width."
msgstr "Ширина обрезки. "

msgid "X coordinate"
msgstr "Координата X"

msgid "The crop's X coordinate."
msgstr "Координата X обрезки."

msgid "Y coordinate"
msgstr "Координата Y"

msgid "The crop's Y coordinate."
msgstr "Координата Y обрезки."

msgid "Revision timestamp"
msgstr "Метка времени редакции"

msgid "The time that the current revision was created."
msgstr "Время создания текущей редакции"

msgid "Revision author ID"
msgstr "ИД автора ревизии"

msgid "The user ID of the author of the current revision."
msgstr "Идентификатор пользователя, который является автором текущей редакции."

msgid "Revision Log"
msgstr "Журнал ревизии"

msgid "The log entry explaining the changes in this revision."
msgstr "Запись в журнале, объясняющая изменения в этой редакции."

msgid "Crop"
msgstr "Обрезка"

msgid "Are you sure you want to delete the crop type %type?"
msgstr "Вы действительно хотите удалить тип обрезки %type?"

msgid "The crop type %name has been deleted."
msgstr "Тип обрезки %name был удален. "

msgid "Deleted crop type %name."
msgstr "Удален тип обрезки %name."

msgid "%type is used by 1 piece of content on your site. You can not remove this content type until you have removed all of the %type content."
msgid_plural "%type is used by @count pieces of content on your site. You may not remove %type until you have removed all of the %type content."
msgstr[0] "%type используется в 1 материале на сайте. Невозможно удалить данный тип материала пока не удалены все материалы типа %type."
msgstr[1] "%type используется в @count материалах на сайте. Невозможно удалить данный тип материала пока не удалены все материалы типа %type."
msgstr[2] "%type используется в @count[2] материалах на сайте. Невозможно удалить данный тип материала пока не удалены все материалы типа %type."

msgid "Edit %label crop type"
msgstr "Изменить тип обрезки %label"

msgid "The human-readable name of this crop type. This name must be unique."
msgstr "Удобочитаемое имя типа обрезки. Имя должно быть уникальным."

msgid "A unique machine-readable name for this crop type. It must only contain lowercase letters, numbers, and underscores."
msgstr "Уникальное машинно-читаемое имя типа обрезки. Допустимы только строчные буквы, цифры и знаки подчеркивания."

msgid "Describe this crop type."
msgstr "Укажите описание типа обрезки. "

msgid "Set an aspect ratio <b>eg: 16:9</b> or leave this empty for arbitrary aspect ratio"
msgstr "Укажите отношение сторон (<b>например, 16:9</b>) или оставьте пустое значение для произвольного отношения сторон "

msgid "Soft limit"
msgstr "Мягкий предел"

msgid "Define crop size soft limit. Warning will be displayed if crop smaller than that is selected."
msgstr "Укажите гибкое ограничение размера обрезки. При выборе обрезки меньшего размера выдается предупреждение. "

msgid "Limit for width."
msgstr "Ограничение ширины."

msgid "Limit for height."
msgstr "Ограничение высоты."

msgid "Hard limit"
msgstr "Жесткий лимит"

msgid "Define crop size hard limit. User is not allowed to make a smaller selection than defined here."
msgstr "Укажите жесткое ограничение размера обрезки. Пользователю запрещено выбирать размеры меньше указанных. "

msgid "Limit for width"
msgstr "Ограничение ширины"

msgid "Save crop type"
msgstr "Сохранить тип обрезки"

msgid "Delete crop type"
msgstr "Удалить тип обрезки"

msgid "The crop type %name has been updated."
msgstr "Тип обрезки %name обновлен. "

msgid "The crop type %name has been added."
msgstr "Добавлен тип обрезки %name. "

msgid "View"
msgstr "Просмотр"

msgid "Added crop type %name."
msgstr "Добавлен тип обрезки %name."

msgid "File"
msgstr "Файл"

msgid "Provides crop integration for core files."
msgstr "Интеграция обрезки для базовых файлов. "

msgid "Provides crop integration for media."
msgstr "Интеграция обрезки для медиаобъектов. "

msgid "Crop type to be used for the image style."
msgstr "Тип обрезки для стиля изображения. "

msgid "Manual image crop failed due to misconfigured crop type on %path."
msgstr "Ошибка обрезки изображения вручную, поскольку указан неверный тип обрезки в %path."

msgid "Manual image crop failed using the %toolkit toolkit on %path (%mimetype, %width x %height)"
msgstr "Ошибка обрезки изображения вручную с помощью набора инструментов %toolkit в %path (%mimetype, %width x %height)"

msgid "Manual crop"
msgstr "Ручная обрезка"

msgid "Applies manually provided crop to the image."
msgstr "Позволяет обрезать изображение вручную. "

