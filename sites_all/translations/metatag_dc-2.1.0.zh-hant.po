msgid "Metatag: Dublin Core"
msgstr "meta 標籤：Dublin Core"

msgid "Provides the fifteen <a href=\"https://dublincore.org/documents/dces/\">Dublin Core Metadata Element Set 1.1</a> meta tags from the <a href=\"https://dublincore.org/\">Dublin Core Metadata Institute</a>."
msgstr "提供來自 <a href=\"https://dublincore.org/\">Dublin Core Metadata Institute</a> 的 15 個 <a href=\"https://dublincore.org/documents/dces/\">Dublin Core Metadata Element Set 1.1</a> meta 標籤。"

msgid "SEO"
msgstr "SEO"

