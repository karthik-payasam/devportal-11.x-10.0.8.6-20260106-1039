msgid "Metatag: Google Plus"
msgstr "Metaetiqueta: Google Plus"

msgid "Provides support for Google's Plus meta tags. Deprecated, will be removed in Metatag 2.0.0."
msgstr "Proporciona soporte de las metaetiquetas de Google Plus. En desuso, se eliminará en Metatag 2.0.0."

msgid "SEO"
msgstr "SEO (optimizador del motor de búsqueda)"

msgid "Google Plus: name"
msgstr "Google Plus: name (nombre)"

msgid "Google Plus: image"
msgstr "Google Plus: image (imagen)"

msgid "Google Plus: description"
msgstr "Google Plus: description (descripción)"

msgid "Publisher URL"
msgstr "URL del publicador"

msgid "Author"
msgstr "Autor"

msgid "Google Plus"
msgstr "Google Plus"

msgid "DEPRECATED, use Advanced-Author instead."
msgstr "EN DESUSO, utilice Advanced-Author en su lugar."

msgid "Description"
msgstr "Descripción"

msgid "Content description less than 200 characters."
msgstr "La descripción del contenido tiene menos de 200 caracteres."

msgid "Image"
msgstr "Imagen"

msgid "The URL of an image which should represent the content. For best results use an image that is at least 1200 x 630 pixels in size, but at least 600 x 316 pixels is a recommended minimum. Supports PNG, JPEG and GIF formats."
msgstr "URL de una imagen que represente el contenido. Los mejores resultados se obtienen con una imagen de un tamaño de al menos 1200 x 630 píxeles, aunque el mínimo recomendado es de 600 x 316 píxeles. Soporta los formatos PNG, JPEG y GIF."

msgid "Name"
msgstr "Nombre"

msgid "Content title."
msgstr "Título del contenido."

msgid "Used by some search engines to confirm publication of the content on a page. Should be the full URL for the publication's Google+ profile page."
msgstr "Utilizado por algunos motores de búsqueda para confirmar la publicación del contenido en una página. Debería ser el URL completo de la página de perfil Google+ de la publicación."

