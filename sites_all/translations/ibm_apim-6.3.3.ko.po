msgid "Only users with the required permissions can access the subscription wizard"
msgstr "필수 권한이 있는 사용자만 등록 마법사에 액세스할 수 있습니다."

msgid "Select Plan"
msgstr "플랜 선택"

msgid "Select Application"
msgstr "애플리케이션 선택"

msgid "Subscribe"
msgstr "등록"

msgid "Summary"
msgstr "요약"

msgid "Back"
msgstr "이전"

msgid "Cancel"
msgstr "취소"

msgid "The specified arguments were not correct."
msgstr "지정된 인수가 올바르지 않습니다."

msgid "Create Application"
msgstr "애플리케이션 작성"

msgid "Select an existing application or create a new application"
msgstr "기존 애플리케이션을 선택하거나 새 애플리케이션을 작성"

msgid "Select an existing application"
msgstr "기존 애플리케이션을 선택"

msgid "There are no applications that can be subscribed to this Plan."
msgstr "이 플랜에 등록될 수 있는 애플리케이션이 없습니다."

msgid "You must select an application to create a subscription."
msgstr "등록을 작성하려면 애플리케이션을 선택해야 합니다."

msgid "Invalid application: Provide a valid application to create a subscription."
msgstr "올바르지 않은 애플리케이션: 올바른 애플리케이션을 제공하여 등록을 작성하십시오."

msgid "There is %number suspended application not displayed in this list."
msgid_plural "There are %number suspended applications not displayed in this list."
msgstr[0] "이 목록에 표시되지 않는 %number개의 일시중단된 애플리케이션이 있습니다."

msgid "There is %number application that is already subscribed to the %product product. It is not displayed in this list."
msgid_plural "There are %number applications that are already subscribed to the %product product. They are not displayed in this list."
msgstr[0] "%product 제품에 이미 등록된 %number개의 애플리케이션이 있습니다. 이는 이 목록에 표시되지 않습니다."

msgid "Subscription wizard was invoked with no productId. Start the wizard again from the %apiproducts page."
msgstr "등록 마법사가 productId 없이 호출되었습니다. %apiproducts 페이지에서 다시 마법사를 시작하십시오."

msgid "You must select a plan that you want to subscribe to."
msgstr "등록하려는 플랜을 선택해야 합니다."

msgid "Your subscription request has been created and is now pending approval. You will receive an email once your subscription request is approved."
msgstr "등록 요청이 작성되었으며 이제 승인을 보류 중입니다. 등록 요청이 승인되면 이메일을 수신합니다."

msgid "Your application is now subscribed to the selected plan."
msgstr "이제 애플리케이션이 선택된 플랜에 등록됩니다."

msgid "There was a problem with your subscription request. Review any error messages, correct the problem and try again."
msgstr "등록 요청에 문제점이 있습니다. 오류 메시지를 검토하고 문제점을 정정한 후 다시 시도하십시오."

msgid "Subscription Error"
msgstr "등록 오류"

msgid "There was a problem with your subscription request. Review any error messages and try again."
msgstr "등록 요청에 문제점이 있습니다. 오류 메시지를 검토하고 다시 시도하십시오."

