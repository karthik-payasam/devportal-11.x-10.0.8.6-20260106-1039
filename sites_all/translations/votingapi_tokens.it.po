msgstr "Informazioni"

msgid "This module enables tokens for all entity types that has <kbd>voting_api_field</kbd>."
msgstr "Questo modulo abilita i token a tutti i tipi di entità che hanno <kbd>voting_api_field</kbd>."

msgid "Usage"
msgstr "Utilizzo"

msgid "Tokens are dynamic and you have to pass <emph>vote_type</emph> as the last parameter. Module defines four tokens:"
msgstr "I token sono dinamici e bisogna passare <emph>vote_type</emph> come ultimo parametro. Il modulo definisce quattro token:"

msgid "<ul><li>Vote count :: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"
msgstr "<ul><li>Conteggio voto :: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"

msgid "<li>Vote average :: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"
msgstr "<li>Media di voto :: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"

msgid "<li>Best vote :: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"
msgstr "<li>Voto migliore :: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"

msgid "<li>Worst vote :: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"
msgstr "<li>Voto peggiore :: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"

msgid "Voting API Tokens"
msgstr "Token API di voto"

msgid "Token support for Voting API"
msgstr "Supporto token per l'API di voto"

msgid "Voting"
msgstr "Votazione"

