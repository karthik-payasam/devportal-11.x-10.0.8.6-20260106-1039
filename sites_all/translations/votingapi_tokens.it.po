msgid "VotingAPI tokens"
msgstr "Token di votazione"

msgid "Dynamic Tokens for VotingAPI."
msgstr "Token dinamici per VotingAPI."

msgid "Vote count"
msgstr "Conteggio dei voti"

msgid "Number of votes."
msgstr "Numero di voti."

msgid "Average Result"
msgstr "Risultato medio"

