msgstr "Il testo da mostrare quando non c'è una ricerca corrente"

msgid "Reset facets link"
msgstr "Link Ripristina facet"

msgid "The text to show for the reset link."
msgstr "Il testo da mostrare per il link di ripristino."

msgid "Position of the reset link."
msgstr "Posizione del link di reimpostazione."

msgid "Processor @id specifies a non-existing @class."
msgstr "Il processore @id specifica una @class non esistente."

