msgstr "Riepilogo facet"

msgid "Edit %label facets summary"
msgstr "Modifica riepilogo facet %label"

msgid "Enabled facets"
msgstr "Facet abilitati"

msgid "Separator"
msgstr "Separatore"

msgid "Show counts"
msgstr "Mostra conteggi"

msgid "Weight"
msgstr "Peso"

msgid "Select the facets to be shown in the summary block. You can reorder them."
msgstr "Selezionare i facet da visualizzare nel blocco di riepilogo. È possibile riordinarli."

msgid "Weight for @title"
msgstr "Peso per @title"

msgid "No facets found."
msgstr "Nessun facet trovato."

