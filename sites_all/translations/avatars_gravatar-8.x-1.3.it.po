msgid "Gravatar"
msgstr "Gravatar"

msgid "Adds Gravatar.com avatar generators for Avatar Kit."
msgstr "Aggiunge i generatori avatar Gravatar.com per Avatar Kit."

msgid "Avatars"
msgstr "Avatar"

msgid "Maximum content rating"
msgstr "Valutazione massima del contenuto"

msgid "Gravatar generator"
msgstr "Generatore Gravatar"

msgid "Type"
msgstr "Tipo"

msgid "Unrestricted"
msgstr "Senza restrizioni"

msgid "G: suitable for display on all websites with any audience type."
msgstr "G: adatto alla visualizzazione da parte di tutti gli utenti di qualsiasi sito web."

msgid "PG: may contain rude gestures, provocatively dressed individuals, the lesser swear words, or mild violence."
msgstr "PG: può contenere gesti violenti, persone vestite in modo provocante, linguaggio scurrile o moderata violenza."

msgid "R: may contain such things as harsh profanity, intense violence, nudity, or hard drug use."
msgstr "R: potrebbe contenere gravi bestemmie, violenza intensa, nudo o uso elevato di droghe."

msgid "X: may contain hardcore sexual imagery or extremely disturbing violence."
msgstr "X: potrebbe contenere pornografia o violenza estremamente inquietante."

msgid "Maximum rating: @maximum_rating"
msgstr "Valutazione massima: @maximum_rating"

msgid "Universal avatar uploaded to Gravatar.com"
msgstr "Avatar Universal caricato su Gravatar.com"

msgid "Identicon"
msgstr "Identicon"

msgid "Monster ID"
msgstr "Monster ID"

msgid "Wavatar"
msgstr "Wavatar"

msgid "8-bit style avatar"
msgstr "Avatar con stile a 8-bit"

msgid "Missing Configuration"
msgstr "Configurazione mancante"

msgid "Type: @type"
msgstr "Tipo: @type"

msgid "Identicon, MonsterID, Retro, and Wavatar avatar generators."
msgstr "Generatori di avatar Identicon, MonsterID, Retro e Wavatar"

