msgid "None"
msgstr "Nenhum"

msgid "Vertical"
msgstr "Vertical"

msgid "Horizontal"
msgstr "Horizontal"

msgid "Diagonal"
msgstr "Diagonal"

msgid "About Superfish"
msgstr "Sobre o Superfish"

msgid "<a href=\"@url_module\">Superfish module</a> integrates <a href=\"@url_library\">jQuery Superfish</a> plugin to your Drupal menu blocks. Please refer to the module <a href=\"@url_documentation\">documentation</a> for more information."
msgstr "O <a href=\"@url_module\">Módulo Superfish</a> integra o plug-in <a href=\"@url_library\">Superfish jQuery</a> nos seus blocos de menu do Drupal. Consulte o módulo <a href=\"@url_documentation\">documentação</a> para obter mais informações."

msgid "In order to use Superfish, go to the <a href=\"@block\">Block layout</a> page and use any of the \"Place block\" buttons to create a Superfish block."
msgstr "Para usar Superfish, acesse a página <a href=\"@block\">Layout de bloco</a> e use qualquer um dos botões \"Colocar bloco\" para criar um bloco Superfish."

msgid "Superfish library is missing. Please refer to the <a href=\"@documentation\">plugin documentation</a> for how you can fix this issue; Once done, go to the <a href=\"@block\">Block layout</a> page and use any of the \"Place block\" buttons to create a Superfish block."
msgstr "A biblioteca do Superfish está ausente. Consulte a <a href=\"@documentation\">documentação do plug-in</a> para saber como é possível corrigir esse problema; depois de concluir, acesse a página <a href=\"@block\">Layout de bloco</a> e use qualquer um dos botões \"Colocar bloco\" para criar um bloco Superfish."

msgid "If there was no Superfish block in the \"Place block\" form, go to the <a href=\"@performance\">Performance</a> page and clear the cache once."
msgstr "Se não houver nenhum bloco Superfish no formulário \"Colocar bloco\", vá para a página <a href=\"@performance\">Desempenho</a> e limpe o cache uma vez."

msgid "Superfish library"
msgstr "Biblioteca do Superfish"

msgid "Inaccessible"
msgstr "Inacessível"

msgid "Cannot access the Superfish library directory; perhaps because its permissions and/or ownership are not set up correctly."
msgstr "Não é possível acessar o diretório da biblioteca Superfish; talvez porque suas permissões e/ou propriedade não estejam configuradas corretamente."

msgid "Unknown version"
msgstr "Versão desconhecida"

msgid "Cannot determine the version of your Superfish library."
msgstr "Não é possível determinar a versão de sua biblioteca Superfish."

msgid "Not supported"
msgstr "Não suportado"

msgid "The Superfish library requires an update. You can find the update instructions on :url."
msgstr "A biblioteca Superfish requer uma atualização. É possível localizar as instruções de atualização na :url."

msgid "Installed; at @location"
msgstr "Instalado; em @location"

msgid "Not installed"
msgstr "Não instalado"

msgid "Please download the Superfish library from :url."
msgstr "Faça o download da biblioteca Superfish a partir da :url."

msgid "Superfish"
msgstr "Superfish"

msgid "Adds jQuery Superfish plugin to menu blocks."
msgstr "Inclui o plug-in jQuery Superfish nos blocos de menus."

msgid "User interface"
msgstr "Interface com o usuário"

msgid "Block settings"
msgstr "Configurações de bloco"

msgid "Default"
msgstr "Padrão"

msgid "Horizontal (single row)"
msgstr "Horizontal (linha única)"

msgid "Menu type"
msgstr "Tipo de menu"

msgid "Horizontal (double row)"
msgstr "Horizontal (linha dupla)"

msgid "Vertical (stack)"
msgstr "Vertical (pilha)"

msgid "Style"
msgstr "Estilo"

msgid "Black"
msgstr "Preto"

msgid "Blue"
msgstr "Azul"

msgid "Coffee"
msgstr "Coffee"

msgid "White"
msgstr "Branco"

msgid "Add arrows to parent menus"
msgstr "Incluir setas para menus principais"

msgid "Drop shadows"
msgstr "Aplicações de sombra"

msgid "jQuery Easing plugin is not installed."
msgstr "O plug-in jQuery Easing não está instalado."

msgid "The plugin provides a handful number of animation effects, they can be used by uploading the 'jquery.easing.js' file to the libraries directory within the 'easing' directory (for example: libraries/easing/jquery.easing.js). Refresh this page after the plugin is uploaded, this will make more effects available in the above list."
msgstr "O plug-in fornece um número limitado de efeitos de animação, que podem ser usados para fazer upload do arquivo 'jquery.easing.js' para o diretório de bibliotecas dentro do diretório 'easing' (por exemplo: libraries/easing/jquery.easing.js). Atualize a página após o plug-in ser transferido por upload, o que disponibilizará mais efeitos na lista acima."

msgid "Slide-in effect"
msgstr "Efeito deslizante"

msgid "Superfish plugins"
msgstr "Plug-ins do Superfish"

msgid "Relocates sub-menus when they would otherwise appear outside the browser window area."
msgstr "Realoca submenus quando eles aparecem fora da área de janela do navegador."

msgid "enabled"
msgstr "ativado"

msgid "jQuery Supposition"
msgstr "Suposição do jQuery"

msgid "Prevents accidental firing of animations by waiting until the user's mouse slows down enough, hence determinig user's <em>intent</em>."
msgstr "Evita disparo acidental de animações em espera até que o movimento do mouse diminua o suficiente, determinando, assim, a <em>intenção</em> do usuário."

msgid "jQuery hoverIntent"
msgstr "jQuery hoverIntent"

msgid "<strong>sf-Touchscreen</strong> provides touchscreen compatibility."
msgstr "<strong>sf-Touchscreen</strong> fornece compatibilidade de touch screen."

msgid "The first click on a parent hyperlink shows its children and the second click opens the hyperlink."
msgstr "O primeiro clique em um hyperlink pai mostra seus filhos e o segundo clique abre o hyperlink."

msgid "sf-Touchscreen"
msgstr "sf-Touchscreen"

msgid "Disable"
msgstr "Desativar"

msgid "Enable jQuery sf-Touchscreen plugin for this menu."
msgstr "Ativar o plug-in sf-Touchscreen do jQuery para este menu."

msgid "Enable jQuery sf-Touchscreen plugin for this menu depending on the user's Web browser <strong>window width</strong>."
msgstr "Ativar o plug-in sf-Touchscreen do jQuery para este menu, dependendo da <strong>largura da janela</strong> do navegador da web do usuário."

msgid "Enable jQuery sf-Touchscreen plugin for this menu depending on the user's Web browser <strong>user agent</strong>."
msgstr "Ativar o plug-in sf-Touchscreen do jQuery para este menu, dependendo do <strong>agente do usuário</strong> do navegador da web do usuário."

msgid "Hiding the sub-menu on the second tap, adding cloned parent links to the top of sub-menus as well."
msgstr "Ocultando o submenu no segundo toque, incluindo links pais clonados também sobre os sub-menus."

msgid "Using this plugin, the first click or tap will expand the sub-menu, here you can choose what a second click or tap should do."
msgstr "Usando este plug-in, o primeiro clique ou toque expandirá o submenu, em que será possível escolher a ação de um segundo clique ou toque."

msgid "Opening the parent menu item link on the second tap."
msgstr "Abrindo o link de item de menu pai no segundo toque."

msgid "Hiding the sub-menu on the second tap."
msgstr "Ocultando o submenu no segundo toque."

msgid "sf-Touchscreen will be enabled only if the width of user's Web browser window is smaller than the below value."
msgstr "O sf-Touchscreen será ativado apenas se a largura da janela do navegador da web do usuário for menor que o valor abaixo."

msgid "Please note that in most cases such a meta tag is necessary for this feature to work properly:"
msgstr "Observe que, na maioria dos casos, tal metatag é necessária para que este recurso funcione corretamente:"

msgid "Window width settings"
msgstr "Configurações de largura da janela"

msgid "Also known as \"Breakpoint\"."
msgstr "Conhecido como \"Ponto de Interrupção\"."

msgid "pixels"
msgstr "pixels"

msgid "User agent settings"
msgstr "Configurações do agente do usuário"

msgid "Use the pre-defined list of the <strong>user agents</strong>."
msgstr "Use a lista predefinida de <strong>agentes do usuário</strong>."

msgid "Recommended"
msgstr "Recomendado"

msgid "Use the custom list of the <strong>user agents</strong>."
msgstr "Use a lista customizada de <strong>agentes do usuário</strong>."

msgid "UA string of the current Web browser:"
msgstr "Sequência de UA do navegador da web atual:"

msgid "Could be partial or complete. (Asterisk separated)"
msgstr "Pode ser parcial ou completo. (Separado por asterisco)"

msgid "empty"
msgstr "vazio"

msgid "Examples"
msgstr "Exemplos"

msgid "Custom list of the user agents"
msgstr "Lista customizada de agentes do usuário"

msgid "Client-side (JavaScript)"
msgstr "Lado do cliente (JavaScript)"

msgid "<strong>User agent</strong> detection method"
msgstr "Método de detecção do <strong>agente do usuário</strong>"

msgid "Server-side (PHP)"
msgstr "Lado do servidor (PHP)"

msgid "sf-Smallscreen"
msgstr "sf-Smallscreen"

msgid "<strong>sf-Smallscreen</strong> provides small-screen compatibility for your menus."
msgstr "<strong>sf-Smallscreen</strong> fornece compatibilidade com tela pequena para seu menus."

msgid "Enable jQuery sf-Smallscreen plugin for this menu depending on the user's Web browser <strong>window width</strong>."
msgstr "Ativar o plug-in sf-Smallscreen do jQuery para este menu, dependendo da <strong>largura da janela</strong> do navegador da web do usuário."

msgid "Enable jQuery sf-Smallscreen plugin for this menu."
msgstr "Ativar o plug-in sf-Smallscreen do jQuery para este menu."

msgid "Enable jQuery sf-Smallscreen plugin for this menu depending on the user's Web browser <strong>user agent</strong>."
msgstr "Ativar o plug-in sf-Smallscreen do jQuery para este menu, dependendo do <strong>agente do usuário</strong> do navegador da web do usuário."

msgid "sf-Smallscreen will be enabled only if the width of user's Web browser window is smaller than the below value."
msgstr "O sf-Smallscreen será ativado apenas se a largura da janela do navegador da web do usuário for menor que o valor abaixo."

msgid "Convert the menu to an accordion menu."
msgstr "Converter o menu em um menu sanfona."

msgid "Select a type"
msgstr "Selecionar um tipo"

msgid "Convert the menu to a &lt;select&gt; element."
msgstr "Converta o menu em um elemento &lt;select&gt;."

msgid "&lt;select&gt; settings"
msgstr "Configurações de &lt;select&gt;"

msgid "By default the first item in the &lt;select&gt; element will be the name of the parent menu or the title of this block, you can change this by setting a custom title."
msgstr "Por padrão, o primeiro item no elemento &lt;select&gt; será o nome do menu pai ou o título desse bloco; é possível mudar isso configurando um título customizado."

msgid "Example"
msgstr "Exemplo:"

msgid "Main Menu"
msgstr "Menu principal"

msgid "&lt;select&gt; title"
msgstr "Título de &lt;select&gt;"

msgid "Add <em>selected</em> attribute to the &lt;option&gt; element with the class <strong>active</strong> ."
msgstr "Incluir o atributo <em>selecionado</em> no elemento <opção> com a classe <strong>ativa</strong> ."

msgid "Makes pre-selected the item linked to the active page when the page loads."
msgstr "Vincula o item pré-selecionado à página ativa quando a página é carregada."

msgid "More"
msgstr "Mais"

msgid "Copy the main &lt;ul&gt; classes to the &lt;select&gt;."
msgstr "Copie as classes principais &lt;ul&gt; para o &lt;select&gt;."

msgid "disabled"
msgstr "desativado"

msgid "Comma separated"
msgstr "Separado por vírgula"

msgid "Exclude these classes from the &lt;select&gt; element"
msgstr "Excluir essas classes do elemento &lt;select&gt;"

msgid "Copy the hyperlink classes to the &lt;option&gt; elements of the &lt;select&gt;."
msgstr "Copie as classes de hyperlink para os elementos &lt;option&gt; do &lt;select&gt;."

msgid "Exclude these classes from the &lt;option&gt; elements of the &lt;select&gt;"
msgstr "Excluir essas classes dos elementos &lt;option&gt; do &lt;select&gt;"

msgid "Include these classes in the &lt;select&gt; element"
msgstr "Incluir essas classes no elemento &lt;select&gt;"

msgid "Include these classes in the &lt;option&gt; elements of the &lt;select&gt;"
msgstr "Incluir essas classes nos elementos &lt;option&gt; do &lt;select&gt;"

msgid "Accordion settings"
msgstr "Configurações de sanfona"

msgid "By default the caption of the accordion toggle switch will be the name of the parent menu or the title of this block, you can change this by setting a custom title."
msgstr "Por padrão, a legenda do interruptor de duas posições de sanfona será o nome do menu pai ou o título deste bloco. Essa configuração pode ser mudada selecionando um título customizado."

msgid "Menu"
msgstr "a de Menus"

msgid "Accordion menu title"
msgstr "Título do menu sanfona"

msgid "Use parent menu items as buttons, add cloned parent links to sub-menus as well."
msgstr "Usar itens de menu pai, como botões, e incluir também links pais clonados nos sub-menus."

msgid "Accordion button type"
msgstr "Tipo de botão sanfona"

msgid "Use parent menu items as buttons."
msgstr "Usar itens de menu pai como botões."

msgid "Create new links next to parent menu item links and use them as buttons."
msgstr "Criar novos links ao lado de links de item de menu pai e usá-los como botões."

msgid "Supersubs"
msgstr "Supersubs"

msgid "<strong>Supersubs</strong> makes it possible to define custom widths for your menus."
msgstr "O <strong>Supersubs</strong> permite definir larguras customizadas para seus menus."

msgid "Enable Supersubs for this menu."
msgstr "Ativar o Supersubs para este menu."

msgid "Minimum width for sub-menus, in <strong>em</strong> units."
msgstr "Largura mínima para os submenus, em unidades <strong>em</strong>."

msgid "Minimum width"
msgstr "Largura mínima"

msgid "Maximum width for sub-menus, in <strong>em</strong> units."
msgstr "Largura máxima para os submenus, em unidades <strong>em</strong>."

msgid "Maximum width"
msgstr "Largura máxima"

msgid "Please refer to the Superfish module documentation for how you should setup multi-column sub-menus."
msgstr "Consulte a documentação do módulo Superfish para o modo necessário para configurar submenus de múltiplas colunas."

msgid "Multi-column sub-menus"
msgstr "Submenus de múltiplas colunas"

msgid "Enable multi-column sub-menus."
msgstr "Ativar sub-menus de múltiplas colunas."

msgid "The depth of the first instance of multi-column sub-menus."
msgstr "A profundidade da primeira instância de sub-menus de múltiplas colunas."

msgid "Start from depth"
msgstr "Iniciar a partir da profundidade"

msgid "The amount of sub-menu levels that will be included in the multi-column sub-menu."
msgstr "A quantia de níveis submenu que será incluída no submenu de múltiplas colunas."

msgid "Levels"
msgstr "Níveis"

msgid "Advanced settings"
msgstr "Configurações avançadas"

msgid "The speed of the animation either in <strong>milliseconds</strong> or pre-defined values (<strong>slow, normal, fast</strong>)."
msgstr "A velocidade da animação em <strong>milissegundos</strong> ou valores predefinidos (<strong>lenta, normal, rápida</strong>)."

msgid "Animation speed"
msgstr "Velocidade da animação"

msgid "The delay in <strong>milliseconds</strong> that the mouse can remain outside a sub-menu without it closing."
msgstr "O atraso em <strong>milissegundos</strong> em que o mouse pode permanecer fora de um submenu sem que ele seja fechado."

msgid "Mouse delay"
msgstr "Atraso do mouse"

msgid "The amount of sub-menu levels that remain open or are restored using the \".active-trail\" class."
msgstr "A quantidade de níveis de submenu que permanecem abertos ou são restaurados usando a classe \".active-trail\"."

msgid "Change this setting <strong>only and only</strong> if you are <strong>totally sure</strong> of what you are doing."
msgstr "Mude essa configuração <strong>somente</strong> se você estiver <strong>absolutamente certo</strong> do que está fazendo."

msgid "Path levels"
msgstr "Níveis de caminho"

msgid "Hyperlinks"
msgstr "Hyperlinks"

msgid "By enabling this option, only parent menu items with <em>Expanded</em> option enabled will have their submenus appear."
msgstr "Ao ativar esta opção, apenas os itens de menu pai com a opção <em>Expandido</em> ativada terão seus submenus exibidos."

msgid "Take \"Expanded\" option into effect."
msgstr "Colocar a opção \"Expandido\" em vigor."

msgid "Add cloned parent links to the top of sub-menus."
msgstr "Incluir links pais clonados sobre os submenus."

msgid "Disable hyperlink descriptions (\"title\" attribute)"
msgstr "Desativar descrições de hyperlink (atributo \"title\")"

msgid "Insert hyperlink descriptions (\"title\" attribute) into hyperlink texts."
msgstr "Insira as descrições de hyperlink (atributo \"title\") em textos de hyperlink."

msgid "Add item depth classes to menu items and their hyperlinks."
msgstr "Incluir classes de profundidade de item nos itens de menu e em seus hyperlinks."

msgid "Custom classes"
msgstr "Classes customizadas"

msgid "(Space separated, without dots)"
msgstr "(Separado por espaço, sem pontos)"

msgid "For the main UL"
msgstr "Para o UL principal"

msgid "For the list items"
msgstr "Para os itens de lista"

msgid "For the hyperlinks"
msgstr "Para os hyperlinks"

msgid "Unacceptable value entered for the \"Animation speed\" option."
msgstr "Valor inaceitável inserido para a opção \"Velocidade da animação\"."

msgid "Unacceptable value entered for the \"Mouse delay\" option."
msgstr "Valor inaceitável inserido para a opção \"Atraso do mouse\"."

msgid "\"sfTouchscreen Breakpoint\" option cannot be empty."
msgstr "A opção \"Ponto de interrupção de sfTouchscreen\" não pode estar vazia."

msgid "Unacceptable value enterd for the \"sfTouchscreen Breakpoint\" option."
msgstr "Valor inaceitável inserido para a opção \"Ponto de interrupção de sfTouchscreen\"."

msgid "List of the touch-screen user agents cannot be empty."
msgstr "A lista dos agentes do usuário de touch screen não pode ficar vazia."

msgid "\"sfSmallscreen Breakpoint\" option cannot be empty."
msgstr "A opção \"Ponto de interrupção de sfSmallscreen\" não pode estar vazia."

msgid "Unacceptable value entered for the \"sfSmallscreen Breakpoint\" option."
msgstr "Valor inaceitável inserido para a opção \"Ponto de interrupção de sfSmallscreen\"."

msgid "List of the small-screen user agents cannot be empty."
msgstr "A lista dos agentes do usuário de tela pequena não pode ficar vazia."

msgid "Unacceptable value entered for the \"Supersubs minimum width\" option."
msgstr "Valor inaceitável inserido para a opção \"Largura mínima de Supersubs\"."

msgid "Unacceptable value entered for the \"Supersubs maximum width\" option."
msgstr "Valor inaceitável inserido para a opção \"Largura máxima de Supersubs\"."

msgid "Supersubs \"maximum width\" has to be bigger than the \"minimum width\"."
msgstr "A \"largura máxima\" de Supersubs tem que ser maior que a \"largura mínima\"."

msgid "Expand"
msgstr "Expandir"

msgid "Collapse"
msgstr "Reduzir"

