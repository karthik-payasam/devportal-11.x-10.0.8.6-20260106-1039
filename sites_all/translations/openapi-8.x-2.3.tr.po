msgid "OpenAPI"
msgstr "OpenAPI"

msgid "Connects Drupal to the OpenAPI Javascript Library"
msgstr "Drupal ile OpenAPI Javascript Library arasında bağlantı kurar"

msgid "Available OpenAPI Documentation."
msgstr "Kullanılabilir OpenAPI Belgeleri."

msgid "Access API Docs"
msgstr "API Docs'a Erişim"

msgid "Access documentation page for the REST API"
msgstr "REST API belge sayfasına erişim"

msgid "OpenAPI Schema Download"
msgstr "OpenAPI Şeması Karşıdan Yüklemesi"

msgid "OpenAPI Resources"
msgstr "OpenAPI Kaynakları"

msgid "OpenAPI Documentation"
msgstr "OpenAPI Belgeleri"

msgid "%label OpenApi Schema Download"
msgstr "%label OpenApi Şeması Karşıdan Yüklemesi"

msgid "The specifications provide the documentation on some of Drupal's apis following <a href=':openapi_spec'>OpenAPI (aka Swagger)</a> standards."
msgstr "Belirtimler, <a href=':openapi_spec'>OpenAPI (diğer adıyla Swagger)</a> standartlarına uygun bazı Drupal API'leriyle ilgili belgeler sağlar."

msgid "These json files can be used in tools such as the <a href=\":swagger_editor\">Swagger Editor</a> to provide a more detailed version of the API documentation or <a href=\":swagger_codegen\">Swagger Codegen</a> to create an api client."
msgstr "Bu json dosyaları, API istemcisi oluşturmak için <a href=\":swagger_codegen\">Swagger Codegen</a> veya API belgelerinin daha ayrıntılı bir sürümünü sağlamak üzere <a href=\":swagger_editor\">Swagger Editor</a> gibi araçlarda kullanılabilir."

msgid "Module"
msgstr "Eklenti"

msgid "Specification"
msgstr "Belirtim"

msgid "Explore"
msgstr "Keşfet"

msgid "Please visit the <a href=':openapi_ui_link'>OpenAPI UI module</a> for information on these interfaces and to discover others."
msgstr "Bu arabirimlerle ilgili bilgi almak ve diğerlerini keşfetmek için lütfen <a href=':openapi_ui_link'>OpenAPI UI modülünü</a> ziyaret edin."

msgid "No UI plugins available"
msgstr "Kullanılabilir bir UI eklentisi yok"

msgid "There are no plugins available for exploring the OpenAPI documentation."
msgstr "OpenAPI belgelerini keşfetmek için kullanılabilir bir eklenti yok."

msgid "You can install one of the below projects to view the API Specifications from with your site."
msgstr "Sitenizden API Belirtimlerini görüntülemek için aşağıdaki projelerden birini kurabilirsiniz."

msgid "View/Download"
msgstr "Görüntüle/Karşıdan Yükle"

msgid "Explore with %interface"
msgstr "%interface ile keşfet"

msgid "No UI available."
msgstr "Kullanılabilir UI yok."

msgid "No OpenApi generator plugins are currently available."
msgstr "Şu anda kullanılabilir bir OpenApi oluşturucu eklentisi yok."

msgid "You must enable a REST or API module which supports OpenApi Downloads, such as the <a href=\":rest_link\">Core Rest</a> and <a href=\":jsonapi_link\">JSON:API</a> modules."
msgstr "<a href=\":rest_link\">Core Rest</a> ve <a href=\":jsonapi_link\">JSON:API</a> modülleri gibi OpenApi Karşıdan Yüklemelerini destekleyen bir REST veya API modülünü etkinleştirmeniz gerekir."

msgid "%generator OpenApi Documentation"
msgstr "%generator OpenApi Belgeleri"

