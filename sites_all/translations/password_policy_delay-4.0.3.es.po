msgid "Password Policy Delay"
msgstr "Retardo de política de contraseñas"

msgid "Sets up a password constraint to limit how soon before a password can be reset again."
msgstr "Configura una restricción de contraseña para limitar la rapidez con la que se puede volver a restablecer una contraseña."

msgid "Security"
msgstr "Seguridad"

msgid "Hours until next password reset may be performed."
msgstr "Horas que deben pasar hasta el siguiente restablecimiento de contraseña."

msgid ""
"Not enough time has passed\n"
"          since this password was last reset."
msgstr ""
"No ha transcurrido tiempo suficiente\n"
" desde la última vez que se restableció esta contraseña."

msgid "Hours until password can be reset again."
msgstr "Horas hasta que se pueda volver a restablecer la contraseña."

msgid "A value of 0 represents no delay"
msgstr "Un valor de 0 representa que no hay retardo"

msgid "The delay value must be zero or greater."
msgstr "El valor de retardo debe ser cero o mayor."

msgid "Delay in hours until password can be reset: @delay"
msgstr "Retardo en horas hasta que se pueda restablecer la contraseña: @delay"

msgid "Password Delay"
msgstr "Retardo de contraseña"

msgid "Provide delay before password can be reset again."
msgstr "Proporcione un retardo antes de que se pueda volver a restablecer la contraseña."

msgid "You cannot reset your password until the delay has as elapsed."
msgstr "No puede restablecer la contraseña hasta que el retardo haya transcurrido."

