msgid "Finished @num elements and @num_translations translations created successfully."
msgstr "@num öğe ve @num_translations çevirileri başarıyla oluşturuldu."

msgid "Finished @num elements created successfully."
msgstr "Sonlandırılan @num öğe başarıyla oluşturuldu."

msgid "Finished with an error."
msgstr "Bir hatayla tamamlandı."

msgid "Generate @label"
msgstr "@label oluştur"

msgid "Generate"
msgstr "Oluştur"

msgid "Generate realistic items (content, users, menus, etc) to assist your site development and testing."
msgstr "Sitenizin geliştirilmesine ve test edilmesine yardımcı olması için gerçekçi öğeler (içerik, kullanıcılar, menüler vb.) oluşturun."

msgid "Devel generate"
msgstr "Devel oluşturma"

msgid "Devel Generate"
msgstr "Geliştirme Oluşturma"

msgid "Generate test users, nodes, menus, taxonomy terms..."
msgstr "Test kullanıcıları, düğümler, menüler ve taksonomi terimleri oluşturun..."

msgid "Development"
msgstr "Geliştirme"

msgid "Administer devel_generate"
msgstr "devel_generate yönet"

msgid "Language"
msgstr "Dil"

msgid "Select the primary language(s) for @items"
msgstr "@items için birincil dil(ler)i seçin"

msgid "Disabled - requires Language module"
msgstr "Devre dışı - Dil modülü gerektirir"

msgid "Select the language(s) for translated @items"
msgstr "Çevirilen @items için dil(ler)i seçin"

msgid "Translated @items will be created for each language selected."
msgstr "Seçilen her dil için çevirilen @items oluşturulacaktır."

msgid "Disabled - requires Content Translation module."
msgstr "Devre dışı - İçerik Çeviri modülünü gerektirir."

msgid "@permission"
msgstr "@permission"

msgid "Failed to generate elements due to \"%error\"."
msgstr "\"%error\" nedeniyle öğeler oluşturulamadı."

msgid "You do not have any content types that can be generated. <a href=\":create-type\">Go create a new content type</a>"
msgstr "Oluşturulabilen içerik tipiniz yok. <a href=\":create-type\">Yeni içerik tipi oluştur menüsüne gidin</a>"

msgid "Hidden"
msgstr "Gizli"

msgid "Closed"
msgstr "Kapalı"

msgid "Open"
msgstr "Aç"

msgid "No comment fields"
msgstr "Yorum alanı yok"

msgid "Content type"
msgstr "İçerik tipi"

msgid "Comments"
msgstr "Açıklamalar"

msgid "<strong>Delete all content</strong> in these content types before generating new content."
msgstr "Yeni içerik oluşturmadan önce bu içerik tiplerinde <strong>tüm içeriği silin</strong>."

msgid "How many nodes would you like to generate?"
msgstr "Kaç düğüm oluşturmak itiyorsunuz?"

msgid "Now"
msgstr "Şimdi"

msgid "ago"
msgstr "önce"

msgid "How far back in time should the nodes be dated?"
msgstr "Düğümler ne kadar süreli olmalıdır?"

msgid "Node creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "Düğüm oluşturma tarihleri, geçerli saatten seçili saate kadar geriye doğru rastgele dağıtılır."

msgid "Maximum number of comments per node."
msgstr "Düğüm başına maksimum yorum sayısı."

msgid "You must also enable comments for the content types you are generating. Note that some nodes will randomly receive zero comments. Some will receive the max."
msgstr "Oluşturmakta olduğunuz içerik tipleri için yorumları da etkinleştirmeniz gerekir. Bazı düğümlerin rastgele sıfır yorum alacağını göz önünde bulundurun. Bazıları maksimum alır."

msgid "Maximum number of words in titles"
msgstr "Başlıklardaki maksimum sözcük sayısı"

msgid "Fields to leave empty"
msgstr "Boş bırakılacak alanlar"

msgid "Enter the field names as a comma-separated list. These will be skipped and have a default value in the generated content."
msgstr "Alan adlarını virgülle ayrılmış bir liste olarak girin. Bunlar atlanacak ve oluşturulan içerikte varsayılan bir değere sahip olacaktır."

msgid "Base fields to populate"
msgstr "Doldurulacak temel alanlar"

msgid "Enter the field names as a comma-separated list. These will be populated."
msgstr "Alan adlarını virgülle ayrılmış bir liste olarak girin. Bunlar doldurulacaktır."

msgid "Prefix the title with the content type label."
msgstr "Başlığa, içerik tipi etiketini önek olarak ekleyin."

msgid "This will not count against the maximum number of title words specified above."
msgstr "Bu, yukarıda belirtilen başlık sözcük sayısı üst sınırına sayılmaz."

msgid "Requires path.module"
msgstr "path.module gerektirir"

msgid "Add an url alias for each node."
msgstr "Her düğüm için bir url diğer adı ekleyin."

msgid "Add statistics for each node (node_counter table)."
msgstr "Her düğüm (node_counter tablosu) için istatistik ekleyin."

msgid "User ID"
msgstr "Kullanıcı Kimliği"

msgid "Name"
msgstr "Ad"

msgid "Role(s)"
msgstr "Roller"

msgid "Users"
msgstr "Kullanıcılar"

msgid "Select users for randomly assigning as authors of the generated content. Leave all unchecked to use a random selection of up to 50 users."
msgstr "Oluşturulan içeriğin yazarı olarak rastgele atanacak için kullanıcıları seçin. 50 kullanıcıya kadar rastgele bir seçim kullanmak için tümünü işaretlenmemiş olarak bırakın."

msgid "Please select at least one content type"
msgstr "Lütfen en az bir içerik tipi seçin"

msgid "Generating Content"
msgstr "İçerik Oluşturma"

msgid "Deleted %count nodes."
msgstr "%count düğüm siliniyor."

msgid "Completed @feedback nodes (@rate nodes/min)"
msgstr "@feedback düğüm (@rate düğüm/dak) tamamlandı"

msgid "No content types available"
msgstr "Kullanılabilir içerik tipi yok"

msgid "To delete content, please provide the content types (--bundles)"
msgstr "İçeriği silmek için, lütfen içerik tiplerini (--bundles) sağlayın"

msgid "One or more content types have been entered that don't exist on this site"
msgstr "Bu sitede olmayan bir ya da daha çok içerik tipi girildi"

msgid "Created 1 node"
msgid_plural "Created @count nodes"
msgstr[0] "1 düğüm oluşturuldu"
msgstr[1] "@count düğüm oluşturuldu"

msgid "Created 1 node translation"
msgid_plural "Created @count node translations"
msgstr[0] "1 düğüm çevirisi oluşturuldu"
msgstr[1] "@count düğüm çevirisi oluşturuldu"

msgid "content"
msgstr "içerik"

msgid "Generate a given number of content. Optionally delete current content."
msgstr "Belirli sayıda içerik oluşturun. İsteğe bağlı olarak geçerli içeriği silin."

msgid "You do not have any media types that can be generated. <a href=\":url\">Go create a new media type</a>"
msgstr "Oluşturulabilen bir ortam tipiniz yok. <a href=\":url\">Yeni bir ortam tipi oluşturun</a>"

msgid "Media type"
msgstr "Ortam tipi"

msgid "<strong>Delete all media</strong> in these types before generating new media."
msgstr "Yeni ortam oluşturmadan önce bu türlerdeki <strong>tüm ortamları silin</strong>."

msgid "How many media items would you like to generate?"
msgstr "Kaç adet ortam öğesi oluşturmak istersiniz?"

msgid "How far back in time should the media be dated?"
msgstr "Ortam tarihi ne zamana kadar geriye gitmeli?"

msgid "Media creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "Ortam oluşturma tarihleri, geçerli saatten seçili saate kadar geriye doğru rastgele dağıtılır."

msgid "Maximum number of words in names"
msgstr "Adlardaki sözcük sayısı üst sınırı"

msgid "Set language on media"
msgstr "Ortamdaki dili ayarla"

msgid "Requires locale.module"
msgstr "locale.module gerektirir"

msgid "Please select at least one media type"
msgstr "Lütfen en az bir ortam tipi seçin"

msgid "Generating media items"
msgstr "Ortam öğeleri oluşturuluyor"

msgid "Deleted %count media items."
msgstr "%count medya öğesi silindi."

msgid "Completed !feedback media items (!rate media/min)"
msgstr "!feedback ortam öğeleri tamamlandı (!rate ortam/dk)"

msgid "No media types available"
msgstr "Kullanılabilir ortam tipi yok"

msgid "media"
msgstr "ortam"

msgid "Generate a given number of media entities."
msgstr "Belirli sayıda ortam varlığı oluşturun."

msgid "Create new menu(s)"
msgstr "Yeni menü oluştur"

msgid "Generate links for these menus"
msgstr "Bu menüler için bağlantılar oluştur"

msgid "Number of new menus to create"
msgstr "Oluşturulacak yeni menü sayısı"

msgid "Number of links to generate"
msgstr "Oluşturulacak bağlantı sayısı"

msgid "Maximum length for menu titles and menu links"
msgstr "Menü başlıkları ve menü bağlantıları için uzunluk üst sınırı"

msgid "Text will be generated at random lengths up to this value. Enter a number between 2 and 128."
msgstr "Metin, bu değere kadar rasgele uzunluklarda oluşturulur. 2 ile 128 arasında bir sayı girin."

msgid "Types of links to generate"
msgstr "Oluşturulacak bağlantı tipleri"

msgid "Nodes"
msgstr "Düğümler"

msgid "Front page"
msgstr "Ön sayfa"

msgid "External"
msgstr "Dış"

msgid "Maximum link depth"
msgstr "Maksimum bağlantı derinliği"

msgid "Maximum menu width"
msgstr "Maksimum menü genişliği"

msgid "Limit the width of the generated menu's first level of links to a certain number of items."
msgstr "Bağlantıların oluşturulan menünün ilk düzeyinin genişliğini belirli sayıda öğe olarak sınırlandırın."

msgid "Delete existing custom generated menus and menu links before generating new ones."
msgstr "Var olan, özel oluşturulan menüleri ve menü bağlantılarını, yenilerini oluşturmadan önce silin."

msgid "Deleted @menus_deleted menu(s) and @links_deleted other link(s)."
msgstr "@menus_deleted menüleri ve diğer @links_deleted bağlantıları silindi."

msgid "Description of @name"
msgstr "@name açıklaması"

msgid "Description of @title."
msgstr "@title açıklaması."

msgid "Invalid number of menus"
msgstr "Geçersiz menü sayısı"

msgid "Invalid number of links"
msgstr "Geçersiz bağlantı sayısı"

msgid "Invalid maximum link depth. Use a value between 1 and 9"
msgstr "Geçersiz maksimum bağlantı derinliği. 1 ile 9 arasında bir değer kullanın"

msgid "Invalid maximum menu width. Use a positive numeric value."
msgstr "Geçersiz maksimum menü genişliği. Pozitif bir sayısal değer kullanın."

msgid "Created the following 1 new menu: @menus"
msgid_plural "Created the following @count new menus: @menus"
msgstr[0] "Şu 1 yeni menü oluşturuldu: @menus"
msgstr[1] "Şu @count yeni menü oluşturuldu: @menus"

msgid "menus"
msgstr "menüler"

msgid "Generate a given number of menus and menu links. Optionally delete current menus."
msgstr "Belirli sayıda menü ve menü bağlantıları oluşturun. İsteğe bağlı olarak geçerli menüleri silin."

msgid "Vocabularies"
msgstr "Sözlükler"

msgid "Restrict terms to these vocabularies."
msgstr "Terimleri bu sözlüklerle sınırlandırın."

msgid "Number of terms"
msgstr "Terim sayısı"

msgid "Maximum number of characters in term names"
msgstr "Terim adlarında maksimum karakter sayısı"

msgid "Minimum depth for new terms in the vocabulary hierarchy"
msgstr "Sözlük sıradüzenindeki yeni terimler için derinlik alt sınırı"

msgid "Enter a value from 1 to 20."
msgstr "1 ile 20 arasında bir değer girin."

msgid "Maximum depth for new terms in the vocabulary hierarchy"
msgstr "Sözlük hiyerarşisinde yeni terimler için derinlik üst sınırı"

msgid "Delete existing terms in specified vocabularies before generating new terms."
msgstr "Yeni terimler oluşturmadan önce belirtilen sözlüklerde var olan terimleri silin."

msgid "In vocabulary @vlabel: @termlist"
msgstr "Şu sözlükte @vlabel: @termlist"

msgid "In vocabulary @vlabel: No terms created"
msgstr "Şu sözlükte @vlabel: Herhangi bir terim oluşturulmadı"

msgid "Minimum depth changed from @min_depth to 1 because all terms were deleted"
msgstr "Tüm terimler silindiğinden derinlik alt sınırı @min_depth iken 1 olarak değiştirildi"

msgid "Please provide a vocabulary machine name (--bundles)."
msgstr "Lütfen bir sözlük makine adı sağlayın (--bundles)."

msgid "Invalid vocabulary machine name: @name"
msgstr "Geçersiz sözlük makine adı: @name"

msgid "Invalid number of terms: @num"
msgstr "Geçersiz terim sayısı: @num"

msgid "The depth values must be in the range 1 to 20 and min-depth cannot be larger than max-depth (values given: min-depth @min, max-depth @max)"
msgstr "Derinlik değerleri 1 ile 20 aralığında olmalıdır ve minimum derinlik, maksimum derinlikten büyük olamaz (verilen değerler: min. derinlik @min, maks. derinlik @max)"

msgid "Created 1 new term"
msgid_plural "Created @count new terms"
msgstr[0] "1 yeni terim oluşturuldu"
msgstr[1] "@count yeni terim oluşturuldu"

msgid "1 new term at level @level (@terms)"
msgid_plural "@count new terms at level @level (@terms)"
msgstr[0] "@level düzeyinde 1 yeni terim (@terms)"
msgstr[1] "@level düzeyinde @count yeni terim (@terms)"

msgid "Created 1 term translation"
msgid_plural "Created @count term translations"
msgstr[0] "1 terim çevirisi oluşturuldu"
msgstr[1] "@count terim çevirisi oluşturuldu"

msgid "Deleted 1 existing term"
msgid_plural "Deleted @count existing terms"
msgstr[0] "Var olan 1 terim silindi"
msgstr[1] "Var olan @count terim silindi"

msgid "terms"
msgstr "terim"

msgid "Generate a given number of terms. Optionally delete current terms."
msgstr "Belirli sayıda terim oluşturun. İsteğe bağlı olarak geçerli terimleri silin."

msgid "How many users would you like to generate?"
msgstr "Kaç kullanıcı oluşturmak istiyorsunuz?"

msgid "Delete all users (except user id 1) before generating new users."
msgstr "Yeni kullanıcılar oluşturmadan önce tüm kullanıcıları (kullanıcı kimliği 1 dışında) silin."

msgid "Which roles should the users receive?"
msgstr "Kullanıcılar hangi rolleri almalıdır?"

msgid "Users always receive the <em>authenticated user</em> role."
msgstr "Kullanıcılar her zaman <em>kimliği doğrulanmış kullanıcı</em> rolünü alır."

msgid "Password to be set"
msgstr "Ayarlanacak parola"

msgid "Leave this field empty if you do not need to set a password"
msgstr "Bir parola ayarlamanız gerekmiyorsa bu alanı boş bırakın"

msgid "How old should user accounts be?"
msgstr "Kullanıcı hesapları ne kadar eski olmalıdır?"

msgid "User ages will be distributed randomly from the current time, back to the selected time."
msgstr "Kullanıcı yaşları, geçerli saatten seçili saate kadar geriye doğru rastgele dağıtılır."

msgid "@num_users created."
msgstr "@num_users oluşturuldu."

msgid "1 user deleted"
msgid_plural "@count users deleted."
msgstr[0] "1 kullanıcı silindi"
msgstr[1] "@count kullanıcı silindi"

msgid "1 user"
msgid_plural "@count users"
msgstr[0] "1 kullanıcı"
msgstr[1] "@count kullanıcı"

msgid "users"
msgstr "kullanıcılar"

msgid "Generate a given number of users. Optionally delete current users."
msgstr "Belirli sayıda kullanıcı oluşturun. İsteğe bağlı olarak geçerli kullanıcıları silin."

msgid "Number of vocabularies?"
msgstr "Sözlük sayısı?"

msgid "Maximum number of characters in vocabulary names"
msgstr "Sözlük adlarında maksimum karakter sayısı"

msgid "Delete existing vocabularies before generating new ones."
msgstr "Yenilerini oluşturmadan önce var olan sözlükleri silin."

msgid "Deleted existing vocabularies."
msgstr "Var olan sözlükler silindi."

msgid "Created the following new vocabularies: @vocs"
msgstr "Şu yeni sözlükler oluşturuldu: @vocs"

msgid "Invalid number of vocabularies: @num."
msgstr "Geçersiz sözlük sayısı: @num."

msgid "vocabularies"
msgstr "sözlükler"

msgid "Generate a given number of vocabularies. Optionally delete current vocabularies."
msgstr "Belirli sayıda sözlük oluşturun. İsteğe bağlı olarak geçerli sözlükleri silin."

