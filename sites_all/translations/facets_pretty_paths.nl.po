msgid "Pretty paths coder"
msgstr "Pretty Paths Coder"

msgid "Facets Pretty Paths"
msgstr "Facets Pretty Paths"

msgid "Pretty paths for Facets."
msgstr "Pretty Paths voor facetten."

msgid "Search"
msgstr "Zoeken"

msgid "Facet Pretty Paths third party settings on the Facet config"
msgstr "Instellingen van derden voor Facet Pretty Paths in de Facet-configuratie"

msgid "The coder plugin ID"
msgstr "Het ID van de coderplugin"

msgid "Home"
msgstr "Home"

msgid "Pretty paths"
msgstr "Pretty Paths"

msgid "Pretty paths uses slashes as separator, e.g. /brand/drupal/color/blue"
msgstr "Pretty Paths gebruikt schuine strepen als scheidingsteken, bijv. /brand/drupal/color/blue"

msgid "Default"
msgstr "Standaard"

msgid "Use the raw value, no special processing is done, e.g. /color/<strong>2</strong>"
msgstr "Gebruik de ruwe waarde, er vindt geen speciale verwerking plaats, bijv. /color/<strong>2</strong>"

msgid "Node title + id"
msgstr "Knooppunttitel + ID"

msgid "Use node title with entity id, e.g. /color/<strong>blue-2</strong>"
msgstr "Gebruik de knooppunttitel met het entiteit-ID, bijvoorbeeld /color/<strong>blue-2</strong>"

msgid "Taxonomy term name + id"
msgstr "Naam + ID van taxonomieterm"

msgid "Use term name with term id, e.g. /color/<strong>blue-2</strong>"
msgstr "Gebruik de naam van de term met het ID van de term, bijv. /color/<strong>blue-2</strong>"

