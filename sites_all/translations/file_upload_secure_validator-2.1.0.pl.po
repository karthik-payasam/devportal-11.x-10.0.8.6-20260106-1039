msgid "About"
msgstr "O stronie"

msgid "Secure File Upload Mime Detect"
msgstr "Bezpieczne wykrywanie typu MIME przy przesyłaniu plików"

msgid "Fileinfo extension"
msgstr "Rozszerzenie Fileinfo"

msgid "Found"
msgstr "Znaleziono"

msgid "Fileinfo extension not available"
msgstr "Rozszerzenie Fileinfo nie jest dostępne"

msgid "File upload secure validator module uses Fileinfo extension. It seems as if Fileinfo extension is not loaded/enabled. If you are using Windows, may be, you should uncomment php_fileinfo.dll in php.ini file."
msgstr "Moduł bezpiecznego analizatora poprawności przesyłania pliku używa rozszerzenia Fileinfo. Wygląda na to, że rozszerzenie Fileinfo nie jest załadowane/włączone. Jeśli używany jest system Windows, może to oznaczać, że należy usunąć znak komentarza przy wpisie php_fileinfo.dll w pliku php.ini."

msgid "File Upload Secure Validator"
msgstr "Bezpieczny analizator poprawności przesyłania pliku"

msgid "Secure Mime Detect"
msgstr "Bezpieczne wykrywanie typu MIME"

msgid "Security"
msgstr "Bezpieczeństwo"

msgid "Manage the list of MIME types equivalence groups."
msgstr "Zarządzaj listą grup równoważności typów MIME."

msgid "Administer File Upload Secure Validator configuration"
msgstr "Administrowanie konfiguracją programu File Upload Secure Validator"

msgid "Allow user to administer File Upload Secure Validator configuration."
msgstr "Zezwól użytkownikowi na administrowanie konfiguracją programu File Upload Secure Validator."

msgid "SettingsForm"
msgstr "SettingsForm"

msgid "MIME types equivalence groups"
msgstr "Grupy równoważności typów MIME"

msgid "MIME types equivalence group"
msgstr "Grupa równoważności typów MIME"

msgid "MIME type"
msgstr "typ MIME"

msgid "MIME types equivalence group(s)"
msgstr "Grupy równoważności typów MIME"

msgid "A CSV-like list of MIME types groups; if two MIME types are part of the same group, then, File Upload Secure Validator will not protest."
msgstr "Lista grup typów MIME o formacie podobnym do CSV. Upload Secure Validator nie zgłosi błędu, jeśli dwa typy MIME należą do tej samej grupy."

msgid "Caught an InvalidArgumentException; cannot validate missing file requested as @path"
msgstr "Przechwycono wyjątek InvalidArgumentException; nie można sprawdzić poprawności brakującego pliku zażądanego jako @path"

msgid "There was a problem with this file. The uploaded file is of type @extension but the real content seems to be @real_extension"
msgstr "Wystąpił problem z tym plikiem. Przesłany plik jest typu @extension, ale rzeczywista treść wydaje się mieć typ @real_extension"

msgid "Error while uploading file: MimeTypeGuesser guessed '%mime_by_fileinfo' and fileinfo '%mime_by_filename'"
msgstr "Wystąpił błąd podczas przesyłania pliku: MimeTypeGuesser zgadł '%mime_by_fileinfo' i fileinfo '%mime_by_filename'"

