msgid "Entity Warmer"
msgstr "엔티티 워머"

msgid "Warms the entity cache for the configured entity types."
msgstr "구성된 엔티티 유형에 대한 엔티티 캐시를 워밍합니다."

msgid "Entity Types"
msgstr "엔티티 유형"

msgid "Enable the entity types to warm asynchronously."
msgstr "엔티티 유형을 비동기적으로 워밍하도록 설정합니다."

msgid "Entity"
msgstr "엔티티"

msgid "Loads entities from the selected entity types & bundles to warm the entity cache."
msgstr "엔티티 캐시를 웜시키기 위해 선택된 엔티티 유형 및 번들의 엔티티를 로드합니다."

