msgid "About"
msgstr "Hakkında"

msgid "DropzoneJS"
msgstr "DropzoneJS"

msgid "or"
msgstr "ya da"

msgid "Select file"
msgid_plural "Select files"
msgstr[0] "Dosya Seç"
msgstr[1] "Dosyaları seç"

msgid "Dropzone library missing"
msgstr "Dropzone kitaplığı eksik"

msgid ""
"Dropzonejs requires the dropzone.min.js library.\n"
"        Download it (https://github.com/enyo/dropzone) and place it in the\n"
"        libraries folder (/libraries)"
msgstr ""
"Dropzonejs, dropzone.min.js kitaplığı gerektirir.\n"
"        Kitaplığı karşıdan yükleyin (https://github.com/enyo/dropzone) ve \n"
"        kitaplıklar klasörüne (/libraries) yerleştirin."

msgid "dropzonejs"
msgstr "dropzonejs"

msgid "The Drupal integration for DropzoneJS."
msgstr "DropzoneJS için Drupal bütünleştirmesi."

msgid "Media"
msgstr "Medya"

msgid "Dropzone upload files"
msgstr "Dropzone karşıya yükleme dosyaları"

msgid "Allow uploading of files via dropzonejs."
msgstr "dropzonejs aracılığıyla dosyaların karşıya yüklenmesini sağlar."

msgid "DropzoneJS settings"
msgstr "DropzoneJS ayarları"

msgid "Upload scheme"
msgstr "Şemayı karşıya yükle"

msgid "Transliterate names of uploaded files"
msgstr "Karşıya yüklenen dosyaların başka alfabeyle yazılmış adları"

msgid "Upload timeout"
msgstr "Karşıya yükleme zamanaşımı"

msgid "Drop files here to upload"
msgstr "Karşıya yüklenecek dosyaları buraya bırakın"

msgid "Your browser does not support drag'n'drop file uploads."
msgstr "Tarayıcınız dosya yukarı yüklemede sürükleyip bırakma yöntemini desteklemiyor."

msgid "Please use the fallback form below to upload your files like in the olden days."
msgstr "Dosyalarınızı eskiden olduğu gibi yukarı yüklemek için aşağıdaki yedek biçimi kullanın."

msgid "File is too big ({{filesize}}MiB). Max filesize: {{maxFilesize}}MiB."
msgstr "Dosya çok büyük ({{filesize}}MiB). Dosya büyüklüğü üst sınırı: {{maxFilesize}}MiB."

msgid "You can't upload files of this type."
msgstr "Bu tip dosyaları yükleyemezsiniz."

msgid "Server responded with {{statusCode}} code."
msgstr "Sunucu {{statusCode}} koduyla yanıt verdi."

msgid "Cancel upload"
msgstr "Karşıya yüklemeyi iptal et"

msgid "Are you sure you want to cancel this upload?"
msgstr "Karşıya yüklemeyi iptal etmek istediğinizden emin misiniz?"

msgid "Remove file"
msgstr "Dosyayı sil"

msgid "You can not upload any more files."
msgstr "Başka dosya yükleyemezsiniz."

msgid "TB"
msgstr "TB"

msgid "GB"
msgstr "GB"

msgid "MB"
msgstr "MB"

msgid "KB"
msgstr "KB"

msgid "b"
msgstr "b"

msgid "DropzoneJS entity browser widget"
msgstr "DropzoneJS varlık tarayıcı pencere bileşeni"

msgid "DropzoneJS Entity browser widget."
msgstr "DropzoneJS Varlık tarayıcı pencere bileşeni."

msgid "DropzoneJS widget configuration"
msgstr "DropzoneJS pencere bileşeni yapılandırması"

msgid "Submit button text"
msgstr "Gönder Düğmesi Metni"

msgid "Automatically submit selection"
msgstr "Seçimi otomatik olarak gönder"

msgid "Upload location"
msgstr "Konumu karşıya yükle"

msgid "Dropzone drag-n-drop zone text"
msgstr "Dropzone sürükle-bırak alanı metni"

msgid "Maximum size of files"
msgstr "Dosyaların maksimum boyutu"

msgid "Allowed file extensions"
msgstr "İzin verilen dosya uzantıları"

msgid "Use clientside resize"
msgstr "İstemci tarafı yeniden boyutlandırma kullan"

msgid "Maximum width"
msgstr "En fazla genişlik"

msgid "Maximum height"
msgstr "En fazla yükseklik"

msgid "Resize quality"
msgstr "Yeniden boyutlandırma kalitesi"

msgid "Method used for resizing"
msgstr "Yeniden boyutlandırma için kullanılan yöntem"

msgid "Method used for generating the thumbnail"
msgstr "Küçük resmi oluşturmak için kullanılan yöntem"

msgid "Media Entity DropzoneJS widget configuration"
msgstr "Media Entity DropzoneJS pencere bileşeni yapılandırması"

msgid "Media type"
msgstr "Medya tipi"

msgid "Media Entity DropzoneJS with edit widget configuration"
msgstr "Pencere bileşeni yapılandırmasını düzenlemeyi içeren Media Entity DropzoneJS"

msgid "Form mode"
msgstr "Form Kipi"

msgid "Drop files here to upload them"
msgstr "Karşıya yüklemek için dosyaları buraya bırakın"

msgid "File upload"
msgstr "Dosya karşıya yükleme"

msgid "Files could not be uploaded because the destination directory %destination is not configured correctly."
msgstr "Hedef dizin %destination düzgün yapılandırılmadığından dosyalar karşıya yüklenemedi."

msgid "Some files that you are trying to upload did not pass validation. Requirements are: max file %size, allowed extensions are %extensions"
msgstr "Karşıya yüklemeye çalıştığınız bazı dosyalar doğrulamayı geçemedi. Gereksinimler: maksimum dosya %size, izin verilen uzantılar: %extensions"

msgid "At least one valid file should be uploaded."
msgstr "En az bir geçerli dosya karşıya yüklenmelidir."

msgid "A space separated list of file extensions"
msgstr "Dosya uzantılarının boşlukla ayrılmış listesi"

msgid "Use client side resizing"
msgstr "İstemci tarafı yeniden boyutlandırması kullan"

msgid "Requires droopzone version v4.4.0 or higher and the <a href=\"@exif\" target=\"_blank\">exif</a> library."
msgstr "droopzone v4.4.0 veya üzeri bir sürüm ve <a href=\"@exif\" target=\"_blank\">exif</a> kitaplığını gerektirir."

msgid "Max width"
msgstr "Genişlik üst sınırı"

msgid "Max height"
msgstr "Yükseklik üst sınırı"

msgid "Resize method"
msgstr "Yeniden boyutlandırma yöntemi"

msgid "Contain (scale)"
msgstr "İçerir (ölçek)"

msgid "Crop"
msgstr "Kırp"

msgid "Thumbnail method"
msgstr "Küçük resim yöntemi"

msgid "Invalid extension list format."
msgstr "Geçersiz uzantı listesi biçimi."

msgid "Adds DropzoneJS upload integration."
msgstr "DropzoneJS karşıya yükleme bütünleştirmesi ekler."

msgid "Missing requirement: in order to use this widget you have to install Inline entity form module first"
msgstr "Eksik gereksinim: Bu pencere bileşenini kullanmak için öncelikle Inline varlık formu modülünü kurmanız gerekir"

msgid "Edit"
msgstr "Düzenle"

msgid "Media Entity DropzoneJS with edit"
msgstr "Düzenleme içeren Media Entity DropzoneJS"

msgid "Adds DropzoneJS upload integration that saves Media entities and allows to edit them."
msgstr "Ortam varlıklarını kaydeden ve bunların düzenlenmesini sağlayan DropzoneJS karşıya yükleme bütünleştirmesi ekler."

msgid "The type of media entity to create from the uploaded file(s)."
msgstr "Karşıya yüklenen dosyadan/dosyalardan oluşturulacak ortam varlığı tipi."

msgid "You must @create_media_type before using this widget."
msgstr "Bu pencere bileşenini kullanmadan önce @create_media_type"

msgid "create a media type"
msgstr "bir ortam tipi oluşturun"

msgid "Media Entity DropzoneJS"
msgstr "Media Entity DropzoneJS"

msgid "Adds DropzoneJS upload integration that saves Media entities."
msgstr "Ortam varlıklarını kaydeden DropzoneJS karşıya yükleme bütünleştirmesini ekler."

msgid "For security reasons, your upload has been renamed to %filename."
msgstr "Güvenlik nedeniyle, yüklediğiniz dosyanın adı %filename olarak değiştirilmiştir."

msgid "The specified file %name could not be uploaded."
msgstr "Seçilen %name dosyası yüklenemedi."

msgid "The file could not be uploaded because the destination %destination is invalid."
msgstr "%destination hedefi geçersiz olduğundan dosya karşıya yüklenemedi."

msgid "File upload error. Could not move uploaded file."
msgstr "Dosya yükleme hatası. Yüklenen dosya taşınamadı."

msgid "Upload error. Could not move uploaded file %file to destination %destination."
msgstr "Yükleme hatası. Yüklenen %file dosyası  %destination hedefine taşınamadı."

msgid "The file could not be saved because it exceeds the maximum allowed size for uploads."
msgstr "Karşıya yüklemeler için izin verilen maksimum boyutu aştığından dosya kaydedilemedi."

msgid "The file could not be saved because the upload did not complete."
msgstr "Karşıya yükleme işlemi tamamlanmadığından dosya kaydedilemedi."

msgid "The file could not be saved. An unknown error has occurred."
msgstr "Dosya kaydedilemedi. Bilinmeyen bir hata oluştu."

msgid "There was a problem while processing the file named @name"
msgstr "@name adlı dosya işlenirken bir sorun oluştu"

msgid "You don't have sufficent permissions to use the DropzoneJS uploader. Contact your system administrator"
msgstr "DropzoneJS karşıya yükleyicisini kullanmak için yeterli izniniz yok. Sistem yöneticinize başvurun."

msgid "A maximum of @count files can be uploaded."
msgstr "Maksimum @count dosya karşıya yüklenebilir."

msgid "Drop file here to upload it"
msgid_plural "Drop files here to upload them"
msgstr[0] "Karşıya yüklemek için dosyayı buraya bırakın"
msgstr[1] "Karşıya yüklemek için dosyaları buraya bırakın"

