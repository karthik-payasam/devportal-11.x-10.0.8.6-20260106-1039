msgid "No destination directory provided."
msgstr "Не указан целевой каталог."

msgid "About"
msgstr "Информация"

msgid "Helper module to quickly import a list of terms with parent structure."
msgstr "Вспомогательный модуль для быстрого импорта списка терминов с родительской структурой."

msgid "Term CSV Export/Import"
msgstr "Экспортировать/импортировать термины в формате CSV"

msgid "Import and Export Taxonomy terms as csv."
msgstr "Импортировать и экспортировать термины таксономии в формате csv."

msgid "Taxonomy"
msgstr "Таксономия"

msgid "Import and Export Taxonomy Terms as CSV"
msgstr "Импортировать и экспортировать термины таксономии в формате CSV"

msgid "Term CSV Import"
msgstr "Импортировать термины в формате CSV"

msgid "Term CSV Export"
msgstr "Экспортировать термины в формате CSV"

msgid "Administer CSV Term Import"
msgstr "Администрирование импорта терминов в формате CSV"

msgid "Allows a user to import taxonomy terms."
msgstr "Позволяет пользователю импортировать термины таксономии."

msgid "CSV Term Import"
msgstr "Импорт терминов в формате CSV"

msgid "CSV Term Export"
msgstr "Экспорт терминов в формате CSV"

msgid "The header keys were not included in the import."
msgstr "Ключи заголовков не были импортированы."

msgid "Line with \"@part\" could not be parsed. Incorrect number of values: @count."
msgstr "Не удалось проанализировать строку с \"@part\". Неправильное число значений: @count."

msgid "The term @name has multiple matches. Ignoring."
msgstr "Найдено несколько совпадений для термина @name. Игнорируется."

msgid "The term with id @id already exists and preserve existing terms is checked. No modification has been made."
msgstr "Термин с ИД @id уже существует, и выбрана опция сохранения существующих терминов. Никакие изменения внесены не будут."

msgid "The Term ID already exists."
msgstr "ИД термина уже существует."

msgid "More than 1 terms are named @name. Cannot distinguish by name. Try using id export/import."
msgstr "Существует несколько терминов с именем @name. Их нельзя отличить по имени. Попробуйте выполнить процедуру импорта/экспорта с помощью ИД."

msgid "The field data <em>@data</em> is not formatted correctly. Please use the export function."
msgstr "Поле содержит данные в недопустимом формате: <em>@data</em>. Используйте функцию экспорта."

msgid "The field data <em>@data</em> could not be imported. Please add the appropriate fields to the vocabulary you are importing into."
msgstr "Не удалось импортировать данные поля: <em>@data</em>. Добавьте соответствующие поля в словарь, в который импортируются данные."

msgid "Imported @count terms."
msgstr "Импортировано терминов: @count."

msgid "Include Term Ids in export."
msgstr "Экспортировать термины вместе с ИД."

msgid "Include Term Headers in export."
msgstr "Экспортировать термины вместе с заголовками."

msgid "Include extra fields in export."
msgstr "Экспортировать дополнительные поля."

msgid "Note that fields are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"
msgstr "Обратите внимание, что поля переводятся в строковое представление с помощью <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"

msgid "Export"
msgstr "Экспортировать"

msgid "CSV Data"
msgstr "Данные CSV"

msgid "The formatted term data"
msgstr "Отформатированные данные терминов"

msgid "Input"
msgstr "Входные данные"

msgid "<p><strong>See CSV Export for an example.</strong></p><p>Enter in the form of: <pre>\"name,status,description,format,weight,parent_name,[any_additional_fields];</pre><pre>name,status,description,format,weight,parent_name[;parent_name1;parent_name2;...],[any_additional_fields]\"</pre> or <pre>\"tid,uuid,name,status,revision_id,description,format,weight,parent_name[;parent_name1;parent_name2;...],parent_tid[;parent_tid1;parent_tid2;...],[any_additional_fields];</pre><pre>tid,uuid,name,status,revision_id,description,format,weight,parent_name,parent_tid,[any_additional_fields]\"</pre> Note that <em>[any_additional_fields]</em> are optional and are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>If you need to export from Drupal 7, you can import and modify the view d7exportview.txt found at the root directory of this project</p>"
msgstr "<p><strong>См. пример экспорта в CSV.</strong></p><p>Формат: <pre>\"name,status,description,format,weight,parent_name,[дополнительные-поля];</pre><pre>name,status,description,format,weight,parent_name[;parent_name1;parent_name2;...],[дополнительные-поля]\"</pre> или <pre>\"tid,uuid,name,status,revision_id,description,format,weight,parent_name[;parent_name1;parent_name2;...],parent_tid[;parent_tid1;parent_tid2;...],[дополнительные-поля];</pre><pre>tid,uuid,name,status,revision_id,description,format,weight,parent_name,parent_tid,[дополнительные-поля]\"</pre> Обратите внимание, что <em>[дополнительные-поля]</em> указывать необязательно; они переводятся в строковое представление с помощью <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>Если необходимо экспортировать данные из Drupal 7, то можно импортировать и изменить представление d7exportview.txt, расположенное в корневом каталоге этого проекта</p>"

msgid "Preserve Vocabularies on existing terms."
msgstr "Сохранить словари для существующих терминов."

msgid "Preserve existing terms. This will prevent a term id collision if importing from another install."
msgstr "Сохранить существующие термины. Это позволит исключить конфликт ИД терминов при импорте из другого экземпляра продукта."

msgid "Next"
msgstr "Вперёд"

msgid "Name"
msgstr "Название"

msgid "Create New Vocabulary"
msgstr "Создать новый словарь"

msgid "Create Vocabulary"
msgstr "Создать словарь"

msgid "Are you sure you want to copy @count_terms terms into the vocabulary @vocabulary@preserve_vocabularies?"
msgstr "Вы действительно хотите скопировать термины (@count_terms) в словарь @vocabulary@preserve_vocabularies?"

msgid "Import"
msgstr "Импортировать"

