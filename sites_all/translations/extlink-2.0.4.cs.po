msgid "You can now <a href=\"@extlink_admin\">configure the External Links module</a> for your site."
msgstr "Nyní můžete pro váš server <a href=\"@extlink_admin\">nakonfigurovat modul Externí odkazy</a>."

msgid "External Links is used to differentiate between internal and external links. Using jQuery, it will find all external links on a page and add an external icon indicating it will take you offsite or a mail icon for mailto links."
msgstr "Modul Externí odkazy se používá k rozlišení mezi interními a externími odkazy. Pomocí nástroje jQuery najde na stránce všechny externí odkazy a přidá externí ikonu, která označuje, že vás zavede mimo server a ikonu pošty pro odkazy mailto."

msgid "This link will take you to an external web site. We are not responsible for their content."
msgstr "Tento odkaz vás zavede na externí webové stránky. Nejsme zodpovědni za jejich obsah."

msgid "(link is external)"
msgstr "(odkaz je externí)"

msgid "(link sends email)"
msgstr "(odkaz odešle e-mail)"

msgid "External Links"
msgstr "Externí odkazy"

msgid "Modify behavior and appearance of external links."
msgstr "Změní chování a vzhled externích odkazů."

msgid "User interface"
msgstr "Uživatelské rozhraní"

msgid "External Links administration page."
msgstr "Stránka správy externích odkazů."

msgid "Settings"
msgstr "Nastavení"

msgid "Administer External Links"
msgstr "Spravovat externí odkazy"

msgid "External Links Settings"
msgstr "Nastavení externích odkazů"

msgid "Load exclusions and inclusions externally"
msgstr "Načíst vyloučení a zahrnutí externě"

msgid "Disable module on admin routes."
msgstr "Zakázat modul na trasách administrace."

msgid "Open external links in a new tab"
msgstr "Otevřít externí odkazy na nové kartě"

msgid "Do not override target=\"*\" if set"
msgstr "Nepřepisovat target=\"*\", pokud je nastaveno"

msgid "Tag external links as \"no follow\""
msgstr "Označit externí odkazy jako \"no follow\""

msgid "Tag external links as \"noreferrer\""
msgstr "Označit externí odkazy jako \"noreferrer\""

msgid "Do not override rel=\"follow\" if set"
msgstr "Nepřepisovat rel=\"follow\", pokud je nastaveno"

msgid "Consider subdomains internal"
msgstr "Považovat subdomény za interní"

msgid "Enable Pop-up warnings"
msgstr "Povolit upozornění ve vyskakovacím okně"

msgid "Message to display when Pop-up warning is shown"
msgstr "Zpráva, která se má zobrazit při zobrazení automaticky otevřeného upozornění"

msgid "Exclude links matching the pattern"
msgstr "Vyloučit odkazy, které odpovídají vzorku"

msgid "Include links matching the pattern"
msgstr "Zahrnout odkazy, které odpovídají vzorku"

msgid "Add icon to external links"
msgstr "Přidat ikonu externím odkazům"

msgid "Alternative text for external link icon"
msgstr "Alternativní text pro ikonu externího odkazu"

msgid "Treat images wrapped in an anchor tag as external links"
msgstr "Zacházet s obrázky zabalenými do kotvicí značky jako s externími odkazy"

msgid "Comma-separated list of CSS selectors to exclude"
msgstr "Čárkami oddělený seznam selektorů CSS k vyloučení"

msgid "Comma-separated list of CSS selectors to include"
msgstr "Čárkami oddělený seznam selektorů CSS k zahrnutí"

msgid "Add icon to mailto links"
msgstr "Přidat ikonu k e-mailovým odkazům"

msgid "Alternative text for mailto icon"
msgstr "Alternativní text pro ikonu mailto"

msgid "Use Font Awesome icons instead of images."
msgstr "Místo obrázků použijte ikony Font Awesome."

msgid "Font Awesome icon classes"
msgstr "Třídy ikon Font Awesome "

msgid "External link classes"
msgstr "Třídy externích odkazů"

msgid "Mailto link classes"
msgstr "Třídy odkazů Mailto "

msgid "Add icon in front of any processed link."
msgstr "Přidejte ikonu před jakýkoli zpracovaný odkaz."

msgid "Whitelisted domains"
msgstr "Seznam povolených domén"

msgid "Domain"
msgstr "Doména"

msgid "Disable on admin routes."
msgstr "Zakázat na trasách administrace."

msgid "Whether the extlink module should be disabled on admin routes."
msgstr "Zda by měl být modul extlink zakázán na trasách administrace."

msgid "Load exclusions and inclusions externally."
msgstr "Načtěte vyloučení a zahrnutí externě."

msgid "Whether the extlink JS settings should be added to the page via an external settings file. In the case of a large number of patterns, this will reduce the amount of markup added to each page."
msgstr "Určuje, zda mají být nastavení extlink JS přidána na stránku prostřednictvím externího souboru nastavení. V případě velkého počtu vzorků dojde ke snížení množství markupů přidaných na každou stránku."

msgid "Place an icon next to external links."
msgstr "Umístěte ikonu vedle externích odkazů."

msgid "Places an <span class=\"ext\"> </span>&nbsp; icon next to external links."
msgstr "Umístí <span class=\"ext\"> </span>&nbsp; ikonu vedle externích odkazů."

msgid "Place an icon next to mailto links."
msgstr "Umístěte ikonu vedle odkazů mailto."

msgid "Places an <span class=\"mailto\"> </span>&nbsp; icon next to mailto links."
msgstr "Umístí <span class=\"mailto\"> </span>&nbsp; ikonu vedle e-mailových odkazů."

msgid "Place an icon next to image links."
msgstr "Umístěte ikonu vedle odkazů image."

msgid "If checked, images wrapped in an anchor tag will be treated as external links."
msgstr "Je-li zaškrtnuto, obrázky zabalené do kotvicí značky budou považovány za externí odkazy."

msgid "Add Font Awesome classes to the link as well as an i tag rather than images."
msgstr "Přidejte třídy Font Awesome do odkazu a do značek i místo obrázků."

msgid "Font Awesome External Links Classes"
msgstr "Třídy externích odkazů Font Awesome "

msgid "Font Awesome mailto Links Classes"
msgstr "Třídy odkazů Font Awesome Mailto"

msgid "Where to place icon in reference to link."
msgstr "Kam umístit ikonu jako odkaz na odkaz."

msgid "Before"
msgstr "Před"

msgid "Prepend"
msgstr "Připojit na začátek"

msgid "Append"
msgstr "Připojit"

msgid "After"
msgstr "Po"

msgid "Choose the location of the external link icon relative to the link. Before and after will place the graphic outside the link, while append and prepend will place the graphic inside the link."
msgstr "Vyberte umístění ikony externího odkazu vzhledem k odkazu. Volba Před a za umístí obrázek mimo odkaz, zatímco volba Připojit a připojit na začátek umístí obrázek uvnitř odkazu."

msgid "Exclude links with the same primary domain."
msgstr "Vyloučit odkazy se stejnou primární doménou."

msgid "For example, a link from 'www.example.com' to the subdomain of 'my.example.com' would be excluded."
msgstr "Bude např. vyloučen odkaz z 'www.example.com' na poddoménu 'my.example.com'."

msgid "Open external links in a new window or tab."
msgstr "Otevřít externí odkazy v novém okně nebo kartě."

msgid "A link will open in a new window or tab (depending on which web browser is used and how it is configured)."
msgstr "Odkaz se otevře v novém okně nebo kartě (v závislosti na tom, který webový prohlížeč se používá a jak je nakonfigurován)."

msgid "Do not alter links with a default target value"
msgstr "Neměnit odkazy s výchozí cílovou hodnotou"

msgid "A link that specifies target='_self' will not be changed to target='_blank'."
msgstr "Odkaz, který uvádí target='_self' nebude změněn na target='_blank'."

msgid "Tag external links as \"noreferrer\"."
msgstr "Označte externí odkazy jako \"noreferrer\"."

msgid "Tag external links as \"no follow\"."
msgstr "Označit externí odkazy jako \"no follow\"."

msgid "Do not override rel=\"follow\", if set"
msgstr "Nepřepisovat rel=\"follow\", pokud je nastaveno"

msgid "Display a pop-up warning when any external link is clicked."
msgstr "Zobrazit automaticky otevírané okno s varováním, když klepnete na jakýkoli externí odkaz."

msgid "Text to display in the pop-up warning box."
msgstr "Text, který se zobrazí v automaticky otevíraném okně."

msgid "Text to display in the pop-up external link warning box."
msgstr "Text se zobrazí ve vyskakovacím okně externího odkazu jako varování."

msgid "Whitelisted domains."
msgstr "Seznam povolených domén."

msgid "Enter a line-separated list of whitelisted domains (ie \"example.com\")."
msgstr "Zadejte seznam povolených domén oddělených řádkem (např. \"example.com\")."

msgid "Matches example.com."
msgstr "Odpovídá example.com."

msgid "Multiple patterns can be strung together by using a pipe. Matches example.com OR example.net."
msgstr "Mnohonásobné vzorky mohou být svázány dohromady pomocí roury (svislé čáry |). Odpovídá example.com OR example.net."

msgid "Matches links that go through the <a target=\"Links-module\" href=\"http://drupal.org/project/links\">Links module</a> redirect."
msgstr "Najde odpovídající odkazy, které procházejí přesměrováním v <a target=\"Links-module\" href=\"http://drupal.org/project/links\">modulu Odkazy</a>."

msgid "Matches any character."
msgstr "Odpovídá nějakému znaku."

msgid "The previous character or set is optional."
msgstr "Předchozí znak nebo sada jsou nepovinné."

msgid "Matches any digit (0-9)."
msgstr "Odpovídá nějaké číslici (0-9)."

msgid "Brackets may be used to match a custom set of characters. This matches any alphabetic letter."
msgstr "Závorky mohou být použity k porovnání vlastní skupiny znaků. To odpovídá jakémukoli znaku abecedy."

msgid "Pattern matching."
msgstr "Shoda dle vzoru."

msgid "External links uses patterns (regular expressions) to match the \"href\" property of links."
msgstr "Externí odkazy používají vzorky (regulární výrazy) pro porovnání vlastnosti \"href\" odkazů."

msgid "Here are some common patterns."
msgstr "Zde je několik častých vzorků."

msgid "Common special characters:"
msgstr "Časté speciální znaky:"

msgid "All special characters (<code>@characters</code>) must also be escaped with backslashes. Patterns are not case-sensitive. Any <a target=\"pattern supported by JavaScript\" href=\"http://www.javascriptkit.com/javatutors/redev2.shtml\">pattern supported by JavaScript</a> may be used."
msgstr "Všechny speciální znaky (<code>@characters</code>) musí být také uvozeny zpětnými lomítky. Vzory nerozlišují malá a velká písmena. Použít lze jakýkoli <a target=\"pattern supported by JavaScript\" href=\"http://www.javascriptkit.com/javatutors/redev2.shtml\">vzor podporovaný skriptem JavaScript</a>."

msgid "Exclude links matching the pattern."
msgstr "Vyloučit odkazy shodující se se vzorem."

msgid "Enter a regular expression for links that you wish to exclude from being considered external."
msgstr "Zadejte regulární výraz pro odkazy, které si přejete vyloučit z odkazů považovaných za externí."

msgid "Include links matching the pattern."
msgstr "Zahrnout odkazy odpovídající vzoru."

msgid "Enter a regular expression for internal links that you wish to be considered external."
msgstr "Zadejte regulární výraz pro interní odkazy, které si přejete považovat za externí."

msgid "CSS Matching."
msgstr "Přizpůsobení CSS."

msgid "Use CSS selectors to exclude entirely or only look inside explicitly specified classes and IDs for external links.  These will be passed straight to jQuery for matching."
msgstr "Použijte selektory CSS k úplnému vyloučení nebo pouze vyhledávání v explicitně zadaných třídách a ID pro externí odkazy. Ty budou předány pro přizpůsobení přímo do jQuery."

msgid "Exclude links inside these CSS selectors."
msgstr "Vyloučit odkazy uvnitř těchto selektorů CSS."

msgid "Enter a comma-separated list of CSS selectors (ie \"#block-block-2 .content, ul.menu\")."
msgstr "Zadejte seznam selektorů CSS oddělených čárkami (např. \"#block-block-2 .content, ul.menu\")."

msgid "Only look for links inside these CSS selectors."
msgstr "Hledat pouze odkazy uvnitř těchto selektorů CSS."

