msgid "CDN Warmer"
msgstr "CDN 預熱程式"

msgid "Executes HTTP requests to warm the edge caches. It is useful without a CDN as well, as it will also warm Varnish and Page Cache."
msgstr "執行 HTTP 要求以對邊緣快取進行預熱。 沒有 CDN 也很有用，因為它還會對 Varnish 及頁面快取進行預熱。"

msgid "URLs"
msgstr "URL"

msgid "Enter the list of URLs. One on each line. Examples: https://example.org/foo/bar, /foo/bar."
msgstr "輸入 URL 清單。 每行各一個。 範例：https://example.org/foo/bar, /foo/bar。"

msgid "Headers"
msgstr "標題"

msgid "Specific headers to use when making HTTP requests. Format: <code>Header-Name: value1; value2</code>"
msgstr "發出 HTTP 要求時要使用的特定標頭。格式：<code>Header-Name: value1; value2</code>"

msgid "Enable SSL verification"
msgstr "啟用 SSL 驗證"

msgid "Enable SSL verification. Recommended to keep it checked for security reasons."
msgstr "啟用 SSL 驗證。 基於安全考量，建議將其保持為已勾選。"

msgid "Maximum number of concurrent Requests."
msgstr "並行要求數目上限。"

msgid "The maximum number of concurrent requests."
msgstr "並行要求數目上限。"

msgid "CDN"
msgstr "CDN"

msgid "minPriority should be a float between 0 and 1."
msgstr "minPriority 應該是介於 0 與 1 之間的浮點。"

msgid "Sitemaps"
msgstr "網站地圖"

msgid "Enter the list of sitemap URLs. One on each line. Examples: https://example.org/sitemap.xml, /drupal-sitemap.xml."
msgstr "輸入網站地圖 URL 的清單。 每行各一個。 範例：https://example.org/sitemap.xml, /drupal-sitemap.xml。"

msgid "Minimum Priority"
msgstr "最低優先順序"

msgid "URLs with a lower priority than the configured will not be warmed. A float value between 0 and 1."
msgstr "將不會對優先順序低於所配置優先順序的 URL 進行預熱。 介於 0 與 1 之間的浮點值。"

msgid "This defines the maximum number of concurrent requests."
msgstr "這會定義並行要求的數目上限。"

msgid "There was an error parsing the Sitemap in %location. Please check the watchdog logs for more information."
msgstr "剖析 %location 中的網站地圖時發生錯誤。 如需相關資訊，請檢查監視器日誌。"

msgid "CDN via Sitemap"
msgstr "透過網站地圖的 CDN"

msgid "Collects the URLs to warm from the sitemap. Then uses the CDN warmer for those."
msgstr "從網站地圖中收集要預熱的 URL。 然後，針對其使用 CDN 預熱程式。"

msgid "All headers must have a colon. Follow the format: <code>the-name: the-value</code>"
msgstr "所有標頭皆必須具有冒號。遵循下列格式： <code>the-name: the-value</code>"

