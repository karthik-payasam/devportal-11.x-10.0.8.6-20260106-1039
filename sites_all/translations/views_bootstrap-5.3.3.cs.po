msgid "@style style will not display without the \"@field\" setting."
msgstr "Styl @style se nezobrazí bez nastavení \"@field\". "

msgid "About"
msgstr "Popis"

msgid "The <a href=\":bootstrap\">Views Bootstrap module</a> adds styles to Views to output the results of a view as several common <a href=\":components\">Twitter Bootstrap</a> components."
msgstr "<a href=\":bootstrap\">Modul Pohledy Bootstrap</a> přidává styly do pohledů za účelem zobrazování výsledků pohledu formou několika běžných komponent <a href=\":components\">Twitter Bootstrap</a>."

msgid "Uses"
msgstr "Použití"

msgid "<a href=\":views\">Create a view</a> using one of the following styles:"
msgstr "<a href=\":views\">Vytvořte pohled</a> pomocí následujících stylů."

msgid "<a href=\":docs\">Accordion</a>"
msgstr "<a href=\":docs\">Harmonika</a>"

msgid "<a href=\":docs\">Cards</a>"
msgstr "<a href=\":docs\">Karty</a>"

msgid "<a href=\":docs\">Carousel</a>"
msgstr "<a href=\":docs\">Karusel</a>"

msgid "<a href=\":docs\">Dropdown</a>"
msgstr "<a href=\":docs\">Rozevírací seznam</a>"

msgid "<a href=\":docs\">Grid</a>"
msgstr "<a href=\":docs\">Mřížka</a>"

msgid "<a href=\":docs\">Thumbnails</a>"
msgstr "<a href=\":docs\">Miniatury</a>"

msgid "<a href=\":docs\">Tables</a>"
msgstr "<a href=\":docs\">Tabulky</a>"

msgid "<a href=\":docs\">Tabs</a>"
msgstr "<a href=\":docs\">Karty</a>"

msgid "<a href=\":docs\">Media object</a>"
msgstr "<a href=\":docs\">Objekt médií</a>"

msgid "<a href=\":docs\">List group</a>"
msgstr "<a href=\":docs\">Skupina seznamů</a>"

msgid "Views Bootstrap"
msgstr "Pohledy Bootstrap"

msgid "Views Twitter Bootstrap Components."
msgstr "Zobrazuje komponenty Twitter Bootstrap."

msgid "Views"
msgstr "Views"

msgid "The Bootstrap accordion displays content in collapsible panels (<a href=\":docs\">see documentation</a>)."
msgstr "Harmonika Bootstrap zobrazuje obsah ve sbalitelných panelech (<a href=\":docs\">viz dokumentace</a>)."

msgid "Panel title field"
msgstr "Pole Název panelu"

msgid "Select the field that will be used as the accordion panel titles."
msgstr "Vyberte pole, které bude použito jako názvy panelu harmoniky."

msgid "Label field"
msgstr "Pole popisku"

msgid "- None -"
msgstr "- Nic -"

msgid "Select the field that will be used as the label."
msgstr "Vyberte pole, jež bude používáno jako popisek."

msgid "Collapse Options"
msgstr "Sbalit volby"

msgid "All Items Closed"
msgstr "Všechny uzavřené položky"

msgid "First Item Open"
msgstr "První otevřená položka"

msgid "All Items Open"
msgstr "Všechny otevřené položky"

msgid "Default panel state for collapse behavior."
msgstr "Výchozí stav panelu pro sbalené chování."

msgid "Bootstrap Accordion"
msgstr "Harmonika Bootstrap"

msgid "Displays rows in a Bootstrap Accordion."
msgstr "Zobrazuje řádky v harmonice Bootstrap. "

msgid "Card title field"
msgstr "Pole titulku karty"

msgid "Select the field that will be used for the card title."
msgstr "Vyberte pole, které bude použito pro titulek karty."

msgid "Card content field"
msgstr "Pole obsahu karty"

msgid "Select the field that will be used for the card content."
msgstr "Vyberte pole, které bude použito pro obsah karty."

msgid "Card image field"
msgstr "Pole s obrázkem karty"

msgid "Select the field that will be used for the card image."
msgstr "Vyberte pole, které bude použito pro obrázek karty."

msgid "Custom card group class"
msgstr "Vlastní třída skupin karet"

msgid "Additional classes to provide on the card group. Separated by a space."
msgstr "Další třídy, které se mají poskytnout ve skupině karet. Odděleno mezerou."

msgid "Additional classes to provide on each card. Separated by a space."
msgstr "Další třídy, které se mají poskytnout na každé kartě. Odděleno mezerou."

msgid "Bootstrap Cards"
msgstr "Karty Bootstrap"

msgid "Displays rows in a Bootstrap Card Group layout"
msgstr "Zobrazuje řádky v rozvržení seskupení karty Bootstrap"

msgid "The Bootstrap carousel displays content as a slideshow (<a href=\":docs\">see documentation</a>)."
msgstr "Karusel Bootstrap zobrazuje obsah jako prezentaci (<a href=\":docs\">viz dokumentace</a>)."

msgid "<None>"
msgstr "<Nic>"

msgid "Interval"
msgstr "Interval"

msgid "The amount of time to delay between automatically cycling an item. If false, carousel will not automatically cycle."
msgstr "Délka prodlevy mezi automatickým pootočením položek. Je-li zadána hodnota false, karusel se nebude automaticky otáčet. "

msgid "Show navigation"
msgstr "Zobrazit navigaci"

msgid "Show indicators"
msgstr "Zobrazit indikátory"

msgid "Pause on hover"
msgstr "Pozastavit při podržení ukazatele"

msgid "Pauses the cycling of the carousel on mouseenter and resumes the cycling of the carousel on mouseleave."
msgstr "Pozastaví otáčení karuselu při podržení ukazatele nad prvkem a obnoví otáčení při odstranění ukazatele myši z prvku. "

msgid "Wrap"
msgstr "Otáčet"

msgid "The carousel should cycle continuously or have hard stops."
msgstr "Karusel se otáčí nepřetržitě nebo se zastavuje. "

msgid "Columns"
msgstr "Sloupce"

msgid "The number of columns to include in the carousel."
msgstr "Počet sloupců, které se mají zahrnout do karuselu."

msgid "Breakpoints"
msgstr "Zarážky"

msgid "The min-width breakpoint of the multicolumn carousel."
msgstr "Zarážka minimální šířky pro karusel s více sloupci."

msgid "Extra Small"
msgstr "Velmi malá"

msgid "Small"
msgstr "Malý"

msgid "Medium"
msgstr "Střední"

msgid "Large"
msgstr "Velký"

msgid "Display"
msgstr "Zobrazit"

msgid "Select by fields"
msgstr "Vybrat podle polí"

msgid "Display fields as row content"
msgstr "Zobrazit pole jako obsah řádku"

msgid "Displaying fields as row content will output the field rows as unformatted values within each carousel item."
msgstr "Zobrazení polí jako obsahu řádku vytvoří výstup řádků polí jako neformátované hodnoty v rámci každé položky karuselu."

msgid "Image"
msgstr "Obrázek"

msgid "Title"
msgstr "Nadpis"

msgid "Description"
msgstr "Popis"

msgid "Bootstrap Carousel"
msgstr "Karusel Bootstrap"

msgid "Displays rows in a Bootstrap Carousel."
msgstr "Zobrazuje řádky v karuselu Bootstrap. "

msgid "The Bootstrap dropdown style displays a list of links in a drop-down menu format (<a href=\":docs\">see documentation</a>)."
msgstr "Rozevírací nabídka stylu Bootstrap zobrazuje seznam odkazů ve formátu rozevírací nabídky (<a href=\":docs\">viz dokumentace</a>)."

msgid "Button text"
msgstr "Text tlačítka"

msgid "Text label for the button that is the drop-down toggle."
msgstr "Textový popisek pro tlačítko, které je přepínací rozevírací seznam."

msgid "Button class"
msgstr "Třída tlačítka"

msgid "Classes for the button that is the drop-down toggle."
msgstr "Třídy pro tlačítko, které je přepínací rozevírací seznam."

msgid "Default"
msgstr "Výchozí"

msgid "Primary"
msgstr "Primární"

msgid "Success"
msgstr "Úspěšně dokončeno"

msgid "Info"
msgstr "Info"

msgid "Warning"
msgstr "Varování"

msgid "Danger"
msgstr "Nebezpečí"

msgid "Wrapper class"
msgstr "Obalovací třída"

msgid "The class to provide on the wrapper, outside the list."
msgstr "Třída, která má být poskytnuta v modulu wrapper, mimo seznam."

msgid "List class"
msgstr "Třída seznamu"

msgid "The class to provide on the list element itself."
msgstr "Třída, která se má poskytnout na samotném prvku seznamu."

msgid "Bootstrap Dropdown"
msgstr "Rozevírací nabídka Bootstrap"

msgid "Displays rows in a Bootstrap Dropdown."
msgstr "Zobrazuje řádky v rozevíracím seznamu Bootstrap."

msgid "The Bootstrap grid displays content in a responsive, mobile first fluid grid (<a href=\":docs\">see documentation</a>)."
msgstr "Mřížka Bootstrap zobrazuje obsah v responzivní, fluidní mřížce typu mobile first (<a href=\":docs\">viz dokumentace</a>)."

msgid "Alignment"
msgstr "Zarovnání"

msgid "Horizontal"
msgstr "Vodorovný"

msgid "Vertical"
msgstr "Svislý"

msgid ""
"Horizontal alignment will place items starting in the upper left and moving right.\n"
"      Vertical alignment will place items starting in the upper left and moving down."
msgstr ""
"Vodorovné zarovnání umístí položky počínaje levým horním rohem a bude s pohybovat doprava.\n"
"      Svislé uspořádání umístí položky počínaje levým horním rohem a bude se pohybovat dolů."

msgid "Default column classes"
msgstr "Výchozí třídy sloupců"

msgid "Add the default views column classes like views-col, col-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Přidejte výchozí třídy sloupců pohledů, jako např. views-col, col-1 a clearfix, do výstupu. Toho lze využít k rychlému snížení počtu markupů standardně poskytovaných pohledem, ale za cenu obtížnějšího aplikování stylů CSS."

msgid "Custom column class"
msgstr "Vlastní třída sloupce"

msgid "Additional classes to provide on each column. Separated by a space."
msgstr "Další třídy, které se mají poskytnout v každém sloupci. Odděleno mezerou."

msgid "You may use field tokens from as per the \"Replacement patterns\" used in \"Rewrite the output of this field\" for all fields."
msgstr "Pro všechna pole můžete použít tokeny polí jako \"Náhradní vzory\" použité ve volbě \"Přepsat výstup tohoto pole\"."

msgid "Default row classes"
msgstr "Výchozí třídy řádků"

msgid "Adds the default views row classes like views-row, row-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Přidává výchozí třídy řádků pohledů, jako např. views-row, row-1 a clearfix, do výstupu. Toho lze využít k rychlému snížení počtu markupů standardně poskytovaných pohledem, ale za cenu obtížnějšího aplikování stylů CSS."

msgid "Custom row class"
msgstr "Vlastní třída řádků"

msgid "Additional classes to provide on each row. Separated by a space."
msgstr "Další třídy, které se mají poskytnout v každém řádku. Odděleno mezerou."

msgid "Base number of columns"
msgstr "Základní počet sloupců"

msgid "all"
msgstr "vše"

msgid "Choose the number of columns that views will wrap in a single row. This will be reflected in the HTML structure rendered regardless of the device size. If selecting \"all\" then use the alternative template."
msgstr "Vyberte, kolik sloupců pohledy zabalí do jednoho řádku. To se odrazí ve vykreslované struktuře HTML, bez ohledu na velikost zařízení. Vyberete-li volbu \"vše\", použijte alternativní šablonu."

msgid "Number of columns (col-@size)"
msgstr "Počet sloupců (col-@size)"

msgid "This adds col-@size to the div."
msgstr "Tím se přidá col-@size do div."

msgid "Bootstrap Grid"
msgstr "Mřížka Bootstrap"

msgid "Displays rows in a Bootstrap Grid layout"
msgstr "Zobrazuje řádky v rozvržení Mřížka Bootstrap"

msgid "The Bootstrap list group displays content in an unordered list with list group classes (<a href=\":docs\">see documentation</a>)."
msgstr "Skupina seznamů Bootstrap zobrazuje obsah v neřazeném seznamu s třídami skupin seznamu (<a href=\":docs\">viz dokumentace</a>)."

msgid "Set group field in panel heading"
msgstr "Nastavit pole skupiny v záhlaví panelu"

msgid "Title field"
msgstr "Pole titulku"

msgid "Select the field that will be used as the title."
msgstr "Vyberte pole, jež bude používáno jako název. "

msgid "Bootstrap List Group"
msgstr "Skupina seznamů Bootstrap"

msgid "Displays rows in a Bootstrap List Group."
msgstr "Zobrazuje řádky ve skupině seznamů Bootstrap. "

msgid "The Bootstrap media object displays content with an image item lead with heading and text (<a href=\":docs\">see documentation</a>)."
msgstr "Objekt médií Bootstrap zobrazuje obsah s úvodní položkou obrázku a se záhlavím a textem (<a href=\":docs\">viz dokumentace</a>)."

msgid "Heading field"
msgstr "Pole Záhlaví"

msgid "Select the field that will be used as the media object heading. Exclude this field from display to prevent duplication."
msgstr "Vyberte pole, které se bude používat jako záhlaví objekt médií. Vylučte toto pole ze zobrazení pro zabránění duplikace."

msgid "Image field"
msgstr "Pole s obrázkem"

msgid "Select the field that will be used as the media object image. Exclude this field from display to prevent duplication."
msgstr "Vyberte pole, které se bude používat jako obrázek objektu médií. Vylučte toto pole ze zobrazení pro zabránění duplikace."

msgid "Body field"
msgstr "Pole obsahu"

msgid "All fields that are not excluded from display will be shown as the body."
msgstr "Všechna pole, která nejsou vyloučena ze zobrazení, budou zobrazena jako tělo."

msgid "Image Alignment"
msgstr "Zarovnání obrázku"

msgid "Left"
msgstr "Left"

msgid "Right"
msgstr "Right"

msgid "Middle"
msgstr "Na střed"

msgid "Align the media object image left or right."
msgstr "Zarovnejte obrázek mediálního objektu vlevo nebo vpravo. "

msgid "Bootstrap Media Object"
msgstr "Mediální objekt Bootstrap"

msgid "Displays rows in a Bootstrap Media Object."
msgstr "Zobrazuje řádky v mediálním objektu Bootstrap. "

msgid "The Bootstrap panels displays content in a box with optional header and footer elements (<a href=\":docs\">see documentation</a>)."
msgstr "Panely Bootstrap zobrazují obsah v rámečku s volitelnými prvky záhlaví a zápatí (<a href=\":docs\">viz dokumentace</a>)."

msgid "Contextual class"
msgstr "Kontextová třída"

msgid "<a href=\":docs\">see Bootstrap documentation</a>"
msgstr "<a href=\":docs\">viz dokumentace Bootstrap</a>"

msgid "Select the field that will be used as the panel heading titles."
msgstr "Vyberte pole, které bude použito jako titulky záhlaví panelu."

msgid "Panel footer field"
msgstr "Pole zápatí panelu"

msgid "Select the field that will be used as the panel footer."
msgstr "Vyberte pole, které bude použito jako zápatí panelu."

msgid "Bootstrap Panels"
msgstr "Panely Bootstrap"

msgid "Displays rows in a Bootstrap Panel."
msgstr "Zobrazuje řádky v panelu Bootstrap."

msgid "The Bootstrap tabs displays content with tab titles linked to dynamically displayed content (<a href=\":docs\">see documentation</a>)."
msgstr "Karty Bootstrap zobrazují obsah s titulky karet propojenými s dynamicky zobrazeným obsahem (<a href=\":docs\">viz dokumentace</a>)."

msgid "Tab field"
msgstr "Pole karta"

msgid "Select the field that will be used as the tab."
msgstr "Vyberte pole, které se bude používat jako karta. "

msgid "Tab Type"
msgstr "Typ karty"

msgid "Tabs"
msgstr "Záložky"

msgid "Pills"
msgstr "Tablety"

msgid "List"
msgstr "Seznam"

msgid "Position of tabs"
msgstr "Pozice karet"

msgid "Tabs/pills on the top"
msgstr "Karty/pilulky nahoře"

msgid "Tabs/pills on the left"
msgstr "Karty/pilulky vlevo"

msgid "Tabs/pills on the right"
msgstr "Karty/pilulky vpravo"

msgid "Tabs/pills on the bottom"
msgstr "Karty/pilulky dole"

msgid "Tabs/pills justified on the top"
msgstr "Karty/pilulky zarovnané nahoře"

msgid "Tabs/pills stacked"
msgstr "Karty/pilulky skládané"

msgid "Fade Effect"
msgstr "Efekt vyblednutí"

msgid "Add a fade in effect when tabs clicked"
msgstr "Přidat efekt vyblednutí při klepnutí na karty"

msgid "Bootstrap Tabs"
msgstr "Karty Bootstrap"

msgid "Displays rows in Bootstrap Tabs."
msgstr "Zobrazuje řádky na kartě Bootstrap. "

msgid "The Bootstrap table style adds default Bootstrap table classes and optional classes (<a href=\":docs\">see documentation</a>)."
msgstr "Styl tabulky Bootstrap přidá výchozí třídy tabulky Bootstrap a volitelné třídy (<a href=\":docs\">viz dokumentace</a>)."

msgid "Responsive"
msgstr "Responzivní"

msgid "To make a table scroll horizontally on small devices."
msgstr "Pro vodorovné posouvání tabulky na malých zařízeních. "

msgid "Bootstrap styles"
msgstr "Styly Bootstrap"

msgid "Striped"
msgstr "Pruhovaný"

msgid "Bordered"
msgstr "S okrajem"

msgid "Hover"
msgstr "Řádek pod ukazatelem"

msgid "Condensed"
msgstr "Zhuštěný"

msgid "Caption for the table"
msgstr "Popisek pro tabulku"

msgid "A title semantically associated with your table for increased accessibility."
msgstr "Nadpis sémanticky přidružený k tabulce pro zvýšené usnadnění přístupu."

msgid "Table details"
msgstr "Podrobnosti tabulky"

msgid "Summary title"
msgstr "Titulek souhrnu"

msgid "Table description"
msgstr "Popis tabulky"

msgid "Provide additional details about the table to increase accessibility."
msgstr "Poskytněte další podrobnosti o tabulce pro zvýšení usnadnění přístupu."

msgid "Bootstrap Table"
msgstr "Tabulka Bootstrap"

msgid "Displays rows in a Bootstrap table."
msgstr "Zobrazuje řádky v tabulce Bootstrap. "

msgid "The Bootstrap thumbnails extends the grid display with the thumbnail component to showcase linked images (<a href=\":docs\">see documentation</a>)."
msgstr "Miniatury Bootstrap rozšiřují mřížku o komponentu miniatur pro zobrazení propojených obrázků (<a href=\":docs\">viz dokumentace</a>)."

msgid "Bootstrap Thumbnails"
msgstr "Miniatury Bootstrap"

msgid "Displays rows in a Bootstrap Grid layout with thumbnails"
msgstr "Zobrazuje řádky v rozvržení Mřížka Bootstrap s miniaturami"

msgid "Previous"
msgstr "Předchozí"

msgid "Next"
msgstr "Další"

