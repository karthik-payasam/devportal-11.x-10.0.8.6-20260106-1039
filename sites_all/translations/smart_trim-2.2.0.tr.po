msgid "About"
msgstr "Hakkında"

msgid "Smart Trim implements a new field formatter for text fields (text, text_long, and text_with_summary, if you want to get technical) that improves upon the \"Summary or Trimmed\" formatter."
msgstr "Akıllı Kırpma, \"Özet ya da Kırpılmış\" biçimlendiricisi ile iyileştirilen metin alanları (teknik olarak belirtmek gerekirse, text, text_long ve text_with_summary) için yeni bir alan biçimlendirici uygular."

msgid "More"
msgstr "Devamı"

msgid "Read more about [node:title]"
msgstr "[node:title] hakkında daha fazla bilgi edinin"

msgid "Smart Trim"
msgstr "Akıllı Kırpma"

msgid "Provides a more robust alternative to \"summary or trimmed\" textfield format"
msgstr "\"Özet ya da kırpılmış\" metin alanı biçimine daha sağlam bir alternatif sağlar"

msgid "Fields"
msgstr "Alanlar"

msgid "Smart trim formatter settings"
msgstr "Akıllı kırpma biçimlendiricisi ayarları"

msgid "Trim length"
msgstr "Kırpma uzunluğu"

msgid "Trim units"
msgstr "Kırpma birimleri"

msgid "Suffix"
msgstr "Son ek"

msgid "Wrap trimmed content"
msgstr "Kırpılmış içeriği kaydır"

msgid "Wrapped content class"
msgstr "Kaydırılmış içerik sınıfı"

msgid "More link configuration"
msgstr "Diğer bağlantısı yapılandırması"

msgid "Display more link"
msgstr "Daha fazla bağlantı görüntüle"

msgid "Open link in new window"
msgstr "Bağlantıyı yeni sayfada aç"

msgid "More link only when content is trimmed"
msgstr "Yalnızca içerik kırpıldığında diğer bağlantısı"

msgid "More link class"
msgstr "Diğer bağlantı sınıfı"

msgid "More link text"
msgstr "Daha fazla bağlantı metni"

msgid "More link aria-label value"
msgstr "Daha fazla bağlantı aria-etiket değeri"

msgid "Summary handler"
msgstr "Özet işleyici"

msgid "Additional options"
msgstr "Ek seçenekler"

msgid "Strip HTML"
msgstr "HTML ayır"

msgid "Honor a zero trim length"
msgstr "Sıfır kırpma uzunluğunu kabul et"

msgid "Replace tokens before trimming"
msgstr "Kırpma işleminden önce belirteçleri değiştir"

msgid "Characters"
msgstr "Karakterler"

msgid "Words"
msgstr "Sözcükler"

msgid "Summary"
msgstr "Özet"

msgid "Use summary if present, and do not trim"
msgstr "Varsa özeti kullan ve kırpma"

msgid "Use summary if present, honor trim settings"
msgstr "Varsa özeti kullan, kırpma ayarlarını kabul et"

msgid "Do not use summary"
msgstr "Özeti kullanma"

msgid "Wrap trimmed content?"
msgstr "Kırpılmış içerik kaydırılsın mı?"

msgid "Adds a wrapper div to trimmed content. This option is deprecated and will be removed in Smart Trim 3.0.0. Please override the smart-trim.html.twig template file to customize output."
msgstr "Kırpılmış içeriğe bir kaydırıcı bölümü ekler. Bu seçenek kullanımdan kaldırılmıştır ve Smart Trim 3.0.0'da tamamen kaldırılacaktır. Lütfen çıkışı özelleştirmek için smart-trim.html.twig şablon dosyasını geçersiz kılın."

msgid "Wrapped content class."
msgstr "Kaydırılmış içerik sınıfı."

msgid "If wrapping, define the class name here."
msgstr "Kaydırılıyorsa, burada sınıf adını tanımlayın."

msgid "<em>More</em> link"
msgstr "<em>Diğer</em> bağlantısı"

msgid "Display <em>More</em> link?"
msgstr "<em>Diğer</em> bağlantısı görüntülensin mi?"

msgid "Displays a link to the entity (if one exists)"
msgstr "Varlığın bir bağlantısını (varsa) görüntüler"

msgid "Display <em>More</em> link only when content is trimmed?"
msgstr "<em>Diğer</em> bağlantısı yalnızca içerik kırpıldığında görüntülensin mi?"

msgid "Only display <em>More</em> link if content is actually trimmed."
msgstr "<em>Diğer</em> bağlantısını yalnızca ierik gerçekten kırpılırsa görüntüle."

msgid "Open <em>More</em> link in new window"
msgstr "<em>Diğer</em> bağlantısını yeni pencerede aç"

msgid "<em>More</em> link text"
msgstr "<em>Diğer</em> bağlantısı metni"

msgid "If displaying <em>More</em> link, enter the text for the link. This field supports tokens."
msgstr "<em>Diğer</em> bağlantısı görüntüleniyorsa, bağlantıya ilişkin metni girin. Bu alanda belirteçler (tokens) desteklenir."

msgid "<em>More</em> link aria-label"
msgstr "<em>Diğer</em> bağlantısı aria-label"

msgid "If displaying <em>More</em> link, provide additional context for screen-reader users. In most cases, the aria-label value will be announced instead of the link text. This field supports tokens."
msgstr "<em>Diğer</em> bağlantısı görüntüleniyorsa, ekran okuyucu kullanıcıları için ek bağlam sağlayın. Çoğu durumda, bağlantı metni yerine aria etiketi değeri duyurulacaktır. Bu alanda belirteçler (tokens) desteklenir."

msgid "<em>More</em> link class"
msgstr "<em>Diğer</em> bağlantı sınıfı"

msgid "If displaying <em>More</em> link, add a custom class for formatting."
msgstr "<em>Diğer</em> bağlantısı görüntüleniyorsa, biçimlendirme için özel bir sınıf ekleyin."

msgid "words"
msgstr "sözcükler"

msgid "characters"
msgstr "karakterler"

msgid "Suffix: %suffix"
msgstr "Sonek: %suffix"

msgid "<em>More</em> link enabled, text: %text"
msgstr "<em>Diğer</em> bağlantısı etkinleştirildi, metin: %text"

msgid "Only display <em>More</em> link when trimmed"
msgstr "<em>Diğer</em> bağlantısını yalnızca kırpıldığında görüntüle"

msgid "<em>More</em> link aria-label: %label"
msgstr "<em>Diğer</em> bağlantısı aria-label: %label"

msgid "<em>More</em> link class: %class"
msgstr "<em>Diğer</em> bağlantı sınıfı: %class"

msgid "Smart trimmed"
msgstr "Akıllı kırpılmış"

