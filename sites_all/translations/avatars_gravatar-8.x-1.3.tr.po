msgid "Gravatar"
msgstr "Gravatar"

msgid "Adds Gravatar.com avatar generators for Avatar Kit."
msgstr "Avatar Kiti için Gravatar.com avatar oluşturucuları ekler."

msgid "Avatars"
msgstr "Avatarlar"

msgid "Maximum content rating"
msgstr "İçerik derecelendirmesi üst sınırı"

msgid "Gravatar generator"
msgstr "Gravatar oluşturucu"

msgid "Type"
msgstr "Tip"

msgid "Unrestricted"
msgstr "Kısıtlamasız"

msgid "G: suitable for display on all websites with any audience type."
msgstr "G: Herhangi tipte bir hedef kitlesi olan tüm web sitelerinde görüntülenmeye uygundur."

msgid "PG: may contain rude gestures, provocatively dressed individuals, the lesser swear words, or mild violence."
msgstr "PG: Kaba hareketler, kışkırtıcı giyimli bireyler, daha az küfür ya da hafif şiddet içerebilir."

msgid "R: may contain such things as harsh profanity, intense violence, nudity, or hard drug use."
msgstr "R: Sert küfür, yoğun şiddet, çıplaklık ya da yoğun uyuşturucu kullanımı gibi şeyler içerebilir."

msgid "X: may contain hardcore sexual imagery or extremely disturbing violence."
msgstr "X: Sert porno görüntüler veya son derece rahatsız edici şiddet içerebilir."

msgid "Maximum rating: @maximum_rating"
msgstr "Derecelendirme üst sınırı: @maximum_rating"

msgid "Universal avatar uploaded to Gravatar.com"
msgstr "Gravatar.com'a yüklenen evrensel avatar."

msgid "Identicon"
msgstr "Identicon"

msgid "Monster ID"
msgstr "Monster ID"

msgid "Wavatar"
msgstr "Wavatar"

msgid "8-bit style avatar"
msgstr "8 bit stilinde avatar"

msgid "Missing Configuration"
msgstr "Eksik Yapılandırma"

msgid "Type: @type"
msgstr "Tip: @type"

msgid "Identicon, MonsterID, Retro, and Wavatar avatar generators."
msgstr "Identicon, MonsterID, Retro ve Wavatar avatar oluşturucuları."

