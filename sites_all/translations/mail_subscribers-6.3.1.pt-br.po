msgstr "Enviado e-mail para proprietários que assinam o produto %product"

msgid "Sent email to members subscribing to product %product"
msgstr "Enviado e-mail para membros que assinam o produto %product"

msgid "Sent email to owners subscribing to API %api"
msgstr "Enviado e-mail para proprietários que assinam a API %api"

msgid "Sent email to members subscribing to API %api"
msgstr "Enviado e-mail para membros que assinam a API %api"

msgid "Sent email to all consumer organization owners"
msgstr "E-mail enviado para todos os proprietários da organização do consumidor"

msgid "Sent email to all consumer organization members"
msgstr "E-mail enviado para todos os membros da organização do consumidor"

