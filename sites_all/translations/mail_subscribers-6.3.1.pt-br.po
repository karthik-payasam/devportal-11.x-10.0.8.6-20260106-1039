msgstr "Não foi localizado um objeto de usuário para o destinatário @to. Nenhum token do usuário no assunto ou no corpo da mensagem será substituído"

msgid "Did not find a plan with the name @plan in the product @product"
msgstr "Não foi localizado um plano com o nome @plan no produto @product"

