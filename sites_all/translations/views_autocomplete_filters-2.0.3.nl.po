msgid "Views Autocomplete Filters"
msgstr "Autocomplete-filters voor views"

msgid "Use Autocomplete for string field filters."
msgstr "Autocomplete gebruiken voor filters van tekenreeksvelden."

msgid "Views"
msgstr "Overzichten"

msgid "Autocomplete for Combine fields filter"
msgstr "Autocomplete voor filter Velden combineren"

msgid "Exposed"
msgstr "Zichtbaar gemaakt"

msgid "Use Autocomplete"
msgstr "Autocomplete gebruiken"

msgid "Minimum number of characters to start filter"
msgstr "Minimum aantal tekens om filter te starten"

msgid "Maximum number of items in Autocomplete"
msgstr "Maximum aantal items in Autocomplete"

msgid "Field with autocomplete results"
msgstr "Veld met resultaten van Autocomplete"

msgid "Unformatted suggestion"
msgstr "Niet-ingedeelde suggestie"

msgid "Unformatted dropdown"
msgstr "Niet-ingedeelde vervolgkeuze"

msgid "Suggestions depend on other filter fields"
msgstr "Suggesties zijn afhankelijk van andere filtervelden"

msgid "Autocomplete for Search API fulltext search filter"
msgstr "Autocomplete voor filter voor Fulltext Search in Search API"

msgid "Autocomplete for Search API text field filter"
msgstr "Autocomplete voor filter voor tekstvelden in Search API"

msgid "Autocomplete for basic textfield filter"
msgstr "Autocomplete voor filter voor elementaire tekstvelden"

msgid "Field for autocomplete filter %label is not set in view %view, display %display"
msgstr "Veld voor Autocomplete-filter %label is niet ingesteld in view %view, scherm %display"

msgid "Field for autocomplete filter %label not exists in view %view, display %display"
msgstr "Veld voor Autocomplete-filter %label bestaat niet in view %view, scherm %display"

msgid "Use Autocomplete for this filter."
msgstr "Autocomplete gebruiken voor dit filter."

msgid "Enter 0 for no limit."
msgstr "Gebruik 0 voor onbeperkt."

msgid "Autocomplete suggestions will be filtered by other filter fields"
msgstr "Suggesties van Autocomplete worden gefilterd door andere filtervelden"

msgid "The selected field will be used for drop-down results of the autocompletion. In most cases it should be the same field you use for the filter, and <em>must</em> be included in the field list for the view/display in order to appear here."
msgstr "Het geselecteerde veld wordt gebruikt voor de vervolgkeuzeresultaten van de automatische voltooiing. In de meeste gevallen moet dit hetzelfde veld zijn dat u gebruikt voor het filter en <em>moet</em> het worden opgenomen in de veldlijst voor de view/weergave om hier te verschijnen."

msgid "Use unformatted data from database for dropdown list instead of field formatter result. Value will be printed as plain text."
msgstr "Niet-ingedeelde gegevens uit de database gebruiken voor de vervolgkeuzelijst, in plaats van resultaten van Field Formatter. Waarde wordt afgebeeld in de vorm van platte tekst."

msgid "The same as above, but for suggestion (text appearing inside textfield when item is selected)."
msgstr "Hetzelfde als het bovenstaande, maar voor suggestie (tekst die in het tekstveld wordt afgebeeld als er een item geselecteerd is)"

msgid "Add some fields to view"
msgstr "Enkele velden toevoegen aan view"

