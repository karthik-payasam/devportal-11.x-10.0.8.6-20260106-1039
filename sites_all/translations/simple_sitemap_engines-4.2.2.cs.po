msgid "IndexNow notification"
msgstr "Oznámení IndexNow"

msgid "IndexNow notification checkbox"
msgstr "Zaškrtávací políčko oznímení IndexNow"

msgid "Simple XML Sitemap IndexNow"
msgstr "Jednoduchá XML mapa webu IndexNow"

msgid "Verification key in Drupal State"
msgstr "Ověřovací klíč ve stavu Drupal"

msgid "Verification key not available"
msgstr "Ověřovací klíč není k dispozici"

msgid "In order to generate a verification key for the IndexNow service and choose which sitemaps are to be submitted to search engines, visit <a href=\"@url\">this</a> configuration page."
msgstr "Chcete-li vygenerovat ověřovací klíč pro službu IndexNow a vybrat, které mapy webů se mají odeslat do vyhledávacích strojů, navštivte <a href=\"@url\">tuto</a> konfigurační stránku."

msgid "Simple XML Sitemap (Search engines)"
msgstr "Jednoduchá mapu webu XML (vyhledávače)"

msgid "Submits sitemaps to search engines and notifies IndexNow compatible engines about changes to entities."
msgstr "Odešle mapy webů do vyhledávacích strojů a upozorní vyhledávací stroje kompatibilní s IndexNow na změny v entitách."

msgid "SEO"
msgstr "SEO"

msgid "Search engines"
msgstr "Vyhledávače"

msgid "Status"
msgstr "Stav"

msgid "Settings"
msgstr "Nastavení"

msgid "Index entity on save"
msgstr "Entita indexu při ukládání"

msgid "Allows optionally sending a change notice to IndexNow compatible search engines on entity form save."
msgstr "Umožňuje volitelné odeslání oznámení o změně vyhledávacím strojům kompatibilním s IndexNow při uložení formuláře entity."

msgid "Simple XML Sitemap"
msgstr "Jednoduchá mapa webu XML"

msgid "Search engine"
msgstr "Vyhledávač"

msgid "Search engine ID"
msgstr "ID vyhledávače"

msgid "Label"
msgstr "Popisek"

msgid "Submission URL"
msgstr "Adresa URL odeslání"

msgid "IndexNow URL"
msgstr "Adresa URL IndexNow"

msgid "Sitemap variants"
msgstr "Varianty mapy webu"

msgid "Sitemap variant"
msgstr "Varianta mapy webu"

msgid "IndexNow bundle settings"
msgstr "Nastavení balíku IndexNow"

msgid "IndexNow"
msgstr "IndexNow"

msgid "Sitemap search engine submission settings"
msgstr "Nastavení odeslání vyhledávače mapy webu"

msgid "Sitemap submission enabled"
msgstr "Odeslání mapy webu povoleno"

msgid "Sitemap submission frequency"
msgstr "Frekvence odeslání mapy webu"

msgid "IndexNow submission enabled"
msgstr "Odeslání IndexNow povoleno"

msgid "Selected engine for IndexNow submissions"
msgstr "Vybraný stroj pro odeslání IndexNow"

msgid "IndexNow on entity save"
msgstr "IndexNow při uložení entity"

msgid "Sitemap submission status"
msgstr "Stav odeslání mapy webu"

msgid "Name"
msgstr "Název"

msgid "Sitemaps"
msgstr "Mapy webu"

msgid "Last submitted"
msgstr "Poslední odeslání"

msgid "There are no @label yet."
msgstr "Dosud neexistuje žádný @label."

msgid "Submission settings can be configured <a href=\"@url\">here</a>."
msgstr "Nastavení odeslání lze nakonfigurovat <a href=\"@url\">zde</a>."

msgid "Never"
msgstr "Nikdy"

msgid "No search engines supporting sitemap submission have been found."
msgstr "Nebyly nalezeny žádné vyhledávací stroje podporující odeslání mapy webu."

msgid "Sitemap submission is disabled."
msgstr "Odeslání mapy webu je zakázáno."

msgid "IndexNow status"
msgstr "Stav IndexNow"

msgid "The last IndexNow submission was <em>@entity</em> to @engine_label on @time"
msgstr "Poslední odeslání IndexNow bylo <em>@entity</em> do @engine_label v @time"

msgid "IndexNow settings can be configured <a href=\"@url\">here</a>."
msgstr "Nastavení IndexNow lze nakonfigurovat <a href=\"@url\">zde</a>."

msgid "No search engines supporting IndexNow have been found."
msgstr "Nebyly nalezeny žádné vyhledávací stroje podporující IndexNow."

msgid "IndexNow submission is disabled."
msgstr "Odeslání IndexNow je zakázáno."

msgid "Excluded"
msgstr "Vyloučený"

msgid "Sitemap submission settings"
msgstr "Nastavení odeslání mapy webu"

msgid "Submit sitemaps to search engines"
msgstr "Odeslání mapy webu do vyhledávacích strojů"

msgid "This enables/disables sitemap submission; don't forget to choose sitemaps below."
msgstr "Tato vlastnost povolí/zakáže odeslání mapy webu; nezapomeňte vybrat níže uvedené mapy webů."

msgid "Submission interval"
msgstr "Interval odeslání"

msgid "Engines"
msgstr "Stroje"

msgid "Choose which sitemaps are to be submitted to which search engines.<br>Sitemaps can be configured <a href=\"@url\">here</a>."
msgstr "Vyberte, které mapy webů se mají odeslat kterým vyhledávacím strojům.<br>Mapy webů lze nakonfigurovat <a href=\"@url\">zde</a>."

msgid "IndexNow settings"
msgstr "Nastavení IndexNow"

msgid "Submit changes to IndexNow capable engines"
msgstr "Odeslání změn strojům schopným IndexNow"

msgid "Send change notice to IndexNow compatible search engines right after submitting entity forms. Changes include creating, deleting and updating of an entity.<br/>This behaviour can be overridden on entity forms. Don't forget to <a href=\"@inclusion_url\">include entities</a>."
msgstr "Odešlete oznámení o změně vyhledávacím strojům kompatibilním s IndexNow ihned po odeslání formulářů entit. Změny zahrnují vytvoření, odstranění a aktualizaci entity.<br/>Toto chování může být potlačeno na formulářích entit. Nezapomeňte <a href=\"@inclusion_url\">zahrnout entity</a>."

msgid "Preferred IndexNow engine"
msgstr "Upřednostňovaný stroj IndexNow"

msgid "All IndexNow requests will be sent to the engine selected here. Only one engine needs to be notified, as it will notify other IndexNow compatible engines for you.<br/>For the sake of equality of opportunity, <strong>consider leaving this at <em>Random</em></strong>, so a random engine can be picked on each submission."
msgstr "Všechny požadavky IndexNow budou odeslány zde vybranému stroji. Musí být upozorněn pouze jeden stroj, protože informuje ostatní stroje kompatibilní s IndexNow.<br/>V zájmu rovnosti příležitostí <strong>zvažte ponechání této hodnoty jako <em>Náhodné</em></strong>, takže může být při každém odeslání vybrán náhodný stroj."

msgid "Random"
msgstr "Náhodně"

msgid "Index on every entity save operation"
msgstr "Index u každé operace uložení entity"

msgid "If checked, all entity save operations for <a href=\"@inclusion_url\">included entities</a> will trigger notification of IndexNow search engines.<br/>If unchecked, this will only be possible by adding/altering/deleting an entity through a form.<br/>This should be unchecked if there are mass operations performed on entities that are irrelevant to indexing."
msgstr "Je-li tato volba označeno, všechny operace ukládání entit pro <a href=\"@inclusion_url\">zahrnuté entity</a> spustí oznámení pro vyhledávací stroje IndexNow.<br/>Pokud nebude tato volba označena, bude to možné pouze přidáním/nahrazením/odstraněním entity prostřednictvím formuláře.<br/>Tato volba by neměla být označena, pokud existují hromadné operace prováděné na entitách, které jsou nepodstatné pro indexování."

msgid "Remove verification key from state"
msgstr "Odebrat ověřovací klíč ze stavu"

msgid "Generate verification key"
msgstr "Generovat ověřovací klíč"

msgid "The IndexNow verification key is saved in <em>settings.php</em>: @key"
msgstr "Ověřovací klíč IndexNow je uložen v souboru <em>settings.php</em>: @key"

msgid "The IndexNow verification key is defined in <em>Drupal state</em>: @key"
msgstr "Ověřovací klíč IndexNow je definován ve stavu <em>Drupal</em>: @key"

msgid "The IndexNow verification key is saved in <em>Drupal state</em>. Consider defining it in <em>settings.php</em> like so:<br/>@code"
msgstr "Ověřovací klíč IndexNow je uložen ve stavu <em>Drupal</em>. Zvažte možnost jeho definování v souboru <em>settings.php</em>, jako například:<br/>@code"

msgid "The IndexNow verification key is saved in <em>settings.php</em> and can be safely removed from <em>Drupal state</em>."
msgstr "Ověřovací klíč IndexNow je uložen v souboru <em>settings.php</em> a lze jej bezpečně odebrat ze stavu <em>Drupal</em>."

msgid "An IndexNow verification key needs to be generated and optionally added to <em>settings.php</em> in order for IndexNow engines to get notified about changes. This warning only applies to the production environment."
msgstr "Ověřovací klíč IndexNow musí být generován a volitelně přidán do souboru <em>settings.php</em>, aby byly stroje IndexNow upozorněny na změny. Toto varování se vztahuje pouze na produkční prostředí."

msgid "No sitemaps have been selected for submission."
msgstr "Pro odeslání nebyly vybrány žádné položky mapy webů."

msgid "Notify IndexNow search engines of changes <em>now</em>"
msgstr "Oznámit vyhledávacím strojům IndexNow změny <em>nyní</em>"

msgid "Send change notice to IndexNow compatible search engines right after submitting this form."
msgstr "Odešlete oznámení o změně vyhledávacím strojům kompatibilním s IndexNow ihned po odeslání tohoto formuláře."

msgid "Notify IndexNow search engines of changes <em>by default</em>"
msgstr "Oznámit vyhledávacím strojům IndexNow změny <em>standardně</em>"

msgid "Send change notice to IndexNow compatible search engines right after submitting entity forms of this type.<br/>Changes include creating, deleting and updating of an entity. This setting can be overridden on the entity form."
msgstr "Odešlete oznámení o změně vyhledávacím strojům kompatibilním s IndexNow ihned po odeslání formulářů entit tohoto typu.<br/>Změny zahrnují vytvoření, odstranění a aktualizaci entity. Toto nastavení může být potlačeno na formuláři entity."

msgid "Sitemap search engine submission"
msgstr "Odeslání vyhledávače mapy webu"

