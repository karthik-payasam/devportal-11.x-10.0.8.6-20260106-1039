msgid "DropzoneJS entity browser widget"
msgstr "Widget przeglądarki jednostek DropzoneJS"

msgid "DropzoneJS Entity browser widget."
msgstr "Widget przeglądarki jednostek DropzoneJS."

msgid "Media"
msgstr "Multimedia"

msgid "DropzoneJS widget configuration"
msgstr "Konfiguracja widgetu DropzoneJS"

msgid "Submit button text"
msgstr "Tekst przycisku wysyłania"

msgid "Automatically submit selection"
msgstr "Automatycznie wysyłaj wybór"

msgid "Upload location"
msgstr "Miejsce przesyłania"

msgid "Dropzone drag-n-drop zone text"
msgstr "Tekst w strefie przeciągania i upuszczania Dropzone"

msgid "Maximum size of files"
msgstr "Maksymalna wielkość plików"

msgid "Allowed file extensions"
msgstr "Dozwolone rozszerzenia nazw plików"

msgid "Use clientside resize"
msgstr "Użyj zmiany wielkości po stronie klienta"

msgid "Maximum width"
msgstr "Maksymalna szerokość"

msgid "Maximum height"
msgstr "Maksymalna wysokość"

msgid "Resize quality"
msgstr "Jakość zmiany wielkości"

msgid "Method used for resizing"
msgstr "Metoda zmiany wielkości"

msgid "Method used for generating the thumbnail"
msgstr "Metoda generowania miniatury"

msgid "Media Entity DropzoneJS widget configuration"
msgstr "Konfiguracja widgetu DropzoneJS modułu Media Entity"

msgid "Media type"
msgstr "Typ multimediów"

msgid "Media Entity DropzoneJS with edit widget configuration"
msgstr "Widget DropzoneJS modułu Media Entity z konfiguracją widgetu edycji"

msgid "Form mode"
msgstr "Tryb formularza"

msgid "Drop files here to upload them"
msgstr "Aby przesłać pliki, upuść je tutaj"

msgid "File upload"
msgstr "Przesyłanie plików"

msgid "Files could not be uploaded because the destination directory %destination is not configured correctly."
msgstr "Nie można przesłać plików, ponieważ katalogu docelowy %destination jest poprawnie skonfigurowany."

msgid "Some files that you are trying to upload did not pass validation. Requirements are: max file %size, allowed extensions are %extensions"
msgstr "Niektóre pliki, które próbujesz przesłać, nie przeszły procedury sprawdzania poprawności. Wymagania są następujące: maksymalna wielkość pliku to %size, dozwolone rozszerzenia to %extensions"

msgid "At least one valid file should be uploaded."
msgstr "Powinien zostać przesłany co najmniej jeden poprawny plik."

msgid "MB"
msgstr "MB"

msgid "A space separated list of file extensions"
msgstr "Rozdzielana spacjami lista rozszerzeń nazw plików"

msgid "Use client side resizing"
msgstr "Użyj zmiany wielkości po stronie klienta"

msgid "Requires droopzone version v4.4.0 or higher and the <a href=\"@exif\" target=\"_blank\">exif</a> library."
msgstr "Wymaga biblioteki dropzone 4.4.0 lub nowszej i biblioteki <a href=\"@exif\" target=\"_blank\">exif</a>."

msgid "Max width"
msgstr "Maksymalna szerokość"

msgid "Max height"
msgstr "Maksymalna wysokość"

msgid "Resize method"
msgstr "Metoda zmiany wielkości"

msgid "Contain (scale)"
msgstr "Zawiera (skala)"

msgid "Crop"
msgstr "Uprawa"

msgid "Thumbnail method"
msgstr "Metoda generowania miniatury"

msgid "Invalid extension list format."
msgstr "Niepoprawny format listy rozszerzeń."

msgid "DropzoneJS"
msgstr "DropzoneJS"

msgid "Adds DropzoneJS upload integration."
msgstr "Dodaje integrację możliwości przesyłania przy użyciu biblioteki DropzoneJS."

msgid "Missing requirement: in order to use this widget you have to install Inline entity form module first"
msgstr "Nie spełniono wymagania: aby można było używać tego widgetu, należy wcześniej zainstalować moduł Inline Entity Form."

msgid "Edit"
msgstr "Edytuj"

msgid "Media Entity DropzoneJS with edit"
msgstr "Widget DropzoneJS modułu Media Entity z funkcją edycji"

msgid "Adds DropzoneJS upload integration that saves Media entities and allows to edit them."
msgstr "Dodaje integrację możliwości przesyłania przy użyciu biblioteki DropzoneJS, dzięki której można zapisywać jednostki multimedialne i je edytować."

msgid "The type of media entity to create from the uploaded file(s)."
msgstr "Typ jednostki multimedialnej, który ma zostać utworzony na podstawie przesłanych plików."

msgid "You must @create_media_type before using this widget."
msgstr "Zanim będzie można używać tego widgetu, @create_media_type."

msgid "create a media type"
msgstr "utwórz typ multimediów"

msgid "Media Entity DropzoneJS"
msgstr "Widget DropzoneJS modułu Media Entity"

msgid "Adds DropzoneJS upload integration that saves Media entities."
msgstr "Dodaje integrację możliwości przesyłania przy użyciu biblioteki DropzoneJS, która umożliwia zapisywanie jednostek multimedialnych."

