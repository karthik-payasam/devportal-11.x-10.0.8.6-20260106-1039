msgid "@style style will not display without the \"@field\" setting."
msgstr "Lo stile @style non verrà visualizzato senza l'impostazione \"@field\". "

msgid "About"
msgstr "Informazioni"

msgid "The <a href=\":bootstrap\">Views Bootstrap module</a> adds styles to Views to output the results of a view as several common <a href=\":components\">Twitter Bootstrap</a> components."
msgstr "Il <a href=\":bootstrap\">modulo Bootstrap viste</a> aggiunge gli stili alle viste per visualizzare i risultati di una vista come diversi componenti <a href=\":components\">Bootstrap Twitter</a> comuni."

msgid "Uses"
msgstr "Usa"

msgid "<a href=\":views\">Create a view</a> using one of the following styles:"
msgstr "<a href=\":views\">Creare una vista</a> utilizzando uno dei seguenti stili:"

msgid "<a href=\":docs\">Accordion</a>"
msgstr "<a href=\":docs\">Menu a fisarmonica</a>"

msgid "<a href=\":docs\">Cards</a>"
msgstr "<a href=\":docs\">Schede</a>"

msgid "<a href=\":docs\">Carousel</a>"
msgstr "<a href=\":docs\">Sequenza</a>"

msgid "<a href=\":docs\">Dropdown</a>"
msgstr "<a href=\":docs\">Elenco a discesa</a>"

msgid "<a href=\":docs\">Grid</a>"
msgstr "<a href=\":docs\">Griglia</a>"

msgid "<a href=\":docs\">Thumbnails</a>"
msgstr "<a href=\":docs\">Miniature</a>"

msgid "<a href=\":docs\">Tables</a>"
msgstr "<a href=\":docs\">Tabelle</a>"

msgid "<a href=\":docs\">Tabs</a>"
msgstr "<a href=\":docs\">Schede</a>"

msgid "<a href=\":docs\">Media object</a>"
msgstr "<a href=\":docs\">Oggetto multimediale</a>"

msgid "<a href=\":docs\">List group</a>"
msgstr "<a href=\":docs\">Gruppo di elenco</a>"

msgid "Views Bootstrap"
msgstr "Bootstrap viste"

msgid "Views Twitter Bootstrap Components."
msgstr "Componenti bootstrap Twitter viste."

msgid "Views"
msgstr "Viste"

msgid "The Bootstrap accordion displays content in collapsible panels (<a href=\":docs\">see documentation</a>)."
msgstr "Il menu a fisarmonica Bootstrap visualizza il contenuto in pannelli comprimibili (<a href=\":docs\">consultare la documentazione</a>)."

msgid "Panel title field"
msgstr "Campo Titolo del pannello"

msgid "Select the field that will be used as the accordion panel titles."
msgstr "Selezionare il campo che verrà utilizzato come titoli del pannello del menù a fisarmonica."

msgid "Label field"
msgstr "Campo Etichetta"

msgid "- None -"
msgstr "- Nessuno -"

msgid "Select the field that will be used as the label."
msgstr "Selezionare il campo che verrà utilizzato come etichetta."

msgid "Collapse Options"
msgstr "Opzioni compressione"

msgid "All Items Closed"
msgstr "Tutti gli elementi chiusi"

msgid "First Item Open"
msgstr "Primo elemento aperto"

msgid "All Items Open"
msgstr "Tutti gli elementi aperti"

msgid "Default panel state for collapse behavior."
msgstr "Lo stato del pannello predefinito per il funzionamento della compressione."

msgid "Bootstrap Accordion"
msgstr "Menu a fisarmonica bootstrap "

msgid "Displays rows in a Bootstrap Accordion."
msgstr "Visualizza le righe in un menu a fisarmonica bootstrap."

msgid "Card title field"
msgstr "Campo del titolo della scheda"

msgid "Select the field that will be used for the card title."
msgstr "Selezionare il campo che verrà utilizzato per il titolo della scheda."

msgid "Card content field"
msgstr "Campo del contenuto della scheda"

msgid "Select the field that will be used for the card content."
msgstr "Selezionare il campo che verrà utilizzato per il contenuto della scheda."

msgid "Card image field"
msgstr "Campo dell'immagine della scheda"

msgid "Select the field that will be used for the card image."
msgstr "Selezionare il campo che verrà utilizzato per l'immagine della scheda."

msgid "Custom card group class"
msgstr "Classe di gruppo delle schede personalizzate"

msgid "Additional classes to provide on the card group. Separated by a space."
msgstr "Classi aggiuntive da fornire sul gruppo di schede. Separate da uno spazio."

msgid "Additional classes to provide on each card. Separated by a space."
msgstr "Classi aggiuntive da fornire su ciascuna scheda. Separate da uno spazio."

msgid "Bootstrap Cards"
msgstr "Schede bootstrap"

msgid "Displays rows in a Bootstrap Card Group layout"
msgstr "Visualizza le righe in un layout Gruppo di schede Bootstrap"

msgid "The Bootstrap carousel displays content as a slideshow (<a href=\":docs\">see documentation</a>)."
msgstr "Il carousel Bootstrap visualizza il contenuto come una presentazione (<a href=\":docs\">consultare la documentazione</a>)."

msgid "<None>"
msgstr "<Nessuno>"

msgid "Interval"
msgstr "Intervallo"

msgid "The amount of time to delay between automatically cycling an item. If false, carousel will not automatically cycle."
msgstr "L'intervallo di tempo di ritardo tra l'esecuzione automatica del ciclo di un elemento. Se l'opzione è impostata su false, la sequenza non esegue automaticamente il ciclo. "

msgid "Show navigation"
msgstr "Mostra navigazione"

msgid "Show indicators"
msgstr "Mostra indicatori"

msgid "Pause on hover"
msgstr "Pausa al passaggio del mouse"

msgid "Pauses the cycling of the carousel on mouseenter and resumes the cycling of the carousel on mouseleave."
msgstr "Interrompe il ciclo della sequenza al mouseenter e la ripristina al mouseleave. "

msgid "Wrap"
msgstr "Esegui wrap "

msgid "The carousel should cycle continuously or have hard stops."
msgstr "La sequenza si ripete continuamente o si interrompe definitivamente. "

msgid "Columns"
msgstr "Colonne"

msgid "The number of columns to include in the carousel."
msgstr "Il numero di colonne da includere nella sequenza."

msgid "Breakpoints"
msgstr "Punti di suddivisione"

msgid "The min-width breakpoint of the multicolumn carousel."
msgstr "Il punto di suddivisione con larghezza minima della sequenza a più colonne."

msgid "Extra Small"
msgstr "Molto piccolo"

msgid "Small"
msgstr "Piccolo"

msgid "Medium"
msgstr "Medio"

msgid "Large"
msgstr "Grande"

msgid "Display"
msgstr "Visualizzazione"

msgid "Select by fields"
msgstr "Seleziona in base ai campi"

msgid "Display fields as row content"
msgstr "Visualizza i campi come contenuto della riga"

msgid "Displaying fields as row content will output the field rows as unformatted values within each carousel item."
msgstr "La visualizzazione dei campi come contenuto della riga genererà come output le righe del campo come valori non formattati all'interno di ogni elemento della sequenza."

msgid "Image"
msgstr "Immagine"

msgid "Title"
msgstr "Titolo"

msgid "Description"
msgstr "Descrizione"

msgid "Bootstrap Carousel"
msgstr "Sequenza di bootstrap "

msgid "Displays rows in a Bootstrap Carousel."
msgstr "Visualizza le righe in una sequenza di bootstrap."

msgid "The Bootstrap dropdown style displays a list of links in a drop-down menu format (<a href=\":docs\">see documentation</a>)."
msgstr "Lo stile del menu a discesa visualizza un elenco dei link nel formato di un menu a discesa (<a href=\":docs\">consultare la documentazione</a>)."

msgid "Button text"
msgstr "Testo del bottone"

msgid "Text label for the button that is the drop-down toggle."
msgstr "L'etichetta di testo per il pulsante che è il toggle del menu a discesa"

msgid "Button class"
msgstr "Classe pulsante"

msgid "Classes for the button that is the drop-down toggle."
msgstr "Le classi per il pulsante che è il toggle del menu a discesa."

msgid "Default"
msgstr "Predefinito"

msgid "Primary"
msgstr "Primario"

msgid "Success"
msgstr "Riuscito"

msgid "Info"
msgstr "Informazioni"

msgid "Warning"
msgstr "Avviso"

msgid "Danger"
msgstr "Pericolo"

msgid "Wrapper class"
msgstr "Classe wrapper"

msgid "The class to provide on the wrapper, outside the list."
msgstr "La classe da assegnare all wrapper che contiene l'elenco."

msgid "List class"
msgstr "Classe dell'elenco"

msgid "The class to provide on the list element itself."
msgstr "La classe da assegnare all'elenco stesso."

msgid "Bootstrap Dropdown"
msgstr "Menu a discesa Bootstrap"

msgid "Displays rows in a Bootstrap Dropdown."
msgstr "Visualizza le righe in un menu a discesa Bootstrap."

msgid "The Bootstrap grid displays content in a responsive, mobile first fluid grid (<a href=\":docs\">see documentation</a>)."
msgstr "La griglia Bootstrap visualizza il contenuto in una griglia responsiva, fluida Mobile First (<a href=\":docs\">consultare la documentazione</a>)."

msgid "Alignment"
msgstr "Allineamento"

msgid "Horizontal"
msgstr "Orizzontale"

msgid "Vertical"
msgstr "Verticale"

msgid ""
"Horizontal alignment will place items starting in the upper left and moving right.\n"
"      Vertical alignment will place items starting in the upper left and moving down."
msgstr ""
"L'allineamento orizzontale posizionerà gli elementi a partire da in alto a sinistra, spostandosi a destra.\n"
"      L'allineamento verticale posiziona gli elementi partendo dalla parte superiore sinistra e spostandosi verso il basso."

msgid "Default column classes"
msgstr "Classi colonna predefinite"

msgid "Add the default views column classes like views-col, col-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Aggiungere le classi colonna delle viste predefinite come views-col, col-1 e clearfix all'output. È possibile utilizzare ciò per ridurre rapidamente la quantità di markup che la vista fornisce per impostazione predefinita a costo di rendere più difficile applicare CSS."

msgid "Custom column class"
msgstr "Classe colonna personalizzata"

msgid "Additional classes to provide on each column. Separated by a space."
msgstr "Ulteriori classi da fornire in ogni colonna. Separate da uno spazio."

msgid "You may use field tokens from as per the \"Replacement patterns\" used in \"Rewrite the output of this field\" for all fields."
msgstr "Per tutti i campi è possibile utilizzare token (vedi \"pattern di sostituzione\" utilizzato in \"Riscrittura dell'output del campo\")."

msgid "Default row classes"
msgstr "Classi riga predefinite"

msgid "Adds the default views row classes like views-row, row-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Aggiunge le classi riga delle viste predefinite come views-row, row-1 e clearfix all'output. È possibile utilizzare ciò per ridurre rapidamente la quantità di markup che la vista fornisce per impostazione predefinita a costo di rendere più difficile applicare CSS."

msgid "Custom row class"
msgstr "Classe riga personalizzata"

msgid "Additional classes to provide on each row. Separated by a space."
msgstr "Ulteriori classi da fornire in ogni riga. Separate da uno spazio."

msgid "Base number of columns"
msgstr "Numero base di colonne"

msgid "all"
msgstr "tutti"

msgid "Choose the number of columns that views will wrap in a single row. This will be reflected in the HTML structure rendered regardless of the device size. If selecting \"all\" then use the alternative template."
msgstr "Scegliere il numero di colonne che le viste accorperanno in una singola riga. Ciò sarà riflesso nella struttura HTML rappresentata indipendentemente dalla dimensione del dispositivo. Se si seleziona \"tutto\", utilizzare il modello alternativo."

msgid "Number of columns (col-@size)"
msgstr "Numero di colonne (col-@size)"

msgid "This adds col-@size to the div."
msgstr "Questo aggiunge col-@size al dispositivo."

msgid "Bootstrap Grid"
msgstr "Griglia di bootstrap "

msgid "Displays rows in a Bootstrap Grid layout"
msgstr "Visualizza le righe in un layout Griglia di bootstrap "

msgid "The Bootstrap list group displays content in an unordered list with list group classes (<a href=\":docs\">see documentation</a>)."
msgstr "Il gruppo di elenchi Bootstrap visualizza il contenuto in un elenco non ordinato con le classi del gruppo di elenchi <a href=\":docs\">consultare la documentazione</a>)."

msgid "Set group field in panel heading"
msgstr "Impostare il campo gruppo nell'intestazione del pannello"

msgid "Title field"
msgstr "Titolo del campo"

msgid "Select the field that will be used as the title."
msgstr "Selezionare il campo che verrà utilizzato come titolo. "

msgid "Bootstrap List Group"
msgstr "Gruppo di elenco bootstrap "

msgid "Displays rows in a Bootstrap List Group."
msgstr "Visualizza le righe in un gruppo di elenco bootstrap. "

msgid "The Bootstrap media object displays content with an image item lead with heading and text (<a href=\":docs\">see documentation</a>)."
msgstr "L'oggetto di supporto Bootstrap visualizza il contenuto con un elemento immagine con intestazione e testo <a href=\":docs\">consultare la documentazione</a>)."

msgid "Heading field"
msgstr "Campo intestazione"

msgid "Select the field that will be used as the media object heading. Exclude this field from display to prevent duplication."
msgstr "Selezionare il campo che verrà utilizzato come intestazione dell'oggetto multimediale. Escludere questo campo dalla visualizzazione per evitare la duplicazione."

msgid "Image field"
msgstr "Campo immagine"

msgid "Select the field that will be used as the media object image. Exclude this field from display to prevent duplication."
msgstr "Selezionare il campo che verrà utilizzato come immagine dell'oggetto multimediale. Escludere questo campo dalla visualizzazione per evitare la duplicazione."

msgid "Body field"
msgstr "Campo corpo"

msgid "All fields that are not excluded from display will be shown as the body."
msgstr "Tutti i campi che non sono esclusi dalla visualizzazione verranno mostrati come corpo."

msgid "Image Alignment"
msgstr "Allineamento immagine"

msgid "Left"
msgstr "Sinistra"

msgid "Right"
msgstr "Destra"

msgid "Middle"
msgstr "Centro"

msgid "Align the media object image left or right."
msgstr "Allinea l'immagine dell'oggetto multimediale a destra o sinistra. "

msgid "Bootstrap Media Object"
msgstr "Oggetto multimediale bootstrap "

msgid "Displays rows in a Bootstrap Media Object."
msgstr "Visualizza le righe in un oggetto multimediale bootstrap. "

msgid "The Bootstrap panels displays content in a box with optional header and footer elements (<a href=\":docs\">see documentation</a>)."
msgstr "I pannelli Bootstrap visualizzano il contenuto in una casella con l'intestazione facoltativa e elementi a piè di pagina (<a href=\":docs\">consultare la documentazione</a>)."

msgid "Contextual class"
msgstr "Classe contestuale"

msgid "<a href=\":docs\">see Bootstrap documentation</a>"
msgstr "<a href=\":docs\">consultare la documentazione Bootstrap</a>"

msgid "Select the field that will be used as the panel heading titles."
msgstr "Selezionare il campo che verrà utilizzato come titoli di intestazione del pannello."

msgid "Panel footer field"
msgstr "Campo piè di pagina del pannello"

msgid "Select the field that will be used as the panel footer."
msgstr "Selezionare il campo che verrà utilizzato come piè di pagina del pannello."

msgid "Bootstrap Panels"
msgstr "Pannelli Bootstrap"

msgid "Displays rows in a Bootstrap Panel."
msgstr "Visualizza le righe in un pannello Bootstrap."

msgid "The Bootstrap tabs displays content with tab titles linked to dynamically displayed content (<a href=\":docs\">see documentation</a>)."
msgstr "Le schede Bootstrap visualizzano il contenuto con titoli della scheda collegati al contenuto visualizzato dinamicamente <a href=\":docs\">consultare la documentazione</a>)."

msgid "Tab field"
msgstr "Campo Scheda"

msgid "Select the field that will be used as the tab."
msgstr "Selezionare il campo che verrà utilizzato come scheda. "

msgid "Tab Type"
msgstr "Tipo di scheda"

msgid "Tabs"
msgstr "Schede"

msgid "Pills"
msgstr "Pillole"

msgid "List"
msgstr "Elenco"

msgid "Position of tabs"
msgstr "Posizione delle schede"

msgid "Tabs/pills on the top"
msgstr "Schede/sottotitoli nell parte superiore"

msgid "Tabs/pills on the left"
msgstr "Schede/Sottotitoli a sinistra"

msgid "Tabs/pills on the right"
msgstr "Schede/sottotitoli a destra"

msgid "Tabs/pills on the bottom"
msgstr "Schede/sottotitoli nella parte inferiore"

msgid "Tabs/pills justified on the top"
msgstr "Schede/sottotitoli giustificati nella parte superiore"

msgid "Tabs/pills stacked"
msgstr "Schede/sottotitoli impilate"

msgid "Fade Effect"
msgstr "Effetto sfumato"

msgid "Add a fade in effect when tabs clicked"
msgstr "Aggiunge un effetto sfumato quando si fa clic sulle schede"

msgid "Bootstrap Tabs"
msgstr "Schede Bootstrap"

msgid "Displays rows in Bootstrap Tabs."
msgstr "Visualizza le righe nelle schede bootstrap. "

msgid "The Bootstrap table style adds default Bootstrap table classes and optional classes (<a href=\":docs\">see documentation</a>)."
msgstr "Lo stile tabella Bootstrap aggiunge classi tabella Bootstrap predefinite e classi facoltative <a href=\":docs\">consultare la documentazione</a>)."

msgid "Responsive"
msgstr "Responsive"

msgid "To make a table scroll horizontally on small devices."
msgstr "Abilita lo scorrimento orizzontale su dispositivi di piccole dimensioni. "

msgid "Bootstrap styles"
msgstr "Stili bootstrap "

msgid "Striped"
msgstr "A strisce"

msgid "Bordered"
msgstr "Con bordi"

msgid "Hover"
msgstr "Al passaggio del mouse"

msgid "Condensed"
msgstr "Ridotto"

msgid "Caption for the table"
msgstr "Didascalia per la tabella"

msgid "A title semantically associated with your table for increased accessibility."
msgstr "Un titolo semanticamente associato alla tabella per una maggiore facilità di accesso."

msgid "Table details"
msgstr "Dettagli tabella"

msgid "Summary title"
msgstr "Titolo riepilogo"

msgid "Table description"
msgstr "Descrizione tabella"

msgid "Provide additional details about the table to increase accessibility."
msgstr "Fornire ulteriori dettagli sulla tabella per aumentare l'accessibilità."

msgid "Bootstrap Table"
msgstr "Tabella bootstrap "

msgid "Displays rows in a Bootstrap table."
msgstr "Visualizza le righe in una tabella bootstrap. "

msgid "The Bootstrap thumbnails extends the grid display with the thumbnail component to showcase linked images (<a href=\":docs\">see documentation</a>)."
msgstr "Le miniature Bootstrap estendono la visualizzazione della griglia con il componente della miniatura per mostrare le immagini collegate (<a href=\":docs\">consultare la documentazione</a>)."

msgid "Bootstrap Thumbnails"
msgstr "Miniature Bootstrap"

msgid "Displays rows in a Bootstrap Grid layout with thumbnails"
msgstr "Visualizza le righe in un layout di griglia Bootstrap con miniature"

msgid "Previous"
msgstr "Precedente"

msgid "Next"
msgstr "Seguente"

