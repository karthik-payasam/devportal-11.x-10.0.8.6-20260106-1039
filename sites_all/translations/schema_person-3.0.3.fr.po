msgid "Schema.org: Person"
msgstr "Schema.org : Personne"

msgid "An additional name for a Person, can be used for a middle name."
msgstr "Autre nom d'une personne, qui peut être utilisé comme deuxième prénom."

msgid "Physical address of the person."
msgstr "Adresse physique de la personne."

msgid "An organization that this person is affiliated with. For example, a school/university, a club, or a team."
msgstr "Organisation à laquelle cette personne est affiliée. Par exemple, une école/université, un club ou une équipe."

msgid "An alias for the person."
msgstr "Alias de la personne."

msgid "birthDate"
msgstr "birthDate"

msgid "Date of birth of the person in ISO 8601 format, 2017-12-31."
msgstr "Date de naissance de la personne au format ISO 8601, par exemple 2017-12-31."

msgid "The brand of the person."
msgstr "Marque de la personne."

msgid "A description of the person."
msgstr "Description de la personne."

msgid "The email address of the person."
msgstr "Adresse électronique de la personne."

msgid "familyName"
msgstr "familyName"

msgid "Family name. In the U.S., the last name of an Person. This can be used along with givenName instead of the name property."
msgstr "Nom de famille. Aux États-Unis, le nom de famille d'une personne. Il peut être utilisé avec l'élément givenName au lieu de la propriété name."

msgid "Gender of the person."
msgstr "Sexe de la personne."

msgid "givenName"
msgstr "givenName"

msgid "Given name. In the U.S., the first name of a Person. This can be used along with familyName instead of the name property."
msgstr "Prénom. Aux États-Unis, le prénom d'une personne. Il peut être utilisé avec l'élément familyName au lieu de la propriété name."

msgid "Globally unique id of the person, usually a url."
msgstr "ID global unique de la personne, généralement une URL."

msgid "The primary image for the person."
msgstr "Image principale de la personne."

msgid "jobTitle"
msgstr "jobTitle"

msgid "The job title of the person (for example, Financial Manager)."
msgstr "Intitulé du poste de la personne (par exemple, Responsable financier)."

msgid "memberOf"
msgstr "memberOf"

msgid "An Organization (or ProgramMembership) to which this Person belongs."
msgstr "Organisation (ou ProgramMembership) à laquelle appartient cette personne."

msgid "REQUIRED BY GOOGLE. The name of the person."
msgstr "REQUIS PAR GOOGLE. Nom de la personne."

msgid "REQUIRED BY GOOGLE. A single or an [array] of URLs for the person's official social media profile page(s)."
msgstr "REQUIS PAR GOOGLE. URL unique ou [groupe] d'URL correspondant aux pages de profil officielles de la personne sur les réseaux sociaux."

msgid "The telephone number of the person."
msgstr "Numéro de téléphone de la personne."

msgid "REQUIRED. The type of person (fixed by standard)."
msgstr "Obligatoire. Type de personne (déterminé par une norme)."

msgid "REQUIRED BY GOOGLE. The URL for the person's official website."
msgstr "REQUIS PAR GOOGLE. URL du site Web officiel de la personne."

msgid "worksFor"
msgstr "worksFor"

msgid "Organizations that the person works for."
msgstr "Organisations pour lesquelles travaille la personne."

