msgstr "Typ uzlu je povolen pro plánované stažení"

msgid "The node to check for the type being enabled for scheduled unpublishing."
msgstr "Uzel kontrolující typ povolený pro plánované zrušení publikování."

msgid "scheduled publishing"
msgstr "plánované publikování"

msgid "scheduled unpublishing"
msgstr "plánované zrušení publikování"

msgid "@bundle_label is enabled for @activity"
msgstr "@bundle_label je povolen pro @activity"

msgid "@type settings"
msgstr "Nastavení @type"

msgid "Action %action is not valid because @activity is not enabled for %type @group. Add the condition %condition to your Reaction Rule, or enable @activity via the <a href=\"@url\">%type</a> settings."
msgstr "Akce %akce není platná, protože @activity není povolena pro %type @group. Přidejte podmínku %condition do svého pravidla reakce, nebo povolte @activity prostřednictvím nastavení <a href=\"@url\">%type</a>."

msgid "Action %action is not valid because @activity is not enabled for %type @group. Add the condition %condition to your Reaction Rule, or enable @activity via the %type settings."
msgstr "Akce %akce není platná, protože @activity není povolena pro %type @group. Přidejte podmínku %condition do svého pravidla reakce, nebo povolte @activity prostřednictvím nastavení %type."

msgid "Set date for publishing a @entity_type_singular"
msgstr "Nastavit datum publikování @entity_type_singular"

msgid "@entity_type_label for scheduling"
msgstr "@entity_type_label pro plánování"

msgid "The @entity_type_singular which is to have a scheduled publishing date set"
msgstr "@entity_type_singular, který má mít nastaveno datum plánovaného publikování"

msgid "Date for publishing"
msgstr "Datum publikování"

msgid "The date when Scheduler will publish the @entity_type_singular"
msgstr "Datum, kdy plánovač publikuje @entity_type_singular"

msgid "Set date for unpublishing a @entity_type_singular"
msgstr "Nastavit datum pro zrušení publikování @entity_type_singular"

