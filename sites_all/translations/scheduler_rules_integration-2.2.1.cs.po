msgstr "@entity_type_label je naplánován pro zrušení publikování"

msgid "The @entity_type_singular to check for having a scheduled unpublishing date."
msgstr "@entity_type_singular kontrolující existenci data naplánované zrušení publikování."

msgid "Node type is enabled for scheduled publishing"
msgstr "Typ uzlu je povolen pro plánované publikování"

msgid "Content (Scheduler)"
msgstr "Obsah (Plánovač)"

msgid "The node to check for the type being enabled for scheduled publishing."
msgstr "Uzel kontrolující typ povolený pro plánované publikování."

msgid "Node is scheduled for publishing"
msgstr "Uzel je naplánován pro publikování"

msgid "The node to check for having a scheduled publishing date."
msgstr "Uzel kontrolující existenci data plánovaného publikování."

msgid "Node is scheduled for unpublishing"
msgstr "Uzel je naplánován pro stažení"

msgid "The node to check for having a scheduled unpublishing date."
