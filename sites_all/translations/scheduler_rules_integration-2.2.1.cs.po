msgstr "Když plánovač publikoval @entity_type"

msgid "After Scheduler has unpublished a @entity_type"
msgstr "Když plánovač zrušil publikování @entity_type"

msgid "@entity_type_label type is enabled for scheduled publishing"
msgstr "Typ @entity_type_label je povolen pro plánované publikování"

msgid "@entity_type_label"
msgstr "@entity_type_label"

