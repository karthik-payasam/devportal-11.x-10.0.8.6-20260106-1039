msgid "Send e-mail when content is published by Scheduler"
msgstr "Odeslat e-mail při publikování obsahu modulem Scheduler (plánovačem)"

msgid "'[node:title]' has been published on [site:name]"
msgstr "'[node:title]' byl publikován na [site:name]"

msgid "Send e-mail when content is unpublished by Scheduler"
msgstr "Odeslat e-mail, když má obsah zrušené publikování modulem Scheduler"

msgid "'[node:title]' has been unpublished on [site:name]"
msgstr "'[node:title]' má zrušené publikování z [site:name]"

msgid "Node"
msgstr "Uzel"

msgid "The node for publishing via Scheduler."
msgstr "Uzel pro publikování prostřednictvím modulu Scheduler."

msgid "Publish-on Date"
msgstr "Datum publikování"

msgid "The publishing date to be used by Scheduler."
msgstr "Datum publikování, které má být použito modulem Scheduler."

msgid "Set scheduled publishing date"
msgstr "Nastavit datum plánovaného publikování"

msgid "The node for unpublishing via Scheduler."
msgstr "Uzel pro stažení prostřednictvím modulu Scheduler."

msgid "Unpublish-on Date"
msgstr "Datum stažení"

msgid "The unpublishing date to be used by Scheduler."
msgstr "Datum stažení, které má být použito modulem Scheduler."

msgid "Set scheduled unpublishing date"
msgstr "Nastavit datum plánovaného stažení"

msgid "The scheduled node"
msgstr "Plánovaný uzel"

msgid "The node scheduled for publishing via Scheduler."
msgstr "Uzel plánovaný pro publikování prostřednictvím modulu Scheduler."

msgid "Remove scheduled publishing date"
msgstr "Odebrat datum plánovaného publikování"

msgid "The node scheduled for unpublishing via Scheduler."
msgstr "Uzel naplánovaný pro stažení prostřednictvím modulu Scheduler."

msgid "Remove scheduled unpublishing date"
msgstr "Odebrat datum plánovaného stažení"

msgid "Scheduler Rules Integration"
msgstr "Integrace pravidel modulu Scheduler"

msgid "Scheduler sub-module providing conditions, actions and events for use with the Rules module."
msgstr "Dílčí modul modulu Scheduler poskytující podmínky, akce a události pro použití s modulem Pravidla."

msgid "Scheduler"
msgstr "Scheduler"

msgid "The object representing the scheduled @entity_type"
msgstr "Objekt představující naplánovaný @entity_type"

msgid "After saving a new @entity_type that is scheduled for publishing"
msgstr "Po uložení nového @entity_type, který je naplánován pro publikování"

msgid "After saving a new @entity_type that is scheduled for unpublishing"
msgstr "Po uložení nového @entity_type, který je naplánován pro zrušení publikování"

