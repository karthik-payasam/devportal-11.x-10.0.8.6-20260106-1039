msgid "VotingAPI tokens"
msgstr "VotingAPI-Tokens"

msgid "Dynamic Tokens for VotingAPI."
msgstr "Dynamische Tokens für VotingAPI."

msgid "Vote count"
msgstr "Stimmenanzahl"

msgid "Number of votes."
msgstr "Anzahl der Stimmen."

msgid "Average Result"
msgstr "Durchschnittliches Ergebnis"

msgid "Average result of votes."
msgstr "Durchschnittliches Ergebnis der Stimmen."

msgid "Best Vote"
msgstr "Beste Stimme"

msgid "Best Vote cast."
msgstr "Beste abgegebene Stimme."

msgid "Worst Vote"
msgstr "Schlechteste Stimme"

msgid "Worst Vote cast."
msgstr "Schlechteste abgegebene Stimme."

msgid "About"
msgstr "Informationen"

msgid "This module enables tokens for all entity types that has <kbd>voting_api_field</kbd>."
msgstr "Dieses Modul ermöglicht Tokens für alle Entitätstypen mit <kbd>voting_api_field</kbd>."

msgid "Usage"
msgstr "Nutzung"

msgid "Tokens are dynamic and you have to pass <emph>vote_type</emph> as the last parameter. Module defines four tokens:"
msgstr "Tokens sind dynamisch. Sie müssen <emph>vote_type</emph> als letzten Parameter übergeben. Das Modul definiert vier Tokens:"

msgid "<ul><li>Vote count :: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"
msgstr "<ul><li>Stimmenanzahl :: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"

msgid "<li>Vote average :: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"
msgstr "<li>Stimmendurchschnitt :: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"

msgid "<li>Best vote :: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"
msgstr "<li>Beste Stimme :: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"

msgid "<li>Worst vote :: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"
msgstr "<li>Schlechteste Stimme :: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"

msgid "Voting API Tokens"
msgstr "'Voting API'-Token"

msgid "Token support for Voting API"
msgstr "Tokenunterstützung für Voting API"

msgid "Voting"
msgstr "Abstimmen"

