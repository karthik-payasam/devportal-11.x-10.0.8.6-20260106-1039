msgid "Lists registered library information."
msgstr "Выводит информацию о зарегистрированной библиотеке."

msgid ""
"Downloads a registered library into the libraries directory for the active site.\n"
"\n"
"See libraries-list for a list of registered libraries."
msgstr ""
"Загружает зарегистрированную библиотеку в каталог библиотек для активного сайта.\n"
"\n"
"См. libraries-list для списка зарегистрированных библиотек."

msgid "Name"
msgstr "Название"

msgid "Status"
msgstr "Статус"

msgid "Version"
msgstr "Версия"

msgid "Variants"
msgstr "Варианты"

msgid "Dependencies"
msgstr "Зависимости"

msgid "OK"
msgstr "OK"

msgid "Missing dependency: unzip. Install it before using this command."
msgstr "Отсутствует зависимость: unzip. Установите ее перед использованием этой команды."

msgid "Directory @path was created"
msgstr "Создан каталог @path"

msgid "A existing Colorbox plugin was overwritten at @path"
msgstr "Существующий модуль Colorbox заменен в @path"

msgid "Colorbox plugin has been downloaded to @path"
msgstr "Модуль Colorbox загружен в @path"

msgid "Drush was unable to download the Colorbox plugin to @path"
msgstr "Drush не удалось загрузить модуль Colorbox в @path"

msgid "The %dependency library, which the %library library depends on, is not installed."
msgstr "Библиотека %dependency, от которой зависит библиотека %library не установлена."

msgid "The version %dependency_version of the %dependency library is not compatible with the %library library."
msgstr "Версия %dependency_version библиотеки %dependency несовместима с библиотекой %library."

msgid "The %library library could not be found."
msgstr "Библиотека %library не найдена."

msgid "The version of the %library library could not be detected."
msgstr "Версия библиотеки %library не определена."

msgid "The installed version %version of the %library library is not supported."
msgstr "Библиотека %library версии %version не установлена."

msgid "The %variant variant of the %library library could not be found."
msgstr "Вариант %variant библиотеки %library не может быть найден."

msgid "The following external libraries could not successfully be registered with Drupal core: @libs. See earlier log entries for more details. Once these issues are addressed please be sure to clear your Drupal library cache to ensure external library detection is run again."
msgstr "Следующие внешние библиотеки не удалось зарегистрировать в ядре Drupal: @libs. См. предыдущие записи протокола. После устранения этих неполадок не забудьте очистить кэш библиотеки Drupal для повторного выполнения поиска внешних библиотек."

msgid "Libraries"
msgstr "Библиотеки"

msgid "Allows version-dependent and shared usage of external libraries."
msgstr "Разрешает зависимое от версии и общедоступное использование внешних библиотек."

msgid "Libraries API settings"
msgstr "Параметры API библиотек"

msgid "Library definition settings"
msgstr "Параметры определения библиотеки"

msgid "Local"
msgstr "Локально"

msgid "Local path"
msgstr "Локальный путь"

msgid "Enable remote fetching of library definitions"
msgstr "Включить удаленную загрузку определений библиотек"

msgid "A list of remote library registry URLs"
msgstr "Список URL удаленных реестров библиотек"

msgid "The URL of a remote library registry"
msgstr "URL удаленного реестра библиотек"

msgid "URI locator configuration"
msgstr "Конфигурация указателя URI"

msgid "The locator URI"
msgstr "URI указателя"

msgid "Assets"
msgstr "Ресурсы"

msgid "Provides access to asset library files."
msgstr "Обеспечивает доступ к файлам библиотек ресурсов."

msgid "Library definitions"
msgstr "Определения библиотек"

msgid "Provides access to library definition files."
msgstr "Обеспечивает доступ к файлам определений библиотек."

msgid "PHP library files"
msgstr "Файлы библиотек PHP"

msgid "Provides access to PHP library files."
msgstr "Обеспечивает доступ к файлам библиотек PHP."

