msgid "About"
msgstr "Информация"

msgid "Drupal Proxy Module"
msgstr "Модуль Прокси-сервер Drupal"

msgid "Drupal Proxy"
msgstr "Прокси-сервер Drupal"

msgid "Proxy"
msgstr "Прокси-сервер"

msgid "Proxy Settings"
msgstr "Параметры прокси-сервера"

msgid "ProxySettingForm"
msgstr "ProxySettingForm"

msgid "Https or Https"
msgstr "Https или Https"

msgid "type of Scheme"
msgstr "тип схемы"

msgid "Proxy Server"
msgstr "Прокси-сервер"

msgid "The IP address or hostname of the proxy server."
msgstr "IP-адрес или имя-хоста прокси-сервера."

msgid "Port"
msgstr "Порт"

msgid "The port number used by the proxy server for client connections."
msgstr "Номер порта, используемый прокси-сервером для соединений с клиентами."

msgid "Proxy Username"
msgstr "Имя пользователя прокси-сервера"

msgid "A username used of proxy server for Authentication."
msgstr "Имя пользователя, используемое прокси-сервером для идентификации."

msgid "Proxy Password"
msgstr "Пароль прокси-сервера"

msgid "Password of proxy server used for Authentication."
msgstr "Пароль прокси-сервера, используемый для идентификации."

msgid "Proxy User Agent"
msgstr "Браузер прокси-сервера"

msgid "A string which can be used by the proxy server to identify connection requests."
msgstr "Строка, используемая прокси-сервером для идентификации запросов на установление соединения."

msgid "Proxy Exceptions"
msgstr "Исключения прокси-сервера"

msgid "Specify exceptions using either IP addresses or hostnames. Enter one exception per line. Exceptions will be accessed directly, not via proxy."
msgstr "Укажите исключения (IP-адреса или имена хостов). Одно исключение на строке. Доступ к исключениям будет прямым, а не через прокси-сервер."

