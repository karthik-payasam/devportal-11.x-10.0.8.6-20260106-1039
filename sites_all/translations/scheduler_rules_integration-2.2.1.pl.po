msgid "Send e-mail when content is published by Scheduler"
msgstr "Wysyłaj wiadomość e-mail, gdy treść jest publikowana przez program planujący"

msgid "'[node:title]' has been published on [site:name]"
msgstr "Węzeł '[node:title]' został opublikowany w serwisie [site:name]"

msgid "Send e-mail when content is unpublished by Scheduler"
msgstr "Wysyłaj wiadomość e-mail, gdy publikacja treści jest wycofywana przez program planujący"

msgid "'[node:title]' has been unpublished on [site:name]"
msgstr "Publikacja węzła '[node:title]' w serwisie [site:name] została wycofana."

msgid "Node"
msgstr "Węzeł"

msgid "The node for publishing via Scheduler."
msgstr "Węzeł do opublikowania za pośrednictwem programu planującego."

msgid "Publish-on Date"
msgstr "Data publikacji"

msgid "The publishing date to be used by Scheduler."
msgstr "Data publikacji, która ma być używana przez program planujący."

msgid "Set scheduled publishing date"
msgstr "Ustaw datę planowanej publikacji"

msgid "The node for unpublishing via Scheduler."
msgstr "Węzeł do wycofania publikacji za pośrednictwem programu planującego."

msgid "Unpublish-on Date"
msgstr "Data wycofania publikacji"

msgid "The unpublishing date to be used by Scheduler."
msgstr "Data wycofania publikacji, która ma być używana przez program planujący."

msgid "Set scheduled unpublishing date"
msgstr "Ustaw datę planowanego wycofania publikacji"

msgid "The scheduled node"
msgstr "Zaplanowany węzeł"

msgid "The node scheduled for publishing via Scheduler."
msgstr "Węzeł, który został zaplanowany do opublikowania za pośrednictwem programu planującego."

msgid "Remove scheduled publishing date"
msgstr "Usuń datę planowanej publikacji"

msgid "The node scheduled for unpublishing via Scheduler."
msgstr "Węzeł, który został zaplanowany do wycofania publikacji za pośrednictwem programu planującego."

msgid "Remove scheduled unpublishing date"
msgstr "Usuń datę planowanego wycofania publikacji"

msgid "Scheduler Rules Integration"
msgstr "Integracja reguł programu planującego"

msgid "Scheduler sub-module providing conditions, actions and events for use with the Rules module."
msgstr "Podmoduł programu planującego udostępniający warunki, działania i zdarzenia do użycia z modułem Rules."

msgid "Scheduler"
msgstr "Program planujący"

msgid "The object representing the scheduled @entity_type"
msgstr "Jednostka reprezentująca zaplanowany typ jednostki @entity_type"

msgid "After saving a new @entity_type that is scheduled for publishing"
msgstr "Po zapisaniu nowego typu @entity_type, który jest zaplanowany na potrzeby publikowania"

msgid "After saving a new @entity_type that is scheduled for unpublishing"
msgstr "Po zapisaniu nowego typu @entity_type, który jest zaplanowany na potrzeby wycofania publikowania"

msgid "After updating a @entity_type that is scheduled for publishing"
msgstr "Po zaktualizowaniu typu @entity_type, który jest zaplanowany na potrzeby publikowania"

msgid "After updating a @entity_type that is scheduled for unpublishing"
msgstr "Po zaktualizowaniu typu @entity_type, który został zaplanowany na potrzeby wycofania publikowania"

msgid "After Scheduler has published a @entity_type"
msgstr "Po opublikowaniu typu @entity_type przez program planujący"

msgid "After Scheduler has unpublished a @entity_type"
msgstr "Po wycofaniu opublikowania typu @entity_type przez program planujący"

msgid "@entity_type_label type is enabled for scheduled publishing"
msgstr "Typ @entity_type_label jest włączony dla zaplanowanego publikowania"

msgid "@entity_type_label"
msgstr "@entity_type_label"

msgid "The @entity_type_singular to check for the type being enabled for scheduled publishing."
msgstr "@entity_type_singular, aby sprawdzić, czy typ jest włączony dla zaplanowanego publikowania."

msgid "@entity_type_label type is enabled for scheduled unpublishing"
msgstr "Typ @entity_type_label jest włączony dla zaplanowanego wycofania publikowania"

msgid "The @entity_type_singular to check for the type being enabled for scheduled unpublishing."
msgstr "@entity_type_singular, aby sprawdzić, czy typ jest włączony dla zaplanowanego wycofania publikowania."

msgid "@entity_type_label is scheduled for publishing"
msgstr "@entity_type_label został zaplanowany dla publikowania"

msgid "The @entity_type_singular to check for having a scheduled publishing date."
msgstr "@entity_type_singular, aby sprawdzić posiadanie zaplanowanej daty publikacji."

msgid "@entity_type_label is scheduled for unpublishing"
msgstr "@entity_type_label jest zaplanowany do wycofania publikowania"

msgid "The @entity_type_singular to check for having a scheduled unpublishing date."
msgstr "@entity_type_singular, aby sprawdzić posiadanie zaplanowanej daty wycofania publikowania."

msgid "Node type is enabled for scheduled publishing"
msgstr "Typ węzła włączono na potrzeby planowanej publikacji"

msgid "Content (Scheduler)"
msgstr "Treść (program planujący)"

msgid "The node to check for the type being enabled for scheduled publishing."
msgstr "Węzeł, który ma być sprawdzany, czy typ jest włączony do zaplanowanego publikowania."

msgid "Node is scheduled for publishing"
msgstr "Zaplanowano publikację węzła"

msgid "The node to check for having a scheduled publishing date."
msgstr "Węzeł, który ma być sprawdzany pod kątem posiadania zaplanowanej daty publikacji."

msgid "Node is scheduled for unpublishing"
msgstr "Zaplanowano wycofanie publikacji węzła"

msgid "The node to check for having a scheduled unpublishing date."
msgstr "Węzeł, który ma być sprawdzany pod kątem posiadania zaplanowanej daty wycofania publikacji."

msgid "Node type is enabled for scheduled unpublishing"
msgstr "Typ węzła włączono na potrzeby planowanego wycofania publikacji"

msgid "The node to check for the type being enabled for scheduled unpublishing."
msgstr "Węzeł, który ma być sprawdzany, czy typ jest włączony do zaplanowanego wycofania publikowania."

msgid "scheduled publishing"
msgstr "zaplanowane publikowanie"

msgid "scheduled unpublishing"
msgstr "zaplanowane wycofanie publikacji"

msgid "@bundle_label is enabled for @activity"
msgstr "@bundle_label jest włączony dla @activity"

msgid "@type settings"
msgstr "Ustawienia @type"

msgid "Action %action is not valid because @activity is not enabled for %type @group. Add the condition %condition to your Reaction Rule, or enable @activity via the <a href=\"@url\">%type</a> settings."
msgstr "Działanie %action nie jest poprawne, ponieważ @activity nie jest włączone dla %type @group. Dodaj warunek %condition reguły reakcji lub włącz @activity za pomocą ustawień <a href=\"@url\">%type</a>."

msgid "Action %action is not valid because @activity is not enabled for %type @group. Add the condition %condition to your Reaction Rule, or enable @activity via the %type settings."
msgstr "Działanie %action nie jest poprawne, ponieważ @activity nie jest włączone dla %type @group. Dodaj warunek %condition reguły reakcji lub włącz @activity za pomocą ustawień %type."

msgid "Set date for publishing a @entity_type_singular"
msgstr "Ustaw datę publikacji @entity_type_singular"

msgid "@entity_type_label for scheduling"
msgstr "@entity_type_label do zaplanowania"

msgid "The @entity_type_singular which is to have a scheduled publishing date set"
msgstr "@entity_type_singular, który ma mieć ustawioną datę publikacji"

msgid "Date for publishing"
msgstr "Data publikacji"

msgid "The date when Scheduler will publish the @entity_type_singular"
msgstr "Data, gdy program planujący opublikuje @entity_type_singular"

msgid "Set date for unpublishing a @entity_type_singular"
msgstr "Ustaw datę wycofania publikacji @entity_type_singular"

msgid "The @entity_type_singular which is to have a scheduled unpublishing date set"
msgstr "@entity_type_singular, który ma mieć ustawioną datę wycofania publikacji"

msgid "Date for unpublishing"
msgstr "Data wycofania publikacji"

msgid "The date when Scheduler will unpublish the @entity_type_singular"
msgstr "Data, gdy program planujący wycofa publikację @entity_type_singular"

msgid "Remove date for publishing a @entity_type_singular"
msgstr "Usuń datę publikacji @entity_type_singular"

msgid "The @entity_type_singular from which to remove the scheduled publishing date"
msgstr "@entity_type_singular, z którego ma zostać usunięta planowana data publikacji"

msgid "Remove date for unpublishing a @entity_type_singular"
msgstr "Usuń datę wycofania publikowania @entity_type_singular"

msgid "The @entity_type_singular from which to remove the scheduled unpublishing date"
msgstr "@entity_type_singular, z którego należy usunąć zaplanowaną datę wycofania publikacji."

msgid "Publish a @entity_type_singular immediately"
msgstr "Natychmiast opublikuj @entity_type_singular"

msgid "@entity_type_label for publishing"
msgstr "@entity_type_label do opublikowania"

msgid "The @entity_type_singular to be published now"
msgstr "@entity_type_singular, który ma zostać teraz opublikowany"

msgid "Unpublish a @entity_type_singular immediately"
msgstr "Natychmiast wycofaj publikację @entity_type_singular"

msgid "@entity_type_label for unpublishing"
msgstr "@entity_type_label do wycofania publikacji"

msgid "The @entity_type_singular to be unpublished now"
msgstr "@entity_type_singular, którego opublikowanie ma być teraz wycofane"

msgid "Publish a content item immediately"
msgstr "Natychmiast opublikuj element treści"

msgid "The node to be published now"
msgstr "Węzeł, który ma zostać teraz opublikowany"

msgid "Remove date for publishing a content item"
msgstr "Usuń datę opublikowania elementu treści"

msgid "The node from which to remove the scheduled publishing date"
msgstr "Węzeł, z którego ma zostać usunięta data planowanej publikacji"

msgid "Remove date for unpublishing a content item"
msgstr "Usuń datę wycofania publikacji elementu treści"

msgid "The node from which to remove the scheduled unpublishing date"
msgstr "Węzeł, z którego ma zostać usunięta data planowanego wycofania publikacji"

msgid "Set date for publishing a content item"
msgstr "Ustaw datę opublikowania elementu treści"

msgid "Node for scheduling"
msgstr "Węzeł do planowania"

msgid "The node which is to have a scheduled publishing date set"
msgstr "Węzeł, dla którego ma zostać ustawiona data planowanej publikacji"

msgid "The date for publishing"
msgstr "Data publikacji"

msgid "The date when Scheduler will publish the node"
msgstr "Data określająca, kiedy program planujący opublikuje węzeł"

msgid "Set date for unpublishing a content item"
msgstr "Ustaw datę wycofania publikacji elementu treści"

msgid "The node which is to have a scheduled unpublishing date set"
msgstr "Węzeł, dla którego ma zostać ustawiona data planowanego wycofania publikacji"

msgid "The date for unpublishing"
msgstr "Data wycofania publikacji"

msgid "The date when Scheduler will unpublish the node"
msgstr "Data określająca, kiedy program planujący wycofa publikację węzła"

msgid "Unpublish a content item immediately"
msgstr "Natychmiast wycofaj opublikowanie elementu treści"

msgid "The node to be unpublished now"
msgstr "Węzeł, którego publikacja ma zostać teraz wycofana"

