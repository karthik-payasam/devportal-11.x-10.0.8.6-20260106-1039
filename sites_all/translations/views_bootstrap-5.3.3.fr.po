msgid "@style style will not display without the \"@field\" setting."
msgstr "Le style @style ne s'affichera pas sans le paramètre \"@field\". "

msgid "About"
msgstr "À propos"

msgid "The <a href=\":bootstrap\">Views Bootstrap module</a> adds styles to Views to output the results of a view as several common <a href=\":components\">Twitter Bootstrap</a> components."
msgstr "Le <a href=\":bootstrap\">module Bootstrap pour les vues</a> ajoute des styles aux vues pour générer les résultats d'une vue sous la forme de plusieurs composants <a href=\":components\">Twitter Bootstrap</a> communs."

msgid "Uses"
msgstr "Utilisations"

msgid "<a href=\":views\">Create a view</a> using one of the following styles:"
msgstr "<a href=\":views\">Créez une vue</a> avec l'un des styles suivants :"

msgid "<a href=\":docs\">Accordion</a>"
msgstr "<a href=\":docs\">Accordéon</a>"

msgid "<a href=\":docs\">Cards</a>"
msgstr "<a href=\":docs\">Cartes</a>"

msgid "<a href=\":docs\">Carousel</a>"
msgstr "<a href=\":docs\">Carrousel</a>"

msgid "<a href=\":docs\">Dropdown</a>"
msgstr "<a href=\":docs\">Liste déroulante</a>"

msgid "<a href=\":docs\">Grid</a>"
msgstr "<a href=\":docs\">Grille</a>"

msgid "<a href=\":docs\">Thumbnails</a>"
msgstr "<a href=\":docs\">Miniatures</a>"

msgid "<a href=\":docs\">Tables</a>"
msgstr "<a href=\":docs\">Tables</a>"

msgid "<a href=\":docs\">Tabs</a>"
msgstr "<a href=\":docs\">Onglets</a>"

msgid "<a href=\":docs\">Media object</a>"
msgstr "<a href=\":docs\">Objet média</a>"

msgid "<a href=\":docs\">List group</a>"
msgstr "<a href=\":docs\">Groupe de liste</a>"

msgid "Views Bootstrap"
msgstr "Amorçage des vues"

msgid "Views Twitter Bootstrap Components."
msgstr "Composants Bootstrap Twitter pour les vues."

msgid "Views"
msgstr "Vues"

msgid "The Bootstrap accordion displays content in collapsible panels (<a href=\":docs\">see documentation</a>)."
msgstr "Le style accordéon pour le module Bootstrap affiche le contenu dans des panneaux extensibles (<a href=\":docs\">voir la documentation</a>)."

msgid "Panel title field"
msgstr "Zone de titre de panneau "

msgid "Select the field that will be used as the accordion panel titles."
msgstr "Sélectionnez la zone à utiliser comme titre pour les panneaux de l'accordéon."

msgid "Label field"
msgstr "Champ étiquette"

msgid "- None -"
msgstr "- Aucun(e) -"

msgid "Select the field that will be used as the label."
msgstr "Sélectionnez la zone qui sera utilisée comme libellé."

msgid "Collapse Options"
msgstr "Réduire les options"

msgid "All Items Closed"
msgstr "Tous les éléments fermés"

msgid "First Item Open"
msgstr "Premier élément ouvert"

msgid "All Items Open"
msgstr "Tous les éléments ouverts"

msgid "Default panel state for collapse behavior."
msgstr "Etat du panneau par défaut pour le comportement de réduction."

msgid "Bootstrap Accordion"
msgstr "Accordéon Bootstrap"

msgid "Displays rows in a Bootstrap Accordion."
msgstr "Affiche les lignes dans l'accordéon Bootstrap. "

msgid "Card title field"
msgstr "Zone d'intitulé de carte"

msgid "Select the field that will be used for the card title."
msgstr "Sélectionnez la zone à utiliser pour l'intitulé de carte."

msgid "Card content field"
msgstr "Zone de contenu de carte"

msgid "Select the field that will be used for the card content."
msgstr "Sélectionnez la zone à utiliser pour le contenu de carte."

msgid "Card image field"
msgstr "Zone d'image de carte"

msgid "Select the field that will be used for the card image."
msgstr "Sélectionnez la zone à utiliser pour l'image de carte."

msgid "Custom card group class"
msgstr "Classe de groupe de cartes personnalisées"

msgid "Additional classes to provide on the card group. Separated by a space."
msgstr "Classes supplémentaires à fournir sur le groupe de cartes. Séparées par une espace."

msgid "Additional classes to provide on each card. Separated by a space."
msgstr "Classes supplémentaires à fournir sur chaque carte. Séparées par une espace."

msgid "Bootstrap Cards"
msgstr "Cartes Bootstrap"

msgid "Displays rows in a Bootstrap Card Group layout"
msgstr "Affiche les lignes dans une présentation groupée de cartes Bootstrap"

msgid "The Bootstrap carousel displays content as a slideshow (<a href=\":docs\">see documentation</a>)."
msgstr "Le style Carrousel pour le module Bootstrap affiche le contenu sous la forme de diaporama (<a href=\":docs\">voir la documentation</a>)."

msgid "<None>"
msgstr "-Aucun-"

msgid "Interval"
msgstr "Intervalle"

msgid "The amount of time to delay between automatically cycling an item. If false, carousel will not automatically cycle."
msgstr "Intervalle entre les cycles automatiques d'un élément. Si la valeur est false, aucun cycle automatique n'est déclenché pour le carrousel. "

msgid "Show navigation"
msgstr "Montrer la navigation"

msgid "Show indicators"
msgstr "Afficher les indicateurs"

msgid "Pause on hover"
msgstr "Pause au survol"

msgid "Pauses the cycling of the carousel on mouseenter and resumes the cycling of the carousel on mouseleave."
msgstr "Interrompt le cycle du carrousel en cas d'événement mouseenter et le reprend en cas d'événement mouseleave. "

msgid "Wrap"
msgstr "Envelopper"

msgid "The carousel should cycle continuously or have hard stops."
msgstr "Le cycle du carrousel doit être continu ou s'arrêter à la dernière diapositive. "

msgid "Columns"
msgstr "Colonnes"

msgid "The number of columns to include in the carousel."
msgstr "Nombre de colonnes à inclure dans le carrousel."

msgid "Breakpoints"
msgstr "Points d'arrêt"

msgid "The min-width breakpoint of the multicolumn carousel."
msgstr "Point d'arrêt de largeur minimale du carrousel à plusieurs colonnes."

msgid "Extra Small"
msgstr "Très petit"

msgid "Small"
msgstr "Petit"

msgid "Medium"
msgstr "Moyen"

msgid "Large"
msgstr "Grand"

msgid "Display"
msgstr "Affichage"

msgid "Select by fields"
msgstr "Sélectionner par zones"

msgid "Display fields as row content"
msgstr "Afficher les zones en tant que contenu de ligne"

msgid "Displaying fields as row content will output the field rows as unformatted values within each carousel item."
msgstr "L'affichage des zones en tant que contenu de ligne génère les lignes de zone sous forme de valeurs non formatées dans chaque élément de carrousel."

msgid "Image"
msgstr "Image"

msgid "Title"
msgstr "Titre"

msgid "Description"
msgstr "Description"

msgid "Bootstrap Carousel"
msgstr "Carrousel Bootstrap "

msgid "Displays rows in a Bootstrap Carousel."
msgstr "Affiche les lignes dans un carrousel Bootstrap. "

msgid "The Bootstrap dropdown style displays a list of links in a drop-down menu format (<a href=\":docs\">see documentation</a>)."
msgstr "Le style Liste déroulante du module Bootstrap affiche une liste de liens sous la forme de menu déroulant (<a href=\":docs\">voir la documentation</a>)."

msgid "Button text"
msgstr "Texte du bouton"

msgid "Text label for the button that is the drop-down toggle."
msgstr "Libellé de texte du bouton constituant la liste déroulante."

msgid "Button class"
msgstr "Classe de bouton"

msgid "Classes for the button that is the drop-down toggle."
msgstr "Classes du bouton constituant la liste déroulante."

msgid "Default"
msgstr "Par défaut"

msgid "Primary"
msgstr "Primaire"

msgid "Success"
msgstr "Succès"

msgid "Info"
msgstr "Info"

msgid "Warning"
msgstr "Avertissement"

msgid "Danger"
msgstr "Danger"

msgid "Wrapper class"
msgstr "Classe de l'enveloppe (wrapper)"

msgid "The class to provide on the wrapper, outside the list."
msgstr "La classe à appliquer à l'enveloppe (wrapper) de la liste."

msgid "List class"
msgstr "Classe de la liste"

msgid "The class to provide on the list element itself."
msgstr "La classe à appliquer à l'élément liste lui-même."

msgid "Bootstrap Dropdown"
msgstr "Liste déroulante du module Bootstrap"

msgid "Displays rows in a Bootstrap Dropdown."
msgstr "Affiche les lignes dans une liste déroulante du module Bootstrap."

msgid "The Bootstrap grid displays content in a responsive, mobile first fluid grid (<a href=\":docs\">see documentation</a>)."
msgstr "Le style Grille du module Bootstrap affiche le contenu dans une grille mobile, fluide et réactive (<a href=\":docs\">voir la documentation</a>)."

msgid "Alignment"
msgstr "Alignement"

msgid "Horizontal"
msgstr "Horizontal"

msgid "Vertical"
msgstr "Vertical"

msgid ""
"Horizontal alignment will place items starting in the upper left and moving right.\n"
"      Vertical alignment will place items starting in the upper left and moving down."
msgstr ""
"L'alignement horizontal place les éléments en commençant dans le coin supérieur gauche et en se déplaçant vers la droite.\n"
"      L'alignement vertical positionne les éléments depuis le coin supérieur gauche et en allant vers le bas."

msgid "Default column classes"
msgstr "Classes de colonne par défaut"

msgid "Add the default views column classes like views-col, col-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Ajouter au rendu des colonnes les classes par défaut de Views comme views-col, col-1 et clearfix. Vous pouvez utiliser ceci pour rapidement réduire la quantité de code fourni par défaut par la vue mais cela peut complexifier le CSS."

msgid "Custom column class"
msgstr "Classe de colonne personnalisée"

msgid "Additional classes to provide on each column. Separated by a space."
msgstr "Classes supplémentaires pour chaque colonne. Séparées par un espace."

msgid "You may use field tokens from as per the \"Replacement patterns\" used in \"Rewrite the output of this field\" for all fields."
msgstr "Vous pouvez utiliser les jetons de champs conformément aux \"Modèles de remplacement\" utilisés dans \"Réécrire la sortie de ce champ\" pour tous les champs."

msgid "Default row classes"
msgstr "Classes de ligne par défaut"

msgid "Adds the default views row classes like views-row, row-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Ajoute au rendu des lignes les classes par défaut de Views comme views-row, row-1 et clearfix. Vous pouvez utiliser ceci pour rapidement réduire la quantité de code fourni par défaut par la vue mais cela peut complexifier le CSS."

msgid "Custom row class"
msgstr "Classe de ligne personnalisée"

msgid "Additional classes to provide on each row. Separated by a space."
msgstr "Classes supplémentaires pour chaque ligne. Séparées par un espace."

msgid "Base number of columns"
msgstr "Nombre de base de colonnes"

msgid "all"
msgstr "tous"

msgid "Choose the number of columns that views will wrap in a single row. This will be reflected in the HTML structure rendered regardless of the device size. If selecting \"all\" then use the alternative template."
msgstr "Choisissez le nombre de colonnes que les vues vont encapsuler dans une seule ligne. Cela sera reflété dans la structure HTML affichée, quelle que soit la taille de l'unité. Si vous sélectionnez \"all\", utilisez le modèle alternatif."

msgid "Number of columns (col-@size)"
msgstr "Nombre de colonnes (col-@size)"

msgid "This adds col-@size to the div."
msgstr "Cette action ajoute col-@size à l'élément div."

msgid "Bootstrap Grid"
msgstr "Grille Bootstrap"

msgid "Displays rows in a Bootstrap Grid layout"
msgstr "Affiche les lignes dans une disposition en grille Bootstrap "

msgid "The Bootstrap list group displays content in an unordered list with list group classes (<a href=\":docs\">see documentation</a>)."
msgstr "Le style Groupe de liste du module Bootstrap affiche le contenu dans une liste non triée avec les classes de groupe de liste (<a href=\":docs\">voir la documentation</a>)."

msgid "Set group field in panel heading"
msgstr "Définir la zone de groupe dans l'en-tête de panneau"

msgid "Title field"
msgstr "Champ titre"

msgid "Select the field that will be used as the title."
msgstr "Choisir le champ qui sera utilisé comme titre."

msgid "Bootstrap List Group"
msgstr "Groupe de liste Bootstrap "

msgid "Displays rows in a Bootstrap List Group."
msgstr "Affiche les lignes dans un groupe de liste Bootstrap. "

msgid "The Bootstrap media object displays content with an image item lead with heading and text (<a href=\":docs\">see documentation</a>)."
msgstr "L'objet média du module Bootstrap affiche le contenu avec une image précédée d'un en-tête et de texte (<a href=\":docs\">voir la documentation</a>)."

msgid "Heading field"
msgstr "Zone d'en-tête "

msgid "Select the field that will be used as the media object heading. Exclude this field from display to prevent duplication."
msgstr "Sélectionnez la zone à utiliser comme en-tête de l'objet média. Excluez cette zone de l'affichage afin d'empêcher la duplication."

msgid "Image field"
msgstr "Champ image"

msgid "Select the field that will be used as the media object image. Exclude this field from display to prevent duplication."
msgstr "Sélectionnez la zone à utiliser comme image de l'objet média. Excluez cette zone de l'affichage afin d'empêcher la duplication."

msgid "Body field"
msgstr "Champs Corps"

msgid "All fields that are not excluded from display will be shown as the body."
msgstr "Toutes les zones qui ne sont pas exclues de l'affichage seront affichées comme corps."

msgid "Image Alignment"
msgstr "Alignement de l'image"

msgid "Left"
msgstr "Gauche"

msgid "Right"
msgstr "Droit"

msgid "Middle"
msgstr "Milieu"

msgid "Align the media object image left or right."
msgstr "Alignez l'image de l'objet média à gauche ou à droite. "

msgid "Bootstrap Media Object"
msgstr "Objet média Bootstrap "

msgid "Displays rows in a Bootstrap Media Object."
msgstr "Affiche les lignes dans un objet média Bootstrap. "

msgid "The Bootstrap panels displays content in a box with optional header and footer elements (<a href=\":docs\">see documentation</a>)."
msgstr "Les panneaux du module Bootstrap affichent du contenu dans une zone avec des éléments d'en-tête et de pied de page facultatifs (<a href=\":docs\">voir la documentation</a>)."

msgid "Contextual class"
msgstr "Classe contextuelle"

msgid "<a href=\":docs\">see Bootstrap documentation</a>"
msgstr "<a href=\":docs\">Voir la documentation du module Bootstrap</a>"

msgid "Select the field that will be used as the panel heading titles."
msgstr "Sélectionnez la zone qui sera utilisée comme titre pour l'en-tête de panneau."

msgid "Panel footer field"
msgstr "Zone de pied de page de panneau"

msgid "Select the field that will be used as the panel footer."
msgstr "Sélectionnez la zone qui sera utilisée comme pied de page de panneau."

msgid "Bootstrap Panels"
msgstr "Panneaux du module Bootstrap"

msgid "Displays rows in a Bootstrap Panel."
msgstr "Affiche les lignes dans un panneau de module Bootstrap."

msgid "The Bootstrap tabs displays content with tab titles linked to dynamically displayed content (<a href=\":docs\">see documentation</a>)."
msgstr "Les onglets du module Bootstrap affichent du contenu avec des titres d'onglet liés au contenu affiché dynamiquement (<a href=\":docs\">voir la documentation</a>)."

msgid "Tab field"
msgstr "Champ de l'onglet"

msgid "Select the field that will be used as the tab."
msgstr "Sélectionnez la zone à utiliser comme onglet. "

msgid "Tab Type"
msgstr "Type d'onglet"

msgid "Tabs"
msgstr "Onglets"

msgid "Pills"
msgstr "Pastilles"

msgid "List"
msgstr "Lister"

msgid "Position of tabs"
msgstr "Emplacement des onglets"

msgid "Tabs/pills on the top"
msgstr "Onglets/pastilles dans la partie supérieure"

msgid "Tabs/pills on the left"
msgstr "Onglets/pastilles sur la partie gauche"

msgid "Tabs/pills on the right"
msgstr "Onglets/pastilles sur la partie droite"

msgid "Tabs/pills on the bottom"
msgstr "Onglets/pastilles dans la partie inférieure"

msgid "Tabs/pills justified on the top"
msgstr "Onglets/pastilles justifiés en haut"

msgid "Tabs/pills stacked"
msgstr "Onglets/pastilles empilés"

msgid "Fade Effect"
msgstr "Effet de fondu"

msgid "Add a fade in effect when tabs clicked"
msgstr "Ajouter un effet de fondu lorsque vous cliquez sur les onglets"

msgid "Bootstrap Tabs"
msgstr "Onglet du module Bootstrap"

msgid "Displays rows in Bootstrap Tabs."
msgstr "Affiche les lignes dans des onglets Bootstrap. "

msgid "The Bootstrap table style adds default Bootstrap table classes and optional classes (<a href=\":docs\">see documentation</a>)."
msgstr "Le style Tables du module Bootstrap ajoute des classes de table Bootstrap par défaut et des classes facultatives (<a href=\":docs\">voir la documentation</a>)."

msgid "Responsive"
msgstr "Adaptatif"

msgid "To make a table scroll horizontally on small devices."
msgstr "Permet de faire défiler une table horizontalement sur les petits périphériques. "

msgid "Bootstrap styles"
msgstr "Styles Bootstrap "

msgid "Striped"
msgstr "Rayé"

msgid "Bordered"
msgstr "Avec bordure"

msgid "Hover"
msgstr "Survol"

msgid "Condensed"
msgstr "Condensé "

msgid "Caption for the table"
msgstr "Légende de la table"

msgid "A title semantically associated with your table for increased accessibility."
msgstr "Titre sémantiquement associé à votre table pour une meilleure accessibilité."

msgid "Table details"
msgstr "Détails de la table"

msgid "Summary title"
msgstr "Titre récapitulatif"

msgid "Table description"
msgstr "Description de la table"

msgid "Provide additional details about the table to increase accessibility."
msgstr "Fournissez des détails supplémentaires sur la table pour augmenter l'accessibilité."

msgid "Bootstrap Table"
msgstr "Table Bootstrap "

msgid "Displays rows in a Bootstrap table."
msgstr "Affiche les lignes dans une table Bootstrap. "

msgid "The Bootstrap thumbnails extends the grid display with the thumbnail component to showcase linked images (<a href=\":docs\">see documentation</a>)."
msgstr "Le style Miniatures du module Bootstrap étendent l'affichage de grille avec le composant de miniature pour présenter les images liées (<a href=\":docs\">voir la documentation</a>)."

msgid "Bootstrap Thumbnails"
msgstr "Vignettes Bootstrap"

msgid "Displays rows in a Bootstrap Grid layout with thumbnails"
msgstr "Affiche les lignes dans une disposition en grille Bootstrap avec des miniatures"

msgid "Previous"
msgstr "Précédent"

msgid "Next"
msgstr "Suivant"

