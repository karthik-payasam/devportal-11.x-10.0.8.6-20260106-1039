msgid "All Product entries deleted."
msgstr "Se han suprimido todas las entradas de producto."

msgid "Drush @func No Product provided"
msgstr "Drush @func No se ha proporcionado ningún producto"

msgid "Drush DeleteProduct deleted Product @prod"
msgstr "Drush DeleteProduct ha suprimido el producto @prod"

msgid "Drush DeleteProduct could not find Product @prod"
msgstr "Drush DeleteProduct no ha podido hallar el producto @prod"

msgid "Drush DeleteProduct deleted retired API @api"
msgstr "Drush DeleteProduct ha suprimido la API retirada @api"

msgid "Drush DeleteProduct No Product provided."
msgstr "Drush DeleteProduct No se ha proporcionado ningún producto."

msgid "Drush product supersede : found a product in a strange lifecycle state '@state'. Expected 'published' or 'deprecated'."
msgstr "Reemplazo de producto Drush: se ha encontrado un producto en un estado de ciclo de vida extraño '@state'. Se esperaba 'publicado' o 'en desuso'."

msgid "Drush SupersedeProduct deleted retired API @api"
msgstr "Drush SupersedeProduct ha suprimido la API @api retirada"

msgid "Drush product supersede : incorrect number of applications with url '@url' found. Should be 1 but was @count."
msgstr "Reemplazo de producto Drush: el número de aplicaciones encontradas con el url '@url' no es correcto. Debe ser 1, pero es @count."

msgid "Drush product supersede : incorrect number of products found. Should be 2 but was @count."
msgstr "Reemplazo de producto Drush: el número de productos encontrados no es correcto. Debe ser 2 pero es @count."

msgid "Drush product supersede : no content provided."
msgstr "Reemplazo de producto Drush: no se ha proporcionado contenido."

msgid "Drush ReplaceProduct deleted retired API @api"
msgstr "Drush ReplaceProduct ha suprimido la API @api retirada"

msgid "Drush product replace : found a product in a strange lifecycle state '@state'. Expected 'published', 'deprecated' or 'retired'."
msgstr "Sustitución de producto Drush: se ha encontrado un producto en un estado de ciclo de vida extraño '@state'. Se esperaba 'publicado', 'en desuso' o 'retirado'."

msgid "Drush product replace : incorrect number of products found. Should be 2 but was @count."
msgstr "Sustitución de producto Drush: el número de productos encontrados no es correcto. Debe ser 2 pero es @count."

