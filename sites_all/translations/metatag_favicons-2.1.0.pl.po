msgid "Favicons & touch icons"
msgstr "Ikony favicon i dotyku"

msgid "A PNG image that is 60px wide by 60px high. Used with the non-Retina iPhone, iPod Touch, and Android 2.1+ devices."
msgstr "Obraz PNG o szerokości 60 px i wysokości 60 px. Używany na urządzeniach iPhone z ekranem innym niż Retina, iPod Touch i Android 2.1+."

msgid "A PNG image that is 114px wide by 114px high. Used with iPhone with @2x display running iOS <= 6."
msgstr "Obraz PNG o szerokości 114 px i wysokości 114 px. Używany na telefonach iPhone z ekranem @2x i systemem iOS <= 6."

msgid "A PNG image that is 120px wide by 120px high. Used with iPhone with @2x display running iOS >= 7."
msgstr "Obraz PNG o szerokości 120 px i wysokości 120 px. Używany na telefonach iPhone z ekranem @2x i systemem iOS >= 7."

msgid "A PNG image that is 144px wide by 144px high. Used with iPad with @2x display running iOS <= 6."
msgstr "Obraz PNG o szerokości 144 px i wysokości 144 px. Używany na tabletach iPad z ekranem @2x i systemem iOS <= 6."

msgid "A PNG image that is 152px wide by 152px high. Used with iPad with @2x display running iOS >= 7."
msgstr "Obraz PNG o szerokości 152 px i wysokości 152 px. Używany na tabletach iPad z ekranem @2x i systemem iOS >= 7."

msgid "A PNG image that is 180px wide by 180px high. Used with iPhone 6 Plus with @3x display."
msgstr "Obraz PNG o szerokości 180 px i wysokości 180 px. Używany na telefonie iPhone 6 Plus z ekranem @3x."

msgid "A PNG image that is 72px wide by 72px high. Used with the iPad mini and the first- and second-generation iPad (@1x display) on iOS <= 6."
msgstr "Obraz PNG o szerokości 72 px i wysokości 72 px. Używany na tabletach iPad mini oraz iPad 1. i 2. generacji (ekran @1x) z systemem iOS <= 6."

msgid "A PNG image that is 76px wide by 76px high. Used with the iPad mini and the second-generation iPad (@1x display) on iOS >= 7."
msgstr "Obraz PNG o szerokości 76 px i wysokości 76 px. Używany na tabletach iPad mini oraz iPad 2. generacji (ekran @1x) z systemem iOS >= 7."

msgid "A PNG image that is 57px wide by 57px high. Used with the non-Retina iPhone, iPod Touch, and Android 2.1+ devices."
msgstr "Obraz PNG o szerokości 57 px i wysokości 57 px. Używany na urządzeniach iPhone z ekranem innym niż Retina, iPod Touch i Android 2.1+."

msgid "A PNG image that is 16px wide by 16px high."
msgstr "Obraz PNG o szerokości 16 px i wysokości 16 px."

msgid "A PNG image that is 192px wide by 192px high."
msgstr "Obraz PNG o szerokości 192 px i wysokości 192 px."

msgid "A PNG image that is 32px wide by 32px high."
msgstr "Obraz PNG o szerokości 32 px i wysokości 32 px."

msgid "A PNG image that is 96px wide by 96px high."
msgstr "Obraz PNG o szerokości 96 px i wysokości 96 px."

msgid "Mask icon color"
msgstr "Kolor ikony maski"

msgid "Color attribute for SVG (mask) icon in hexadecimal format, e.g. '#0000ff'. Setting it will break HTML validation. If not set macOS Safari ignores the Mask Icon entirely, making the Icon: SVG completely useless."
msgstr "Atrybut koloru dla ikony SVG (maska) w formacie szesnastkowym, np. „#0000ff”. Ustawienie tej opcji spowoduje przerwanie sprawdzania poprawności kodu HTML. Jeśli ta opcja nie zostanie ustawiona, przeglądarka macOS Safari zignoruje całkowicie ikonę maski, co sprawia, że ikona SVG będzie całkowicie bezużyteczna."

msgid "Mask icon (SVG)"
msgstr "Ikona maski (SVG)"

msgid "A grayscale scalable vector graphic (SVG) file."
msgstr "Plik skalowalnej grafiki wektorowej (SVG) w skali szarości."

msgid "Default icon"
msgstr "Ikona domyślna"

msgid "The traditional favicon, must be either a GIF, ICO, JPG/JPEG or PNG image."
msgstr "Tradycyjna ikona ulubionych – musi być obrazem w formacie GIF, ICO, JPG/JPEG lub PNG."

