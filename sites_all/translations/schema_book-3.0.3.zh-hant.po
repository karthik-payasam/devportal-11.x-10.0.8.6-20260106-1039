msgid "Schema.org Book"
msgstr "Schema.org 書籍"

msgid "Adds Schema.org/Book to the JSON LD array."
msgstr "將 Schema.org/書籍新增至 JSON LD 陣列。"

msgid "SEO"
msgstr "SEO"

