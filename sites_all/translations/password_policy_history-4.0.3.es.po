msgid "Password Policy History"
msgstr "Historial de política de contraseña"

msgid "Sets up a password constraint to limit repeated use of the same password."
msgstr "Establece una restricción de contraseña para limitar el uso repetido de la misma contraseña."

msgid "Security"
msgstr "Seguridad"

msgid "Previous passwords cannot be reused. Choose a different password."
msgstr "Las contraseñas anteriores no se pueden reutilizar. Elija una contraseña diferente."

msgid "Number of passwords that will be checked in the user password update history"
msgstr "Número de contraseñas que se comprobarán en el historial de actualizaciones de contraseñas de usuario"

msgid "A value of 0 represents that the user can not repeat any of the old passwords."
msgstr "Un valor de 0 representa que el usuario no puede repetir ninguna de las contraseñas antiguas."

msgid "The number of repeated passwords value must be zero or greater."
msgstr "El número de contraseñas repetidas tiene que cero o mayor."

msgid "Number of passwords that will be checked in the user password update history: @number-repeats"
msgstr "Número de contraseñas que se comprobarán en el historial de actualizaciones de contraseñas de usuario: @number-repeats"

msgid "The last @count password cannot be reused. Choose a different password."
msgid_plural "The last @count passwords cannot be reused. Choose a different password."
msgstr[0] "La última contraseña no se puede reutilizar. Elija una contraseña diferente."
msgstr[1] "Las últimas @count contraseñas no se pueden reutilizar. Elija una contraseña diferente."

msgid "Password History"
msgstr "Historial de contraseñas"

msgid "Provide restrictions on previously used passwords."
msgstr "Proporcione restricciones sobre contraseñas utilizadas previamente."

msgid "You have used the same password previously and cannot."
msgstr "Ha utilizado la misma contraseña anteriormente y no puede."

