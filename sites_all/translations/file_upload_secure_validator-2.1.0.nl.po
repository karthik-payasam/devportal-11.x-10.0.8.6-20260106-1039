msgid "About"
msgstr "Over"

msgid "Secure File Upload Mime Detect"
msgstr "Mime-detectie bij Secure File Upload"

msgid "Fileinfo extension"
msgstr "Extensie Fileinfo"

msgid "Found"
msgstr "Gevonden"

msgid "Fileinfo extension not available"
msgstr "Extensie Fileinfo niet beschikbaar"

msgid "File upload secure validator module uses Fileinfo extension. It seems as if Fileinfo extension is not loaded/enabled. If you are using Windows, may be, you should uncomment php_fileinfo.dll in php.ini file."
msgstr "De module File Upload Secure Validator maakt gebruik van de extensie Fileinfo. Het lijkt erop dat de extensie Fileinfo niet geladen of niet ingeschakeld is. Als u met Windows werkt, zou het kunnen zijn dat u de commentaartekens voor php_fileinfo.dll in het bestand php.ini moet verwijderen."

msgid "File Upload Secure Validator"
msgstr "File Upload Secure Validator"

msgid "Secure Mime Detect"
msgstr "Secure Mime Detect"

msgid "Security"
msgstr "Beveiliging"

msgid "Manage the list of MIME types equivalence groups."
msgstr "De lijst van equivalentiegroepen van MIME-typen beheren."

msgid "Administer File Upload Secure Validator configuration"
msgstr "Configuratie van beveiligde validator voor bestand uploaden"

msgid "Allow user to administer File Upload Secure Validator configuration."
msgstr "Gebruiker toestaan om de configuratie van de Secure Validator van het bestand te beheren."

msgid "SettingsForm"
msgstr "SettingsForm"

msgid "MIME types equivalence groups"
msgstr "Equivalentiegroepen voor MIME"

msgid "MIME types equivalence group"
msgstr "Equivalentiegroep voor MIME"

msgid "MIME type"
msgstr "MIME-type"

msgid "MIME types equivalence group(s)"
msgstr "Equivalentiegroep(en) van MIME-typen"

msgid "A CSV-like list of MIME types groups; if two MIME types are part of the same group, then, File Upload Secure Validator will not protest."
msgstr "Een CSV-achtige lijst van groepen MIME-typen; als twee MIME-typen deel uitmaken van dezelfde groep, dan volgt geen bezwaar van File Upload Secure Validator."

msgid "Caught an InvalidArgumentException; cannot validate missing file requested as @path"
msgstr "Er is een uitzondering opgetreden bij InvalidArgument; kan het ontbrekende bestand dat is aangevraagd als @path, niet valideren."

msgid "There was a problem with this file. The uploaded file is of type @extension but the real content seems to be @real_extension"
msgstr "Er is een probleem met dit bestand. Het geüploade bestand is van het type @extension maar de echte inhoud lijkt @real_extension te zijn"

msgid "Error while uploading file: MimeTypeGuesser guessed '%mime_by_fileinfo' and fileinfo '%mime_by_filename'"
msgstr "Fout bij uploaden van bestand: MimeTypeGuesser gokte op '%mime_by_fileinfo' en fileinfo '%mime_by_filename'"

