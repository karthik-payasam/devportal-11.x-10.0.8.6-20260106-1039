msgid "Font Awesome IconPicker"
msgstr "Font Awesome IconPicker"

msgid "The fontIconPicker library is installed."
msgstr "Viene installata la libreria fontIconPicker."

msgid "Not installed"
msgstr "Non installato"

msgid "The fontIconPicker library could not be found. To use the Font Awesome Iconpicker, please verify that the fontIconPicker library is installed correctly. Please see the Font Awesome Iconpicker submodule README file for more details."
msgstr "Impossibile trovare la libreria fontIconPicker. Per utilizzare Font Awesome Iconpicker, verificare che la libreria fontIconPicker sia installata correttamente. Per ulteriori dettagli, consultare il file README del modulo secondario Font Awesome Iconpicker."

msgid "Font Awesome Iconpicker Widget"
msgstr "Widget Font Awesome Iconpicker"

msgid "Provides an iconpicker widget for Font Awesome"
msgstr "Fornisce un widget iconpicker per Font Awesome"

msgid "IconPicker already present at @path. No download required."
msgstr "IconPicker già presente in @path. Non è richiesto alcun download."

msgid "Drush was unable to download the fontIconPicker library from @remote."
msgstr "Drush non è stato in grado di scaricare la libreria fontIconPicker da @remote."

msgid "Error: unable to download fontIconPicker library from @remote"
msgstr "Errore: impossibile scaricare la libreria fontIconPicker da @remote"

msgid "fontIconPicker library has been successfully downloaded to @path."
msgstr "la libreria fontIconPicker è stata scaricata correttamente in @path."

msgid "Drush was unable to load the fontIconPicker) library"
msgstr "Drush non è stato in grado di caricare la libreria fontIconPicker)"

msgid "Icon Name"
msgstr "Nome icona"

msgid "Invalid icon"
msgstr "Icona non valida"

