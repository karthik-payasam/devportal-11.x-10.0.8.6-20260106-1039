msgid "<a href=\":fontawesome_url\">Font Awesome</a> is an iconic font and CSS toolkit. Font Awesome gives you scalable vector icons that can instantly be customized — size, color, drop shadow, and anything that can be done with the power of CSS. For more information on how to use Font Awesome, see the <a href=\":fontawesome_examples_page\">Font Awesome Examples page</a>."
msgstr "<a href=\":fontawesome_url\">Font Awesome</a> 是一个标志性字体和 CSS 工具箱。 Font Awesome 为您提供了可即时定制的可扩展向量图标 - 大小、颜色、阴影以及任何可以借助 CSS 的力量完成的任务。 有关如何使用 Font Awesome 的更多信息，请参阅<a href=\":fontawesome_examples_page\">“Font Awesome 示例”页面</a>。"

msgid "The Font Awesome library could not be found. Please verify Font Awesome is installed correctly or that the CDN has been activated and properly configured. Please see the @adminPage and the Font Awesome module README file for more details."
msgstr "找不到 Font Awesome 库。 请验证是否正确安装了 Font Awesome，或者是否已激活并正确配置 CDN。 请参阅 @adminPage 和 Font Awesome 模块自述文件，以获取更多详细信息。"

msgid "admin page"
msgstr "管理页面"

msgid "HTML Markup"
msgstr "HTML 标记"

msgid "Choose the HTML markup tag that Font Awesome icons should be created with. Typically, this is a %tag tag, however it can be changed to suite the theme requirements."
msgstr "选择用于创建 Font Awesome 图标的 HTML 标记。 通常，这是一个 %tag 标记，但是可以进行更改以适合主题需求。"

msgid "Font Awesome"
msgstr "Font Awesome"

msgid "Library being loaded manually"
msgstr "正在手动装入库"

msgid "The Font Awesome module is configured not to load the Font Awesome library. If this is an error, please see the @adminPage and the Font Awesome module README file for more details."
msgstr "Font Awesome 模块配置为不装入 Font Awesome 库。 如果这是错误，请参阅 @adminPage 和 Font Awesome 模块自述文件，以获取更多详细信息。"

msgid "Webfonts with CSS"
msgstr "使用 CSS 的 Web 字体"

msgid "CDN SVG with JS"
msgstr "使用 JS 的 CDN SVG"

msgid "SVG with JS"
msgstr "使用 JS 的 SVG"

msgid "All icons loaded"
msgstr "已装入所有图标"

msgid "Solid icons loaded"
msgstr "已装入实心图标"

msgid "Regular icons loaded"
msgstr "已装入常规图标"

msgid "Light icons loaded"
msgstr "已装入浅色图标"

msgid "Brands icons loaded"
msgstr "已装入品牌图标"

msgid "Font Awesome library is installed. Using %version version. (@moreInfoLink)"
msgstr "已安装 Font Awesome 库。 正在使用 %version 版本。(@moreInfoLink)"

msgid "more information"
msgstr "更多信息"

msgid "Not installed"
msgstr "未安装"

msgid "The Font Awesome library could not be found. If you want this module to handle loading your FontAwesome assets, please verify Font Awesome is installed correctly or that the CDN has been activated and properly configured. Please see the @adminPage and the Font Awesome module README file for more details."
msgstr "找不到 Font Awesome 库。 如果您希望使用此模块处理装入 FontAwesome 资产的操作，请验证是否正确安装了 Font Awesome，或者是否已激活并正确配置 CDN。 请参阅 @adminPage 和 Font Awesome 模块自述文件，以获取更多详细信息。"

msgid "The most popular icon set and toolkit on the web."
msgstr "Web 上最常用的图标集和工具箱。"

msgid "Font Awesome Settings"
msgstr "Font Awesome 设置"

msgid "Global settings for the display of Font Awesome icons."
msgstr "显示 Font Awesome 图标的全局设置。"

msgid "Access fontawesome additional settings"
msgstr "访问 fontawesome 其他设置"

msgid "Grants access to the additional settings in fontawesome fields type. Without this permission, only the icon can be selected."
msgstr "授予对 fontawesome 字段类型中其他设置的访问权。 如果没有此许可权，那么只能选择图标。"

msgid "Font Awesome settings"
msgstr "Font Awesome 设置"

msgid "Add Font Awesome Icon"
msgstr "添加 Font Awesome 图标"

msgid "Tag used for Font Awesome elements"
msgstr "用于 Font Awesome 元素的标记"

msgid "Method used for delivering Font Awesome"
msgstr "用于传送 Font Awesome 的方法"

msgid "Let module handle loading FontAwesome assets"
msgstr "让模块处理装入 FontAwesome 资产的操作"

msgid "Use CDN to serve Font Awesome"
msgstr "使用 CDN 为 Font Awesome 提供服务"

msgid "Location of the external CDN for Font Awesome"
msgstr "Font Awesome 外部 CDN 的位置"

msgid "Use Shim File for v4 compatibility"
msgstr "使用 Shim 文件实现 v4 兼容性"

msgid "Location of the external CDN for Font Awesome shim file"
msgstr "Font Awesome shim 文件的外部 CDN 的位置"

msgid "Allow CSS pseudo elements with webfonts"
msgstr "允许使用 Web 字体的 CSS 伪元素"

msgid "Use the Font Awesome solid icons file"
msgstr "使用 Font Awesome 实心图标文件"

msgid "Use the Font Awesome regular icons file"
msgstr "使用 Font Awesome 常规图标文件"

msgid "Use the Font Awesome light icons file"
msgstr "使用 Font Awesome 浅色图标文件"

msgid "Use the Font Awesome brands icons file"
msgstr "使用 Font Awesome 品牌图标文件"

msgid "Use the Font Awesome duotone icons file"
msgstr "使用 Font Awesome 双色调图标文件"

msgid "Use the Font Awesome thin icons file"
msgstr "使用 Font Awesome 瘦体图标文件"

msgid "Integrity value of the external CDN for Font Awesome"
msgstr "Font Awesome 外部 CDN 的完整性值"

msgid "Bypass Font Awesome validation"
msgstr "绕过 Font Awesome 验证"

msgid "Use the Font Awesome sharp regular icons file"
msgstr "使用 Font Awesome 锐利常规图标文件"

msgid "Use the Font Awesome sharp light icons file"
msgstr "使用 Font Awesome 锐利浅色图标文件"

msgid "Use the Font Awesome sharp solid icons file"
msgstr "使用 Font Awesome 锐利实心图标文件"

msgid "Use the Font Awesome custom icons file"
msgstr "使用 Font Awesome 定制图标文件"

msgid "Font Awesome Icon formatter settings"
msgstr "Font Awesome 图标格式化程序设置"

msgid "Display multi-value fields as layers?"
msgstr "将多值字段显示为层？"

msgid "Font Awesome IconPicker"
msgstr "Font Awesome IconPicker"

msgid "The fontIconPicker library is installed."
msgstr "已安装 fontIconPicker 库。"

msgid "The fontIconPicker library could not be found. To use the Font Awesome Iconpicker, please verify that the fontIconPicker library is installed correctly. Please see the Font Awesome Iconpicker submodule README file for more details."
msgstr "找不到 fontIconPicker 库。 要使用 Font Awesome Iconpicker，请验证是否正确安装了 fontIconPicker 库。 请参阅 Font Awesome Iconpicker 子模块自述文件以获取更多详细信息。"

msgid "Font Awesome Iconpicker Widget"
msgstr "Font Awesome Iconpicker 窗口小部件"

msgid "Provides an iconpicker widget for Font Awesome"
msgstr "为 Font Awesome 提供图标选取器窗口小部件"

msgid "IconPicker already present at @path. No download required."
msgstr "@path 处已存在 IconPicker。 无需下载。"

msgid "Drush was unable to download the fontIconPicker library from @remote."
msgstr "Drush 无法从 @remote 下载 fontIconPicker 库。"

msgid "Error: unable to download fontIconPicker library from @remote"
msgstr "错误：无法从 @remote 下载 fontIconPicker 库"

msgid "fontIconPicker library has been successfully downloaded to @path."
msgstr "已将 fontIconPicker 库成功下载到 @path。"

msgid "Drush was unable to load the fontIconPicker) library"
msgstr "Drush 无法装入 fontIconPicker 库"

msgid "Icon Name"
msgstr "图标名称"

msgid "Invalid icon"
msgstr "图标无效"

msgid "Font Awesome Media Entity"
msgstr "Font Awesome 媒体实体"

msgid "Adds a Font Awesome Media Entity Type."
msgstr "添加 Font Awesome 媒体实体类型。"

msgid "Name of the Font Awesome Icon. See @iconsLink for valid icon names, or begin typing for an autocomplete list. Note that all four versions of the icon will be shown - Light, Regular, Solid, Duotone, and Thin respectively. If the icon shows a question mark, that icon version is not supported in your version of Fontawesome."
msgstr "Font Awesome 图标的名称。 请参阅 @iconsLink 以获取有效的图标名称，或者开始输入以获取自动补全列表。 请注意，将显示该图标的所有四个版本，分别为浅色、常规、实心、双色调和瘦体。 如果图标显示问号，那么该图标版本在您的 Fontawesome 版本中不受支持。"

msgid "the Font Awesome icon list"
msgstr "Font Awesome 图标列表"

msgid "Add"
msgstr "添加"

msgid "Title"
msgstr "标题"

msgid "Font Awesome Icon"
msgstr "Font Awesome 图标"

msgid "Use a Font Awesome Icon for reusable media."
msgstr "对可复用媒体使用 Font Awesome 图标。"

msgid "Font Awesome already present at @path. No download required."
msgstr "@path 处已存在 Font Awesome。 无需下载。"

msgid "Drush was unable to download the Font Awesome library from @remote."
msgstr "Drush 无法从 @remote 下载 Font Awesome 库。"

msgid "Error: unable to download Fontawesome library from @remote"
msgstr "错误：无法从 @remote 下载 Fontawesome 库"

msgid "Fontawesome library has been successfully downloaded to @path."
msgstr "已将 Fontawesome 库成功下载到 @path。"

msgid "Drush was unable to load the Font Awesome library"
msgstr "Drush 无法装入 Font Awesome 库"

msgid "For more information on icon selection, see @iconLink. If an icon below is displayed with a question mark, it is likely a Font Awesome Pro icon, unavailable with the free version of Font Awesome."
msgstr "有关图标选择的更多信息，请参阅 @iconLink。 如果下面的图标显示有问号，那么很可能是 Font Awesome Pro 图标，不可用于免费版 Font Awesome。"

msgid "Name of the Font Awesome Icon. See @iconsLink for valid icon names, or begin typing for an autocomplete list."
msgstr "Font Awesome 图标的名称。 请参阅 @iconsLink 以获取有效的图标名称，或者开始输入以获取自动补全列表。"

msgid "Additional Font Awesome Settings"
msgstr "其他 Font Awesome 设置"

msgid "Style"
msgstr "样式"

msgid "This changes the style of the icon. Please note that this is not available for all icons, and for some of the icons this is only available in the pro version. If the icon does not render properly in the preview above, the icon does not support that style. Notably, brands do not support any styles. See @iconLink for more information."
msgstr "这会更改图标的样式。 请注意，这并非可用于所有图标，对于某些图标，这仅在 pro 版本中可用。 如果图标未在上面的预览中正确呈现，那么图标不支持该样式。 值得注意的是，品牌不支持任何风格。 请参阅 @iconLink 以获取更多信息。"

msgid "Size"
msgstr "大小"

msgid "This increases icon sizes relative to their container"
msgstr "这会增加图标相对于其容器的大小"

msgid "Default"
msgstr "缺省值"

msgid "Extra Small"
msgstr "超小"

msgid "Small"
msgstr "小"

msgid "Large"
msgstr "大"

msgid "2x"
msgstr "2x"

msgid "3x"
msgstr "3x"

msgid "4x"
msgstr "4x"

msgid "5x"
msgstr "5x"

msgid "6x"
msgstr "6x"

msgid "7x"
msgstr "7x"

msgid "8x"
msgstr "8x"

msgid "9x"
msgstr "9x"

msgid "10x"
msgstr "10x"

msgid "Fixed Width?"
msgstr "固定宽度？"

msgid "Use to set icons at a fixed width. Great to use when different icon widths throw off vertical alignment. Especially useful in things like nav lists and list groups."
msgstr "用于设置固定宽度的图标。 当不同的图标宽度偏离垂直对齐时，非常好用。 在诸如导航列表和列表组之类的内容中特别有用。"

msgid "Border?"
msgstr "边框？"

msgid "Adds a border to the icon."
msgstr "向图标添加边框。"

msgid "Invert color?"
msgstr "反转颜色？"

msgid "Inverts the color of the icon (black becomes white, etc.)"
msgstr "反转图标的颜色（黑色变为白色等）"

msgid "Animation"
msgstr "动画"

msgid "Use spin to get any icon to rotate, and pulse to have it rotate with 8 steps. Works especially well with fa-spinner & everything in the @iconLink."
msgstr "使用旋转以获取要旋转的任何图标，并使用脉冲使其通过 8 个步骤进行旋转。 尤其适用于 @iconLink 中的 fa-spinner 和所有内容。"

msgid "spinner icons category"
msgstr "微调器图标类别"

msgid "None"
msgstr "无"

msgid "Spin"
msgstr "旋转"

msgid "Pulse"
msgstr "脉冲"

msgid "Pull"
msgstr "拉取"

msgid "This setting will pull the icon (float) to one side or the other in relation to its nearby content"
msgstr "此设置会将图标（浮点）拉到与其附近内容相关的一侧或另一侧"

msgid "Left"
msgstr "左边"

msgid "Right"
msgstr "向右"

msgid "Power Transforms"
msgstr "Power Transforms"

msgid "See @iconLink for additional information on Power Transforms. Note that these transforms only work with the SVG with JS version of Font Awesome and are disabled for Webfonts. See the @adminLink to set your version of Font Awesome."
msgstr "请参阅 @iconLink 以获取有关 Power Transforms 的其他信息。 请注意，这些变换仅适用于具有 JS 版本 Font Awesome 的 SVG，并且对 Web 字体禁用。 请参阅 @adminLink 以设置您的 Font Awesome 版本。"

msgid "the Font Awesome `Power Transforms` guide"
msgstr "Font Awesome `Power Transforms` 指南"

msgid "Rotate"
msgstr "旋转"

msgid "Power Transform rotating effects icon angle without changing or moving the container. To rotate icons use any arbitrary value. Units are degrees with negative numbers allowed."
msgstr "Power Transform 旋转效果图标角度，无需更改或移动容器。 要旋转图标，请使用任何任意值。 单位是允许为负数的度数。"

msgid "Flip Horizontal?"
msgstr "水平翻转？"

msgid "Power Transform flipping effects icon reflection without changing or moving the container."
msgstr "Power Transform 翻转效果图标反射，无需更改或移动容器。"

msgid "Flip Vertical?"
msgstr "垂直翻转？"

msgid "Scale"
msgstr "Scale"

msgid "Power Transform scaling effects icon size without changing or moving the container. This field will scale icons up or down with any arbitrary value, including decimals. Units are 1/16em."
msgstr "Power Transform 缩放效果图标大小，无需更改或移动容器。 此字段将使用任何任意值（包括小数）缩放图标。 单位为 1/16em。"

msgid "Scale Type"
msgstr "缩放类型"

msgid "Shrink"
msgstr "缩小"

msgid "Grow"
msgstr "增长"

msgid "Scale Value"
msgstr "标度值"

msgid "Position (Y Axis)"
msgstr "位置（Y 轴）"

msgid "Power Transform positioning effects icon location without changing or moving the container. This field will move icons up or down with any arbitrary value, including decimals. Units are 1/16em."
msgstr "Power Transform 定位效果图标位置，无需更改或移动容器。 此字段将使用任何任意值（包括小数）上下移动图标。 单位为 1/16em。"

msgid "Position Type"
msgstr "位置类型"

msgid "Up"
msgstr "已启用"

msgid "Down"
msgstr "向下"

msgid "Position Value"
msgstr "位置值"

msgid "Position (X Axis)"
msgstr "位置（X 轴）"

msgid "Insert Icon"
msgstr "插入图标"

msgid "Invalid value for Font Awesome Power Transform %value. Please see @iconLink for information on correct values."
msgstr "Font Awesome Power Transform %value 值无效。 请参阅 @iconLink 以获取有关正确值的信息。"

msgid "the Font Awesome guide to Power Transforms"
msgstr "Font Awesome Power Transforms 指南"

msgid "Invalid icon name %value. Please see @iconLink for correct icon names."
msgstr "图标名称 %value 无效。 请参阅 @iconLink 以获取正确的图标名称。"

msgid "Font Awesome Tag"
msgstr "Font Awesome 标记"

msgid "&lt;i&gt;"
msgstr "&lt;i&gt;"

msgid "&lt;span&gt;"
msgstr "&lt;span&gt;"

msgid "Font Awesome works with any consistent HTML element. By default, Font Awesome uses the &lt;i&gt; tag for its icons. However, in some cases you may want to use a different tag for your Font Awesome icons, such as a &lt;span&gt; tag. Changing the value here will change the way the tags are inserted into your site. Manually created Font Awesome tags can use any HTML element you like. Note that changing this setting will require clearing the site cache."
msgstr "Font Awesome 使用任何一致的 HTML 元素。 缺省情况下，Font Awesome 将 &lt;i&gt; 标记用于其图标。 然而，在某些情况下，您可能希望为 Font Awesome 图标使用不同的标记，例如 &lt;span&gt; 标记。 更改此处的值将会更改将标记插入到站点中的方式。 手动创建的 Font Awesome 标记可以使用您喜欢的任何 HTML 元素。 请注意，更改此设置将需要清除站点高速缓存。"

msgid "Font Awesome Method"
msgstr "Font Awesome 方法"

msgid "Web Fonts with CSS"
msgstr "使用 CSS 的 Web 字体"

msgid "This setting controls the way Font Awesome works. SVG with JS is the modern, easy, and powerful version with the most backwards compatibility. Web Fonts with CSS is the classic Font Awesome icon method that you have seen in earlier versions of Font Awesome. We recommend SVG with JS. Please note that the Webfonts with CSS version does not allow backwards compatibility with Font Awesome 4. That means you will need to check your code base to be certain that the icons are all updated to work with version 5. See @gettingStartedLink for more information."
msgstr "此设置控制 Font Awesome 的工作方式。 使用 JS 的 SVG 是一个现代、简单且功能强大的版本，具有最大向后兼容性。 使用 CSS 的 Web 字体是您在较早版本的 Font Awesome 中看到的经典 Font Awesome 图标方法。 我们推荐使用 JS 的 SVG。请注意，使用 CSS 版本的 Web 字体不允许向后兼容 Font Awesome 4。 这意味着您需要检查代码库，以确保图标全都更新为使用 V5。 请参阅 @gettingStartedLink 以获取更多信息。"

msgid "the Font Awesome guide"
msgstr "Font Awesome 指南"

msgid "Allow CSS pseudo-elements?"
msgstr "是否允许 CSS 伪元素？"

msgid "If you do not want to add icons directly in code, you can add them through CSS pseudo-elements. Font Awesome has leveraged the ::before pseudo-element to add icons to a page since the very beginning. For more information on how to use pseudo-elements, see the @pseudoElementsLink. Note that this feature is always available with the Webfonts version of Font Awesome. If you turn this feature on for SVG with JS, it will slow your site down noticeably."
msgstr "如果您不想直接在代码中添加图标，可以通过 CSS 伪元素进行添加。 Font Awesome 从一开始就利用了 ::before 伪元素向页面添加图标。 有关如何使用伪元素的更多信息，请参阅 @pseudoElementsLink。 请注意，此功能始终随 Font Awesome 的 Web 字体版本提供。 如果对使用 JS 的 SVG 开启此功能，那么将明显降低站点速度。"

msgid "Font Awesome guide to pseudo-elements"
msgstr "Font Awesome 伪元素指南"

msgid "Load Font Awesome library?"
msgstr "装入 Font Awesome 库？"

msgid "If enabled, this module will attempt to load the Font Awesome library for you. To prevent loading twice, leave this option disabled if you're including the assets manually or through another module or theme."
msgstr "如果已启用，此模块将尝试为您装入 Font Awesome 库。 要防止装入两次，如果要手动或通过另一个模块或主题包含资产，请将此选项保持禁用状态。"

msgid "External file configuration"
msgstr "外部文件配置"

msgid "These settings control the method by which the Font Awesome library is loaded. You can choose to use an external (full URL) or local (relative path) library by selecting a URL / path below, or you can use a local version of the file by leaving the box unchecked and downloading the library <a href=\":remoteurl\">:remoteurl</a> and installing locally at %installpath. See the README for more information."
msgstr "这些设置用于控制 Font Awesome 库的装入方法。 您可以通过选择下面的 URL/路径来选择使用外部（完整 URL）或本地（相对路径）库，也可以通过使该框保持未选中状态并下载库 <a href=\":remoteurl\">:remoteurl</a> 以及在 %installpath 处进行本地安装来使用本地版本的文件。 请参阅自述文件以获取更多信息。"

msgid "Use external file (CDN) / local file?"
msgstr "是否使用外部文件 (CDN)/本地文件？"

msgid "Checking this box will cause the Font Awesome library to be loaded from the given source rather than from the local library file."
msgstr "选中此框将导致从给定源而不是本地库文件装入 Font Awesome 库。"

msgid "External File Location"
msgstr "外部文件位置"

msgid "Enter a source URL for the external Font Awesome library file you wish to use. Note that this is designed for use with the <strong>SVG with JS</strong> method. Use for the Webfonts method at your own risk. This URL should point to the Font Awesome JS svg file when using <strong>SVG with JS</strong> or it should point to the Font Awesome CSS file when using <strong>Web Fonts with CSS</strong>. Leave blank to use the default Font Awesome CDN."
msgstr "输入要使用的外部 Font Awesome 库文件的源 URL。 请注意，此方法旨在与<strong>使用 JS 的 SVG</strong> 方法配合使用。 用于由您自行承担风险的 Web 字体方法。 当利用<strong>使用 JS 的 SVG</strong> 时，此 URL 应该指向 Font Awesome JS svg 文件，或者当利用<strong>使用 CSS 的 Web 字体</strong>时，它应该指向 Font Awesome CSS 文件。 留空以使用缺省 Font Awesome CDN。"

msgid "External File Integrity Value"
msgstr "外部文件完整性值"

msgid "Enter an (optional) integrity value for checking the CDN. This value should be provided by Font Awesome alongside the CDN source. This will force the browser to confirm the integrity of the CDN to prevent unexpected content from being loaded."
msgstr "输入用于检查 CDN 的（可选）完整性值。 此值应由 Font Awesome 与 CDN 源一起提供。 这将强制浏览器确认 CDN 的完整性，以防止装入意外内容。"

msgid "Partial file configuration"
msgstr "部分文件配置"

msgid "By default, Font Awesome loads all of the icons. However, you can choose to load only some of the icon files if you only want a subset of the available icons. This method can result in reduced file size. These files will be assumed to exist in the same directory as the parent <i>all.js/all.css</i> file."
msgstr "缺省情况下，Font Awesome 会装入所有图标。 但是，如果您只需要可用图标的子集，那么可以选择仅装入部分图标文件。 此方法可减小文件大小。 将假定这些文件与父 <i>all.js/all.css</i> 文件存在于同一目录中。"

msgid "Load solid icons"
msgstr "装入实心图标"

msgid "Checking this box will cause the Font Awesome library to load the file containing the solid icon declarations (<i>solid.js/solid.css</i>)"
msgstr "选中此框将导致 Font Awesome 库装入包含实心图标声明的文件 (<i>solid.js/solid.css</i>)"

msgid "Load regular icons"
msgstr "装入常规图标"

msgid "Checking this box will cause the Font Awesome library to load the file containing the regular icon declarations (<i>regular.js/regular.css</i>)"
msgstr "选中此框将导致 Font Awesome 库装入包含常规图标声明的文件 (<i>regular.js/regular.css</i>)"

msgid "Load light icons"
msgstr "装入浅色图标"

msgid "Checking this box will cause the Font Awesome library to load the file containing the light icon declarations (<i>light.js/light.css</i>). Note that this a Pro-only feature."
msgstr "选中此框将导致 Font Awesome 库装入包含浅色图标声明的文件 (<i>light.js/light.css</i>)。 请注意，这是仅限于 Pro 的功能部件。"

msgid "Load brand icons"
msgstr "装入品牌图标"

msgid "Checking this box will cause the Font Awesome library to load the file containing the brands icon declarations (<i>brands.js/brands.css</i>)"
msgstr "选中此框将导致 Font Awesome 库装入包含品牌图标声明的文件 (<i>brands.js/brands.css</i>)"

msgid "Load duotone icons"
msgstr "装入双色调图标"

msgid "Checking this box will cause the Font Awesome library to load the file containing the duotone icon declarations (<i>duotone.js/duotone.css</i>)"
msgstr "选中此框将导致 Font Awesome 库装入包含双色调图标声明的文件 (<i>duotone.js/duotone.css</i>)"

msgid "Load thin icons"
msgstr "装入瘦体图标"

msgid "Checking this box will cause the Font Awesome library to load the file containing the thin icon declarations (<i>thin.js/thin.css</i>)"
msgstr "选中此框将导致 Font Awesome 库装入包含瘦体图标声明的文件 (<i>thin.js/thin.css</i>)"

msgid "Load sharp regular icons"
msgstr "装入锐利常规图标"

msgid "Checking this box will cause the Font Awesome library to load the file containing the sharp regular icon declarations (<i>sharp-regular.js/sharp-regular.css</i>)"
msgstr "选中此框将导致 Font Awesome 库装入包含锐利常规图标声明的文件 (<i>sharp-regular.js/sharp-regular.css</i>)"

msgid "Load sharp light icons"
msgstr "装入锐利浅色图标"

msgid "Checking this box will cause the Font Awesome library to load the file containing the sharp light icon declarations (<i>sharp-light.js/sharp-light.css</i>)"
msgstr "选中此框将导致 Font Awesome 库装入包含锐利浅色图标声明的文件 (<i>sharp-light.js/sharp-light.css</i>)"

msgid "Load sharp solid icons"
