msgid "Restrict by IP settings"
msgstr "Omezit podle nastavení IP"

msgid "Enter IP Address Ranges in CIDR Notation separated with semi-colons, with no trailing semi-colon. E.G. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />For more information on CIDR notation <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\" target=\"_blank\">click here</a>.<br /><strong>Leave field empty to disable IP restrictions for this user.</strong>"
msgstr "Zadejte rozsahy adres IP v notaci CIDR oddělené středníky bez koncového středníku.Např. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />Další informace o notaci CIDR získáte <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\" target=\"_blank\">klepnutím sem</a>.<br /><strong>Chcete-li omezení IP pro tohoto uživatele vypnout, ponechejte pole prázdné.</strong>"

msgid "Restrict By IP"
msgstr "Omezit podle IP"

msgid "Enables limiting user login and role access to specific IP Addresses."
msgstr "Umožňuje omezit přihlášení uživatele a přístup rolí na určité adresy IP."

msgid "Access control"
msgstr "Kontrola přístupu"

msgid "Restrict by IP"
msgstr "Omezit podle IP"

msgid "General settings for Restrict by IP module."
msgstr "Obecná nastavení pro modul Omezit podle IP."

msgid "General Settings"
msgstr "Obecné nastavení"

msgid "Restrict login by IP"
msgstr "Omezit přihlášení podle IP"

msgid "Global Restrictions"
msgstr "Globální omezení"

msgid "User restrictions"
msgstr "Omezení uživatelů"

msgid "Restrict role by IP"
msgstr "Omezit roli podle IP"

msgid "Administer restrict by ip"
msgstr "Spravovat omezení podle IP"

msgid "Create, edit and delete rules for restricted IP login."
msgstr "Vytvořit, upravit a odstranit pravidla pro omezené přihlašování pomocí IP."

msgid "Server header to check for user IP address"
msgstr "Záhlaví serveru pro kontrolu adresy IP uživatele"

msgid "Page user is redirected to when login is denied"
msgstr "Při odepření přihlášení je uživatel stránky přesměrován"

msgid "Global IP address login restrictions"
msgstr "Globální omezení přihlášení podle adresy IP"

msgid "User level IP address login restrictions"
msgstr "Omezení úrovně uživatele přihlášení podle adresy IP"

msgid "Role level IP address grant restrictions"
msgstr "Omezení úrovně role udělení adresy IP"

msgid "Dependencies"
msgstr "Závislosti"

msgid "Login denied from @ip for %name."
msgstr "Přihlášení z @ip pro %name bylo odepřeno."

msgid "Header to check"
msgstr "Záhlaví, které se má zkontrolovat"

msgid "This is the HTTP request header that contains the client IP Address. It is sometimes re-written by reverse proxies and Content Distribution Networks."
msgstr "Jedná se o záhlaví požadavku HTTP, které obsahuje adresu IP klienta. Někdy je přepsáno reverzními servery proxy a sítěmi pro distribuci obsahu."

msgid "Your current IP address is %ipaddress. If this is wrong, make sure you have the correct header configured in general settings."
msgstr "Vaše aktuální adresa IP je %ipaddress. Pokud je to chyba, ujistěte se, že máte v obecných nastaveních nakonfigurováno správné záhlaví."

msgid "Login denied error page"
msgstr "Stránka s chybou pro odepřené přihlášení"

msgid "This the address of the page to which the user will be redirected if they are not allowed to login. If you don't set this the user will not know why they couldn't login."
msgstr "Jedná se o adresu stránky, na kterou bude uživatel přesměrován, pokud není oprávněn se přihlásit. Když ji nenastavíte, nebude uživatel vědět, proč se nemohl přihlásit."

msgid "Restrict global login to allowed IP range"
msgstr "Omezit globální přihlášení na povolený rozsah IP"

msgid "To restrict login for ALL users, enter global IP Address Ranges in CIDR Notation separated with semi-colons, with no trailing semi-colon. E.G. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />For more information on CIDR notation click <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\">here</a>.<br />Leave field blank to disable IP restrictions for user login."
msgstr "Chcete-li omezit přihlášení pro VŠECHNY uživatele, zadejte globální rozsahy adres IP v notaci CIDR oddělené středníky bez koncového středníku. Např. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />Další informace o notaci CIDR získáte klepnutím <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\">sem</a>.<br />Chcete-li omezení IP pro přihlášení uživatele vypnout, ponechejte toto pole prázdné."

msgid "No roles configured. <a href=\"@add-role\">Add a role</a>."
msgstr "Nejsou nakonfigurovány žádné role. <a href=\"@add-role\">Přidat roli</a>."

msgid "@role-label role IP range"
msgstr "Rozsah IP role @role-label"

msgid "Add new user allowed IP range"
msgstr "Přidat nový rozsah povolených adres IP pro uživatele"

msgid "Username"
msgstr "Uživatelské jméno"

msgid "Allowed IP range"
msgstr "Rozsah povolených adres IP"

msgid "Enter IP Address Ranges in CIDR Notation separated with semi-colons, with no trailing semi-colon. E.G. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />For more information on CIDR notation click <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\">here</a>."
msgstr "Zadejte rozsahy adres IP v notaci CIDR oddělené středníky bez koncového středníku.Např. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />Další informace o notaci CIDR získáte klepnutím <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\">zde</a>."

msgid "@name user IP range"
msgstr "Rozsah adres IP pro uživatele @name"

msgid "Enter IP Address Ranges in CIDR Notation separated with semi-colons, with no trailing semi-colon. E.G. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />For more information on CIDR notation click <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\">here</a>.<br />Leave field blank to disable IP restrictions for @name."
msgstr "Zadejte rozsahy adres IP v notaci CIDR oddělené středníky bez koncového středníku.Např. 10.20.30.0/24;192.168.199.1/32;1.0.0.0/8<br />Další informace o notaci CIDR získáte klepnutím <a href=\"http://www.brassy.net/2007/mar/cidr_basic_subnetting\">zde</a>.<br />Chcete-li omezení IP pro @name vypnout, ponechejte toto pole prázdné."

msgid "Restriction for that user already exist."
msgstr "Omezení pro daného uživatele již existuje."

