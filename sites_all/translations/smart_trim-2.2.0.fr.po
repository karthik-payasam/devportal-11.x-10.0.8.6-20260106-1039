msgid "About"
msgstr "À propos"

msgid "Smart Trim implements a new field formatter for text fields (text, text_long, and text_with_summary, if you want to get technical) that improves upon the \"Summary or Trimmed\" formatter."
msgstr "Smart Trim met en œuvre un nouveau formateur de champ pour les champs de type texte (d'un point de vue technique text, text_long et text_with_summary) qui améliore le formateur \"résumé ou tronqué\"."

msgid "More"
msgstr "Plus"

msgid "Read more about [node:title]"
msgstr "En savoir plus sur [node:title]"

msgid "Smart Trim"
msgstr "Smart Trim"

msgid "Provides a more robust alternative to \"summary or trimmed\" textfield format"
msgstr "Fournit une alternative plus robuste au formateur de champs texte \"Résumé ou coupé\"."

msgid "Fields"
msgstr "Champs"

msgid "Smart trim formatter settings"
msgstr "Paramètres du formateur de champ de Smart Trim."

msgid "Trim length"
msgstr "Longueur de coupe"

msgid "Trim units"
msgstr "Unités utilisées pour tronquer"

msgid "Suffix"
msgstr "Suffixe"

msgid "Wrap trimmed content"
msgstr "Envelopper le contenu tronqué dans un conteneur"

msgid "Wrapped content class"
msgstr "Classe du contenu enveloppé"

msgid "More link configuration"
msgstr "Configuration de liens supplémentaires"

msgid "Display more link"
msgstr "Afficher un lien \"plus\""

msgid "Open link in new window"
msgstr "Ouvrir le lien dans une nouvelle fenêtre"

msgid "More link only when content is trimmed"
msgstr "Liens supplémentaires uniquement lorsque le contenu est tronqué"

msgid "More link class"
msgstr "Classe du lien \"plus\""

msgid "More link text"
msgstr "Texte du lien \"Plus\""

msgid "More link aria-label value"
msgstr "Valeur de l'attribut \"aria-label\" du lien \"plus\""

msgid "Summary handler"
msgstr "Gestionnaire du résumé"

msgid "Additional options"
msgstr "Options additionnelles"

msgid "Strip HTML"
msgstr "Retirer les balises HTML"

msgid "Honor a zero trim length"
msgstr "Tronquer le texte même si les paramètres spécifient une longueur nulle"

msgid "Replace tokens before trimming"
msgstr "Remplacer les jetons avant la troncation"

msgid "Characters"
msgstr "Caractères"

msgid "Words"
msgstr "Mots"

msgid "Summary"
msgstr "Résumé"

msgid "Use summary if present, and do not trim"
msgstr "Utiliser le résumé si présent et ne pas tronquer."

msgid "Use summary if present, honor trim settings"
msgstr "Utiliser le résumé s'il est présent, tronquer conformément aux paramètres"

msgid "Do not use summary"
msgstr "Ne pas utiliser le résumé"

msgid "Wrap trimmed content?"
msgstr "Envelopper le contenu tronqué ?"

msgid "Adds a wrapper div to trimmed content. This option is deprecated and will be removed in Smart Trim 3.0.0. Please override the smart-trim.html.twig template file to customize output."
msgstr "Ajoute un encapsuleur div au contenu tronqué. Cette option est obsolète et sera supprimée dans Smart Trim 3.0.0. Veuillez remplacer le fichier modèle smart-trim.html.twig pour personnaliser la sortie."

msgid "Wrapped content class."
msgstr "Classe du contenu enveloppé."

msgid "If wrapping, define the class name here."
msgstr "En cas d'encapsulage, définissez le nom de classe ici."

msgid "<em>More</em> link"
msgstr "Lien <em>Plus</em>"

msgid "Display <em>More</em> link?"
msgstr "Afficher le lien <em>Plus</em> ?"

msgid "Displays a link to the entity (if one exists)"
msgstr "Affiche un lien vers l'entité (le cas échéant)"

msgid "Display <em>More</em> link only when content is trimmed?"
msgstr "Afficher le lien <em>Plus</em> uniquement lorsque le contenu est tronqué ?"

msgid "Only display <em>More</em> link if content is actually trimmed."
msgstr "Afficher uniquement le lien <em>Plus</em> si le contenu est réellement tronqué."

msgid "Open <em>More</em> link in new window"
msgstr "Ouvrir le lien <em>Plus</em> dans une nouvelle fenêtre"

msgid "<em>More</em> link text"
msgstr "Texte du lien <em>Plus</em>"

msgid "If displaying <em>More</em> link, enter the text for the link. This field supports tokens."
msgstr "Si vous affichez le lien <em>Plus</em>, entrez le lien du texte. Cette zone admet les jetons."

msgid "<em>More</em> link aria-label"
msgstr "Libellé aria du lien <em>Plus</em>"

msgid "If displaying <em>More</em> link, provide additional context for screen-reader users. In most cases, the aria-label value will be announced instead of the link text. This field supports tokens."
msgstr "Si vous affichez le lien <em>Plus</em>, fournissez un contexte supplémentaire pour les utilisateurs du lecteur d'écran. Dans la plupart des cas, c'est la valeur du libellé aria qui sera annoncée à la place du texte du lien. Cette zone admet les jetons."

msgid "<em>More</em> link class"
msgstr "Classe de lien <em>Plus</em>"

msgid "If displaying <em>More</em> link, add a custom class for formatting."
msgstr "Si vous affichez le lien <em>Plus</em>, ajoutez une classe personnalisée pour le formatage."

msgid "words"
msgstr "mots"

msgid "characters"
msgstr "caractères"

msgid "Suffix: %suffix"
msgstr "Suffixe : %suffix"

msgid "<em>More</em> link enabled, text: %text"
msgstr "Lien <em>Plus</em> activé, texte : %text"

msgid "Only display <em>More</em> link when trimmed"
msgstr "Afficher uniquement le lien <em>Plus</em> lorsqu'il est tronqué"

msgid "<em>More</em> link aria-label: %label"
msgstr "Libellé aria du lien <em>Plus</em> : %label"

msgid "<em>More</em> link class: %class"
msgstr "Classe du lien <em>Plus</em> : %class"

msgid "Smart trimmed"
msgstr "Tronqué avec Smart Trim."

