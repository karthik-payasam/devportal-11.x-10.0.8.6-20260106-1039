msgid "No Content Security Policy headers are currently enabled."
msgstr "Şu anda etkin bir İçerik Güvenliği İlkesi üstbilgisi yok."

msgid "Enable a header via <a href=\":csp-settings\">the Content Security Policy settings</a>."
msgstr "<a href=\":csp-settings\">İçerik Güvenliği İlkesi ayarlarını</a> kullanarak bir üstbilgiyi etkinleştirin."

msgid "Enabling Content Security Policy in Security Kit is likely to cause policy conflicts."
msgstr "Güvenlik Setinde İçerik Güvenliği İlkesinin etkinleştirilmesi, ilke çakışmalarına neden olabilir."

msgid "Disable the Content Security Policy settings in <a href=\":seckit-settings\">Security Kit configuration</a>."
msgstr "<a href=\":seckit-settings\">Güvenlik Seti yapılandırması</a> İçerik Güvenliği İlkesi ayarlarını devre dışı bırakın."

msgid "Content Security Policy"
msgstr "İçerik Güvenliği İlkesi"

msgid "Provide Content-Security-Policy headers"
msgstr "İçerik-Güvenliği-İlkesi üstbilgileri sağla"

msgid "Configure policy enforcement."
msgstr "İlke uygulamasını yapılandırın."

msgid "Administer Content Security Policy"
msgstr "İçerik Güvenliği İlkesini Yönet"

msgid "Content Security Policy Settings"
msgstr "İçerik Güvenliği İlkesi Ayarları"

msgid "Report-Only Policy"
msgstr "Yalnızca Bildirme İlkesi"

