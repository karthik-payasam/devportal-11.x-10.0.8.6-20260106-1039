msgstr "Drupal ^10.1'de modül gerekli değildir"

msgid "Content Security Policy Extras"
msgstr "İçerik Güvenliği İlkesi Ekstraları"

msgid "Optional extra features for Content Security Policy"
msgstr "İçerik Güvenliği İlkesi için isteğe bağlı ek özellikler"

msgid ""
"@type <br/>\n"
"<pre>@data</pre>"
msgstr ""
"@type <br/>\n"
"<pre>@data</pre>"

msgid "Policies"
msgstr "Kurallar"

msgid "Report Only"
msgstr "Yalnızca Rapor"

msgid "Enforced"
msgstr "Zorunlu"

msgid "Enable '@type'"
msgstr "'@type' etkinleştir"

msgid "Additional Sources"
msgstr "Ek Kaynaklar"

msgid "Additional domains or protocols to allow for this directive, separated by a space."
msgstr "Bu yönergeye izin vermek için, bir boşlukla ayrılmış ek etki alanları ya da protokoller."

msgid "Instead of child-src, nested browsing contexts and workers should use the frame-src and worker-src directives, respectively."
msgstr "İç içe geçmiş göz atma bağlamları ve çalışanlar, child-src yerine sırayla frame-src ve worker-src direktiflerini kullanmalıdır."

msgid "Handler"
msgstr "İşleyici"

msgid "Reset @policyType policy to default values"
msgstr "@policyType ilkesini varsayılan değerlere sıfırla"

msgid "No policies are currently enabled."
msgstr "Şu anda etkin bir ilke yok."

msgid "%policy %directive has a hash source configured, which may block functionality that relies on inline code."
msgstr "%policy %directive, yerleşik koda güvenen işlevselliği engelleyebilen, yapılandırılmış bir hash kaynağına sahiptir."

msgid "%policy %directive is enabled without a fallback directive for non-supporting browsers."
msgstr "%policy %directive, desteklemeyen tarayıcılar için yedek yönergesi olmadan etkinleştirilir."

msgid "<a href=\":docUrl\">Nonces must be a unique value for each request</a>, so cannot be set in configuration."
msgstr "<a href=\":docUrl\">Nonces her istek için benzersiz bir değer olmalıdır</a>, dolayısıyla yapılandırmada ayarlanamaz."

msgid "Invalid domain or protocol provided."
msgstr "Geçersiz etki alanı ya da protokol sağlandı."

msgid "Reporting Handler is required for enabled policies."
msgstr "Raporlama İşleyicisi, etkinleştirilen ilkeler için gereklidir."

msgid "Reporting is disabled"
msgstr "Raporlama devre dışı bırakıldı"

msgid "Your <a href=\":url\">Report-URI.com subdomain</a>."
msgstr "<a href=\":url\">Report-URI.com alt etki alanınız</a>."

msgid "Enable Wizard"
msgstr "Sihirbazı Etkinleştir"

msgid "Send reports to the <a href=\":url\">CSP Wizard</a> reporting address."
msgstr "<a href=\":url\">CSP Sihirbazı</a> raporlama adresine raporlar gönderir."

msgid "Reports will be sent to a ReportURI.com account."
msgstr "Raporlar bir ReportURI.com hesabına gönderilir."

msgid "Reports will be added to the site log."
msgstr "Raporlar site günlüğüne eklenecektir. "

msgid "The URI to send reports to."
msgstr "Raporların gönderileceği URI."

msgid "Reports will be sent to a URI."
msgstr "Raporlar bir URI'ye gönderilir."

