msgid "Back To Top"
msgstr "返回顶部"

msgid "Back To Top adds a button that hovers in the bottom of your screen and allow users to smoothly scroll up the page using jQuery."
msgstr "“返回顶部”会添加一个按钮，此按钮悬停在屏幕底部，允许用户使用 jQuery 平滑地向上滚动页面。"

msgid "User interface"
msgstr "用户界面"

msgid "Back to Top"
msgstr "返回页首"

msgid "Administer Back To Top settings."
msgstr "管理“返回顶部”设置。"

msgid "Back to top settings"
msgstr "“返回顶部”设置"

msgid "Access Back to top settings"
msgstr "访问“返回顶部”设置"

msgid "Prevent on mobile and touch devices"
msgstr "在移动设备和触摸设备上禁用"

msgid "Prevent on administration pages and node edit"
msgstr "在管理页面及节点编辑页面禁用"

msgid "Prevent on front page"
msgstr "阻止出现在首页上"

msgid "Trigger"
msgstr "触发器"

msgid "Placement"
msgstr "放置位置"

msgid "Button text"
msgstr "按钮文本"

msgid "Button type"
msgstr "按钮类型"

msgid "Background color"
msgstr "背景色"

msgid "Border color"
msgstr "边框颜色"

msgid "Hover color"
msgstr "鼠标悬停时的颜色"

msgid "Text color"
msgstr "文本颜色"

msgid "Back to top"
msgstr "返回页首"

msgid "Don´t show Back To Top-button on screen width up to 760px."
msgstr "请勿在屏幕宽度不超过 760 像素的情况下显示“返回到顶部”按钮。"

msgid "Do you want to prevent Back To Top on admin pages?"
msgstr "在管理页面禁用返回页首吗？"

msgid "Do you want to prevent Back To Top on front page?"
msgstr "(钩选) 不在首页启用 Back To Top 。"

msgid "Set the number of pixel which trigger the Back To Top button default 100"
msgstr "设置返回到页面按钮的触发器像素大小，默认为100"

msgid "Where should the Back To Top button appear?"
msgstr "返回页首按钮需要出现在哪儿？"

msgid "Bottom right"
msgstr "右下"

msgid "Bottom left"
msgstr "左下"

msgid "Bottom center"
msgstr "底部中间"

msgid "Top right"
msgstr "右上方"

msgid "Top left"
msgstr "左上方"

msgid "Top center"
msgstr "上方的中间"

msgid "Mid right"
msgstr "中部的右边"

msgid "Mid left"
msgstr "中左"

msgid "Mid center"
msgstr "中部居中"

msgid "Set the text of the Back To Top button"
msgstr "设置“返回顶部”按钮的文本"

msgid "Do you want Back To Top to use a PNG-24 image or a Text/Css button?"
msgstr "使用PNG-24格式的图像按钮还是文字/CSS按钮？"

msgid "Image (default)"
msgstr "图像 (默认)"

msgid "Text/Css"
msgstr "文字/Css"

msgid "Text/Css button settings"
msgstr "文字/Css 按钮设置"

msgid "Button background color default #F7F7F7"
msgstr "默认的按钮背景色 #F7F7F7"

msgid "Border color default #CCCCCC"
msgstr "默认的边框颜色 #CCCCCC"

