msgid "About"
msgstr "Acerca de"

msgid ""
"\n"
"<p>This module generates and exposes a\n"
"  <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a> schema for\n"
"  <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a> entities,\n"
"  and allows you to expose your own custom schema in a consistent way and with\n"
"  minimal effort.</p>"
msgstr ""
"\n"
"<p>Este módulo genera y expone un esquema\n"
"  <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a> para\n"
"  entidades <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a>,\n"
"  y permite exponer su propio esquema personalizado de forma coherente\n"
"  y con el mínimo esfuerzo.</p>"

