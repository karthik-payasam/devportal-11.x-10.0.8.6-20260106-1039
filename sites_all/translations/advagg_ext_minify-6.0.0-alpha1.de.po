msgid "Advagg External Minification: PHP shell_exec"
msgstr "Advagg - Externe Kompression: PHP-shell_exec"

msgid "PHP shell_exec is non-functional."
msgstr "PHP-shell_exec funktioniert nicht."

msgid "Check php.ini for safemode or <a href=\"@link\" target=\"_blank\">disable_functions</a>."
msgstr "Überprüfen Sie php.ini auf 'safemode' oder <a href=\"@link\" target=\"_blank\">disable_functions</a>."

msgid "Enabled"
msgstr "Aktiviert"

msgid "AdvAgg External Minification"
msgstr "AdvAgg - Externe Kompression"

msgid "Minify Javascript and/or CSS with a command line minifier."
msgstr "Javascript und/oder CSS mit einem Befehlszeilenkompressionstool komprimieren."

msgid "Advanced CSS/JS Aggregation"
msgstr "Erweiterte CSS-/JS-Aggregation"

msgid "External Minification"
msgstr "Externe Kompression"

msgid "AdvAgg external minification settings."
msgstr "Externe AdvAgg-Kompressionseinstellungen."

msgid "AdvAgg: External Minifiers"
msgstr "AdvAgg: Externe Kompressionstools"

msgid "Settings"
msgstr "Einstellungen"

msgid "Command line for external CSS minification."
msgstr "Befehlszeile für externe CSS-Kompression."

msgid "Whether to use the external CSS minifier if configured."
msgstr "Gibt an, ob das externe CSS-Kompressionstool verwendet werden soll, wenn es konfiguriert ist."

msgid "Command line for external JavaScript minification."
msgstr "Befehlszeile für externe JavaScript-Kompression."

msgid "Whether to use the external JS minifier if configured."
msgstr "Gibt an, ob das externe JS-Kompressionstool verwendet werden soll, wenn es konfiguriert ist."

msgid "CSS"
msgstr "CSS"

msgid "JavaScript"
msgstr "JavaScript"

msgid "Command Line"
msgstr "Befehlszeile"

msgid "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = input file. <br /> {%IN_URL_ENC%} = url pointing to the input file that has been url encoded. <br /> {%OUT%} = output file. <br /><br />"
msgstr "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = Eingabedatei. <br /> {%IN_URL_ENC%} = URL, die auf die Eingabedatei verweist, die URL-codiert wurde. <br /> {%OUT%} = Ausgabedatei. <br /><br />"

msgid "Example using the <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"
msgstr "Beispiel für die Verwendung von <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "Beispiel für die Verwendung von <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"

msgid "Example using curl to minify via the <a href=\"@link1\">Online Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "Beispiel für die Verwendung von cURL zum Minimieren über den <a href=\"@link1\">Online Google Closure Compiler</a>. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">YUI Compressor</a>. <p><code>@code1</code></p>"
msgstr "Beispiel für die Verwendung von <a href=\"@link1\">YUI Compressor</a>. <p><code>@code1</code></p>"

msgid "Example using curl to minify via an online <a href=\"@link1\">CSS Minifier</a>. <p><code>@code1</code></p>"
msgstr "Beispiel für die Verwendung von cURL zum Minimieren über einen Online-<a href=\"@link1\">CSS-Minifier</a> <p><code>@code1</code></p>"

msgid "Command to run"
msgstr "Auszuführender Befehl"

msgid "Enable external @type minification"
msgstr "Externe @type-Kompression aktivieren"

