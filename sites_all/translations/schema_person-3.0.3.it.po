msgid "Schema.org: Person"
msgstr "Schema.org: Person"

msgid "An additional name for a Person, can be used for a middle name."
msgstr "Un nome aggiuntivo per una Persona, può essere utilizzato per il secondo nome."

msgid "Physical address of the person."
msgstr "Indirizzo fisico della persona."

msgid "An organization that this person is affiliated with. For example, a school/university, a club, or a team."
msgstr "Un'organizzazione a cui questa persona è affiliata. Ad esempio, una scuola/università, un club o un team."

msgid "An alias for the person."
msgstr "Un alias per la persona."

msgid "birthDate"
msgstr "birthDate"

msgid "Date of birth of the person in ISO 8601 format, 2017-12-31."
msgstr "Data di nascita della persona in formato ISO 8601, 2017-12-31."

msgid "The brand of the person."
msgstr "Lo stile di una persona."

msgid "A description of the person."
msgstr "Una descrizione della persona."

msgid "The email address of the person."
msgstr "L'indirizzo email della persona."

msgid "familyName"
msgstr "familyName"

msgid "Family name. In the U.S., the last name of an Person. This can be used along with givenName instead of the name property."
msgstr "Il cognome di famiglia. Negli Stati Uniti, il cognome di una persona. Può essere utilizzato insieme a givenName invece della proprietà name."

msgid "Gender of the person."
msgstr "Sesso della persona."

msgid "givenName"
msgstr "givenName"

msgid "Given name. In the U.S., the first name of a Person. This can be used along with familyName instead of the name property."
msgstr "Nome proprio. Negli Stati Uniti, il nome proprio di una persona. Può essere utilizzato insieme a familyName invece della proprietà name."

msgid "Globally unique id of the person, usually a url."
msgstr "Id globalmente unico della persona, generalmente un url."

msgid "The primary image for the person."
msgstr "L'immagine principale della persona."

msgid "jobTitle"
msgstr "jobTitle"

msgid "The job title of the person (for example, Financial Manager)."
msgstr "La qualifica della persona (ad esempio, Direttore finanziario)."

msgid "memberOf"
msgstr "memberOf"

msgid "An Organization (or ProgramMembership) to which this Person belongs."
msgstr "Un'organizzazione (o ProgramMembership) a cui appartiene questa persona."

msgid "REQUIRED BY GOOGLE. The name of the person."
msgstr "RICHIESTO DA GOOGLE. Il nome della persona."

msgid "REQUIRED BY GOOGLE. A single or an [array] of URLs for the person's official social media profile page(s)."
msgstr "RICHIESTO DA GOOGLE. Un URL singolo o un [array] di URL per le pagine di profilo social media ufficiali della persona."

msgid "The telephone number of the person."
msgstr "Il numero di telefono della persona."

msgid "REQUIRED. The type of person (fixed by standard)."
msgstr "Obbligatorio. Il tipo di persona (fissato in base ad uno standard)."

msgid "REQUIRED BY GOOGLE. The URL for the person's official website."
msgstr "RICHIESTO DA GOOGLE. L'URL del sito Web ufficiale della persona."

msgid "worksFor"
msgstr "worksFor"

msgid "Organizations that the person works for."
msgstr "Organizzazioni per cui la persona svolge un lavoro."

