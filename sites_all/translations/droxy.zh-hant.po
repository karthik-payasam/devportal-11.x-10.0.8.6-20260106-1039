msgid "About"
msgstr "關於"

msgid "Drupal Proxy Module"
msgstr "Drupal Proxy 模組"

msgid "Drupal Proxy"
msgstr "Drupal Proxy"

msgid "Proxy"
msgstr "Proxy"

msgid "Proxy Settings"
msgstr "Proxy 設定"

msgid "ProxySettingForm"
msgstr "ProxySettingForm"

msgid "Https or Https"
msgstr "Https 或 Https"

msgid "type of Scheme"
msgstr "架構類型"

msgid "Proxy Server"
msgstr "Proxy 伺服器"

msgid "The IP address or hostname of the proxy server."
msgstr "Proxy 伺服器的 IP 位址或主機名稱。"

msgid "Port"
msgstr "連接埠"

msgid "The port number used by the proxy server for client connections."
msgstr "Proxy 伺服器用於用戶端連線的埠號。"

msgid "Proxy Username"
msgstr "Proxy 使用者名稱"

msgid "A username used of proxy server for Authentication."
msgstr "Proxy 伺服器用於鑑別的使用者名稱。"

msgid "Proxy Password"
msgstr "Proxy 密碼"

msgid "Password of proxy server used for Authentication."
msgstr "Proxy 伺服器用於鑑別的密碼。"

msgid "Proxy User Agent"
msgstr "Proxy 使用者代理程式"

msgid "A string which can be used by the proxy server to identify connection requests."
msgstr "可供 Proxy 伺服器用來識別連線要求的字串。"

msgid "Proxy Exceptions"
msgstr "Proxy 異常狀況"

msgid "Specify exceptions using either IP addresses or hostnames. Enter one exception per line. Exceptions will be accessed directly, not via proxy."
msgstr "使用 IP 位址或主機名稱來指定異常狀況。每行輸入一個異常狀況。將會直接（而非透過 Proxy）存取異常狀況。"

