msgid "About"
msgstr "Popis"

msgid "Drupal 8 includes jQuery UI in core, however it is no longer actively maintained and has been marked deprecated. This module provides the jQuery UI Droppable library for any themes and modules that require it."
msgstr "Drupal 8 obsahuje uživatelské rozhraní jQuery UI v jádru, avšak již není aktivně udržováno a bylo označeno jako zamítnuté. Tento modul poskytuje knihovnu jQuery UI umožňující přetažení pro všechny motivy a moduly, které jej vyžadují."

msgid "For more information about the deprecation of jQuery UI, see this <a href=\":change-record\">change record</a>"
msgstr "Další informace o zamítnutí uživatelského rozhraní jQuery UI viz tento <a href=\":change-record\">záznam o změně</a>"

msgid "Visit the <a href=\":project_link\">jQuery UI Droppable project page</a> on Drupal.org for more information."
msgstr "Další informace viz <a href=\":project_link\">Stránka projektu jQuery UI umožňující přetažení</a> na webu Drupal.org."

msgid "jQuery UI Droppable"
msgstr "jQuery UI umožňující přetažení"

msgid "Provides jQuery UI Droppable library."
msgstr "Poskytuje knihovnu jQuery UI umožňující přetažení."

msgid "jQuery UI"
msgstr "jQuery UI"

