msgid "About"
msgstr "Acerca de"

msgid "Provides additional Open Graph Protocol meta tags for describing products."
msgstr "Proporciona metaetiquetas adicionales del protocolo Open Graph para describir productos."

msgid "Metatag: Open Graph Products"
msgstr "Metatag: Productos de Open Graph"

msgid "SEO"
msgstr "SEO (optimizador del motor de búsqueda)"

msgid "Open Graph Product: Price availability"
msgstr "Abrir producto gráfico: disponibilidad de precios"

msgid "Open Graph Product: Product condition"
msgstr "Abrir producto gráfico: condición de producto"

msgid "Open Graph Product: Price amount"
msgstr "Producto Open Graph: Cantidad del precio"

msgid "Open Graph Product: Price currency"
msgstr "Producto Open Graph: Moneda del precio"

msgid "Open Graph Product: Retailer Item ID"
msgstr "Abrir producto gráfico: ID de elemento minorista"

msgid "Open Graph - Products"
msgstr "Open Graph - Productos"

msgid "These <a href='https://ogp.me/'>Open Graph meta tags</a> are for describing products.<br><br>The Facebook <a href='https://developers.facebook.com/tools/debug/'>Sharing Debugger</a> lets you preview how your content will look when it's shared to Facebook and debug any issues with your Open Graph tags."
msgstr "Estas <a href='https://ogp.me/'>metaetiquetas de Open Graph</a> son para describir productos.<br><br>El <a href='https://developers.facebook.com/tools/debug/'>depurador de contenido compartido</a> de Facebook le permite obtener una vista previa del aspecto que tendrá el contenido cuando se comparta en Facebook y depurar cualquier problema con las etiquetas de Open Graph."

msgid "Product availability"
msgstr "Disponibilidad de producto"

msgid "The availability of the product."
msgstr "La disponibilidad del producto."

msgid "Product condition"
msgstr "Condición de producto"

msgid "The condition of the product."
msgstr "La condición del producto."

msgid "Product price amount"
msgstr "Cantidad del precio del producto"

msgid "The price amount of the product."
msgstr "La cantidad del precio del producto."

msgid "Product price currency"
msgstr "Moneda del precio del producto"

msgid "The price currency of the product."
msgstr "La moneda del precio del producto."

msgid "Retailer Item ID"
msgstr "ID de artículo de minorista"

msgid "The ID of the product as provided by the retailer."
msgstr "El ID del producto suministrado por el minorista."

