msgid "Single widget"
msgstr "Jednotlivý modul widget"

msgid "Displays only the first configured widget. Use this if you plan to have only one widget available."
msgstr "Zobrazí pouze první nakonfigurovaný modul widget. Tuto volbu použijte, pokud plánujete mít k dispozici pouze jeden modul widget."

msgid "Tabs"
msgstr "Záložky"

msgid "Creates horizontal tabs on the top of the entity browser, each tab representing one available widget."
msgstr "Vytvoří horizontální karty v horní části prohlížeče entit, přičemž každá karta představuje jeden dostupný modul widget."

msgid "Cardinality validator"
msgstr "Validátor kardinality"

msgid "Entity type validator"
msgstr "Validátor typu entity"

msgid "File validator"
msgstr "Validátor souboru"

msgid "Display Edit button"
msgstr "Zobrazit tlačítko Upravit"

msgid "Display Remove button"
msgstr "Zobrazit tlačítko Odebrat"

msgid "Display Replace button"
msgstr "Zobrazit tlačítko Nahradit"

msgid "This button will only be displayed if there is a single entity in the current selection."
msgstr "Toto tlačítko se zobrazí pouze v případě, že v aktuálním výběru existuje jediná entita."

msgid "Show widget details as open by default"
msgstr "Zobrazit podrobnosti modulu widget při výchozím nastavení jako otevřené"

msgid "If marked, the fieldset container that wraps the browser on the entity form will be loaded initially expanded."
msgstr "Je-li tato volba označena, načte se kontejner sady polí, který zabaluje prohlížeč ve formuláři entit, na začátku rozbalený."

msgid "Determines how selection in entity browser will be handled. Will selection be appended/prepended or it will be replaced in case of editing."
msgstr "Určuje, jak bude zacházeno s výběrem v prohlížeči entit. Zda bude výběr v případě úprav připojen/předřazen nebo nahrazen."

msgid "The selection mode %selection_mode requires an entity browser with a selection display plugin that supports preselection.  Either change the selection mode or update the @browser_link entity browser to use a selection display plugin that supports preselection."
msgstr "Režim výběru %selection_mode vyžaduje prohlížeč entit s modulem plug-in zobrazení výběru, který podporuje předběžný výběr. Buď změňte režim výběru, nebo aktualizujte prohlížeč entit @browser_link, aby používal modul plug-in zobrazení výběru, který podporuje předběžný výběr."

msgid "Entity display: @name"
msgstr "Zobrazení entity: @name"

msgid "View Mode: @view_mode"
msgstr "Režim zobrazení: @view_mode"

msgid "@name field is required."
msgstr "Pole @name je povinné."

msgid "Replace"
msgstr "Nahradit"

msgid "You can select one @entity_type."
msgstr "Můžete vybrat pouze jeden typ @entity_type."

msgid "You can select up to @maximum @entity_type (@remaining left)."
msgstr "Můžete vybrat až @maximum @entity_type (@remaining zbývá)."

msgid "Append"
msgstr "Připojit"

msgid "Prepend"
msgstr "Připojit na začátek"

msgid "No entity browser selected."
msgstr "Nebyl vybrán žádný prohlížeč entit."

msgid "Entity browser: @browser"
msgstr "Prohlížeč entit: @browser"

msgid "Missing entity browser!"
msgstr "Chybí prohlížeč entit!"

msgid "Selection mode: @selection_mode"
msgstr "Režim výběru: @selection_mode"

msgid "Undefined selection mode."
msgstr "Nedefinovaný režim výběru."

msgid "Uses entity browser to select entities."
msgstr "Používá k výběru entit prohlížeč entit."

msgid "File view mode"
msgstr "Režim zobrazení souboru"

msgid "The preview image will be shown while editing the content. Only relevant if using the default file view mode."
msgstr "Při úpravě obsahu bude zobrazen obrázek náhledu. Toto je relevantní pouze v případě, že používáte výchozí režim zobrazení souboru."

msgid "Preview with @view_mode"
msgstr "Náhled pomocí @view_mode"

msgid "Preview image style: @style"
msgstr "Náhled stylu obrázku: @style"

msgid "No preview image"
msgstr "Bez obrázku náhledu"

msgid "No files yet"
msgstr "Dosud bez souborů"

msgid "Preview"
msgstr "Náhled"

msgid "Filename"
msgstr "Název souboru"

msgid "Metadata"
msgstr "Metadata"

msgctxt "Sort order"
msgid "Order"
msgstr "Pořadí"

msgid "Include file in display"
msgstr "Zobrazit soubor"

msgid "Description"
msgstr "Popis"

msgid "The description may be used as the label of the link to the file."
msgstr "Popis lze použít jako název odkazu na soubor."

msgid "Alternative text"
msgstr "Alternativní text"

msgid "This text will be used by screen readers, search engines, or when the image cannot be loaded."
msgstr "Tento text použijí programy na čtení obrazovky, vyhledávače nebo se zobrazí, pokud se nepodaří načíst obrázek."

msgid "Title"
msgstr "Nadpis"

msgid "The title is used as a tool tip when the user hovers the mouse over the image."
msgstr "Nadpis se používá pro vyskakovací okno, když uživatel přetáhne myš na obrázek."

msgid "Weight for row @number"
msgstr "Váha pro řádek @number"

msgid "The key within the widget context."
msgstr "Klíč v kontextu modulu widget."

msgid "The fallback value to use when the context is not present. (ex: \"all\")"
msgstr "Náhradní hodnota, která se použije v případě, že není přítomen kontext. (např.: \"all\")"

msgid "Conjunction to use when handling multiple values. NOTE: for multiple values to work, at the bottom of this form expand the \"More\" fieldset and and check \"Allow multiple values\"."
msgstr "Spojení, které má být použito při zpracování více hodnot. POZNÁMKA: Aby fungovalo více hodnot, rozbalte sadu polí \"Další\" na konci formuláře a zaškrtněte \"Povolit více hodnot\"."

msgid "OR"
msgstr "OR"

msgid "AND"
msgstr "AND"

msgid "Yes (Forced)"
msgstr "Ano (vynuceno)"

msgid "Entity Browser requires Views to use AJAX."
msgstr "Prohlížeč entit vyžaduje pro použití technologie AJAX pohledy."

msgid "Use AJAX"
msgstr "Použít AJAX"

msgid "Displays a view as Entity browser widget."
msgstr "Zobrazí pohled jako modul widget Prohlížeče entit."

msgid "If the view is used in a context where cardinality is 1, use radios instead of checkboxes."
msgstr "Je-li pohled použit v kontextu, kde je kardinalita 1, místo zaškrtávacích políček použijte přepínače."

msgid "Select this item"
msgstr "Vybrat tuto položku"

msgid "You cannot edit this list because the options update in response to entity browser context."
msgstr "Tento seznam nelze upravovat, protože se jednotlivé volby aktualizují v závislosti na kontextu prohlížeče entit."

msgid "Skip to main content"
msgstr "Přejít k hlavnímu obsahu"

