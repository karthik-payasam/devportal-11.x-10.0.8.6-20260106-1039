msgid "Date"
msgstr "Дата"

msgid "Numeric query with set granularity"
msgstr "Числовой запрос с заданным уровнем дискретности"

msgid "Range"
msgstr "Диапазон"

msgid "String"
msgstr "Строка"

msgid "Query string"
msgstr "Строка запроса"

msgid "Query string is the default Facets URL processor, and uses GET parameters, for example ?f[0]=brand:drupal&f[1]=color:blue"
msgstr "Строка запроса - это обработчик URL фасетов по умолчанию, в которой используются параметры GET, например ?f[0]=brand:drupal&f[1]=color:blue"

msgid "Array with raw results"
msgstr "Массив с необработанными результатами"

msgid "A widget that builds an array with results. This widget is not supposed to display any results, but it is needed for rest integration."
msgstr "Виджет, создающий массив с результатами. Этот виджет не предназначен для отображения каких-либо результатов, но он нужен для интеграции rest."

msgid "List of checkboxes"
msgstr "Список переключателей"

msgid "A configurable widget that shows a list of checkboxes"
msgstr "Настраиваемый виджет, показывающий список переключателей"

msgid "To achieve the standard behavior of a dropdown, you need to enable the facet setting below <em>\"Ensure that only one result can be displayed\"</em>."
msgstr "Для достижения стандартного поведения выпадающего списка необходимо включить параметр фасета <em>\"Гарантировать показ только одного результата\"</em> внизу."

msgid "Dropdown"
msgstr "Выпадающий"

msgid "A configurable widget that shows a dropdown."
msgstr "Настраиваемый виджет, показывающий выпадающий список."

msgid "Show all"
msgstr "Показать все"

msgid "Limit the number of displayed facets via JavaScript."
msgstr "Ограничить число показываемых фасетов через JavaScript."

msgid "This text will be used for \"Show less\" link."
msgstr "Этот текст будет использоваться для ссылки \"Показать меньше\"."

msgid "This text will be used for \"Show more\" link."
msgstr "Этот текст будет использоваться для ссылки \"Показать больше\"."

msgid "Reset text"
msgstr "Сбросить текст"

msgid "List of links"
msgstr "Список ссылок"

msgid "A simple widget that shows a list of links"
msgstr "Простой виджет, показывающий список ссылок"

msgid "Pre query stage"
msgstr "Этап обработки перед запросом"

msgid "Post query stage"
msgstr "Этап обработки после запроса"

msgid "Sort stage"
msgstr "Этап сортировки"

msgid "Sort order"
msgstr "Порядок сортировки"

msgid "Ascending"
msgstr "По возрастанию"

msgid "Descending"
msgstr "По убыванию"

msgid "Show the amount of results"
msgstr "Показывать количество результатов"

