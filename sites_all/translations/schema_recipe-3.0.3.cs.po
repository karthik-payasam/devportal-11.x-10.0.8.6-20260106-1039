msgid "Schema.org: Recipe"
msgstr "Schema.org: Recept"

msgid "RECOMMENDED BY GOOGLE. The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Celkové hodnocení založené na kolekci revizí nebo hodnocení položky."

msgid "RECOMMENDED BY GOOGLE. Author of the recipe."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Autor receptu."

msgid "RECOMMENDED BY GOOGLE. Cook Time (The time it takes to actually cook the dish, in ISO 8601 duration format.)."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Doba vaření (čas, po který je třeba skutečně jídlo vařit, ve formátu ISO 8601.)."

msgid "RECOMMENDED BY GOOGLE. Date the recipe was published."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Datum, kdy byl recept publikován."

msgid "RECOMMENDED BY GOOGLE. A description of the item."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Popis položky."

msgid "Globally unique id of the recipe, usually a url."
msgstr "Globálně jedinečné ID receptu, obvykle adresa URL."

msgid "RECOMMENDED BY GOOGLE. The primary image for this item."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Primární obrázek pro tuto položku."

msgid "RECOMMENDED BY GOOGLE. Keywords of the recipe (comma separated). For example, 'winter apple pie, nutmeg crust'"
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Klíčová slova receptu (oddělené čárkami). Například \"zimní jablkový koláč, kůra muškátového oříšku\""

msgid "REQUIRED BY GOOGLE. Name of the recipe."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Název receptu."

msgid "RECOMMENDED BY GOOGLE. The nutrition for this item."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Výživnost pro tuto položku."

msgid "RECOMMENDED BY GOOGLE. The length of time it takes to prepare the recipe for dish, in ISO 8601 format."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Doba potřebná k přípravě receptu jídla, formátu ISO 8601."

msgid "RECOMMENDED BY GOOGLE. The category of the recipe—for example, appetizer, entree, etc."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Kategorie receptu, např. předkrm, entrée atd."

msgid "RECOMMENDED BY GOOGLE. The region associated with your recipe. For example, 'French Mediterranean', or 'American'."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Oblast přidružená k vašemu receptu. Například 'Francouzské Středomoří' nebo 'Americká oblast."

msgid "RECOMMENDED BY GOOGLE. A list of single ingredients used in the recipe, e.g. sugar, flour or garlic."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Seznam jednotlivých ingrediencí použitých v receptu, např. cukr, mouka nebo česnek."

msgid "RECOMMENDED BY GOOGLE. Steps in making the recipe."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Kroky při přípravě receptu."

msgid "RECOMMENDED BY GOOGLE. The quantity produced by the recipe (for example, number of people served, number of servings, etc)."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Množství vyprodukované receptem (například počet obsloužených osob, počet porcí atd.)."

msgid "RECOMMENDED BY GOOGLE. Reviews of this recipe."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Recenze tohoto receptu."

msgid "RECOMMENDED BY GOOGLE. Total Time (The total time required to perform instructions or a direction (including time to prepare the supplies), in ISO 8601 duration format."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Celková doba (celková doba požadovaná k provedení postupu nebo směru (včetně doby potřebné k přípravě dodávek), ve formátu doby trvání ISO 8601."

msgid "REQUIRED. The type of recipe."
msgstr "POŽADOVÁNO. Typ receptu."

