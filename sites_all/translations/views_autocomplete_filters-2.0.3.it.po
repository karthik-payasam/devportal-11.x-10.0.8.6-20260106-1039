msgid "Views Autocomplete Filters"
msgstr "Filtri completamento automatico viste "

msgid "Use Autocomplete for string field filters."
msgstr "Utilizza il completamento automatico per i filtri del campo stringa. "

msgid "Views"
msgstr "Viste"

msgid "Autocomplete for Combine fields filter"
msgstr "Completamento automatico per il filtro dei campi Combina "

msgid "Exposed"
msgstr "Esposto"

msgid "Use Autocomplete"
msgstr "Utilizza completamento automatico "

msgid "Minimum number of characters to start filter"
msgstr "Numero minimo di caratteri per avviare il filtro "

msgid "Maximum number of items in Autocomplete"
msgstr "Numero massimo di elementi nel completamento automatico "

msgid "Field with autocomplete results"
msgstr "Campo con risultati del completamento automatico "

msgid "Unformatted suggestion"
msgstr "Suggerimento non formattato "

msgid "Unformatted dropdown"
msgstr "A discesa non formattato "

msgid "Suggestions depend on other filter fields"
msgstr "I suggerimenti dipendono da altri campi del filtro "

msgid "Autocomplete for Search API fulltext search filter"
msgstr "Completamento automatico per il filtro di ricerca del testo completo di API di ricerca "

msgid "Autocomplete for Search API text field filter"
msgstr "Completamento automatico per il filtro del campo di testo di API di ricerca "

msgid "Autocomplete for basic textfield filter"
msgstr "Completamento automatico per il filtro del campo di testo di base "

msgid "Field for autocomplete filter %label is not set in view %view, display %display"
msgstr "Il campo per il filtro di completamento automatico %label non è impostato nella vista %view, visualizzazione %display"

msgid "Field for autocomplete filter %label not exists in view %view, display %display"
msgstr "Il campo per il filtro di completamento automatico %label non esiste nella vista %view, visualizzazione %display"

msgid "Use Autocomplete for this filter."
msgstr "Utilizza il completamento automatico per questo filtro. "

msgid "Enter 0 for no limit."
msgstr "Inserire 0 per nessun limite."

msgid "Autocomplete suggestions will be filtered by other filter fields"
msgstr "I suggerimenti di completamento automatico verranno filtrati in base ad altri campi del filtro"

msgid "The selected field will be used for drop-down results of the autocompletion. In most cases it should be the same field you use for the filter, and <em>must</em> be included in the field list for the view/display in order to appear here."
msgstr "Il campo selezionato verrà utilizzato per i risultati a discesa del completamento automatico. Nella maggior parte dei casi, deve essere lo stesso campo utilizzato per il filtro e <em>deve</em> essere incluso nell'elenco dei campi per la vista/visualizzazione per poter essere mostrato qui."

msgid "Use unformatted data from database for dropdown list instead of field formatter result. Value will be printed as plain text."
msgstr "Utilizza i dati non formattati dal database per l'elenco a discesa invece del risultato del programma di formattazione del campo. Il valore verrà visualizzato come testo normale. "

msgid "The same as above, but for suggestion (text appearing inside textfield when item is selected)."
msgstr "Come l'opzione precedente, ma per il suggerimento (il testo viene visualizzato all'interno del campo di testo quando l'elemento viene selezionato). "

msgid "Add some fields to view"
msgstr "Aggiunge alcuni campi alla vista"

