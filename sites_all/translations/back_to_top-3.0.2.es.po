msgstr "Establezca el número de píxel que desencadena el valor predeterminado 100 de Volver al principio"

msgid "Where should the Back To Top button appear?"
msgstr "¿Dónde debe aparecer el botón Volver al principio?"

msgid "Bottom right"
msgstr "Inferior derecha"

msgid "Bottom left"
msgstr "Inferior izquierda"

msgid "Bottom center"
msgstr "Abajo centro"

msgid "Top right"
msgstr "Superior derecha"

msgid "Top left"
