msgid "Back To Top"
msgstr "Volver arriba"

msgid "Back To Top adds a button that hovers in the bottom of your screen and allow users to smoothly scroll up the page using jQuery."
msgstr "Volver al principio añade un botón en la parte inferior de la pantalla que permite a los usuarios subir fluidamente por la página utilizando jQuery."

msgid "User interface"
msgstr "Interfaz de usuario"

msgid "Back to Top"
msgstr "Volver arriba"

msgid "Administer Back To Top settings."
msgstr "Administrar valores de Volver al principio."

msgid "Back to top settings"
msgstr "Valores de Volver al principio"

msgid "Access Back to top settings"
msgstr "Acceder a los valores de Volver al principio"

msgid "Prevent on mobile and touch devices"
msgstr "Impedir en dispositivos móviles y táctiles"

msgid "Prevent on administration pages and node edit"
msgstr "Impedir en páginas de administración y edición de nodos"

msgid "Prevent on front page"
msgstr "Impedir en la primera página"

