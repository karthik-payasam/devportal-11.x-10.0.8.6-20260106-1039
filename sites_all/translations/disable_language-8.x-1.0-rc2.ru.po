msgid "Disable language"
msgstr "Выключить язык"

msgid "This will remove the language from the language switcher and filter out the Simple XML sitemap"
msgstr "Позволяет удалить язык из переключателя языков и отфильтровать простую карту сайта XML"

msgid "Select language to which we redirect"
msgstr "Выберите язык для перенаправления"

msgid "This option will redirect to the selected language when a user calls the disabled language"
msgstr "Позволяет выбрать язык для перенаправления в случае вызова выключенного языка"

msgid "Disabled"
msgstr "Отключено"

msgid "Yes"
msgstr "Да"

msgid "No"
msgstr "Нет"

msgid "Disable Language"
msgstr "Выключить язык"

msgid "A module that lets you disable multiple languages."
msgstr "Модуль, позволяющий выключить несколько языков."

msgid "Multilingual"
msgstr "Многоязычность"

msgid "Disable Language settings"
msgstr "Параметры модуля Выключить язык"

msgid "Configure the Disable Language module settings"
msgstr "Настроить параметры модуля Выключить язык"

msgid "View disabled languages"
msgstr "Просмотреть выключенные языки"

msgid "Allows the user to see disabled languages"
msgstr "Позволяет пользователю просмотреть выключенные языки"

msgid "Create content in disabled language"
msgstr "Создавать содержимое на выключенном языке"

msgid "Allows the user to create content in a disabled language"
msgstr "Позволяет пользователю создавать содержимое на выключенном языке"

msgid "Disable Language Settings"
msgstr "Параметры модуля Выключить язык"

msgid "List of route names that will redirect to themselves in the right language instead of the frontpage when accessed in a disabled language."
msgstr "Список имен маршрутов, которые должны перенаправлять пользователя на версию страницы на правильном языке вместо главной страницы в случае обращения на выключенном языке."

msgid "Redirect override route"
msgstr "Маршрут переопределения перенаправления"

msgid "Request path condition"
msgstr "Условие пути запроса"

msgid "Disable language settings"
msgstr "Выключить параметры языка"

msgid "Language to redirect to"
msgstr "Язык для перенаправления"

msgid "Help"
msgstr "Справка"

msgid "As we can't define appropriate cache invalidation, you will have to clear your cache after you save this form."
msgstr "Поскольку нам не удалось настроить аннулирование кэша, после сохранения этой формы вам потребуется очистить кэш."

msgid "Override routes"
msgstr "Переопределить маршруты"

msgid "Enter route names (one per line) that should redirect to themselves in the correct language instead of the frontpage"
msgstr "Введите имена маршрутов (по одному в строке), которые должны перенаправлять пользователя на версию на правильном языке, а не на главную страницу."

msgid "Exclude by path"
msgstr "Исключить по пути"

