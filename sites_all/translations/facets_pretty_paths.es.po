msgid "Pretty paths coder"
msgstr "Codificador Pretty Paths"

msgid "Facets Pretty Paths"
msgstr "Facets Pretty Paths"

msgid "Pretty paths for Facets."
msgstr "Pretty Paths para Facets."

msgid "Search"
msgstr "Buscar"

msgid "Facet Pretty Paths third party settings on the Facet config"
msgstr "Valores de terceros de Facet Pretty Paths en la configuración de Facet "

msgid "The coder plugin ID"
msgstr "El ID del plug-in del codificador "

msgid "Home"
msgstr "Inicio"

msgid "Pretty paths"
msgstr "Pretty Paths"

msgid "Pretty paths uses slashes as separator, e.g. /brand/drupal/color/blue"
msgstr "Pretty Paths utiliza barras inclinadas como separador, p. ej. /brand/drupal/color/blue"

msgid "Default"
msgstr "Por defecto"

msgid "Use the raw value, no special processing is done, e.g. /color/<strong>2</strong>"
msgstr "Utilice el valor en bruto, no se realiza ningún proceso especial, p. ej. /color/<strong>2</strong>"

msgid "Node title + id"
msgstr "Título de nodo + id"

msgid "Use node title with entity id, e.g. /color/<strong>blue-2</strong>"
msgstr "Utilice el título del nodo con el ID de la entidad, por ejemplo, <strong>blue-2</strong>"

msgid "Taxonomy term name + id"
msgstr "Nombre de término de taxonomía + id"

msgid "Use term name with term id, e.g. /color/<strong>blue-2</strong>"
msgstr "utilice el nombre de término con el ID de término, p. ej. /color/<strong>blue-2</strong>"

