msgstr "-- Sabit -- "

msgid "Which thread to run in when invoking with ?thread=N. Note: This setting only has an effect when cron is run through cron.php with an argument ?thread=N or through Drush with --options=thread=N."
msgstr "?thread=N ile çağrıldığında çalıştırılacak iş parçacığı. Not: Bu ayar yalnızca dönemsel iş ?thread=N bağımsız değişkeniyle cron.php ile ya da --options=thread=N içeren Drush ile çalıştırıldığında etkili olur."

msgid "%title must be greater than 0"
msgstr "%title 0'dan büyük olmalıdır"

msgid "Launched in thread @current_thread"
msgstr "@current_thread iş parçacığında başlatıldı"

msgid "Invalid thread available for starting launch thread"
msgstr "Başlatma iş parçacığını başlatmak için geçersiz iş parçacığı"

msgid "Thread @thread is already running"
msgstr "@thread iş parçacığı şu anda çalışıyor"

msgid "No free threads available for launching jobs"
msgstr "Başlatma işleri için boş iş parçacığı yok"

msgid "Serial"
msgstr "Seri"

msgid "Launches scheduled jobs in the same thread and runs them consecutively."
msgstr "Aynı iş parçacığında zamanlanmış işleri başlatır ve bunları art arda çalıştırır."

msgid "Stores the last log entry (and only the last) in the cache."
msgstr "Son günlük girdisini (ve yalnızca son) önbellekte depolar."

msgid "Lock #@original_lid was already closed and logged. Creating a new log entry #@lid"
msgstr "#@original_lid kilidi zaten kapatıldı ve günlüğe kaydedildi. #@lid yeni günlük girdisi oluşturuluyor"

msgid "@count_entries log entries removed for @jobs_count jobs"
msgstr "@count_entries günlük girdisi @jobs_count iş için kaldırıldı"

msgid "Invalid cleanup method: @method"
msgstr "Geçersiz temizleme yöntemi: @method"

msgid "Stores logs in the database."
msgstr "Günlükleri veritabanında depolar."

msgid "Next scheduled run at @datetime"
msgstr "Sonraki zamanlanan çalıştırma: @datetime"

msgid "Comma separated list of crontab rules."
msgstr "Crontab kurallarının virgülle ayrılmış listesi."

msgid "Rule is invalid"
msgstr "Kural geçersiz"

msgid "Use crontab rules for scheduling jobs."
msgstr "Zamanlama işleri için crontab kurallarını kullanın."

msgid "Every @interval"
msgstr "Her @interval"

msgid "Provides a set of predefined intervals for scheduling."
msgstr "Zamanlama için önceden tanımlı aralıkları sağlar."

