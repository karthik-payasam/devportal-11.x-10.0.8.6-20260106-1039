msgid "No destination directory provided."
msgstr "No se ha proporcionado ningún directorio de destino."

msgid "About"
msgstr "Acerca de"

msgid "Helper module to quickly import a list of terms with parent structure."
msgstr "Módulo de ayuda para importar rápidamente una lista de términos con estructura padre."

msgid "Term CSV Export/Import"
msgstr "Exportación/Importación de CSV de término"

msgid "Import and Export Taxonomy terms as csv."
msgstr "Importar y exportar términos de taxonomía como csv."

msgid "Taxonomy"
msgstr "Taxonomía"

msgid "Import and Export Taxonomy Terms as CSV"
msgstr "Importar y exportar términos de taxonomía como CSV"

msgid "Term CSV Import"
msgstr "Importación de CSV de término"

msgid "Term CSV Export"
msgstr "Exportación de CSV de término"

msgid "Administer CSV Term Import"
msgstr "Administrar importación de término CSV"

msgid "Allows a user to import taxonomy terms."
msgstr "Permite a un usuario importar términos de taxonomía."

msgid "CSV Term Import"
msgstr "Importación de términos CSV"

msgid "CSV Term Export"
msgstr "Exportación de términos CSV"

msgid "The header keys were not included in the import."
msgstr "Las claves de cabecera no estaban incluidas en la importación."

msgid "Line with \"@part\" could not be parsed. Incorrect number of values: @count."
msgstr "La línea con \"@part\" no se ha podido analizar. Número incorrecto de valores: @count."

msgid "The term @name has multiple matches. Ignoring."
msgstr "El término @name tiene varias coincidencias. Ignorando."

msgid "The term with id @id already exists and preserve existing terms is checked. No modification has been made."
msgstr "El término con el ID @id y Conservar términos existentes está seleccionado. No se ha realizado ninguna modificación."

msgid "The Term ID already exists."
msgstr "El ID del término ya existe."

msgid "More than 1 terms are named @name. Cannot distinguish by name. Try using id export/import."
msgstr "Más de 1 término se llama @name. No se puede distinguir por el nombre. Intente utilizar la exportación/importación de ID."

msgid "The field data <em>@data</em> is not formatted correctly. Please use the export function."
msgstr "Los datos de campo <em>@data</em> no tienen un formato correcto. Utilice la función de exportación."

msgid "The field data <em>@data</em> could not be imported. Please add the appropriate fields to the vocabulary you are importing into."
msgstr "Los datos de campo <em>@data</em> no se han podido importar. Añada los campos apropiados al vocabulario en el que está importando."

msgid "Imported @count terms."
msgstr "Se han importado @count términos."

msgid "Include Term Ids in export."
msgstr "Incluir ID de término en la exportación."

msgid "Include Term Headers in export."
msgstr "Incluir cabeceras de término en la exportación."

msgid "Include extra fields in export."
msgstr "Incluir campos adicionales en la exportación."

msgid "Note that fields are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"
msgstr "Tenga en cuenta que los campos están desfilizados mediante <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"

msgid "Export"
msgstr "Exportar"

msgid "CSV Data"
msgstr "Datos CSV"

msgid "The formatted term data"
msgstr "Los datos de término con formato"

msgid "Input"
msgstr "Entrada"

msgid "<p><strong>See CSV Export for an example.</strong></p><p>Enter in the form of: <pre>\"name,status,description,format,weight,parent_name,[any_additional_fields];</pre><pre>name,status,description,format,weight,parent_name[;parent_name1;parent_name2;...],[any_additional_fields]\"</pre> or <pre>\"tid,uuid,name,status,revision_id,description,format,weight,parent_name[;parent_name1;parent_name2;...],parent_tid[;parent_tid1;parent_tid2;...],[any_additional_fields];</pre><pre>tid,uuid,name,status,revision_id,description,format,weight,parent_name,parent_tid,[any_additional_fields]\"</pre> Note that <em>[any_additional_fields]</em> are optional and are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>If you need to export from Drupal 7, you can import and modify the view d7exportview.txt found at the root directory of this project</p>"
msgstr "<p><strong>Consulte la exportación de CSV para ver un ejemplo.</strong></p><p>Entre con la forma de: <pre>\"nombre,estado,descripción,formato,peso,nombre_padre,[cualquier_campo_adicional];</pre><pre>nombre,estado,descripción,formato,peso,nombre_padre[;nombre1_padre;nombre2_padre;...],[cualquier_campo_adicional]\"</pre> o <pre>\"tid,uuid,nombre,estado,id_revisión,formato,peso,nombre_padre[;nombre1_padre;nombre2_padre;...],tid_padre[;tid1_padre;tid2_padre;...],[cualquier_campo_adicional];</pre><pre>tid,uuid,nombre,estado,id_revisión,descripción,formato,peso,nombre_padre,tid_padre,[cualquier_campo_adicional]\"</pre> Tenga en cuenta que <em>[cualquier_campo_adicional]</em> es opcional y se desfiliza utilizando <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>Si necesita exportar desde Drupal 7, puede importar y modificar la vista d7exportview.txt que se encuentra en el directorio raíz de este proyecto</p>"

msgid "Preserve Vocabularies on existing terms."
msgstr "Conservar vocabularios en términos existentes."

msgid "Preserve existing terms. This will prevent a term id collision if importing from another install."
msgstr "Conservar términos existentes. Esto impedirá un conflicto de ID del término si se importa de otra instalación."

msgid "Next"
msgstr "Siguiente"

msgid "Name"
msgstr "Nombre"

msgid "Create New Vocabulary"
msgstr "Crear nuevo vocabulario"

msgid "Create Vocabulary"
msgstr "Crear vocabulario"

msgid "Are you sure you want to copy @count_terms terms into the vocabulary @vocabulary@preserve_vocabularies?"
msgstr "¿Está seguro de que desea copiar @count_terms términos en el vocabulario @vocabulary@preserve_vocabularies?"

msgid "Import"
msgstr "Importar"

