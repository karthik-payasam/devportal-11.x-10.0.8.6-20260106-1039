msgid "In order to use the Simple XML Sitemap Views module, the Views URL generator must be <a href=\"@url\">added</a> to a sitemap type."
msgstr "Chcete-li použít modul Jednoduchá mapa webu v XML (pohledy), musí být generátor adres URL pohledů <a href=\"@url\">přidán</a> do typu webové mapy."

msgid "Simple XML Sitemap (Views)"
msgstr "Jednoduchá mapa webu v XML (pohledy)"

msgid "Provides integration of the Simple XML Sitemap module with the Views module."
msgstr "Zajišťuje integraci modulu Jednoduchá mapa webu v XML s modulem Pohledy."

msgid "SEO"
msgstr "SEO"

msgid "Views"
msgstr "Pohledy"

msgid "Simple XML Sitemap"
msgstr "Jednoduchá mapa webu XML"

msgid "Variants"
msgstr "Varianty"

msgid "Index"
msgstr "Rejstřík"

msgid "Priority"
msgstr "Priorita"

msgid "Change frequency"
msgstr "Změnit frekvenci"

msgid "Indexed arguments"
msgstr "Indexované argumenty"

msgid "Max links"
msgstr "Maximální počet odkazů"

msgid "View"
msgstr "Zobrazit"

msgid "Display"
msgstr "Zobrazit"

msgid "Sitemaps"
msgstr "Mapy webu"

msgid "Operations"
msgstr "Operace"

msgid "No view displays are set to be indexed yet. <a href=\"@url\">Edit a view.</a>"
msgstr "Zatím nejsou nastaveny žádné pohledy, které mají být indexovány. <a href=\"@url\">Upravit pohled.</a>"

msgid "Please configure at least one <a href=\"@sitemaps_url\">sitemap</a> to be of a <a href=\"@types_url\">type</a> that implements the views URL generator."
msgstr "Nakonfigurujte alespoň jednu <a href=\"@sitemaps_url\">webovou mapu</a> <a href=\"@types_url\">typu</a>, který implementuje generátor adres URL pohledů."

msgid "Edit"
msgstr "Upravit"

msgid "Garbage collection in the simple_sitemap_views table"
msgstr "Uvolňování paměti v tabulce simple_sitemap_views"

msgid "Views URL generator"
msgstr "Generátor adres URL pohledů"

msgid "Generates URLs for views."
msgstr "Generuje adresy URL pro pohledy."

msgid "Index this display in sitemap <em>@variant_label</em>"
msgstr "Indexujte toto zobrazení v mapě webu <em>@variant_label</em>"

msgid "The priority this display will have in the eyes of search engine bots."
msgstr "Priorita, kterou bude mít toto zobrazení v očích robotů vyhledávačů."

msgid "The frequency with which this display changes. Search engine bots may take this as an indication of how often to index it."
msgstr "Frekvence, se kterou se mění toto zobrazení. Roboty vyhledávačů mohou toto nastavení považovat za stanovení četnosti indexace."

msgid "Maximum display variations"
msgstr "Maximální počet variant zobrazení"

msgid "The maximum number of link variations to be indexed for this display. If left blank, each argument will create link variations for this display. Use with caution, as a large number of argument values​can significantly increase the number of sitemap links."
msgstr "Maximální počet variant odkazů, které mají být indexovány pro toto zobrazení. Není-li tato hodnota vyplněná, bude každý argument vytvářet varianty odkazů pro toto zobrazení. Používat opatrně, protože velký počet hodnot argumentů může značně zvýšit počet odkazů na mapu webu."

msgid "Simple XML Sitemap settings for this display"
msgstr "Nastavení Jednoduché mapy webu v XML pro toto zobrazení"

msgid "Included in sitemaps: @variants"
msgstr "Zahrnuto v mapách webů: @variants"

msgid "Excluded from all sitemaps"
msgstr "Vyloučeno ze všech map webů"

msgid "To enable indexing of an argument, you must enable indexing of all previous arguments."
msgstr "Chcete-li povolit indexování argumentu, je třeba povolit indexování všech předchozích argumentů."

msgid "Simple XML Sitemap settings for this view."
msgstr "Nastavení Jednoduché mapy webu v XML pro tento pohled."

