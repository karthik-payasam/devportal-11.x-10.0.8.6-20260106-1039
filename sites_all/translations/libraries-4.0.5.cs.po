msgid "Lists registered library information."
msgstr "Vypisuje informace o registrovaných knihovnách."

msgid ""
"Downloads a registered library into the libraries directory for the active site.\n"
"\n"
"See libraries-list for a list of registered libraries."
msgstr ""
"Stáhněte si registrovanou knihovnu do adresáře libraries pro aktivní web.\n"
"\n"
"Seznam registrovaných knihoven viz libraries-list."

msgid "Name"
msgstr "Jméno"

msgid "Status"
msgstr "Stav"

msgid "Version"
msgstr "Verze"

msgid "Variants"
msgstr "Varianty"

msgid "Dependencies"
msgstr "Závislosti"

msgid "OK"
msgstr "OK"

msgid "Missing dependency: unzip. Install it before using this command."
msgstr "Chybí závislost: unzip. Nainstalujte ji před použitím tohoto příkazu."

msgid "Directory @path was created"
msgstr "Byl vytvořen adresář @path"

msgid "A existing Colorbox plugin was overwritten at @path"
msgstr "Byl přepsán stávající modul plugin Colorbox v adresáři @path"

msgid "Colorbox plugin has been downloaded to @path"
msgstr "Plugin Colorbox byl stažen do adresáře @path"

msgid "Drush was unable to download the Colorbox plugin to @path"
msgstr "Programu Drush se nezdařilo stažení modulu plugin Colorbox do adresáře @path"

msgid "The %dependency library, which the %library library depends on, is not installed."
msgstr "Není nainstalována knihovna %dependency, na které závisí knihovna %library."

msgid "The version %dependency_version of the %dependency library is not compatible with the %library library."
msgstr "Verze %dependency_version knihovny %dependency není kompatibilní s knihovnou %library."

msgid "The %library library could not be found."
msgstr "Knihovna %library nebyla nalezena."

msgid "The version of the %library library could not be detected."
msgstr "Nelze detekovat verzi knihovny %library."

msgid "The installed version %version of the %library library is not supported."
msgstr "Nainstalovaná verze %version knihovny %library není podporována."

msgid "The %variant variant of the %library library could not be found."
msgstr "Nebyla nalezena varianta %variant knihovny %library."

msgid "The following external libraries could not successfully be registered with Drupal core: @libs. See earlier log entries for more details. Once these issues are addressed please be sure to clear your Drupal library cache to ensure external library detection is run again."
msgstr "Nezdařila se registrace těchto externích knihoven s jádrem Drupal: @libs. Další podrobnosti naleznete v dřívějších záznamech protokolu. Po vyřešení těchto problémů vyprázdněte mezipaměť knihoven Drupal, a zajistěte tak opětovné spuštění detekce externích knihoven."

msgid "Libraries"
msgstr "Knihovny"

msgid "Allows version-dependent and shared usage of external libraries."
msgstr "Umožňuje na verzích závislé a sdílené používání externích knihoven."

msgid "Libraries API settings"
msgstr "Nastavení rozhraní API knihoven"

msgid "Library definition settings"
msgstr "Nastavení definice knihovny"

msgid "Local"
msgstr "Místní"

msgid "Local path"
msgstr "Lokální cesta"

msgid "Enable remote fetching of library definitions"
msgstr "Povolit vzdálené načítání definic knihoven"

msgid "A list of remote library registry URLs"
msgstr "Seznam adres URL vzdálených registrů knihoven"

msgid "The URL of a remote library registry"
msgstr "Adresa URL vzdáleného registru knihoven"

msgid "URI locator configuration"
msgstr "Konfigurace lokátoru identifikátoru URI"

msgid "The locator URI"
msgstr "Lokátor identifikátoru URI"

msgid "Assets"
msgstr "Aktiva"

msgid "Provides access to asset library files."
msgstr "Poskytuje přístup k souborům knihoven aktiv."

msgid "Library definitions"
msgstr "Definice knihoven"

msgid "Provides access to library definition files."
msgstr "Poskytuje přístup k souborům s definicemi knihoven."

msgid "PHP library files"
msgstr "Soubory knihoven PHP"

msgid "Provides access to PHP library files."
msgstr "Poskytuje přístup k souborům knihoven PHP."

