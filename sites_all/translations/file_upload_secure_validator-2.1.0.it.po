msgid "About"
msgstr "Informazioni"

msgid "Secure File Upload Mime Detect"
msgstr "Rilevamento Mime di caricamento file sicuro"

msgid "Fileinfo extension"
msgstr "Estensione Fileinfo"

msgid "Found"
msgstr "Trovato"

msgid "Fileinfo extension not available"
msgstr "Estensione Fileinfo non disponibile"

msgid "File upload secure validator module uses Fileinfo extension. It seems as if Fileinfo extension is not loaded/enabled. If you are using Windows, may be, you should uncomment php_fileinfo.dll in php.ini file."
msgstr "Il modulo di convalida sicuro del caricamento file utilizza l'estensione Fileinfo. Sembra che l'estensione Fileinfo non sia stata caricata o abilitata. Se si utilizza Windows, potrebbe essere necessario togliere il commento a php_fileinfo.dll nel file php.ini."

msgid "File Upload Secure Validator"
msgstr "Programma di convalida sicuro del caricamento file"

msgid "Secure Mime Detect"
msgstr "Rilevamento Mime sicuro"

msgid "Security"
msgstr "Sicurezza"

msgid "Manage the list of MIME types equivalence groups."
msgstr "Gestire i gruppi di equivalenza dell'elenco di tipi MIME."

msgid "Administer File Upload Secure Validator configuration"
msgstr "Amministra configurazione del programma di convalida sicuro del caricamento file"

msgid "Allow user to administer File Upload Secure Validator configuration."
msgstr "Consente all'utente di gestire la configurazione del programma di convalida sicuro del caricamento file."

msgid "SettingsForm"
msgstr "SettingsForm"

msgid "MIME types equivalence groups"
msgstr "Gruppi di equivalenza dei tipi MIME"

msgid "MIME types equivalence group"
msgstr "Gruppo di equivalenza dei tipi MIME"

msgid "MIME type"
msgstr "Tipo MIME"

msgid "MIME types equivalence group(s)"
msgstr "Gruppi di equivalenza dei tipi MIME"

msgid "A CSV-like list of MIME types groups; if two MIME types are part of the same group, then, File Upload Secure Validator will not protest."
msgstr "Un elenco di MIME di tipo CSV; se due tipi MIME fanno parte dello stesso gruppo, il Programma di convalida sicura del caricamento file non genererà errori."

msgid "Caught an InvalidArgumentException; cannot validate missing file requested as @path"
msgstr "È stata rilevata un'eccezione InvalidArgument; impossibile convalidare il file mancante richiesto come @path"

msgid "There was a problem with this file. The uploaded file is of type @extension but the real content seems to be @real_extension"
msgstr "Si è verificato un problema con questo file. Il file caricato è di tipo @extension ma il contenuto reale sembra essere @real_extension"

msgid "Error while uploading file: MimeTypeGuesser guessed '%mime_by_fileinfo' and fileinfo '%mime_by_filename'"
msgstr "Errore durante il caricamento del file: MimeTypeGuesser ha provato '%mime_by_fileinfo' e fileinfo '%mime_by_filename'"

