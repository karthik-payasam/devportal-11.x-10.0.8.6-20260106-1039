msgid "Pretty paths coder"
msgstr "Kodér pretty paths"

msgid "Facets Pretty Paths"
msgstr "Fazety pretty paths"

msgid "Pretty paths for Facets."
msgstr "Pretty paths pro fazety."

msgid "Search"
msgstr "Hledat"

msgid "Facet Pretty Paths third party settings on the Facet config"
msgstr "Nastavení třetí strany fazety Pretty Paths v rámci konfigurace fazety"

msgid "The coder plugin ID"
msgstr "ID modulu plug-in kodéru"

msgid "Home"
msgstr "Domů"

msgid "Pretty paths"
msgstr "Pretty paths"

msgid "Pretty paths uses slashes as separator, e.g. /brand/drupal/color/blue"
msgstr "Cesty pretty paths používají jako oddělovač lomítka, např. /brand/drupal/color/blue"

msgid "Default"
msgstr "Výchozí"

msgid "Use the raw value, no special processing is done, e.g. /color/<strong>2</strong>"
msgstr "Použijte nezpracovanou hodnotu, neprobíhá žádné speciální zpracování, např. /color/<strong>2</strong>"

msgid "Node title + id"
msgstr "Název uzlu + ID"

msgid "Use node title with entity id, e.g. /color/<strong>blue-2</strong>"
msgstr "Použijte název entity s ID entity, např. /color/<strong>blue-2</strong>"

msgid "Taxonomy term name + id"
msgstr "Název taxonomického termínu + id"

msgid "Use term name with term id, e.g. /color/<strong>blue-2</strong>"
msgstr "Použijte název termínu s ID termínu, např. /color/<strong>blue-2</strong>"

