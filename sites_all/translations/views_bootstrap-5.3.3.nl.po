msgid "@style style will not display without the \"@field\" setting."
msgstr "Als \"@field\" niet is ingesteld, wordt de stijl @style niet afgebeeld."

msgid "About"
msgstr "Over"

msgid "The <a href=\":bootstrap\">Views Bootstrap module</a> adds styles to Views to output the results of a view as several common <a href=\":components\">Twitter Bootstrap</a> components."
msgstr "De module <a href=\":bootstrap\">Views Bootstrap</a> breidt Views uit met extra stijlen voor de uitvoer van de resultaten van een view in de vorm van enkele algemene <a href=\":components\">Twitter Bootstrap</a>-componenten."

msgid "Uses"
msgstr "Gebruikt"

msgid "<a href=\":views\">Create a view</a> using one of the following styles:"
msgstr "<a href=\":views\">Maak een view</a> met een van de volgende stijlen:"

msgid "<a href=\":docs\">Accordion</a>"
msgstr "<a href=\":docs\">Harmonica</a>"

msgid "<a href=\":docs\">Cards</a>"
msgstr "<a href=\":docs\">Kaarten</a>"

msgid "<a href=\":docs\">Carousel</a>"
msgstr "<a href=\":docs\">Carrousel</a>"

msgid "<a href=\":docs\">Dropdown</a>"
msgstr "<a href=\":docs\">Vervolgkeuzemenu</a>"

msgid "<a href=\":docs\">Grid</a>"
msgstr "<a href=\":docs\">Raster</a>"

msgid "<a href=\":docs\">Thumbnails</a>"
msgstr "<a href=\":docs\">Miniaturen</a>"

msgid "<a href=\":docs\">Tables</a>"
msgstr "<a href=\":docs\">Tabellen</a>"

msgid "<a href=\":docs\">Tabs</a>"
msgstr "<a href=\":docs\">Tabs</a>"

msgid "<a href=\":docs\">Media object</a>"
msgstr "<a href=\":docs\">Mediaobject</a>"

msgid "<a href=\":docs\">List group</a>"
msgstr "<a href=\":docs\">Lijstgroep</a>"

msgid "Views Bootstrap"
msgstr "Views-bootstrap"

msgid "Views Twitter Bootstrap Components."
msgstr "Twitter-bootstrapcomponenten Views"

msgid "Views"
msgstr "Overzichten"

msgid "The Bootstrap accordion displays content in collapsible panels (<a href=\":docs\">see documentation</a>)."
msgstr "De Bootstrap-harmonica beeldt content af in samenvouwbare panelen (<a href=\":docs\">zie documentatie</a>)."

msgid "Panel title field"
msgstr "Veld voor schermtitel"

msgid "Select the field that will be used as the accordion panel titles."
msgstr "Selecteer het scherm dat gebruikt moet worden als titel voor harmonicaschermen."

msgid "Label field"
msgstr "Labelveld"

msgid "- None -"
msgstr "- Geen -"

msgid "Select the field that will be used as the label."
msgstr "Selecteer het veld dat als label wordt gebruikt."

msgid "Collapse Options"
msgstr "Opties samenvouwen"

msgid "All Items Closed"
msgstr "Alle items gesloten"

msgid "First Item Open"
msgstr "Eerste item geopend"

msgid "All Items Open"
msgstr "Alle items geopend"

msgid "Default panel state for collapse behavior."
msgstr "Standaard vensterstatus voor gedrag van samenvouwen."

msgid "Bootstrap Accordion"
msgstr "Bootstrap-harmonica"

msgid "Displays rows in a Bootstrap Accordion."
msgstr "Zorgt ervoor dat rijen worden afgebeeld in een Bootstrap-harmonica."

msgid "Card title field"
msgstr "Veld voor kaarttitel"

msgid "Select the field that will be used for the card title."
msgstr "Selecteer het veld dat moet worden gebruikt voor de kaarttitel."

msgid "Card content field"
msgstr "Contentveld voor kaart"

msgid "Select the field that will be used for the card content."
msgstr "Selecteer het veld dat moet worden gebruikt voor de kaartcontent."

msgid "Card image field"
msgstr "Veld voor kaartafbeelding"

msgid "Select the field that will be used for the card image."
msgstr "Selecteer het veld dat moet worden gebruikt voor de kaartafbeelding."

msgid "Custom card group class"
msgstr "Aangepaste klasse voor kaartgroep"

msgid "Additional classes to provide on the card group. Separated by a space."
msgstr "Aanvullende klassen die voor de kaartgroep moeten worden verstrekt. Van elkaar gescheiden door spaties."

msgid "Additional classes to provide on each card. Separated by a space."
msgstr "Extra klassen die bij elke kaart moten worden opgegeven. Van elkaar gescheiden door spaties."

msgid "Bootstrap Cards"
msgstr "Bootstrapkaarten"

msgid "Displays rows in a Bootstrap Card Group layout"
msgstr "Zorgt ervoor dat rijen worden afgebeeld in een Bootstrap-kaartgroeplayout."

msgid "The Bootstrap carousel displays content as a slideshow (<a href=\":docs\">see documentation</a>)."
msgstr "De bootstrap-carrousel beeldt content af in de vorm van een diapresentatie (<a href=\":docs\">zie documentatie</a>)."

msgid "<None>"
msgstr "- Geen -"

msgid "Interval"
msgstr "Interval"

msgid "The amount of time to delay between automatically cycling an item. If false, carousel will not automatically cycle."
msgstr "Hoe lang het duurt voordat een item automatisch wisselt. Bij 0 zal de carrousel niet automatisch wisselen."

msgid "Show navigation"
msgstr "Navigatie tonen"

msgid "Show indicators"
msgstr "Toon indicatoren"

msgid "Pause on hover"
msgstr "Pauzeren bij aanwijzen"

msgid "Pauses the cycling of the carousel on mouseenter and resumes the cycling of the carousel on mouseleave."
msgstr "Hiermee wordt het rouleren van de carrousel onderbroken als de muisaanwijzer erop staat en wordt het rouleren hervat als de muisaanwijzer weggaat."

msgid "Wrap"
msgstr "Doordraaien"

msgid "The carousel should cycle continuously or have hard stops."
msgstr "De carrousel moet doorlopend rouleren of harde stops hebben."

msgid "Columns"
msgstr "Kolommen"

msgid "The number of columns to include in the carousel."
msgstr "Het aantal kolommen dat in de carrousel moet worden opgenomen."

msgid "Breakpoints"
msgstr "Breakpoints"

msgid "The min-width breakpoint of the multicolumn carousel."
msgstr "Het minimumbreedte-breekpunt van de carrousel met meerdere kolommen."

msgid "Extra Small"
msgstr "Extra klein"

msgid "Small"
msgstr "Klein"

msgid "Medium"
msgstr "Medium"

msgid "Large"
msgstr "Groot"

msgid "Display"
msgstr "Weergave"

msgid "Select by fields"
msgstr "Op velden selecteren"

msgid "Display fields as row content"
msgstr "Velden weergeven als rij-inhoud"

msgid "Displaying fields as row content will output the field rows as unformatted values within each carousel item."
msgstr "Door velden als rij-inhoud weer te geven, worden de veldrijen als niet-ingedeelde waarden binnen elk carrousel-item weergegeven."

msgid "Image"
msgstr "Afbeelding"

msgid "Title"
msgstr "Titel"

msgid "Description"
msgstr "Beschrijving"

msgid "Bootstrap Carousel"
msgstr "Bootstrap-carrousel"

msgid "Displays rows in a Bootstrap Carousel."
msgstr "Zorgt ervoor dat rijen worden afgebeeld in een Bootstrap-carrousel."

msgid "The Bootstrap dropdown style displays a list of links in a drop-down menu format (<a href=\":docs\">see documentation</a>)."
msgstr "De bootstrap-menustijl toont een lijst van links in een vervolgkeuzemenu (<a href=\":docs\">zie documentatie</a>)."

msgid "Button text"
msgstr "Knoptekst"

msgid "Text label for the button that is the drop-down toggle."
msgstr "Tekstlabel voor de knop die de schakeling naar de keuzelijst vormt."

msgid "Button class"
msgstr "Knopklasse"

msgid "Classes for the button that is the drop-down toggle."
msgstr "Klasse van de knop die de schakeling naar de keuzelijst vormt."

msgid "Default"
msgstr "Standaard"

msgid "Primary"
msgstr "Primaire"

msgid "Success"
msgstr "Succes"

msgid "Info"
msgstr "Info"

msgid "Warning"
msgstr "Waarschuwing"

msgid "Danger"
msgstr "Gevaar"

msgid "Wrapper class"
msgstr "Wrapper-klasse"

msgid "The class to provide on the wrapper, outside the list."
msgstr "De klasse om toe te voegen aan de wrapper, buiten de lijst."

msgid "List class"
msgstr "Lijstklasse"

msgid "The class to provide on the list element itself."
msgstr "De klasse om aan het lijstelement zelf toe te voegen."

msgid "Bootstrap Dropdown"
msgstr "Bootstraplijst"

msgid "Displays rows in a Bootstrap Dropdown."
msgstr "Beeldt de rijen van een bootstraplijst af."

msgid "The Bootstrap grid displays content in a responsive, mobile first fluid grid (<a href=\":docs\">see documentation</a>)."
msgstr "Het bootstrapraster bevat content in een responsief, op mobiele apparaten gericht vloeiend raster (<a href=\":docs\">zie documentatie</a>)."

msgid "Alignment"
msgstr "Uitlijning"

msgid "Horizontal"
msgstr "Horizontaal"

msgid "Vertical"
msgstr "Verticaal"

msgid ""
"Horizontal alignment will place items starting in the upper left and moving right.\n"
"      Vertical alignment will place items starting in the upper left and moving down."
msgstr ""
"Bij horizontale uitlijning worden de items links bovenin geplaatst en bewegen ze naar rechts.\n"
"      Bij verticale uitlijning worden de items links bovenin geplaatst en bewegen ze omlaag."

msgid "Default column classes"
msgstr "Standaard kolomklassen"

msgid "Add the default views column classes like views-col, col-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Voegt de standaard Views-kolomklassen zoals views-col, col-1 en clearfix toe. Dit kan gebruikt worden om de hoeveelheid opmaak die het overzicht standaard levert snel te verminderen. Dit maakt het echter moeilijker om CSS toe te voegen."

msgid "Custom column class"
msgstr "Aangepaste kolom-klasse"

msgid "Additional classes to provide on each column. Separated by a space."
msgstr "Aanvullende klassen voor iedere kolom. Meerdere klassen met spaties scheiden."

msgid "You may use field tokens from as per the \"Replacement patterns\" used in \"Rewrite the output of this field\" for all fields."
msgstr "Er kunnen veld-tokens worden gebruikt, zoals te vinden onder \"Vervangingspatronen\" in de rubriek \"Uitvoer van dit veld herschrijven\" van ieder veld."

msgid "Default row classes"
msgstr "Standaard rijklassen"

msgid "Adds the default views row classes like views-row, row-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Voegt de standaard rij-klassen zoals views-row, row-1 en clearfix toe. Dit kan gebruikt worden om de hoeveelheid opmaak die standaard gegenereerd wordt door het overzicht snel te verminderen. Dit maakt echter het toevoegen van CSS moeilijker."

msgid "Custom row class"
msgstr "Aangepaste rij-klasse"

msgid "Additional classes to provide on each row. Separated by a space."
msgstr "Aanvullende klassen voor iedere rij. Meerdere klassen met spaties scheiden."

msgid "Base number of columns"
msgstr "Basisaantal kolommen"

msgid "all"
msgstr "alle"

msgid "Choose the number of columns that views will wrap in a single row. This will be reflected in the HTML structure rendered regardless of the device size. If selecting \"all\" then use the alternative template."
msgstr "Kies het aantal kolommen dat in één rij van een view wordt ingepakt. Dit wordt weerspiegeld in de HTML-structuur die wordt weergegeven, ongeacht de grootte van het apparaat. Als u \"alles\" selecteert, gebruik dan de alternatieve sjabloon."

msgid "Number of columns (col-@size)"
msgstr "Aantal kolommen (col-@size)"

msgid "This adds col-@size to the div."
msgstr "Hiermee wordt col-@size toegevoegd aan de div."

msgid "Bootstrap Grid"
msgstr "Bootstrap-raster"

msgid "Displays rows in a Bootstrap Grid layout"
msgstr "Zorgt ervoor dat rijen worden afgebeeld in een Bootstrap-rasterlayout."

msgid "The Bootstrap list group displays content in an unordered list with list group classes (<a href=\":docs\">see documentation</a>)."
msgstr "De lijstgroep Bootstrap beeldt content af in een niet-geordende lijst met lijstgroepklassen (<a href=\":docs\">zie documentatie</a>)."

msgid "Set group field in panel heading"
msgstr "Groepsveld instellen in schermkop"

msgid "Title field"
msgstr "Titelveld"

msgid "Select the field that will be used as the title."
msgstr "Selecteer het veld dat als titel wordt gebruikt."

msgid "Bootstrap List Group"
msgstr "Bootstrap-lijstgroep"

msgid "Displays rows in a Bootstrap List Group."
msgstr "Zorgt ervoor dat rijen worden afgebeeld in een Bootstrap-lijstgroep."

msgid "The Bootstrap media object displays content with an image item lead with heading and text (<a href=\":docs\">see documentation</a>)."
msgstr "Het Bootstrap-mediaobject beeldt content af met een afbeeldingsitem met kop en tekst (<a href=\":docs\">zie documentatie</a>)."

msgid "Heading field"
msgstr "Titelveld"

msgid "Select the field that will be used as the media object heading. Exclude this field from display to prevent duplication."
msgstr "Selecteer het veld dat moet worden gebruikt als kop voor het mediaobject. Sluit dit veld uit van weergave om duplicatie te voorkomen."

msgid "Image field"
msgstr "Afbeeldingsveld"

msgid "Select the field that will be used as the media object image. Exclude this field from display to prevent duplication."
msgstr "Selecteer het veld dat moet worden gebruikt als afbeelding voor het mediaobject. Sluit dit veld uit van weergave om duplicatie te voorkomen."

msgid "Body field"
msgstr "Corpusveld"

msgid "All fields that are not excluded from display will be shown as the body."
msgstr "Alle velden die niet zijn uitgesloten van weergave worden afgebeeld als lopende tekst."

msgid "Image Alignment"
msgstr "Uitlijning van afbeeldingen"

msgid "Left"
msgstr "Links"

msgid "Right"
msgstr "Rechts"

msgid "Middle"
msgstr "Midden"

msgid "Align the media object image left or right."
msgstr "Lijn de afbeelding van het mediaobject links of rechts uit."

msgid "Bootstrap Media Object"
msgstr "Bootstrap-mediaobject"

msgid "Displays rows in a Bootstrap Media Object."
msgstr "Zorgt ervoor dat rijen worden afgebeeld in een Bootstrap-mediaobject."

msgid "The Bootstrap panels displays content in a box with optional header and footer elements (<a href=\":docs\">see documentation</a>)."
msgstr "De Bootstrap-vensters beelden content af in een vak met optionele koptekst- en voettekstelementen (<a href=\":docs\">zie documentatie</a>)."

msgid "Contextual class"
msgstr "Contextuele klasse"

msgid "<a href=\":docs\">see Bootstrap documentation</a>"
msgstr "<a href=\":docs\">zie de Bootstrap-documentatie</a>"

msgid "Select the field that will be used as the panel heading titles."
msgstr "Selecteer het veld dat wordt gebruikt als titel van de schermkop."

msgid "Panel footer field"
msgstr "Veld voor schermvoettekst"

msgid "Select the field that will be used as the panel footer."
msgstr "Selecteer het veld dat wordt gebruikt als schermvoettekst."

msgid "Bootstrap Panels"
msgstr "Bootstrapvensters"

msgid "Displays rows in a Bootstrap Panel."
msgstr "Beeldt de rijen van een bootstrapvenster af."

msgid "The Bootstrap tabs displays content with tab titles linked to dynamically displayed content (<a href=\":docs\">see documentation</a>)."
msgstr "Op de Bootstrap-tabbladen wordt content afgebeeld met tabtitels die gekoppeld zijn aan dynamisch afgebeelde content (<a href=\":docs\">zie documentatie</a>)."

msgid "Tab field"
msgstr "Tabveld"

msgid "Select the field that will be used as the tab."
msgstr "Selecteer het veld dat moet worden gebruikt als tab."

msgid "Tab Type"
msgstr "Type tab"

msgid "Tabs"
msgstr "Tabbladen"

msgid "Pills"
msgstr "Pillen"

msgid "List"
msgstr "Lijst"

msgid "Position of tabs"
msgstr "Positie van tabbladen"

msgid "Tabs/pills on the top"
msgstr "Tabbladen/pillen bovenin"

msgid "Tabs/pills on the left"
msgstr "Tabbladen/pillen links"

msgid "Tabs/pills on the right"
msgstr "Tabbladen/pillen rechts"

msgid "Tabs/pills on the bottom"
msgstr "Tabbladen/pillen onderin"

msgid "Tabs/pills justified on the top"
msgstr "Tabbladen/pillen uitgevuld bovenin"

msgid "Tabs/pills stacked"
msgstr "Tabbladen/pillen gestapeld"

msgid "Fade Effect"
msgstr "Fade-effect"

msgid "Add a fade in effect when tabs clicked"
msgstr "Een fade-effect toevoegen als er op tabbladen geklikt wordt"

msgid "Bootstrap Tabs"
msgstr "Bootstraptabbladen"

msgid "Displays rows in Bootstrap Tabs."
msgstr "Zorgt ervoor dat rijen worden afgebeeld op Bootstrap-tabs."

msgid "The Bootstrap table style adds default Bootstrap table classes and optional classes (<a href=\":docs\">see documentation</a>)."
msgstr "De Bootstrap-tabelstijl voegt standaard Bootstrap-tabelklassen en optionele klassen toe (<a href=\":docs\">zie documentatie</a>)."

msgid "Responsive"
msgstr "Responsive"

msgid "To make a table scroll horizontally on small devices."
msgstr "Om het mogelijk te maken om op kleine apparaten horizontaal door een tabel te scrollen."

msgid "Bootstrap styles"
msgstr "Bootstrap-stijlen"

msgid "Striped"
msgstr "Gestreept"

msgid "Bordered"
msgstr "Omrand"

msgid "Hover"
msgstr "Zweven"

msgid "Condensed"
msgstr "Verkleind"

msgid "Caption for the table"
msgstr "Bijschrift voor de tabel"

msgid "A title semantically associated with your table for increased accessibility."
msgstr "Een titel die semantisch bij uw tabel hoort, voor extra toegankelijkheid."

msgid "Table details"
msgstr "Details van tabel"

msgid "Summary title"
msgstr "Samenvattingstitel"

msgid "Table description"
msgstr "Tabelbeschrijving"

msgid "Provide additional details about the table to increase accessibility."
msgstr "Aanvullende informatie over de tabel opgeven om de toegankelijkheid te vergroten."

msgid "Bootstrap Table"
msgstr "Bootstrap tabel"

msgid "Displays rows in a Bootstrap table."
msgstr "Zorgt ervoor dat rijen worden afgebeeld in een Bootstrap-tabel."

msgid "The Bootstrap thumbnails extends the grid display with the thumbnail component to showcase linked images (<a href=\":docs\">see documentation</a>)."
msgstr "De Bootstrap-miniaturen breiden de rasterweergave uit met de miniatuurcomponent voor het weergeven van gelinkte afbeeldingen (<a href=\":docs\">zie documentatie</a>)."

msgid "Bootstrap Thumbnails"
msgstr "Bootstrap-miniaturen"

msgid "Displays rows in a Bootstrap Grid layout with thumbnails"
msgstr "Hiermee worden rijen in een Bootstrap-rasterlayout met miniaturen afgebeeld"

msgid "Previous"
msgstr "Vorige"

msgid "Next"
msgstr "Volgende"

