msgid "Finished @num elements and @num_translations translations created successfully."
msgstr "Ukończono elementy w liczbie @num i utworzono tłumaczenia w liczbie @num_translations."

msgid "Finished @num elements created successfully."
msgstr "Pomyślnie zakończono tworzenie następującej liczby elementów: @num."

msgid "Finished with an error."
msgstr "Zakończono z błędem."

msgid "Generate @label"
msgstr "Generuj element @label"

msgid "Generate"
msgstr "Generuj"

msgid "Generate realistic items (content, users, menus, etc) to assist your site development and testing."
msgstr "Wygeneruj realistyczne elementy (treść, użytkownicy, menu itp.), aby wspomóc proces tworzenia i testowania serwisu."

msgid "Devel generate"
msgstr "Devel Generate"

msgid "Devel Generate"
msgstr "Generowanie elementu Devel"

msgid "Generate test users, nodes, menus, taxonomy terms..."
msgstr "Generuj użytkowników testowych, węzły, menu, terminy systematyki..."

msgid "Development"
msgstr "Tworzenie"

msgid "Administer devel_generate"
msgstr "Administrowanie modułem devel_generate"

msgid "Language"
msgstr "Język"

msgid "Select the primary language(s) for @items"
msgstr "Wybierz języki podstawowe dla elementów @items"

msgid "Disabled - requires Language module"
msgstr "Wyłączone - wymaga modułu Language"

msgid "Select the language(s) for translated @items"
msgstr "Wybierz języki dla przetłumaczonych elementów @items"

msgid "Translated @items will be created for each language selected."
msgstr "Przetłumaczone elementy @items zostaną utworzone w każdym wybranym języku."

msgid "Disabled - requires Content Translation module."
msgstr "Wyłączone - wymaga modułu Content Translation."

msgid "@permission"
msgstr "@permission"

msgid "Failed to generate elements due to \"%error\"."
msgstr "Nie powiodło się generowanie elementów ze względu na błąd „%error”."

msgid "You do not have any content types that can be generated. <a href=\":create-type\">Go create a new content type</a>"
msgstr "Nie masz żadnych typów treści, które mogą zostać wygenerowane. <a href=\":create-type\">Utwórz nowy typ treści.</a>"

msgid "Hidden"
msgstr "Ukryte"

msgid "Closed"
msgstr "Zamknięte"

msgid "Open"
msgstr "Otwarty"

msgid "No comment fields"
msgstr "Brak pól komentarza"

msgid "Content type"
msgstr "Typ zawartości"

msgid "Comments"
msgstr "Komentarze"

msgid "<strong>Delete all content</strong> in these content types before generating new content."
msgstr "Przed wygenerowaniem nowej treści <strong>usuń całą treść</strong> w tych typach treści."

msgid "How many nodes would you like to generate?"
msgstr "Ile węzłów wygenerować?"

msgid "Now"
msgstr "Teraz"

msgid "ago"
msgstr "temu"

msgid "How far back in time should the nodes be dated?"
msgstr "Jaki przedział czasu powinno obejmować datowanie węzłów?"

msgid "Node creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "Zostaną losowo przypisane daty utworzenia węzłów z przedziału od bieżącej daty do wybranej daty w przeszłości."

msgid "Maximum number of comments per node."
msgstr "Maksymalna liczba komentarzy na węzeł."

msgid "You must also enable comments for the content types you are generating. Note that some nodes will randomly receive zero comments. Some will receive the max."
msgstr "Musisz również włączyć komentarze dla generowanych typów treści. Pamiętaj o tym, że niektóre węzły nie otrzymają losowo żadnych komentarzy. Inne węzły mogą otrzymać maksymalną liczbę komentarzy."

msgid "Maximum number of words in titles"
msgstr "Maksymalna liczba słów w tytułach"

msgid "Fields to leave empty"
msgstr "Pola, które mają pozostać puste"

msgid "Enter the field names as a comma-separated list. These will be skipped and have a default value in the generated content."
msgstr "Wprowadź nazwy pól w postaci listy elementów rozdzielanych przecinkami. Te elementy zostaną pominięte i będą miały wartość domyślną w wygenerowanej treści."

msgid "Base fields to populate"
msgstr "Pola podstawowe do zapełnienia"

msgid "Enter the field names as a comma-separated list. These will be populated."
msgstr "Wprowadź nazwy pól w postaci listy elementów rozdzielanych przecinkami. Zostaną one zapełnione."

msgid "Prefix the title with the content type label."
msgstr "Poprzedzaj tytuł etykietą typu treści."

msgid "This will not count against the maximum number of title words specified above."
msgstr "Nie będzie się ona wliczać do maksymalnej liczby słów tytułu określonej powyżej."

msgid "Requires path.module"
msgstr "Wymaga modułu path.module"

msgid "Add an url alias for each node."
msgstr "Dodaj alias adresu URL dla każdego węzła."

msgid "Add statistics for each node (node_counter table)."
msgstr "Dodaj statystykę dla każdego węzła (tabela node_counter)."

msgid "User ID"
msgstr "ID użytkownika"

msgid "Name"
msgstr "Nazwa"

msgid "Role(s)"
msgstr "Role"

msgid "Users"
msgstr "Użytkownicy"

msgid "Select users for randomly assigning as authors of the generated content. Leave all unchecked to use a random selection of up to 50 users."
msgstr "Wybierz użytkowników do losowego przypisywania jako autorów wygenerowanej treści. Pozostaw wszystkie pola niezaznaczone, aby użyć losowego wyboru spośród maksymalnie 50 użytkowników."

msgid "Please select at least one content type"
msgstr "Wybierz co najmniej jeden typ treści"

msgid "Generating Content"
msgstr "Generowanie treści"

msgid "Deleted %count nodes."
msgstr "Usunięte następującą liczbę węzłów: %count."

msgid "Completed @feedback nodes (@rate nodes/min)"
msgstr "Ukończone węzły: @feedback (@rate węzł./min)"

msgid "No content types available"
msgstr "Brak dostępnych typów treści."

msgid "To delete content, please provide the content types (--bundles)"
msgstr "Aby usunąć treść, podaj typy treści (--bundles)"

msgid "One or more content types have been entered that don't exist on this site"
msgstr "Wprowadzono co najmniej jeden typ treści, który nie istnieje w tym serwisie."

msgid "Created 1 node"
msgid_plural "Created @count nodes"
msgstr[0] "Utworzono 1 węzeł"
msgstr[1] "Utworzono węzły w liczbie @count"
msgstr[2] "Utworzono węzły w liczbie @count"

msgid "Created 1 node translation"
msgid_plural "Created @count node translations"
msgstr[0] "Utworzono 1 tłumaczenie węzła"
msgstr[1] "Utworzono tłumaczenia węzłów w liczbie @count"
msgstr[2] "Utworzono tłumaczenia węzłów w liczbie @count"

msgid "content"
msgstr "zawartość"

msgid "Generate a given number of content. Optionally delete current content."
msgstr "Wygeneruj podaną liczbę elementów treści. Opcjonalnie usuń istniejącą treść."

msgid "You do not have any media types that can be generated. <a href=\":url\">Go create a new media type</a>"
msgstr "Nie masz żadnych typów danych multimedialnych, które mogą zostać wygenerowane. <a href=\":url\">Utwórz nowy typ danych multimedialnych.</a>"

msgid "Media type"
msgstr "Typ multimediów"

msgid "<strong>Delete all media</strong> in these types before generating new media."
msgstr "<strong>Usuń wszystkie multimedia</strong> w tych typach przed wygenerowaniem nowych elementów multimedialnych."

msgid "How many media items would you like to generate?"
msgstr "Ile elementów multimedialnych chcesz wygenerować?"

msgid "How far back in time should the media be dated?"
msgstr "Jaki przedział czasu powinno obejmować datowanie elementów multimedialnych?"

msgid "Media creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "Zostaną losowo przypisane daty utworzenia elementów multimedialnych z przedziału od bieżącej daty do wybranej daty w przeszłości."

msgid "Maximum number of words in names"
msgstr "Maksymalna liczba słów w nazwach"

msgid "Set language on media"
msgstr "Ustaw język w danych multimedialnych"

msgid "Requires locale.module"
msgstr "Wymaga modułu locale.module"

msgid "Please select at least one media type"
msgstr "Wybierz co najmniej jeden typ danych multimedialnych"

msgid "Generating media items"
msgstr "Generowanie elementów multimedialnych"

msgid "Deleted %count media items."
msgstr "Usunięto następującą liczbę elementów multimediów: %count."

msgid "Completed !feedback media items (!rate media/min)"
msgstr "Ukończono elementów multimedialnych: !feedback (!rate elementów/min)"

msgid "No media types available"
msgstr "Brak dostępnych typów danych multimedialnych"

msgid "1 media item created."
msgid_plural "Finished creating @count media items."
msgstr[0] "Utworzono 1 element multimedialny."
msgstr[1] "Zakończono tworzenie @count elementów multimedialnych."
msgstr[2] "Zakończono tworzenie @count elementów multimedialnych."

msgid "media"
msgstr "multimedia"

msgid "Generate a given number of media entities."
msgstr "Wygeneruj podaną liczbę jednostek multimedialnych."

msgid "Create new menu(s)"
msgstr "Utwórz nowe menu"

msgid "Generate links for these menus"
msgstr "Generuj odsyłacze dla tych menu"

msgid "Number of new menus to create"
msgstr "Liczba nowych menu do utworzenia"

msgid "Number of links to generate"
msgstr "Liczba odsyłaczy do wygenerowania"

msgid "Maximum length for menu titles and menu links"
msgstr "Maksymalna długość tytułów menu i odsyłaczy menu"

msgid "Text will be generated at random lengths up to this value. Enter a number between 2 and 128."
msgstr "Zostanie wygenerowany tekst o losowych długościach nieprzekraczających tej wartości. Określ liczbę z zakresu od 2 do 128."

msgid "Types of links to generate"
msgstr "Typy odsyłaczy do wygenerowania"

msgid "Nodes"
msgstr "Węzły"

msgid "Front page"
msgstr "Strona tytułowa"

msgid "External"
msgstr "Zewnętrzny"

msgid "Maximum link depth"
msgstr "Maksymalna głębokość odsyłacza"

msgid "Maximum menu width"
msgstr "Maksymalna szerokość menu"

msgid "Limit the width of the generated menu's first level of links to a certain number of items."
msgstr "Ogranicz szerokość pierwszego poziomu odsyłaczy generowanego menu do podanej liczby pozycji."

msgid "Delete existing custom generated menus and menu links before generating new ones."
msgstr "Usuń istniejące wygenerowane niestandardowe menu i odsyłacze menu, zanim wygenerujesz nowe."

msgid "Deleted @menus_deleted menu(s) and @links_deleted other link(s)."
msgstr "Usunięto @menus_deleted menu i pozostałe odsyłacze w liczbie @links_deleted."

msgid "Description of @name"
msgstr "Opis elementu @name"

msgid "Description of @title."
msgstr "Opis elementu @title."

msgid "Invalid number of menus"
msgstr "Niepoprawna liczba menu."

msgid "Invalid number of links"
msgstr "Niepoprawna liczba odsyłaczy."

msgid "Invalid maximum link depth. Use a value between 1 and 9"
msgstr "Niepoprawna maksymalna głębokość odsyłacza. Wprowadź wartość z zakresu od 1 do 9."

msgid "Invalid maximum menu width. Use a positive numeric value."
msgstr "Niepoprawna maksymalna szerokość menu. Wprowadź dodatnią wartość liczbową."

msgid "Created the following 1 new menu: @menus"
msgid_plural "Created the following @count new menus: @menus"
msgstr[0] "Utworzono następujące 1 nowe menu: @menus"
msgstr[1] "Utworzono następujące nowe menu w liczbie @count: @menus"
msgstr[2] "Utworzono następujące nowe menu w liczbie @count: @menus"

msgid "Created 1 new menu link."
msgid_plural "Created @count new menu links."
msgstr[0] "Utworzono 1 nowy odsyłacz menu."
msgstr[1] "Utworzono następującą liczbę odsyłaczy menu: @count."
msgstr[2] "Utworzono następującą liczbę odsyłaczy menu: @count."

msgid "menus"
msgstr "menu"

msgid "Generate a given number of menus and menu links. Optionally delete current menus."
msgstr "Wygeneruj podaną liczbę menu i odsyłaczy menu. Opcjonalnie usuń istniejące menu."

msgid "Vocabularies"
msgstr "Słowniki"

msgid "Restrict terms to these vocabularies."
msgstr "Ogranicz terminy do tych słowników."

msgid "Number of terms"
msgstr "Podaj liczbę terminów"

msgid "Maximum number of characters in term names"
msgstr "Maksymalna liczba znaków w nazwach terminów"

msgid "Minimum depth for new terms in the vocabulary hierarchy"
msgstr "Minimalna głębokość dla nowych terminów w hierarchii słownika"

msgid "Enter a value from 1 to 20."
msgstr "Wprowadź wartość z zakresu od 1 do 20."

msgid "Maximum depth for new terms in the vocabulary hierarchy"
msgstr "Maksymalna głębokość dla nowych terminów w hierarchii słownika"

msgid "Delete existing terms in specified vocabularies before generating new terms."
msgstr "Przed wygenerowaniem nowych terminów usuń istniejące terminy z podanych słowników."

msgid "In vocabulary @vlabel: @termlist"
msgstr "W słowniku @vlabel: @termlist"

msgid "In vocabulary @vlabel: No terms created"
msgstr "W słowniku @vlabel: Nie utworzono żadnych terminów"

msgid "Minimum depth changed from @min_depth to 1 because all terms were deleted"
msgstr "Minimalna głębokość została zmieniona z wartości @min_depth na wartość 1, ponieważ wszystkie terminy zostały usunięte"

msgid "Please provide a vocabulary machine name (--bundles)."
msgstr "Podaj nazwę słownika w formie zapisu maszynowego (--bundles)"

msgid "Invalid vocabulary machine name: @name"
msgstr "Niepoprawna nazwa słownika w formie zapisu maszynowego: @name."

msgid "Invalid number of terms: @num"
msgstr "Niepoprawna liczba terminów: @num."

msgid "The depth values must be in the range 1 to 20 and min-depth cannot be larger than max-depth (values given: min-depth @min, max-depth @max)"
msgstr "Wartości głębokości muszą należeć do zakresu od 1 do 20, a minimalna głębokość nie może być większa niż maksymalna głębokość (podane wartości: minimalna @min, maksymalna @max)"

msgid "Created 1 new term"
msgid_plural "Created @count new terms"
msgstr[0] "Utworzono 1 nowy termin"
msgstr[1] "Utworzono nowe terminy w liczbie: @count"
msgstr[2] "Utworzono nowe terminy w liczbie: @count"

msgid "1 new term at level @level (@terms)"
msgid_plural "@count new terms at level @level (@terms)"
msgstr[0] "1 nowy termin na poziomie @level (@terms)"
msgstr[1] "Nowe terminy w liczbie @count na poziomie @level (@terms)"
msgstr[2] "Nowe terminy w liczbie @count na poziomie @level (@terms)"

msgid "Created 1 term translation"
msgid_plural "Created @count term translations"
msgstr[0] "Utworzono 1 tłumaczenie jednego terminu"
msgstr[1] "Utworzono tłumaczenia terminów w liczbie @count"
msgstr[2] "Utworzono tłumaczenia terminów w liczbie @count"

msgid "Deleted 1 existing term"
msgid_plural "Deleted @count existing terms"
msgstr[0] "Usunięto 1 istniejący termin"
msgstr[1] "Usunięto istniejące terminy w liczbie @count"
msgstr[2] "Usunięto istniejące terminy w liczbie @count"

msgid "terms"
msgstr "składniki"

msgid "Generate a given number of terms. Optionally delete current terms."
msgstr "Wygeneruj podaną liczbę terminów. Opcjonalnie usuń istniejące terminy."

msgid "How many users would you like to generate?"
msgstr "Ile kont użytkowników wygenerować?"

msgid "Delete all users (except user id 1) before generating new users."
msgstr "Przed wygenerowaniem nowych kont użytkowników usuń wszystkie konta użytkowników (z wyjątkiem konta użytkownika o identyfikatorze 1)."

msgid "Which roles should the users receive?"
msgstr "Które role mają otrzymać użytkownicy?"

msgid "Users always receive the <em>authenticated user</em> role."
msgstr "Użytkownicy zawsze otrzymują rolę <em>Użytkownik uwierzytelniony</em>."

msgid "Password to be set"
msgstr "Hasło do ustawienia"

msgid "Leave this field empty if you do not need to set a password"
msgstr "Pozostaw to pole puste, jeśli nie musisz ustawiać hasła."

msgid "How old should user accounts be?"
msgstr "Jaki wiek przypisać do kont użytkowników?"

msgid "User ages will be distributed randomly from the current time, back to the selected time."
msgstr "Wiek użytkowników zostanie przypisany losowo przy użyciu dat z przedziału od bieżącej daty do wybranej daty w przeszłości."

msgid "@num_users created."
msgstr "Utworzono następującą liczbę kont użytkowników: @num_users."

msgid "1 user deleted"
msgid_plural "@count users deleted."
msgstr[0] "Usunięto 1 konto użytkownika."
msgstr[1] "Usunięto następującą liczbę kont użytkowników: @count."
msgstr[2] "Usunięto następującą liczbę kont użytkowników: @count."

msgid "1 user"
msgid_plural "@count users"
msgstr[0] "1 użytkownik"
msgstr[1] "@count użytkowników"
msgstr[2] "@count użytkowników"

msgid "users"
msgstr "użytkownicy"

msgid "Generate a given number of users. Optionally delete current users."
msgstr "Wygeneruj podaną liczbę kont użytkowników. Opcjonalnie usuń istniejące konta użytkowników."

msgid "Number of vocabularies?"
msgstr "Podaj liczbę słowników."

msgid "Maximum number of characters in vocabulary names"
msgstr "Maksymalna liczba znaków w nazwach słowników"

msgid "Delete existing vocabularies before generating new ones."
msgstr "Przed wygenerowaniem nowych słowników usuń istniejące słowniki."

msgid "Deleted existing vocabularies."
msgstr "Usunięto istniejące słowniki."

msgid "Created the following new vocabularies: @vocs"
msgstr "Utworzono następujące nowe słowniki: @vocs."

msgid "Invalid number of vocabularies: @num."
msgstr "Niepoprawna liczba słowników: @num."

msgid "vocabularies"
msgstr "słowniki"

msgid "Generate a given number of vocabularies. Optionally delete current vocabularies."
msgstr "Wygeneruj podaną liczbę słowników. Opcjonalnie usuń istniejące słowniki."

