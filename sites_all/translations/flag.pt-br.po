msgstr "A entidade sinalizada."

msgid "A boolean indicating whether the flagging is global."
msgstr "Um booleano que indica se a sinalização é global."

msgid "User ID"
msgstr "ID do Usuário"

msgid "The user ID of the flagging user. This is recorded for both global and personal flags."
msgstr "O ID do usuário do usuário de sinalização. Isso é registrado para sinalizações globais e pessoais."

msgid "Session ID"
msgstr "ID da Sessão"

msgid "The session ID associated with an anonymous user."
msgstr "O ID de sessão associado a um usuário anônimo."

