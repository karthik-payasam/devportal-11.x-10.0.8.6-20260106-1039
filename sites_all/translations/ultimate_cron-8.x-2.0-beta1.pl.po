msgstr "anonimowe"

msgid "by"
msgstr "dodany przez"

msgid "Registered at @datetime"
msgstr "Zarejestrowano: @datetime"

msgid "no info"
msgstr "brak informacji"

msgid "-- Any -- "
msgstr "-- Dowolny -- "

msgid "-- Fixed -- "
msgstr "-- Stały -- "

msgid "Which thread to run in when invoking with ?thread=N. Note: This setting only has an effect when cron is run through cron.php with an argument ?thread=N or through Drush with --options=thread=N."
msgstr "Wątek, który ma zostać uruchomiony w przypadku wywołania przy użyciu argumentu ?thread=N. Uwaga: To ustawienie ma zastosowanie tylko wtedy, gdy zadanie cron jest uruchamiane za pośrednictwem pliku cron.php z argumentem ?thread=N lub za pośrednictwem narzędzia Drush z argumentem --options=thread=N."

msgid "%title must be greater than 0"
msgstr "Wartość %title musi być większa niż 0."

msgid "Launched in thread @current_thread"
msgstr "Uruchomiono w wątku @current_thread."

msgid "Invalid thread available for starting launch thread"
msgstr "Niepoprawny wątek dostępny na potrzeby rozpoczynania wątku uruchamiania."

msgid "Thread @thread is already running"
msgstr "Wątek @thread jest już uruchomiony."

msgid "No free threads available for launching jobs"
msgstr "Brak wolnych wątków do uruchamiania zadań."

msgid "Serial"
msgstr "Numer seryjny"

msgid "Launches scheduled jobs in the same thread and runs them consecutively."
msgstr "Uruchamia zaplanowane zadania w tym samym wątku i uruchamia je po kolei."

msgid "Stores the last log entry (and only the last) in the cache."
msgstr "Zapisuje ostatnią pozycję dziennika (i tylko ostatnią) w pamięci podręcznej."

msgid "Lock #@original_lid was already closed and logged. Creating a new log entry #@lid"
msgstr "Blokada #@original_lid została już zamknięta i zarejestrowana. Tworzenie nowej pozycji dziennika #@lid."

msgid "@count_entries log entries removed for @jobs_count jobs"
msgstr "Usunięto @count_entries poz. dziennika w przypadku @jobs_count zadań."

msgid "Invalid cleanup method: @method"
msgstr "Niepoprawna metoda czyszczenia: @method"

msgid "Stores logs in the database."
msgstr "Zapisuje dzienniki w bazie danych."

msgid "Next scheduled run at @datetime"
msgstr "Następne zaplanowane uruchomienie: @datetime"

msgid "Comma separated list of crontab rules."
msgstr "Rozdzielana przecinkami lista reguł tabeli crontab. "

msgid "Rule is invalid"
msgstr "Reguła jest niepoprawna "

msgid "Use crontab rules for scheduling jobs."
msgstr "Użyj reguł tabeli crontab do planowania zadań. "

msgid "Every @interval"
msgstr "Co @interval"

msgid "Provides a set of predefined intervals for scheduling."
msgstr "Udostępnia zestaw predefiniowanych odstępów czasu na potrzeby planowania. "

