msgid "Ultimate Cron Monitoring"
msgstr "Monitorowanie rozszerzenia Ultimate Cron"

msgid "Thresholds"
msgstr "Progi"

msgid "Thresholds for reporting critical alerts to Nagios."
msgstr "Progi na potrzeby raportowania alertów krytycznych do programu Nagios."

msgid "Running jobs count"
msgstr "Liczba uruchomionych zadań"

msgid "Issue a critical alert when more than this number of jobs are running. Default is 50."
msgstr "Wyślij alert krytyczny, jeśli liczba uruchomionych zadań przekracza tę wartość. Wartością domyślną jest 50."

msgid "Failed jobs count"
msgstr "Liczba zadań zakończonych niepowodzeniem"

msgid "Issue a critical alert when more than this number of jobs failed their last run. Default is 10."
msgstr "Wyślij alert krytyczny, jeśli liczba zadań, których ostatnie uruchomienie zakończyło się niepowodzeniem, przekracza tę wartość. Wartością domyślną jest 10. "

msgid "Long running jobs"
msgstr "Zadania długotrwałe"

msgid "Issue a critical alert when more than this number of jobs are running longer than usual. Default is 0."
msgstr "Wyślij alert krytyczny, jeśli liczba zadań wykonywanych dłużej niż zwykle, przekracza tę wartość. Wartością domyślną jest 0."

msgid "Check number of currently running jobs"
msgstr "Sprawdź liczbę obecnie uruchomionych zadań"

msgid "Check the number of jobs that failed last run"
msgstr "Sprawdź liczbę zadań, których ostatnie uruchomienie zakończyło się niepowodzeniem"

msgid "Check the number of jobs that are running longer than usual"
msgstr "Sprawdź liczbę zadań, które są wykonywane dłużej niż zwykle"

msgid "@jobs currently running - it is more than @threshold"
msgstr "Liczba aktualnie uruchomionych zadań (@jobs) przekracza próg @threshold."

msgid "@jobs currently running"
msgstr "Liczba aktualnie uruchomionych zadań: @jobs"

msgid "@jobs failed their last run - it is more than @threshold"
msgstr "Liczba zadań, których ostatnie uruchomienie zakończyło się niepowodzeniem (@jobs), przekracza próg @threshold."

msgid "@jobs failed their last run"
msgstr "Liczba zadań, których ostatnie uruchomienie zakończyło się niepowodzeniem: @jobs"

msgid "@jobs jobs are running longer than usual - it is more than @threshold"
msgstr "Liczba zadań, które są wykonywane dłużej niż zwykle (@jobs), przekracza próg @threshold."

msgid "@jobs jobs are running longer than usual"
msgstr "Liczba zadań, które są wykonywane dłużej niż zwykle: @jobs"

msgid "Never"
msgstr "Nigdy"

msgid "Some jobs are behind their schedule. Please check if <a href=\":system_cron_url\">Cron</a> is running properly."
msgstr "Niektóre zadania są opóźnione względem harmonogramu. Należy sprawdzić, czy program <a href=\":system_cron_url\">Cron</a> działa poprawnie."

msgid "Cron is running properly."
msgstr "Program Cron działa poprawnie."

msgid "@count job is behind schedule"
msgid_plural "@count jobs are behind schedule"
msgstr[0] "@count zadanie jest opóźnione względem harmonogramu"
msgstr[1] "Istnieje następująca liczba zadań opóźnionych względem harmonogramu: @count"

