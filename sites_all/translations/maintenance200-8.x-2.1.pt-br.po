msgid ""
"\n"
"        <h2>Maintenance200 module.</h2>\n"
"        <h3>Instructions</h3>\n"
"        <p>Install the module as normal and enable in <strong>/admin/modules</strong>.</p>\n"
"        <p>On the module configuration form you will find a switch to turn on or off the rewriting of the HTTP code returned when the site is in maintenance mode, as well as a field where you\n"
"        can input the numeric HTTP which the site should return.</p>\n"
"      "
msgstr ""
"\n"
"        <h2>Módulo Maintenance200.</h2>\n"
"        <h3>Instruções</h3> <p>Instale o módulo normalmente e ative em <strong>/admin/modules</strong>.</p>\n"
"        <p>No formulário de configuração de módulo, você encontrará um comutador para ativar ou desativar a regravação do código de HTTP retornado quando o site está no modo de manutenção, além de um campo no qual é possível inserir o HTTP numérico que o site deve retornar.</p>\n"
"      "

msgid "Maintenance 200"
msgstr "Maintenance 200"

msgid "Allows the maintenance page to return a configurable HTTP status code rather than the standard 503 code."
msgstr "Permite que a página de manutenção retorne um código de status de HTTP configurável em vez do código padrão 503."

msgid "Configure maintenance200"
msgstr "Configurar maintenance200"

msgid "Maintenance200 Settings"
msgstr "Configurações de Maintenance200"

msgid "Maintenance 200 settings"
msgstr "Configurações de Maintenance 200"

msgid "Enable custom status code during maintenance mode"
msgstr "Ativar código de status customizado durante o modo de manutenção"

msgid "Status code to return during maintenance mode"
msgstr "Código de status a ser retornado durante o modo de manutenção"

msgid "Change the status code during maintenance mode"
msgstr "Mudar o código de status durante o modo de manutenção"

msgid "Status code to use"
msgstr "Código de status a ser usado"

msgid "A valid HTTP status code is required. See the Wikipedia <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">HTTP status codes</a> page for a complete list."
msgstr "É necessário um código de status de HTTP válido. Consulte a página da Wikipédia <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">Códigos de status de HTTP</a> para obter uma lista completa."

msgid "A valid HTTP status code is required."
msgstr "É necessário um código de status de HTTP válido."

msgid "You must provide an HTTP status code."
msgstr "Deve ser fornecido um código de status de HTTP."

