msgid "Allowlist skipping ban: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Verbod op overslaan instellen: %ip voor mislukken van %type op %formulier <br />Bron: %bron <br /> Gebruikersagent: %browser"

msgid "Banned: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Verboden: %ip voor mislukt %type op %form <br />Bron: %source <br /> Gebruikersagent: %browser"

msgid "Drupal Perimeter Defence"
msgstr "Drupal Perimeter Defence"

msgid "Immediately ban hackers when they try to scan the site."
msgstr "Hackers onmiddellijk buitensluiten als ze proberen de site te scannen."

msgid "Perimeter defence settings"
msgstr "Instellingen voor bewaking van de perimeter"

msgid "Configure the settings for Drupal Perimeter Defence."
msgstr "Instellingen configureren voor Drupal Perimeter Defence."

msgid "Bypass Perimeter Defence ban rules"
msgstr "Perimeter Defence-verbodsregels omzeilen"

msgid "Allow users to bypass the rules defined by Perimeter Defence module."
msgstr "Gebruikers toestaan om de regels te omzeilen die zijn gedefinieerd door de Perimeter Defence-module."

msgid "Perimeter settings"
msgstr "Perimeterinstellingen"

msgid "Perimeter Settings"
msgstr "Perimeterinstellingen"

msgid "A list of regex patterns"
msgstr "Een lijst van regex-patronen"

msgid "A regex pattern"
msgstr "Een regex-patroon"

msgid "Banned: %ip for requesting %pattern <br />Source: %source <br /> User Agent: %browser"
msgstr "Verboden: %ip voor het aanvragen van %pattern <br />Bron: %source<br />-gebruikersagent: %browser"

msgid "Perimeter will ban any user that generates \"404 - File not found\" for requesting any of the following url pattern"
msgstr "Met een perimeter wordt elke gebruiker buitengesloten die \"404-Bestand niet gevonden\" genereert voor het aanvragen van een van de volgende URL-patronen"

msgid "Ban URL patterns"
msgstr "URL-patronen verbieden"

msgid "A list of regex patterns, each pattern on a separate line"
msgstr "Een lijst van regex-patronen, elk patroon op een aparte regel"

