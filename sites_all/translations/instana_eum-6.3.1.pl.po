msgid "Instana EUM"
msgstr "Instana EUM"

msgid "Configures Instana End User Monitoring (EUM) beacon module."
msgstr "Konfiguruje moduł sygnalizatora Instana EUM (End User Monitoring)."

msgid "Monitoring"
msgstr "Monitorowanie"

msgid "Instana EUM Configuration"
msgstr "Konfiguracja Instana EUM"

msgid "Setup Instana EUM connection parameters."
msgstr "Skonfiguruj parametry połączenia z Instana EUM."

msgid "Configure the Instana EUM module"
msgstr "Konfiguracja modułu Instana EUM"

msgid "Setup the parameters to connect Drupal to Instana."
msgstr "Skonfiguruj parametry, aby połączyć produkt Drupal z Instana."

msgid "Instana EUM Settings"
msgstr "Ustawienia Instana EUM"

msgid "The API Key for the Instana server"
msgstr "Klucz API dla serwera Instana"

msgid "The reporting URL of the Instana server"
msgstr "Adres URL raportowania na serwerze Instana"

msgid "Allow Instana to monitor page views, load times and JS errors for individual pages"
msgstr "Zezwól Instana na monitorowanie widoków stron, czasów ładowania i błędów JS dla poszczególnych stron"

msgid "Enable monitoring of admin pages."
msgstr "Włącz monitorowanie stron administracyjnych."

msgid "Advanced settings for the Instana server configuration"
msgstr "Zaawansowane ustawienia konfiguracji serwera Instana"

msgid "Configures Instana End User Monitoring (EUM) beacon module. Please see the <a href=\"https://www.instana.com/docs/website_monitoring/\" target=\"_blank\">official documentation</a> for further details."
msgstr "Konfiguruje moduł sygnalizatora Instana EUM (End User Monitoring). Więcej informacji na ten temat zawiera <a href=\"https://www.instana.com/docs/website_monitoring/\" target=\"_blank\">oficjalna dokumentacja</a>."

msgid "API Key"
msgstr "Klucz interfejsu API"

msgid "Enter the API key for your Instana server."
msgstr "Wprowadź klucz API dla serwera Instana."

msgid "Reporting URL"
msgstr "Adres URL raportowania"

msgid "Enter the Instana server reporting URL."
msgstr "Wprowadź adres URL raportowania serwera Instana."

msgid "Track individual pages"
msgstr "Śledzenie poszczególnych stron"

msgid "Isolate specific pages and analyze their performance to find pages with the most traffic, or the slowest response times."
msgstr "Wyizoluj konkretne strony i przeanalizuj ich wydajność w celu znalezienia stron o największym ruchu danych lub najdłuższych czasach odpowiedzi."

msgid "Admin page tracking"
msgstr "Śledzenie strony administratora"

msgid "Include monitoring of pages with /admin in the url."
msgstr "Uwzględnij monitorowanie stron z /admin w adresie URL."

msgid "You can use this to set additional EUM settings."
msgstr "Tego ustawienia można użyć do określenia dodatkowych ustawień EUM."

msgid "See documentation here"
msgstr "Zapoznaj się z dokumentacją tutaj"

msgid "Examples:"
msgstr "Przykłady:"

msgid "Advanced Settings"
msgstr "Ustawienia zaawansowane"

