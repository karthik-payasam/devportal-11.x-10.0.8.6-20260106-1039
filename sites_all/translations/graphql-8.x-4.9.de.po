msgid "About"
msgstr "Über"

msgid ""
"\n"
"<p>This module generates and exposes a\n"
"  <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a> schema for\n"
"  <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a> entities,\n"
"  and allows you to expose your own custom schema in a consistent way and with\n"
"  minimal effort.</p>"
msgstr ""
"\n"
"<p>Dieses Modul generiert ein\n"
"  <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a>-Schema für\n"
"  <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a>-Entitäten, stellt es bereit\n"
" und ermöglicht es Ihnen, Ihr eigenes angepasstes Schema auf konsistente Weise und mit\n"
"  einem Minimum an Aufwand bereitzustellen.</p>"

