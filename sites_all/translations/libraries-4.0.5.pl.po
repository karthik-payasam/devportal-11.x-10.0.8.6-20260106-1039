msgid "Lists registered library information."
msgstr "Wyświetla informacje o zarejestrowanych bibliotekach."

msgid ""
"Downloads a registered library into the libraries directory for the active site.\n"
"\n"
"See libraries-list for a list of registered libraries."
msgstr ""
"Pobiera zarejestrowaną bibliotekę do katalogu bibliotek aktywnego serwisu.\n"
" \n"
"Aby wyświetlić listę zarejestrowanych bibliotek, użyj komendy libraries-list."

msgid "Name"
msgstr "Nazwa"

msgid "Status"
msgstr "Status"

msgid "Version"
msgstr "Wersja"

msgid "Variants"
msgstr "Warianty"

msgid "Dependencies"
msgstr "Zależności"

msgid "OK"
msgstr "OK"

msgid "Missing dependency: unzip. Install it before using this command."
msgstr "Niespełniona zależność: unzip. Przed wykonaniem tej komendy zainstaluj ten moduł."

msgid "Directory @path was created"
msgstr "Katalog @path został utworzony."

msgid "A existing Colorbox plugin was overwritten at @path"
msgstr "Istniejąca wtyczka Colorbox została nadpisana w katalogu @path."

msgid "Colorbox plugin has been downloaded to @path"
msgstr "Wtyczka Colorbox została pobrana do katalogu @path."

msgid "Drush was unable to download the Colorbox plugin to @path"
msgstr "Moduł Drush nie mógł pobrać wtyczki Colorbox do katalogu @path."

msgid "The %dependency library, which the %library library depends on, is not installed."
msgstr "Biblioteka %dependency, od której zależy biblioteka %library, nie jest zainstalowana."

msgid "The version %dependency_version of the %dependency library is not compatible with the %library library."
msgstr "Wersja %dependency_version biblioteki %dependency nie jest kompatybilna z biblioteką %library."

msgid "The %library library could not be found."
msgstr "Bibloteka %library nie została znaleziona."

msgid "The version of the %library library could not be detected."
msgstr "Wersja biblioteki %library nie została wykryta."

msgid "The installed version %version of the %library library is not supported."
msgstr "Zainstalowana wersja %version biblioteki %library nie jest wspierana."

msgid "The %variant variant of the %library library could not be found."
msgstr "Wariant %variant biblioteki %library nie został znaleziony."

msgid "The following external libraries could not successfully be registered with Drupal core: @libs. See earlier log entries for more details. Once these issues are addressed please be sure to clear your Drupal library cache to ensure external library detection is run again."
msgstr "Następujące zewnętrzne biblioteki nie mogły zostać pomyślnie zarejestrowane w podstawowym module Drupal: @libs. Więcej szczegółowych informacji można znaleźć we wcześniejszych pozycjach dziennika. Po rozwiązaniu tych problemów należy wyczyścić pamięć podręczną bibliotek systemu Drupal, aby upewnić się, że zostanie ponownie uruchomione wykrywanie bibliotek zewnętrznych."

msgid "Libraries"
msgstr "Biblioteki"

msgid "Allows version-dependent and shared usage of external libraries."
msgstr "Umożliwia zależne od wersji i wspólne korzystanie z zewnętrznych bibliotek."

msgid "Libraries API settings"
msgstr "Ustawienia interfejsu API bibliotek"

msgid "Library definition settings"
msgstr "Ustawienia definicji biblioteki"

msgid "Local"
msgstr "Lokalnie"

msgid "Local path"
msgstr "Ścieżka lokalna"

msgid "Enable remote fetching of library definitions"
msgstr "Włącz zdalne pobieranie definicji bibliotek"

msgid "A list of remote library registry URLs"
msgstr "Lista adresów URL zdalnych rejestrów bibliotek"

msgid "The URL of a remote library registry"
msgstr "Adres URL zdalnego rejestru bibliotek"

msgid "URI locator configuration"
msgstr "Konfiguracja wskaźnika identyfikatorów URI"

msgid "The locator URI"
msgstr "Identyfikator URI wskaźnika"

msgid "Assets"
msgstr "Zasoby"

msgid "Provides access to asset library files."
msgstr "Zapewnia dostęp do plików bibliotek zasobów."

msgid "Library definitions"
msgstr "Definicje bibliotek"

msgid "Provides access to library definition files."
msgstr "Zapewnia dostęp do plików definicji bibliotek."

msgid "PHP library files"
msgstr "Pliki bibliotek PHP"

msgid "Provides access to PHP library files."
msgstr "Zapewnia dostęp do plików bibliotek PHP."

