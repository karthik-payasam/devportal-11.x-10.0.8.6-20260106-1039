msgid "You are about to delete a vote by %user on @entity-type %label. This action cannot be undone."
msgstr "Za chwilę zostanie usunięty głos użytkownika %user dotyczący jednostki @entity-type %label. Tego działania nie można cofnąć."

msgid "%type is used by 1 piece of content on your site. You can not remove this vote type until you have removed that vote."
msgid_plural "%type is used by @count pieces of content on your site. You may not remove %type until you have removed all of the %type votes."
msgstr[0] "Typ %type jest używany przez 1 element treści w serwisie. Nie można usunąć tego typu głosu, dopóki nie zostanie usunięty ten głos."
msgstr[1] "Typ %type jest używany przez następującą liczbę elementów w serwisie: @count. Nie można usunąć typu %type, dopóki nie zostaną usunięte wszystkie głosy typu %type."
msgstr[2] "Typ %type jest używany przez następującą liczbę elementów w serwisie: @count. Nie można usunąć typu %type, dopóki nie zostaną usunięte wszystkie głosy typu %type."

