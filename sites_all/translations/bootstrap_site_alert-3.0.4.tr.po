msgid "Bootstrap Site Alert"
msgstr "Önyükleme Site Uyarısı"

msgid "This module is for rendering alerts site wide using the power of Bootstrap"
msgstr "Bu modül, Önyükleme gücünü kullanarak site genelinde uyarıların görüntüsünü oluşturmak içindir"

msgid "Other"
msgstr "Diğer"

msgid "Bootstrap Site Alert Configuration"
msgstr "Önyükleme Site Uyarısı Yapılandırması"

msgid "Configure the Bootstrap Site Wide Alert Settings"
msgstr "Önyükleme Site Genelinde Uyarı Ayarlarını Yapılandır"

msgid "Administer Bootstrap Site Alert"
msgstr "Önyükleme Site Uyarısını Yönet"

msgid "View Bootstrap Site Alert"
msgstr "Önyükleme Site Uyarısını Görüntüle"

msgid "Settings"
msgstr "Ayarlar"

msgid ""
"<h3>Use this form to setup the bootstrap site alert(s).</h3>\n"
"                  <p>Make sure you select the checkbox if you want to turn the alerts on</p>"
msgstr ""
"<h3>Önyükleme site uyarılarını ayarlamak için bu formu kullanın.</h3>\n"
"                  <p>Uyarıları açmak istiyorsanız onay kutusunu seçtiğinizden emin olun</p>"

msgid "Select Bootstrap Version"
msgstr "Önyükleme Sürümünü Seç"

msgid "3"
msgstr "3"

msgid "4"
msgstr "4"

msgid "- SELECT -"
msgstr "- SEÇ -"

msgid "Save Bootstrap Version"
msgstr "Önyükleme Sürümünü Kaydet"

msgid "Success"
msgstr "Başarılı"

msgid "Info"
msgstr "Bilgi"

msgid "Warning"
msgstr "Uyarı"

msgid "Danger"
msgstr "Tehlike"

msgid "Primary"
msgstr "Birincil"

msgid "Secondary"
msgstr "İkincil"

msgid "Light"
msgstr "Açık"

msgid "Dark"
msgstr "Koyu"

msgid "If Checked, Bootstrap Site Alert is Active."
msgstr "İşaretlenirse, Önyükleme Site Uyarısı Etkin olur."

msgid "Severity"
msgstr "Önem seviyesi"

msgid "Make this alert dismissable?"
msgstr "Bu uyarı yoksayılabilsin mi?"

msgid "Hide this alert on admin pages?"
msgstr "Yönetici sayfalarında bu uyarı gizlensin mi?"

msgid "Only Show On Certain Pages?"
msgstr "Yalnızca Belirli Sayfalarda mı Gösterilsin?"

msgid "Path(s) to show on"
msgstr "Gösterileceği yollar"

msgid "Specify pages by using their paths. Enter one path per line. The '*' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page."
msgstr "Sayfaları yollarıyla belirtin. Her satıra tek bir yol girin. Yıldız '*' joker karakterdir. Örnek bir yol olarak, her kullanıcı sayfası için %user-wildcard yolu verilebilir. %front, ön sayfadır."

msgid "Alert Message"
msgstr "Uyarı İletisi"

msgid "Add Another Alert"
msgstr "Başka Bir Uyarı Ekle"

msgid "Remove Last Alert"
msgstr "Son Uyarıyı Kaldır"

msgid "Save Alert Message(s)"
msgstr "Uyarı İletilerini Kaydet"

