msgid ""
"\n"
"        <h2>Maintenance200 module.</h2>\n"
"        <h3>Instructions</h3>\n"
"        <p>Install the module as normal and enable in <strong>/admin/modules</strong>.</p>\n"
"        <p>On the module configuration form you will find a switch to turn on or off the rewriting of the HTTP code returned when the site is in maintenance mode, as well as a field where you\n"
"        can input the numeric HTTP which the site should return.</p>\n"
"      "
msgstr ""
"\n"
"        <h2>Módulo Maintenance200.</h2>\n"
"        <h3>Instrucciones</h3> <p>Instale el módulo de la forma habitual y habilítelo en <strong>/admin/modules</strong>.</p>\n"
"        <p>En el formulario de configuración del módulo encontrará un conmutador para activar o desactivar la reescritura del código HTTP devuelto cuando el sitio está en modalidad de mantenimiento, así como un campo en el que puede especificar el HTTP numérico que el sitio debe devolver.</p>\n"
"      "

msgid "Maintenance 200"
msgstr "Mantenimiento 200"

msgid "Allows the maintenance page to return a configurable HTTP status code rather than the standard 503 code."
msgstr "Permite que la página de mantenimiento devuelva un código de estado HTTP configurable en lugar del código 503 estándar."

msgid "Configure maintenance200"
msgstr "Configurar maintenance200"

msgid "Maintenance200 Settings"
msgstr "Valores de Maintenance200"

msgid "Maintenance 200 settings"
msgstr "Valores de Mantenimiento 200"

msgid "Enable custom status code during maintenance mode"
msgstr "Habilitar código de estado personalizado durante la modalidad de mantenimiento"

msgid "Status code to return during maintenance mode"
msgstr "Código de estado a devolver durante la modalidad de mantenimiento"

msgid "Change the status code during maintenance mode"
msgstr "Cambiar el código de estado durante la modalidad de mantenimiento"

msgid "Status code to use"
msgstr "Código de estado a utilizar"

msgid "A valid HTTP status code is required. See the Wikipedia <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">HTTP status codes</a> page for a complete list."
msgstr "Es necesario un código de estado HTTP válido. Consulte la página de wikipedia <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">Códigos de estado HTTP</a> para obtener una lista completa."

msgid "A valid HTTP status code is required."
msgstr "Es necesario un código de estado HTTP válido."

msgid "You must provide an HTTP status code."
msgstr "Debe proporcionar un código de estado HTTP."

