msgid "About"
msgstr "Informationen"

msgid "Enable bookmaking of AJAX views. Supports filters and paging."
msgstr "Erstellung von Lesezeichen für AJAX-Ansichten aktivieren. Unterstützt Filter und Paging."

msgid "Visit the <a href=\":project_link\">Views AJAX History project pages</a> on Drupal.org for more information."
msgstr "Weitere Informationen finden Sie auf den Projektseiten <a href=\":project_link\">Views AJAX History</a> unter Drupal.org."

msgid "Views AJAX History"
msgstr "Ansichten AJAX-Verlauf"

msgid "Add bookmarking abilities to AJAX Views."
msgstr "Fähigkeiten zum Setzen von Lesezeichen zu AJAX-Ansichten hinzufügen."

msgid "Views"
msgstr "Ansichten"

msgid "Enable history"
msgstr "Verlauf aktivieren"

msgid "AJAX history"
msgstr "AJAX-Verlauf"

msgid "Enable Views AJAX history."
msgstr "Views AJAX-Verlauf aktivieren."

msgid "Enable the AJAX history feature for the current view."
msgstr "AJAX-Verlaufsfunktion für die aktuelle Ansicht aktivieren."

