msgid "VotingAPI tokens"
msgstr "Маркеры VotingAPI"

msgid "Dynamic Tokens for VotingAPI."
msgstr "Динамические маркеры для VotingAPI."

msgid "Vote count"
msgstr "Количество оценок"

msgid "Number of votes."
msgstr "Число оценок. "

msgid "Average Result"
msgstr "Средний результат"

msgid "Average result of votes."
msgstr "Средний результат оценок. "

msgid "Best Vote"
msgstr "Лучшая оценка"

msgid "Best Vote cast."
msgstr "Лучшая оценка. "

msgid "Worst Vote"
msgstr "Худшая оценка"

msgid "Worst Vote cast."
msgstr "Худшая оценка. "

msgid "About"
msgstr "О модуле"

msgid "This module enables tokens for all entity types that has <kbd>voting_api_field</kbd>."
msgstr "Этот модуль поддерживает маркеры для всех типов сущностей с <kbd>voting_api_field</kbd>."

msgid "Usage"
msgstr "Формат"

msgid "Tokens are dynamic and you have to pass <emph>vote_type</emph> as the last parameter. Module defines four tokens:"
msgstr "Поскольку маркеры создаются в динамическом режиме, необходимо передать <emph>vote_type</emph> в качестве последнего параметра. Модуль задает четыре маркера:"

msgid "<ul><li>Vote count :: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"
msgstr "<ul><li>Число оценок:: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"

msgid "<li>Vote average :: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"
msgstr "<li>Средняя оценка:: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"

msgid "<li>Best vote :: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"
msgstr "<li>Лучшая оценка:: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"

msgid "<li>Worst vote :: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"
msgstr "<li>Худшая оценка:: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"

msgid "Voting"
msgstr "Голосование"

