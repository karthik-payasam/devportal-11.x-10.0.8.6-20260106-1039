msgstr "Veld met consumergeheim"

msgid "Field with Oauth access token"
msgstr "Veld met Oauth-toegangstoken"

msgid "Field with Oauth access token secret"
msgstr "Veld met geheim van Oauth-toegangstoken"

msgid "Enable automatic thumbnail generation"
msgstr "Automatisch genereren van thumbnails inschakelen"

