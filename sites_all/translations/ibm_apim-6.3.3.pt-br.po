msgid "IBM API Developer Portal Development Settings"
msgstr "Configurações de desenvolvimento do IBM API Developer Portal"

msgid "Debug"
msgstr "Depurar"

msgid "Enable method entry / exit trace"
msgstr "Ativar entrada de método/rastreio de saída"

msgid "WARNING: Not to be used on production servers. It greatly increases the amount of debug information in the logs."
msgstr "AVISO: essa opção não será usada em servidores de produção. Ela aumenta enormemente a quantia de informações de depuração nos logs."

msgid "Enable API Manager REST interface debug"
msgstr "Ativar depuração interface REST do gerenciador de API"

msgid "Enable webhook payload debug"
msgstr "Ativar depuração de carga útil do webhook"

msgid "WARNING: Not to be used on production servers. It stores all webhook payloads in the database for debug. This does not scale well!"
msgstr "AVISO: essa opção não será usada em servidores de produção. Ela armazena todas as cargas úteis do webhook no banco de dados para depuração. Isso não escala bem!"

msgid "Enable snapshot debug logging"
msgstr "Ativar a criação do log de depuração da captura instantânea"

msgid "WARNING: Not to be used on production servers. It generates a lot of logging when snapshots are processed. This does not scale well!"
msgstr "AVISO: essa opção não será usada em servidores de produção. Isto gera muitos logs quando as capturas instantâneas são processadas. Isso não escala bem!"

msgid "Enable audit log backtrace member in CADF request"
msgstr "Ativar membro de rastreio de retorno no log de auditoria na solicitação CADF"

msgid "WARNING: Not to be used on production servers. Adds unsupported backtrace member to CADF output."
msgstr "AVISO: essa opção não será usada em servidores de produção. Inclui membro de rastreio de retorno não suportado à saída CADF."

msgid "Use this debug audit endpoint to send audit data to, instead of apim."
msgstr "Use esse terminal de auditoria de depuração para enviar dados de auditoria, em vez de \"apim\"."

msgid "WARNING: Should not to be used on production servers."
msgstr "AVISO: não deve ser usado em servidores de produção."

msgid "Log level for audit"
msgstr "Nível de log para auditoria"

msgid "WARNING: debug should not to be used on production servers."
msgstr "AVISO: a depuração não deve ser usada em servidores de produção."

msgid "Enable node access control debug"
msgstr "Ativar depuração de controle de acesso de nó"

msgid "Insecure mode (disable Consumer API certificate validation)"
msgstr "Modo inseguro (desativar a validação do certificado de API do Consumidor)"

msgid "WARNING: Not to be used on production servers. It disables certificate validation when calling the APIM Consumer API, this leaves you vulnerable to 'Man in the middle' attacks."
msgstr "AVISO: essa opção não será usada em servidores de produção. Desativa a validação de certificado ao chamar a API do Consumidor do APIM, o que deixa você vulnerável a ataques 'Man in the middle'."

msgid "These development options are not available when running in IBM Cloud."
msgstr "Essas opções de desenvolvimento não estão disponíveis na execução no IBM Cloud."

msgid "WARNING: Account only has a member role for the org \"@orgName\", some features of the Developer Portal maybe restricted. Contact your Consumer Org owner to be granted permissions such as Administrator, Developer or Viewer."
msgstr "AVISO: a conta só tem uma função de membro para a organização \"@orgName\", alguns recursos do portal do desenvolvedor podem ser restritos. Entre em contato com o proprietário da organização de consumidores para obter permissões como Administrador, Desenvolvedor ou Visualizador."

