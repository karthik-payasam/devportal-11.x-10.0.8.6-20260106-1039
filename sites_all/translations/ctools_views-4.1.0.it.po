msgid "Chaos Tools Views"
msgstr "Viste strumenti Chaos"

msgid "A set of improvements to the core Views code that allows for greater control over Blocks."
msgstr "Una serie di miglioramenti al codice delle viste core che consente un maggiore controllo sui blocchi."

msgid "Chaos tool suite (Experimental)"
msgstr "Chaos tool suite (Sperimentale)"

msgid "Items per page"
msgstr "Elementi per pagina"

msgid "Pager offset"
msgstr "Offset pager"

msgid "Pager type"
msgstr "Tipo di pager"

msgid "Hide fields"
msgstr "Nascondi campi"

msgid "Reorder fields"
msgstr "Riordina campi"

msgid "Configure filters"
msgstr "Configura filtri"

msgid "Disable filters"
msgstr "Disabilita filtri"

msgid "Configure sorts"
msgstr "Configura ordinamenti"

msgid "Allow settings"
msgstr "Consenti impostazioni"

msgid "None"
msgstr "Nessuna"

msgid "For example, set this to 3 and the first 3 items will not be displayed."
msgstr "Per esempio, impostando questo a 3 i primi 3 elementi non verranno mostrati."

msgid "Inherit from view"
msgstr "Eredita dalla vista"

msgid "Display a specified number of items"
msgstr "Visualizza un numero specifico di elementi"

msgid "Display all items"
msgstr "Visualizza tutti gli elementi"

msgid "Pager"
msgstr "Pager"

msgid "Hide"
msgstr "Nascondi"

msgid "Label"
msgstr "Etichetta"

msgid "Weight"
msgstr "Peso"

msgid "Weight for @title"
msgstr "Peso per @title"

msgid "Exposed filter values"
msgstr "Valori di filtro esposti"

msgid "If a value is set for an exposed filter, it will be removed from the block display."
msgstr "Se è stato impostato un valore per un filtro esposto, verrà rimosso dalla visualizzazione dei blocchi."

msgid "Expose filter value to user"
msgstr "Esponi valore di filtro all'utente"

msgid "Expose this filter value to visitors? If so, the value set here will be the default."
msgstr "Esporre questo valore di filtro ai visitatori? In tal caso, il valore impostato qui sarà il valore predefinito."

msgid "Expose filter operator to user"
msgstr "Esponi operatore di filtro all'utente"

msgid "Expose this filter's operator to visitors? If so, the operator set here will be the default."
msgstr "Esporre l'operatore di questo filtro ai visitatori? In tal caso, l'operatore impostato qui sarà il valore predefinito."

msgid "Disable filter: @handler"
msgstr "Disabilita filtro: @handler"

msgid "Sort ascending"
msgstr "Ordina in modo ascendente"

msgid "Sort descending"
msgstr "Ordina in modo discendente"

msgid "Order"
msgstr "Ordinamento"

