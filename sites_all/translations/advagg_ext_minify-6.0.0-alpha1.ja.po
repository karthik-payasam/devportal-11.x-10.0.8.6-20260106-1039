msgid "Advagg External Minification: PHP shell_exec"
msgstr "Advagg External Minification: PHP shell_exec"

msgid "PHP shell_exec is non-functional."
msgstr "PHP shell_exec は機能していません。"

msgid "Check php.ini for safemode or <a href=\"@link\" target=\"_blank\">disable_functions</a>."
msgstr "php.ini を調べて、safemode または <a href=\"@link\" target=\"_blank\">disable_functions</a> を探します。"

msgid "Enabled"
msgstr "有効"

msgid "AdvAgg External Minification"
msgstr "AdvAgg External Minification"

msgid "Minify Javascript and/or CSS with a command line minifier."
msgstr "コマンド・ライン・ミニファイヤーを使用して Javascript または CSS (あるいはその両方) をミニファイします。"

msgid "Advanced CSS/JS Aggregation"
msgstr "Advanced CSS/JS Aggregation"

msgid "External Minification"
msgstr "External Minification"

msgid "AdvAgg external minification settings."
msgstr "Advagg External Minification の設定。"

msgid "AdvAgg: External Minifiers"
msgstr "AdvAgg: 外部ミニファイヤー"

msgid "Settings"
msgstr "設定"

msgid "Command line for external CSS minification."
msgstr "外部 CSS ミニファイ用のコマンド・ライン。"

msgid "Whether to use the external CSS minifier if configured."
msgstr "外部 CSS ミニファイヤーが構成されている場合に、それを使用するかどうか。"

msgid "Command line for external JavaScript minification."
msgstr "外部 JavaScript ミニファイ用のコマンド・ライン。"

msgid "Whether to use the external JS minifier if configured."
msgstr "外部 JS ミニファイヤーが構成されている場合に、それを使用するかどうか。"

msgid "CSS"
msgstr "CSS"

msgid "JavaScript"
msgstr "JavaScript"

msgid "Command Line"
msgstr "コマンド・ライン"

msgid "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = input file. <br /> {%IN_URL_ENC%} = url pointing to the input file that has been url encoded. <br /> {%OUT%} = output file. <br /><br />"
msgstr "{%CWD%} = \\Drupal::root()。<br /> {%IN%} = 入力ファイル。<br /> {%IN_URL_ENC%} = URLエンコードされた入力ファイルを指す。<br /> {%OUT%} = 出力ファイル。<br /><br />"

msgid "Example using the <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"
msgstr "<a href=\"@link1\">Microsoft Ajax Minifier</a>使用の例。<p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "<a href=\"@link1\">Google Closure Compiler</a>使用の例。<p><code>@code1</code></p>"

msgid "Example using curl to minify via the <a href=\"@link1\">Online Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "curlを使用して<a href=\"@link1\">オンラインのGoogle Closure Compiler</a>によってミニファイする例。<p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">YUI Compressor</a>. <p><code>@code1</code></p>"
msgstr "<a href=\"@link1\">YUI Compressor</a>使用の例。<p><code>@code1</code></p>"

msgid "Example using curl to minify via an online <a href=\"@link1\">CSS Minifier</a>. <p><code>@code1</code></p>"
msgstr "curlを使用してオンラインの<a href=\"@link1\">CSS Minifier</a>によってミニファイする例。<p><code>@code1</code></p>"

msgid "Command to run"
msgstr "実行するコマンド"

msgid "Enable external @type minification"
msgstr "外部 @type ミニファイを有効化"

