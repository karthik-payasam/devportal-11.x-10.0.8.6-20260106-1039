msgid "Metatag: Pinterest"
msgstr "Metatag: Pinterest"

msgid "Provides support for Pinterest's custom meta tags."
msgstr "Fornisce il supporto per i metatag personalizzati di Pinterest."

msgid "SEO"
msgstr "SEO"

msgid "Pinterest: Description"
msgstr "Pinterest: Descrizione"

msgid "Pinterest: ID"
msgstr "Pinterest: ID"

msgid "Pinterest: Media"
msgstr "Pinterest: Supporto"

msgid "Pinterest: No hover"
msgstr "Pinterest: Nessuna informazione rapida"

msgid "Pinterest: No pin"
msgstr "Pinterest: Nessun blocco"

msgid "Pinterest: No search"
msgstr "Pinterest: Nessuna ricerca"

msgid "Pinterest: URL"
msgstr "Pinterest: URL"

msgid "Pinterest"
msgstr "Pinterest"

msgid "A set of meta tags used to control how the site's content is consumed by <a href='https://pinterest.com/'>Pinterest</a>."
msgstr "Un insieme di metatag utilizzati per controllare il modo in cui il contenuto del sito viene utilizzato da <a href='https://pinterest.com/'>Pinterest</a>."

msgid "Description"
msgstr "Descrizione"

msgid "A one to two sentence description of the content."
msgstr "Una descrizione del contenuto composta da una o due frasi."

msgid "Id"
msgstr "ID"

msgid "The Canonical Pinterest object to pin."
msgstr "L'oggetto Pinterest canonico da bloccare."

msgid "Media"
msgstr "Contenuto multimediale"

msgid "The URL of media which should represent the content."
msgstr "L'URL del supporto che dovrebbe rappresentare il contenuto."

msgid "No hover"
msgstr "Nessuna informazione rapida"

msgid "Do not show hovering Save or Search buttons, generated by the Pinterest browser extensions."
msgstr "Non mostra i pulsanti Salva o Ricerca a comparsa, generati dalle estensioni del browser Pinterest."

msgid "No pin"
msgstr "Nessun blocco"

msgid "Do not pin anything from this page. When selected, this option will take precedence over all options below."
msgstr "Non blocca alcun elemento da questa pagina. Quando è selezionata, questa opzione ha precedenza rispetto a tutte le altre opzioni di seguito."

msgid "No search"
msgstr "Nessuna ricerca"

msgid "Do not allow Pinterest visual search to happen from this page."
msgstr "Non consente a Pinterest di eseguire ricerche visive da questa pagina."

msgid "URL"
msgstr "URL"

msgid "The URL which should represent the content."
msgstr "L'URL che dovrebbe rappresentare il contenuto."

