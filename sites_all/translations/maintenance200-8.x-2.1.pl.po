msgid ""
"\n"
"        <h2>Maintenance200 module.</h2>\n"
"        <h3>Instructions</h3>\n"
"        <p>Install the module as normal and enable in <strong>/admin/modules</strong>.</p>\n"
"        <p>On the module configuration form you will find a switch to turn on or off the rewriting of the HTTP code returned when the site is in maintenance mode, as well as a field where you\n"
"        can input the numeric HTTP which the site should return.</p>\n"
"      "
msgstr ""
"\n"
"        Moduł <h2>Maintenance200.</h2>\n"
"        <h3>Instrukcje</h3><p>Zainstaluj moduł jako normalny i włącz pod adresem <strong>/admin/modules</strong>.</p>\n"
"        <p>W formularzu konfiguracji modułu znajdziesz przełącznik służący do włączania lub wyłączania funkcji przepisywania kodu HTTP zwracanego, gdy serwis jest w trybie konserwacji, a także pole, w którym można wprowadzić numeryczny kod HTTP, który powinien zwrócić serwis.</p>\n"
"      "

msgid "Maintenance 200"
msgstr "Maintenance 200"

msgid "Allows the maintenance page to return a configurable HTTP status code rather than the standard 503 code."
msgstr "Umożliwia stronie konserwacji zwracanie konfigurowalnego kodu statusu HTTP, a nie standardowego kodu 503."

msgid "Configure maintenance200"
msgstr "Konfigurowanie kodu maintenance200"

msgid "Maintenance200 Settings"
msgstr "Ustawienia kodu Maintenance200"

msgid "Maintenance 200 settings"
msgstr "Ustawienia kodu Maintenance 200"

msgid "Enable custom status code during maintenance mode"
msgstr "Włącz niestandardowy kod statusu podczas trybu konserwacji"

msgid "Status code to return during maintenance mode"
msgstr "Kod statusu do zwrócenia podczas trybu konserwacji"

msgid "Change the status code during maintenance mode"
msgstr "Zmień kodu statusu podczas trybu konserwacji"

msgid "Status code to use"
msgstr "Kod statusu do użycia"

msgid "A valid HTTP status code is required. See the Wikipedia <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">HTTP status codes</a> page for a complete list."
msgstr "Wymagany jest poprawny kod statusu HTTP. Pełną listę można znaleźć na stronie Wikipedii <a href=\"http://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">Kody statusu HTTP</a>."

msgid "A valid HTTP status code is required."
msgstr "Wymagany jest poprawny kod statusu HTTP."

msgid "You must provide an HTTP status code."
msgstr "Należy podać kod statusu HTTP."

