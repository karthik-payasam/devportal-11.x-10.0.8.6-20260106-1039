msgid "OpenAPI"
msgstr "OpenAPI"

msgid "Connects Drupal to the OpenAPI Javascript Library"
msgstr "Conecta o Drupal à Biblioteca do Javascript OpenAPI"

msgid "Available OpenAPI Documentation."
msgstr "Documentação de OpenAPI disponível."

msgid "Access API Docs"
msgstr "API de Acesso Docs"

msgid "Access documentation page for the REST API"
msgstr "Acesse a página de documentação para a API de REST"

msgid "OpenAPI Schema Download"
msgstr "Download do Esquema OpenAPI"

msgid "OpenAPI Resources"
msgstr "Recursos de OpenAPI"

msgid "OpenAPI Documentation"
msgstr "Documentação de OpenAPI"

msgid "%label OpenApi Schema Download"
msgstr "%label ^% Download de Esquema OpenApi"

msgid "The specifications provide the documentation on some of Drupal's apis following <a href=':openapi_spec'>OpenAPI (aka Swagger)</a> standards."
msgstr "As especificações fornecem a documentação sobre algumas das APIs de Drupal que seguem os padrões <a href=':openapi_spec'>OpenAPI (também conhecido como Swagger)</a>."

msgid "These json files can be used in tools such as the <a href=\":swagger_editor\">Swagger Editor</a> to provide a more detailed version of the API documentation or <a href=\":swagger_codegen\">Swagger Codegen</a> to create an api client."
msgstr "Esses arquivos json podem ser usados em ferramentas como o <a href=\":swagger_editor\">Editor Swagger</a> para fornecer uma versão mais detalhada da documentação da API ou do <a href=\":swagger_codegen\">Swagger Codegen</a> para criar um cliente da API."

msgid "Module"
msgstr "Módulo"

msgid "Specification"
msgstr "Especificação"

msgid "Explore"
msgstr "Explorar"

msgid "Please visit the <a href=':openapi_ui_link'>OpenAPI UI module</a> for information on these interfaces and to discover others."
msgstr "Visite o <a href=':openapi_ui_link'>módulo da IU do OpenAPI</a> para obter informações sobre essas interfaces e para descobrir outras."

msgid "No UI plugins available"
msgstr "Nenhum plug-in de IU disponível"

msgid "There are no plugins available for exploring the OpenAPI documentation."
msgstr "Não há plug-ins disponíveis para explorar a documentação do OpenAPI."

msgid "You can install one of the below projects to view the API Specifications from with your site."
msgstr "É possível instalar um dos projetos abaixo para visualizar as Especificações de API com seu site."

msgid "View/Download"
msgstr "Visualizar/Fazer download"

msgid "Explore with %interface"
msgstr "Explorar com %interface"

msgid "No UI available."
msgstr "Nenhuma IU disponível."

msgid "No OpenApi generator plugins are currently available."
msgstr "Nenhum plug-in do gerador OpenApi está disponível atualmente."

msgid "You must enable a REST or API module which supports OpenApi Downloads, such as the <a href=\":rest_link\">Core Rest</a> and <a href=\":jsonapi_link\">JSON:API</a> modules."
msgstr "Deve-se ativar um módulo REST ou API que suporta Downloads OpenApi, como os módulos <a href=\":rest_link\">Core Rest</a> e <a href=\":jsonapi_link\">JSON:API</a>."

msgid "%generator OpenApi Documentation"
msgstr "Documentação de OpenApi do %generator"

