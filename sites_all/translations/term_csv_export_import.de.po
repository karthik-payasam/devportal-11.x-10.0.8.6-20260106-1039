msgid "No destination directory provided."
msgstr "Es wurde kein Zielverzeichnis angegeben."

msgid "About"
msgstr "Über"

msgid "Helper module to quickly import a list of terms with parent structure."
msgstr "Mit dem Hilfemodul kann schnell eine Liste von Begriffen mit der übergeordneten Struktur importiert werden."

msgid "Term CSV Export/Import"
msgstr "Begriffs-CSV exportieren/importieren"

msgid "Import and Export Taxonomy terms as csv."
msgstr "Taxonomiebegriffe als CSV importieren und exportieren."

msgid "Taxonomy"
msgstr "Taxonomie"

msgid "Import and Export Taxonomy Terms as CSV"
msgstr "Taxonomiebegriffe als CSV importieren und exportieren"

msgid "Term CSV Import"
msgstr "Begriffs-CSV importieren"

msgid "Term CSV Export"
msgstr "Begriffs-CSV exportieren"

msgid "Administer CSV Term Import"
msgstr "CSV-Begriffsimport verwalten"

msgid "Allows a user to import taxonomy terms."
msgstr "Ermöglicht einem Benutzer das Importieren von Taxonomiebegriffen."

msgid "CSV Term Import"
msgstr "CSV-Begriffsimport"

msgid "CSV Term Export"
msgstr "CSV-Begriffsexport"

msgid "The header keys were not included in the import."
msgstr "Die Header-Schlüssel waren nicht im Import enthalten."

msgid "Line with \"@part\" could not be parsed. Incorrect number of values: @count."
msgstr "Zeile mit \"@part\" konnte nicht analysiert werden. Falsche Anzahl von Werten: @count."

msgid "The term @name has multiple matches. Ignoring."
msgstr "Der Begriff @name weist mehrere Übereinstimmungen auf. Er wird ignoriert."

msgid "The term with id @id already exists and preserve existing terms is checked. No modification has been made."
msgstr "Der Begriff mit der ID @id ist bereits vorhanden und die Beibehaltung der vorhandenen Begriffe ist ausgewählt. Es wurde keine Änderung vorgenommen."

msgid "The Term ID already exists."
msgstr "Die Begriffs-ID ist bereits vorhanden."

msgid "More than 1 terms are named @name. Cannot distinguish by name. Try using id export/import."
msgstr "Mehr als 1 Begriffe ist mit @name benannt. Eine Unterscheidung nach Name ist nicht möglich. Versuchen Sie einen Export/Import über die ID."

msgid "The field data <em>@data</em> is not formatted correctly. Please use the export function."
msgstr "Die Felddaten <em>@data</em> sind nicht ordnungsgemäß formatiert. Verwenden Sie die Exportfunktion."

msgid "The field data <em>@data</em> could not be imported. Please add the appropriate fields to the vocabulary you are importing into."
msgstr "Die Felddaten <em>@data</em> konnten nicht importiert werden. Fügen Sie die entsprechenden Felder zum Vokabular hinzu, in das Sie importieren."

msgid "Imported @count terms."
msgstr "@count Begriffe wurden importiert."

msgid "Include Term Ids in export."
msgstr "Begriffs-IDs im Export einschließen."

msgid "Include Term Headers in export."
msgstr "Begriffs-Header im Export einschließen."

msgid "Include extra fields in export."
msgstr "Zusätzliche Felder im Export einschließen."

msgid "Note that fields are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"
msgstr "Beachten Sie, dass Felder mit <a href=\"http://www.php.net/http_build_query\">http_build_query</a> in Zeichenfolgen konvertiert werden."

msgid "Export"
msgstr "Exportieren"

msgid "CSV Data"
msgstr "CSV-Daten"

msgid "The formatted term data"
msgstr "Die formatierten Begriffsdaten."

msgid "Input"
msgstr "Input"

msgid "<p><strong>See CSV Export for an example.</strong></p><p>Enter in the form of: <pre>\"name,status,description,format,weight,parent_name,[any_additional_fields];</pre><pre>name,status,description,format,weight,parent_name[;parent_name1;parent_name2;...],[any_additional_fields]\"</pre> or <pre>\"tid,uuid,name,status,revision_id,description,format,weight,parent_name[;parent_name1;parent_name2;...],parent_tid[;parent_tid1;parent_tid2;...],[any_additional_fields];</pre><pre>tid,uuid,name,status,revision_id,description,format,weight,parent_name,parent_tid,[any_additional_fields]\"</pre> Note that <em>[any_additional_fields]</em> are optional and are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>If you need to export from Drupal 7, you can import and modify the view d7exportview.txt found at the root directory of this project</p>"
msgstr "<p><strong>Siehe CSV-Export für ein Beispiel.</strong></p><p>Eingabe im folgenden Format: <pre>\"name,status,description,format,weight,parent_name,[any_additional_fields];</pre><pre>name,status,description,format,weight,parent_name[;parent_name1;parent_name2;...],[any_additional_fields]\"</pre> oder <pre>\"tid,uuid,name,status,revision_id,description,format,weight,parent_name[;parent_name1;parent_name2;...],parent_tid[;parent_tid1;parent_tid2;...],[any_additional_fields];</pre><pre>tid,uuid,name,status,revision_id,description,format,weight,parent_name,parent_tid,[any_additional_fields]\"</pre> Beachten Sie, dass <em>[any_additional_fields]</em> optional sind und mit <a href=\"http://www.php.net/http_build_query\">http_build_query</a> in Zeichenfolgen konvertiert werden.</p><p>Wenn Sie aus Drupal 7 exportieren möchten, können Sie die Ansicht 'd7exportview.txt' importieren und ändern, die sich im Stammverzeichnis dieses Projekts befindet.</p>"

msgid "Preserve Vocabularies on existing terms."
msgstr "Vokabulare für vorhandene Begriffe beibehalten."

msgid "Preserve existing terms. This will prevent a term id collision if importing from another install."
msgstr "Vorhandene Begriffe beibehalten. Dies verhindert, dass beim Importieren aus einer anderen Installation eine Kollision der Begriffs-IDs auftritt."

msgid "Next"
msgstr "Weiter"

msgid "Name"
msgstr "Name"

msgid "Create New Vocabulary"
msgstr "Neues Vokabular erstellen"

msgid "Create Vocabulary"
msgstr "Vokabular erstellen"

msgid "Are you sure you want to copy @count_terms terms into the vocabulary @vocabulary@preserve_vocabularies?"
msgstr "Möchten Sie wirklich @count_terms Begriffe in das Vokabular @vocabulary@preserve_vocabularies kopieren?"

msgid "Import"
msgstr "Importieren"

