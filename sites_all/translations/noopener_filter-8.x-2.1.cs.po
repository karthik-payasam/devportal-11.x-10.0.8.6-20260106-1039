msgid "Noopener Filter"
msgstr "Filtr Noopener"

msgid "Provides a filter to add rel=\"noopener\" to external links and links in the ckeditor."
msgstr "Poskytuje filtr pro přidání rel=\"noopener \" do externích odkazů a odkazů v editoru ckeditor."

msgid "Noopener filter settings"
msgstr "Nastavení filtru Noopener"

msgid "Change settings for noopener filter"
msgstr "Změnit nastavení pro filtr Noopener"

msgid "Administer Noopener filter"
msgstr "Správa filtru Noopener"

msgid "Enables the ability to change the noopener filter settings."
msgstr "Umožňuje změnit nastavení filtru Noopener."

msgid "Settings for Noopener filter"
msgstr "Nastavení filtru Noopener"

msgid "Noopener"
msgstr "Noopener"

msgid "Filter links"
msgstr "Filtrovat odkazy"

msgid "Filter links through alter link hook."
msgstr "Filtrujte odkazy pomocí háčku pro změnu odkazu."

msgid "Save"
msgstr "Uložit"

msgid "Add noopener to all links"
msgstr "Přidat noopener do všech odkazů"

