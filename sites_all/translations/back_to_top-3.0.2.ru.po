msgid "Back To Top"
msgstr "Вверх"

msgid "Back To Top adds a button that hovers in the bottom of your screen and allow users to smoothly scroll up the page using jQuery."
msgstr "«Вернуться к началу» это кнопка, которая находится в нижней части экрана и позволяет пользователям плавно прокручивать страницу вверх, используя jQuery."

msgid "User interface"
msgstr "Интерфейс пользователя"

msgid "Back to Top"
msgstr "Вернуться в начало"

msgid "Administer Back To Top settings."
msgstr "Администрирование параметров модуля В начало. "

msgid "Back to top settings"
msgstr "Параметры модуля В начало"

msgid "Access Back to top settings"
msgstr "Доступ к настройкам «Вернуться к началу»"

msgid "Prevent on mobile and touch devices"
msgstr "Не показывать на мобильных и сенсорных устройствах"

msgid "Prevent on administration pages and node edit"
msgstr "Не показывать на администраторских и страницах редактирования"

msgid "Prevent on front page"
msgstr "Запрет на главной странице"

msgid "Trigger"
msgstr "Триггер"

msgid "Placement"
msgstr "Положение"

msgid "Button text"
msgstr "Текст на кнопке"

msgid "Background color"
msgstr "Цвет фона"

msgid "Border color"
msgstr "Цвет рамки"

msgid "Hover color"
msgstr "Цвет при наведении"

msgid "Text color"
msgstr "Цвет текста"

msgid "Back to top"
msgstr "Наверх"

msgid "Do you want to prevent Back To Top on admin pages?"
msgstr "Вы хотите отключить \"Вверх\" на администраторских страницах?"

msgid "Do you want to prevent Back To Top on front page?"
msgstr "Вы не хотите появление кнопки на главной странице?"

msgid "Set the number of pixel which trigger the Back To Top button default 100"
msgstr "Установите число пикселей от верха экрана, при прокрутке которых запускается кнопка «Вернуться к началу» по умолчанию 100"

msgid "Where should the Back To Top button appear?"
msgstr "Где должна отображаться кнопка «Вернуться к началу»?"

msgid "Bottom right"
msgstr "Внизу справа"

msgid "Bottom left"
msgstr "Внизу слева"

msgid "Bottom center"
msgstr "Внизу в центре"

msgid "Top right"
msgstr "Вверху справа"

msgid "Top left"
msgstr "Вверху слева"

msgid "Top center"
msgstr "Вверху в центре"

msgid "Mid right"
msgstr "Посередине и справа"

msgid "Mid left"
msgstr "Посередине и слева"

msgid "Mid center"
msgstr "Посередине и по центру"

msgid "Set the text of the Back To Top button"
msgstr "Укажите текст кнопки В начало"

msgid "Do you want Back To Top to use a PNG-24 image or a Text/Css button?"
msgstr "Кнопка «Вернуться к началу» использует для оформления изображение PNG-24 или Текст/Css?"

msgid "Image (default)"
msgstr "Изображение (по умолчанию)"

msgid "Text/Css"
msgstr "Текст/CSS"

msgid "Text/Css button settings"
msgstr "Настройка текстовой/CSS кнопки"

msgid "Button background color default #F7F7F7"
msgstr "Цвет фона кнопки по умолчанию: # F7F7F7"

msgid "Border color default #CCCCCC"
msgstr "Цвет рамки по умолчанию: #CCCCCC"

msgid "Hover color default #EEEEEE"
msgstr "Цвет по умолчанию при наведении: #EEEEEE"

msgid "Text color default #333333"
msgstr "Цвет текста по умолчанию #333333"

