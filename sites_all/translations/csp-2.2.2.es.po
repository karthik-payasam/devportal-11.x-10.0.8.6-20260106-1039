msgid "Policies"
msgstr "Políticas"

msgid "Report Only"
msgstr "Solo informe"

msgid "Enforced"
msgstr "Impuesto"

msgid "Enable '@type'"
msgstr "Habilitar '@type'"

msgid "Additional Sources"
msgstr "Orígenes adicionales"

msgid "Additional domains or protocols to allow for this directive, separated by a space."
msgstr "Dominios o protocolos adicionales a permitir para esta directiva, separados por un espacio."

msgid "Instead of child-src, nested browsing contexts and workers should use the frame-src and worker-src directives, respectively."
msgstr "En lugar de child-src, los contextos de navegación anidados y los trabajadores deberían utilizar las directivas frame-src y worker-src, respectivamente."

msgid "Handler"
msgstr "Manejador"

msgid "Reset @policyType policy to default values"
msgstr "Restablecer política @policyType en valores predeterminados"

msgid "No policies are currently enabled."
msgstr "No hay políticas habilitadas actualmente."

msgid "%policy %directive has a hash source configured, which may block functionality that relies on inline code."
msgstr "%policy %directive tiene un origen hash configurado que podría bloquear la funcionalidad que se basa en el código en línea."

msgid "%policy %directive is enabled without a fallback directive for non-supporting browsers."
msgstr "%policy %directive se habilita sin una directriz de reserva para los navegadores que no le dan soporte."

msgid "<a href=\":docUrl\">Nonces must be a unique value for each request</a>, so cannot be set in configuration."
msgstr "<a href=\":docUrl\">Nonces debe ser un valor exclusivo para cada solicitud</a>, por lo que no se puede establecer en la configuración."

msgid "Invalid domain or protocol provided."
msgstr "Se ha proporcionado un dominio o un protocolo no válido."

msgid "Reporting Handler is required for enabled policies."
msgstr "El manejador de creación de informes es necesario para las políticas habilitadas."

msgid "Reporting is disabled"
msgstr "La creación de informes está inhabilitada"

msgid "Your <a href=\":url\">Report-URI.com subdomain</a>."
msgstr "El <a href=\":url\">subdominio de Report-URI.com</a>."

msgid "Enable Wizard"
msgstr "Habilitar asistente"

msgid "Send reports to the <a href=\":url\">CSP Wizard</a> reporting address."
msgstr "Enviar informes a la dirección de la creación de informes del <a href=\":url\">Asistente CSP</a>."

msgid "Reports will be sent to a ReportURI.com account."
msgstr "Los informes se enviarán a una cuenta ReportURI.com."

msgid "Reports will be added to the site log."
msgstr "Los informes se añadirán al registro del sitio."

msgid "The URI to send reports to."
msgstr "El URI al que enviar informes."

msgid "Reports will be sent to a URI."
msgstr "Los informes se enviarán a un URI."

