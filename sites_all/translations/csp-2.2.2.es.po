msgid "No Content Security Policy headers are currently enabled."
msgstr "Actualmente no hay cabeceras de Política de seguridad de contenidos habilitadas."

msgid "Enable a header via <a href=\":csp-settings\">the Content Security Policy settings</a>."
msgstr "Habilitar una cabecera a través de <a href=\":csp-settings\">los valores de Política de seguridad de contenidos</a>."

msgid "Enabling Content Security Policy in Security Kit is likely to cause policy conflicts."
msgstr "Es probable que la habilitación de la política de seguridad de contenido en el kit de seguridad provoque conflictos de política."

msgid "Disable the Content Security Policy settings in <a href=\":seckit-settings\">Security Kit configuration</a>."
msgstr "Inhabilite la configuración de la política de seguridad de contenido en <a href=\":seckit-settings\">Configuración del kit de seguridad</a>."

msgid "Content Security Policy"
msgstr "Política de seguridad de contenidos"

msgid "Provide Content-Security-Policy headers"
msgstr "Proporcionar cabeceras Content-Security-Policy"

msgid "Configure policy enforcement."
msgstr "Configurar imposición de política."

msgid "Administer Content Security Policy"
msgstr "Administrar política de seguridad de contenidos"

msgid "Content Security Policy Settings"
msgstr "Valores de Política de seguridad de contenidos"

msgid "Report-Only Policy"
msgstr "Política de solo informe"

msgid "Enforce Policy"
msgstr "Imponer política"

