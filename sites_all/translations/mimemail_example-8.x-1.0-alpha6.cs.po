msgid "Mime Mail Example"
msgstr "Příklad Mime Mail"

msgid "Example of how to use the Mime Mail module."
msgstr "Příklad použití modulu Mime Mail."

msgid "Example modules"
msgstr "Ukázkové moduly"

msgid "Settings"
msgstr "Nastavení"

msgid "Test Mime Mail"
msgstr "Testovat Mime Mail"

msgid "Send example email"
msgstr "Odeslat ukázkový e-mail"

msgid "Use the example email form to send arbitrary email with attachments."
msgstr "Použijte ukázkový e-mailový formulář k odeslání libovolného e-mailu s přílohami."

msgid "Use this form to send a HTML message to an email address. No spamming!"
msgstr "Tento formulář použijte k odeslání zprávy HTML na e-mailovou adresu. Žádné spamování!"

msgid "Key"
msgstr "Klíč"

msgid "A key to identify the email sent."
msgstr "Klíč pro identifikaci odeslaného e-mailu."

msgid "To"
msgstr "Komu"

msgid "The email address of the recipient. The formatting of this string must comply with <a href=\":url\">RFC 2822</a>"
msgstr "E-mailová adresa příjemce. Formátování tohoto řetězce musí být v souladu s <a href=\":url\">RFC 2822</a>"

msgid "Sender name"
msgstr "Jméno odesílatele"

msgid "The sender's name. Leave empty to use the <a href=\":url\">Site name</a>."
msgstr "Jméno odesílatele. Toto pole ponechte prázdné, chcete-li použít <a href=\":url\">Název serveru</a>."

msgid "Sender email address"
msgstr "Emailová adresa odesílatele"

msgid "The sender's email address. Leave empty to use the site <a href=\":url\">Email address</a>."
msgstr "E-mailová adresa odesílatele. Toto pole ponechte prázdné, chcete-li použít <a href=\":url\">E-mailovou adresu</a> serveru."

msgid "Cc"
msgstr "Kopie"

msgid "The mail's carbon copy address. You may separate multiple addresses with comma."
msgstr "Adresa kopie e-mailu. Více adres oddělte čárkami."

msgid "Bcc"
msgstr "Skrytá kopie"

msgid "The mail's blind carbon copy address. You may separate multiple addresses with comma."
msgstr "Adresa skryté kopie e-mailu. Více adres oddělte čárkami."

msgid "Reply to"
msgstr "Příjemce"

msgid "The address to reply to. Leave empty to use the sender's address."
msgstr "Adresa, na kterou se má odpovědět. Chcete-li použít adresu odesílatele, ponechejte prázdné."

msgid "List-unsubscribe"
msgstr "Seznam - zrušení odběru"

msgid "An email address and/or a URL that may be used for unsubscription. Values must be enclosed by angle brackets and separated by a comma."
msgstr "E-mailová adresa a/nebo adresa URL, které lze použít pro zrušení odběru. Hodnoty musí být uzavřeny lomenými závorkami a odděleny čárkou."

msgid "Subject"
msgstr "Předmět"

msgid "The email's subject."
msgstr "Předmět e-mailu."

msgid "HTML message"
msgstr "Zpráva HTML"

msgid "HTML version of the email body. This will be formatted using the email format selected on the <a href=\":url\">Mime Mail settings page</a>."
msgstr "Verze HTML textu e-mailu. Hodnota bude naformátována pomocí formátu e-mailu vybraného na <a href=\":url\">stránce Nastavení pošty Mime</a>."

msgid "Plain text message"
msgstr "Zpráva prostého textu"

msgid "Plain text version of the email body. Any HTML tags entered here will appear as plain text."
msgstr "Verze prostého textu e-mailu. Všechny zde zadané značky HTML se zobrazí jako prostý text."

msgid "Choose a file to send as an email attachment"
msgstr "Zvolte, který soubor má být odeslán jako příloha e-mailu"

msgid "Send message"
msgstr "Odeslat zprávu"

msgid "That email address is not valid."
msgstr "Tato e-mailová adresa není platná."

msgid "Your message has been sent."
msgstr "Vaše zpráva byla odeslána."

msgid "There was a problem sending your message and it was not sent."
msgstr "Došlo k problému při odesílání zprávy, zpráva nebyla odeslána."

