msgid "None"
msgstr "없음"

msgid "Vertical"
msgstr "세로"

msgid "Horizontal"
msgstr "가로"

msgid "Diagonal"
msgstr "대각선"

msgid "About Superfish"
msgstr "Superfish 정보"

msgid "<a href=\"@url_module\">Superfish module</a> integrates <a href=\"@url_library\">jQuery Superfish</a> plugin to your Drupal menu blocks. Please refer to the module <a href=\"@url_documentation\">documentation</a> for more information."
msgstr "<a href=\"@url_module\">Superfish 모듈</a>은 <a href=\"@url_library\">jQuery Superfish</a> 플러그인을 Drupal 메뉴 블록에 통합합니다. 자세한 정보는 <a href=\"@url_documentation\">문서</a> 모듈을 참조하십시오."

msgid "In order to use Superfish, go to the <a href=\"@block\">Block layout</a> page and use any of the \"Place block\" buttons to create a Superfish block."
msgstr "Superfish를 사용하려면 <a href=\"@block\">블록 레이아웃</a> 페이지로 이동하고 \"블록 배치\" 단추를 사용하여 Superfish 블록을 작성하십시오."

msgid "Superfish library is missing. Please refer to the <a href=\"@documentation\">plugin documentation</a> for how you can fix this issue; Once done, go to the <a href=\"@block\">Block layout</a> page and use any of the \"Place block\" buttons to create a Superfish block."
msgstr "Superfish 라이브러리가 누락되었습니다. 이 문제를 수정하는 방법은 <a href=\"@documentation\">플러그인 문서</a>를 참조하십시오. 완료되면 <a href=\"@block\">블록 레이아웃</a> 페이지로 이동하여 \"블록 배치\" 단추를 사용하여 Superfish 블록을 작성하십시오."

msgid "If there was no Superfish block in the \"Place block\" form, go to the <a href=\"@performance\">Performance</a> page and clear the cache once."
msgstr "\"블록 배치\" 양식에 Superfish 블록이 없는 경우 <a href=\"@performance\">성능</a> 페이지로 이동하여 캐시를 한 번 지우십시오."

msgid "Superfish library"
msgstr "Superfish 라이브러리"

msgid "Inaccessible"
msgstr "액세스 불가능"

msgid "Cannot access the Superfish library directory; perhaps because its permissions and/or ownership are not set up correctly."
msgstr "Superfish 라이브러리 디렉토리에 액세스할 수 없습니다. 아마도 해당 권한 및/또는 소유권이 올바르게 설정되지 않았기 때문입니다."

msgid "Unknown version"
msgstr "알 수 없는 버전"

msgid "Cannot determine the version of your Superfish library."
msgstr "Superfish 라이브러리의 버전을 판별할 수 없습니다."

msgid "Not supported"
msgstr "지원되지 않음"

msgid "The Superfish library requires an update. You can find the update instructions on :url."
msgstr "Superfish 라이브러리에는 업데이트가 필요합니다. :url에서 업데이트 지시사항을 찾을 수 있습니다."

msgid "Installed; at @location"
msgstr "@location에 설치됨"

msgid "Not installed"
msgstr "설치되지 않음"

msgid "Please download the Superfish library from :url."
msgstr ":url에서 Superfish 라이브러리를 다운로드하십시오."

msgid "Superfish"
msgstr "Superfish"

msgid "Adds jQuery Superfish plugin to menu blocks."
msgstr "jQuery Superfish 플러그인을 메뉴 블록에 추가합니다."

msgid "User interface"
msgstr "사용자 인터페이스"

msgid "Block settings"
msgstr "블록 설정"

msgid "Default"
msgstr "기본값"

msgid "Horizontal (single row)"
msgstr "가로(단일 행)"

msgid "Menu type"
msgstr "메뉴 유형"

msgid "Horizontal (double row)"
msgstr "가로(이중 행)"

msgid "Vertical (stack)"
msgstr "세로(스택)"

msgid "Style"
msgstr "스타일"

msgid "Black"
msgstr "검은색"

msgid "Blue"
msgstr "파란색"

msgid "Coffee"
msgstr "커피"

msgid "White"
msgstr "흰색"

msgid "Add arrows to parent menus"
msgstr "화살표를 상위 메뉴에 추가"

msgid "Drop shadows"
msgstr "드롭 새도우"

msgid "jQuery Easing plugin is not installed."
msgstr "jQuery Easing 플러그인이 설치되지 않았습니다."

msgid "The plugin provides a handful number of animation effects, they can be used by uploading the 'jquery.easing.js' file to the libraries directory within the 'easing' directory (for example: libraries/easing/jquery.easing.js). Refresh this page after the plugin is uploaded, this will make more effects available in the above list."
msgstr "플러그인은 많은 애니메이션 효과를 제공하고, 'jquery.easing.js' 파일을 'easing' 디렉토리(예: libraries/easing/jquery.easing.js) 내에서 라이브러리 디렉토리에 업로드하여 사용할 수 있습니다. 플러그인이 업로드된 후에 이 페이지를 새로 고치십시오. 이는 위의 목록에서 더 많은 효과를 사용 가능하게 만듭니다."

msgid "Slide-in effect"
msgstr "슬라이드 인 효과"

msgid "Superfish plugins"
msgstr "Superfish 플러그인"

msgid "Relocates sub-menus when they would otherwise appear outside the browser window area."
msgstr "그렇지 않은 경우 브라우저 창 영역 외부에 나타나게 될 서브 메뉴를 재배치합니다."

msgid "enabled"
msgstr "사용"

msgid "jQuery Supposition"
msgstr "jQuery 가정"

msgid "Prevents accidental firing of animations by waiting until the user's mouse slows down enough, hence determinig user's <em>intent</em>."
msgstr "사용자의 마우스가 충분히 느려질 때까지 기다려서 사용자의 <em>의도</em>를 판별하여 애니메이션이 실수로 시작되는 것을 막으십시오."

msgid "jQuery hoverIntent"
msgstr "jQuery hoverIntent"

msgid "<strong>sf-Touchscreen</strong> provides touchscreen compatibility."
msgstr "<strong>sf-Touchscreen</strong>은 터치 스크린 기능을 제공합니다."

msgid "The first click on a parent hyperlink shows its children and the second click opens the hyperlink."
msgstr "상위 하이퍼링크의 첫 번째 클릭은 해당 하위를 보여주고 두 번째 클릭은 하이퍼링크를 엽니다."

msgid "sf-Touchscreen"
msgstr "sf-Touchscreen"

msgid "Disable"
msgstr "사용 안함"

msgid "Enable jQuery sf-Touchscreen plugin for this menu."
msgstr "이 메뉴의 jQuery sf-Touchscreen 플러그인을 사용으로 설정합니다."

msgid "Enable jQuery sf-Touchscreen plugin for this menu depending on the user's Web browser <strong>window width</strong>."
msgstr "사용자의 웹 브라우저 <strong>창 너비</strong>에 따라 이 메뉴의 jQuery sf-Touchscreen 플러그인을 사용으로 설정합니다."

msgid "Enable jQuery sf-Touchscreen plugin for this menu depending on the user's Web browser <strong>user agent</strong>."
msgstr "사용자의 웹 브라우저 <strong>사용자 에이전트</strong>에 따라 이 메뉴의 jQuery sf-Touchscreen 플러그인을 사용으로 설정합니다."

msgid "Hiding the sub-menu on the second tap, adding cloned parent links to the top of sub-menus as well."
msgstr "두 번째 탭에서 하위 메뉴를 숨기고, 복제된 상위 링크를 또한 하위 메뉴의 맨 위에 추가합니다."

msgid "Using this plugin, the first click or tap will expand the sub-menu, here you can choose what a second click or tap should do."
msgstr "이 플러그인을 사용하면, 첫 번째 클릭 또는 탭은 하위 메뉴를 펼치고, 여기에서 두 번째 클릭이나 탭이 수행해야 하는 작업을 선택할 수 있습니다."

msgid "Opening the parent menu item link on the second tap."
msgstr "두 번째 탭에서 상위 메뉴 항목 링크 열기."

msgid "Hiding the sub-menu on the second tap."
msgstr "두 번째 탭에서 하위 메뉴 숨기기."

msgid "sf-Touchscreen will be enabled only if the width of user's Web browser window is smaller than the below value."
msgstr "sf-Touchscreen은 사용자의 웹 브라우저 창의 너비가 아래 값보다 작은 경우에만 사용으로 설정됩니다."

msgid "Please note that in most cases such a meta tag is necessary for this feature to work properly:"
msgstr "대부분의 경우 이 기능이 제대로 작동하려면 이러한 메타 태그가 필요함을 유의하십시오."

msgid "Window width settings"
msgstr "창 너비 설정"

msgid "Also known as \"Breakpoint\"."
msgstr "\"중단점\"이라고도 합니다."

msgid "pixels"
msgstr "픽셀"

msgid "User agent settings"
msgstr "사용자 에이전트 설정"

msgid "Use the pre-defined list of the <strong>user agents</strong>."
msgstr "<strong>사용자 에이전트</strong>의 사전 정의된 목록을 사용합니다."

msgid "Recommended"
msgstr "권장"

msgid "Use the custom list of the <strong>user agents</strong>."
msgstr "<strong>사용자 에이전트</strong>의 사용자 정의 목록을 사용합니다."

msgid "UA string of the current Web browser:"
msgstr "현재 웹 브라우저의 UA 문자열:"

msgid "Could be partial or complete. (Asterisk separated)"
msgstr "부분 또는 완료일 수 있습니다. (별표로 구분됨)"

msgid "empty"
msgstr "비어 있음"

msgid "Examples"
msgstr "예"

msgid "Custom list of the user agents"
msgstr "사용자 에이전트의 사용자 정의 목록"

msgid "Client-side (JavaScript)"
msgstr "클라이언트측(JavaScript)"

msgid "<strong>User agent</strong> detection method"
msgstr "<strong>사용자 에이전트</strong> 발견 메소드"

msgid "Server-side (PHP)"
msgstr "서버측(PHP)"

msgid "sf-Smallscreen"
msgstr "sf-Smallscreen"

msgid "<strong>sf-Smallscreen</strong> provides small-screen compatibility for your menus."
msgstr "<strong>sf-Smallscreen</strong>은 사용자 메뉴의 작은 화면 호환성을 제공합니다."

msgid "Enable jQuery sf-Smallscreen plugin for this menu depending on the user's Web browser <strong>window width</strong>."
msgstr "사용자의 웹 브라우저 <strong>창 너비</strong>에 따라 이 메뉴의 jQuery sf-Smallscreen 플러그인을 사용으로 설정합니다."

msgid "Enable jQuery sf-Smallscreen plugin for this menu."
msgstr "이 메뉴의 jQuery sf-Smallscreen 플러그인을 사용으로 설정합니다."

msgid "Enable jQuery sf-Smallscreen plugin for this menu depending on the user's Web browser <strong>user agent</strong>."
msgstr "사용자의 웹 브라우저 <strong>사용자 에이전트</strong>에 따라 이 메뉴의 jQuery sf-Smallscreen 플러그인을 사용으로 설정합니다."

msgid "sf-Smallscreen will be enabled only if the width of user's Web browser window is smaller than the below value."
msgstr "sf-Smallscreen은 사용자의 웹 브라우저 창의 너비가 아래 값보다 작은 경우에만 사용으로 설정됩니다."

msgid "Convert the menu to an accordion menu."
msgstr "메뉴를 아코디언 메뉴로 변환합니다."

msgid "Select a type"
msgstr "유형 선택"

msgid "Convert the menu to a &lt;select&gt; element."
msgstr "메뉴를 &lt;select&gt; 요소로 변환하십시오."

msgid "&lt;select&gt; settings"
msgstr "&lt;select&gt; 설정"

msgid "By default the first item in the &lt;select&gt; element will be the name of the parent menu or the title of this block, you can change this by setting a custom title."
msgstr "기본적으로 &lt;select&gt; 요소의 첫 번째 항목은 상위 메뉴의 이름 또는 이 블록의 제목이 됩니다. 사용자 정의 제목을 설정하여 이를 변경할 수 있습니다."

msgid "Example"
msgstr "예제"

msgid "Main Menu"
msgstr "기본 메뉴"

msgid "&lt;select&gt; title"
msgstr "&lt;select&gt; 제목"

msgid "Add <em>selected</em> attribute to the &lt;option&gt; element with the class <strong>active</strong> ."
msgstr "<em>선택됨</em> 속성을 클래스가 <strong>활성</strong>인 <option> 요소에 추가합니다."

msgid "Makes pre-selected the item linked to the active page when the page loads."
msgstr "페이지가 로드될 때 활성 페이지에 링크된 항목을 사전 선택되게 만듭니다."

msgid "More"
msgstr "추가"

msgid "Copy the main &lt;ul&gt; classes to the &lt;select&gt;."
msgstr "기본 &lt;ul&gt; 클래스를 &lt;select&gt;에 복사하십시오."

msgid "disabled"
msgstr "사용 안함"

msgid "Comma separated"
msgstr "쉼표로 구분됨"

msgid "Exclude these classes from the &lt;select&gt; element"
msgstr "&lt;select&gt; 요소에서 이러한 클래스 제외"

msgid "Copy the hyperlink classes to the &lt;option&gt; elements of the &lt;select&gt;."
msgstr "하이퍼링크 클래스를 &lt;select&gt;의 &lt;option&gt; 요소에 복사하십시오."

msgid "Exclude these classes from the &lt;option&gt; elements of the &lt;select&gt;"
msgstr "&lt;select&gt;의 &lt;option&gt; 요소에서 이러한 클래스 제외"

msgid "Include these classes in the &lt;select&gt; element"
msgstr "이러한 클래스를 &lt;select&gt; 요소에 포함"

msgid "Include these classes in the &lt;option&gt; elements of the &lt;select&gt;"
msgstr "이러한 클래스를 &lt;select&gt;의 &lt;option&gt; 요소에 포함"

msgid "Accordion settings"
msgstr "아코디언 설정"

msgid "By default the caption of the accordion toggle switch will be the name of the parent menu or the title of this block, you can change this by setting a custom title."
msgstr "기본적으로, 아코디언 토글 스위치의 캡션은 상위 메뉴의 이름 또는 이 블록의 제목입니다. 사용자 정의 제목을 설정하여 이를 변경할 수 있습니다."

msgid "Menu"
msgstr "메뉴"

msgid "Accordion menu title"
msgstr "아코디언 메뉴 제목"

msgid "Use parent menu items as buttons, add cloned parent links to sub-menus as well."
msgstr "상위 메뉴 항목을 단추로 사용하고, 복제된 링크를 또한 하위 메뉴에 추가합니다."

msgid "Accordion button type"
msgstr "아코디언 단추 유형"

msgid "Use parent menu items as buttons."
msgstr "상위 메뉴 항목을 단추로 사용합니다."

msgid "Create new links next to parent menu item links and use them as buttons."
msgstr "상위 메뉴 항목 링크 옆에 새 링크를 작성하고 이를 단추로 사용합니다."

msgid "Supersubs"
msgstr "수퍼 서브"

msgid "<strong>Supersubs</strong> makes it possible to define custom widths for your menus."
msgstr "<strong>수퍼 서브</strong>는 사용자 메뉴의 사용자 정의 너비를 정의할 수 있게 해줍니다."

msgid "Enable Supersubs for this menu."
msgstr "이 메뉴의 수퍼 서브를 사용으로 설정합니다."

msgid "Minimum width for sub-menus, in <strong>em</strong> units."
msgstr "하위 메뉴의 최소 너비(<strong>em</strong> 단위)."

msgid "Minimum width"
msgstr "최소 너비"

msgid "Maximum width for sub-menus, in <strong>em</strong> units."
msgstr "하위 메뉴의 최대 너비(<strong>em</strong> 단위)."

msgid "Maximum width"
msgstr "최대 너비"

msgid "Please refer to the Superfish module documentation for how you should setup multi-column sub-menus."
msgstr "여러 열 하위 메뉴를 설정하는 방법에 대해서는 Superfish 모듈 문서를 참조하십시오."

msgid "Multi-column sub-menus"
msgstr "여러 열 하위 메뉴"

msgid "Enable multi-column sub-menus."
msgstr "여러 열 하위 메뉴를 사용합니다."

msgid "The depth of the first instance of multi-column sub-menus."
msgstr "여러 열 하위 메뉴의 첫 번째 인스턴스의 깊이입니다."

msgid "Start from depth"
msgstr "깊이에서 시작"

msgid "The amount of sub-menu levels that will be included in the multi-column sub-menu."
msgstr "여러 열 하위 메뉴에 포함될 하위 메뉴 레벨의 양입니다."

msgid "Levels"
msgstr "레벨"

msgid "Advanced settings"
msgstr "고급 설정"

msgid "The speed of the animation either in <strong>milliseconds</strong> or pre-defined values (<strong>slow, normal, fast</strong>)."
msgstr "애니메이션의 속도(<strong>밀리초</strong>) 또는 사전 정의된 값(<strong>slow, normal, fast</strong>)."

msgid "Animation speed"
msgstr "애니메이션 속도"

msgid "The delay in <strong>milliseconds</strong> that the mouse can remain outside a sub-menu without it closing."
msgstr "마우스가 닫지 않고 하위 메뉴 외부에 남아 있을 수 있는 지연(<strong>밀리초</strong>)입니다."

msgid "Mouse delay"
msgstr "마우스 지연"

msgid "The amount of sub-menu levels that remain open or are restored using the \".active-trail\" class."
msgstr "열린 상태로 남아 있거나 \".active-trail\" 클래스를 사용하여 복원되는 하위 메뉴 레벨의 양입니다."

msgid "Change this setting <strong>only and only</strong> if you are <strong>totally sure</strong> of what you are doing."
msgstr "수행하고 있는 작업을 <strong>완전히 확신</strong>하는 <strong>경우에만</strong> 이 설정을 변경하십시오."

msgid "Path levels"
msgstr "경로 레벨"

msgid "Hyperlinks"
msgstr "하이퍼링크"

msgid "By enabling this option, only parent menu items with <em>Expanded</em> option enabled will have their submenus appear."
msgstr "이 옵션을 사용으로 설정하면 <em>펼쳐짐</em> 옵션이 사용으로 설정된 상위 메뉴 항목만이 하위 메뉴를 나타나게 합니다."

msgid "Take \"Expanded\" option into effect."
msgstr "\"확장\" 옵션을 적용합니다."

msgid "Add cloned parent links to the top of sub-menus."
msgstr "하위 메뉴의 맨 위에 복제된 상위 링크를 추가합니다."

msgid "Disable hyperlink descriptions (\"title\" attribute)"
msgstr "하이퍼링크 설명(\"title\" 속성) 사용 안함"

msgid "Insert hyperlink descriptions (\"title\" attribute) into hyperlink texts."
msgstr "하이퍼링크 설명(\"title\" 속성)을 하이퍼링크 텍스트에 삽입합니다."

msgid "Add item depth classes to menu items and their hyperlinks."
msgstr "항목 깊이 클래스를 메뉴 항목 및 해당 하이퍼링크에 추가합니다."

msgid "Custom classes"
msgstr "사용자 정의 클래스"

msgid "(Space separated, without dots)"
msgstr "(점 없이 공백으로 구분됨)"

msgid "For the main UL"
msgstr "기본 UL용"

msgid "For the list items"
msgstr "목록 항목용"

msgid "For the hyperlinks"
msgstr "하이퍼링크용"

msgid "Unacceptable value entered for the \"Animation speed\" option."
msgstr "\"애니메이션 속도\" 옵션에 허용되지 않는 값이 입력되었습니다."

msgid "Unacceptable value entered for the \"Mouse delay\" option."
