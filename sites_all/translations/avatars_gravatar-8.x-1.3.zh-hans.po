msgid "Gravatar"
msgstr "Gravatar"

msgid "Adds Gravatar.com avatar generators for Avatar Kit."
msgstr "为 Avatar Kit 添加 Gravatar.com 头像生成器。"

msgid "Avatars"
msgstr "头像"

msgid "Maximum content rating"
msgstr "最高内容评级"

msgid "Gravatar generator"
msgstr "Gravatar 生成器"

msgid "Type"
msgstr "类型"

msgid "Unrestricted"
msgstr "无限制"

msgid "G: suitable for display on all websites with any audience type."
msgstr "G：适合在具有任何受众类型的所有 Web 站点上显示。"

msgid "PG: may contain rude gestures, provocatively dressed individuals, the lesser swear words, or mild violence."
msgstr "PG：可能包含粗鲁的手势、穿戴轻佻的个人、轻度侮辱性言语或轻度暴力。"

msgid "R: may contain such things as harsh profanity, intense violence, nudity, or hard drug use."
msgstr "R：可能包含恶劣的脏话、强烈的暴力、裸露或硬性药物使用行为等。"

msgid "X: may contain hardcore sexual imagery or extremely disturbing violence."
msgstr "X：可能包含硬核性图像或极其令人不适的暴力行为。"

msgid "Maximum rating: @maximum_rating"
msgstr "最高评级：@maximum_rating"

msgid "Universal avatar uploaded to Gravatar.com"
msgstr "上载至 Gravatar.com 的通用头像"

msgid "Identicon"
msgstr "Identicon"

msgid "Monster ID"
msgstr "Monster ID"

msgid "Wavatar"
msgstr "Wavatar"

msgid "8-bit style avatar"
msgstr "8 位样式头像"

msgid "Missing Configuration"
msgstr "缺少配置"

msgid "Type: @type"
msgstr "类型：@type"

msgid "Identicon, MonsterID, Retro, and Wavatar avatar generators."
msgstr "Identicon、MonsterID、Retro 和 Wavatar 头像生成器。"

