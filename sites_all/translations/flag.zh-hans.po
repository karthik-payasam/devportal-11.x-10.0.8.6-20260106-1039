msgstr "创建用户可对实体设置的定制标记。"

msgid "Add flag"
msgstr "添加标志"

msgid "Configure flags for marking content with arbitrary information (such as <em>offensive</em> or <em>bookmarked</em>)."
msgstr "配置标记以通过任何信息（如 <em>offensive</em> 或 <em>bookmarked</em>）来标记内容。"

