msgid "This module manages language icons for multilingual sites:"
msgstr "Этот модуль содержит пиктограммы языков для мультиязычных сайтов:"

msgid "Automatically adds icons to language links."
msgstr "Автоматически добавляет значки в ссылки на языки."

msgid "Provides related theme functions."
msgstr "Предоставляет функции связанной темы."

msgid "For more information, please see <a href=\"@handbook\">the online handbook section</a>."
msgstr "Дополнительная информация приведена в <a href=\"@handbook\">электронном руководстве</a>."

msgid "To enable multilingual support for specific content types go to <a href=\"@configure_content_types\">configure content types</a>."
msgstr "Для разрешения многоязыковой поддержки для особых типов материалов перейдите на <a href=\"@configure_content_types\">конфигурирование типов материалов</a>."

msgid "Language Icons"
msgstr "Значки языков"

msgid "Adds icons to language links."
msgstr "Добавляет иконки в переключатель языка."

msgid "Multilingual"
msgstr "Многоязычность"

msgid "Language icons"
msgstr "Значки языков"

msgid "Configure the Language Icons module."
msgstr "Настройте модуль Значки языков."

msgid "Icons"
msgstr "Иконки"

msgid "Language Icons settings"
msgstr "Параметры значков языков"

msgid "Show the icons on a node"
msgstr "Показывать значки для узла"

msgid "Show the icons on the language switcher block"
msgstr "Показывать значки для блока переключения языков"

msgid "Add language icons"
msgstr "Добавить языковые иконки"

msgid "Link types to add language icons."
msgstr "Тип ссылки для добавления языковых иконок."

msgid "Node links"
msgstr "Ссылки материала"

msgid "Language switcher block"
msgstr "Блок переключения языка"

msgid "These options are currently disabled due to <a href=\":issue_url\">a bug</a> that cannot currently be resolved. They may be reintroduced at a later stage."
msgstr "В настоящее время эти параметры выключены вследствие <a href=\":issue_url\">неполадки</a>, которую не удалось устранить. Они могут быть активированы позднее."

msgid "Icon placement"
msgstr "Размещение иконки"

msgid "Before link"
msgstr "Перед ссылкой"

msgid "After link"
msgstr "После ссылки"

msgid "Replace link"
msgstr "Заменить ссылку"

msgid "Where to display the icon, relative to the link title."
msgstr "Где нужно отображать иконку, относительно текста ссылки."

msgid "Icons file path"
msgstr "Путь к файлу иконки"

msgid "Path for language icons, relative to Drupal installation. \"*\" is a placeholder for language code."
msgstr "Путь для языковых иконок, относительно установки Drupal. \"*\" является заполнителем для кода языка."

msgid "Image size"
msgstr "Размер изображения"

msgid "Image size for language icons, in the form \"width x height\"."
msgstr "Размер пиктограмм языков в формате \"ширина x высота\"."

