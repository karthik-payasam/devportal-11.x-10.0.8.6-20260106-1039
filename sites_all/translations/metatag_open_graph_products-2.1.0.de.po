msgid "About"
msgstr "Produktinfo"

msgid "Provides additional Open Graph Protocol meta tags for describing products."
msgstr "Stellt zusätzliche Open Graph Protocol-Metatags zum Beschreiben von Produkten bereit."

msgid "Metatag: Open Graph Products"
msgstr "Metatag: Open Graph-Produkte"

msgid "SEO"
msgstr "SEO"

msgid "Open Graph Product: Price availability"
msgstr "Open Graph Product: Preisverfügbarkeit"

msgid "Open Graph Product: Product condition"
msgstr "Open Graph Product: Produktzustand"

msgid "Open Graph Product: Price amount"
msgstr "Open Graph Product: Price amount"

msgid "Open Graph Product: Price currency"
msgstr "Open Graph Product: Price currency"

msgid "Open Graph Product: Retailer Item ID"
msgstr "Open Graph Product: Artikel-ID des Einzelhändlers"

msgid "Open Graph - Products"
msgstr "Open Graph - Produkte"

msgid "These <a href='https://ogp.me/'>Open Graph meta tags</a> are for describing products.<br><br>The Facebook <a href='https://developers.facebook.com/tools/debug/'>Sharing Debugger</a> lets you preview how your content will look when it's shared to Facebook and debug any issues with your Open Graph tags."
msgstr "Diese <a href='https://ogp.me/'>Open Graph-Meta-Tags</a> dienen zur Beschreibung von Produkten.<br><br>Mit dem Facebook <a href='https://developers.facebook.com/tools/debug/'>Sharing Debugger</a> können Sie eine Vorschau Ihres Inhalts auf Facebook ansehen und Probleme mit Ihren Open Graph-Tags beheben."

msgid "Product availability"
msgstr "Produktverfügbarkeit"

msgid "The availability of the product."
msgstr "Die Verfügbarkeit des Produkts."

msgid "Product condition"
msgstr "Produktzustand"

msgid "The condition of the product."
msgstr "Der Zustand des Produkts."

msgid "Product price amount"
msgstr "Product price amount"

msgid "The price amount of the product."
msgstr "Der Preisbetrag des Produkts."

msgid "Product price currency"
msgstr "Product price currency"

msgid "The price currency of the product."
msgstr "Die Preiswährung des Produkts."

msgid "Retailer Item ID"
msgstr "Artikel-ID des Einzelhändlers"

msgid "The ID of the product as provided by the retailer."
msgstr "Die ID des Produkts, wie vom Einzelhändler angegeben."

