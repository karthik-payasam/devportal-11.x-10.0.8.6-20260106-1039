msgid "You cannot delete your account because you own more than 1 organization."
msgstr "複数の組織を所有しているため、アカウントは削除できません。"

msgid ""
"You are the owner of multiple consumer organizations.\n"
"                        You can delete your account only when you are the owner of a single organization.\n"
"                        Please transfer the ownership of, or delete, the other organizations before you delete your account."
msgstr ""
"あなたは複数のコンシューマー組織の所有者です。\n"
"                        自分のアカウントを削除できるのは、1 つの組織の所有者である場合のみです。\n"
"                        アカウントを削除する前に、他の組織の所有権を移転するか、組織を削除してください。"

msgid "Cancel"
msgstr "キャンセル"

msgid "Are you sure you want to delete your account? This action cannot be undone. This action will also remove the organization you own. This permanently removes access to the organization, and all of its applications and subscriptions, for all members of the organization. Please note that once an organization has been deleted, it cannot be reactivated. You might want to consider changing ownership of your Developer organizations, before deleting your account."
msgstr "自分のアカウントを削除しますか? この処理を元に戻すことはできません。このアクションにより、所有する組織も削除されます。これにより、組織およびそのすべてのアプリケーションとサブスクリプションへのアクセスが組織のすべてのメンバーについて完全に削除されます。組織を一度削除すると、再アクティブ化できないことに注意してください。アカウントを削除する前に開発者組織の所有権を変更することも検討してください。"

msgid "Are you sure you want to delete your account? This action cannot be undone."
msgstr "自分のアカウントを削除しますか? この処理を元に戻すことはできません。"

msgid "Delete"
msgstr "削除"

msgid "Are you sure you want to delete your account?"
msgstr "自分のアカウントを削除しますか?"

msgid "Organization successfully deleted."
msgstr "組織が正常に削除されました。"

msgid "Error deleting organization (%org_url). Please contact your system administrator for assistance."
msgstr "組織 (%org_url) の削除中にエラーが発生しました。システム管理者にお問い合わせください。"

msgid "Account successfully deleted."
msgstr "アカウントが正常に削除されました。"

msgid "Error deleting user. Please contact your system administrator for assistance."
msgstr "ユーザーの削除中にエラーが発生しました。システム管理者にお問い合わせください。"

msgid "Organization successfully deleted from ApicUserDeleteForm."
msgstr "組織が ApicUserDeleteForm から正常に削除されました。"

msgid "No org to delete as part of user deletion"
msgstr "ユーザー削除の一部として削除する組織はありません"

msgid "Deleting %org_url as part of user deletion"
msgstr "ユーザー削除の一環として %org_url を削除しています"

msgid "Account deleted successfully from ApicUserDeleteForm."
msgstr "アカウントが ApicUserDeleteForm から正常に削除されました。"

msgid "Attempt to load ApicUserDeleteForm while owning more than 1 org."
msgstr "複数の組織を所有している間に ApicUserDeleteForm をロードしようとしました。"

msgid "Error deleting account from ApicUserDeleteForm."
msgstr "ApicUserDeleteForm からアカウントを削除中にエラーが発生しました。"

msgid "To complete your invitation, sign in to an existing account or sign up to create a new account."
msgstr "招待を完了するには、既存のアカウントにサインインするか、サインアップして新規アカウントを作成してください。"

msgid "Consumer organization"
msgstr "コンシューマー組織"

msgid "You are signing in with an existing account but have been invited to create a new consumer organization, please provide a name for that organization."
msgstr "既存のアカウントを使用してサインインしようとしていますが、新規コンシューマー組織を作成するよう招待されています。その組織の名前を指定してください。"

msgid "Sign in to an existing account or create a new account to subscribe to this Product."
msgstr "この製品をサブスクライブするには、既存のアカウントにサインインするか新規アカウントを作成してください。"

msgid "Sign in with @registryName"
msgstr "@registryName を使用してサインインしてください"

msgid "Sign in"
msgstr "サインイン"

msgid "Sign in using @ur"
msgstr "@ur を使用してサインイン"

msgid "or"
msgstr "または"

msgid "Continue with"
msgstr "次を使用して続行"

msgid "Unable to sign in. This may be because the credentials provided for authentication are invalid or the user has not been activated. Please check that the user is active, then repeat the request with valid credentials. Please note that repeated attempts with incorrect credentials can lock the user account."
msgstr "サインインできません。認証に対して指定された資格情報が無効であるか、ユーザーがアクティブになっていないことが原因と考えられます。ユーザーがアクティブであることを確認してから、有効な資格情報を使用して要求を繰り返してください。誤った資格情報を使用して試行を繰り返すと、ユーザー・アカウントがロックされる場合があるので注意してください。"

msgid "<a href=\":password\">Forgot your password? Click here to reset it.</a>"
msgstr "<a href=\":password\">パスワードをお忘れですか? ここをクリックして、再設定してください。</a>"

msgid "Unauthorized"
msgstr "許可されていません"

