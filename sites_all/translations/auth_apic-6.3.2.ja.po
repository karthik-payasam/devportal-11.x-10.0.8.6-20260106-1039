msgstr "招待ユーザーでサインインする場合、管理ユーザーは許可されません。"

msgid "admin login, using core validation for login"
msgstr "管理者ログイン (ログインにコア検証を使用)"

msgid "Failed to login. Unable to determine registry to use from login form."
msgstr "ログインに失敗しました。ログイン・フォームから使用対象のレジストリーを判別できません。"

msgid "Login attempt for %user which failed in validateApicAuthentication."
msgstr "validateApicAuthentication で %user のログイン試行が失敗しました。"

msgid "Username or email address"
msgstr "ユーザー名または E メール・アドレス"

msgid "Use @ur"
msgstr "@ur を使用"

