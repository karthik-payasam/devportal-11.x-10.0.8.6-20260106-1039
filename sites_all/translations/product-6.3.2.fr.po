msgid "All Product entries deleted."
msgstr "Toutes les entrées de produit supprimées."

msgid "Drush @func No Product provided"
msgstr "Aucun produit fourni pour la commande Drush @func"

msgid "Drush DeleteProduct deleted Product @prod"
msgstr "La commande Drush DeleteProduct a supprimé le produit @prod"

msgid "Drush DeleteProduct could not find Product @prod"
msgstr "La commande Drush DeleteProduct n'est pas parvenue à trouver le produit @prod"

msgid "Drush DeleteProduct deleted retired API @api"
msgstr "La commande Drush DeleteProduct a supprimé l'API @api."

msgid "Drush DeleteProduct No Product provided."
msgstr "Aucun produit fourni pour la commande Drush DeleteProduct."

msgid "Drush product supersede : found a product in a strange lifecycle state '@state'. Expected 'published' or 'deprecated'."
msgstr "Commande Drush de substitution de produit : un produit a été trouvé dans un état de cycle de vie étrange : '@state'. Etat attendu : 'publié' ou 'déprécié'."

msgid "Drush SupersedeProduct deleted retired API @api"
msgstr "La commande Drush SupersedeProduct a supprimé l'API @api."

msgid "Drush product supersede : incorrect number of applications with url '@url' found. Should be 1 but was @count."
msgstr "Commande Drush de substitution de produit : nombre incorrect d'applications avec l'URL '@url' trouvé. Nombre attendu : 1 et non @count."

msgid "Drush product supersede : incorrect number of products found. Should be 2 but was @count."
msgstr "Commande Drush de substitution de produit : nombre incorrect de produits trouvé. Nombre attendu : 2 et non @count."

msgid "Drush product supersede : no content provided."
msgstr "Commande Drush de substitution de produit : aucun contenu fourni."

msgid "Drush ReplaceProduct deleted retired API @api"
msgstr "La commande Drush ReplaceProduct a supprimé l'API @api retirée."

msgid "Drush product replace : found a product in a strange lifecycle state '@state'. Expected 'published', 'deprecated' or 'retired'."
msgstr "Commande Drush de remplacement de produit : un produit a été trouvé dans un état de cycle de vie étrange : '@state'. Etat attendu : 'publié', 'obsolète' ou 'retiré'."

msgid "Drush product replace : incorrect number of products found. Should be 2 but was @count."
msgstr "Commande Drush de remplacement de produit : nombre incorrect de produits trouvé. Nombre attendu : 2 et non @count."

msgid "Invalid plan found with empty plan name. Contact your system administrator"
msgstr "Plan non valide détecté avec un nom de plan vide. Contactez votre administrateur système"

