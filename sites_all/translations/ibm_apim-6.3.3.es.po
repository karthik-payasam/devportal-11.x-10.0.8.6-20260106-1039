msgid "IBM API Developer Portal Development Settings"
msgstr "Valores de desarrollo del Portal del desarrollador de IBM API"

msgid "Debug"
msgstr "Depurar"

msgid "Enable method entry / exit trace"
msgstr "Habilitar rastreo de entrada/salida de método"

msgid "WARNING: Not to be used on production servers. It greatly increases the amount of debug information in the logs."
msgstr "AVISO: No debe utilizarse en servidores de producción. Aumenta en gran medida la cantidad de información de depuración en los registros."

msgid "Enable API Manager REST interface debug"
msgstr "Habilitar depuración de interfaz REST del Gestor de API"

msgid "Enable webhook payload debug"
msgstr "Habilitar depuración de carga útil de webhook"

msgid "WARNING: Not to be used on production servers. It stores all webhook payloads in the database for debug. This does not scale well!"
msgstr "AVISO: No debe utilizarse en servidores de producción. Almacena todas las cargas útiles de webhook en la base de datos para depuración. ¡No es adecuado para el escalado!"

msgid "Enable snapshot debug logging"
msgstr "Habilitar registro de depuración de instantáneas"

msgid "WARNING: Not to be used on production servers. It generates a lot of logging when snapshots are processed. This does not scale well!"
msgstr "AVISO: No debe utilizarse en servidores de producción. Genera muchos registros cuando se procesan las instantáneas. ¡No es adecuado para el escalado!"

msgid "Enable audit log backtrace member in CADF request"
msgstr "Habilitar miembro de rastreo de origen de registro de auditoría en solicitud CADF"

msgid "WARNING: Not to be used on production servers. Adds unsupported backtrace member to CADF output."
msgstr "AVISO: No debe utilizarse en servidores de producción. Añade un miembro de rastreo de origen no soportado a la salida CADF."

msgid "Use this debug audit endpoint to send audit data to, instead of apim."
msgstr "Utilice este punto final de auditoría de depuración para enviar datos de auditoría a, en lugar de apim."

msgid "WARNING: Should not to be used on production servers."
msgstr "AVISO: No debe utilizarse en servidores de producción."

msgid "Log level for audit"
msgstr "Nivel de registro para auditoría"

msgid "WARNING: debug should not to be used on production servers."
msgstr "AVISO: la depuración no debe utilizarse en servidores de producción."

msgid "Enable node access control debug"
msgstr "Habilitar depuración de control de accesos de nodo"

msgid "Insecure mode (disable Consumer API certificate validation)"
msgstr "Modalidad no segura (inhabilitar validación de certificado de API de consumidor)"

msgid "WARNING: Not to be used on production servers. It disables certificate validation when calling the APIM Consumer API, this leaves you vulnerable to 'Man in the middle' attacks."
msgstr "AVISO: No debe utilizarse en servidores de producción. Inhabilita la validación de certificado cuando llama a la API de consumidor de APIM, esto le hace vulnerable a 'Ataques de intermediario'."

msgid "These development options are not available when running in IBM Cloud."
msgstr "Estas opciones de desarrollo no están disponibles al ejecutar en IBM Cloud."

msgid "WARNING: Account only has a member role for the org \"@orgName\", some features of the Developer Portal maybe restricted. Contact your Consumer Org owner to be granted permissions such as Administrator, Developer or Viewer."
msgstr "AVISO: La cuenta solo tiene un rol de miembro para la organización \"@orgName\",, por lo que algunas funciones del Portal del desarrollador pueden estar restringidas. Póngase en contacto con el propietario de su organización de consumidores para que le conceda permisos como administrador, desarrollador o visor."

msgid "There are issues with your account:"
msgstr "Hay problemas con su cuenta:"

msgid "Account Status Messages"
msgstr "Mensajes de estado de la cuenta"

msgid "Session expired. Please sign in again."
msgstr "La sesión ha caducado. Vuelva a iniciar la sesión."

msgid "FATAL: Initial portal configuration has not been received from the API Manager. Contact your system administrator before continuing further. This will prevent almost all portal functionality from working including user login."
msgstr "MUY GRAVE: la configuración inicial del portal no se ha recibido del Gestor de API. Póngase en contacto con el administrador del sistema antes de continuar. Esto impedirá el funcionamiento de casi todas las funciones del portal, incluido el inicio de sesión de usuario."

msgid "FATAL: No user registries defined. Contact your system administrator before continuing. This will prevent almost all portal functionality from working including user login."
msgstr "MUY GRAVE: No se han definido registros de usuarios. Póngase en contacto con el administrador del sistema antes de continuar. Esto impedirá el funcionamiento de casi todas las funciones del portal, incluido el inicio de sesión de usuario."

msgid "FATAL: Missing provider organization ID. Contact your system administrator before continuing further. This will prevent almost all portal functionality from working including user login."
msgstr "MUY GRAVE: Falta el ID de organización de proveedores. Póngase en contacto con el administrador del sistema antes de continuar. Esto impedirá el funcionamiento de casi todas las funciones del portal, incluido el inicio de sesión de usuario."

msgid "FATAL: Missing catalog ID. Contact your system administrator before continuing further. This will prevent almost all portal functionality from working including user login."
msgstr "MUY GRAVE: Falta el ID de catálogo. Póngase en contacto con el administrador del sistema antes de continuar. Esto impedirá el funcionamiento de casi todas las funciones del portal, incluido el inicio de sesión de usuario."

msgid "FATAL: Site credentials are missing. Contact your system administrator before continuing further. This will prevent almost all portal functionality from working including user login."
msgstr "MUY GRAVE: Faltan las credenciales del sitio. Póngase en contacto con el administrador del sistema antes de continuar. Esto impedirá el funcionamiento de casi todas las funciones del portal, incluido el inicio de sesión de usuario."

msgid "FATAL: Essential required information has not been received from the API Manager. Contact your system administrator before continuing further."
msgstr "MUY GRAVE: la información necesaria esencial no se ha recibido del Gestor de API. Póngase en contacto con el administrador del sistema antes de continuar."

