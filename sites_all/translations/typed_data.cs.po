msgid "Typed Data"
msgstr "Typed Data"

msgid "Extends the core Typed Data API with new APIs and features."
msgstr "Rozšiřuje základní rozhraní Typed Data API o nová rozhraní API a funkce. "

msgid "Missing arguments for filter %filter_id"
msgstr "Chybějící argumenty pro filtr %filter_id"

msgid "Entity machine names:"
msgstr "Názvy počítačů entit:"

msgid "Global context variables:"
msgstr "Globální kontextové proměnné:"

msgid "Available TypedData data types:"
msgstr "Dostupné datové typy TypedData:"

msgid "Text"
msgstr "Text"

msgid "The count filter counts the number of characters in the input string."
msgstr "Filtr počtu počítá počet znaků ve vstupním řetězci."

msgid "Applies a default value if there is no value."
msgstr "Použije výchozí hodnotu, není-li poskytnuta žádná hodnota."

msgid "Provides the URL of an entity."
msgstr "Poskytuje adresu URL entity."

msgid "Unkown date format %format given."
msgstr "Byl poskytnut neznámý formát data %format. "

msgid "If a custom date format is supplied, 'custom' must be passed as date format."
msgstr "Je-li poskytnut vlastní formát data, je nutné jako formát data zadat 'custom'. "

msgid "If 'custom' is given as date type, a custom date formatting string must be provided; e.g., 'Y-m-d H:i:s'."
msgstr "Je-li jako typ data zadán 'custom', musí být zadán vlastní formátovací řetězec data; např. 'd-m-Y H:i:s'."

msgid "Formats a date, using a configured date type or a custom date format string."
msgstr "Formátuje datum pomocí nakonfigurovaného typu data nebo vlastního formátovacího řetězce data. "

msgid "The format_text filter passes the text through the given filter."
msgstr "Filtr format_text předává text prostřednictvím daného filtru."

msgid "Converts a string to lower case."
msgstr "Převede řetězec na malá písmena."

msgid "The replace filter replaces all occurrences of the text given in the first argument with the text given in the second argument."
msgstr "Nahrazující filtr nahradí všechny výskyty textu uvedeného v prvním argumentu textem uvedeným ve druhém argumentu."

msgid "The striptags filter strips SGML/XML tags and replace adjacent whitespace by one space."
msgstr "Filtr striptags odstraní značky SGML/XML a sousedící prázdné znaky nahradí jednou mezerou."

msgid "The trim filter removes whitespace from both the beginning and the end of an input string."
msgstr "Filtr oříznutí odebírá mezery jak od začátku, tak od konce vstupního řetězce."

msgid "The upper filter converts the entire input string to upper case."
msgstr "Velký filtr převede celý vstupní řetězec na velká písmena."

msgid "No widget exists for this data type."
msgstr "Pro tento datový typ neexistuje žádný modul widget."

msgid "The field %field_label consists of the data type %data_type which cannot be input or a widget for this data type is not implemented yet."
msgstr "Pole %field_label se skládá z datového typu %data_type, který nemůže být vstupem, nebo modul widget pro tento datový typ není dosud implementován."

msgid "Label"
msgstr "Popisek"

msgid "Broken widget"
msgstr "Nefunkční modul widget"

msgid "A widget for everything that cannot be input or if a widget for a data type is not yet implemented."
msgstr "Modul widget pro všechno, co nemůže být vstupem, nebo pokud modul widget pro určitý datový typ ještě nebyl implementován."

msgid "currently in daylight saving mode"
msgstr "v současné době v režimu letního času"

msgid "not in daylight saving mode"
msgstr "není v režimu letního času"

msgid "Timezone : %timezone %daylight_saving."
msgstr "Časové pásmo: %timezone %daylight_saving."

msgid "Start date"
msgstr "Datum začátku"

msgid "End date"
msgstr "Datum konce"

msgid "Description"
msgstr "Popis"

msgid "The @title end date cannot be before the start date"
msgstr "Koncové datum @title nemůže být dřívější než datum zahájení."

msgid "Datetime Range"
msgstr "Rozsah data a času"

msgid "A datetime range input widget, containing two datetime values, for the start and end of the range."
msgstr "Vstupní modul widget rozsahu data a času obsahující dvě hodnoty data a času, pro začátek a konec rozsahu."

msgid "Datetime"
msgstr "Datum a čas"

msgid "A datetime input widget."
msgstr "Vstupní modul widget data a času."

msgid "Empty option label"
msgstr "Prázdný popisek volby"

msgid "Allows overriding the label of the empty option"
msgstr "Umožňuje přepsat popisek prázdné volby"

msgid "Select"
msgstr "Vybrat"

msgid "A simple select box."
msgstr "Jednoduché výběrové pole."

msgid "Placeholder value"
msgstr "Hodnota zástupného symbolu"

msgid "Input field size"
msgstr "Velikost vstupního pole"

msgid "Maximum text length"
msgstr "Maximální délka textu"

msgid "Text input"
msgstr "Textový vstup"

msgid "A simple, one-line text input widget."
msgstr "Jednoduchý, jednořádkový textový vstupní modul widget."

msgid "Number of rows in the text box"
msgstr "Počet řádků v textovém poli"

msgid "Number of columns in the text box"
msgstr "Počet sloupců v textovém poli"

msgid "Controls whether the text area is resizable"
msgstr "Řídí, zda je oblast textu neměnné velikosti"

msgid "Allowed values are \"none\", \"vertical\", \"horizontal\", or \"both\"."
msgstr "Povolené hodnoty jsou \"none\", \"vertical\", \"horizontal\" nebo \"both\"."

msgid "Textarea"
msgstr "Textová oblast"

msgid "A multi-line text input widget."
msgstr "Víceřádkový textový vstupní modul widget."

