msgid "Finished @num elements and @num_translations translations created successfully."
msgstr "La création des traductions @num_translations et des éléments @num terminés a abouti."

msgid "Finished @num elements created successfully."
msgstr "La création des éléments @num a abouti."

msgid "Finished with an error."
msgstr "Terminée avec une erreur"

msgid "Generate @label"
msgstr "Générer @label"

msgid "Generate"
msgstr "Générer"

msgid "Generate realistic items (content, users, menus, etc) to assist your site development and testing."
msgstr "Générer des éléments réalistes (contenu, utilisateurs, menus, etc) pour faciliter le test et le développement de site."

msgid "Devel generate"
msgstr "Génération Devel"

msgid "Devel Generate"
msgstr "Génération Devel"

msgid "Generate test users, nodes, menus, taxonomy terms..."
msgstr "Générer des utilisateurs, des noeuds, des menus, des termes de taxonomie de test..."

msgid "Development"
msgstr "Développement"

msgid "Administer devel_generate"
msgstr "Administrer devel_generate"

msgid "Language"
msgstr "Langue"

msgid "Select the primary language(s) for @items"
msgstr "Sélectionner la langue ou les langues principales pour @items"

msgid "Disabled - requires Language module"
msgstr "Désactivé - Module de langue requis"

msgid "Select the language(s) for translated @items"
msgstr "Sélectionner la langue ou les langues pour les éléments @items traduits"

msgid "Translated @items will be created for each language selected."
msgstr "Les éléments @items traduits seront créés pour chaque langue sélectionnée."

msgid "Disabled - requires Content Translation module."
msgstr "Désactivé - Module de traduction de contenu requis."

msgid "@permission"
msgstr "@permission"

msgid "Failed to generate elements due to \"%error\"."
msgstr "Echec de la génération d'éléments en raison de \"%error\"."

msgid "You do not have any content types that can be generated. <a href=\":create-type\">Go create a new content type</a>"
msgstr "Aucun type de contenu ne peut être généré. <a href=\":create-type\">Créez un nouveau type de contenu.</a>"

msgid "Hidden"
msgstr "Masqué"

msgid "Closed"
msgstr "Clôturé"

msgid "Open"
msgstr "Ouvrir"

msgid "No comment fields"
msgstr "Aucune zone de commentaire"

msgid "Content type"
msgstr "Type de contenu"

msgid "Comments"
msgstr "Commentaires"

msgid "<strong>Delete all content</strong> in these content types before generating new content."
msgstr "<strong>Supprimer tout le contenu</strong> dans ces types de contenu avant de générer un nouveau contenu."

msgid "How many nodes would you like to generate?"
msgstr "Combien de noeuds voulez-vous générer ?"

msgid "Now"
msgstr "Maintenant"

msgid "ago"
msgstr "en arrière"

msgid "How far back in time should the nodes be dated?"
msgstr "À partir de quand doit-on dater les noeuds ?"

msgid "Node creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "Les dates de création des noeuds seront réparties aléatoirement entre la date de départ choisie et maintenant."

msgid "Maximum number of comments per node."
msgstr "Nombre maximal de commentaires par noeud."

msgid "You must also enable comments for the content types you are generating. Note that some nodes will randomly receive zero comments. Some will receive the max."
msgstr "Vous devez aussi activer les commentaires pour les types de contenu que vous générez. Notez que certains noeuds ne recevront aléatoirement aucun commentaire. D'autres recevront le maximum."

msgid "Maximum number of words in titles"
msgstr "Nombre maximal de mots dans les titres"

msgid "Fields to leave empty"
msgstr "Zones à laisser vides"

msgid "Enter the field names as a comma-separated list. These will be skipped and have a default value in the generated content."
msgstr "Entrez les noms de zone sous forme de liste dont les éléments sont séparés par une virgule. Ces zones seront ignorées et auront une valeur par défaut dans le contenu généré."

msgid "Base fields to populate"
msgstr "Zones de base à remplir"

msgid "Enter the field names as a comma-separated list. These will be populated."
msgstr "Entrez les noms de zone sous forme de liste dont les éléments sont séparés par une virgule. Ces zones seront renseignées."

msgid "Prefix the title with the content type label."
msgstr "Ajouter le libellé du type de contenu avant le titre."

msgid "This will not count against the maximum number of title words specified above."
msgstr "Cette option ne comptera pas le nombre maximal de mots de titre spécifiés ci-dessus."

msgid "Requires path.module"
msgstr "Requiert path.module"

msgid "Add an url alias for each node."
msgstr "Ajouter un alias d'URL à chaque noeud"

msgid "Add statistics for each node (node_counter table)."
msgstr "Ajouter des statistiques pour chaque noeud (table node_counter)."

msgid "User ID"
msgstr "ID utilisateur"

msgid "Name"
msgstr "Nom"

msgid "Role(s)"
msgstr "Rôle(s)"

msgid "Users"
msgstr "Utilisateurs"

msgid "Select users for randomly assigning as authors of the generated content. Leave all unchecked to use a random selection of up to 50 users."
msgstr "Sélectionnez des utilisateurs pour une affectation aléatoire en tant qu'auteurs du contenu généré. Ne sélectionnez aucune option pour utiliser une sélection aléatoire incluant jusqu'à 50 utilisateurs."

msgid "Please select at least one content type"
msgstr "Sélectionnez au moins un type de contenu"

msgid "Generating Content"
msgstr "Génération du contenu"

msgid "Deleted %count nodes."
msgstr "%count noeuds supprimés."

msgid "Completed @feedback nodes (@rate nodes/min)"
msgstr "@feedback noeuds terminés (@rate noeuds/mn)"

msgid "No content types available"
msgstr "Aucun type de contenu disponible"

msgid "To delete content, please provide the content types (--bundles)"
msgstr "Pour supprimer le contenu, indiquez les types de contenu (--bundles)"

msgid "One or more content types have been entered that don't exist on this site"
msgstr "Un ou plusieurs types de contenu qui n'existent pas sur ce site ont été entrés"

msgid "Created 1 node"
msgid_plural "Created @count nodes"
msgstr[0] "Un noeud créé"
msgstr[1] "@count noeuds créés"

msgid "Created 1 node translation"
msgid_plural "Created @count node translations"
msgstr[0] "Une traduction de noeud créée"
msgstr[1] "@count traductions de noeud créées"

msgid "content"
msgstr "contenu"

msgid "Generate a given number of content. Optionally delete current content."
msgstr "Générez un nombre donné de contenus. Si vous le souhaitez, supprimez le contenu en cours."

msgid "You do not have any media types that can be generated. <a href=\":url\">Go create a new media type</a>"
msgstr "Vous ne disposez d'aucun type de média pouvant être généré. <a href=\":url\">Créez un nouveau type de média</a>"

msgid "Media type"
msgstr "Type de support"

msgid "<strong>Delete all media</strong> in these types before generating new media."
msgstr "<strong>Supprimez tous les médias</strong> de ces types avant de générer un nouveau média."

msgid "How many media items would you like to generate?"
msgstr "Combien de médias souhaitez-vous générer ?"

msgid "How far back in time should the media be dated?"
msgstr "Quelle doit être l'ancienneté du média ?"

msgid "Media creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "Les dates de création de média seront distribués de manière aléatoire entre la date de départ choisie et maintenant."

msgid "Maximum number of words in names"
msgstr "Nombre maximal de mots dans les noms"

msgid "Set language on media"
msgstr "Définir la langue sur le média"

msgid "Requires locale.module"
msgstr "Requiert locale.module"

msgid "Please select at least one media type"
msgstr "Sélectionner au moins un type de média"

msgid "Generating media items"
msgstr "Génération d'éléments de média"

msgid "Deleted %count media items."
msgstr "Eléments de support de montage %csupprimés."

msgid "Completed !feedback media items (!rate media/min)"
msgstr "Eléments de média !feedback terminés (!rate média/min)"

msgid "No media types available"
msgstr "Aucun type de média disponible"

msgid "media"
msgstr "support"

msgid "Generate a given number of media entities."
msgstr "Générer le nombre indiqué d'entités de média."

msgid "Create new menu(s)"
msgstr "Créer un ou des menus"

msgid "Generate links for these menus"
msgstr "Générer des liens pour ces menus"

msgid "Number of new menus to create"
msgstr "Nombre de menus à créer"

msgid "Number of links to generate"
msgstr "Nombre de liens à générer"

msgid "Maximum length for menu titles and menu links"
msgstr "Longueur maximale des titres de menu et des liens de menu"

msgid "Text will be generated at random lengths up to this value. Enter a number between 2 and 128."
msgstr "Le texte sera généré avec une longueur aléatoire dont le maximum correspond à cette valeur. Entrez un nombre compris entre 2 et 128."

msgid "Types of links to generate"
msgstr "Types de lien à générer"

msgid "Nodes"
msgstr "Noeuds"

msgid "Front page"
msgstr "Page d'accueil"

msgid "External"
msgstr "Externe"

msgid "Maximum link depth"
msgstr "Profondeur maximale des liens"

msgid "Maximum menu width"
msgstr "Largeur maximale des menus"

msgid "Limit the width of the generated menu's first level of links to a certain number of items."
msgstr "Limitez la largeur des liens de premier niveau du menu généré à un certain nombre d'éléments."

msgid "Delete existing custom generated menus and menu links before generating new ones."
msgstr "Supprimez les liens de menu et les menus personnalisés générés existants avant d'en générer de nouveaux."

msgid "Deleted @menus_deleted menu(s) and @links_deleted other link(s)."
msgstr "Menu(s) @menus_deleted et autre(s) @links_deleted supprimé(s)."

msgid "Description of @name"
msgstr "Description de @name"

msgid "Description of @title."
msgstr "Description de @title."

msgid "Invalid number of menus"
msgstr "Nombre non valide de menus"

msgid "Invalid number of links"
msgstr "Nombre non valide de liens"

msgid "Invalid maximum link depth. Use a value between 1 and 9"
msgstr "Profondeur maximale des liens non valide. Utilisez une valeur comprise entre 1 et 9."

msgid "Invalid maximum menu width. Use a positive numeric value."
msgstr "Profondeur maximale des menus non valide. Utilisez une valeur numérique positive."

msgid "Created the following 1 new menu: @menus"
msgid_plural "Created the following @count new menus: @menus"
msgstr[0] "Le nouveau menu suivant a été créé : @menus"
msgstr[1] "Les @count nouveaux menus suivants ont été créés : @menus"

msgid "menus"
msgstr "menus"

msgid "Generate a given number of menus and menu links. Optionally delete current menus."
msgstr "Générez un nombre donné de menus et de liens de menu. Si vous le souhaitez, supprimez les menus actuels."

msgid "Vocabularies"
msgstr "Vocabulaires"

msgid "Restrict terms to these vocabularies."
msgstr "Restreignez les termes à ces vocabulaires."

msgid "Number of terms"
msgstr "Nombre de termes"

msgid "Maximum number of characters in term names"
msgstr "Nombre maximal de caractères dans les noms de terme"

msgid "Minimum depth for new terms in the vocabulary hierarchy"
msgstr "Profondeur minimale des nouveaux termes dans la hiérarchie du vocabulaire"

msgid "Enter a value from 1 to 20."
msgstr "Entrez une valeur comprise entre 1 et 20."

msgid "Maximum depth for new terms in the vocabulary hierarchy"
msgstr "Profondeur maximale des nouveaux termes dans la hiérarchie du vocabulaire"

msgid "Delete existing terms in specified vocabularies before generating new terms."
msgstr "Supprimez les termes existants dans les vocabulaires spécifiés avant de générer de nouveaux termes."

msgid "In vocabulary @vlabel: @termlist"
msgstr "Dans le vocabulaire @vlabel : @termlist"

msgid "In vocabulary @vlabel: No terms created"
msgstr "Dans le vocabulaire @vlabel : aucun terme créé"

msgid "Minimum depth changed from @min_depth to 1 because all terms were deleted"
msgstr "La profondeur minimale est passée de @min_depth à 1 car tous les termes ont été supprimés"

msgid "Please provide a vocabulary machine name (--bundles)."
msgstr "Indiquez un nom système du vocabulaire (--bundles)."

msgid "Invalid vocabulary machine name: @name"
msgstr "Nom système du vocabulaire non valide : @name"

msgid "Invalid number of terms: @num"
msgstr "Nombre non valide de termes : @num"

msgid "The depth values must be in the range 1 to 20 and min-depth cannot be larger than max-depth (values given: min-depth @min, max-depth @max)"
msgstr "Les valeurs de profondeur doivent être comprises entre 1 et 20 et la profondeur minimale ne peut pas être supérieure à la valeur maximale (valeurs données : profondeur minimale @min, profondeur maximale @max)"

msgid "Created 1 new term"
msgid_plural "Created @count new terms"
msgstr[0] "Un nouveau terme créé"
msgstr[1] "@count nouveaux termes créés"

msgid "1 new term at level @level (@terms)"
msgid_plural "@count new terms at level @level (@terms)"
msgstr[0] "Un nouveau terme au niveau @level (@terms)"
msgstr[1] "@count nouveaux termes au niveau @level (@terms)"

msgid "Created 1 term translation"
msgid_plural "Created @count term translations"
msgstr[0] "Une traduction de terme créée"
msgstr[1] "@count traductions de terme créées"

msgid "Deleted 1 existing term"
msgid_plural "Deleted @count existing terms"
msgstr[0] "Un terme existant supprimé"
msgstr[1] "@count termes existants supprimés"

msgid "terms"
msgstr "termes"

msgid "Generate a given number of terms. Optionally delete current terms."
msgstr "Générez un nombre donné de termes. Si vous le souhaitez supprimez les termes actuels."

msgid "How many users would you like to generate?"
msgstr "Combien d'utilisateurs voulez-vous générer ?"

msgid "Delete all users (except user id 1) before generating new users."
msgstr "Supprimez tous les utilisateurs (sauf l'ID utilisateur 1) avant de générer de nouveaux utilisateurs."

msgid "Which roles should the users receive?"
msgstr "Quels rôles les utilisateurs doivent-ils avoir ?"

msgid "Users always receive the <em>authenticated user</em> role."
msgstr "Les utilisateurs ont toujours le rôle <em>utilisateur authentifié</em>."

msgid "Password to be set"
msgstr "Mot de passe à définir"

msgid "Leave this field empty if you do not need to set a password"
msgstr "Laissez cette zone vide s'il n'est pas nécessaire de définir un mot de passe"

msgid "How old should user accounts be?"
msgstr "Quel âge doivent avoir les comptes utilisateur ?"

msgid "User ages will be distributed randomly from the current time, back to the selected time."
msgstr "L'ancienneté des utilisateurs sera distribuée aléatoirement entre l'heure choisie et l'heure actuelle."

msgid "@num_users created."
msgstr "@num_users créés."

msgid "1 user deleted"
msgid_plural "@count users deleted."
msgstr[0] "1 utilisateur supprimé"
msgstr[1] "@count utilisateurs supprimés."

msgid "1 user"
msgid_plural "@count users"
msgstr[0] "1 utilisateur"
msgstr[1] "@count utilisateurs"

msgid "users"
msgstr "utilisateurs"

msgid "Generate a given number of users. Optionally delete current users."
msgstr "Générez un nombre défini d'utilisateurs. Si vous le souhaitez, supprimez les utilisateurs actuels."

msgid "Number of vocabularies?"
msgstr "Nombre de vocabulaires ?"

msgid "Maximum number of characters in vocabulary names"
msgstr "Nombre maximal de caractères dans les noms de vocabulaire"

msgid "Delete existing vocabularies before generating new ones."
msgstr "Supprimez les vocabulaires existants avant d'en générer de nouveaux."

msgid "Deleted existing vocabularies."
msgstr "Vocabulaires existants supprimés."

msgid "Created the following new vocabularies: @vocs"
msgstr "Nouveaux vocabulaires suivants créés : @vocs"

msgid "Invalid number of vocabularies: @num."
msgstr "Nombre non valide de vocabulaires : @num."

msgid "vocabularies"
msgstr "vocabulaires"

msgid "Generate a given number of vocabularies. Optionally delete current vocabularies."
msgstr "Générez un nombre donné de vocabulaires. Si vous le souhaitez, supprimez les vocabulaires actuels."

