msgstr "Content Security Policy"

msgid "Provide Content-Security-Policy headers"
msgstr "Fornire intestazioni Content-Security-Policy"

msgid "Configure policy enforcement."
msgstr "Configurare l'applicazione della politica."

msgid "Administer Content Security Policy"
msgstr "Amministra la politica di sicurezza del contenuto"

msgid "Content Security Policy Settings"
msgstr "Impostazioni Content Security Policy"

