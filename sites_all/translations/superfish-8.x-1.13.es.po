msgid "None"
msgstr "Ninguno"

msgid "Vertical"
msgstr "Vertical"

msgid "Horizontal"
msgstr "Horizontal"

msgid "Diagonal"
msgstr "Diagonal"

msgid "About Superfish"
msgstr "Acerca de Superfish"

msgid "<a href=\"@url_module\">Superfish module</a> integrates <a href=\"@url_library\">jQuery Superfish</a> plugin to your Drupal menu blocks. Please refer to the module <a href=\"@url_documentation\">documentation</a> for more information."
msgstr "El <a href=\"@url_module\">Módulo Superfish</a> integra el plugin <a href=\"@url_library\">jQuery Superfish</a> en los bloques de menú de Drupal. Consulte la <a href=\"@url_documentation\">documentación</a> del módulo para obtener información adicional."

msgid "In order to use Superfish, go to the <a href=\"@block\">Block layout</a> page and use any of the \"Place block\" buttons to create a Superfish block."
msgstr "Para utilizar Superfish, vaya a la página <a href=\"@block\">Bloquear diseño</a> y utilice cualquiera de los botones \"Colocar bloque\" para crear un bloque Superfish."

msgid "Superfish library is missing. Please refer to the <a href=\"@documentation\">plugin documentation</a> for how you can fix this issue; Once done, go to the <a href=\"@block\">Block layout</a> page and use any of the \"Place block\" buttons to create a Superfish block."
msgstr "Falta la biblioteca de Superfish. Consulte la <a href=\"@documentation\">documentación del plugin</a> para ver cómo puede solucionar este problema. Una vez hecho esto, vaya a la página <a href=\"@block\">Bloquear diseño</a> y utilice cualquiera de los botones \"Colocar bloque\" para crear un bloque Superfish."

msgid "If there was no Superfish block in the \"Place block\" form, go to the <a href=\"@performance\">Performance</a> page and clear the cache once."
msgstr "Si no había ningún bloque Superfish en el formulario \"Colocar bloque\", vaya a la página <a href=\"@performance\">Rendimiento</a> y borre la memoria caché una vez."

msgid "Superfish library"
msgstr "Biblioteca de Superfish"

msgid "Inaccessible"
msgstr "Inaccesible"

msgid "Cannot access the Superfish library directory; perhaps because its permissions and/or ownership are not set up correctly."
msgstr "No se puede acceder al directorio de biblioteca Superfish; quizás porque sus permisos y/o la propiedad no se han configurado correctamente."

msgid "Unknown version"
msgstr "Versión desconocida"

msgid "Cannot determine the version of your Superfish library."
msgstr "No se puede determinar la versión de la biblioteca Superfish."

msgid "Not supported"
msgstr "No soportado"

msgid "The Superfish library requires an update. You can find the update instructions on :url."
msgstr "La biblioteca de Superfish requiere una actualización. Puede encontrar las instrucciones de actualización en :url."

msgid "Installed; at @location"
msgstr "Instalado en @location"

msgid "Not installed"
msgstr "No instalada"

msgid "Please download the Superfish library from :url."
msgstr "Descargue la biblioteca de Superfish en :url."

msgid "Superfish"
msgstr "Superfish"

msgid "Adds jQuery Superfish plugin to menu blocks."
msgstr "Añade el plugin jQuery Superfish a los bloques de menú."

msgid "User interface"
msgstr "Interfaz de usuario"

msgid "Block settings"
msgstr "Valores de bloque"

msgid "Default"
msgstr "Valor predeterminado"

msgid "Horizontal (single row)"
msgstr "Horizontal (fila única)"

msgid "Menu type"
msgstr "Tipo de menú"

msgid "Horizontal (double row)"
msgstr "Horizontal (fila doble)"

msgid "Vertical (stack)"
msgstr "Vertical (pila)"

msgid "Style"
msgstr "Estilo"

msgid "Black"
msgstr "Negro"

msgid "Blue"
msgstr "Azul"

msgid "Coffee"
msgstr "Café"

msgid "White"
msgstr "Blanco"

msgid "Add arrows to parent menus"
msgstr "Añadir flechas a menús padre"

msgid "Drop shadows"
msgstr "Descartar sombreados"

msgid "jQuery Easing plugin is not installed."
msgstr "El plugin de borrado jQuery no está instalado."

msgid "The plugin provides a handful number of animation effects, they can be used by uploading the 'jquery.easing.js' file to the libraries directory within the 'easing' directory (for example: libraries/easing/jquery.easing.js). Refresh this page after the plugin is uploaded, this will make more effects available in the above list."
msgstr "El plugin proporciona un buen número de efectos de animación que se pueden usar cargando el archivo 'jquery.easing.js' en el directorio de bibliotecas dentro del directorio 'easing' (por ejemplo: libraries/easing/jquery.easing.js). Renueve esta página una vez cargado el plugin, lo que hará que haya más efectos disponibles en la lista anterior."

msgid "Slide-in effect"
msgstr "Efecto de entrada deslizante (slide-in)"

msgid "Superfish plugins"
msgstr "Plugins de Superfish"

msgid "Relocates sub-menus when they would otherwise appear outside the browser window area."
msgstr "Reubica los submenús cuando aparecen fuera del área de ventana del navegador."

msgid "enabled"
msgstr "enabled"

msgid "jQuery Supposition"
msgstr "jQuery Supposition"

msgid "Prevents accidental firing of animations by waiting until the user's mouse slows down enough, hence determinig user's <em>intent</em>."
msgstr "Impide un desencadenamiento accidental de las animaciones esperando hasta que el ratón del usuario se haya ralentizado lo suficiente como para determinar la <em>intención</em> del usuario."

msgid "jQuery hoverIntent"
msgstr "jQuery hoverIntent"

msgid "<strong>sf-Touchscreen</strong> provides touchscreen compatibility."
msgstr "<strong>sf-Touchscreen</strong> proporciona compatibilidad con pantalla táctil."

msgid "The first click on a parent hyperlink shows its children and the second click opens the hyperlink."
msgstr "El primer clic en un hiperenlace padre muestra sus hijos y el segundo clic abre el hiperenlace."

msgid "sf-Touchscreen"
msgstr "sf-Touchscreen"

msgid "Disable"
msgstr "Inhabilitar"

msgid "Enable jQuery sf-Touchscreen plugin for this menu."
msgstr "Activar el plugin de jQuery sf-Touchscreen en este menú."

msgid "Enable jQuery sf-Touchscreen plugin for this menu depending on the user's Web browser <strong>window width</strong>."
msgstr "Activar el plugin jQuery sf-Touchscreen en este menú en función del <strong>ancho de ventana</strong> del navegador web del usuario."

msgid "Enable jQuery sf-Touchscreen plugin for this menu depending on the user's Web browser <strong>user agent</strong>."
msgstr "Activar el plugin jQuery sf-Touchscreen en este menú en función del <strong>agente de usuario</strong> del navegador web del usuario."

msgid "Hiding the sub-menu on the second tap, adding cloned parent links to the top of sub-menus as well."
msgstr "Ocultando el submenú en el segundo toque, y añadiendo también enlaces padre clonados en la parte superior de los submenús."

msgid "Using this plugin, the first click or tap will expand the sub-menu, here you can choose what a second click or tap should do."
msgstr "Con este plugin, el primer clic o toque expande el submenú, y en este punto se puede elegir qué hace un segundo clic o toque."

msgid "Opening the parent menu item link on the second tap."
msgstr "Abriendo el enlace del menú padre al segundo toque."

msgid "Hiding the sub-menu on the second tap."
msgstr "Ocultando el submenú al segundo toque."

msgid "sf-Touchscreen will be enabled only if the width of user's Web browser window is smaller than the below value."
msgstr "sf-Touchscreen solo se activará si el ancho de la ventana del navegador web del usuario es menor que el valor de abajo."

msgid "Please note that in most cases such a meta tag is necessary for this feature to work properly:"
msgstr "Tenga en cuenta que en la mayoría de los casos una meta etiqueta como esta es necesaria para que esta característica funcione correctamente:"

msgid "Window width settings"
msgstr "Configuración del ancho de ventana"

msgid "Also known as \"Breakpoint\"."
msgstr "También conocido como \"Punto de interrupción\"."

msgid "pixels"
msgstr "píxeles"

msgid "User agent settings"
msgstr "Configuración del agente de usuario"

msgid "Use the pre-defined list of the <strong>user agents</strong>."
msgstr "Utilice la lista predefinida de los <strong>agentes de usuario</strong>."

msgid "Recommended"
msgstr "Recomendado"

msgid "Use the custom list of the <strong>user agents</strong>."
msgstr "Utilice la lista personalizada de los <strong>agentes de usuario</strong>."

msgid "UA string of the current Web browser:"
msgstr "Cadena de agente de usuario del navegador web actual:"

msgid "Could be partial or complete. (Asterisk separated)"
msgstr "Puede ser parcial o completo. (Separados por asteriscos)"

msgid "empty"
msgstr "vacío"

msgid "Examples"
msgstr "Ejemplos"

msgid "Custom list of the user agents"
msgstr "Lista personalizada de los agentes de usuario"

msgid "Client-side (JavaScript)"
msgstr "Lado del cliente (JavaScript)"

msgid "<strong>User agent</strong> detection method"
msgstr "Método de detección del <strong>agente de usuario</strong>"

msgid "Server-side (PHP)"
msgstr "Lado del servidor (PHP)"

msgid "sf-Smallscreen"
msgstr "sf-Smallscreen"

msgid "<strong>sf-Smallscreen</strong> provides small-screen compatibility for your menus."
msgstr "<strong>sf-Smallscreen</strong> proporciona compatibilidad de pantalla pequeña para los menús."

msgid "Enable jQuery sf-Smallscreen plugin for this menu depending on the user's Web browser <strong>window width</strong>."
msgstr "Habilite el plugin jQuery sf-Smallscreen para este menú en función del <strong>ancho de ventana</strong> del navegador web del usuario."

msgid "Enable jQuery sf-Smallscreen plugin for this menu."
msgstr "Habilite el plugin jQuery sf-Smallscreen para este menú."

msgid "Enable jQuery sf-Smallscreen plugin for this menu depending on the user's Web browser <strong>user agent</strong>."
msgstr "Habilite el plugin jQuery sf-Smallscreen para este menú en función del <strong>agente de usuario</strong>del navegador web del usuario."

msgid "sf-Smallscreen will be enabled only if the width of user's Web browser window is smaller than the below value."
msgstr "sf-Smallscreen solo se habilitará si el ancho de la ventana del navegador web del usuario es menor que el valor a continuación."

msgid "Convert the menu to an accordion menu."
msgstr "Convertir el menú en un menú de acordeón."

msgid "Select a type"
msgstr "Seleccione un tipo"

msgid "Convert the menu to a &lt;select&gt; element."
msgstr "Convierta el menú en un elemento &lt;select&gt;"

msgid "&lt;select&gt; settings"
msgstr "Valores de &lt;select&gt;"

msgid "By default the first item in the &lt;select&gt; element will be the name of the parent menu or the title of this block, you can change this by setting a custom title."
msgstr "De forma predeterminada, el primer elemento del elemento&lt;select&gt; será el nombre del menú padre o el título de este bloque, puede cambiarlo estableciendo un título personalizado."

msgid "Example"
msgstr "Ejemplo"

msgid "Main Menu"
msgstr "Menú principal"

msgid "&lt;select&gt; title"
msgstr "Título de &lt;select&gt;"

msgid "Add <em>selected</em> attribute to the &lt;option&gt; element with the class <strong>active</strong> ."
msgstr "Añade el atributo <em>selected</em> al elemento <option> con la clase <strong>active</strong>."

msgid "Makes pre-selected the item linked to the active page when the page loads."
msgstr "Hace preseleccionar el elemento enlazado a la página activa cuando se carga la página."

msgid "More"
msgstr "Más"

msgid "Copy the main &lt;ul&gt; classes to the &lt;select&gt;."
msgstr "Copie las clases &lt;ul&gt; principales en &lt;select&gt;."

msgid "disabled"
msgstr "inhabilitado"

msgid "Comma separated"
msgstr "Separados por comas"

msgid "Exclude these classes from the &lt;select&gt; element"
msgstr "Excluir estas clases del elemento &lt;select&gt;"

msgid "Copy the hyperlink classes to the &lt;option&gt; elements of the &lt;select&gt;."
msgstr "Copie las clases de hiperenlace en los elementos &lt;option&gt; de &lt;select&gt;."

msgid "Exclude these classes from the &lt;option&gt; elements of the &lt;select&gt;"
msgstr "Excluya estas clases de los elementos &lt;option&gt; de &lt;select&gt;"

msgid "Include these classes in the &lt;select&gt; element"
msgstr "Incluir estas clases en el elemento &lt;select&gt;"

msgid "Include these classes in the &lt;option&gt; elements of the &lt;select&gt;"
msgstr "Incluya estas clases en los elementos &lt;option&gt; de &lt;select&gt;"

msgid "Accordion settings"
msgstr "Configuración de acordeón"

msgid "By default the caption of the accordion toggle switch will be the name of the parent menu or the title of this block, you can change this by setting a custom title."
msgstr "De forma predeterminada, la leyenda del conmutador del acordeón será el nombre del menú padre o el título de este bloque; esto se puede cambiar configurando un título personalizado."

msgid "Menu"
msgstr "Menú"

msgid "Accordion menu title"
msgstr "Título de menú del acordeón"

msgid "Use parent menu items as buttons, add cloned parent links to sub-menus as well."
msgstr "Utilice elementos de menú padre como botones y añada también enlaces padre clonados a submenús."

msgid "Accordion button type"
msgstr "Tipo de botón acordeón"

msgid "Use parent menu items as buttons."
msgstr "Utilice elementos de menú padre como botones."

msgid "Create new links next to parent menu item links and use them as buttons."
msgstr "Cree enlaces junto a enlaces de elemento de menú padre y úselos como botones."

msgid "Supersubs"
msgstr "Supersubs"

msgid "<strong>Supersubs</strong> makes it possible to define custom widths for your menus."
msgstr "<strong>Supersubs</strong> permite definir anchos personalizados en los menús."

msgid "Enable Supersubs for this menu."
msgstr "Habilitar Supersubs en este menú."

msgid "Minimum width for sub-menus, in <strong>em</strong> units."
msgstr "Ancho mínimo de los submenús, en unidades <strong>em</strong>."

msgid "Minimum width"
msgstr "Ancho mínima"

msgid "Maximum width for sub-menus, in <strong>em</strong> units."
msgstr "Ancho máximo de los submenús, en unidades <strong>em</strong>."

msgid "Maximum width"
msgstr "Anchura máxima"

msgid "Please refer to the Superfish module documentation for how you should setup multi-column sub-menus."
msgstr "Consulte la documentación del módulo Superfish para saber cómo se configuran submenús de varias columnas."

msgid "Multi-column sub-menus"
msgstr "Submenús de varias columnas"

msgid "Enable multi-column sub-menus."
msgstr "Habilitar submenús de varias columnas."

msgid "The depth of the first instance of multi-column sub-menus."
msgstr "Profundidad de la primera instancia de submenús de varias columnas."

msgid "Start from depth"
msgstr "Empezar a partir de profundidad"

msgid "The amount of sub-menu levels that will be included in the multi-column sub-menu."
msgstr "Cantidad de niveles de submenú que se incluirán en el submenú de varias columnas."

msgid "Levels"
msgstr "Niveles"

msgid "Advanced settings"
msgstr "Valores avanzados"

msgid "The speed of the animation either in <strong>milliseconds</strong> or pre-defined values (<strong>slow, normal, fast</strong>)."
msgstr "Velocidad de la animación en <strong>milisegundos</strong> o valores predefinidos (<strong>slow, normal, fast</strong>, lenta, normal, rápida)."

msgid "Animation speed"
msgstr "Velocidad de animación"

msgid "The delay in <strong>milliseconds</strong> that the mouse can remain outside a sub-menu without it closing."
msgstr "Retardo en <strong>milisegundos</strong> que el ratón puede permanecer fuera de un submenú sin que se cierre."

msgid "Mouse delay"
msgstr "Retardo del ratón"

msgid "The amount of sub-menu levels that remain open or are restored using the \".active-trail\" class."
msgstr "La cantidad de niveles de submenú que permanecen abiertos o se restauran utilizando la clase \". active-trail\"."

msgid "Change this setting <strong>only and only</strong> if you are <strong>totally sure</strong> of what you are doing."
msgstr "Cambie este parámetro a <strong>only and only</strong> solo si está <strong>totalmente seguro</strong> de lo que está haciendo."

msgid "Path levels"
msgstr "Niveles de ruta"

msgid "Hyperlinks"
msgstr "Hiperenlaces"

msgid "By enabling this option, only parent menu items with <em>Expanded</em> option enabled will have their submenus appear."
msgstr "Al habilitarse esta opción, solo aparecerán los submenús de aquellos elementos de menú padre que tengan habilitada la opción <em>Expanded</em> (expandido)."

msgid "Take \"Expanded\" option into effect."
msgstr "Activar la opción \"Expandido\"."

msgid "Add cloned parent links to the top of sub-menus."
msgstr "Añadir enlaces padre clonados a la parte superior de los submenús."

msgid "Disable hyperlink descriptions (\"title\" attribute)"
msgstr "Inhabilitar descripciones de hiperenlace (atributo \"title\")"

msgid "Insert hyperlink descriptions (\"title\" attribute) into hyperlink texts."
msgstr "Insertar descripciones de hiperenlace (atributo \"title\") en textos de hiperenlace."

msgid "Add item depth classes to menu items and their hyperlinks."
msgstr "Añadir clases de profundidad de elemento a elementos de menú y sus hiperenlaces."

msgid "Custom classes"
msgstr "Clases personalizadas"

msgid "(Space separated, without dots)"
msgstr "(Separadas por espacios, sin puntos)"

msgid "For the main UL"
msgstr "Para el UL principal"

msgid "For the list items"
msgstr "Para los elementos de lista"

msgid "For the hyperlinks"
msgstr "Para los hiperenlaces"

msgid "Unacceptable value entered for the \"Animation speed\" option."
msgstr "Se ha especificado un valor inaceptable para la opción \"Velocidad de animación\"."

msgid "Unacceptable value entered for the \"Mouse delay\" option."
msgstr "Se ha especificado un valor inaceptable para la opción \"Retardo de ratón\"."

msgid "\"sfTouchscreen Breakpoint\" option cannot be empty."
msgstr "La opción \"sfTouchscreen Breakpoint\" no puede estar vacía."

msgid "Unacceptable value enterd for the \"sfTouchscreen Breakpoint\" option."
msgstr "Se ha especificado un valor inaceptable para la opción \"Punto de interrupciónsfTouchscreen \"."

msgid "List of the touch-screen user agents cannot be empty."
msgstr "La lista de agentes de usuario de touch-screen no puede estar vacía."

msgid "\"sfSmallscreen Breakpoint\" option cannot be empty."
msgstr "La opción \"sfSmallscreen Breakpoint\" no puede estar vacía."

msgid "Unacceptable value entered for the \"sfSmallscreen Breakpoint\" option."
msgstr "Se ha especificado un valor inaceptable para la opción \"Punto de interrupción sfSmallscreen \"."

msgid "List of the small-screen user agents cannot be empty."
msgstr "La lista de agentes de usuario de small-screen no puede estar vacía."

msgid "Unacceptable value entered for the \"Supersubs minimum width\" option."
msgstr "Se ha especificado un valor inaceptable para la opción \"Ancho mínimo de supersubs\"."

msgid "Unacceptable value entered for the \"Supersubs maximum width\" option."
msgstr "Se ha especificado un valor inaceptable para la opción \"Supersubs maximum width\"."

msgid "Supersubs \"maximum width\" has to be bigger than the \"minimum width\"."
msgstr "El \"ancho máximo\" de supersubs debe ser mayor que el \"ancho mínimo\"."

msgid "Expand"
msgstr "Expandir"

msgid "Collapse"
msgstr "Contraer"

