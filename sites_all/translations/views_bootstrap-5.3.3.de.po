msgid "@style style will not display without the \"@field\" setting."
msgstr "Der Stil @style wird nicht ohne die Einstellung „@field“ angezeigt."

msgid "About"
msgstr "Über"

msgid "The <a href=\":bootstrap\">Views Bootstrap module</a> adds styles to Views to output the results of a view as several common <a href=\":components\">Twitter Bootstrap</a> components."
msgstr "Das Modul <a href=\":bootstrap\">Bootstrap-Ansichten</a> fügt Stile zu Ansichten hinzu, um die Ergebnisse einer Ansicht als mehrere allgemeine <a href=\":components\">Twitter Bootstrap</a>-Komponenten auszugeben."

msgid "Uses"
msgstr "Verwendungszwecke"

msgid "<a href=\":views\">Create a view</a> using one of the following styles:"
msgstr "<a href=\":views\">Erstellen Sie eine Ansicht</a>, indem Sie einen der folgenden Stile verwenden:"

msgid "<a href=\":docs\">Accordion</a>"
msgstr "<a href=\":docs\">Akkordeon</a>"

msgid "<a href=\":docs\">Cards</a>"
msgstr "<a href=\":docs\">Karten</a>"

msgid "<a href=\":docs\">Carousel</a>"
msgstr "<a href=\":docs\">Rundmagazin</a>"

msgid "<a href=\":docs\">Dropdown</a>"
msgstr "<a href=\":docs\">Dropdown-Liste</a>"

msgid "<a href=\":docs\">Grid</a>"
msgstr "<a href=\":docs\">Raster</a>"

msgid "<a href=\":docs\">Thumbnails</a>"
msgstr "<a href=\":docs\">Piktogramme</a>"

msgid "<a href=\":docs\">Tables</a>"
msgstr "<a href=\":docs\">Tabellen</a>"

msgid "<a href=\":docs\">Tabs</a>"
msgstr "<a href=\":docs\">Registerkarten</a>"

msgid "<a href=\":docs\">Media object</a>"
msgstr "<a href=\":docs\">Medienobjekte</a>"

msgid "<a href=\":docs\">List group</a>"
msgstr "<a href=\":docs\">Listengruppe</a>"

msgid "Views Bootstrap"
msgstr "Bootstrap-Ansichten"

msgid "Views Twitter Bootstrap Components."
msgstr "Zeigt Twitter Bootstrap-Komponenten an."

msgid "Views"
msgstr "Ansichten"

msgid "The Bootstrap accordion displays content in collapsible panels (<a href=\":docs\">see documentation</a>)."
msgstr "Das Bootstrap-Akkordeon zeigt Inhalte in ausblendbaren Anzeigen an (<a href=\":docs\">siehe Dokumentation</a>)."

msgid "Panel title field"
msgstr "Panel-Titelfeld"

msgid "Select the field that will be used as the accordion panel titles."
msgstr "Wählen Sie das Feld aus, das für Akkordeon-Anzeigenüberschriften verwendet werden soll."

msgid "Label field"
msgstr "Beschriftungsfeld"

msgid "- None -"
msgstr "- Nicht festgelegt/ausgewählt -"

msgid "Select the field that will be used as the label."
msgstr "Wählen Sie das Feld aus, das als Beschriftung verwendet werden soll."

msgid "Collapse Options"
msgstr "Ausblendeoptionen"

msgid "All Items Closed"
msgstr "Alle geschlossenen Elemente"

msgid "First Item Open"
msgstr "Erstes geöffnetes Element"

msgid "All Items Open"
msgstr "Alle geöffneten Elemente"

msgid "Default panel state for collapse behavior."
msgstr "Standardanzeigenstatus für Ausblendeverhalten."

msgid "Bootstrap Accordion"
msgstr "Bootstrap-Akkordeon"

msgid "Displays rows in a Bootstrap Accordion."
msgstr "Zeilen in einem Bootstrap-Akkordeon anzeigen."

msgid "Card title field"
msgstr "Kartentitelfeld"

msgid "Select the field that will be used for the card title."
msgstr "Das Feld auswählen, das für den Kartentitel verwendet werden soll."

msgid "Card content field"
msgstr "Karteninhaltsfeld"

msgid "Select the field that will be used for the card content."
msgstr "Das Feld auswählen, das für den Karteninhalt verwendet werden soll."

msgid "Card image field"
msgstr "Kartenbildfeld"

msgid "Select the field that will be used for the card image."
msgstr "Das Feld auswählen, das für das Kartenbild verwendet werden soll."

msgid "Custom card group class"
msgstr "Benutzerdefinierte Karten-Gruppenklasse"

msgid "Additional classes to provide on the card group. Separated by a space."
msgstr "Zusätzliche Klassen, die auf der Kartengruppe bereitgestellt werden. Getrennt durch ein Leerzeichen."

msgid "Additional classes to provide on each card. Separated by a space."
msgstr "Zusätzliche Klassen, die auf jeder Karte bereitgestellt werden. Getrennt durch ein Leerzeichen."

msgid "Bootstrap Cards"
msgstr "Bootstrap-Karten"

msgid "Displays rows in a Bootstrap Card Group layout"
msgstr "Zeilen in einem Bootstrap-Karten-Gruppenlayout anzeigen"

msgid "The Bootstrap carousel displays content as a slideshow (<a href=\":docs\">see documentation</a>)."
msgstr "Das Bootstrap-Karussell zeigt den Inhalt als Slideshow an (<a href=\":docs\">siehe Dokumentation</a>)."

msgid "<None>"
msgstr "- Keine -"

msgid "Interval"
msgstr "Intervall"

msgid "The amount of time to delay between automatically cycling an item. If false, carousel will not automatically cycle."
msgstr "Die Zeitspanne, die zwischen dem automatischen Abspielen eines Elements vergeht. Wenn diese Option auf falsch steht, wird das Karussell nicht automatisch abgespielt."

msgid "Show navigation"
msgstr "Navigation anzeigen"

msgid "Show indicators"
msgstr "Indikatoren anzeigen"

msgid "Pause on hover"
msgstr "Pausieren bei dem Überfahren mit der Maus"

msgid "Pauses the cycling of the carousel on mouseenter and resumes the cycling of the carousel on mouseleave."
msgstr "Pausiert das Abspielen des Karussells bei Überfahren mit dem Mauszeiger und setzt das Abspielen des Karussells beim Verlassen des Mauszeigers fort."

msgid "Wrap"
msgstr "Einwickeln"

msgid "The carousel should cycle continuously or have hard stops."
msgstr "Das Karussell sollte kontinuierlich weiterlaufen oder feste Stopps aufweisen."

msgid "Columns"
msgstr "Spalten"

msgid "The number of columns to include in the carousel."
msgstr "Die Anzahl der Spalten, die in das Karussell aufgenommen werden sollen."

msgid "Breakpoints"
msgstr "Haltepunkte"

msgid "The min-width breakpoint of the multicolumn carousel."
msgstr "Der Breakpoint für die Mindestbreite des mehrspaltigen Karussells."

msgid "Extra Small"
msgstr "Besonders klein"

msgid "Small"
msgstr "Klein"

msgid "Medium"
msgstr "Medium"

msgid "Large"
msgstr "Groß"

msgid "Display"
msgstr "Anzeigen"

msgid "Select by fields"
msgstr "Nach Feldern auswählen"

msgid "Display fields as row content"
msgstr "Felder als Zeileninhalt anzeigen"

msgid "Displaying fields as row content will output the field rows as unformatted values within each carousel item."
msgstr "Durch das Anzeigen von Feldern als Zeileninhalt werden die Feldzeilen als unformatierte Werte in jedem Karussellelement ausgegeben."

msgid "Image"
msgstr "Bild"

msgid "Title"
msgstr "Titel"

msgid "Description"
msgstr "Beschreibung"

msgid "Bootstrap Carousel"
msgstr "Bootstrap-Karussell"

msgid "Displays rows in a Bootstrap Carousel."
msgstr "Zeilen in einem Bootstrap-Karussell anzeigen."

msgid "The Bootstrap dropdown style displays a list of links in a drop-down menu format (<a href=\":docs\">see documentation</a>)."
msgstr "Der Bootstrap-Dropdown-Stil zeigt eine Liste von Links in Form eines Dropdown-Menüs an (<a href=\":docs\">Siehe Dokumentation</a>)."

msgid "Button text"
msgstr "Button-Text"

msgid "Text label for the button that is the drop-down toggle."
msgstr "Textbeschriftung für die Schaltfläche, die die Umschaltfunktion darstellt."

msgid "Button class"
msgstr "Button-Klasse"

msgid "Classes for the button that is the drop-down toggle."
msgstr "Klassen für die Schaltfläche, die die Umschaltfunktion darstellt."

msgid "Default"
msgstr "Standard"

msgid "Primary"
msgstr "Primär"

msgid "Success"
msgstr "Erfolg"

msgid "Info"
msgstr "Info"

msgid "Warning"
msgstr "Warnung"

msgid "Danger"
msgstr "Gefahr"

msgid "Wrapper class"
msgstr "Klasse für umgebende Elemente"

msgid "The class to provide on the wrapper, outside the list."
msgstr "Die Klasse, die auf den Wrapper angewendt werden soll (außerhalb der Liste)."

msgid "List class"
msgstr "Listenklasse"

msgid "The class to provide on the list element itself."
msgstr "Die Klasse, die auf das Listenelement selbst angewendet werden soll."

msgid "Bootstrap Dropdown"
msgstr "Bootstrap Dropdown"

msgid "Displays rows in a Bootstrap Dropdown."
msgstr "Zeigt Zeilen in einem Bootstrap Dropdown an."

msgid "The Bootstrap grid displays content in a responsive, mobile first fluid grid (<a href=\":docs\">see documentation</a>)."
msgstr "Das Bootstrap-Raster zeigt Inhalte in einem reaktionsfähigen, mobilen First Fluid-Raster an (<a href=\":docs\">siehe Dokumentation</a>)."

msgid "Alignment"
msgstr "Ausrichtung"

msgid "Horizontal"
msgstr "Horizontal"

msgid "Vertical"
msgstr "Vertikal"

msgid ""
"Horizontal alignment will place items starting in the upper left and moving right.\n"
"      Vertical alignment will place items starting in the upper left and moving down."
msgstr ""
"Die horizontale Ausrichtung platziert Elemente, die oben links beginnen und sich nach rechts bewegen.\r\n"
"      Die vertikale Ausrichtung platziert Elemente, die oben links beginnen und sich nach unten bewegen."

msgid "Default column classes"
msgstr "Standard Spalten-Klassen"

msgid "Add the default views column classes like views-col, col-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Fügt die Standard-CSS-Klassen für Ansichten wie zum Beispiel: views-col, col-1 and clearfix zum ausgegebenen Quellcode hinzu. Sie können diese Klassen verwenden, um die Menge des Markups zu reduzieren, die die Ansicht zur Verfügung stellt. Der Preis dafür ist, dass es schwieriger ist CSS hinzuzufügen, wenn die Standardklassen nicht verwendend werden."

msgid "Custom column class"
msgstr "Benutzerdefinierte Spalten-Klassen"

msgid "Additional classes to provide on each column. Separated by a space."
msgstr "Zusätzliche Klassen für jede Spalte. Mehrere Klassen müssen durch ein Leerzeichen getrennt werden."

msgid "You may use field tokens from as per the \"Replacement patterns\" used in \"Rewrite the output of this field\" for all fields."
msgstr "Es können Feld-Token aus den „Ersetzungsmustern“ in „Ergebnisse Überschreiben“ für alle Felder verwendet werden."

msgid "Default row classes"
msgstr "Standard-Zeilenklassen"

msgid "Adds the default views row classes like views-row, row-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Fügt die Standard-Css-Klassen für Zeilen in Ansichten wie views-row, row-1 und clearfix zur Ausgabe hinzu. Diese Css-Klasen können verwendet werden um schnell das notwendige Markup zu reduzieren, das zum Anpassen der Ausgabe von Ansichten benötigt wird. Durch das aktivieren dieser Option wird der benötigte CSS-Code allerdings auch etwas komplexer."

msgid "Custom row class"
msgstr "Zeilen-Klasse überschreiben"

msgid "Additional classes to provide on each row. Separated by a space."
msgstr "Weitere Klassen für jede Zeile hinzufügen. Mittels Leerzeichen getrennt."

msgid "Base number of columns"
msgstr "Basisanzahl der Spalten"

msgid "all"
msgstr "alle"

msgid "Choose the number of columns that views will wrap in a single row. This will be reflected in the HTML structure rendered regardless of the device size. If selecting \"all\" then use the alternative template."
msgstr "Wählen Sie die Anzahl der Spalten aus, die Ansichten in eine einzige Zeile einschließen. Dies spiegelt sich in der HTML-Struktur wider, die unabhängig von der Einheitengröße wiedergegeben wird. Wenn Sie \"all\" auswählen, verwenden Sie die alternative Vorlage."

msgid "Number of columns (col-@size)"
msgstr "Anzahl der Spalten (col-@size)"

msgid "This adds col-@size to the div."
msgstr "Dies fügt col-@size zum div hinzu."

msgid "Bootstrap Grid"
msgstr "Bootstrap-Raster"

msgid "Displays rows in a Bootstrap Grid layout"
msgstr "Zeilen in einem Bootstrap-Raster-Layout anzeigen"

msgid "The Bootstrap list group displays content in an unordered list with list group classes (<a href=\":docs\">see documentation</a>)."
msgstr "Die Bootstrap-Listengruppe zeigt Inhalte in einer ungeordneten Liste mit Listengruppenklassen an (<a href=\":docs\">siehe Dokumentation</a>)."

msgid "Set group field in panel heading"
msgstr "Gruppenfeld in der Anzeigenüberschrift festlegen"

msgid "Title field"
msgstr "Titelfeld"

msgid "Select the field that will be used as the title."
msgstr "Das Feld auswählen, das als Titel verwendet werden soll."

msgid "Bootstrap List Group"
msgstr "Bootstrap-Listengruppe"

msgid "Displays rows in a Bootstrap List Group."
msgstr "Zeilen in einer Bootstrap-Listengruppe anzeigen."

msgid "The Bootstrap media object displays content with an image item lead with heading and text (<a href=\":docs\">see documentation</a>)."
msgstr "Das Bootstrap-Medienobjekt zeigt Inhalte mit einem Bildelement-Lead mit Überschrift und Text an (<a href=\":docs\">siehe Dokumentation</a>)."

msgid "Heading field"
msgstr "Kopfzeilenfeld"

msgid "Select the field that will be used as the media object heading. Exclude this field from display to prevent duplication."
msgstr "Wählen Sie das Feld aus, das als Überschrift für das Medienobjekt verwendet werden soll. Schließen Sie dieses Feld aus der Anzeige aus, um eine Vervielfältigung zu verhindern."

msgid "Image field"
msgstr "Bildfeld"

msgid "Select the field that will be used as the media object image. Exclude this field from display to prevent duplication."
msgstr "Wählen Sie das Feld aus, das als Medienobjektbild verwendet wird. Schließen Sie dieses Feld aus der Anzeige aus, um eine Vervielfältigung zu verhindern."

msgid "Body field"
msgstr "Textkörperfeld"

msgid "All fields that are not excluded from display will be shown as the body."
msgstr "Alle Felder, die nicht aus der Anzeige ausgeschlossen sind, werden als Hauptteil angezeigt."

msgid "Image Alignment"
msgstr "Bildausrichtung"

msgid "Left"
msgstr "Links"

msgid "Right"
msgstr "Rechts"

msgid "Middle"
msgstr "Mitte"

msgid "Align the media object image left or right."
msgstr "Das Bild des Medienobjekts links oder rechts ausrichten."

msgid "Bootstrap Media Object"
msgstr "Bootstrap-Medienobjekt"

msgid "Displays rows in a Bootstrap Media Object."
msgstr "Zeilen in einem Bootstrap-Medienobjekt anzeigen."

msgid "The Bootstrap panels displays content in a box with optional header and footer elements (<a href=\":docs\">see documentation</a>)."
msgstr "Die Bootstrap-Panels zeigen Inhalte in einer Box mit optionalen Kopf- und Fußzeilenelementen an (<a href=\":docs\">Siehe Dokumentation</a>)."

msgid "Contextual class"
msgstr "Kontextuelle Klasse"

msgid "<a href=\":docs\">see Bootstrap documentation</a>"
msgstr "<a href=\":docs\">Siehe Bootstrap Dokumentation</a>"

msgid "Select the field that will be used as the panel heading titles."
msgstr "Wählen Sie das Feld aus, das für die Überschriften der Felder verwendet werden soll."

msgid "Panel footer field"
msgstr "Feld für die Fußzeile des Panels"

msgid "Select the field that will be used as the panel footer."
msgstr "Wählen Sie das Feld aus, das als Fußzeile des Panels verwendet werden soll."

msgid "Bootstrap Panels"
msgstr "Bootstrap-Panels"

msgid "Displays rows in a Bootstrap Panel."
msgstr "Zeigt Zeilen in einem Bootstrap-Panel an."

msgid "The Bootstrap tabs displays content with tab titles linked to dynamically displayed content (<a href=\":docs\">see documentation</a>)."
msgstr "Auf den Bootstrap-Registerkarten werden Inhalte mit Registerkartentiteln angezeigt, die mit dynamisch angezeigten Inhalten verknüpft sind (<a href=\":docs\">siehe Dokumentation</a>)."

msgid "Tab field"
msgstr "Reiterfeld"

msgid "Select the field that will be used as the tab."
msgstr "Das Feld auswählen, das als Reiter verwendet werden soll."

msgid "Tab Type"
msgstr "Reitertyp"

msgid "Tabs"
msgstr "Tabs"

msgid "Pills"
msgstr "Pills"

msgid "List"
msgstr "Liste"

msgid "Position of tabs"
msgstr "Position der Registerkarten"

msgid "Tabs/pills on the top"
msgstr "Registerkarten/Pills oben"

msgid "Tabs/pills on the left"
msgstr "Registerkarten/Pills links"

msgid "Tabs/pills on the right"
msgstr "Registerkarten/Pills rechts"

msgid "Tabs/pills on the bottom"
msgstr "Registerkarten/Pills unten"

msgid "Tabs/pills justified on the top"
msgstr "Registerkarten/Pills (justified) oben"

msgid "Tabs/pills stacked"
msgstr "Gestapelte Registerkarten/Pills"

msgid "Fade Effect"
msgstr "Ein-/Ausblendeeffekt"

msgid "Add a fade in effect when tabs clicked"
msgstr "Fügen Sie einen Einblendeeffekt beim Klicken auf Registerkarten hinzu"

msgid "Bootstrap Tabs"
msgstr "Bootstrap-Registerkarten"

msgid "Displays rows in Bootstrap Tabs."
msgstr "Zeilen in Bootstrap-Reitern anzeigen."

msgid "The Bootstrap table style adds default Bootstrap table classes and optional classes (<a href=\":docs\">see documentation</a>)."
msgstr "Der Bootstrap-Tabellenstil fügt Bootstrap-Standardtabellenklassen und optionale Klassen hinzu (<a href=\":docs\">siehe Dokumentation</a>)."

msgid "Responsive"
msgstr "Responsiv"

msgid "To make a table scroll horizontally on small devices."
msgstr "Um eine Tabelle horizontal auf kleinen Geräten scrollen zu lassen."

msgid "Bootstrap styles"
msgstr "Bootstrap-Stile"

msgid "Striped"
msgstr "Gestreift"

msgid "Bordered"
msgstr "Umrahmt"

msgid "Hover"
msgstr "Mit der Maus überfahren"

msgid "Condensed"
msgstr "Verkürzt"

msgid "Caption for the table"
msgstr "Beschriftung für die Tabelle"

msgid "A title semantically associated with your table for increased accessibility."
msgstr "Ein Titel, der Ihrer Tabelle semantisch zugeordnet ist, um die Zugänglichkeit zu erhöhen."

msgid "Table details"
msgstr "Tabellendetails"

msgid "Summary title"
msgstr "Übersichtstitel"

msgid "Table description"
msgstr "Tabellenbeschreibung"

msgid "Provide additional details about the table to increase accessibility."
msgstr "Geben Sie zusätzliche Details zur Tabelle an, um die Zugänglichkeit zu verbessern."

msgid "Bootstrap Table"
msgstr "Bootstrap-Tabelle"

msgid "Displays rows in a Bootstrap table."
msgstr "Zeilen in einer Bootstrap-Tabelle anzeigen."

msgid "The Bootstrap thumbnails extends the grid display with the thumbnail component to showcase linked images (<a href=\":docs\">see documentation</a>)."
msgstr "Die Bootstrap-Thumbnails erweitern die Grid-Darstellung um die Thumbnail-Komponente, um verlinkte Bilder zu präsentieren (<a href=\":docs\">Siehe Dokumentation</a>)."

msgid "Bootstrap Thumbnails"
msgstr "Bootstrap-Miniaturbilder"

msgid "Displays rows in a Bootstrap Grid layout with thumbnails"
msgstr "Zeigt Zeilen in einem Bootstrap-Grid-Layout mit Miniaturansichten an"

msgid "Previous"
msgstr "Vorherige"

msgid "Next"
msgstr "Weiter"

