msgid "Schema.org HowTo"
msgstr "Instruções de Schema.org"

msgid "Adds Schema.org/HowTo to the JSON LD array."
msgstr "Inclui Schema.org/Instruções na matriz JSON LD."

msgid "SEO"
msgstr "SEO"

msgid "@type"
msgstr "@type"

msgid "name"
msgstr "nome"

