msgstr "Sterowanie tabelą flood: blokowanie prób zresetowania hasła wysłanych z adresu IP: @ip_address"

msgid "Flood Control: Blocking password reset attempt for user ID: @account_id"
msgstr "Sterowanie tabelą flood: blokowanie prób zresetowania hasła wysłanych przez użytkownika o identyfikatorze: @account_id"

