msgid "New password not set."
msgstr "Nowe hasło nie zostało ustawione."

msgid "Email Address"
msgstr "Adres e-mail"

msgid "Active"
msgstr "Aktywne"

msgid "Blocked"
msgstr "Zablokowany"

msgid "Roles"
msgstr "Role"

msgid "First Name is required."
msgstr "Imię jest wymagane."

msgid "Last Name is required."
