msgid_plural "Updated @count servers."
msgstr[0] "1 serveur mis à jour."
msgstr[1] "@count serveurs mis à jour."

msgid "Database Search"
msgstr "Database Search"

msgid "Offers an implementation of the Search API that uses database tables for indexing content."
msgstr "Offre une implémentation de Search API qui utilise des tables de base de données pour indexer le contenu."

msgid "Search API DB settings"
msgstr "Paramètres de Search API Database Search"

msgid "Name of the database we are connecting to"
msgstr "Nom de la base de données à laquelle se connecter"

msgid "Minimum length of indexed words"
msgstr "Longueur minimale des mots indexés"

msgid "The matching mode – \"words\", \"prefix\" or \"partial\""
msgstr "Mode de correspondance : \"mots\", \"préfixe\" ou \"partiel\""

msgid "Autocomplete configuration"
msgstr "Configuration de la saisie semi-automatique"

msgid "Suggest suffix"
msgstr "Suggérer des suffix"

msgid "Suggest words"
msgstr "Suggérer des mots"

msgid "Maximum occurrences of a term until autocomplete suggestions ignores it"
msgstr "Nombre maximal d'occurrences d'un terme qui, s'il est atteint, entraîne l'ignorance du terme par la fonction de suggestion de saisie semi-automatique "

msgid "Database Search Defaults"
msgstr "Paramètres par défaut de Database Search"

msgid "Enable this module for a best-practice default setup of Search API with the Database backend. After installation it is recommended to uninstall this module again for performance reasons. The provided configuration will not be removed."
msgstr "Activez ce module pour une configuration par défaut conforme aux meilleures pratiques de l'API de recherche avec le système de back end de la base de données. Après son installation, il est recommandé de désinstaller le module pour de meilleures performances. La configuration fournie ne sera pas retirée. "

msgid "Database"
msgstr "Base de données"

msgid "Select the database key and target to use for storing indexing information in. Cannot be changed after creation."
msgstr "Sélectionnez la clé et la cible de base de données à utiliser pour le stockage des informations d'indexation. Elles ne peuvent pas être modifiées après leur création. "

msgid "Minimum word length"
msgstr "Longueur minimale de mot"

msgid "The minimum number of characters a word must consist of to be indexed"
msgstr "Le nombre minimum de caractères qu'un mot doit comprendre pour être indexé"

msgid "Partial matching"
msgstr "Correspondance partielle"

msgid "Match whole words only"
msgstr "Correspondance sur mots entiers uniquement"

msgid "Match on parts of a word"
msgstr "Correspondance sur parties de mots"

msgid "Match words starting with given keywords"
msgstr "Correspondance de mots commençant par certains mots clés"

msgid "Autocomplete settings"
msgstr "Paramètres d'autocomplétion"

msgid "These settings allow you to configure how suggestions are computed when autocompletion is used. If you are seeing many inappropriate suggestions you might want to deactivate the corresponding suggestion type. You can also deactivate one method to speed up the generation of suggestions."
msgstr "Ces paramètres vous permettent de configurer la façon dont les suggestions sont calculées lorsque la saisie semi-automatique est utilisée. Si de nombreuses suggestions inappropriées sont proposées, il peut être judicieux de désactiver le type de suggestion correspondant. Vous pouvez aussi désactiver une méthode afin d'accélérer la génération des suggestions. "

msgid "Suggest word endings"
msgstr "Proposer des terminaisons de mots"

msgid "Suggest endings for the currently entered word."
msgstr "Suggérer des fins pour le mot saisi. "

msgid "Suggest additional words"
msgstr "Proposer des mots supplémentaires"

msgid "Suggest additional words the user might want to search for."
msgstr "Suggérer des mots supplémentaires que l'utilisateur pourrait vouloir rechercher."

msgid "None selected yet"
msgstr "Aucun n'a encore été sélectionné"

msgid "none"
msgstr "aucun(e)"

msgid "Autocomplete suggestions"
msgstr "Suggestions d'autocomplétion"

msgid "No valid search keys were present in the query."
msgstr "Aucune clé de recherche valide n'était présente dans la requête."

msgid "Unknown sort order @order. Assuming \"@default\"."
msgstr "Ordre de tri @order inconnu. L'ordre \"@default\" est supposé."

msgid "Unknown facet field @field."
msgstr "Champ de facette @field inconnu."

msgid "Facets on location fields are currently not supported."
msgstr "Les facettes pour les zones d'emplacement ne sont pas prises en charge actuellement."

msgid "Unknown field @field: please check (and re-save) the index's fields settings."
msgstr "Zone @field inconnue : vérifiez (et sauvegardez à nouveau) les paramètres des zones de l'index. "

msgid "An overlong word (more than 50 characters) was encountered while indexing: %word.<br />Since database search servers currently cannot index words of more than 50 characters, the word was truncated for indexing. If this should not be a single word, please make sure the \"Tokenizer\" processor is enabled and configured correctly for index %index."
msgstr "Un mot trop long (comportant plus de 50 caractères) a été détecté lors de l'indexation : %word.<br />Etant donné que les serveurs de recherche de base de données ne peuvent actuellement pas index de mots comportant plus de 50 caractères, le mot a été tronqué dans le cadre de son indexation. Si ce mot n'est pas un mot unique, assurez-vous que le processeur \"Marqueur sémantique\" est activé et configuré correctement pour l'index %index."

msgid "An overlong value (more than 255 characters) was encountered while indexing: %value.<br />Database search servers currently cannot index such values correctly – the value was therefore trimmed to the allowed length."
msgstr "Une valeur trop longue (comportant plus de 255 caractères) a été détectée lors de l'indexation : %value.<br />Actuellement, les serveurs de recherche de base de données ne peuvent pas indexer de telles valeurs correctement. Par conséquent, la valeur a été tronquée pour avoir la longueur autorisée. "

msgid "Error while adding facets: only \"item_id\" field should be used, used are: @fields."
msgstr "Erreur lors de l'ajout de facettes : la zone \"item_id\" seulement doit être utilisée. Or les zones utilisées sont : @fields."

msgid "Indexes items in the database. Supports several advanced features, but should not be used for large sites."
msgstr "Indexe les éléments dans la base de données. Prend en charge plusieurs fonctions avancées mais ne doit pas être utilisé sur les grands sites. "

msgid "Completed about @percentage% of the indexing operation (@current of @total)."
msgstr "Environ @percentage% de l'opération d'indexation ont été réalisés (@current sur @total)."

msgid "An error occurred during indexing on @index: @message"
msgstr "Une erreur s'est produite lors de l'indexation sur @index: @message"

msgid "Couldn't index items. Check the logs for details."
msgstr "Impossible d'indexer les éléments. Consulter les journaux pour plus de détails."

msgid "An error occurred while trying to index items. Check the logs for details."
msgstr "Une erreur est survenue lors de la tentative d'indexation des éléments. Consulter les journaux pour plus de détails."

msgid "Successfully indexed 1 item."
msgid_plural "Successfully indexed @count items."
msgstr[0] "1 élément indexé avec succès."
msgstr[1] "@count éléments indexés avec succès"

msgid "1 item could not be indexed. Check the logs for details."
msgid_plural "@count items could not be indexed. Check the logs for details."
msgstr[0] "1 élément n'a pas pu être indexé. Consulter les journaux pour plus de détails."
msgstr[1] "@count éléments n'ont pas pu être indexés. Consulter les journaux pour plus de détails."

msgid "The required Node module is not installed on your site. Database Search Defaults module could not be installed."
msgstr "Le mode Noeud requis n'est pas installé sur votre site. Le module Valeurs par défaut de la recherche dans la base de données n'a pas pu être installé."

msgid "Content type @content_type not found. Database Search Defaults module could not be installed."
msgstr "Type de contenu @content_type introuvable. Le module Valeurs par défaut de la recherche dans la base de données n'a pas pu être installé. "

msgid "Field @field in content type @node_type not found. Database Search Defaults module could not be installed"
msgstr "Zone @field dans le type de contenu @node_type introuvable. Le module Valeurs par défaut de la recherche dans la base de données n'a pas pu être installé. "

msgid "It looks like the default setup provided by this module already exists on your site. Cannot re-install module."
msgstr "Il semble que la configuration par défaut fournie par ce module existe déjà sur votre site. Impossible de réinstaller le module. "

