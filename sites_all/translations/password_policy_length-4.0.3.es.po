msgid "Password Character Length Policy"
msgstr "Política de longitud de caracteres de contraseña"

msgid "Sets up a character length constraint for passwords."
msgstr "Configura una restricción de longitud de caracteres en las contraseñas."

msgid "Security"
msgstr "Seguridad"

msgid "Number of characters"
msgstr "Número de caracteres"

msgid "Operation"
msgstr "Operación"

msgid "Minimum length"
msgstr "Longitud mínima"

msgid "Maximum length"
msgstr "Longitud máxima"

msgid "The character length must be a positive number."
msgstr "La longitud de caracteres tiene que ser un número positivo."

msgid "at least"
msgstr "como mínimo"

msgid "at most"
msgstr "como máximo"

msgid "Password length must be at least 1 character."
msgid_plural "Password length must be at least @count characters."
msgstr[0] "La longitud de la contraseña debe ser como mínimo de 1 carácter."
msgstr[1] "La longitud de la contraseña debe ser como mínimo de @count caracteres."

msgid "Password length must not exceed 1 character."
msgid_plural "Password length must not exceed @count characters."
msgstr[0] "La longitud de la contraseña no debe superar 1 carácter."
msgstr[1] "La longitud de la contraseña no debe superar @count caracteres."

msgid "Password character length of @operation 1 character"
msgid_plural "Password character length of @operation @characters characters"
msgstr[0] "Longitud de caracteres de contraseña de @operation 1 carácter"
msgstr[1] "Longitud de caracteres de contraseña de @operation @characters caracteres"

msgid "Password character length"
msgstr "Longitud de caracteres de la contraseña"

msgid "Verifying that a password has a minimum character length"
msgstr "Verificando que una contraseña tiene una longitud de caracteres mínima."

msgid "The length of your password is too short."
msgstr "La longitud de la contraseña es demasiado corta."

