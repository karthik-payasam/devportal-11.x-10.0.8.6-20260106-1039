msgid "Date"
msgstr "Data"

msgid "Numeric query with set granularity"
msgstr "Query numerica con granularità impostata"

msgid "Range"
msgstr "Intervallo"

msgid "String"
msgstr "Testo"

msgid "Query string"
msgstr "Stringa query"

msgid "Query string is the default Facets URL processor, and uses GET parameters, for example ?f[0]=brand:drupal&f[1]=color:blue"
msgstr "Stringa query è Processore URL di facet predefinito, e utilizza i parametri GET, ad esempio ?f[0]=brand:drupal&f[1]=color:blue"

msgid "Array with raw results"
msgstr "Array con risultati non elaborati"

msgid "A widget that builds an array with results. This widget is not supposed to display any results, but it is needed for rest integration."
msgstr "Un widget che costruisce un array con risultati. Questo widget non dovrebbe mostrare alcun risultato, ma è necessario per l'integrazione del resto."

msgid "List of checkboxes"
msgstr "Elenco di caselle di spunta"

msgid "A configurable widget that shows a list of checkboxes"
msgstr "Un widget configurabile che mostra un elenco di caselle di spunta"

msgid "To achieve the standard behavior of a dropdown, you need to enable the facet setting below <em>\"Ensure that only one result can be displayed\"</em>."
msgstr "Per ottenere il comportamento standard di un elenco a discesa, è necessario abilitare l'impostazione del facet seguente <em>\"Verificare che sia possibile visualizzare solo un risultato\"</em>."

msgid "Dropdown"
msgstr "Menu a discesa"

msgid "A configurable widget that shows a dropdown."
msgstr "Un widget configurabile che mostra un elenco a discesa."

msgid "Show all"
msgstr "Mostra tutti"

msgid "Limit the number of displayed facets via JavaScript."
msgstr "Limita il numero di facet visualizzati tramite JavaScript."

msgid "This text will be used for \"Show less\" link."
msgstr "Questo testo verrà utilizzato per il link \"Mostra meno\"."

msgid "This text will be used for \"Show more\" link."
msgstr "Questo testo verrà utilizzato per il link \"Mostra più\"."

msgid "Reset text"
msgstr "Reimposta testo"

msgid "List of links"
msgstr "Elenco di link"

msgid "A simple widget that shows a list of links"
msgstr "Un widget semplice che mostra un elenco di link"

msgid "Pre query stage"
msgstr "Stage pre-query"

msgid "Post query stage"
msgstr "Stage post-query"

msgid "Sort stage"
msgstr "Ordina stage"

msgid "Sort order"
msgstr "Ordinamento"

msgid "Ascending"
msgstr "Crescente"

msgid "Descending"
msgstr "Decrescente"

msgid "Show the amount of results"
msgstr "Mostra la quantità di risultati"

