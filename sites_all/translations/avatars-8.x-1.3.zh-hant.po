msgstr "類型：@type | 背景：@background"

msgid "Robots and monsters from Robohash.org"
msgstr "來自 Robohash.org 的機器人及怪獸"

msgid "Avatar generator settings"
msgstr "頭像產生器設定"

msgid "How long should dynamic avatars be cached before allowing refresh."
msgstr "在容許重新整理之前，應該快取動態頭像的時間。"

msgid "How long should non-preferred static avatars be cached. Leave empty to never delete. Preferred static avatars never expire."
msgstr "應該快取非偏好靜態頭像的時間。保留空白，表示永不刪除。偏好的靜態頭像永不到期。"

msgid "Avatar Generator"
msgstr "頭像產生器"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "標籤"

msgid "Weight"
msgstr "權重"

msgid "Plugin"
msgstr "外掛"

msgid "Provider"
msgstr "供應商"

msgid "Avatar generator preview settings"
msgstr "頭像產生器預覽設定"

msgid "Preview image style"
msgstr "預覽圖片樣式"

