msgid "Slick Extras"
msgstr "Doplňky pro Slick"

msgid "Provides Slick carousel extras."
msgstr "Poskytuje doplňky pro karusely Slick. "

msgid "Slick"
msgstr "Slick"

msgid "Slick Development"
msgstr "Vývoj prvků Slick"

msgid "Provides Slick carousel development."
msgstr "Poskytuje vývoj karuselů Slick."

msgid "Configure the Slick development module settings."
msgstr "Konfigurujte nastavení modulu vývoje prvků Slick."

msgid "Development"
msgstr "Vývoj"

msgid "Slick devel settings"
msgstr "Nastavení vývoje prvků Slick"

msgid "Enable development mode"
msgstr "Povolit režim vývoje"

msgid "Use non-minified slick.load.js"
msgstr "Použít nezmenšený slick.load.js"

msgid "Disable module slick.load.js"
msgstr "Zakázat modul slick.load.js"

msgid "Replace the slick.load.js with development version: slick.load.devel.js"
msgstr "Nahradit slick.load.js vývojovou verzí: slick.load.devel.js"

msgid "Unless you are helping to develop the Slick module, all these are not needed to run Slick. Requires slick library 1.6.0 - 1.8.0 at most and slick module 2.10+."
msgstr ""

msgid "Load the development version of the Slick library. Only useful to test new features of the library. Leave it unchecked at production."
msgstr "Načtěte vývojovou verzi knihovny Slick. Používá se pouze k testování nových funkcí knihovny. Při produkci ponechejte nezaškrtnuté."

msgid "Replace slick.load.min.js with slick.load.js. Only useful to debug it."
msgstr "Nahraďte slick.load.min.js za slick.load.js. Používá se pouze pro ladění."

msgid "Slick will not run unless you initiliaze it yourself."
msgstr "Slick se nespustí, pokud jej sami neinicializujete."

msgid "Use slick.load.devel.js to debug the Slick without modifying slick.load.min.js."
msgstr "Použijte slick.load.devel.js k ladění Slick bez úpravy slick.load.min.js."

msgid "Slick Example"
msgstr "Příklad Slick"

msgid "Provides Slick Carousel examples."
msgstr "Poskytuje příklady karuselu Slick."

msgid "Testimonial with thumbnail and description with slidesToShow 2."
msgstr "Osvědčení s miniaturou a popisem, se slidesToShow 2."

msgid "Slick example skin"
msgstr "Vzhled příkladu Slick"

msgid "Adds 3d view with focal point at back, works best with 3 slidesToShow, and caption below."
msgstr "Přidá 3D zobrazení s kontaktním místem na zadní straně, funguje nejlépe se 3 zobrazovanými snímky a titulky umístěnými dole. "

msgid "Adds margins to the sides of slick-list revealing arrows."
msgstr "Přidá okraje po stranách seznamu Slick se šipkami. "

msgid "Carousel that has margins, alternative to centerMode."
msgstr "Karusel, který má okraje, alternativa k centerMode. "

msgid "Adds margins and split caption and image."
msgstr "Přidá okraje a rozdělené titulky a obrázek. "

msgid "Rounds the .slide__image, great for 3-5 visible-slides carousel."
msgstr "Zaoblí obrázek .slide__image, skvělé pro karusel se 3-5 viditelnými snímky. "

msgid "Adds a vertical tabs like thumbnail navigation."
msgstr "Přidá svislé karty jako navigaci pomocí miniatur. "

msgid "Slick extras skin"
msgstr "Vzhled doplňků pro Slick "

