msgid "APIC Drush Administration commands"
msgstr "Commandes d'administration APIC Drush"

msgid "Additional drush admin commands"
msgstr "Commandes supplémentaires d'administration Drush"

msgid "IBM API Developer Portal"
msgstr "Portail de développeur IBM API"

msgid "@theme_name deleted."
msgstr "@theme_name supprimé."

msgid "@module_name deleted."
msgstr "@module_name supprimé."

msgid "All bans cleared."
msgstr "Toutes les interdictions ont été effacées."

msgid "Processing batch delete of users..."
msgstr "Suppression d'utilisateurs par lots en cours..."

msgid "@theme_name not deleted. It is either still activated or is not a custom theme."
msgstr "@theme_name non supprimé. Soit il est toujours activé, soit il ne s'agit pas d'un thème personnalisé."

msgid "@module_name not deleted. It is either still activated or is not a custom module."
msgstr "@module_name non supprimé. Soit il est toujours activé, soit il ne s'agit pas d'un module personnalisé."

msgid "Unknown entity type"
msgstr "Type d'entité inconnu"

msgid "All entities of type %type deleted."
msgstr "Toutes les entités de type %type ont été supprimées."

msgid "All nodes of type %type deleted."
msgstr "Tous les noeuds de type %type ont été supprimés."

msgid "All users from user registry %type have been deleted."
msgstr "Tous les utilisateurs du registre d'utilisateurs %type ont été supprimés."

msgid "All users (except admin) have been deleted."
msgstr "Tous les utilisateurs (sauf admin) ont été supprimés."

