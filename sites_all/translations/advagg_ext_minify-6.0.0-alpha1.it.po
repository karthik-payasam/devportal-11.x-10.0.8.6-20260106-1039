msgid "Advagg External Minification: PHP shell_exec"
msgstr "Minimizzazione esterna Advagg: PHP shell_exec"

msgid "PHP shell_exec is non-functional."
msgstr "PHP shell_exec non è funzionale."

msgid "Check php.ini for safemode or <a href=\"@link\" target=\"_blank\">disable_functions</a>."
msgstr "Selezionare php.ini per safemode o <a href=\"@link\" target=\"_blank\">disable_functions</a>."

msgid "Enabled"
msgstr "Abilitato"

msgid "AdvAgg External Minification"
msgstr "Minimizzazione esterna AdvAgg"

msgid "Minify Javascript and/or CSS with a command line minifier."
msgstr "Minimizza Javascript e/o CSS con il minifier di riga comandi."

msgid "Advanced CSS/JS Aggregation"
msgstr "Aggregazione CSS/JS avanzata"

msgid "External Minification"
msgstr "Minimizzazione esterna"

msgid "AdvAgg external minification settings."
msgstr "Impostazioni della minimizzazione esterna AdvAgg."

msgid "AdvAgg: External Minifiers"
msgstr "AdvAgg: Minifier esterni"

msgid "Settings"
msgstr "Impostazioni"

msgid "Command line for external CSS minification."
msgstr "Riga comandi per la minimizzazione CSS esterna."

msgid "Whether to use the external CSS minifier if configured."
msgstr "Indica se utilizzare il minifier CSS esterno se configurato."

msgid "Command line for external JavaScript minification."
msgstr "Riga comandi per la minimizzazione JavaScript esterna."

msgid "Whether to use the external JS minifier if configured."
msgstr "Indica se utilizzare il minifier JS esterno se configurato."

msgid "CSS"
msgstr "CSS"

msgid "JavaScript"
msgstr "JavaScript"

msgid "Command Line"
msgstr "Riga comandi"

msgid "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = input file. <br /> {%IN_URL_ENC%} = url pointing to the input file that has been url encoded. <br /> {%OUT%} = output file. <br /><br />"
msgstr "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = file di input. <br /> {%IN_URL_ENC%} = url che punta al file di input che è stato codificato con url. <br /> {%OUT%} = file di output. <br /><br />"

msgid "Example using the <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"
msgstr "Esempio con utilizzo di <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "Esempio con utilizzo di <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"

msgid "Example using curl to minify via the <a href=\"@link1\">Online Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "Esempio con utilizzo di curl per minimizzare tramite il <a href=\"@link1\">Google Closure Compiler online</a>. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">YUI Compressor</a>. <p><code>@code1</code></p>"
msgstr "Esempio con utilizzo di <a href=\"@link1\">YUI Compressor</a>. <p><code>@code1</code></p>"

msgid "Example using curl to minify via an online <a href=\"@link1\">CSS Minifier</a>. <p><code>@code1</code></p>"
msgstr "Esempio con utilizzo di curl per minimizzare tramite un <a href=\"@link1\">CSS Minifier</a> online. <p><code>@code1</code></p>"

msgid "Command to run"
msgstr "Comando da eseguire"

msgid "Enable external @type minification"
msgstr "Abilita minimizzazione @type esterna"

