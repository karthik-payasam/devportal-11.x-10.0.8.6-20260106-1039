msgid "About"
msgstr "Popis"

msgid ""
"\n"
"<p>This module generates and exposes a\n"
"  <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a> schema for\n"
"  <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a> entities,\n"
"  and allows you to expose your own custom schema in a consistent way and with\n"
"  minimal effort.</p>"
msgstr ""
"\n"
"<p>Tento modul generuje a vystavuje\n"
"  schéma <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a> pro\n"
"  entity <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a>\n"
"  a umožňuje vám vystavovat vaše vlastní schéma konzistentním způsobem a\n"
"  s minimální námahou.</p>"

