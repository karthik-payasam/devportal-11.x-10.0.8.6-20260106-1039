msgid "Rules HTTP Client"
msgstr "Klient HTTP pro pravidla"

msgid "Provides an action for making http requests."
msgstr "Poskytuje akci pro provádění požadavků http."

msgid "Rules"
msgstr "Rules"

msgid "Error while requsting url as Error code: %code and Message: %message."
msgstr "Chyba při požadavku adresy URL jako kód chyby: %code a zpráva: %message."

msgid "Request HTTP data"
msgstr "Požadavek na data HTTP"

msgid "Data"
msgstr "Data"

msgid "URL"
msgstr "URL"

msgid "Url address where to post, get and delete request send."
msgstr "Adresa URL pro odeslání požadavků post, get a delete."

msgid "Headers"
msgstr "Záhlaví"

msgid "Request headers to send as 'name: value' pairs, one per line (e.g., Accept: text/plain). See <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a> for more information."
msgstr "Záhlaví požadavku, která se mají jako dvojice 'název: hodnota' odeslat po jedné na řádku (např. přijmout: text/prostý). Další informace viz<a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a>."

msgid "Method"
msgstr "Metoda"

msgid "The HTTP request methods like'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH' etc."
msgstr "Metody požadavků HTTP, jako jsou např.'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH' atd."

msgid "The request body, formatter as 'param=value&param=value&...' or one 'param=value' per line.."
msgstr "Tělo požadavku, formátovač jako 'parametr=hodnota&parametr=hodnota&...' nebo jedna dvojice 'parametr=hodnota' na řádek.."

msgid "Max Redirect"
msgstr "Maximální přesměrování"

msgid "How many times a redirect may be followed."
msgstr "Kolikrát může být provedeno přesměrování."

msgid "Timeout"
msgstr "Časový limit"

msgid "The maximum number of seconds the request may take.."
msgstr "Maximální doba trvání požadavku v sekundách."

msgid "HTTP data"
msgstr "Data HTTP"

