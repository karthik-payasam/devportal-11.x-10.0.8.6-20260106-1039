msgid "Font Awesome IconPicker"
msgstr "Písmo Awesome IconPicker"

msgid "The fontIconPicker library is installed."
msgstr "Knihovna fontIconPicker je nainstalována."

msgid "Not installed"
msgstr "Neinstalováno"

msgid "The fontIconPicker library could not be found. To use the Font Awesome Iconpicker, please verify that the fontIconPicker library is installed correctly. Please see the Font Awesome Iconpicker submodule README file for more details."
msgstr "Knihovna fontIconPicker nebyla nalezena. Chcete-li použít submodul Font Awesome Iconpicker, ověřte, zda je knihovna fontIconPicker správně nainstalována. Další podrobnosti naleznete v souboru README submodulu Font Awesome Iconpicker."

msgid "Font Awesome Iconpicker Widget"
msgstr "Modul widget Font Awesome Iconpicker"

msgid "Provides an iconpicker widget for Font Awesome"
msgstr "Poskytuje modul widget iconpicker pro Font Awesome"

msgid "IconPicker already present at @path. No download required."
msgstr "IconPicker je již v @path přítomen. Není nutné jej stahovat."

msgid "Drush was unable to download the fontIconPicker library from @remote."
msgstr "Drush nemohl stáhnout knihovnu fontIconPicker z @remote."

msgid "Error: unable to download fontIconPicker library from @remote"
msgstr "Chyba: Nelze stáhnout knihovnu fontIconPicker z @remote"

msgid "fontIconPicker library has been successfully downloaded to @path."
msgstr "Knihovna fontIconPicker byla úspěšně stažena do @path."

msgid "Drush was unable to load the fontIconPicker) library"
msgstr "Drush nemohl načíst knihovnu fontIconPicker"

msgid "Icon Name"
msgstr "Název ikony"

msgid "Invalid icon"
msgstr "Neplatná ikona"

