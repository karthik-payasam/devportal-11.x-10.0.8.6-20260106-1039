msgstr "Wersja IBM API Developer Portal %ver"

msgid "API Explorer version %ver (%build)"
msgstr "Eksplorator API wersja %ver (%build)"

msgid "Consumer Analytics version %ver (%build)"
msgstr "Consumer Analytics, wersja %ver (%build)"

