msgid "There is %number suspended application not displayed in this list."
msgid_plural "There are %number suspended applications not displayed in this list."
msgstr[0] "Na tej liście nie wyświetlono %number zawieszonej aplikacji."
msgstr[1] "Na tej liście nie wyświetlono %number zawieszonych aplikacji."
