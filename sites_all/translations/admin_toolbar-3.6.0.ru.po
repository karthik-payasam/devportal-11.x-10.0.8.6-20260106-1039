msgid "Provides search of Admin Toolbar items."
msgstr "Позволяет выполнять поиск элементов панели инструментов администрирования."

msgid "Configure the Admin Toolbar Search module."
msgstr "Настройка модуля Admin Toolbar Search."

msgid "Use Admin Toolbar search"
msgstr "Использовать поиск на панели инструментов администрирования"

msgid "Admin toolbar search settings"
msgstr "Параметры Admin Toolbar Search"

