msgid "About"
msgstr "소개"

msgid "Currently the dragable field &quot;User name and password&quot; mashes together:"
msgstr "현재 끌어올 수 있는 필드 &quot;사용자 이름 및 비밀번호&quot;가 함께 표시됩니다."

msgid "This module aims to fix that problem for site builders who want to manage that fields separately."
msgstr "이 모듈은 해당 필드를 별도로 관리하고자 하는 사이트 빌더의 문제점을 해결하려고 합니다."

msgid "Usage"
msgstr "사용 내역"

msgid "After enabling of this module you will see a list of new fields on %link."
msgstr "이 모듈을 사용으로 설정하면 %link에 새로운 필드 목록이 나타납니다."

msgid "Manage or reorder them for your needs."
msgstr "필요에 따라 관리하거나 다시 정렬합니다."

msgid "Account Field Split"
msgstr "계정 필드 분할"

msgid "Split up user profile \"User name and password\" field into separate list of fields that could be managed independently through the \"Manage form display\" UI."
msgstr "사용자 프로파일 \"사용자 이름 및 비밀번호\" 필드를 \"양식 표시 관리\" UI를 통해 독립적으로 관리할 수 있는 별도의 필드 목록으로 분할합니다."

msgid "User"
msgstr "사용자"

msgid "User profile element"
msgstr "사용자 프로파일 요소"

