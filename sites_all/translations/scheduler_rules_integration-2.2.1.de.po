msgstr "Inhaltselement sofort veröffentlichen"

msgid "The node to be published now"
msgstr "Der jetzt zu veröffentlichende Knoten"

msgid "Remove date for publishing a content item"
msgstr "Datum zum Veröffentlichen eines Inhaltselements entfernen"

msgid "The node from which to remove the scheduled publishing date"
msgstr "Der Knoten, aus dem das geplante Veröffentlichungsdatum entfernt werden soll"

msgid "Remove date for unpublishing a content item"
msgstr "Datum zum Zurücknehmen der Veröffentlichung eines Inhaltselements entfernen"

msgid "The node from which to remove the scheduled unpublishing date"
msgstr "Der Knoten, aus dem das geplante Datum für das Zurücknehmen der Veröffentlichung entfernt werden soll"

msgid "Set date for publishing a content item"
msgstr "Datum für Veröffentlichung eines Inhaltselements festlegen"

msgid "Node for scheduling"
msgstr "Knoten für die Planung"

msgid "The node which is to have a scheduled publishing date set"
msgstr "Der Knoten, für den ein geplantes Veröffentlichungsdatum festgelegt werden soll"

msgid "The date for publishing"
msgstr "Das Datum für die Veröffentlichung"

msgid "The date when Scheduler will publish the node"
msgstr "Das Datum, an dem Scheduler den Knoten veröffentlichen wird"

msgid "Set date for unpublishing a content item"
msgstr "Datum für das Zurücknehmen der Veröffentlichung eines Inhaltselements festlegen"

msgid "The node which is to have a scheduled unpublishing date set"
msgstr "Der Knoten, für den ein geplantes Datum für das Zurücknehmen der Veröffentlichung festgelegt werden soll"

msgid "The date for unpublishing"
msgstr "Das Datum für das Zurücknehmen der Veröffentlichung"

msgid "The date when Scheduler will unpublish the node"
msgstr "Das Datum, an dem Scheduler die Veröffentlichung des Knotens zurücknehmen wird"

msgid "Unpublish a content item immediately"
msgstr "Veröffentlichung eines Inhaltselements sofort zurücknehmen"

msgid "The node to be unpublished now"
msgstr "Der Knoten, dessen Veröffentlichung jetzt zurückgenommen werden soll"

