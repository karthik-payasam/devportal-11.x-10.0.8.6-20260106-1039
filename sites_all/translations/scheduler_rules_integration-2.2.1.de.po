msgstr "@entity_type_label für Veröffentlichung"

msgid "The @entity_type_singular to be published now"
msgstr "@entity_type_singular, der jetzt veröffentlicht werden soll"

msgid "Unpublish a @entity_type_singular immediately"
msgstr "Veröffentlichung von @entity_type_singular sofort zurücknehmen"

msgid "@entity_type_label for unpublishing"
msgstr "@entity_type_label zum Zurücknehmen der Veröffentlichung"

msgid "The @entity_type_singular to be unpublished now"
msgstr "@entity_type_singular, dessen Veröffentlichung jetzt zurückgenommen werden soll"

