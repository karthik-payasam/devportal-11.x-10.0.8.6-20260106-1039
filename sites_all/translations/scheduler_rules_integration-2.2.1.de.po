msgid "Send e-mail when content is published by Scheduler"
msgstr "E-Mail senden, wenn Inhalt von Scheduler veröffentlicht wird"

msgid "'[node:title]' has been published on [site:name]"
msgstr "'[node:title]' wurde auf [site:name] veröffentlicht"

msgid "Send e-mail when content is unpublished by Scheduler"
msgstr "E-Mail senden, wenn die Veröffentlichung von Inhalt von Scheduler zurückgenommen wird"

msgid "'[node:title]' has been unpublished on [site:name]"
msgstr "Die Veröffentlichung von '[node:title]' wurde auf [site:name] zurückgenommen"

msgid "Node"
msgstr "Knoten"

msgid "The node for publishing via Scheduler."
msgstr "Der Knoten zum Veröffentlichen über Scheduler."

msgid "Publish-on Date"
msgstr "Veröffentlichungsdatum"

msgid "The publishing date to be used by Scheduler."
msgstr "Das Veröffentlichungsdatum, das von Scheduler verwendet werden soll."

msgid "Set scheduled publishing date"
msgstr "Geplantes Veröffentlichungsdatum festlegen"

msgid "The node for unpublishing via Scheduler."
msgstr "Der Knoten zum Zurücknehmen der Veröffentlichung über Scheduler."

msgid "Unpublish-on Date"
msgstr "Datum für das Zurücknehmen der Veröffentlichung"

msgid "The unpublishing date to be used by Scheduler."
msgstr "Das Datum zum Zurücknehmen der Veröffentlichung, das von Scheduler verwendet werden soll."

msgid "Set scheduled unpublishing date"
msgstr "Geplantes Datum für das Zurücknehmen der Veröffentlichung festlegen"

msgid "The scheduled node"
msgstr "Der geplante Knoten"

msgid "The node scheduled for publishing via Scheduler."
msgstr "Der Knoten, dessen Veröffentlichen über Scheduler geplant ist."

msgid "Remove scheduled publishing date"
msgstr "Geplantes Veröffentlichungsdatum entfernen"

msgid "The node scheduled for unpublishing via Scheduler."
msgstr "Der Knoten, für das das Zurücknehmen der Veröffentlichung über Scheduler geplant ist."

msgid "Remove scheduled unpublishing date"
msgstr "Geplantes Datum für das Zurücknehmen der Veröffentlichung entfernen"

msgid "Scheduler Rules Integration"
msgstr "Integration von Schedulerregeln"

msgid "Scheduler sub-module providing conditions, actions and events for use with the Rules module."
msgstr "Scheduler-Untermodul mit Bedingungen, Aktionen und Ereignissen für die Verwendung mit dem Modul 'Regeln'."

msgid "Scheduler"
msgstr "Scheduler"

msgid "The object representing the scheduled @entity_type"
msgstr "Das Objekt, das den geplanten @entity_type darstellt"

msgid "After saving a new @entity_type that is scheduled for publishing"
msgstr "Nach dem Speichern eines neuen @entity_type, der für die Veröffentlichung geplant ist"

msgid "After saving a new @entity_type that is scheduled for unpublishing"
msgstr "Nach dem Speichern eines neuen @entity_type, dessen Veröffentlichung zurückgenommen werden soll"

msgid "After updating a @entity_type that is scheduled for publishing"
msgstr "Nach der Aktualisierung eines @entity_type, der für die Veröffentlichung geplant ist"

msgid "After updating a @entity_type that is scheduled for unpublishing"
msgstr "Nach der Aktualisierung eines @entity_type, dessen Veröffentlichung zurückgenommen werden soll"

msgid "After Scheduler has published a @entity_type"
msgstr "Nachdem die Planungsfunktion einen @entity_type veröffentlicht hat"

msgid "After Scheduler has unpublished a @entity_type"
msgstr "Nachdem die Planungsfunktion die Veröffentlichung eines @entity_type zurückgenommen hat"

msgid "@entity_type_label type is enabled for scheduled publishing"
msgstr "Der Typ @entity_type_label ist für die geplante Veröffentlichung aktiviert"

msgid "@entity_type_label"
msgstr "@entity_type_label"

msgid "The @entity_type_singular to check for the type being enabled for scheduled publishing."
msgstr "@entity_type_singular für die Überprüfung des Typs, der für die geplante Veröffentlichung aktiviert wird."

msgid "@entity_type_label type is enabled for scheduled unpublishing"
msgstr "Der Typ @entity_type_label ist für das geplante Zurücknehmen der Veröffentlichung aktiviert"

msgid "The @entity_type_singular to check for the type being enabled for scheduled unpublishing."
msgstr "@entity_type_singular für die Überprüfung des Typs, der für das geplante Zurücknehmen der Veröffentlichung aktiviert wird."

msgid "@entity_type_label is scheduled for publishing"
msgstr "@entity_type_label ist für die Veröffentlichung geplant"

msgid "The @entity_type_singular to check for having a scheduled publishing date."
msgstr "@entity_type_singular für die Überprüfung eines geplanten Veröffentlichungsdatums."

msgid "@entity_type_label is scheduled for unpublishing"
msgstr "@entity_type_label ist für das Zurücknehmen der Veröffentlichung geplant"

msgid "The @entity_type_singular to check for having a scheduled unpublishing date."
msgstr "@entity_type_singular für die Überprüfung auf ein geplantes Datum für das Zurücknehmen der Veröffentlichung."

msgid "Node type is enabled for scheduled publishing"
msgstr "Für den Knotentyp ist die geplante Veröffentlichung aktiviert"

msgid "Content (Scheduler)"
msgstr "Inhalt (Scheduler)"

msgid "The node to check for the type being enabled for scheduled publishing."
msgstr "Der Knoten, der auf den für die geplante Veröffentlichung aktivierten Typ überprüft werden soll."

msgid "Node is scheduled for publishing"
msgstr "Für den Knoten ist die Veröffentlichung geplant"

msgid "The node to check for having a scheduled publishing date."
msgstr "Der Knoten, der auf ein geplantes Veröffentlichungsdatum überprüft werden soll."

msgid "Node is scheduled for unpublishing"
msgstr "Für den Knoten ist das Zurücknehmen der Veröffentlichung geplant"

msgid "The node to check for having a scheduled unpublishing date."
msgstr "Der Knoten, der auf ein geplantes Datum für das Zurücknehmen der Veröffentlichung überprüft werden soll."

msgid "Node type is enabled for scheduled unpublishing"
msgstr "Für den Knotentyp ist das geplante Zurücknehmen der Veröffentlichung aktiviert"

msgid "The node to check for the type being enabled for scheduled unpublishing."
msgstr "Der Knoten, der auf den für das geplante Zurücknehmen der Veröffentlichung aktivierten Typ überprüft werden soll."

msgid "scheduled publishing"
msgstr "geplante Veröffentlichung"

msgid "scheduled unpublishing"
msgstr "geplante Zurücknahme der Veröffentlichung"

msgid "@bundle_label is enabled for @activity"
msgstr "@bundle_label ist für @activity aktiviert"

msgid "@type settings"
msgstr "@type Einstellungen"

msgid "Action %action is not valid because @activity is not enabled for %type @group. Add the condition %condition to your Reaction Rule, or enable @activity via the <a href=\"@url\">%type</a> settings."
msgstr "Aktion %action ist ungültig, da @activity für %type @group nicht aktiviert ist. Fügen Sie die Bedingung %condition zu Ihrer Reaktionsregel hinzu oder aktivieren Sie @activity über die Einstellungen für <a href=\"@url\">%type</a>."

msgid "Action %action is not valid because @activity is not enabled for %type @group. Add the condition %condition to your Reaction Rule, or enable @activity via the %type settings."
msgstr "Aktion %action ist ungültig, da @activity für %type @group nicht aktiviert ist. Fügen Sie die Bedingung %condition zu Ihrer Reaktionsregel hinzu oder aktivieren Sie @activity über die Einstellungen für %type."

msgid "Set date for publishing a @entity_type_singular"
msgstr "Datum für die Veröffentlichung von @entity_type_singular festlegen"

msgid "@entity_type_label for scheduling"
msgstr "@entity_type_label für Terminierung"

msgid "The @entity_type_singular which is to have a scheduled publishing date set"
msgstr "@entity_type_singular, für den ein geplantes Veröffentlichungsdatum festgelegt werden soll"

msgid "Date for publishing"
msgstr "Datum der Veröffentlichung"

msgid "The date when Scheduler will publish the @entity_type_singular"
msgstr "Das Datum, an dem @entity_type_singular von der Planungsfunktion veröffentlicht wird"

msgid "Set date for unpublishing a @entity_type_singular"
msgstr "Datum für das Zurücknehmen der Veröffentlichung von @entity_type_singular festlegen"

msgid "The @entity_type_singular which is to have a scheduled unpublishing date set"
msgstr "@entity_type_singular, für den ein geplantes Datum für das Zurücknehmen der Veröffentlichung festgelegt werden soll"

msgid "Date for unpublishing"
msgstr "Datum für das Zurücknehmen der Veröffentlichung"

msgid "The date when Scheduler will unpublish the @entity_type_singular"
msgstr "Das Datum, an dem die Veröffentlichung von @entity_type_singular von der Planungsfunktion zurückgenommen wird"

msgid "Remove date for publishing a @entity_type_singular"
msgstr "Datum für Veröffentlichung von @entity_type_singular entfernen"

msgid "The @entity_type_singular from which to remove the scheduled publishing date"
msgstr "@entity_type_singular, aus dem das geplante Veröffentlichungsdatum entfernt werden soll"

msgid "Remove date for unpublishing a @entity_type_singular"
msgstr "Datum zum Zurücknehmen der Veröffentlichung von @entity_type_singular entfernen"

msgid "The @entity_type_singular from which to remove the scheduled unpublishing date"
msgstr "@entity_type_singular, aus dem das geplante Datum zum Zurücknehmen der Veröffentlichung entfernt werden soll"

msgid "Publish a @entity_type_singular immediately"
msgstr "@entity_type_singular sofort veröffentlichen"

