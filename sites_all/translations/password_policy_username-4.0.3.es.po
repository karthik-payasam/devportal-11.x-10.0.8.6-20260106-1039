msgid "Password Username Policy"
msgstr "Política de nombre de usuario en contraseñas"

msgid "Restrict users from having their username in their password."
msgstr "Impide a los usuarios tener su nombre de usuario en la contraseña."

msgid "Security"
msgstr "Seguridad"

msgid "Disallow username"
msgstr "No permitir nombre de usuario"

msgid "Password must not contain the username."
msgstr "La contraseña no puede contener el nombre de usuario."

msgid "Prevent user from having a password containing their username."
msgstr "Impedir que el usuario incluya su nombre de usuario en la contraseña."

msgid "Password must not contain the user's username."
msgstr "La contraseña no puede contener el nombre del usuario."

msgid "Password username"
msgstr "Nombre de usuario de contraseña"

msgid "Password must not contain their username"
msgstr "La contraseña no puede contener el nombre de usuario"

msgid "Your password contains your username."
msgstr "La contraseña contiene su nombre de usuario."

