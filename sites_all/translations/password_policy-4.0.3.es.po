msgid "Policy"
msgstr "Política"

msgid "Status"
msgstr "Estado"

msgid "Constraint"
msgstr "Restringir"

msgid "There are no constraints for the selected user roles"
msgstr "No hay restricciones para los roles de usuario seleccionados"

msgid "The password does not satisfy the password policies."
msgstr "La contraseña no satisface las políticas de contraseñas."

msgid "Your password has expired. Please visit the following link to reset your password: :link"
msgstr "La contraseña ha caducado. Por favor, visite el siguiente enlace para restablecer su contraseña: :enlace"

msgid "Your password will expire in less than :pending days. Please visit the following link to reset your password: :link"
msgstr "La contraseña caducará en menos de: días pendientes. Por favor, visite el siguiente enlace para restablecer su contraseña: :enlace"

msgid "You need to reset your password."
msgstr "Es necesario restablecer la contraseña."

msgid "Your password will expire soon."
msgstr "Su contraseña caducará pronto."

msgid "The Password Policy module has updated user accounts. Total update count: @count"
msgstr "El módulo Política de contraseñas ha actualizado las cuentas de usuario. Número total de actualizaciones: @count"

msgid "Password Policy"
msgstr "Política de contraseñas"

msgid "Sets up constraints and expiration of passwords."
msgstr "Configura restricciones y caducidad de contraseñas."

msgid "Security"
msgstr "Seguridad"

msgid "Add Policy"
msgstr "Añadir política"

msgid "Configuring security settings."
msgstr "Configurando parámetros de seguridad."

msgid "Create password policies."
msgstr "Crear políticas de contraseña."

msgid "Manage password reset"
msgstr "Gestionar restablecimiento de contraseñas"

msgid "Be able to manually override user password reset dates."
msgstr "Poder sustituir manualmente las fechas de restablecimiento de contraseña."

msgid "Force Password Reset"
msgstr "Forzar restablecimiento de contraseña"

msgid "Delete policy"
msgstr "Borrar política"

msgid "Password Policies"
msgstr "Políticas de contraseña"

msgid "Edit password_policy"
msgstr "Editar password_policy"

msgid "Add Password Policy"
msgstr "Añadir política de contraseñas"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "Etiqueta"

msgid "Password reset"
msgstr "Recuperar contraseña"

msgid "Password reset send email"
msgstr "Correo electrónico de restablecimiento de contraseña"

msgid "Password reset pending days"
msgstr "Días pendientes de restablecimiento de contraseña"

msgid "Password reset pending day"
msgstr "Día pendiente de restablecimiento de contraseña"

msgid "Language"
msgstr "Idioma"

msgid "Constraints"
msgstr "Restricciones"

msgid "Show policy table"
msgstr "Mostrar tabla de políticas"

msgid "Roles"
msgstr "Roles"

msgid "Role"
msgstr "Rol"

msgid "Constraint settings"
msgstr "Parámetros de restricciones"

msgid "Password Policy settings"
msgstr "Valores de Política de contraseñas"

msgid "Cron threshold"
msgstr "Umbral de cron"

msgid "Password Blacklist Policy"
msgstr "Política de lista negra de contraseñas"

msgid "Create a blacklist of phrases that cannot be used in passwords."
msgstr "Cree una lista negra de frases que no se pueden utilizar en contraseñas."

msgid "Blacklist"
msgstr "Lista negra"

msgid "Password"
msgstr "Contraseña"

msgid "Match substrings"
msgstr "Emparejar subseries"

msgid "There are restricted terms in your password. Please modify your password."
msgstr "Hay términos restringidos en la contraseña. Modifique la contraseña."

msgid "Your password is on the blacklist. Please choose a different password."
msgstr "La contraseña está en la lista negra. Elija una contraseña diferente."

msgid "Also disallow passwords containing blacklisted passwords"
msgstr "Además, no permitir contraseñas que contengan contraseñas en la lista negra"

msgid "Blacklisted passwords"
msgstr "Contraseñas en la lista negra"

msgid "Password cannot be a member of this list, ignoring case. Enter one password per line."
msgstr "La contraseña no puede ser miembro de esta lista, se ignoran las mayúsculas y minúsculas. Especifique una contraseña por línea."

msgid "Password must not contain any restricted words or phrases."
msgstr "La contraseña no debe contener palabras o frases restringidas."

msgid "Password must not be on the blacklist."
msgstr "La contraseña no debe estar en la lista negra."

msgid "Password Blacklist"
msgstr "Lista negra de contraseñas"

msgid "Password cannot match certain disallowed passwords"
msgstr "La contraseña no puede coincidir con determinadas contraseñas no permitidas"

msgid "Your password contains restricted words or phrases."
msgstr "La contraseña contiene palabras o frases restringidas."

msgid "Password Character Types Policy"
msgstr "Política de tipos de carácter de contraseña"

msgid "Minimum number of different character types the password must contain."
msgstr "El número mínimo de distintos tipos de carácter que debe contener la contraseña. "

msgid "Character Types"
msgstr "Tipos de carácter"

msgid "Invalid plugin configuration."
msgstr "Configuración de plugin no válida."

msgid "Password must contain at least @types types of characters from the following character types: lowercase letters, uppercase letters, digits, special characters."
msgstr "La contraseña debe contener al menos @types tipos de caracteres de los tipos de carácter siguientes: letras minúsculas, letras mayúsculas, dígitos, caracteres especiales. "

msgid "Minimum number of character types"
msgstr "Número mínimo de tipos de carácter"

msgid "Select the minimum number of character types which must be found in a password. The four supported character types are given as: lowercase letters, uppercase letters, digits, special characters."
msgstr "Seleccione el número mínimo de tipos de carácter que tiene que haber en una contraseña. Los cuatro tipos de carácter soportados se dan como: letras minúsculas, letras mayúsculas, dígitos, caracteres especiales. "

msgid "The number of character types must be between 2 and 4."
msgstr "El número de tipos de carácter tiene que situarse entre 2 y 4."

msgid "Minimum password character types: @types"
msgstr "Mínimo de tipos de carácter de contraseña: @types"

msgid "Password character types"
msgstr "Tipos de carácter de contraseña"

msgid "Verifying that a password has a minimum number of character types."
msgstr "Verificando que una contraseña tiene un número mínimo de tipos de carácter."

msgid "Your password must have different character types."
msgstr "La contraseña ha de tener diferentes tipos de carácter."

msgid "Password Characters of Type Policy"
msgstr "Caracteres de contraseña de política de tipo "

msgid "Minimum characters of a particular type the password must contain."
msgstr "El mínimo de caracteres de un tipo concreto que debe contener la contraseña. "

msgid "Number of characters"
msgstr "Número de caracteres"

msgid "Character type"
msgstr "Tipo de carácter"

msgid "Uppercase"
msgstr "Mayúsculas"

msgid "Lowercase"
msgstr "Minúsculas"

msgid "Letter"
msgstr "Letra"

msgid "Numeric"
msgstr "Numérico"

msgid "Special Character"
msgstr "Carácter especial"

msgid "The number of characters must be a positive number."
msgstr "El número de caracteres tiene que ser un número positivo."

msgid "Password must contain at least 1 uppercase character."
msgid_plural "Password must contain at least @count unique uppercase characters."
msgstr[0] "La contraseña debe contener al menos 1 carácter en mayúsculas."
msgstr[1] "La contraseña debe contener al menos @count caracteres exclusivos en mayúsculas."

msgid "Password must contain at least 1 lowercase character."
msgid_plural "Password must contain at least @count unique lowercase characters."
msgstr[0] "La contraseña debe contener al menos 1 carácter en minúsculas."
msgstr[1] "La contraseña debe contener al menos @count caracteres exclusivos en minúsculas."

msgid "Password must contain at least 1 letter character."
msgid_plural "Password must contain at least @count unique letter characters."
msgstr[0] "La contraseña debe contener al menos 1 carácter de letra."
msgstr[1] "La contraseña debe contener al menos @count caracteres exlusivos de letra."

msgid "Password must contain at least 1 special character."
msgid_plural "Password must contain at least @count unique special characters."
msgstr[0] "La contraseña debe contener al menos 1 carácter especial."
msgstr[1] "La contraseña debe contener al menos @count caracteres especiales exclusivos."

msgid "Password must contain at least 1 numeric character."
msgid_plural "Password must contain at least @count unique numeric characters."
msgstr[0] "La contraseña debe contener al menos 1 carácter numérico."
msgstr[1] "La contraseña debe contener al menos @count caracteres numéricos exclusivos."

msgid "Password character type"
msgstr "Tipo de carácter de contraseña"

msgid "Verifying that a password has a specific number of characters"
msgstr "Verificando que una contraseña tiene un determinado número de caracteres"

msgid "The password does not contain a the correct number of certain characters."
msgstr "La contraseña no contiene el número correcto de determinados caracteres."

msgid "Password Consecutive Characters Policy"
msgstr "Política de caracteres consecutivos de contraseña"

msgid "Sets up a consecutive characters constraint for passwords."
msgstr "Configura una restricción de caracteres consecutivos para contraseñas."

msgid "Maximum consecutive character count"
msgstr "Recuento máximo de caracteres consecutivos"

msgid "No consecutive identical characters are allowed."
msgstr "No se permiten caracteres idénticos consecutivos."

msgid "Password must have fewer than @max consecutive identical characters. This is case sensitive."
msgstr "La contraseña debe tener menos de @max caracteres idénticos consecutivos. Esto es sensible a las mayúsculas y minúsculas."

msgid "Consecutive identical characters fewer than: @max"
msgstr "Caracteres idénticos consecutivos menores que: @max"

msgid "Consecutive identical characters fewer than"
msgstr "Caracteres idénticos consecutivos menores que"

msgid "This many or more consecutive identical characters will not be allowed in the password."
msgstr "No se permitirá esta cantidad, o más, de caracteres idénticos consecutivos en la contraseña."

msgid "The number of consecutive identical characters must be higher than 1 otherwise all passwords will fail."
msgstr "El número de caracteres idénticos consecutivos debe ser mayor que 1, de lo contrario todas las contraseñas fallarán."

msgid "Consecutive characters"
msgstr "Caracteres consecutivos"

msgid "Verifying that a password has a maximum number of consecutive identical characters."
msgstr "Verificando que una contraseña tiene un número máximo de caracteres idénticos consecutivos."

msgid "Your password has too many consecutive characters."
msgstr "La contraseña tiene demasiados caracteres consecutivos."

msgid "Password Policy Delay"
msgstr "Retardo de política de contraseñas"

msgid "Sets up a password constraint to limit how soon before a password can be reset again."
msgstr "Configura una restricción de contraseña para limitar la rapidez con la que se puede volver a restablecer una contraseña."

msgid "Hours until next password reset may be performed."
msgstr "Horas que deben pasar hasta el siguiente restablecimiento de contraseña."

msgid ""
"Not enough time has passed\n"
"          since this password was last reset."
msgstr ""
"No ha transcurrido tiempo suficiente\n"
" desde la última vez que se restableció esta contraseña."

msgid "Hours until password can be reset again."
msgstr "Horas hasta que se pueda volver a restablecer la contraseña."

msgid "A value of 0 represents no delay"
msgstr "Un valor de 0 representa que no hay retardo"

msgid "The delay value must be zero or greater."
msgstr "El valor de retardo debe ser cero o mayor."

msgid "Delay in hours until password can be reset: @delay"
msgstr "Retardo en horas hasta que se pueda restablecer la contraseña: @delay"

msgid "Password Delay"
msgstr "Retardo de contraseña"

msgid "Provide delay before password can be reset again."
msgstr "Proporcione un retardo antes de que se pueda volver a restablecer la contraseña."

msgid "You cannot reset your password until the delay has as elapsed."
msgstr "No puede restablecer la contraseña hasta que el retardo haya transcurrido."

msgid "Password Policy History"
msgstr "Historial de política de contraseña"

msgid "Sets up a password constraint to limit repeated use of the same password."
msgstr "Establece una restricción de contraseña para limitar el uso repetido de la misma contraseña."

msgid "Previous passwords cannot be reused. Choose a different password."
msgstr "Las contraseñas anteriores no se pueden reutilizar. Elija una contraseña diferente."

msgid "Number of passwords that will be checked in the user password update history"
msgstr "Número de contraseñas que se comprobarán en el historial de actualizaciones de contraseñas de usuario"

msgid "A value of 0 represents that the user can not repeat any of the old passwords."
msgstr "Un valor de 0 representa que el usuario no puede repetir ninguna de las contraseñas antiguas."

msgid "The number of repeated passwords value must be zero or greater."
msgstr "El número de contraseñas repetidas tiene que cero o mayor."

msgid "Number of passwords that will be checked in the user password update history: @number-repeats"
msgstr "Número de contraseñas que se comprobarán en el historial de actualizaciones de contraseñas de usuario: @number-repeats"

msgid "The last @count password cannot be reused. Choose a different password."
msgid_plural "The last @count passwords cannot be reused. Choose a different password."
msgstr[0] "La última contraseña no se puede reutilizar. Elija una contraseña diferente."
msgstr[1] "Las últimas @count contraseñas no se pueden reutilizar. Elija una contraseña diferente."

msgid "Password History"
msgstr "Historial de contraseñas"

msgid "Provide restrictions on previously used passwords."
msgstr "Proporcione restricciones sobre contraseñas utilizadas previamente."

msgid "You have used the same password previously and cannot."
msgstr "Ha utilizado la misma contraseña anteriormente y no puede."

msgid "Password Character Length Policy"
msgstr "Política de longitud de caracteres de contraseña"

msgid "Sets up a character length constraint for passwords."
msgstr "Configura una restricción de longitud de caracteres en las contraseñas."

msgid "Operation"
msgstr "Operación"

msgid "Minimum length"
msgstr "Longitud mínima"

msgid "Maximum length"
msgstr "Longitud máxima"

msgid "The character length must be a positive number."
msgstr "La longitud de caracteres tiene que ser un número positivo."

msgid "at least"
msgstr "como mínimo "

msgid "at most"
msgstr "como máximo "

msgid "Password length must be at least 1 character."
msgid_plural "Password length must be at least @count characters."
msgstr[0] "La longitud de la contraseña tiene que se como mínimo de 1 carácter."
msgstr[1] "La longitud de la contraseña tiene que ser como mínimo de @count caracteres."

msgid "Password length must not exceed 1 character."
msgid_plural "Password length must not exceed @count characters."
msgstr[0] "La longitud de la contraseña no debe exceder 1 carácter."
msgstr[1] "La longitud de la contraseña no debe exceder @count caracteres."

msgid "Password character length of @operation 1 character"
msgid_plural "Password character length of @operation @characters characters"
msgstr[0] "Longitud de caracteres de contraseña de @operation 1 carácter"
msgstr[1] "Longitud de caracteres de contraseña de @operation @characters caracteres"

msgid "Password character length"
msgstr "Longitud de caracteres de la contraseña"

msgid "Verifying that a password has a minimum character length"
msgstr "Verificando que una contraseña tiene una longitud de caracteres mínima."

msgid "The length of your password is too short."
msgstr "La longitud de la contraseña es demasiado corta."

msgid "Password Username Policy"
msgstr "Política de nombre de usuario en contraseñas"

msgid "Restrict users from having their username in their password."
msgstr "Impide a los usuarios tener su nombre de usuario en la contraseña."

msgid "Disallow username"
msgstr "No permitir nombre de usuario"

msgid "Password must not contain the username."
msgstr "La contraseña no puede contener el nombre de usuario."

msgid "Prevent user from having a password containing their username."
msgstr "Impedir que el usuario incluya su nombre de usuario en la contraseña."

msgid "Password must not contain the user's username."
msgstr "La contraseña no puede contener el nombre del usuario."

msgid "Password username"
msgstr "Nombre de usuario en contraseña"

msgid "Password must not contain their username"
msgstr "La contraseña no puede contener el nombre de usuario"

msgid "Your password contains your username."
msgstr "La contraseña contiene su nombre de usuario."

msgid "@message"
msgstr "@message"

msgid "Pass"
msgstr "Resultado válido"

msgid "New role was added or existing password policy changed. Please update your password."
msgstr "Se ha añadido un rol nuevo o la política de contraseñas existente ha cambiado. Actualice la contraseña."

msgid "Fail - @message"
msgstr "Error - @message"

msgid "Machine name"
msgstr "Nombre de sistema"

msgid "password policy"
msgstr "política de contraseñas"

msgid "password policies"
msgstr "políticas de contraseñas"

msgid "Your password has expired, please update it"
msgstr "La contraseña ha caducado, actualícela"

msgid "Are you sure you want to delete the @label constraint?"
msgstr "¿Está seguro de que desea borrar la restricción @label?"

msgid "Save"
msgstr "Guardar"

msgid "Are you sure you want to delete the %name policy?"
msgstr "¿Está seguro de que desea borrar la política %name?"

msgid "Delete"
msgstr "Eliminar"

msgid "The @label password policy has been deleted."
msgstr "Se ha borrado la política de contraseña @label."

msgid "PASSWORD POLICY"
msgstr "POLÍTICA DE CONTRASEÑAS"

msgid "Policy Name"
msgstr "Nombre de la política"

msgid "Enter label for this context."
msgstr "Especifique la etiqueta para este contexto."

msgid "Password Reset Days"
msgstr "Días de restablecimiento de contraseña"

msgid "User password will reset after the selected number of days. 0 days indicates that passwords never expire."
msgstr "La contraseña de usuario se restablecerá una vez transcurrido el número de días seleccionado. 0 días indica que las contraseñas nunca caducan."

msgid "Send email upon password expiring"
msgstr "Enviar correo electrónico cuando caduque la contraseña"

msgid "If checked, an email will go to each user when their password expires, with a link to the request password reset email page."
msgstr "Si se selecciona esta opción, se enviará un correo electrónico a cada usuario cuando caduque su contraseña, con un enlace a la página de correo electrónico para restablecer la contraseña de solicitud."

msgid "Send pending email days before"
msgstr "Enviar correo electrónico pendiente días antes"

msgid "Send password expiration pending email X days before expiration. 0 days indicates this email will not be sent. The box above must also be checked. Separate by comma if sending multiple notifications."
msgstr "Enviar correo electrónico pendiente de caducidad de contraseña X días antes de la caducidad. 0 días indica que este correo electrónico no se enviará. También debe marcarse la casilla anterior. Separe por coma si envía varias notificaciones."

msgid "Indicate whether this policy should show the password policy table on the user add/edit form."
msgstr "Indica si esta política debe mostrar la tabla de políticas de contraseñas en el formulario de adición/edición de usuario."

msgid "The password policy %label has been added."
msgstr "Se ha añadido la política de contraseñas %label."

msgid "The password policy was not saved."
msgstr "La política de contraseñas no se ha guardado."

msgid "No password constraint available. Enable one of the modules that has password constraints."
msgstr "No hay ninguna restricción de contraseña disponible. Habilite uno de los módulos que tiene restricciones de contraseña."

msgid "Add Constraint"
msgstr "Añadir restricción "

msgid "Configure Constraint Settings"
msgstr "Configurar parámetros de restricción"

msgid "Policy Constraints"
msgstr "Restricciones de política "

msgid "Plugin Id"
msgstr "ID del plugin"

msgid "Summary"
msgstr "Resumen"

msgid "Operations"
msgstr "Operaciones"

msgid "No constraints have been configured."
msgstr "No se ha configurado ninguna restricción."

msgid "Apply to Roles"
msgstr "Aplicar a roles"

msgid "Select Roles to which this policy applies."
msgstr "Seleccione los roles a los que se aplica esta política."

msgid "Edit"
msgstr "Editar"

msgid "Configure Required Context"
msgstr "Configurar Contexto Requerido"

msgid "Force password reset of selected roles."
msgstr "Forzar restablecimiento de contraseña en los roles seleccionados."

msgid "Exclude Myself"
msgstr "Excluirme a mí mismo"

msgid "Exclude your account if you are included in the roles."
msgstr "Excluya su cuenta si está incluido en los roles."

msgid "No roles selected."
msgstr "No hay roles seleccionados."

msgid "Reset the %roles role."
msgid_plural "Reset the %roles roles."
msgstr[0] "Restablecer el rol %roles ."
msgstr[1] "Restablecer los roles %roles ."

msgid "Unique name"
msgstr "Nombre exclusivo"

msgid "Configuration"
msgstr "Configuración"

