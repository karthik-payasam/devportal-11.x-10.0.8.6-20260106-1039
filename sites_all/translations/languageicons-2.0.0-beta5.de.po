msgid "This module manages language icons for multilingual sites:"
msgstr "Dieses Modul verwaltet Spachicons für mehrsprachige Websites:"

msgid "Automatically adds icons to language links."
msgstr "Symbole automatisch zu Sprachlinks hinzufügen."

msgid "Provides related theme functions."
msgstr "Stellt zugehörige Theme Funktionen zur Verfügung."

msgid "For more information, please see <a href=\"@handbook\">the online handbook section</a>."
msgstr "Weitere Informationen finden Sie im entsprechenden <a href=\"@handbook\">Abschnitt des Onlinehandbuchs</a>."

msgid "To enable multilingual support for specific content types go to <a href=\"@configure_content_types\">configure content types</a>."
msgstr "Die mehrsprachige Unterstützung kann für bestimmte Inhaltstypen in <a href=\"@configure_content_types\">Inhaltstypen konfigurieren</a> aktiviert werden."

msgid "Language Icons"
msgstr "Sprachicons"

msgid "Adds icons to language links."
msgstr "Symbole zu Sprachlinks hinzufügen."

msgid "Multilingual"
msgstr "Mehrsprachenunterstützung"

msgid "Language icons"
msgstr "Language icons"

msgid "Configure the Language Icons module."
msgstr "Das Modul 'Sprachsymbole' konfigurieren."

msgid "Icons"
msgstr "Symbole"

msgid "Language Icons settings"
msgstr "Einstellungen für Sprachensymbole"

msgid "Show the icons on a node"
msgstr "Symbole auf einem Knoten anzeigen"

msgid "Show the icons on the language switcher block"
msgstr "Symbole in einem Sprachumschalterblock anzeigen"

msgid "Add language icons"
msgstr "Sprachicons hinzufügen"

msgid "Link types to add language icons."
msgstr "Linktypen zum Hinzufügen von Sprachicons."

msgid "Node links"
msgstr "Beitraglinks"

msgid "Language switcher block"
msgstr "Block für die Sprachumschaltung"

msgid "These options are currently disabled due to <a href=\":issue_url\">a bug</a> that cannot currently be resolved. They may be reintroduced at a later stage."
msgstr "Diese Optionen sind derzeit aufgrund <a href=\":issue_url\">eines Programmfehlers</a>, der nicht aufgelöst werden kann, inaktiviert. Sie werden möglicherweise zu einem späteren Zeitpunkt erneut eingeführt."

msgid "Icon placement"
msgstr "Anordnung der Icons"

msgid "Before link"
msgstr "Vor dem Link"

msgid "After link"
msgstr "Nach dem Link"

msgid "Replace link"
msgstr "Link ersetzen"

msgid "Where to display the icon, relative to the link title."
msgstr "Wo das Icon angezeigt werden soll, relativ zum Linktitel."

msgid "Icons file path"
msgstr "Dateipfad mit Icons"

msgid "Path for language icons, relative to Drupal installation. \"*\" is a placeholder for language code."
msgstr "Pfad für Sprachsymbole, relativ zur Drupal-Installation. \"*\" ist ein Platzhalter für den Sprachcode."

msgid "Image size"
msgstr "Bildgröße"

msgid "Image size for language icons, in the form \"width x height\"."
msgstr "Bildgröße der Sprachicons, in der Form „Breite x Höhe“."

