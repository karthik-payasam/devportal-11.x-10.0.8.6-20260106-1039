msgid "Autocomplete Deluxe"
msgstr "Completamento automatico Deluxe"

msgid "Enhanced autocomplete using Jquery UI autocomplete."
msgstr "Autocompletamento migliorato utilizzando jQuery UI."

msgid "User interface"
msgstr "Interfaccia utente"

msgid "None"
msgstr "Nessuno"

msgid "The entity '@term' will be added."
msgstr "Verrà aggiunta l'entità '@term'."

msgid "No terms could be found. Please type in order to add a new term."
msgstr "Non è stato possibile trovare termini. Digitare per aggiungere un nuovo termine."

msgid "No results found"
msgstr "Nessun risultato trovato"

msgid "Autocomplete Deluxe widget settings"
msgstr "Impostazioni widget Completamento automatico Deluxe"

msgid "Match Operator"
msgstr "Operatore di corrispondenza"

msgid "Route Name"
msgstr "Nome rotta"

msgid "Size"
msgstr "Dimensione"

msgid "Selection Handler"
msgstr "Gestore Selezione"

msgid "Limit"
msgstr "Limite"

msgid "Min Length"
msgstr "Lunghezza minima"

msgid "Delimiter"
msgstr "Delimitatore"

msgid "Allow \"Not Found\" message"
msgstr "Consenti messaggio \"Non trovato\""

msgid "\"Not Found\" Message"
msgstr "Messaggio \"Non trovato\""

msgid "Allow New Terms"
msgstr "Consentire Nuovi Termini"

msgid "No Empty Message"
msgstr "Nessun Messaggio Vuoto"

msgid "Match operator"
msgstr "Operatore di corrispondenza"

msgid "Specify the matcting operator."
msgstr "Specificare l'operatore di corrispondenza."

msgid "Limit of the output."
msgstr "Limite dell'output."

msgid "If set to zero no limit will be used"
msgstr "Se impostato su zero non verrà utilizzato alcun limite"

msgid "Minimum length."
msgstr "Lunghezza minima."

msgid "The minimum length of characters to enter to open the suggestion list."
msgstr "La lunghezza minima di caratteri da inserire per aprire l'elenco dei suggerimenti."

msgid "Delimiter."
msgstr "Delimitatore."

msgid "A character which should be used beside the enter key, to separate terms."
msgstr "Un carattere che deve essere utilizzato accanto al tasto di inserimento, per separare i termini. "

msgid "Show Term not found message"
msgstr "Messaggio Mostra termine non trovato "

msgid "If this is enabled, a message will be displayed when the term is not found."
msgstr "Se questo è abilitato, verrà visualizzato un messaggio quando il termine non viene trovato."

msgid "Term not found message."
msgstr "Messaggio Termine non trovato. "

msgid "A message text which will be displayed, if the entered term was not found."
msgstr "Un testo di messaggio che verrà visualizzato, se il termine inserito non è stato trovato."

msgid "Allow new terms"
msgstr "Consenti nuovi termini"

msgid "Should it be allowed, that user enter new terms?"
msgstr "Dovesse essere consentito, quell'utente inserirebbe nuovi termini? "

msgid "Empty value message."
msgstr "Messaggio Valore vuoto."

msgid "A text message that will be displayed when the field is focused and it does not contain values."
msgstr "Un messaggio di testo che verrà visualizzato quando il campo è attivato e non contiene valori."

msgid "Match operator: @match_operator"
msgstr "Operatore di corrispondenza: @match_operator"

msgid "Limit: @limit"
msgstr "Limite: @limit"

msgid "Min length: @min_length"
msgstr "Lunghezza min: @min_length"

msgid "Delimiter: @delimiter"
msgstr "Delimitatore: @delimiter"

msgid "Allow Not Found message: @not_found_message_allow"
msgstr "Messaggio Consenti non trovato: @not_found_message_allow"

msgid "Not Found message: @not_found_message"
msgstr "Messaggio Non trovato: @not_found_message"

msgid "Allow new terms: @new_terms"
msgstr "Consentire nuovi termini: @new_terms"

msgid "Empty value message: @no_empty_message"
msgstr "Messaggio valore vuoto: @no_empty_message"

msgid "@not_found_message"
msgstr "@not_found_message"

msgid "@no_empty_message"
msgstr "@no_empty_message"

msgid "Starts with"
msgstr "Inizia con"

msgid "Contains"
msgstr "Contiene"

