msgid "Advagg External Minification: PHP shell_exec"
msgstr "Advagg External Minification: funkcja PHP shell_exec"

msgid "PHP shell_exec is non-functional."
msgstr "Funkcja PHP shell_exec nie działa."

msgid "Check php.ini for safemode or <a href=\"@link\" target=\"_blank\">disable_functions</a>."
msgstr "Sprawdź w pliku php.ini wpis safemode lub <a href=\"@link\" target=\"_blank\">disable_functions</a>."

msgid "Enabled"
msgstr "Włączone"

msgid "AdvAgg External Minification"
msgstr "Zewnętrzna minifikacja AdvAgg"

msgid "Minify Javascript and/or CSS with a command line minifier."
msgstr "Minifikacja kodu Javascript i/lub arkusza CSS za pomocą narzędzia wiersza komend do minifikacji."

msgid "Advanced CSS/JS Aggregation"
msgstr "Zaawansowana agregacja CSS/JS"

msgid "External Minification"
msgstr "Minifikacja zewnętrzna"

msgid "AdvAgg external minification settings."
msgstr "Ustawienia minifikacji zewnętrznej modułu AdvAgg."

msgid "AdvAgg: External Minifiers"
msgstr "AdvAgg: zewnętrzne narzędzia do minifikacji"

msgid "Settings"
msgstr "Ustawienia"

msgid "Command line for external CSS minification."
msgstr "Wiersz komend dla zewnętrznej minifikacji arkusza CSS."

msgid "Whether to use the external CSS minifier if configured."
msgstr "Określa, czy ma być używane zewnętrzne narzędzie do minifikacji arkusza CSS, jeśli jest skonfigurowane."

msgid "Command line for external JavaScript minification."
msgstr "Wiersz komend dla zewnętrznej minifikacji kodu JavaScript."

msgid "Whether to use the external JS minifier if configured."
msgstr "Określa, czy ma być używane zewnętrzne narzędzie do minifikacji kodu JS, jeśli jest skonfigurowane."

msgid "CSS"
msgstr "CSS"

msgid "JavaScript"
msgstr "JavaScript"

msgid "Command Line"
msgstr "Wiersz komend"

msgid "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = input file. <br /> {%IN_URL_ENC%} = url pointing to the input file that has been url encoded. <br /> {%OUT%} = output file. <br /><br />"
msgstr "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = plik wejściowy. <br /> {%IN_URL_ENC%} = adres url wskazujący na plik wejściowy, zakodowany z użyciem kodowania url. <br /> {%OUT%} = plik wyjściowy. <br /><br />"

msgid "Example using the <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"
msgstr "Przykład użycia <a href=\"@link1\">reduktora Microsoft Ajax</a>. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "Przykład z użyciem kompilatora <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"

msgid "Example using curl to minify via the <a href=\"@link1\">Online Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "Przykład użycia komendy curl w celu zredukowania z użyciem kompilatora <a href=\"@link1\">Online Google Closure Compiler</a>. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">YUI Compressor</a>. <p><code>@code1</code></p>"
msgstr "Przykład użycia <a href=\"@link1\">kompresora YUI</a>. <p><code>@code1</code></p>"

msgid "Example using curl to minify via an online <a href=\"@link1\">CSS Minifier</a>. <p><code>@code1</code></p>"
msgstr "Przykład użycia komendy curl w celu zredukowania z użyciem <a href=\"@link1\">reduktora CSS</a>. <p><code>@code1</code></p>"

msgid "Command to run"
msgstr "Komenda do uruchomienia"

msgid "Enable external @type minification"
msgstr "Włącz zewnętrzną minifikację typu @type"

