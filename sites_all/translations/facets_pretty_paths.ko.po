msgid "Pretty paths coder"
msgstr "Pretty 경로 코더"

msgid "Facets Pretty Paths"
msgstr "패싯 Pretty 경로"

msgid "Pretty paths for Facets."
msgstr "패싯용 Pretty 경로"

msgid "Search"
msgstr "찾기"

msgid "Facet Pretty Paths third party settings on the Facet config"
msgstr "패싯 구성의 패싯 프리티 경로 써드파티 설정"

msgid "The coder plugin ID"
msgstr "코더 플러그인 ID"

msgid "Home"
msgstr "홈"

msgid "Pretty paths"
msgstr "Pretty 경로"

msgid "Pretty paths uses slashes as separator, e.g. /brand/drupal/color/blue"
msgstr "Pretty 경로는 슬래시를 구분 기호로 사용합니다. 예: /brand/drupal/color/blue"

msgid "Default"
msgstr "기본값"

msgid "Use the raw value, no special processing is done, e.g. /color/<strong>2</strong>"
msgstr "원시 값을 사용하며 특수 처리가 수행되지 않습니다. 예: /color/<strong>2</strong>"

msgid "Node title + id"
msgstr "노드 제목 + ID"

msgid "Use node title with entity id, e.g. /color/<strong>blue-2</strong>"
msgstr "엔티티 ID에 노드 제목을 사용하십시오. 예: /color/<strong>blue-2</strong>"

msgid "Taxonomy term name + id"
msgstr "택소노미 용어 이름 + ID"

msgid "Use term name with term id, e.g. /color/<strong>blue-2</strong>"
msgstr "용어 ID에 용어 이름을 사용하십시오. 예: /color/<strong>blue-2</strong>"

