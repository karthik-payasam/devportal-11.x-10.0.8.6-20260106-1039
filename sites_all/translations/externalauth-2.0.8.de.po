msgid "External Authentication Map"
msgstr "Zuordnung für externe Authentifizierung"

msgid "Provider"
msgstr "Anbieter"

msgid "The name of the authentication provider providing the authname."
msgstr "Der Name des Authentifizierungsproviders, der den Authentifizierungsnamen (authname) bereitstellt."

msgid "Authname"
msgstr "Authname"

msgid "Unique authentication name provided by authentication provider."
msgstr "Eindeutiger Authentifizierungsname, der vom Authentifizierungsprovider bereitgestellt wird."

msgid "Drupal User ID"
msgstr "Drupal User ID"

msgid "The user linked to the authname."
msgstr "Der Benutzer, der mit dem Authentifizierungsnamen (authname) verknüpft ist."

msgid "Linked Drupal user"
msgstr "Verknüpfter Drupal-Benutzer"

msgid "Link to delete @label entry"
msgstr "Link zum Löschen des Eintrags '@label'"

msgid "Provide a link to delete the @label entry."
msgstr "Geben Sie einen Link zum Löschen des Eintrags '@label' an."

msgid "About"
msgstr "Über"

msgid "Authenticates users using an external site / service and stores identification details."
msgstr "Authentifiziert Benutzer über eine externe Website oder einen externen Service und speichert die Identifikationsdetails."

msgid "External Authentication"
msgstr "Externe Authentifizierung"

msgid "Helper module to authenticate users using an external site / service and storing identification details"
msgstr "Helper-Modul zum Authentifizieren von Benutzern über eine externe Website oder einen externen Service und zum Speichern von Identifikationsdetails"

msgid "User authentication"
msgstr "Benutzerauthentifizierung"

msgid "View external authentication data"
msgstr "Externe Authentifizierungsdaten anzeigen"

msgid "Delete external authentication data"
msgstr "Externe Authentifizierungsdaten löschen"

msgid "Delete authmap entry"
msgstr "Eintrag für die Authentifizierungszuordnung (authmap) löschen"

msgid "Authmap change (%old => %new) for user %name with uid %uid from provider %provider"
msgstr "Änderung an Authmap (%old = > %new) für Benutzer %name mit UID %uid von Provider %provider"

msgid "External registration of user %name from provider %provider and authname %authname"
msgstr "Externe Registrierung von Benutzer %name von Provider %provider und mit Authentifizierungsname %authname"

msgid "External login of user %name"
msgstr "Externe Anmeldung von Benutzer %name"

msgid "Are you sure you want to delete the link between authentication name %id and Drupal user %user?"
msgstr "Möchten Sie den Link zwischen dem Authentifizierungsnamen %id und dem Drupal-Benutzer '%user' wirklich löschen?"

msgid "No authmap record found for provider @provider / uid @uid."
msgstr "Kein authmap-Datensatz für Provider '@provider'/UID '@uid' gefunden."

msgid "The link has been deleted."
msgstr "Der Link wurde gelöscht."

msgid "User’s users.uid."
msgstr "users.uid des Benutzers."

msgid "Unique authentication name."
msgstr "Eindeutiger Authentifizierungsname."

msgid "Module which is controlling the authentication."
msgstr "Modul, das die Authentifizierung steuert."

msgid "delete"
msgstr "Löschen"

msgid "Output the URL as text"
msgstr "Gib die URL als Text aus"

msgid "Use absolute link (begins with \"http://\")"
msgstr "Einen absoluten Link verwenden (beginnt mit „http://“)"

msgid "Enable this option to output an absolute link. Required if you want to use the path as a link destination."
msgstr "Bei dem Aktivieren dieser Option wird ein Link mit absoluter Pfadangabe ausgegeben. Dies ist erforderlich, wenn der Pfad als Ziel eines Links verwendet werden soll."

