msgid "No destination directory provided."
msgstr "Nie podano katalogu docelowego."

msgid "About"
msgstr "O stronie"

msgid "Helper module to quickly import a list of terms with parent structure."
msgstr "Moduł pomocniczy umożliwiający szybkie importowanie listy terminów ze strukturą nadrzędną."

msgid "Term CSV Export/Import"
msgstr "Eksport/import pliku CSV terminów"

msgid "Import and Export Taxonomy terms as csv."
msgstr "Importowanie i eksportowanie terminów systematyki jako pliku csv."

msgid "Taxonomy"
msgstr "Kategorie"

msgid "Import and Export Taxonomy Terms as CSV"
msgstr "Importowanie i eksportowanie terminów systematyki jako pliku CSV"

msgid "Term CSV Import"
msgstr "Import pliku CSV terminów"

msgid "Term CSV Export"
msgstr "Eksport pliku CSV terminów"

msgid "Administer CSV Term Import"
msgstr "Administruj importem pliku CSV terminów"

msgid "Allows a user to import taxonomy terms."
msgstr "Umożliwia użytkownikowi importowanie terminów systematyki."

msgid "CSV Term Import"
msgstr "Import terminów z pliku CSV"

msgid "CSV Term Export"
msgstr "Eksport terminów do pliku CSV"

msgid "The header keys were not included in the import."
msgstr "Klucze nagłówka nie zostały uwzględnione w imporcie."

msgid "Line with \"@part\" could not be parsed. Incorrect number of values: @count."
msgstr "Nie można przeanalizować wiersza zawierającego element \"@part\". Niepoprawna liczba wartości: @count."

msgid "The term @name has multiple matches. Ignoring."
msgstr "Termin @nazwa ma wiele dopasowań. Zostanie on zignorowany."

msgid "The term with id @id already exists and preserve existing terms is checked. No modification has been made."
msgstr "Termin o identyfikatorze @id już istnieje, a opcja zachowywania istniejących terminów jest zaznaczona. Nie dokonano żadnych modyfikacji."

msgid "The Term ID already exists."
msgstr "Ten identyfikator warunku już istnieje."

msgid "More than 1 terms are named @name. Cannot distinguish by name. Try using id export/import."
msgstr "Więcej niż jeden termin ma nazwę @name. Nie można odróżnić ich według nazwy. Spróbuj użyć eksportowania/importowania identyfikatorów."

msgid "The field data <em>@data</em> is not formatted correctly. Please use the export function."
msgstr "Dane pola <em>@data</em> nie są poprawnie sformatowane. Użyj funkcji eksportowania."

msgid "The field data <em>@data</em> could not be imported. Please add the appropriate fields to the vocabulary you are importing into."
msgstr "Nie można zaimportować danych pola <em>@data</em>. Dodaj odpowiednie pola do słownika, do którego importowane są dane."

msgid "Imported @count terms."
msgstr "Liczba zaimportowanych terminów: @count."

msgid "Include Term Ids in export."
msgstr "Dołącz identyfikatory terminów do eksportu."

msgid "Include Term Headers in export."
msgstr "Dołącz nagłówki terminów do eksportu."

msgid "Include extra fields in export."
msgstr "Dołącz dodatkowe pola do eksportu."

msgid "Note that fields are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"
msgstr "Należy zauważyć, że pola są przekształcane w łańcuchy za pomocą elementu <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"

msgid "Export"
msgstr "Eksportuj"

msgid "CSV Data"
msgstr "Dane CSV"

msgid "The formatted term data"
msgstr "Sformatowane dane terminu"

msgid "Input"
msgstr "Dane wejściowe"

msgid "<p><strong>See CSV Export for an example.</strong></p><p>Enter in the form of: <pre>\"name,status,description,format,weight,parent_name,[any_additional_fields];</pre><pre>name,status,description,format,weight,parent_name[;parent_name1;parent_name2;...],[any_additional_fields]\"</pre> or <pre>\"tid,uuid,name,status,revision_id,description,format,weight,parent_name[;parent_name1;parent_name2;...],parent_tid[;parent_tid1;parent_tid2;...],[any_additional_fields];</pre><pre>tid,uuid,name,status,revision_id,description,format,weight,parent_name,parent_tid,[any_additional_fields]\"</pre> Note that <em>[any_additional_fields]</em> are optional and are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>If you need to export from Drupal 7, you can import and modify the view d7exportview.txt found at the root directory of this project</p>"
msgstr "<p><strong>Przykład można znaleźć w sekcji Eksportowanie pliku CSV.</strong></p><p>Wprowadź w formie: <pre>\"nazwa,status,opis,format,waga,nazwa_elementu_nadrzędnego,[dowolne_dodatkowe_pola];</pre><pre>nazwa,status,opis,format,waga,nazwa_elementu_nadrzędnego[;nazwa1_elementu_nadrzędnego;nazwa2_elementu_nadrzędnego;...],[dowolne_dodatkowe_pola]\"</pre> lub <pre>\"tid,uuid,nazwa,status,id_wersji,opis,format,waga,nazwa_elementu_nadrzędnego[;nazwa1_elementu_nadrzędnego;nazwa2_elementu_nadrzędnego;...],tid_elementu_nadrzędnego[;tid_elementu_nadrzędnego1;tid_elementu_nadrzędnego2;...],[dowolne_dodatkowe_pola];</pre><pre>tid,uuid,nazwa,status,id_wersji,opis,format,waga,nazwa_elementu_nadrzędnego,tid_elementu_nadrzędnego,[dowolne_dodatkowe_pola]\"</pre> Należy pamiętać, że <em>[dowolne_dodatkowe_pola]</em> są opcjonalne i że są one przekształcane w łańcuchy za pomocą elementu <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>Jeśli chcesz eksportować z wersji Drupal 7, możesz zaimportować i zmodyfikować widok d7exportview.txt, który znajduje się w katalogu głównym tego projektu.</p>"

msgid "Preserve Vocabularies on existing terms."
msgstr "Zachowaj słowniki dla istniejących terminów."

msgid "Preserve existing terms. This will prevent a term id collision if importing from another install."
msgstr "Zachowaj istniejące terminy. Uniemożliwi to kolizję identyfikatorów terminów podczas importu z innej instalacji."

msgid "Next"
msgstr "Dalej"

msgid "Name"
msgstr "Nazwa"

msgid "Create New Vocabulary"
msgstr "Utwórz nowy słownik"

msgid "Create Vocabulary"
msgstr "Utwórz słownik"

msgid "Are you sure you want to copy @count_terms terms into the vocabulary @vocabulary@preserve_vocabularies?"
msgstr "Czy na pewno chcesz skopiować następującą liczbę terminów: @count_terms do słownika @vocabulary@preserve_vocabularies?"

msgid "Import"
msgstr "Importuj"

