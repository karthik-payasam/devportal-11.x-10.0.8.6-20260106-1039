msgid "External Authentication Map"
msgstr "Dış Kimlik Doğrulama Eşlemi "

msgid "Provider"
msgstr "Sağlayıcı"

msgid "The name of the authentication provider providing the authname."
msgstr "Kimlik doğrulama adını sağlayan kimlik doğrulama sağlayıcısının adı."

msgid "Authname"
msgstr "Kimlik doğrulama adı"

msgid "Unique authentication name provided by authentication provider."
msgstr "Kimlik doğrulama sağlayıcısı tarafından sağlanan benzersiz kimlik doğrulama adı."

msgid "Drupal User ID"
msgstr "Drupal Kullanıcı Kimliği"

msgid "The user linked to the authname."
msgstr "authname ile bağlantılı kullanıcı."

msgid "Linked Drupal user"
msgstr "Bağlantılı Drupal kullanıcısı"

msgid "Link to delete @label entry"
msgstr "@label girişini silme bağlantısı"

msgid "Provide a link to delete the @label entry."
msgstr "@label girişini silmek için bir bağlantı sağlayın."

msgid "About"
msgstr "Hakkında"

msgid "Authenticates users using an external site / service and stores identification details."
msgstr "Harici bir siteyi / hizmeti kullanarak kullanıcıların kimliğini doğrular ve kimlik saptama ayrıntılarını depolar."

msgid "External Authentication"
msgstr "Dış Kimlik Doğrulaması"

msgid "Helper module to authenticate users using an external site / service and storing identification details"
msgstr "Harici bir siteyi / hizmeti kullanarak ve kimlik saptama ayrıntılarını depolayarak kullanıcıların kimliğini doğrulayan yardımcı modül"

msgid "User authentication"
msgstr "Kullanıcı kimlik doğrulaması"

msgid "View external authentication data"
msgstr "Dış kimlik doğrulama verilerini görüntüle"

msgid "Delete external authentication data"
msgstr "Dış kimlik doğrulama verilerini sil"

msgid "Delete authmap entry"
msgstr "authmap girişini sil"

msgid "Authmap change (%old => %new) for user %name with uid %uid from provider %provider"
msgstr "%provider % sağlayıcısından uid %uid ile user %name için authmap değişikliği (%old => %new)"

msgid "External registration of user %name from provider %provider and authname %authname"
msgstr "%name adlı kullanıcının %provider sağlayıcısı ve %authname öğesinden harici kaydı"

msgid "External login of user %name"
msgstr "%name adlı kullanıcının harici oturum açma adı"

msgid "Are you sure you want to delete the link between authentication name %id and Drupal user %user?"
msgstr "%id kimlik doğrulama adı ve Drupal kullanıcısı %user arasındaki bağlantıyı silmek istediğinizden emin misiniz?"

msgid "No authmap record found for provider @provider / uid @uid."
msgstr "@provider / uid @uid için authmap kaydı bulunamadı."

msgid "The link has been deleted."
msgstr "Bağlantı silindi."

msgid "User’s users.uid."
msgstr "Kullanıcının users.uid."

msgid "Unique authentication name."
msgstr "Benzersiz kimlik doğrulaması adı."

msgid "Module which is controlling the authentication."
msgstr "Kimlik doğrulamasını denetleyen modül."

msgid "delete"
msgstr "sil"

msgid "Output the URL as text"
msgstr "URL'yi metin olarak ver"

msgid "Use absolute link (begins with \"http://\")"
msgstr "Mutlak bağlantı kullan (\"http://\" ile başlar)"

msgid "Enable this option to output an absolute link. Required if you want to use the path as a link destination."
msgstr "Mutlak bağlantı çıktısı oluşturmak için bu seçeneği etkinleştirin. Bağlantı hedefi olarak yolu kullanmak istiyorsanız zorunludur."

