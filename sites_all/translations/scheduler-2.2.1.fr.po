msgstr "Saisir une date. L'heure est optionelle."

msgid "The default time is @default_time."
msgstr "L'heure par défaut est @default_time."

msgid "Enter a date and time."
msgstr "Saisir une date et une heure."

msgid "Leave the date blank for no scheduled publishing."
msgstr "Laisser le champ date vide pour ne pas planifier la publication"

