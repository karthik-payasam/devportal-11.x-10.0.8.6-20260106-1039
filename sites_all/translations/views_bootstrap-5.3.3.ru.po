msgid "@style style will not display without the \"@field\" setting."
msgstr "Стиль @style не отображается без параметра \"@field\". "

msgid "About"
msgstr "Информация"

msgid "Uses"
msgstr "Использование"

msgid "Views"
msgstr "Представления"

msgid "Panel title field"
msgstr "Поле заголовка панели"

msgid "- None -"
msgstr "- Не указано -"

msgid "Bootstrap Accordion"
msgstr "Аккордеон Bootstrap"

msgid "Displays rows in a Bootstrap Accordion."
msgstr "Отображает строки в аккордеоне Bootstrap. "

msgid "Card title field"
msgstr "Поле названия карты"

msgid "Select the field that will be used for the card title."
msgstr "Выберите поле для применения в качестве названия карты."

msgid "Card content field"
msgstr "Поле содержимого карты"

msgid "Select the field that will be used for the card content."
msgstr "Выберите поле для применения в качестве содержимого карты."

msgid "Card image field"
msgstr "Поле изображения карты"

msgid "Select the field that will be used for the card image."
msgstr "Выберите поле для применения в качестве изображения карты."

msgid "Bootstrap Cards"
msgstr "Карты Bootstrap"

msgid "Displays rows in a Bootstrap Card Group layout"
msgstr "Отображает строки в группе карт Bootstrap"

msgid "<None>"
msgstr "<Нет>"

msgid "Interval"
msgstr "Интервал"

msgid "The amount of time to delay between automatically cycling an item. If false, carousel will not automatically cycle."
msgstr "Задержка автоматической прокрутки элемента. Значение false позволяет выключить автоматическую прокрутку карусели. "

msgid "Show navigation"
msgstr "Показать навигацию"

msgid "Show indicators"
msgstr "Показать индикаторы"

msgid "Pause on hover"
msgstr "Пауза при наведении курсора"

msgid "Pauses the cycling of the carousel on mouseenter and resumes the cycling of the carousel on mouseleave."
msgstr "Приостанавливает прокрутку карусели при наведении указателя мыши и возобновляет прокрутку после выхода указателя мыши за пределы карусели. "

msgid "Wrap"
msgstr "Переход"

msgid "The carousel should cycle continuously or have hard stops."
msgstr "Карусель может быть зациклена или иметь фиксированные остановки. "

msgid "Image"
msgstr "Изображение"

msgid "Title"
msgstr "Заголовок"

msgid "Description"
msgstr "Описание"

msgid "Bootstrap Carousel"
msgstr "Карусель Bootstrap"

msgid "Displays rows in a Bootstrap Carousel."
msgstr "Отображает строки в карусели Bootstrap. "

msgid "Button text"
msgstr "Текст на кнопке"

msgid "Default"
msgstr "По умолчанию"

msgid "Primary"
msgstr "Первичный"

msgid "Success"
msgstr "Успешно"

msgid "Info"
msgstr "Инфо"

msgid "Warning"
msgstr "Предупреждение"

msgid "Wrapper class"
msgstr "Класс обёртки"

msgid "The class to provide on the wrapper, outside the list."
msgstr "Класс обертки списка."

msgid "List class"
msgstr "Класс списка"

msgid "The class to provide on the list element itself."
msgstr "Класс, предоставляемый непосредственно самому элементу списка."

msgid "Alignment"
msgstr "Выравнивание"

msgid "Horizontal"
msgstr "Горизонтально"

msgid "Vertical"
msgstr "Вертикально"

msgid "Default column classes"
msgstr "Классы для колонок по умолчанию"

msgid "Add the default views column classes like views-col, col-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Добавить классы по умолчанию для колонок представлений, например, views-col, col-1 и clearfix в вывод. Это можно использовать для уменьшения количества разметки, генерируемой представлениями по умолчанию ценой уменьшения удобства применения CSS."

msgid "Custom column class"
msgstr "Пользовательский класс столбца"

msgid "Additional classes to provide on each column. Separated by a space."
msgstr ""
"Дополнительные классы для каждой колонки.\r\n"
"Разделённые пробелом."

msgid "You may use field tokens from as per the \"Replacement patterns\" used in \"Rewrite the output of this field\" for all fields."
msgstr "Вы можете использовать токены полей в соответствии с подстановочными шаблонами, используемыми в разделе \"Переписать вывод этого поля\" для всех полей."

msgid "Default row classes"
msgstr "Классы по умолчанию для строки"

msgid "Adds the default views row classes like views-row, row-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Добавить классы по умолчанию для строк представлений, например, views-row, row-1 и clearfix в вывод. Это можно использовать для уменьшения количества разметки, генерируемой представлениями по умолчанию ценой уменьшения удобства применения CSS."

msgid "Custom row class"
msgstr "Пользовательский класс строки"

msgid "Additional classes to provide on each row. Separated by a space."
msgstr "Дополнительные классы для каждой строки. Разделённые пробелом."

msgid "Bootstrap Grid"
msgstr "Сетка Bootstrap"

msgid "Displays rows in a Bootstrap Grid layout"
msgstr "Отображает строки в сетке Bootstrap "

msgid "Title field"
msgstr "Заголовок полей"

msgid "Select the field that will be used as the title."
msgstr "Выберите поле для применения в качестве заголовка. "

msgid "Bootstrap List Group"
msgstr "Группа списков Bootstrap"

msgid "Displays rows in a Bootstrap List Group."
msgstr "Отображает строки в группе списков Bootstrap. "

msgid "Heading field"
msgstr "Поле заголовка"

msgid "Image field"
msgstr "Поле изображения"

msgid "Body field"
msgstr "Поле тела"

msgid "Image Alignment"
msgstr "Выравнивание изображения"

msgid "Left"
msgstr "Слева"

msgid "Right"
msgstr "Справа"

msgid "Middle"
msgstr "По центру"

msgid "Align the media object image left or right."
msgstr "Выровнять изображение медиаобъекта по левому или правому краю. "

msgid "Bootstrap Media Object"
msgstr "Медиаобъект Bootstrap"

msgid "Displays rows in a Bootstrap Media Object."
msgstr "Отображает строки в медиаобъекте Bootstrap. "

msgid "Tab field"
msgstr "Поле вкладки"

msgid "Select the field that will be used as the tab."
msgstr "Выберите поле для применения в качестве вкладки. "

msgid "Tab Type"
msgstr "Тип вкладки"

msgid "Tabs"
msgstr "Вкладки"

msgid "Pills"
msgstr "Списки"

msgid "List"
msgstr "Список"

msgid "Displays rows in Bootstrap Tabs."
msgstr "Отображает строки на вкладках Bootstrap. "

msgid "Responsive"
msgstr "Адаптивный"

msgid "To make a table scroll horizontally on small devices."
msgstr "Обеспечивает горизонтальную прокрутку таблицы на маленьких устройствах. "

msgid "Bootstrap styles"
msgstr "Стили Bootstrap"

msgid "Striped"
msgstr "В чередованием"

msgid "Bordered"
msgstr "С рамкой"

msgid "Hover"
msgstr "Подсказка"

msgid "Condensed"
msgstr "Сжато"

msgid "Bootstrap Table"
msgstr "Таблица Bootstrap "

msgid "Displays rows in a Bootstrap table."
msgstr "Отображает строки в таблице Bootstrap. "

msgid "Previous"
msgstr "Назад"

msgid "Next"
msgstr "Вперёд"

