msgid "APIC Drush Administration commands"
msgstr "Mandatos de administración Drush de APIC"

msgid "Additional drush admin commands"
msgstr "Mandatos de administración drush adicionales"

msgid "IBM API Developer Portal"
msgstr "Portal del desarrollador de IBM API"

msgid "@theme_name deleted."
msgstr "@theme_name se ha suprimido."

msgid "@module_name deleted."
msgstr "@module_name se ha suprimido."

msgid "All bans cleared."
msgstr "Se han borrado todas las prohibiciones."

msgid "Processing batch delete of users..."
msgstr "Procesando supresión por lotes de usuarios..."

msgid "@theme_name not deleted. It is either still activated or is not a custom theme."
msgstr "@theme_name no se ha suprimido. O bien sigue activado, o bien no es un tema personalizado."

msgid "@module_name not deleted. It is either still activated or is not a custom module."
msgstr "@module_name no se ha suprimido. O bien sigue activado, o bien no es un módulo personalizado."

msgid "Unknown entity type"
msgstr "Tipo de entidad desconocido"

msgid "All entities of type %type deleted."
msgstr "Se han suprimido todas las entidades de tipo %type."

msgid "All nodes of type %type deleted."
msgstr "Se han suprimido todos los nodos de tipo %type."

msgid "All users from user registry %type have been deleted."
msgstr "Se han suprimido todos los usuarios del registro de usuarios %type."

msgid "All users (except admin) have been deleted."
msgstr "Se han suprimido todos los usuarios (excepto admin)."

