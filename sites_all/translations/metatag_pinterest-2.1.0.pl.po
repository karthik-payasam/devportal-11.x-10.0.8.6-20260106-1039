msgid "Metatag: Pinterest"
msgstr "Metaznacznik: Pinterest"

msgid "Provides support for Pinterest's custom meta tags."
msgstr "Udostępnia obsługę niestandardowych metaznaczników serwisu Pinterest."

msgid "SEO"
msgstr "SEO"

msgid "Pinterest: Description"
msgstr "Pinterest: Opis"

msgid "Pinterest: ID"
msgstr "Pinterest: Identyfikator"

msgid "Pinterest: Media"
msgstr "Pinterest: Multimedia"

msgid "Pinterest: No hover"
msgstr "Pinterest: Bez opcji po wskazaniu"

msgid "Pinterest: No pin"
msgstr "Pinterest: Bez przypinania"

msgid "Pinterest: No search"
msgstr "Pinterest: Bez wyszukiwania"

msgid "Pinterest: URL"
msgstr "Pinterest: Adres URL"

msgid "Pinterest"
msgstr "Pinterest"

msgid "A set of meta tags used to control how the site's content is consumed by <a href='https://pinterest.com/'>Pinterest</a>."
msgstr "Zestaw metaznaczników używanych do sterowania korzystaniem z treści serwisu przez serwis <a href='https://pinterest.com/'>Pinterest</a>."

msgid "Description"
msgstr "Opis"

msgid "A one to two sentence description of the content."
msgstr "Opis treści składający się z jednego lub dwóch zdań."

msgid "Id"
msgstr "Identyfikator"

msgid "The Canonical Pinterest object to pin."
msgstr "Kanoniczny obiekt serwisu Pinterest do przypięcia."

msgid "Media"
msgstr "Multimedia"

msgid "The URL of media which should represent the content."
msgstr "Adres URL elementu multimedialnego reprezentującego treść."

msgid "No hover"
msgstr "Bez opcji po wskazaniu"

msgid "Do not show hovering Save or Search buttons, generated by the Pinterest browser extensions."
msgstr "Przyciski Zapisz lub Szukaj dostępne po wskazaniu i generowane przez rozszerzenia przeglądarek serwisu Pinterest nie są wyświetlane."

msgid "No pin"
msgstr "Bez przypinania"

msgid "Do not pin anything from this page. When selected, this option will take precedence over all options below."
msgstr "Nie ma możliwości przypięcia czegokolwiek z tej strony. Jeśli ta opcja zostanie wybrana, to ma priorytet nad wszystkimi opcjami poniżej."

msgid "No search"
msgstr "Bez wyszukiwania"

msgid "Do not allow Pinterest visual search to happen from this page."
msgstr "Na tej stronie nie można wykonywać wyszukiwania wizualnego w serwisie Pinterest."

msgid "URL"
msgstr "Adres URL"

msgid "The URL which should represent the content."
msgstr "Adres URL reprezentujący treść."

