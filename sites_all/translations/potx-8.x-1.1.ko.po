msgid "Generates translation templates from the given Drupal source code in the current working directory."
msgstr "현재 작업 디렉토리에서 제공된 Drupal 소스 코드로부터 변환 템플리트를 생성합니다. "

msgid "Possible potx modes are:"
msgstr "가능한 potx 모드는 다음과 같습니다. "

msgid " single    Single file output mode, every file folded into the single output file (default)."
msgstr " single    단일 파일 출력 모드, 단일 출력 파일로 접힌 모든 파일(기본값). "

msgid " multiple  Multiple file output mode, .info files folded into module .pot files."
msgstr " multiple  다중 파일 출력 모드, module .pot 파일로 접힌 .info 파일. "

msgid " core      Drupal core output mode, .info files folded into general.pot."
msgstr " core      Drupal 코어 출력 모드, general.pot으로 접힌 .info 파일."

msgid "If no files are specified, potx will autodiscover files from the current working directory. You can specify concrete files to look at to limit the scope of the operation."
msgstr "파일이 지정되지 않은 경우에는 potx는 현재 작업 디렉토리에서 파일을 자동으로 발견합니다. 오퍼레이션 범위를 제한하기 위해 보려는 구체적인 파일을 지정할 수 있습니다. "

msgid "Stats"
msgstr "상태"

msgid "Files"
msgstr "파일"

msgid "Strings"
msgstr "문자열들"

msgid "Warnings"
msgstr "경고"

msgid "Errors"
msgstr "오류"

msgid "Done"
msgstr "완료"

msgid "YAML parseing error on file @path: @error"
msgstr "@path 파일에서 YAML 구문 분석 오류: @error"

msgid "This page allows you to generate translation templates for module and theme files. Select the module or theme you wish to generate a template file for. A single Gettext Portable Object (Template) file is generated, so you can easily save it and start translation."
msgstr "이 페이지를 사용하면 모듈과 테마 파일의 변환 템플리트를 생성할 수 있습니다. 템플리트 파일을 생성하려는 모듈이나 테마를 선택하십시오. 단일 Gettext Portable Object(템플리트) 파일이 생성되므로 이를 쉽게 저장하고 변환을 시작할 수 있습니다. "

msgid "PHP tokenizer for Translation template extractor"
msgstr "변환 템플리트 추출기를 위한 PHP tokenizer"

msgid "Available"
msgstr "사용 가능"

msgid "Not available"
msgstr "사용할 수 없음"

msgid "The <a href=\"@tokenizer\">PHP tokenizer functions</a> are required."
msgstr "<a href=\"@tokenizer\">PHP tokenizer 기능</a>이 필수입니다. "

msgid "Translation template extractor"
msgstr "변환 템플리트 추출기"

msgid "Provides a web interface and an API to extract translatable text from the sources of installed components."
msgstr "웹 인터페이스와 API를 제공하여 설치된 컴포넌트의 소스로부터 변환 가능한 텍스트의 압축을 풉니다. "

msgid "Multilingual"
msgstr "다국어"

msgid "Extract"
msgstr "압축 풀기"

msgid "Language independent template"
msgstr "언어 독립 템플리트"

msgid "Template file for @langname translations"
msgstr "@langname 변환을 위한 템플리트 파일"

msgid "Template language"
msgstr "템플리트 언어"

msgid "Export a language independent or language dependent (plural forms, language team name, etc.) template."
msgstr "언어 독립 또는 언어 종속(복수 양식, 언어 팀 이름 등) 템플리트를 내보냅니다. "

msgid "Include translations"
msgstr "변환 포함"

msgid "Include translations of strings in the file generated. Not applicable for language independent templates."
msgstr "생성된 파일에 문자열의 변환을 포함합니다. 언어 종속 템플리트에 적용 가능하지 않습니다. "

msgid "You should select a component to export."
msgstr "내보낼 컴포넌트를 선택해야 합니다. "

msgid "Extract from %name in the %directory directory"
msgstr "%directory 디렉토리에서 %name(으)로부터 압축을 풉니다. "

msgid "Generates output from all files found in this directory."
msgstr "이 디렉토리에서 발견된 모든 파일에서 출력을 생성합니다. "

msgid "Extract from all in directory \"@directory\""
msgstr "\"@directory\" 디렉토리의 모두에서 압축을 풉니다. "

msgid "To extract from a single component in this directory, choose the desired entry in the fieldset below."
msgstr "이 디렉토리에서 단일 컴포넌트로부터 압축을 풀려면 아래의 필드 세트에서 원하는 항목을 선택하십시오. "

msgid "Directory \"@directory\""
msgstr "\"@directory\" 디렉토리"

msgid "Extract from %name"
msgstr "%name에서 압축 풀기"

msgid "Extract from files named %pattern in the %directory directory."
msgstr "%directory 디렉토리에서 이름이 %pattern인 파일에서 압축을 풉니다. "

