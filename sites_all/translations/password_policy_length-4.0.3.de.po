msgid "Password Character Length Policy"
msgstr "Richtlinie für die Kennwortzeichenlänge"

msgid "Sets up a character length constraint for passwords."
msgstr "Konfiguriert eine Zeichenlängenbeschränkung für Kennwörter."

msgid "Security"
msgstr "Sicherheit"

msgid "Number of characters"
msgstr "Anzahl Zeichen"

msgid "Operation"
msgstr "Operation"

msgid "Minimum length"
msgstr "Mindestlänge"

msgid "Maximum length"
msgstr "Maximale Länge"

msgid "The character length must be a positive number."
msgstr "Die Zeichenlänge muss eine positive Zahl sein."

msgid "at least"
msgstr "mindestens"

msgid "at most"
msgstr "höchstens"

msgid "Password length must be at least 1 character."
msgid_plural "Password length must be at least @count characters."
msgstr[0] "Das Kennwort muss aus mindestens 1 Zeichen bestehen."
msgstr[1] "Das Kennwort muss aus mindestens @count Zeichen bestehen."

msgid "Password length must not exceed 1 character."
msgid_plural "Password length must not exceed @count characters."
msgstr[0] "Das Kennwort darf aus maximal 1 Zeichen bestehen."
msgstr[1] "Das Kennwort darf aus maximal @count Zeichen bestehen."

msgid "Password character length of @operation 1 character"
msgid_plural "Password character length of @operation @characters characters"
msgstr[0] "Kennwortzeichenlänge von @characters für @operation - 1 Zeichen"
msgstr[1] "Kennwortzeichenlänge von @characters für @operation - @characters Zeichen"

msgid "Password character length"
msgstr "Kennwortzeichenlänge"

msgid "Verifying that a password has a minimum character length"
msgstr "Überprüfen, ob ein Kennwort eine Mindestzeichenlänge aufweist."

msgid "The length of your password is too short."
msgstr "Ihr Kennwort ist zu kurz."

