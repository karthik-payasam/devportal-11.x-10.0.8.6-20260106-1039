msgid "About"
msgstr "Over"

msgid "DropzoneJS"
msgstr "DropzoneJS"

msgid "or"
msgstr "of"

msgid "Select file"
msgid_plural "Select files"
msgstr[0] "Bestand selecteren"
msgstr[1] "Bestanden selecteren"

msgid "Dropzone library missing"
msgstr "Dropzone-bibliotheek ontbreekt"

msgid ""
"Dropzonejs requires the dropzone.min.js library.\n"
"        Download it (https://github.com/enyo/dropzone) and place it in the\n"
"        libraries folder (/libraries)"
msgstr "Dropzonejs gebruikt de dropzone.min.js-bibliotheek. Download de bibliotheek (https://github.com/enyo/dropzone) en plaats deze in de libraries-map (/libraries)"

msgid "dropzonejs"
msgstr "dropzonejs"

msgid "The Drupal integration for DropzoneJS."
msgstr "De Drupal-integratie voor DropzoneJS."

msgid "Media"
msgstr "Media"

msgid "Dropzone upload files"
msgstr "Upload-dropzone"

msgid "Allow uploading of files via dropzonejs."
msgstr "Maakt het mogelijk om bestanden te uploaden via dropzonejs."

msgid "DropzoneJS settings"
msgstr "DropzoneJS-instellingen"

msgid "Upload scheme"
msgstr "Schema uploaden"

msgid "Transliterate names of uploaded files"
msgstr "Namen van geüploade bestanden transcriberen"

msgid "Upload timeout"
msgstr "Timeout in upload"

msgid "Drop files here to upload"
msgstr "Sleep bestanden hierheen om te uploaden"

msgid "Your browser does not support drag'n'drop file uploads."
msgstr "Uw browser ondersteunt het drag-and-drop uploaden van bestanden niet."

msgid "Please use the fallback form below to upload your files like in the olden days."
msgstr "Gebruik het onderstaande formulier om uw bestanden zoals vroeger te uploaden."

msgid "File is too big ({{filesize}}MiB). Max filesize: {{maxFilesize}}MiB."
msgstr "Bestand is te groot ({{filesize}} MiB). Max. bestandsgrootte: {{maxFilesize}}MiB."

msgid "You can't upload files of this type."
msgstr "Upload van dit bestandstype is niet mogelijk."

msgid "Server responded with {{statusCode}} code."
msgstr "Server heeft gereageerd met code {{statusCode}}."

msgid "Cancel upload"
msgstr "Upload annuleren"

msgid "Are you sure you want to cancel this upload?"
msgstr "Weet u zeker dat u deze upload wilt annuleren?"

msgid "Remove file"
msgstr "Verwijder bestand"

msgid "You can not upload any more files."
msgstr "U kunt geen bestanden meer uploaden."

msgid "TB"
msgstr "TB"

msgid "GB"
msgstr "Groot-Britannië"

msgid "MB"
msgstr "MB"

msgid "KB"
msgstr "KB"

msgid "b"
msgstr "b"

msgid "DropzoneJS entity browser widget"
msgstr "DropzoneJS entity browser widget"

msgid "DropzoneJS Entity browser widget."
msgstr "Widget voor DropzoneJS-entiteitenbrowser."

msgid "DropzoneJS widget configuration"
msgstr "Configuratie van DropzoneJS-widget"

msgid "Submit button text"
msgstr "Tekst voor verzendknop"

msgid "Automatically submit selection"
msgstr "Selectie automatisch indienen"

msgid "Upload location"
msgstr "Upload-locatie"

msgid "Dropzone drag-n-drop zone text"
msgstr "Dropzone drag-n-drop zone-tekst"

msgid "Maximum size of files"
msgstr "Maximale bestandsgrootte"

msgid "Allowed file extensions"
msgstr "Toegestane bestandsextensies"

msgid "Use clientside resize"
msgstr "Formaatwijziging op de client gebruiken"

msgid "Maximum width"
msgstr "Maximumbreedte"

msgid "Maximum height"
msgstr "Maximumhoogte"

msgid "Resize quality"
msgstr "Kwaliteit van formaatwijziging"

msgid "Method used for resizing"
msgstr "Methode gebruikt voor formaatwijziging"

msgid "Method used for generating the thumbnail"
msgstr "Methode gebruikt voor het genereren van de miniatuur"

msgid "Media Entity DropzoneJS widget configuration"
msgstr "Configuratie widget DropzoneJS van media-entiteit"

msgid "Media type"
msgstr "Mediatype"

msgid "Media Entity DropzoneJS with edit widget configuration"
msgstr "Configuratie widget DropzoneJS van media-entiteit met bewerking"

msgid "Form mode"
msgstr "Formuliermodus"

msgid "Drop files here to upload them"
msgstr "Plaats hier bestanden om ze te uploaden"

msgid "File upload"
msgstr "Bestandsupload"

msgid "Files could not be uploaded because the destination directory %destination is not configured correctly."
msgstr "Bestanden konden niet worden geüpload omdat de doelmap %destination niet goed geconfigureerd is."

msgid "Some files that you are trying to upload did not pass validation. Requirements are: max file %size, allowed extensions are %extensions"
msgstr "Enkele bestanden die werden geüpload zijn niet door de validatie gekomen. Vereisten zijn: maximale bestandsgrootte %size, toegestane extensies zijn %extensions"

msgid "At least one valid file should be uploaded."
msgstr "Er dient tenminste één geldig bestand te worden geüpload."

msgid "A space separated list of file extensions"
msgstr "Een door spaties gescheiden lijst van bestandsextensies"

msgid "Use client side resizing"
msgstr "Formaatwijziging op de client gebruiken"

msgid "Requires droopzone version v4.4.0 or higher and the <a href=\"@exif\" target=\"_blank\">exif</a> library."
msgstr "Hiervoor is droopzone versie v4.4.0 of hoger vereist, plus de <a href=\"@exif\" target=\"_blank\">exif</a>-bibliotheek."

msgid "Max width"
msgstr "Maximale breedte"

msgid "Max height"
msgstr "Maximale hoogte"

msgid "Resize method"
msgstr "Methode voor formaatwijziging"

msgid "Contain (scale)"
msgstr "Beheersen (schaal aanpassen)"

msgid "Crop"
msgstr "Bijsnijden"

msgid "Thumbnail method"
msgstr "Methode voor miniatuur (thumbnail)"

msgid "Invalid extension list format."
msgstr "Ongeldige indeling van extensielijst."

msgid "Adds DropzoneJS upload integration."
msgstr "Voegt DropzoneJS upload-integratie toe."

msgid "Missing requirement: in order to use this widget you have to install Inline entity form module first"
msgstr "Ontbrekend vereiste: om deze widget te kunnen gebruiken, moet u eerst de module Inline entity form (Inline formulier voor entiteiten)"

msgid "Edit"
msgstr "Bewerken"

msgid "Media Entity DropzoneJS with edit"
msgstr "DropzoneJS van media-entiteit met bewerking"

msgid "Adds DropzoneJS upload integration that saves Media entities and allows to edit them."
msgstr "Hiermee voegt u DropzoneJS-uploadintegratie toe waarmee media-entiteiten worden opgeslagen en kunnen worden bewerkt."

msgid "The type of media entity to create from the uploaded file(s)."
msgstr "Het type media-entiteit dat moet worden gemaakt op basis van de geüploade bestand(en)."

msgid "You must @create_media_type before using this widget."
msgstr "U moet @create_media_type voordat u deze widget gebruikt."

msgid "create a media type"
msgstr "een mediatype maken"

msgid "Media Entity DropzoneJS"
msgstr "Media Entity DropzoneJS"

msgid "Adds DropzoneJS upload integration that saves Media entities."
msgstr "Voegt DropzoneJS upload-integratie toe voor het opslaan van Media-entiteiten."

msgid "For security reasons, your upload has been renamed to %filename."
msgstr "Om veiligheidsredenen werd de naam van de upload gewijzigd in: %filename"

msgid "The specified file %name could not be uploaded."
msgstr "Het bestand %name kon niet worden geüpload."

msgid "The file could not be uploaded because the destination %destination is invalid."
msgstr "Het bestand kon niet worden geupload omdat de doelmap %destination ongeldig is."

msgid "File upload error. Could not move uploaded file."
msgstr "Fout bij uploaden van bestand. Geüpload bestand kon niet verplaatst worden."

msgid "Upload error. Could not move uploaded file %file to destination %destination."
msgstr "Upload fout. Het geüploade bestand %file kon niet naar %destination worden verplaatst."

msgid "The file could not be saved because it exceeds the maximum allowed size for uploads."
msgstr "Het bestand kon niet worden opgeslagen omdat het te groot is."

msgid "The file could not be saved because the upload did not complete."
msgstr "Het bestand kon niet worden opgeslagen omdat de upload niet afgerond werd."

msgid "The file could not be saved. An unknown error has occurred."
msgstr "Het bestand kon niet worden opgeslagen. Een onbekende fout is opgetreden."

msgid "There was a problem while processing the file named @name"
msgstr "Er is een probleem opgetreden tijdens het verwerken van het bestand @name"

msgid "You don't have sufficent permissions to use the DropzoneJS uploader. Contact your system administrator"
msgstr "U bent niet gemachtigd om de DropzoneJS-uploader te gebruiken. Neem contact op met de systeembeheerder."

msgid "A maximum of @count files can be uploaded."
msgstr "Er kunnen maximaal @count bestanden worden geüpload."

msgid "Drop file here to upload it"
msgid_plural "Drop files here to upload them"
msgstr[0] "Bestand hier neerzetten om het te uploaden"
msgstr[1] "Bestanden hier neerzetten om ze te uploaden"

