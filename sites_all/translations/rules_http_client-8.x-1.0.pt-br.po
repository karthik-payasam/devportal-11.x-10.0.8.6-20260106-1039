msgid "Rules HTTP Client"
msgstr "Regras do cliente HTTP"

msgid "Provides an action for making http requests."
msgstr "Fornece uma ação para fazer solicitações de HTTP."

msgid "Rules"
msgstr "Regras"

msgid "Error while requsting url as Error code: %code and Message: %message."
msgstr "Erro ao solicitar a URL como o Código de erro: %code e a Mensagem: %message."

msgid "Request HTTP data"
msgstr "Solicitar dados HTTP"

msgid "Data"
msgstr "Dados"

msgid "URL"
msgstr "URL"

msgid "Url address where to post, get and delete request send."
msgstr "O endereço de URL no qual postar, obter e excluir a solicitação enviada."

msgid "Headers"
msgstr "Cabeçalhos"

msgid "Request headers to send as 'name: value' pairs, one per line (e.g., Accept: text/plain). See <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a> for more information."
msgstr "Cabeçalhos da solicitação a serem enviados como pares de 'nome: valor', um por linha (por exemplo, Accept: text/plain). Consulte <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a> para obter mais informações."

msgid "Method"
msgstr "Método"

msgid "The HTTP request methods like'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH' etc."
msgstr "Os métodos de solicitação de HTTP, como 'HEAD', 'POST', 'PUT', 'DELETE', 'TRACE', 'OPTIONS', 'CONNECT', 'PATCH', etc."

msgid "The request body, formatter as 'param=value&param=value&...' or one 'param=value' per line.."
msgstr "O corpo da solicitação, formatado como 'param=value&param=value&...' ou um 'param=value' por linha."

msgid "Max Redirect"
msgstr "Máximo de redirecionamento"

msgid "How many times a redirect may be followed."
msgstr "Por quantas vezes um redirecionamento pode ser seguido."

msgid "Timeout"
msgstr "Tempo limite"

msgid "The maximum number of seconds the request may take.."
msgstr "O número máximo de segundos que a solicitação pode levar. "

msgid "HTTP data"
msgstr "Dados HTTP"

