msgid "Schema.org Book"
msgstr "Livre Schema.org"

msgid "Adds Schema.org/Book to the JSON LD array."
msgstr "Ajoute Schema.org/Livre au tableau JSON LD."

msgid "SEO"
msgstr "optimisation pour les moteurs de recherche"

msgid "author"
msgstr "auteur"

msgid "@id"
msgstr "@id"

msgid "name"
msgstr "Nom"

msgid "description"
msgstr "Description"

msgid "sameAs"
msgstr "sameAs"

msgid "@type"
msgstr "@type"

msgid "url"
msgstr "url"

msgid "workExample"
msgstr "workExample"

msgid "review"
msgstr "revue"

msgid "aggregateRating"
msgstr "aggregateRating"

msgid "image"
msgstr "image"

msgid "Schema.org: Book"
msgstr "Schema.org : Livre"

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "Evaluation globale de l'élément, basée sur une collection de révisions ou d'évaluations."

msgid "REQUIRED BY GOOGLE. Author of the book."
msgstr "REQUIS PAR GOOGLE. Auteur du livre."

msgid "A description of the item."
msgstr "Description de l'élément."

msgid "RECOMMENDED BY GOOGLE. Globally unique @id, usually a url, used to to link other properties to this object."
msgstr "RECOMMANDE PAR GOOGLE. Identificateur global unique @id, généralement une URL, utilisé pour lier d'autres propriétés à cet objet."

msgid "The primary image for this item."
msgstr "Image principale de cet élément."

msgid "REQUIRED BY GOOGLE. The title of the book."
msgstr "REQUIS PAR GOOGLE. Titre du livre."

msgid "Reviews of this item."
msgstr "Révisions de cet élément."

msgid "RECOMMENDED BY GOOGLE. URL of a reference Web page that unambiguously indicates the item's identity. E.g. the URL of the item's Wikipedia page, Wikidata entry, or official website."
msgstr "RECOMMANDE PAR GOOGLE. URL d'une page Web de référence qui indique sans ambiguïté l'identité de l'élément. ce qui peut vouloir dire, par exemple, que URL de la page Wikipedia, de l'entrée Wikidata ou du site Web officiel de l'élément."

msgid "REQUIRED. The type of this Book"
msgstr "Obligatoire. Type du livre."

msgid "REQUIRED BY GOOGLE. URL to the page on your site about the book. The page may list all available editions."
msgstr "REQUIS PAR GOOGLE. URL de la page relative au livre sur votre site. La page peut répertorier toutes les éditions disponibles."

msgid "REQUIRED BY GOOGLE. An example of the book."
msgstr "REQUIS PAR GOOGLE. Exemple du livre."

