msgid "Metatag: Google Plus"
msgstr "Metatag: Google Plus"

msgid "Provides support for Google's Plus meta tags. Deprecated, will be removed in Metatag 2.0.0."
msgstr "Fornece suporte para metatags do Google Plus. Descontinuado, será removido na Metatag 2.0.0."

msgid "SEO"
msgstr "SEO"

msgid "Google Plus: name"
msgstr "Google Plus: nome"

msgid "Google Plus: image"
msgstr "Google Plus: imagem"

msgid "Google Plus: description"
msgstr "Google Plus: descrição"

msgid "Publisher URL"
msgstr "URL do publicador"

msgid "Author"
msgstr "Autor"

msgid "Google Plus"
msgstr "Google Plus"

msgid "DEPRECATED, use Advanced-Author instead."
msgstr "DESCONTINUADO, use Advanced-Author como alternativa."

msgid "Description"
msgstr "Descrição"

msgid "Content description less than 200 characters."
msgstr "Descrição do conteúdo com menos de 200 caracteres."

msgid "Image"
msgstr "Imagem"

msgid "The URL of an image which should represent the content. For best results use an image that is at least 1200 x 630 pixels in size, but at least 600 x 316 pixels is a recommended minimum. Supports PNG, JPEG and GIF formats."
msgstr "A URL de uma imagem que deve representar o conteúdo. Para obter melhores resultados, use uma imagem com tamanho de pelo menos 1200 x 630 pixels, mas pelo menos 600 x 316 pixels é um mínimo recomendável. Suporta os formatos PNG, JPEG e GIF."

msgid "Name"
msgstr "Nome"

msgid "Content title."
msgstr "Título do conteúdo."

msgid "Used by some search engines to confirm publication of the content on a page. Should be the full URL for the publication's Google+ profile page."
msgstr "Usado por alguns mecanismos de procura para confirmar publicação do conteúdo de uma página. Deve ser a URL completa para a página do perfil do Google+ da publicação."

