msgid "No destination directory provided."
msgstr "Nebyl zadán žádný cílový adresář."

msgid "About"
msgstr "Popis"

msgid "Helper module to quickly import a list of terms with parent structure."
msgstr "Modul pomocníka pro rychlý import seznamu termínů s nadřízenou strukturou."

msgid "Term CSV Export/Import"
msgstr "Export/Import CSV termínu"

msgid "Import and Export Taxonomy terms as csv."
msgstr "Importujte a exportujte taxonomické termíny jako csv."

msgid "Taxonomy"
msgstr "Kategorie"

msgid "Import and Export Taxonomy Terms as CSV"
msgstr "Importovat a exportovat taxonomické termíny jako CSV"

msgid "Term CSV Import"
msgstr "Import CSV termínu"

msgid "Term CSV Export"
msgstr "Export CSV termínu"

msgid "Administer CSV Term Import"
msgstr "Spravovat import termínu CSV"

msgid "Allows a user to import taxonomy terms."
msgstr "Umožňuje uživateli naimportovat taxonomické termíny."

msgid "CSV Term Import"
msgstr "Import termínu CSV"

msgid "CSV Term Export"
msgstr "Export termínu CSV"

msgid "The header keys were not included in the import."
msgstr "Klíče záhlaví nebyly zahrnuty do importu."

msgid "Line with \"@part\" could not be parsed. Incorrect number of values: @count."
msgstr "Řádek s \"@part\" nelze analyzovat. Chybný počet hodnot: @count."

msgid "The term @name has multiple matches. Ignoring."
msgstr "Termín @name má více shod. Ignorování."

msgid "The term with id @id already exists and preserve existing terms is checked. No modification has been made."
msgstr "Termín s ID @id již existuje a je zaškrtnuto zachovávat existující termíny. Nebyla provedena žádná úprava."

msgid "The Term ID already exists."
msgstr "ID termínu již existuje."

msgid "More than 1 terms are named @name. Cannot distinguish by name. Try using id export/import."
msgstr "Více než 1 termín má název @name. Nelze rozlišit podle názvu. Zkuste použít export/import ID."

msgid "The field data <em>@data</em> is not formatted correctly. Please use the export function."
msgstr "Data pole <em>@data</em> není správně naformátována. Použijte funkci exportu."

msgid "The field data <em>@data</em> could not be imported. Please add the appropriate fields to the vocabulary you are importing into."
msgstr "Pole data <em>@data</em> nelze naimportovat. Přidejte příslušná pole do slovníku, do kterého importujete."

msgid "Imported @count terms."
msgstr "Naimportované termíny @count."

msgid "Include Term Ids in export."
msgstr "Zahrňte ID termínů do exportu."

msgid "Include Term Headers in export."
msgstr "Zahrňte záhlaví termínů do exportu."

msgid "Include extra fields in export."
msgstr "Zahrňte další pole do exportu."

msgid "Note that fields are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"
msgstr "Všimněte se, že pole jsou převedeny na řetězec pomocí <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"

msgid "Export"
msgstr "Export"

msgid "CSV Data"
msgstr "Data CSV"

msgid "The formatted term data"
msgstr "Formátovaná data termínu"

msgid "Input"
msgstr "Vstup"

msgid "<p><strong>See CSV Export for an example.</strong></p><p>Enter in the form of: <pre>\"name,status,description,format,weight,parent_name,[any_additional_fields];</pre><pre>name,status,description,format,weight,parent_name[;parent_name1;parent_name2;...],[any_additional_fields]\"</pre> or <pre>\"tid,uuid,name,status,revision_id,description,format,weight,parent_name[;parent_name1;parent_name2;...],parent_tid[;parent_tid1;parent_tid2;...],[any_additional_fields];</pre><pre>tid,uuid,name,status,revision_id,description,format,weight,parent_name,parent_tid,[any_additional_fields]\"</pre> Note that <em>[any_additional_fields]</em> are optional and are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>If you need to export from Drupal 7, you can import and modify the view d7exportview.txt found at the root directory of this project</p>"
msgstr "<p><strong>Příklad viz export CSV.</strong></p><p>Zadejte ve tvaru: <pre>\"name,status,description,format,weight,parent_name,[any_additional_fields];</pre><pre>name,status,description,format,weight,parent_name[;parent_name1;parent_name2;...],[any_additional_fields]\"</pre> nebo <pre>\"tid,uuid,name,status,revision_id,description,format,weight,parent_name[;parent_name1;parent_name2;...],parent_tid[;parent_tid1;parent_tid2;...],[any_additional_fields];</pre><pre>tid,uuid,name,status,revision_id,description,format,weight,parent_name,parent_tid,[any_additional_fields]\"</pre> Všimněte si, že pole <em>[any_additional_fields]</em> jsou volitelná a jsou převedena na řetězec pomocí <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>Pokud potřebujete exportovat z Drupal 7, můžete importovat a upravit pohled d7exportview.txt, který se nachází v kořenovém adresáři tohoto projektu</p>"

msgid "Preserve Vocabularies on existing terms."
msgstr "Zachovejte slovníky u existujících termínů."

msgid "Preserve existing terms. This will prevent a term id collision if importing from another install."
msgstr "Zachovejte existující termíny. Tím se zabrání kolizi ID termínu při importu z jiné instalace."

msgid "Next"
msgstr "Další"

msgid "Name"
msgstr "Jméno"

msgid "Create New Vocabulary"
msgstr "Vytvořit nový slovník"

msgid "Create Vocabulary"
msgstr "Vytvořit slovník"

msgid "Are you sure you want to copy @count_terms terms into the vocabulary @vocabulary@preserve_vocabularies?"
msgstr "Opravdu chcete zkopírovat termíny @count_terms do slovníku @vocalary@preserve_vocabulary?"

msgid "Import"
msgstr "Import"

