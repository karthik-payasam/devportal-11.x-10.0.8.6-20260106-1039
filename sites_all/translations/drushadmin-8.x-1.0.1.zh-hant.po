msgid "APIC Drush Administration commands"
msgstr "APIC Drush 管理指令"

msgid "Additional drush admin commands"
msgstr "其他的 drush 管理指令"

msgid "IBM API Developer Portal"
msgstr "IBM API Developer Portal"

msgid "@theme_name deleted."
msgstr "已刪除 @theme_name。"

msgid "@module_name deleted."
msgstr "已刪除 @module_name。"

msgid "All bans cleared."
msgstr "已清除所有禁止措施。"

msgid "Processing batch delete of users..."
msgstr "正在處理批次刪除使用者作業..."

msgid "@theme_name not deleted. It is either still activated or is not a custom theme."
msgstr "未刪除 @theme_name。 它仍處於已啟動狀態，或者不是自訂模組。"

msgid "@module_name not deleted. It is either still activated or is not a custom module."
msgstr "未刪除 @module_name。 仍處於已啟動狀態，或者不是自訂模組。"

msgid "Unknown entity type"
msgstr "實體類型不明"

msgid "All entities of type %type deleted."
msgstr "已刪除類型為 %type 的所有實體。"

msgid "All nodes of type %type deleted."
msgstr "已刪除類型為 %type 的所有節點。"

msgid "All users from user registry %type have been deleted."
msgstr "已刪除使用者登錄 %type 中的所有使用者。"

msgid "All users (except admin) have been deleted."
msgstr "已刪除所有使用者（管理者除外）。"

