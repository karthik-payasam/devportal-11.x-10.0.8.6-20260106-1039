msgid "Title"
msgstr "Título"

msgid "Populates the title attribute of the link, usually shown as a small tooltip on hover."
msgstr "Rellena el atributo de título del enlace, que suele mostrarse como una pequeña ayuda contextual al pasar el cursor por encima."

msgid "Advanced"
msgstr "Avanzado"

msgid "ARIA label"
msgstr "Etiqueta ARIA"

msgid "Provide an alternative text value/label for assistive technologies."
msgstr "Proporcione un valor/etiqueta de texto alternativo para las tecnologías de asistencia."

msgid "CSS classes"
msgstr "Clases CSS"

msgid "List of CSS classes to add to the link, separated by spaces."
msgstr "Lista de clases CSS que se añaden al enlace, separadas por espacios."

msgid "ID"
msgstr "ID"

msgid "Allows linking to this content using a <a href=\"https://en.wikipedia.org/wiki/Fragment_identifier\" target=\"_blank\">URL fragment</a>. Must be unique."
msgstr "Permite enlazar con este contenido usando un <a href=\"https://en.wikipedia.org/wiki/Fragment_identifier\" target=\"_blank\">fragmento de URL</a>. Tiene que ser exclusivo."

msgid "Open in new window/tab"
msgstr "Abrir en nueva ventana/pestaña"

msgid "See WCAG guidance on <a href=\"https://www.w3.org/WAI/WCAG21/Techniques/general/G200\" target=\"_blank\">opening links in new windows/tabs</a>."
msgstr "Consulte la orientación de WCAG en <a href=\"https://www.w3.org/WAI/WCAG21/Techniques/general/G200\" target=\"_blank\">abrir enlaces en ventanas/pestañas nuevas</a>."

msgid "Relation (rel)"
msgstr "Relación (rel)"

msgid "Often used by JS galleries. When opening links in new windows/tabs, it is advised to add the noopener attribute due to security concerns."
msgstr "Usado con frecuencia por las galerías JS. Al abrir los enlaces en nuevas ventanas/pestañas, se aconseja añadir el atributo noopener por motivos de seguridad."

msgid "Editor Advanced Link"
msgstr "Enlace avanzado del editor"

msgid "Add title, target etc. attributes to Text Editor's link dialog if the text format allows them."
msgstr "Añada atributos de título, destino, etc. al diálogo de enlace del editor de texto si el formato de texto los permite."

msgid "Advanced Link"
msgstr "Enlace avanzado"

msgid "Enabled attributes"
msgstr "Atributos habilitados"

msgid "Enabled attribute"
msgstr "Atributo habilitado"

msgid "The noopener attribute has been added to rel."
msgstr "El atributo nooopener se ha añadido a rel."

msgid "The noopener attribute has been removed from rel."
msgstr "El atributo noopopener no se ha eliminado de rel."

msgid "Link relationship"
msgstr "Enlazar relación"

msgid "Open in new window"
msgstr "Abrir en ventana nueva"

msgid "These are the attributes that will appear when creating or editing links."
msgstr "Estos son los atributos que aparecerán cuando se creen o se editen enlaces."

msgid "@label (<code>@attribute</code>)"
msgstr "@label (<code>@attribute</code>)"

