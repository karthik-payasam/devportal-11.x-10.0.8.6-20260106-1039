msgid "Rules HTTP Client"
msgstr "HTTP 클라이언트 규칙"

msgid "Provides an action for making http requests."
msgstr "HTTP 요청에 대한 조치를 제공합니다."

msgid "Rules"
msgstr "규칙"

msgid "Error while requsting url as Error code: %code and Message: %message."
msgstr "오류 코드: %code 및 메시지: %message(으)로 요청하는 동안 오류가 발생했습니다."

msgid "Request HTTP data"
msgstr "HTTP 데이터 요청"

msgid "Data"
msgstr "데이터"

msgid "URL"
msgstr "URL"

msgid "Url address where to post, get and delete request send."
msgstr "POST, GET, DELETE 요청을 발송할 URL 주소입니다."

msgid "Headers"
msgstr "헤더"

msgid "Request headers to send as 'name: value' pairs, one per line (e.g., Accept: text/plain). See <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a> for more information."
msgstr "헤더에 'name: value' 쌍을 한 줄에 하나씩(예: Accept: text/plain) 한 쌍씩 보내도록 요청합니다. 자세한 정보는 <a href='https://www.wikipedia.org/wiki/List_of_HTTP_header_fields'>wikipedia.org/wiki/List_of_HTTP_header_fields</a>를 참조하십시오."

msgid "Method"
msgstr "메소드"

msgid "The HTTP request methods like'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH' etc."
msgstr "HTTP 요청 방법은 'HEAD','POST','PUT','DELETE','TRACE','OPTIONS','CONNECT','PATCH' 등입니다."

msgid "The request body, formatter as 'param=value&param=value&...' or one 'param=value' per line.."
msgstr "요청 본문은 'param=value&param=value& 형식입니다...' 또는 각 행당 하나의 'param=value'입니다."

msgid "Max Redirect"
msgstr "최대 경로 재지정"

msgid "How many times a redirect may be followed."
msgstr "경로 재지정을 수행할 수 있는 횟수입니다."

msgid "Timeout"
msgstr "제한시간 초과"

msgid "The maximum number of seconds the request may take.."
msgstr "요청에 소요될 수 있는 최대 시간(초).."

msgid "HTTP data"
msgstr "HTTP 데이터"

