msgid "Policies"
msgstr "Richtlinen"

msgid "Report Only"
msgstr "Nur Bericht"

msgid "Enforced"
msgstr "Erzwungen"

msgid "Enable '@type'"
msgstr "'@type' aktivieren"

msgid "Additional Sources"
msgstr "Zusätzliche Quellen"

msgid "Additional domains or protocols to allow for this directive, separated by a space."
msgstr "Zusätzliche Domänen oder Protokolle, die für diese Anweisung zugelassen werden sollen, getrennt durch eine Leerstelle."

msgid "Instead of child-src, nested browsing contexts and workers should use the frame-src and worker-src directives, respectively."
msgstr "Anstelle von child-src sollten verschachtelte Browsing-Kontexte und -Worker die jeweils passenden Anweisungen frame-src und worker-src verwenden."

msgid "Handler"
msgstr "Handler"

msgid "Reset @policyType policy to default values"
msgstr "Richtlinie @policyType auf Standardwerte zurücksetzen"

msgid "No policies are currently enabled."
msgstr "Derzeit sind keine Richtlinien aktiviert."

msgid "%policy %directive has a hash source configured, which may block functionality that relies on inline code."
msgstr "%policy %directive hat eine Hash-Quelle konfiguriert, die Funktionen blockieren kann, die sich auf Inline-Code basieren."

msgid "%policy %directive is enabled without a fallback directive for non-supporting browsers."
msgstr "%policy %directive ist ohne eine Fallback-Direktive für nicht unterstützende Browser aktiviert."

msgid "<a href=\":docUrl\">Nonces must be a unique value for each request</a>, so cannot be set in configuration."
msgstr "<a href=\":docUrl\">Nonces müssen für jede Anfrage ein eindeutiger Wert sein</a>, können also nicht in der Konfiguration eingestellt werden."

msgid "Invalid domain or protocol provided."
msgstr "Ungültige Domäne oder ungültiges Protokoll angegeben."

msgid "Reporting Handler is required for enabled policies."
msgstr "Für aktivierte Richtlinien ist ein Reporting Handler erforderlich."

msgid "Reporting is disabled"
msgstr "Berichterstellung ist inaktiviert"

msgid "Your <a href=\":url\">Report-URI.com subdomain</a>."
msgstr "Ihre <a href=\":url\">Report-URI.com-Unterdomäne</a>."

msgid "Enable Wizard"
msgstr "Assistenten aktivieren"

msgid "Send reports to the <a href=\":url\">CSP Wizard</a> reporting address."
msgstr "Berichte an die Berichterstellungsadresse des <a href=\":url\">CSP-Assistenten</a> senden."

msgid "Reports will be sent to a ReportURI.com account."
msgstr "Die Berichte werden an einen ReportURI.com-Account gesendet."

msgid "Reports will be added to the site log."
msgstr "Berichte werden zum Site-Protokoll hinzugefügt."

msgid "The URI to send reports to."
msgstr "Der URI, an den Berichte gesendet werden sollen."

msgid "Reports will be sent to a URI."
msgstr "Die Berichte werden an einen URI gesendet."

