msgid "No Content Security Policy headers are currently enabled."
msgstr "Derzeit sind keine Content-Security-Policy-Header aktiviert."

msgid "Enable a header via <a href=\":csp-settings\">the Content Security Policy settings</a>."
msgstr "Aktivieren Sie einen Header über <a href=\":csp-settings\">die Content-Security-Policy-Einstellungen</a>."

msgid "Enabling Content Security Policy in Security Kit is likely to cause policy conflicts."
msgstr "Die Aktivierung der Content-Security-Policy im Security-Kit verursacht wahrscheinlich Richtlinienkonflikte."

msgid "Disable the Content Security Policy settings in <a href=\":seckit-settings\">Security Kit configuration</a>."
msgstr "Inaktivieren Sie die Content-Security-Policy-Einstellungen in der <a href=\":seckit-settings\">Security-Kit-Konfiguration</a>."

msgid "Content Security Policy"
msgstr "Inhaltssicherheitsrichtlinie"

msgid "Provide Content-Security-Policy headers"
msgstr "Geben Sie Content-Security-Policy-Header an"

msgid "Configure policy enforcement."
msgstr "Konfigurieren Sie die Richtliniendurchsetzung."

msgid "Administer Content Security Policy"
msgstr "Inhaltssicherheitsrichtlinie verwalten"

msgid "Content Security Policy Settings"
msgstr "Content-Security-Policy-Einstellungen"

msgid "Report-Only Policy"
msgstr "Richtlinie für den ausschließlichen Meldemodus"

msgid "Enforce Policy"
msgstr "Richtlinie durchsetzen"

