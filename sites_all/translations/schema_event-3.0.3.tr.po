msgid "Schema.org: Event"
msgstr "Schema.org: Olay"

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "Öğenin, inceleme ya da değerlendirme toplamına dayalı genel notu."

msgid "RECOMMENDED BY GOOGLE. A description of the event."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Olayın açıklaması."

msgid "The time when admission will commence."
msgstr "Kabulün başlayacağı saat."

msgid "RECOMMENDED BY GOOGLE. Date and time when the event ends."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Olayın sona erdiği tarih ve saat."

msgid "RECOMMENDED BY GOOGLE. The eventAttendanceMode of the event. Valid values are https://schema.org/OfflineEventAttendanceMode, https://schema.org/MixedEventAttendanceMode, or https://schema.org/OnlineEventAttendanceMode."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Olayın eventAttendanceMode değeri. Geçerli değerler şunlardır: https://schema.org/OfflineEventAttendanceMode, https://schema.org/MixedEventAttendanceMode ya da https://schema.org/OnlineEventAttendanceMode."

msgid "RECOMMENDED BY GOOGLE. The status of the event. Valid options are https://schema.org/EventCancelled, https://schema.org/EventMovedOnline, https://schema.org/EventPostponed, https://schema.org/EventRescheduled, or https://schema.org/EventScheduled."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Olayın durumu. Geçerli seçenekler şunlardır: https://schema.org/EventCancelled, https://schema.org/EventMovedOnline, https://schema.org/EventPostponed, https://schema.org/EventRescheduled ya da https://schema.org/EventScheduled."

msgid "Globally unique id of the event, usually a url."
msgstr "Olayın genel olarak benzersiz tanıtıcısı, genellikle bir url."

msgid "RECOMMENDED BY GOOGLE. The primary image for this item."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Bu öğe için birincil resim."

msgid "REQUIRED BY GOOGLE. The location of the event."
msgstr "GOOGLE İÇİN ZORUNLU. Olayın konumu."

msgid "REQUIRED BY GOOGLE. The name of the event."
msgstr "GOOGLE İÇİN ZORUNLU. Olayın adı."

msgid "RECOMMENDED BY GOOGLE. Offers associated with the event."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Olayla ilişkili teklifler."

msgid "RECOMMENDED BY GOOGLE. The organizer of the event."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Olayın organizatörü."

msgid "RECOMMENDED BY GOOGLE. The performer on the event."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Olaydaki gerçekleştirici."

msgid "RECOMMENDED BY GOOGLE. The previousStartDate of the event."
msgstr "GOOGLE TARAFINDAN ÖNERİLİR. Olayın previousStartDate değeri."

msgid "Reviews of this event."
msgstr "Bu olayın incelemeleri."

msgid "REQUIRED BY GOOGLE. Date and time when the event starts."
msgstr "GOOGLE İÇİN ZORUNLU. Olayın başladığı tarih ve saat."

msgid "REQUIRED. The type of event."
msgstr "ZORUNLU. Olayın tipi."

msgid "The URL of the event."
msgstr "Olayın URL adresi."

