msgid "Terms of Use"
msgstr "이용 약관"

msgid "I agree with these terms"
msgstr "이 약관에 동의합니다."

msgid "Terms of use settings"
msgstr "이용 약관 설정"

msgid "Terms of use module form element."
msgstr "이용 약관 모듈 양식 요소입니다."

msgid "Adds terms of Use to the registration page."
msgstr "등록 페이지에 이용 약관을 추가합니다."

msgid "Add Terms of Use to the registration page."
msgstr "등록 페이지에 이용 약관을 추가합니다."

msgid "Terms Of Use Settings"
msgstr "이용 약관 설정"

msgid "Title of the post where your Terms of Use are published"
msgstr "이용 약관이 공개되는 게시물의 제목"

msgid "Node <em>title</em> of the page or story (or blog entry or book page) where your Terms of Use are published."
msgstr "이용 약관이 공개되는 페이지 또는 스토리(또는 블로그 항목이나 문서 페이지)의 노드 <em>제목</em>입니다."

msgid "Label for the fieldset"
msgstr "필드 세트의 레이블"

msgid "The text for the Terms of Use and the [x] checkbox are contained in a fieldset. Type here the title for that fieldset. Leave empty to remove the fieldset"
msgstr "이용 약관에 대한 텍스트와 [x] 선택란이 필드 세트에 포함됩니다. 여기에 해당 필드 세트의 제목을 입력하십시오. 필드 세트를 제거하려면 비워 두십시오."

msgid "Label for the checkbox"
msgstr "선택란 레이블"

msgid "Type here something like \"I agree with these terms.\" or \"I CERTIFY THAT I AM OVER THE AGE OF 18 YEARS OLD.\", without quotes. You can use the token @link to insert a link to the Terms in this label. For example, the label can be: \"I agree with the @link.\", without quotes. You may want to link to the Terms if you prefer not to show the full text of the Terms in the registration form. If you use the token, the Terms will not be shown."
msgstr "\"이들 약관에 동의합니다.\" 또는 \"18세 이상임을 확인합니다.\" 같은 문구를 따옴표 없이 여기에 입력하십시오. @link 토큰을 사용하여 이 레이블에 약관에 대한 링크를 삽입할 수 있습니다. 예를 들어, 레이블은 따옴표 없이 \"@link에 동의합니다.\"일 수 있습니다. 등록 양식에 약관의 전체 텍스트를 표시하지 않으려는 경우 약관에 링크하기 원할 수 있습니다. 토큰을 사용하는 경우 약관은 표시되지 않습니다."

msgid "Open link in new window"
msgstr "링크를 새 창에 열기"

msgid "Should any @link be opened in a new window."
msgstr "새 창에서 @link를 열어야 합니다."

msgid "Display Terms of Use as collapsed"
msgstr "이용 약관을 접힌 상태로 표시"

