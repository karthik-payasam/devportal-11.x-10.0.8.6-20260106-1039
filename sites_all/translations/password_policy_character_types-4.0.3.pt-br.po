msgid "Password Character Types Policy"
msgstr "Política de tipos de caracteres da senha"

msgid "Minimum number of different character types the password must contain."
msgstr "O número mínimo de tipos de caracteres diferentes que a senha deve conter."

msgid "Security"
msgstr "Security"

msgid "Character Types"
msgstr "Tipos de caractere"

msgid "Invalid plugin configuration."
msgstr "Configuração de plug-in inválida."

msgid "Password must contain at least @types types of characters from the following character types: lowercase letters, uppercase letters, digits, special characters."
msgstr "A senha deve conter pelo menos @types tipos de caracteres dos tipos de caracteres a seguir: letras minúsculas, letras maiúsculas, dígitos, caracteres especiais."

msgid "Minimum number of character types"
msgstr "Número mínimo de tipos de caracteres"

msgid "Select the minimum number of character types which must be found in a password. The four supported character types are given as: lowercase letters, uppercase letters, digits, special characters."
msgstr "Selecione o número mínimo de tipos de caracteres que deve ser localizado em uma senha. Os quatro tipos de caracteres suportados são fornecidos como: letras minúsculas, letras maiúsculas, dígitos, caracteres especiais."

msgid "The number of character types must be between 2 and 4."
msgstr "O número de tipos de caracteres deve estar entre dois e quatro."

msgid "Minimum password character types: @types"
msgstr "Tipos de caracteres de senha mínimos: @types"

msgid "Password character types"
msgstr "Tipos de caracteres da senha"

msgid "Verifying that a password has a minimum number of character types."
msgstr "Verificando se uma senha tem um número mínimo de tipos de caracteres"

msgid "Your password must have different character types."
msgstr "Sua senha deve ter diferentes tipos de caracteres."

