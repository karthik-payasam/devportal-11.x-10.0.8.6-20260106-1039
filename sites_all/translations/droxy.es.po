msgid "About"
msgstr "Acerca de"

msgid "Drupal Proxy Module"
msgstr "Módulo de proxy Drupal "

msgid "Drupal Proxy"
msgstr "Proxy Drupal "

msgid "Proxy"
msgstr "Proxy"

msgid "Proxy Settings"
msgstr "Configuración de proxy "

msgid "ProxySettingForm"
msgstr "ProxySettingForm"

msgid "Https or Https"
msgstr "Https o Https"

msgid "type of Scheme"
msgstr "tipo de esquema"

msgid "Proxy Server"
msgstr "Servidor proxy "

msgid "The IP address or hostname of the proxy server."
msgstr "La dirección IP o el nombre de host del servidor proxy. "

msgid "Port"
msgstr "Puerto"

msgid "The port number used by the proxy server for client connections."
msgstr "El número de puerto utilizado por el servidor proxy para conexiones de cliente. "

msgid "Proxy Username"
msgstr "Nombre de usuario de proxy "

msgid "A username used of proxy server for Authentication."
msgstr "Un nombre de usuario utilizado para la autenticación. "

msgid "Proxy Password"
msgstr "Contraseña de proxy "

msgid "Password of proxy server used for Authentication."
msgstr "Contraseña del servidor proxy utilizada para la autenticación. "

msgid "Proxy User Agent"
msgstr "Agente de usuario proxy "

msgid "A string which can be used by the proxy server to identify connection requests."
msgstr "Una serie que puede utilizar el servidor proxy para identificar las solicitudes de conexión. "

msgid "Proxy Exceptions"
msgstr "Excepciones de proxy "

msgid "Specify exceptions using either IP addresses or hostnames. Enter one exception per line. Exceptions will be accessed directly, not via proxy."
msgstr "Especifique excepciones utilizando direcciones IP o nombres de host. Entre una excepción por línea. Se accederá a las excepciones directamente, no a través de proxy."

