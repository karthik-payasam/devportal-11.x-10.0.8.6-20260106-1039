msgid "OpenAPI"
msgstr "OpenAPI"

msgid "Connects Drupal to the OpenAPI Javascript Library"
msgstr "Connecte Drupal à la bibliothèque OpenAPI Javascript"

msgid "Available OpenAPI Documentation."
msgstr "Documentation OpenAPI disponible."

msgid "Access API Docs"
msgstr "Accéder aux documents d'API"

msgid "Access documentation page for the REST API"
msgstr "Accéder à la page de documentation pour l'API REST"

msgid "OpenAPI Schema Download"
msgstr "Téléchargement du schéma OpenAPI"

msgid "OpenAPI Resources"
msgstr "Ressources OpenAPI"

msgid "OpenAPI Documentation"
msgstr "Documentation OpenAPI"

msgid "%label OpenApi Schema Download"
msgstr "Téléchargement du schéma OpenApi %label"

msgid "The specifications provide the documentation on some of Drupal's apis following <a href=':openapi_spec'>OpenAPI (aka Swagger)</a> standards."
msgstr "Les spécifications fournissent la documentation sur certaines API de Drupal après les normes <a href=':openapi_spec'>OpenAPI (aka Swagger)</a>."

msgid "These json files can be used in tools such as the <a href=\":swagger_editor\">Swagger Editor</a> to provide a more detailed version of the API documentation or <a href=\":swagger_codegen\">Swagger Codegen</a> to create an api client."
msgstr "Ces fichier json peuvent être utilisés dans des outils tels que <a href=\":swagger_editor\">Swagger Editor</a> pour fournir une version plus détaillée de la documentation d'API ou <a href=\":swagger_codegen\">Swagger Codegen</a> pour créer un client d'API."

msgid "Module"
msgstr "Module"

msgid "Specification"
msgstr "Spécification"

msgid "Explore"
msgstr "Explorer"

msgid "Please visit the <a href=':openapi_ui_link'>OpenAPI UI module</a> for information on these interfaces and to discover others."
msgstr "Consultez le <a href=':openapi_ui_link'>module d'interface utilisateur OpenAPI</a> pour plus d'informations sur ces interfaces et pour en découvrir d'autres."

msgid "No UI plugins available"
msgstr "Aucun plug-in d'interface utilisateur disponible"

msgid "There are no plugins available for exploring the OpenAPI documentation."
msgstr "Aucun plug-in n'est disponible pour explorer la documentation OpenAPI."

msgid "You can install one of the below projects to view the API Specifications from with your site."
msgstr "Vous pouvez installer l'un des projets ci-dessous pour afficher les spécifications d'API à partir de votre site."

msgid "View/Download"
msgstr "Afficher/Télécharger"

msgid "Explore with %interface"
msgstr "Explorer avec %interface"

msgid "No UI available."
msgstr "Aucune interface utilisateur disponible."

msgid "No OpenApi generator plugins are currently available."
msgstr "Aucun plug-in de générateur OpenApi n'est disponible actuellement."

msgid "You must enable a REST or API module which supports OpenApi Downloads, such as the <a href=\":rest_link\">Core Rest</a> and <a href=\":jsonapi_link\">JSON:API</a> modules."
msgstr "Vous devez activer un module REST ou API qui prend en charge les téléchargements OpenApi, comme les modules <a href=\":rest_link\">Core Rest</a> et <a href=\":jsonapi_link\">JSON:API</a>."

msgid "%generator OpenApi Documentation"
msgstr "Documentation OpenAPI %generator"

