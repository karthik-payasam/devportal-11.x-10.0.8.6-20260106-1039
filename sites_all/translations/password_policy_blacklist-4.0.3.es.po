msgid "Password Blacklist Policy"
msgstr "Política de lista negra de contraseñas"

msgid "Create a blacklist of phrases that cannot be used in passwords."
msgstr "Cree una lista negra de frases que no se pueden utilizar en contraseñas."

msgid "Security"
msgstr "Seguridad"

msgid "Blacklist"
msgstr "Lista negra"

msgid "Password"
msgstr "Contraseña"

msgid "Match substrings"
msgstr "Emparejar subseries"

msgid "There are restricted terms in your password. Please modify your password."
msgstr "Hay términos restringidos en la contraseña. Modifique la contraseña."

msgid "Your password is on the blacklist. Please choose a different password."
msgstr "La contraseña está en la lista negra. Elija una contraseña diferente."

msgid "Also disallow passwords containing blacklisted passwords"
msgstr "Además, no permitir contraseñas que contengan contraseñas en la lista negra"

msgid "Blacklisted passwords"
msgstr "Contraseñas en la lista negra"

msgid "Password cannot be a member of this list, ignoring case. Enter one password per line."
msgstr "La contraseña no puede ser miembro de esta lista, se ignoran las mayúsculas y minúsculas. Especifique una contraseña por línea."

msgid "Password must not contain any restricted words or phrases."
msgstr "La contraseña no debe contener palabras o frases restringidas."

msgid "Password must not be on the blacklist."
msgstr "La contraseña no debe estar en la lista negra."

msgid "Password Blacklist"
msgstr "Lista negra de contraseñas"

msgid "Password cannot match certain disallowed passwords"
msgstr "La contraseña no puede coincidir con determinadas contraseñas no permitidas"

msgid "Your password contains restricted words or phrases."
msgstr "La contraseña contiene palabras o frases restringidas."

