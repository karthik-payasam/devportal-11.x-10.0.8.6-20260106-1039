msgid "Date"
msgstr "Datum"

msgid "Numeric query with set granularity"
msgstr "Numerieke query met ingestelde granulatie"

msgid "Range"
msgstr "Bereik"

msgid "String"
msgstr "Tekenreeks"

msgid "Query string"
msgstr "Query-tekst"

msgid "Query string is the default Facets URL processor, and uses GET parameters, for example ?f[0]=brand:drupal&f[1]=color:blue"
msgstr "Queryreeks (Query String), de standaardprocessor voor facet-URL's, maakt gebruik van GET-parameters, bijvoorbeeld ?f[0]=brand:drupal&f[1]=color:blue"

msgid "Array with raw results"
msgstr "Array met ruwe resultaten"

msgid "A widget that builds an array with results. This widget is not supposed to display any results, but it is needed for rest integration."
msgstr "Een widget waarmee een array met resultaten wordt opgebouwd. Deze widget is niet bedoeld om zelf resultaten af te beelden, maar is wel nodig voor de REST-integratie."

msgid "List of checkboxes"
msgstr "Lijst met keuzevakjes"

msgid "A configurable widget that shows a list of checkboxes"
msgstr "Een configureerbare widget die een lijst van selectievakjes afbeeldt"

msgid "To achieve the standard behavior of a dropdown, you need to enable the facet setting below <em>\"Ensure that only one result can be displayed\"</em>."
msgstr "Om het standaardgedrag van een vervolgkeuzemenu (dropdown) te realiseren, moet u de facetinstelling onder <em>\"Zorgen dat er slechts één resultaat kan worden afgebeeld\"</em> inschakelen."

msgid "Dropdown"
msgstr "Keuzelijst"

msgid "A configurable widget that shows a dropdown."
msgstr "Een configureerbare widget die een vervolgkeuzemenu afbeeldt."

msgid "Show all"
msgstr "Alles weergeven"

msgid "Limit the number of displayed facets via JavaScript."
msgstr "Het aantal afgebeelde facetten beperken via JavaScript."

msgid "This text will be used for \"Show less\" link."
msgstr "Deze tekst wordt gebruikt voor de link \"Minder afbeelden\"."

msgid "This text will be used for \"Show more\" link."
msgstr "Deze tekst wordt gebruikt voor de link \"Meer afbeelden\"."

msgid "Reset text"
msgstr "Reset-tekst"

msgid "List of links"
msgstr "Lijst van links"

msgid "A simple widget that shows a list of links"
msgstr "Een eenvoudige widget die een lijst van links afbeeldt"

msgid "Pre query stage"
msgstr "Pre-querystadium"

msgid "Post query stage"
msgstr "Post-querystadium"

msgid "Sort stage"
msgstr "Sorteerstadium"

msgid "Sort order"
msgstr "Sorteervolgorde"

msgid "Ascending"
msgstr "Oplopend"

msgid "Descending"
msgstr "Aflopend"

msgid "Show the amount of results"
msgstr "Aantal resultaten afbeelden"

