msgid "File key provider settings updated."
msgstr "Обновлены параметры провайдера файловых ключей."

msgid "Key configuration overrides updated."
msgstr "Изменены переопределения конфигурации ключей."

msgid "Key"
msgstr "Ключ"

msgid "Provides the ability to manage site-wide keys."
msgstr "Предоставляет возможность управления ключами на уровне сайта."

msgid "Security"
msgstr "Безопасность"

msgid "Add Key"
msgstr "Добавить ключ"

msgid "Add Override"
msgstr "Добавить переопределение"

msgid "Keys"
msgstr "Ключи"

msgid "Manage site-wide keys."
msgstr "Управление ключами на уровне сайта."

msgid "Key Overrides"
msgstr "Переопределения ключей"

msgid "Administer keys"
msgstr "Администрирование ключей"

msgid "Create, edit, and delete site-wide keys."
msgstr "Создание, изменение и удаление ключей уровня сайта."

msgid "Administer key configuration overrides"
msgstr "Администрирование переопределений конфигурации ключей"

msgid "Add key"
msgstr "Добавить ключ"

msgid "Edit key"
msgstr "Изменить ключ"

msgid "Delete Key"
msgstr "Удалить ключ"

msgid "Key Configuration Overrides"
msgstr "Переопределения конфигурации ключей"

msgid "Add a key configuration override"
msgstr "Добавить переопределение конфигурации ключей"

msgid "Delete Key Configuration Override"
msgstr "Удалить переопределение конфигурации ключей"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "Метка"

msgid "Description"
msgstr "Описание"

msgid "Key type"
msgstr "Тип ключа"

msgid "Key type settings"
msgstr "Параметры типа ключей"

msgid "Key provider"
msgstr "Провайдер ключей"

msgid "Key provider settings"
msgstr "Параметры провайдера ключей"

msgid "Key input"
msgstr "Ввод ключа"

msgid "Key input settings"
msgstr "Параметры ввода ключа"

msgid "Encryption key type settings"
msgstr "Параметры типа ключа шифрования"

msgid "Key size"
msgstr "Длина ключа"

msgid "Configuration key provider settings"
msgstr "Параметры провайдера ключей конфигурации"

msgid "Key value"
msgstr "Значение ключа"

msgid "Base64-encoded"
msgstr "В кодировке Base64"

msgid "File key provider settings"
msgstr "Параметры провайдера файловых ключей"

msgid "File location"
msgstr "Расположение файла"

msgid "Strip trailing line breaks"
msgstr "Удалить концевые символы разрыва строки"

msgid "Environment key provider settings"
msgstr "Параметры провайдера ключей среды"

msgid "Environment variable"
msgstr "Переменная среды"

msgid "Text field key input settings"
msgstr "Параметры ввода ключа текстового поля"

msgid "Textarea field key input settings"
msgstr "Параметры ввода ключа поля текстовой области"

msgid "Generate key input settings"
msgstr "Создать параметры ввода ключа"

msgid "Generated"
msgstr "Сгенерировано"

msgid "Display once"
msgstr "Показывать один раз"

msgid "Key Configuration Override"
msgstr "Переопределение конфигурации ключей"

msgid "Configuration type"
msgstr "Тип конфигурации"

msgid "Configuration prefix"
msgstr "Префикс конфигурации"

msgid "Configuration name"
msgstr "Имя конфигурации"

msgid "Configuration item"
msgstr "Элемент конфигурации"

msgid "Key ID"
msgstr "ИД ключа"

msgid "Commands for managing keys"
msgstr "Команды для управления ключами"

msgid "Save a key. If a key value is defined and the key provider supports setting values, it will be saved. If any options are omitted, default values will be used."
msgstr "Сохраните ключ. Если значение ключа определено и провайдер ключей поддерживает установку значений, то он будет сохранен. Если какие-либо параметры не указаны, то будут использоваться значения по умолчанию."

msgid "Save a key."
msgstr "Сохраните ключ."

msgid "The ID (machine name) of the key to save."
msgstr "ИД (машинное имя) сохраняемого ключа."

msgid "A key value to save. May or may not be allowed or required, depending on the key provider"
msgstr "Сохраняемое значение ключа. Может быть, а может и не быть разрешено или обязательно (это зависит от провайдера ключей)"

msgid "Delete a key."
msgstr "Удалить ключ."

msgid "The ID (machine name) of the key to delete."
msgstr "ИД (машинное имя) удаляемого ключа."

msgid "Display a list of available keys."
msgstr "Показать список доступных ключей."

msgid "An optional, comma-delimited list of key types. To see a list of available key types, use `drush key-type-list`."
msgstr "Необязательный список типов ключей через запятую. Для просмотра списка доступных типов ключей используйте команду `drush key-type-list`."

msgid "An optional, comma-delimited list of key providers. To see a list of available key providers, use `drush key-provider-list`."
msgstr "Необязательный список провайдеров ключей через запятую. Для просмотра списка доступных провайдеров ключей используйте команду `drush key-provider-list`."

msgid "Display a list of available key types."
msgstr "Показать список доступных типов ключей."

msgid "An optional key type group on which to filter."
msgstr "Необязательная группа типов ключей, по которой будет выполняться фильтрация."

msgid "Display a list of available key providers."
msgstr "Показать список доступных провайдеров ключей."

msgid "An optional key provider storage method on which to filter."
msgstr "Необязательный метод хранения провайдера ключей, по которому будет выполняться фильтрация."

msgid "Get a key value."
msgstr "Получить значение ключа."

msgid "The ID (machine name) of the key whose value should be retrieved."
msgstr "ИД (машинное имя) ключа, чье значение должно быть получено."

msgid "Base64-encode the key value. This is useful in the case of binary encryption keys that would otherwise not be displayed in a readable way."
msgstr "Значение ключа в кодировке Base64. Это полезно в случае двоичных ключей шифрования, которые в противном случае будут показываться в нечитаемой форме."

msgid "Print just the key value, and nothing else."
msgstr "Выводить только значение ключа и ничего больше."

msgid "The human-readable label of the key."
msgstr "Метка ключа, предназначенная для пользователей."

msgid "A short description of the key."
msgstr "Краткое описание ключа."

msgid "The key type. To see a list of available key types, use `drush key-type-list`."
msgstr "Тип ключа. Для просмотра списка доступных типов ключей используйте команду `drush key-type-list`."

msgid "Settings specific to the defined key type, in JSON format."
msgstr "Параметры, относящиеся к определенному типу ключа, в формате JSON."

msgid "The key provider. To see a list of available key providers, use `drush key-provider-list`."
msgstr "Провайдер ключей. Для просмотра списка доступных провайдеров ключей используйте команду `drush key-provider-list`."

msgid "Settings specific to the defined key provider, in JSON format."
msgstr "Параметры, относящиеся к определенному провайдеру ключа, в формате JSON."

msgid "The key input method."
msgstr "Метод ввода ключа."

msgid "Settings specific to the defined key input, in JSON format."
msgstr "Параметры, относящиеся к определенному вводу ключа, в формате JSON."

msgid "Key !id does not exist."
msgstr "Ключ !id не существует."

msgid "Be extremely careful when deleting a key! It may result in losing access to a service or making encrypted data unreadable."
msgstr "Следует соблюдать крайнюю осторожность при удалении ключей! Это может привести к потере доступа к службе или к невозможности прочитать зашифрованные данные."

msgid "The following key will be deleted: !id"
msgstr "Следующий ключ будет удален: !id"

msgid "Do you really want to continue?"
msgstr "Вы действительно хотите продолжить?"

msgid "Key !id was not deleted."
msgstr "Ключ !id не удален."

msgid "Key !id was deleted successfully."
msgstr "Ключ !id успешно удален."

msgid "Key !id exists; specify --overwrite to overwrite."
msgstr "Ключ !id существует. Укажите параметр --overwrite для его замены."

msgid "Be extremely careful when overwriting a key! It may result in losing access to a service or making encrypted data unreadable."
msgstr "Следует соблюдать крайнюю осторожность при замене ключей! Это может привести к потере доступа к службе или к невозможности прочитать зашифрованные данные."

msgid "The following key will be saved: !id"
msgstr "Следующий ключ будет сохранен: !id"

msgid "Key !id was not saved."
msgstr "Ключ !id не сохранен."

msgid "Key !id was saved successfully."
msgstr "Ключ !id успешно сохранен."

msgid "User name"
msgstr "Имя пользователя"

msgid "Password"
msgstr "Пароль"

msgid "The following key will be overwritten: !id"
msgstr "Следующий ключ будет заменен: !id"

msgid "Do you want to continue?"
msgstr "Продолжить?"

msgid "The key type. To see a list of available key types, use `drush key:type-list`."
msgstr "Тип ключа. Для просмотра списка доступных типов ключей используйте команду `drush key:type-list`."

msgid "The key provider. To see a list of available key providers, use `drush key:provider-list`."
msgstr "Провайдер ключей. Для просмотра списка доступных провайдеров ключей используйте команду `drush key:provider-list`."

msgid "Override name"
msgstr "Имя переопределения"

msgid "Configuration"
msgstr "Конфигурация"

msgid "No key configuration overrides are available. <a href=\":link\">Add an override</a>."
msgstr "Нет переопределений конфигурации ключей. <a href=\":link\">Добавьте переопределение</a>."

msgid "Type"
msgstr "Тип"

msgid "Provider"
msgstr "Поставщик"

msgid "Overrides"
msgstr "Переопределенные"

msgid "Add Config Override"
msgstr "Добавить переопределение конфигурации"

msgid "No keys are available. <a href=\":link\">Add a key</a>."
msgstr "Нет ключей. <a href=\":link\">Добавьте ключ</a>."

msgid "Choose an available key. If the desired key is not listed, <a href=\":link\">create a new key</a>."
msgstr "Выберите доступный ключ. Если нет требуемого ключа в списке, <a href=\":link\">создайте его</a>."

msgid "Key configuration override name"
msgstr "Имя переопределения конфигурации ключей"

msgid "A human readable name for this override."
msgstr "Имя данного переопределения, показываемое для пользователей."

msgid "Simple configuration"
msgstr "Простая конфигурация"

msgid "Clear overridden value"
msgstr "Очистить значение переопределения"

msgid "Check this field to clear any existing value for the overridden configuration item. This is important to make sure potentially sensitive data is removed from the configuration."
msgstr "Выберите это поле, чтобы очистить все существующие значения для переопределенного элемента конфигурации. Это важно для того, чтобы из конфигурации были удалены потенциально конфиденциальные данные."

msgid "- Select -"
msgstr "- Выберите -"

msgid "@label (@id)"
msgstr "@label (@id)"

msgid "Are you sure you want to delete the override %name?"
msgstr "Вы действительно хотите удалить переопределение %name?"

msgid "Delete"
msgstr "Удалить"

msgid "The override %name has been deleted."
msgstr "Переопределение %name удалено."

msgid "Are you sure you want to delete the key %key?"
msgstr "Вы действительно хотите удалить ключ %key?"

msgid "The key %label has been deleted."
msgstr "Ключ %label удален."

msgid "Edit key %label"
msgstr "Изменить ключ %label"

msgid "Be extremely careful when editing a key! It may result in broken site functionality. Are you sure you want to edit this key?"
msgstr "Следует соблюдать крайнюю осторожность при изменении ключей! Это может привести к повреждению функциональности сайта. Вы действительно хотите изменить этот ключ?"

msgid "Edit"
msgstr "Редактировать"

msgid "Cancel"
msgstr "Отмена"

msgid "Key name"
msgstr "Имя ключа"

msgid "Type settings"
msgstr "Параметры типа"

msgid "Provider settings"
msgstr "Параметры провайдера"

msgid "Value"
msgstr "Значение"

msgid "Key value settings"
msgstr "Параметры значения ключа"

msgid "The key %name has been updated."
msgstr "Ключ %name обновлен."

msgid "The key %name has been added."
msgstr "Ключ %name добавлен."

msgid "The key value has already been generated and will not be changed."
msgstr "Значение ключа уже создано и не будет изменено."

msgid "The key value will be automatically generated using the selected key type settings."
msgstr "Значение ключа будет автоматически создано с помощью выбранных параметров типа ключа."

msgid "Display value"
msgstr "Отображаемое значение"

msgid "Check this to display the generated value once."
msgstr "Включите этот переключатель, чтобы вывести созданное значение один раз."

msgid "A key value of the requested type has been generated and is displayed below as a Base64-encoded string. You will need to decode it to get the actual key value, which may or may not be human-readable. The key value will not be displayed again, so take note of it now, if necessary.<br>%key_value"
msgstr "Создано значение ключа запрошенного типа, которое показано ниже в виде строки в кодировке Base64. Его необходимо декодировать, чтобы получить фактическое значение ключа, которое может быть, а может и не быть пригодно для чтения человеком. Значение ключа больше не будет показано, поэтому при необходимости запишите его сейчас.<br>%key_value"

msgid "Generate"
msgstr "Создать"

msgid "A key input that generates a key value."
msgstr "Ввод ключа, создающий значение ключа."

msgid "The selected key provider does not accept a value. See the provider's description for instructions on how and where to store the key value."
msgstr "Выбранный провайдер ключей не принимает значение. См. инструкции о том, как и где хранить значение ключа, в описании провайдера."

msgid "None"
msgstr "Нет"

msgid "A key input for providers that don't accept a value."
msgstr "Ввод ключа для провайдеров, которые не принимают значение."

msgid "Check this if the key value being submitted has been Base64-encoded."
msgstr "Включите этот переключатель, если передаваемое значение ключа имеет кодировку Base64."

msgid "Text field"
msgstr "Текстовое поле"

msgid "A simple text field."
msgstr "Простое текстовое поле."

msgid "Textarea field"
msgstr "Поле текстовой области"

msgid "A simple textarea field."
msgstr "Поле простой текстовой области."

msgid "Checking this will store the key with Base64 encoding."
msgstr "Если включить этот переключатель, ключ будет сохранен в кодировке Base64."

msgid "The Configuration key provider stores the key in Drupal's configuration system."
msgstr "Провайдер ключей конфигурации хранит ключ в системе конфигурации Drupal."

msgid "Name of the environment variable."
msgstr "Имя переменной среды."

msgid "Check this to remove any trailing line breaks from the variable. Leave unchecked if there is a chance that a line break could be a valid character in the key."
msgstr "Включите, чтобы удалить все концевые символы разрыва строки из переменной. Не включайте, если есть вероятность того, что символ разрыва строки может быть допустимым символом ключа."

msgid "Check this if the key in the variable is Base64-encoded."
msgstr "Включите, если ключ в переменной находится в кодировке Base64."

msgid "The environment variable does not exist or it is empty."
msgstr "Переменная среды не существует или пустая."

msgid "Environment"
msgstr "Окружение"

msgid "The Environment key provider allows a key to be retrieved from an environment variable."
msgstr "Провайдер ключей среды позволяет извлекать ключи из переменной среды."

msgid "The location of the file in which the key will be stored. The path may be absolute (e.g., %abs), relative to the Drupal directory (e.g., %rel), or defined using a stream wrapper (e.g., %str)."
msgstr "Расположение файла, в котором будет храниться ключ. Путь может быть абсолютным (например, %abs), относительно каталога Drupal (например, %rel) или определен с помощью оболочки потока (например, %str)."

msgid "Check this to remove any trailing line breaks from the file. Leave unchecked if there is a chance that a line break could be a valid character in the key."
msgstr "Включите, чтобы удалить все концевые символы разрыва строки из файла. Не включайте, если есть вероятность того, что символ разрыва строки может быть допустимым символом ключа."

msgid "Check this if the key in the file is Base64-encoded."
msgstr "Включите, если ключ в файле находится в кодировке Base64."

msgid "There is no file at the specified location."
msgstr "Нет файла в указанном расположении."

msgid "The file at the specified location is not readable."
msgstr "Файл в указанном расположении не доступен для чтения."

msgid "File"
msgstr "Файл"

msgid "The File key provider allows a key to be stored in a file, preferably outside of the web root."
msgstr "Провайдер файловых ключей позволяет хранить ключи в файле, предпочтительно за пределами корневого каталога."

msgid "Authentication"
msgstr "Аутентификация"

msgid "A generic key type to use for a password or API key that does not belong to any other defined key type."
msgstr "Общий тип ключа, предназначенный для пароля или ключа API, не принадлежащего какому-либо другому определенному типу ключа."

msgid "The key value does not contain valid JSON."
msgstr "Значение ключа не содержит допустимый JSON."

msgid "The key value is missing the field %field."
msgstr "В значении ключа отсутствует поле %field."

msgid "The key value field %field is empty."
msgstr "Поле %field значения ключа пустое."

msgid "Authentication (Multivalue)"
msgstr "Идентификация (несколько значений)"

msgid "A generic key type to use for an authentication key that contains multiple values."
msgstr "Общий тип ключа, предназначенный для ключа идентификации, который содержит несколько значений."

msgid "The size of the key in bits, with 8 bits per byte."
msgstr "Длина ключа в битах (8 битов на байт)."

msgid "Other"
msgstr "Другое"

msgid "Key size (other value)"
msgstr "Длина ключа (другое значение)"

msgid "Enter a custom key size in bits."
msgstr "Введите пользовательскую длину ключа в битах."

msgid "The selected key size does not match the actual size of the key."
msgstr "Выбранная длина ключа не совпадает с фактической."

msgid "Encryption"
msgstr "Шифрование"

msgid "A generic key type to use for an encryption key that does not belong to any other defined key type."
msgstr "Общий тип ключа, предназначенный для ключа шифрования, не принадлежащего какому-либо другому определенному типу ключа."

msgid "User/password"
msgstr "Пользователь/пароль"

msgid "A key type to store a user/password pair."
msgstr "Тип ключа для хранения пары пользователь/пароль."

