msgid "Schema.org: Event"
msgstr "Schema.org : Evénement"

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "Evaluation globale de l'élément, basée sur une collection de révisions ou d'évaluations."

msgid "RECOMMENDED BY GOOGLE. A description of the event."
msgstr "RECOMMANDE PAR GOOGLE. Description de l'événement."

msgid "The time when admission will commence."
msgstr "Heure à laquelle commence l'admission."

msgid "RECOMMENDED BY GOOGLE. Date and time when the event ends."
msgstr "RECOMMANDE PAR GOOGLE. Date et heure de fin de l'événement."

msgid "RECOMMENDED BY GOOGLE. The eventAttendanceMode of the event. Valid values are https://schema.org/OfflineEventAttendanceMode, https://schema.org/MixedEventAttendanceMode, or https://schema.org/OnlineEventAttendanceMode."
msgstr "RECOMMANDE PAR GOOGLE. Mode eventAttendanceMode de l'événement. Valeurs valides : https://schema.org/OfflineEventAttendanceMode, https://schema.org/MixedEventAttendanceMode ou https://schema.org/OnlineEventAttendanceMode."

msgid "RECOMMENDED BY GOOGLE. The status of the event. Valid options are https://schema.org/EventCancelled, https://schema.org/EventMovedOnline, https://schema.org/EventPostponed, https://schema.org/EventRescheduled, or https://schema.org/EventScheduled."
msgstr "RECOMMANDE PAR GOOGLE. Statut de l'événement. Options valides : https://schema.org/EventCancelled, https://schema.org/EventMovedOnline, https://schema.org/EventPostponed, https://schema.org/EventRescheduled ou https://schema.org/EventScheduled."

msgid "Globally unique id of the event, usually a url."
msgstr "Identificateur global unique de l'événement, généralement une URL."

msgid "RECOMMENDED BY GOOGLE. The primary image for this item."
msgstr "RECOMMANDE PAR GOOGLE. Image principale de cet élément."

msgid "REQUIRED BY GOOGLE. The location of the event."
msgstr "REQUIS PAR GOOGLE. Emplacement de l'événement."

msgid "REQUIRED BY GOOGLE. The name of the event."
msgstr "REQUIS PAR GOOGLE. Nom de l'événement."

msgid "RECOMMENDED BY GOOGLE. Offers associated with the event."
msgstr "RECOMMANDE PAR GOOGLE. Offres associées à l'événement."

msgid "RECOMMENDED BY GOOGLE. The organizer of the event."
msgstr "RECOMMANDE PAR GOOGLE. Organisateur de l'événement."

msgid "RECOMMENDED BY GOOGLE. The performer on the event."
msgstr "RECOMMANDE PAR GOOGLE. Personne exécutant l'événement."

msgid "RECOMMENDED BY GOOGLE. The previousStartDate of the event."
msgstr "RECOMMANDE PAR GOOGLE. Etat previousStartDate de l'événement."

msgid "Reviews of this event."
msgstr "Révisions de cet événement."

msgid "REQUIRED BY GOOGLE. Date and time when the event starts."
msgstr "REQUIS PAR GOOGLE. Date et heure de début de l'événement."

msgid "REQUIRED. The type of event."
msgstr "Obligatoire. Type d'événement."

msgid "The URL of the event."
msgstr "URL de l'événement."

