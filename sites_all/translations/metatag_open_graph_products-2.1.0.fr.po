msgid "About"
msgstr "A propos de"

msgid "Provides additional Open Graph Protocol meta tags for describing products."
msgstr "Fournit des balises meta Open Graph Protocol supplémentaires pour la description des produits."

msgid "Metatag: Open Graph Products"
msgstr "Balise meta : Produits Open Graph"

msgid "SEO"
msgstr "optimisation pour les moteurs de recherche"

msgid "Open Graph Product: Price availability"
msgstr "Produit graphique ouvert : Disponibilité des prix"

msgid "Open Graph Product: Product condition"
msgstr "Ouvrir un produit graphique : condition du produit"

msgid "Open Graph Product: Price amount"
msgstr "Produit Open Graph : Montant du prix"

msgid "Open Graph Product: Price currency"
msgstr "Produit Open Graph : Devise du prix"

msgid "Open Graph Product: Retailer Item ID"
msgstr "Ouvrir un produit graphique : ID article de détaillant"

msgid "Open Graph - Products"
msgstr "Open Graph - Produits"

msgid "These <a href='https://ogp.me/'>Open Graph meta tags</a> are for describing products.<br><br>The Facebook <a href='https://developers.facebook.com/tools/debug/'>Sharing Debugger</a> lets you preview how your content will look when it's shared to Facebook and debug any issues with your Open Graph tags."
msgstr "Ces <a href='https://ogp.me/'>balises meta Open Graph</a> permettent de décrire les produits.<br><br>Le <a href='https://developers.facebook.com/tools/debug/'>débogueur de partage</a> Facebook vous permet de prévisualiser l'apparence de votre contenu lorsqu'il est partagé sur Facebook et de déboguer les problèmes liés à vos balises Open Graph."

msgid "Product availability"
msgstr "Disponibilité de produit"

msgid "The availability of the product."
msgstr "La disponibilité du produit."

msgid "Product condition"
msgstr "Condition du produit"

msgid "The condition of the product."
msgstr "L'état du produit."

msgid "Product price amount"
msgstr "Montant du prix du produit"

msgid "The price amount of the product."
msgstr "Montant du prix du produit."

msgid "Product price currency"
msgstr "Devise du prix du produit"

msgid "The price currency of the product."
msgstr "Devise du prix du produit."

msgid "Retailer Item ID"
msgstr "ID article du détaillant"

msgid "The ID of the product as provided by the retailer."
msgstr "ID du produit fourni par le détaillant."

