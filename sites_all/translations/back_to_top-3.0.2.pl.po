msgid "Back To Top"
msgstr "Do góry"

msgid "Back To Top adds a button that hovers in the bottom of your screen and allow users to smoothly scroll up the page using jQuery."
msgstr "Moduł Back To Top powoduje dodanie przycisku, który znajduje się na dole ekranu i pozwala użytkownikom płynnie przewinąć stronę do góry przy użyciu jQuery."

msgid "User interface"
msgstr "Interfejs użytkownika"

msgid "Back to Top"
msgstr "Powrót na górę"

msgid "Administer Back To Top settings."
msgstr "Administruj ustawieniami modułu Back To Top."

msgid "Back to top settings"
msgstr "Ustawienia powrotu na początek"

msgid "Access Back to top settings"
msgstr "Dostęp do ustawień powrotu na początek"

msgid "Prevent on mobile and touch devices"
msgstr "Blokuj w urządzeniach mobilnych i dotykowych"

msgid "Prevent on administration pages and node edit"
msgstr "Blokuj na stronach administracyjnych i edycji węzła"

msgid "Prevent on front page"
msgstr "Blokuj na stronie tytułowej"

msgid "Trigger"
msgstr "Wyzwalacz"

msgid "Placement"
msgstr "Umiejscowienie"

msgid "Button text"
msgstr "Tekst przycisku"

msgid "Button type"
msgstr "Typ przycisku"

msgid "Background color"
msgstr "Kolor tła"

msgid "Border color"
msgstr "Kolor ramki"

msgid "Hover color"
msgstr "Kolor po najechaniu kursorem"

msgid "Text color"
msgstr "Kolor tekstu"

msgid "Back to top"
msgstr "Do góry"

msgid "Don´t show Back To Top-button on screen width up to 760px."
msgstr "Nie pokazuj przycisku powrotu do początku na ekranie o szerokości do 760 pikseli."

msgid "Do you want to prevent Back To Top on admin pages?"
msgstr "Czy chcesz zablokować moduł Back To Top na stronach administracyjnych?"

msgid "Do you want to prevent Back To Top on front page?"
msgstr "Czy chcesz zablokować moduł Back To Top na stronie tytułowej?"

msgid "Set the number of pixel which trigger the Back To Top button default 100"
msgstr "Ustaw liczbę pikseli, która wywoła przycisk Powrót na początek. Domyślnie wynosi 100"

msgid "Where should the Back To Top button appear?"
msgstr "Wybierz położenie przycisku Powrót na początek"

msgid "Bottom right"
msgstr "Prawy dolny róg"

msgid "Bottom left"
msgstr "Lewy dolny róg"

msgid "Bottom center"
msgstr "Dolny środek"

msgid "Top right"
msgstr "Prawy górny róg"

msgid "Top left"
msgstr "Lewy górny róg"

msgid "Top center"
msgstr "Górny środek"

msgid "Mid right"
msgstr "Pośrodku po prawej"

msgid "Mid left"
msgstr "Pośrodku po lewej"

msgid "Mid center"
msgstr "Pośrodku centralnie"

msgid "Set the text of the Back To Top button"
msgstr "Ustaw tekt przycisku Powrót na początek"

msgid "Do you want Back To Top to use a PNG-24 image or a Text/Css button?"
msgstr "Czy jako przycisk Powrót na początek ma być używany obraz PNG-24, czy przycisk tekstowy/Css?"

msgid "Image (default)"
msgstr "Obraz (ustawienie domyślne)"

msgid "Text/Css"
msgstr "Tekstowy/Css"

msgid "Text/Css button settings"
msgstr "Ustawienia przycisku tekstowego/Css"

msgid "Button background color default #F7F7F7"
msgstr "Domyślny kolor tła przycisku #F7F7F7"

msgid "Border color default #CCCCCC"
msgstr "Domyślny kolor ramki #CCCCCC"

msgid "Hover color default #EEEEEE"
msgstr "Domyślny kolor po wskazaniu #EEEEEE"

msgid "Text color default #333333"
msgstr "Domyślny kolor tekstu #333333"

