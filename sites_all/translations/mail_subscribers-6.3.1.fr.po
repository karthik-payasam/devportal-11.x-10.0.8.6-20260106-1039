msgstr "Courrier électronique envoyé aux propriétaires abonnés au produit %product"

msgid "Sent email to members subscribing to product %product"
msgstr "Courrier électronique envoyé aux membres abonnés au produit %product"

msgid "Sent email to owners subscribing to API %api"
msgstr "Courrier électronique envoyé aux propriétaires abonnés à l'API %api"

msgid "Sent email to members subscribing to API %api"
msgstr "Courrier électronique envoyé aux membres abonnés à l'API %api"

msgid "Sent email to all consumer organization owners"
msgstr "Courrier électronique envoyé à tous les propriétaires d'organisation de type consommateur"

msgid "Sent email to all consumer organization members"
msgstr "Courrier électronique envoyé à tous les membres d'organisation de type consommateur"

msgid "Did not find a user object for the recipient @to.  Any user tokens in the message subject or body will not be substituted"
msgstr "Impossible de trouver un objet utilisateur pour le destinataire @to.  Tout jeton utilisateur dans le sujet ou le corps du message ne sera pas remplacé"

msgid "Did not find a plan with the name @plan in the product @product"
msgstr "Aucun plan dont le nom est @plan n'a été trouvé dans le produit @product"

