msgid "Schema.org: Book"
msgstr "Schema.org: Kniha"

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "Celkové hodnocení založené na kolekci revizí nebo hodnocení položky."

msgid "REQUIRED BY GOOGLE. Author of the book."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Autor knihy."

msgid "A description of the item."
msgstr "Popis položky."

msgid "RECOMMENDED BY GOOGLE. Globally unique @id, usually a url, used to to link other properties to this object."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Globálně jedinečné @id, obvykle adresa URL, která se používá k propojení dalších vlastností s tímto objektem."

msgid "The primary image for this item."
msgstr "Primární obrázek pro tuto položku."

msgid "REQUIRED BY GOOGLE. The title of the book."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Titulek knihy."

msgid "Reviews of this item."
msgstr "Recenze této položky."

msgid "RECOMMENDED BY GOOGLE. URL of a reference Web page that unambiguously indicates the item's identity. E.g. the URL of the item's Wikipedia page, Wikidata entry, or official website."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Adresa URL referenční webové stránky, která jednoznačně označuje identitu položky. Například adresa URL stránky položky Wikipedie, položky Wikidata nebo oficiálního webu."

msgid "REQUIRED. The type of this Book"
msgstr "POŽADOVÁNO. Typ této knihy"

msgid "REQUIRED BY GOOGLE. URL to the page on your site about the book. The page may list all available editions."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Adresa URL stránky na vašem webu o knize. Na stránce je možné vypsat všechna dostupná vydání."

msgid "REQUIRED BY GOOGLE. An example of the book."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Příklad knihy."

