msgid "About"
msgstr "Informazioni"

msgid "Provides support for the hreflang meta tag with some extra logic to simplify it."
msgstr "Fornisce il supporto per il metatag hreflang con una logica supplementare per renderlo più semplice."

msgid "Metatag: Hreflang"
msgstr "Metatag: Hreflang"

msgid "SEO"
msgstr "SEO"

msgid "Default locale (x-default)"
msgstr "Locale predefinita (x-default)"

msgid "Href per language"
msgstr "Href per lingua"

msgid "URL for a version of this page in %langcode"
msgstr "URL per una versione di questa pagina in %langcode"

msgid "Alternative language links (hreflang)"
msgstr "Link delle lingua alternative (hreflang)"

msgid "These meta tags are designed to point visitors to versions of the current page in other languages."
msgstr "Questi metatag sono progettati per indirizzare i visitatori alle versioni della pagina corrente in altre lingue."

msgid "Hreflang per language"
msgstr "Hreflang per lingua"

msgid "This plugin will be cloned from these settings for each enabled language."
msgstr "Questo plugin verrà clonato da queste impostazioni per ciascuna lingua abilitata."

msgid "This should point to the version of the page that is for the main or primary locale, e.g. the original version of an article that is translated into other languages."
msgstr "Deve puntare alla versione della pagina nella locale principale o primaria, vale a dire la versione originale di un articolo tradotto in altre lingue."

