msgid "About"
msgstr "Acerca de"

msgid "Provides a new Forms API element which is a select/radios/checkboxes element that has an 'other' option.<br> When 'other' is selected a textfield appears for the user to provide a custom value."
msgstr "Proporciona un nuevo elemento del API Forms de tipo selección/radio/casilla que tiene la opción 'otros'.<br> Cuando se selecciona 'otros', aparece un campo de texto para que el usuario facilite un valor personalizado."

msgid "Applications"
msgstr "Aplicaciones"

msgid "As a Field widget for (auto create) Entity reference fields."
msgstr "Como widget de campo para campos de referencia de entidad (creación automática)."

msgid "As a Forms API element for developers. Therefor can be integrated into any form or module."
msgstr "Como elemento del API Forms para desarrolladores. Por tanto se puede integrar en cualquier formulario o módulo."

msgid "Select (or other)"
msgstr "Select (or other)"

msgid "Provides a select box form element with additional option 'Other' to give a textfield."
msgstr "Proporciona el elemento de formulario cuadro de selección con una opción adicional 'Otro' para proporcionar un campo de texto"

msgid "Fields"
msgstr "Campos"

msgid "Select or other reference widget display format settings"
msgstr "Configuración del formato de visualización del widget de referencia Seleccionar u otro."

msgid "Type of select form element"
msgstr "Tipo de elemento de formulario de selección"

msgid "Chosen sorting of options"
msgstr "Ordenación de opciones seleccionada"

msgid "Other placeholder"
msgstr "Otro marcador de posición"

msgid "Other option"
msgstr "Otra opción"

msgid "Label of the other field"
msgstr "Etiqueta del otro campo"

msgid "Select or other list widget display format settings"
msgstr "Configuración del formato de visualización del widget de lista Seleccionar u otro."

msgid "Add entered values from the other field to the allowed values list"
msgstr "Añadir valores especificados del otro campo a la lista de valores permitidos"

msgid "- None -"
msgstr "- Ninguno -"

msgid "- Other -"
msgstr "- Otros -"

msgid "Add entered values from the other field to the allowed values list."
msgstr "Añadir valores especificados del otro campo a la lista de valores permitidos."

msgid "Select or Other"
msgstr "Seleccionar u otro"

msgid "Sort options by value"
msgstr "Ordenar opciones por valor"

msgid "Text that will be shown inside the field until a value is entered. This hint is usually a sample value or a brief description of the expected format."
msgstr "Texto que aparece en el campo hasta que se especifica un valor. Esta sugerencia suele ser un valor de ejemplo o una breve descripción del formato esperado."

msgid "Label of the option that the user will choose when they want to supply an other value."
msgstr "Etiqueta de la opción que el usuario elegirá cuando desee proporcionar otro valor."

msgid "Label of the Other field"
msgstr "Etiqueta del campo Otros"

msgid "Label for the field in which the user will supply an other value."
msgstr "Etiqueta del campo en el que el usuario especifica otro valor."

msgid "Type of select form element:"
msgstr "Tipo de elemento de formulario de selección:"

msgid "Placeholder: @placeholder"
msgstr "Marcador de posición: @placeholder"

msgid "No placeholder"
msgstr "Sin marcador de posición"

msgid "Other option: @option"
msgstr "Opción Otros: @option"

msgid "Label of the Other field: @label"
msgstr "Etiqueta del campo Otros: @label"

msgid "Select list"
msgstr "Lista de selección"

msgid "Check boxes/radio buttons"
msgstr "Casillas de selección / botones de radio"

msgid "No sorting"
msgstr "Sin ordenación"

msgid "Sorted ascending"
msgstr "Orden ascendente"

msgid "Sorted descending"
msgstr "Orden descendente"

