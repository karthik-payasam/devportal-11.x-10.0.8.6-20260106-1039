msgid "Lists registered library information."
msgstr "Lista informações da biblioteca registrada."

msgid ""
"Downloads a registered library into the libraries directory for the active site.\n"
"\n"
"See libraries-list for a list of registered libraries."
msgstr ""
"Faz download de uma biblioteca registrada para o diretório de bibliotecas do site ativo.\n"
"\n"
"Consulte a lista de bibliotecas para obter uma lista de bibliotecas registradas."

msgid "Name"
msgstr "Nome"

msgid "Status"
msgstr "Status"

msgid "Version"
msgstr "Versão"

msgid "Variants"
msgstr "Variantes"

msgid "Dependencies"
msgstr "Dependências"

msgid "OK"
msgstr "OK"

msgid "Missing dependency: unzip. Install it before using this command."
msgstr "Dependência ausente: unzip. Instale-a antes de usar este comando."

msgid "Directory @path was created"
msgstr "O @path do diretório foi criado"

msgid "A existing Colorbox plugin was overwritten at @path"
msgstr "Um plug-in Colorbox existente foi sobrescrito em @path"

msgid "Colorbox plugin has been downloaded to @path"
msgstr "O plug-in Colorbox foi transferido por download para @path"

msgid "Drush was unable to download the Colorbox plugin to @path"
msgstr "O Drush não pôde fazer download do plug-in Colorbox para @path"

msgid "The %dependency library, which the %library library depends on, is not installed."
msgstr "A biblioteca %dependency, da qual a biblioteca %library depende, não está instalada. "

msgid "The version %dependency_version of the %dependency library is not compatible with the %library library."
msgstr "A versão %dependency_version da biblioteca %dependency não é compatível com a biblioteca %library."

msgid "The %library library could not be found."
msgstr "A biblioteca %library não pôde ser localizada."

msgid "The version of the %library library could not be detected."
msgstr "A versão da biblioteca %library não pôde ser detectada."

msgid "The installed version %version of the %library library is not supported."
msgstr "A versão %version instalada da biblioteca %library não é suportada."

msgid "The %variant variant of the %library library could not be found."
msgstr "A variante %variant da biblioteca %library não pôde ser localizada."

msgid "The following external libraries could not successfully be registered with Drupal core: @libs. See earlier log entries for more details. Once these issues are addressed please be sure to clear your Drupal library cache to ensure external library detection is run again."
msgstr "As seguintes bibliotecas externas não puderam ser registradas com sucesso com o núcleo Drupal: @libs. Consulte as entradas de log anteriores para obter mais detalhes. Quando esses problemas forem resolvidos, certifique-se de limpar seu cache da biblioteca Drupal para assegurar que a detecção de biblioteca externa seja executada novamente."

msgid "Libraries"
msgstr "Bibliotecas"

msgid "Allows version-dependent and shared usage of external libraries."
msgstr "Permite um uso dependente de versão e compartilhado de bibliotecas externas."

msgid "Libraries API settings"
msgstr "Configurações da API de bibliotecas"

msgid "Library definition settings"
msgstr "Configurações de definição de biblioteca"

msgid "Local"
msgstr "Local"

msgid "Local path"
msgstr "Caminho Local"

msgid "Enable remote fetching of library definitions"
msgstr "Ativar busca remota de definições de biblioteca"

msgid "A list of remote library registry URLs"
msgstr "Uma lista de URLs de registro de biblioteca remota"

msgid "The URL of a remote library registry"
msgstr "A URL de um registro de biblioteca remota"

msgid "URI locator configuration"
msgstr "Configuração do localizador de URI"

msgid "The locator URI"
msgstr "O URI do localizador"

msgid "Assets"
msgstr "Recursos"

msgid "Provides access to asset library files."
msgstr "Fornece acesso a arquivos de biblioteca de ativos."

msgid "Library definitions"
msgstr "Definições de biblioteca"

msgid "Provides access to library definition files."
msgstr "Fornece acesso a arquivos de definição de biblioteca."

msgid "PHP library files"
msgstr "Arquivos de biblioteca PHP"

msgid "Provides access to PHP library files."
msgstr "Fornece acesso aos arquivos de biblioteca PHP."

