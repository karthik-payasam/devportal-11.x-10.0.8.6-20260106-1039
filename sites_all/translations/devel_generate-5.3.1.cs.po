msgid "Finished @num elements and @num_translations translations created successfully."
msgstr "Dokončené prvky @num a překlady @num_translations byly úspěšně vytvořeny."

msgid "Finished @num elements created successfully."
msgstr "Bylo úspěšně vytvořeno @num dokončených prvků."

msgid "Finished with an error."
msgstr "Dokončeno s chybou."

msgid "Generate @label"
msgstr "Generovat @label"

msgid "Generate"
msgstr "Generovat"

msgid "Generate realistic items (content, users, menus, etc) to assist your site development and testing."
msgstr "Generujte realistické položky (obsah, uživatelé, nabídky atd.), které vám pomohou při vývoji a testování webu."

msgid "Devel generate"
msgstr "Vygenerovat prostředí pro vývojáře"

msgid "Devel Generate"
msgstr "Generovat prostředí pro vývojáře"

msgid "Generate test users, nodes, menus, taxonomy terms..."
msgstr "Generovat testovací uživatele, uzly, nabídky, výrazy taxonomie..."

msgid "Development"
msgstr "Vývoj"

msgid "Administer devel_generate"
msgstr "Spravovat devil_generate"

msgid "Language"
msgstr "Jazyk"

msgid "Select the primary language(s) for @items"
msgstr "Vyberte primární jazyk(y) pro @items"

msgid "Disabled - requires Language module"
msgstr "Zakázáno - vyžaduje modul Jazyk"

msgid "Select the language(s) for translated @items"
msgstr "Vybrat jazyk(y) pro přeložené položky @items"

msgid "Translated @items will be created for each language selected."
msgstr "Přeložené položky @items budou vytvořeny pro každý vybraný jazyk."

msgid "Disabled - requires Content Translation module."
msgstr "Zakázáno - vyžaduje modul Překlad obsahu."

msgid "@permission"
msgstr "@permission"

msgid "Failed to generate elements due to \"%error\"."
msgstr "Nezdařilo se vygenerovat prvky kvůli \"%error\"."

msgid "You do not have any content types that can be generated. <a href=\":create-type\">Go create a new content type</a>"
msgstr "Nemáte žádné typy obsahu, které by bylo možné generovat. <a href=\":create-type\">Přejít na vytvoření nového typu obsahu</a>"

msgid "Hidden"
msgstr "Skryté"

msgid "Closed"
msgstr "Zavřený"

msgid "Open"
msgstr "Otevřít"

msgid "No comment fields"
msgstr "Žádná pole komentáře"

msgid "Content type"
msgstr "Typ obsahu"

msgid "Comments"
msgstr "Komentáře"

msgid "<strong>Delete all content</strong> in these content types before generating new content."
msgstr "<strong>Odstranit veškerý obsah</strong> v těchto typech obsahu před generováním nového obsahu."

msgid "How many nodes would you like to generate?"
msgstr "Kolik uzlů chcete generovat?"

msgid "Now"
msgstr "Nyní"

msgid "ago"
msgstr "Před"

msgid "How far back in time should the nodes be dated?"
msgstr "Jak dlouho zpět by měly být uzly datovány?"

msgid "Node creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "Data vytvoření uzlu se budou náhodně distribuovat od aktuálního času zpět do vybraného času."

msgid "Maximum number of comments per node."
msgstr "Maximální počet komentářů na uzel."

msgid "You must also enable comments for the content types you are generating. Note that some nodes will randomly receive zero comments. Some will receive the max."
msgstr "Musíte také povolit komentáře pro typy obsahu, které generujete. Všimněte si, že některé uzly budou náhodně přijímat nulové komentáře. Některé obdrží maximum."

msgid "Maximum number of words in titles"
msgstr "Maximální počet slov v nadpisech"

msgid "Fields to leave empty"
msgstr "Pole, která mají být prázdná"

msgid "Enter the field names as a comma-separated list. These will be skipped and have a default value in the generated content."
msgstr "Zadejte názvy polí jako seznam oddělený čárkami. Tato pole budou vynechána a budou mít výchozí hodnotu v generovaném obsahu."

msgid "Base fields to populate"
msgstr "Základní pole k naplnění"

msgid "Enter the field names as a comma-separated list. These will be populated."
msgstr "Zadejte názvy polí jako seznam oddělený čárkami. Pole budou naplněna daty."

msgid "Prefix the title with the content type label."
msgstr "Zadejte předponu názvu s popiskem typu obsahu."

msgid "This will not count against the maximum number of title words specified above."
msgstr "Toto se nezapočítá proti výše uvedenému maximálnímu počtu slov titulku."

msgid "Requires path.module"
msgstr "Vyžaduje path.module"

msgid "Add an url alias for each node."
msgstr "Přidejte alias adresy URL pro každý uzel."

msgid "Add statistics for each node (node_counter table)."
msgstr "Přidejte statistiku pro každý uzel (tabulka node_counter)."

msgid "User ID"
msgstr "ID uživatele"

msgid "Name"
msgstr "Název"

msgid "Role(s)"
msgstr "Role"

msgid "Users"
msgstr "Uživatelé"

msgid "Select users for randomly assigning as authors of the generated content. Leave all unchecked to use a random selection of up to 50 users."
msgstr "Vyberte uživatele pro náhodné přiřazení jako autory generovaného obsahu. Chcete-li použít náhodný výběr až 50 uživatelů, ponechte políčko nezaškrtnuté."

msgid "Please select at least one content type"
msgstr "Vyberte prosím alespoň jeden typ obsahu"

msgid "Generating Content"
msgstr "Generování obsahu"

msgid "Deleted %count nodes."
msgstr "Bylo odstraněno %count uzlů."

msgid "Completed @feedback nodes (@rate nodes/min)"
msgstr "Dokončeno @feedback uzlů (@rate uzly/min)"

msgid "No content types available"
msgstr "Nejsou k dispozici žádné typy obsahu"

msgid "To delete content, please provide the content types (--bundles)"
msgstr "Chcete-li odstranit obsah, poskytněte typy obsahu (--bundles)"

msgid "One or more content types have been entered that don't exist on this site"
msgstr "Byl zadán jeden nebo více typů obsahu, které na tomto webu neexistují."

msgid "Created 1 node"
msgid_plural "Created @count nodes"
msgstr[0] "Vytvořen 1 uzel"
msgstr[1] "Vytvořeny @count uzly"
msgstr[2] "Vytvořeny @count uzly"

msgid "Created 1 node translation"
msgid_plural "Created @count node translations"
msgstr[0] "Vytvořen 1 překlad uzlu"
msgstr[1] "Vytvořeny @count překlady uzlu"
msgstr[2] "Vytvořeny @count překlady uzlu"

msgid "content"
msgstr "obsah"

msgid "Generate a given number of content. Optionally delete current content."
msgstr "Generujte dané číslo obsahu. Volitelně můžete odstranit aktuální obsah."

msgid "You do not have any media types that can be generated. <a href=\":url\">Go create a new media type</a>"
msgstr "Nemáte žádné typy médií, které mohou být generovány. <a href=\":url\">Vytvořte nový typ média</a>"

msgid "Media type"
msgstr "Typ média"

msgid "<strong>Delete all media</strong> in these types before generating new media."
msgstr "<strong>Odstranit všechna média</strong> v těchto typech před vygenerováním nového média."

msgid "How many media items would you like to generate?"
msgstr "Kolik médií byste chtěli generovat?"

msgid "How far back in time should the media be dated?"
msgstr "Od kterého momentu v minulosti má být médium datováno?"

msgid "Media creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "Data vytvoření média budou náhodně rozdělena od aktuálního data zpět ke zvolenému času."

msgid "Maximum number of words in names"
msgstr "Maximální počet slov v názvech"

msgid "Set language on media"
msgstr "Nastavit jazyk na médiu"

msgid "Requires locale.module"
msgstr "Vyžaduje locale.module"

msgid "Please select at least one media type"
msgstr "Vyberte alespoň jeden typ média"

msgid "Generating media items"
msgstr "Generování položek médií"

msgid "Deleted %count media items."
msgstr "Odstraněno %count položek médií."

msgid "Completed !feedback media items (!rate media/min)"
msgstr "Dokončeny položky média !feedback (!rate media/min)"

msgid "No media types available"
msgstr "Nejsou k dispozici žádné typy médií"

msgid "media"
msgstr "médium"

msgid "Generate a given number of media entities."
msgstr "Vygenerujte daný počet položek média."

msgid "Create new menu(s)"
msgstr "Vytvořit nové nabídky"

msgid "Generate links for these menus"
msgstr "Generovat odkazy pro tyto nabídky"

msgid "Number of new menus to create"
msgstr "Počet nových nabídek k vytvoření"

msgid "Number of links to generate"
msgstr "Počet odkazů k vygenerování"

msgid "Maximum length for menu titles and menu links"
msgstr "Maximální délka pro titulky nabídek a odkazy nabídky"

msgid "Text will be generated at random lengths up to this value. Enter a number between 2 and 128."
msgstr "Text bude generován s náhodnými délkami až do této hodnoty. Zadejte číslo mezi 2 a 128."

msgid "Types of links to generate"
msgstr "Typy odkazů k vygenerování"

msgid "Nodes"
msgstr "Uzly"

msgid "Front page"
msgstr "Přední stránka"

msgid "External"
msgstr "Externí"

msgid "Maximum link depth"
msgstr "Maximální hloubka odkazu"

msgid "Maximum menu width"
msgstr "Maximální šířka nabídky"

msgid "Limit the width of the generated menu's first level of links to a certain number of items."
msgstr "Omezte šířku první úrovně odkazů generované nabídky na určitý počet položek."

msgid "Delete existing custom generated menus and menu links before generating new ones."
msgstr "Odstraňte existující vlastní generované nabídky a odkazy nabídky před generováním nových."

msgid "Deleted @menus_deleted menu(s) and @links_deleted other link(s)."
msgstr "Odstraněny nabídky @menus_deleted a další odkazy @links_deleted."

msgid "Description of @name"
msgstr "Popis @name"

msgid "Description of @title."
msgstr "Popis @title."

msgid "Invalid number of menus"
msgstr "Neplatný počet nabídek"

msgid "Invalid number of links"
msgstr "Neplatný počet odkazů"

msgid "Invalid maximum link depth. Use a value between 1 and 9"
msgstr "Neplatná maximální hloubka odkazu. Použít hodnotu mezi 1 a 9"

msgid "Invalid maximum menu width. Use a positive numeric value."
msgstr "Neplatná maximální šířka nabídky. Použijte kladnou číselnou hodnotu."

msgid "Created the following 1 new menu: @menus"
msgid_plural "Created the following @count new menus: @menus"
msgstr[0] "Vytvořena následující 1 nová nabídka: @menus"
msgstr[1] "Vytvořeny následující @count nové nabídky: @menus"
msgstr[2] "Vytvořeny následující @count nové nabídky: @menus"

msgid "Created 1 new menu link."
msgid_plural "Created @count new menu links."
msgstr[0] "Byl vytvořen 1 nový odkaz nabídky."
msgstr[1] "Bylo vytvořeno @count nových odkazů nabídky."
msgstr[2] "Bylo vytvořeno @count nových odkazů nabídky."

msgid "menus"
msgstr "nabídky"

msgid "Generate a given number of menus and menu links. Optionally delete current menus."
msgstr "Generujte daný počet nabídek a odkazů nabídky. Volitelně odstraňte aktuální nabídky."

msgid "Vocabularies"
msgstr "Slovníky"

msgid "Restrict terms to these vocabularies."
msgstr "Omezte výrazy na tyto slovníky."

msgid "Number of terms"
msgstr "Počet termínů"

msgid "Maximum number of characters in term names"
msgstr "Maximální počet znaků v názvech výrazů"

msgid "Minimum depth for new terms in the vocabulary hierarchy"
msgstr "Minimální hloubka pro nové termíny v hierarchii slovníku"

msgid "Enter a value from 1 to 20."
msgstr "Zadejte hodnotu od 1 do 20."

msgid "Maximum depth for new terms in the vocabulary hierarchy"
msgstr "Maximální hloubka pro nové termíny v hierarchii slovníku"

msgid "Delete existing terms in specified vocabularies before generating new terms."
msgstr "Před generováním nových výrazů odstraňte existující výrazy v určených slovnících."

msgid "In vocabulary @vlabel: @termlist"
msgstr "Ve slovníku @vlabel: @termlist"

msgid "In vocabulary @vlabel: No terms created"
msgstr "Ve slovníku @vlabel: Nebyly vytvořeny žádné termíny"

msgid "Minimum depth changed from @min_depth to 1 because all terms were deleted"
msgstr "Minimální hloubka se změnila z @min_depth na 1, protože všechny výrazy byly odstraněny"

msgid "Please provide a vocabulary machine name (--bundles)."
msgstr "Zadejte název slovníku čitelný pro počítač (--bundles)."

msgid "Invalid vocabulary machine name: @name"
msgstr "Neplatný název počítače slovníku: @name"

msgid "Invalid number of terms: @num"
msgstr "Neplatný počet výrazů: @num"

msgid "The depth values must be in the range 1 to 20 and min-depth cannot be larger than max-depth (values given: min-depth @min, max-depth @max)"
msgstr "Hodnoty hloubky musí být v rozsahu 1 až 20 a minimální hloubka nesmí být větší než maximální hloubka (zadané hodnoty: min-depth @min, max-hloubka @max)"

msgid "Created 1 new term"
msgid_plural "Created @count new terms"
msgstr[0] "Byl vytvořen 1 nový termín"
msgstr[1] "Bylo vytvořeno @count nových termínů"
msgstr[2] "Bylo vytvořeno @count nových termínů"

msgid "1 new term at level @level (@terms)"
msgid_plural "@count new terms at level @level (@terms)"
msgstr[0] "1 nový termín na úrovni @level (@terms)"
msgstr[1] "@count nové termíny na úrovni @level (@terms)"
msgstr[2] "@count nové termíny na úrovni @level (@terms)"

msgid "Created 1 term translation"
msgid_plural "Created @count term translations"
msgstr[0] "Byl vytvořen 1 překlad termínu"
msgstr[1] "Bylo vytvořeno @count překladů termínu"
msgstr[2] "Bylo vytvořeno @count překladů termínu"

msgid "Deleted 1 existing term"
msgid_plural "Deleted @count existing terms"
msgstr[0] "Byl odstraněn 1 existující termín"
msgstr[1] "Byly odstraněny @count existující termíny"
msgstr[2] "Byly odstraněny @count existující termíny"

msgid "terms"
msgstr "výrazy"

msgid "Generate a given number of terms. Optionally delete current terms."
msgstr "Generovat daný počet výrazů. Volitelně odstraňte aktuální výrazy."

msgid "How many users would you like to generate?"
msgstr "Kolik uživatelů si přejete generovat?"

msgid "Delete all users (except user id 1) before generating new users."
msgstr "Před generováním nových uživatelů odstraňte všechny uživatele (kromě ID uživatele 1)."

msgid "Which roles should the users receive?"
msgstr "Jaké role by měli uživatelé obdržet?"

msgid "Users always receive the <em>authenticated user</em> role."
msgstr "Uživatelé vždy obdrží roli <em>ověřený uživatel</em>."

msgid "Password to be set"
msgstr "Heslo, které má být nastaveno"

msgid "Leave this field empty if you do not need to set a password"
msgstr "Ponechte toto pole prázdné, pokud nepotřebujete nastavit heslo"

msgid "How old should user accounts be?"
msgstr "Jak staré by měly být uživatelské účty?"

msgid "User ages will be distributed randomly from the current time, back to the selected time."
msgstr "Uživatelé budou náhodně rozděleni od aktuálního času zpět do vybraného času."

msgid "@num_users created."
msgstr "@num_users vytvořeno."

msgid "1 user deleted"
msgid_plural "@count users deleted."
msgstr[0] "1 uživatel odstraněn"
msgstr[1] "@count uživatelů odstraněno."
msgstr[2] "@count uživatelů odstraněno."

msgid "1 user"
msgid_plural "@count users"
msgstr[0] "1 uživatel"
msgstr[1] "@count uživatelů"
msgstr[2] "@count uživatelů"

msgid "users"
msgstr "uživatelé"

msgid "Generate a given number of users. Optionally delete current users."
msgstr "Generujte daný počet uživatelů. Volitelně odstraňte aktuální uživatele."

msgid "Number of vocabularies?"
msgstr "Počet slovníků?"

msgid "Maximum number of characters in vocabulary names"
msgstr "Maximální počet znaků ve slovníkových názvech"

msgid "Delete existing vocabularies before generating new ones."
msgstr "Před generováním nových slovníků odstraňte existující slovníky."

msgid "Deleted existing vocabularies."
msgstr "Odstraněny existující slovníky."

msgid "Created the following new vocabularies: @vocs"
msgstr "Vytvořeny následující nové slovníky: @vocs"

msgid "Invalid number of vocabularies: @num."
msgstr "Neplatný počet slovníků: @num."

msgid "vocabularies"
msgstr "slovníky"

msgid "Generate a given number of vocabularies. Optionally delete current vocabularies."
msgstr "Generujte daný počet slovníků. Volitelně můžete odstranit aktuální slovníky."

