msgid "CDN Warmer"
msgstr "Préchauffeur de CDN"

msgid "Executes HTTP requests to warm the edge caches. It is useful without a CDN as well, as it will also warm Varnish and Page Cache."
msgstr "Exécute des demandes HTTP pour préchauffer les caches périphériques. Il est utile sans CDN également, car il préchauffe aussi Varnish et le cache de page."

msgid "URLs"
msgstr "Adresses URL"

msgid "Enter the list of URLs. One on each line. Examples: https://example.org/foo/bar, /foo/bar."
msgstr "Entrez la liste des adresses URL. Une sur chaque ligne. Exemples : https://example.org/foo/bar, /foo/bar."

msgid "Headers"
msgstr "En-têtes"

msgid "Specific headers to use when making HTTP requests. Format: <code>Header-Name: value1; value2</code>"
msgstr "En-têtes spécifiques à utiliser lors de l'exécution de demandes HTTP. Format : <code>Header-Name: value1; value2</code>"

msgid "Enable SSL verification"
msgstr "Activer la vérification SSL"

msgid "Enable SSL verification. Recommended to keep it checked for security reasons."
msgstr "Activez la vérification SSL. Il est recommandé de conserver cette option sélectionnée pour des raisons de sécurité."

msgid "Maximum number of concurrent Requests."
msgstr "Nombre maximal de demandes simultanées"

msgid "The maximum number of concurrent requests."
msgstr "Nombre maximal de demandes simultanées."

msgid "CDN"
msgstr "CDN"

msgid "minPriority should be a float between 0 and 1."
msgstr "minPriority doit être une variable flottante comprise entre 0 et 1."

msgid "Sitemaps"
msgstr "Plans du site"

msgid "Enter the list of sitemap URLs. One on each line. Examples: https://example.org/sitemap.xml, /drupal-sitemap.xml."
msgstr "Entrez la liste des URL du plan du site. Une sur chaque ligne. Exemples : https://example.org/sitemap.xml, /drupal-sitemap.xml."

msgid "Minimum Priority"
msgstr "Priorité minimale"

msgid "URLs with a lower priority than the configured will not be warmed. A float value between 0 and 1."
msgstr "Les adresses URL dont la priorité est inférieure à la valeur configurée ne seront pas préchauffées. Valeur flottante comprise entre 0 et 1."

msgid "This defines the maximum number of concurrent requests."
msgstr "Définit le nombre maximal de demandes simultanées."

msgid "There was an error parsing the Sitemap in %location. Please check the watchdog logs for more information."
msgstr "Une erreur s'est produite lors de l'analyse syntaxique du plan de site dans %location. Pour plus d'informations, consultez les journaux du programme de surveillance."

msgid "CDN via Sitemap"
msgstr "CDN via le plan du site"

msgid "Collects the URLs to warm from the sitemap. Then uses the CDN warmer for those."
msgstr "Collecte les adresses URL à préchauffer à partir du plan du site. Utilise ensuite le préchauffeur de CDN pour celles-ci."

msgid "All headers must have a colon. Follow the format: <code>the-name: the-value</code>"
msgstr "Tous les en-têtes doivent comporter un signe deux-points. Respectez le format suivant : <code>the-name: the-value</code>"

