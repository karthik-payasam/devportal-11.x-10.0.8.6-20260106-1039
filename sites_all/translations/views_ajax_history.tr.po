msgid "About"
msgstr "Hakkında"

msgid "Enable bookmaking of AJAX views. Supports filters and paging."
msgstr "AJAX görünümlerinin yer işaretlerine eklenmesini etkinleştirin. Süzgeçleri ve sayfalandırmayı destekler."

msgid "Visit the <a href=\":project_link\">Views AJAX History project pages</a> on Drupal.org for more information."
msgstr "Daha fazla bilgi için Drupal.org sitesinde <a href=\":project_link\">Görünümler AJAX Geçmişi proje sayfalarını</a> ziyaret edin."

msgid "Views AJAX History"
msgstr "AJAX Geçmişini görüntüler"

msgid "Add bookmarking abilities to AJAX Views."
msgstr "AJAX Görünümlerine yer işreti ekleme yetenekleri ekleyin."

msgid "Views"
msgstr "Gösterimler"

msgid "Enable history"
msgstr "Geçmişi etkinleştir"

msgid "AJAX history"
msgstr "AJAX geçmişi"

msgid "Enable Views AJAX history."
msgstr "Görünümler AJAX geçmişini etkinleştirin."

msgid "Enable the AJAX history feature for the current view."
msgstr "Geçerli görünüm için AJAX geçmişi özelliğini etkinleştirin."

