msgid "Schema.org: Person"
msgstr "Schema.org: Osoba"

msgid "An additional name for a Person, can be used for a middle name."
msgstr "Další název pro osobu lze použít pro prostřední jméno."

msgid "Physical address of the person."
msgstr "Fyzická adresa osoby."

msgid "An organization that this person is affiliated with. For example, a school/university, a club, or a team."
msgstr "Organizace, se kterou je tato osoba přidružena. Např. school/university, club nebo team."

msgid "An alias for the person."
msgstr "Alias osoby."

msgid "birthDate"
msgstr "birthDate"

msgid "Date of birth of the person in ISO 8601 format, 2017-12-31."
msgstr "Datum narození osoby ve formátu ISO 8601, 2017-12-31."

msgid "The brand of the person."
msgstr "Značka osoby."

msgid "A description of the person."
msgstr "Popis osoby."

msgid "The email address of the person."
msgstr "E-mailová adresa osoby."

msgid "familyName"
msgstr "familyName"

msgid "Family name. In the U.S., the last name of an Person. This can be used along with givenName instead of the name property."
msgstr "Příjmení. V USA příjmení osoby. To lze použít spolu s givenName místo vlastnosti názvu."

msgid "Gender of the person."
msgstr "Pohlaví osoby."

msgid "givenName"
msgstr "givenName"

msgid "Given name. In the U.S., the first name of a Person. This can be used along with familyName instead of the name property."
msgstr "Křestní jméno. V USA křestní jméno osoby. To lze použít spolu s familyName místo vlastnosti názvu."

msgid "Globally unique id of the person, usually a url."
msgstr "Globálně jedinečné ID osoby, obvykle adresa URL."

msgid "The primary image for the person."
msgstr "Primární obrázek pro osobu."

msgid "jobTitle"
msgstr "jobTitle"

msgid "The job title of the person (for example, Financial Manager)."
msgstr "Název pracovní pozice osoby (například Financial Manager)."

msgid "memberOf"
msgstr "memberOf"

msgid "An Organization (or ProgramMembership) to which this Person belongs."
msgstr "Organizace (nebo ProgramMembership), do které tato osoba patří."

msgid "REQUIRED BY GOOGLE. The name of the person."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Jméno osoby."

msgid "REQUIRED BY GOOGLE. A single or an [array] of URLs for the person's official social media profile page(s)."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Jedna adresa URL nebo [array] adres URL oficiální stránky profilu sociálních médií osoby."

msgid "The telephone number of the person."
msgstr "Telefonní číslo osoby."

msgid "REQUIRED. The type of person (fixed by standard)."
msgstr "POŽADOVÁNO. Typ osoby (fixní podle standardu)."

msgid "REQUIRED BY GOOGLE. The URL for the person's official website."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Adresa URL oficiálního webu dané osoby."

msgid "worksFor"
msgstr "worksFor"

msgid "Organizations that the person works for."
msgstr "Organizace, pro které osoba pracuje."

