msgid "About"
msgstr "O stronie"

msgid ""
"\n"
"<p>This module generates and exposes a\n"
"  <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a> schema for\n"
"  <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a> entities,\n"
"  and allows you to expose your own custom schema in a consistent way and with\n"
"  minimal effort.</p>"
msgstr ""
"\n"
"<p>Ten moduł generuje i prezentuje \n"
"  schemat <a href=\"http://graphql.org/\" target=\"_blank\">GraphQL</a> dla\n"
"  jednostek produktu <a href=\"https://www.drupal.org/8\" target=\"_blank\">Drupal 8</a>\n"
"  i umożliwia spójne zaprezentowanie własnego schematu niestandardowego\n"
"  przy minimalnym nakładzie pracy.</p>"

