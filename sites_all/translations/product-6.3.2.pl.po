msgid "All Product entries deleted."
msgstr "Usunięto wszystkie wpisy produktów."

msgid "Drush @func No Product provided"
msgstr "Nie podano produktu dla funkcji @func programu Drush"

msgid "Drush DeleteProduct deleted Product @prod"
msgstr "Operacja DeleteProduct programu Drush usunęła produkt @prod"

msgid "Drush DeleteProduct could not find Product @prod"
msgstr "Operacja DeleteProduct programu Drush nie może znaleźć produktu @prod"

msgid "Drush DeleteProduct deleted retired API @api"
msgstr "Operacja Drush DeleteProduct usunęła wycofany interfejs API @api"

msgid "Drush DeleteProduct No Product provided."
msgstr "Nie podano produktu dla operacji DeleteProduct programu Drush."

msgid "Drush product supersede : found a product in a strange lifecycle state '@state'. Expected 'published' or 'deprecated'."
msgstr "Zastępowanie produktu Drush: znaleziono produkt w dziwnym stanie cyklu życia '@state'. Oczekiwano stanu opublikowany lub nieaktualny."

msgid "Drush SupersedeProduct deleted retired API @api"
msgstr "Operacja Drush SupersedeProduct usunęła wycofany interfejs API @api"

msgid "Drush product supersede : incorrect number of applications with url '@url' found. Should be 1 but was @count."
msgstr "Zastępowanie produktu Drush: znaleziono niepoprawną liczbę aplikacji z adresem URL '@url'. Powinna być równa 1, ale było: @count."

msgid "Drush product supersede : incorrect number of products found. Should be 2 but was @count."
msgstr "Zastępowanie produktu Drush: znaleziono niepoprawną liczbę produktów. Powinny być 2, ale było: @count."

msgid "Drush product supersede : no content provided."
msgstr "Zastępowanie produktu Drush: nie podano treści."

msgid "Drush ReplaceProduct deleted retired API @api"
msgstr "Operacja Drush ReplaceProduct usunęła wycofany interfejs API @api"

msgid "Drush product replace : found a product in a strange lifecycle state '@state'. Expected 'published', 'deprecated' or 'retired'."
msgstr "Zastępowanie produktu Drush: znaleziono produkt w dziwnym stanie cyklu życia '@state'. Oczekiwano stanu opublikowany, nieaktualny lub wycofany."

msgid "Drush product replace : incorrect number of products found. Should be 2 but was @count."
msgstr "Wymienianie produktu Drush: znaleziono niepoprawną liczbę produktów. Powinny być 2, ale było: @count."

