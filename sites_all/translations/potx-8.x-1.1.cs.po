msgid "Generates translation templates from the given Drupal source code in the current working directory."
msgstr "Generuje překladové šablony z daného zdrojového kódu systému Drupal v aktuálním pracovním adresáři. "

msgid "Possible potx modes are:"
msgstr "Možné režimy potx jsou: "

msgid " single    Single file output mode, every file folded into the single output file (default)."
msgstr " single    Režim výstupu do jednoho souboru; každý soubor je složen do jednoho výstupního souboru (výchozí nastavení). "

msgid " multiple  Multiple file output mode, .info files folded into module .pot files."
msgstr " multiple  Režim výstupu do více souborů, soubory .info jsou složeny do souborů .pot modulů. "

msgid " core      Drupal core output mode, .info files folded into general.pot."
msgstr " core      Režim výstupu jádra Drupal, soubory .info jsou složeny do souboru general.pot. "

msgid "If no files are specified, potx will autodiscover files from the current working directory. You can specify concrete files to look at to limit the scope of the operation."
msgstr "Nejsou-li určeny žádné soubory, potx automaticky vyhledá soubory z aktuálního pracovního adresáře. Můžete určit konkrétní soubory, které mají být sledovány tak, aby byl omezen rozsah operace. "

msgid "Stats"
msgstr "Statistiky"

msgid "Files"
msgstr "Soubory"

msgid "Strings"
msgstr "Řetězce"

msgid "Warnings"
msgstr "Varování"

msgid "Errors"
msgstr "Chyby"

msgid "Done"
msgstr "Hotovo"

msgid "YAML parseing error on file @path: @error"
msgstr "Chyba analýzy YAML v cestě @path souboru: @error"

msgid "This page allows you to generate translation templates for module and theme files. Select the module or theme you wish to generate a template file for. A single Gettext Portable Object (Template) file is generated, so you can easily save it and start translation."
msgstr "Tato stránka vám umožňuje generování překladových šablon pro soubory modulu a motivu. Vyberte modul nebo motiv, pro který chcete generovat soubor šablony. Vygeneruje se jeden soubor šablony (šablona) typu Gettext Portable Object (šablona), takže jej můžete snadno uložit a zahájit překlad. "

msgid "PHP tokenizer for Translation template extractor"
msgstr "PHP tokenizér pro extraktor překladové šablony "

msgid "Available"
msgstr "K dispozici"

msgid "Not available"
msgstr "Není k dispozici"

msgid "The <a href=\"@tokenizer\">PHP tokenizer functions</a> are required."
msgstr "Jsou požadovány <a href=\"@tokenizer\">funkce PHP tokenizéru</a>. "

msgid "Translation template extractor"
msgstr "Extraktor překladové šablony"

msgid "Provides a web interface and an API to extract translatable text from the sources of installed components."
msgstr "Poskytuje webové rozhraní a rozhraní API k extrakci přeložitelného textu ze zdrojů nainstalovaných komponent. "

msgid "Multilingual"
msgstr "Vícejazyčné"

msgid "Extract"
msgstr "Extrahovat"

msgid "Language independent template"
msgstr "Šablona nezávislá na jazyku"

msgid "Template file for @langname translations"
msgstr "Soubor šablony pro překlady v jazyce @langname"

msgid "Template language"
msgstr "Jazyk šablony"

msgid "Export a language independent or language dependent (plural forms, language team name, etc.) template."
msgstr "Exportujte šablonu nezávislou nebo závislou na jazyce (plurálové tvary, název týmu jazyka atd.). "

msgid "Include translations"
msgstr "Vložit překlady"

msgid "Include translations of strings in the file generated. Not applicable for language independent templates."
msgstr "Vložte překlady řetězců do vygenerovaného souboru. Nevztahuje se na šablony nezávislé na jazyce. "

msgid "You should select a component to export."
msgstr "Musíte vybrat součást k exportu. "

msgid "Extract from %name in the %directory directory"
msgstr "Extrahovat z %name v adresáři %directory"

msgid "Generates output from all files found in this directory."
msgstr "Generuje výstup ze všech souborů nacházejících se v adresáři. "

msgid "Extract from all in directory \"@directory\""
msgstr "Extrahovat ze všech souborů v adresáři \"@directory\""

msgid "To extract from a single component in this directory, choose the desired entry in the fieldset below."
msgstr "Chcete-li extrahovat z jedné součásti v tomto adresáři, zvolte požadovanou položku v níže uvedené sadě polí. "

msgid "Directory \"@directory\""
msgstr "Adresář \"@directory\""

msgid "Extract from %name"
msgstr "Extrahovat z %name"

msgid "Extract from files named %pattern in the %directory directory."
msgstr "Extrahujte ze souborů s názvem %pattern v adresáři %directory. "

