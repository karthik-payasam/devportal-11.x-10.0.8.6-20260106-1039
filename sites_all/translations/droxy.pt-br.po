msgid "About"
msgstr "Sobre"

msgid "Drupal Proxy Module"
msgstr "Módulo proxy do Drupal"

msgid "Drupal Proxy"
msgstr "Proxy Drupal"

msgid "Proxy"
msgstr "Proxy"

msgid "Proxy Settings"
msgstr "Configurações de proxy"

msgid "ProxySettingForm"
msgstr "ProxySettingForm"

msgid "Https or Https"
msgstr "HTTP ou HTTPS"

msgid "type of Scheme"
msgstr "tipo de esquema"

msgid "Proxy Server"
msgstr "Servidor proxy"

msgid "The IP address or hostname of the proxy server."
msgstr "O endereço IP ou nome do host do servidor proxy."

msgid "Port"
msgstr "Porta"

msgid "The port number used by the proxy server for client connections."
msgstr "O número da porta usado pelo servidor proxy para conexões do cliente."

msgid "Proxy Username"
msgstr "Nome de Usuário de Proxy"

msgid "A username used of proxy server for Authentication."
msgstr "Um nome do usuário usado do servidor proxy para Autenticação."

msgid "Proxy Password"
msgstr "Senha do Proxy"

msgid "Password of proxy server used for Authentication."
msgstr "A senha do servidor proxy usado para Autenticação."

msgid "Proxy User Agent"
msgstr "Agente do usuário do proxy"

msgid "A string which can be used by the proxy server to identify connection requests."
msgstr "Uma sequência que pode ser usada pelo servidor proxy para identificar solicitações de conexão."

msgid "Proxy Exceptions"
msgstr "Exceções de proxy"

msgid "Specify exceptions using either IP addresses or hostnames. Enter one exception per line. Exceptions will be accessed directly, not via proxy."
msgstr "Especifique exceções usando endereços IP ou nomes do host. Insira uma exceção por linha. As exceções serão acessadas diretamente, não por meio do proxy."

