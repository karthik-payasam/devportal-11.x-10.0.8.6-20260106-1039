msgstr "Overstroming-ID @id"

msgid "Blocked"
msgstr "Geblokkeerd"

msgid "Not blocked"
msgstr "Niet geblokkeerd"

msgid "There are no failed logins at this time."
msgstr "Er zijn momenteel geen mislukte aanmeldingspogingen."

msgid "Remove selected items from the flood table"
msgstr "Geselecteerde items uit de overstromingstabel verwijderen"

msgid "Please make a selection."
