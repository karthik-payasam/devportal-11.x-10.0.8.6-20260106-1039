msgid "Schema.org Image Object"
msgstr "Objeto de imagem do Schema.org"

msgid "Adds Schema.org/ImageObject to the JSON LD array."
msgstr "Inclui Schema.org/ImageObject na matriz JSON LD."

msgid "SEO"
msgstr "SEO"

msgid "url"
msgstr "url"

msgid "description"
msgstr "descrição"

msgid "height"
msgstr "altura"

msgid "@id"
msgstr "@id"

msgid "name"
msgstr "nome"

msgid "@type"
msgstr "@type"

msgid "width"
msgstr "largura"

