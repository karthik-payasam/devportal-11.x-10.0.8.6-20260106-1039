msgstr "aggregateRating"

msgid "review"
msgstr "revisão"

msgid "Schema.org: ImageObject"
msgstr "Schema.org: ImageObject"

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "A classificação geral do item, com base em uma coleção de revisões ou classificações."

msgid "contentURL"
msgstr "contentURL"

msgid "Absolute URL of the image, i.e. [node:field_name:image_preset_name:url]."
msgstr "URL absoluta da imagem, por exemplo [node:field_name:image_preset_name:url]."

msgid "The description of the image."
msgstr "A descrição da imagem."

msgid "The height of the image."
msgstr "A altura da imagem."

msgid "Globally unique id of the image object, usually a url."
msgstr "ID globalmente exclusivo do objeto de imagem, geralmente uma URL."

msgid "The title of the image."
msgstr "O título da imagem."

msgid "Review."
msgstr "Revisão."

msgid "REQUIRED. The type of this ImageObject."
msgstr "REQUIRED. O tipo desse ImageObject."

msgid "The width of the image."
msgstr "A largura da imagem."

