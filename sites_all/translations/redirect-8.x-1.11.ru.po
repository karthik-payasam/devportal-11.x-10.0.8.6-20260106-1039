msgstr "Переадресаций нет."

msgid "Note: links open in the current window."
msgstr "Примечание: ссылки открываются в текущем окне."

msgid "Add URL redirect"
msgstr "Добавить перенаправление URL"

msgid "Redirect"
msgstr "Переадресация"

msgid "Allows users to redirect from old URLs to new URLs."
msgstr "Позволяет пользователям настроить перенаправление из старых на новые URL."

msgid "Add redirect"
msgstr "Добавить перенаправление"

msgid "Settings"
msgstr "Настройки"

msgid "Redirect users from one URL to another."
msgstr "Перенаправление пользователей с одного адреса на другой."

msgid "Configure behavior for URL redirects."
msgstr "Настроить поведение перенаправлений адресов (URL)."

msgid "URL Redirects"
msgstr "Перенаправления url-адресов"

msgid "Administer individual URL redirections"
msgstr "Администрирование отдельных перенаправлений URL"

msgid "Administer global URL redirection settings"
msgstr "Администрирование глобальных параметров перенаправлений URL"

msgid "Edit URL redirect"
msgstr "Изменить перенаправление URL"

msgid "Delete URL redirect"
msgstr "Удалить перенаправление URL"

msgid "Redirect settings"
msgstr "Настройка переадресации"

msgid "Automatically create redirects when URL aliases are changed."
msgstr "Автоматически создавать перенаправления, при изменении синонимов URL."

msgid "Default redirect status"
msgstr "Состояние переадресации по умолчанию"

msgid "Retain query string through redirect."
msgstr "Сохранять строку запроса при перенаправлении."

msgid "Display a warning message to users when they are redirected."
msgstr "Показывать пользователям при переадресации предупреждающее сообщение."

msgid "Allow redirections on admin paths."
msgstr "Разрешить перенаправление на административные пути."

msgid "Menu Access Checking"
msgstr "Проверка доступа к меню"

msgid "Enforce clean and canonical URLs."
msgstr "Использовать только чистые и каноничные URL."

msgid "Delete redirect configuration"
msgstr "Удалить конфигурацию перенаправлений"

msgid "Redirect type"
msgstr "Тип перенаправления"

msgid "Output machine name"
msgstr "Машинное имя \"на выходе\""

msgid "Redirect Source formatter"
msgstr "Функция форматирования источника перенаправления"

msgid "Redirect bulk form"
msgstr "Форма для группового перенаправления"

msgid "Redirect 404"
msgstr "Перенаправление 404"

msgid "Overview for 404 error paths with no redirect assigned yet."
msgstr "Обзор путей с ошибками 404, которым еще не присвоены перенаправления."

msgid "Path"
msgstr "Путь"

msgid "The path of the request."
msgstr "Путь запроса."

msgid "The language of this request."
msgstr "Язык запроса."

msgid "Count"
msgstr "Количество"

msgid "The number of requests with that path and language."
msgstr "Число запросов с указанными путем и языком."

msgid "Daily count"
msgstr "Ежедневное число"

msgid "The number of requests with that path and language in a day."
msgstr "Число запросов с указанными путем и языком в день."

msgid "Timestamp"
msgstr "Время"

msgid "The timestamp of the last request with that path and language."
msgstr "Системное время последнего запроса с указанными путем и языком."

msgid "Resolved"
msgstr "Обработано"

msgid "Whether or not this path has a redirect assigned."
msgstr "Указывает, присвоено ли перенаправление этому пути."

msgid "Provide operation buttons to handle the 404 path."
msgstr "Кнопки операций для обработки пути 404."

msgid "404 error database logs to keep"
msgstr "Сохраняемые протоколы базы данных ошибок 404"

msgid "All"
msgstr "Все"

msgid "The maximum number of 404 error logs to keep in the database log. Requires a <a href=\":cron\">cron maintenance task</a>."
msgstr "Максимальное число протоколов ошибок 404 для хранения в протоколе базы данных. Требуется <a href=\":cron\">задача обслуживания cron</a>."

msgid "Pages to ignore"
msgstr "Страницы для игнорирования"

msgid "Specify pages by using their paths. Enter one path per line. The '*' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page."
msgstr "Укажите адреса страниц. Укажите по одному адресу на строку. Знак '*' означает любой набор символов после него. Например, путь %user-wildcard страницы всех пользователей. %front - главная страница."

msgid "Suppress 'page not found' log messages"
msgstr "Запретить регистрацию в протоколе сообщений 'страница не найдена'"

msgid "Prevents logging 'page not found' events. Can be safely enabled when redirect_404 module is used, which stores them separately, nothing else relies on those messages."
msgstr "Запрещает регистрацию в протоколе событий 'страница не найдена'. Можно включить в случае применения модуля redirect_404, который хранит их отдельно. Больше эти сообщения нигде не используются."

msgid "Logs 404 errors and allows users to create redirects for often requested but missing pages."
msgstr "Регистрирует ошибки 404 в протоколе и позволяет пользователям создавать перенаправления для часто запрашиваемых страниц, которые не существуют."

msgid "Fix 404 pages with URL redirects"
msgstr "Исправить ошибки 404 на переадресации"

msgid "Add redirects for 404 pages."
msgstr "Добавить перенаправления для отсутствующих (404) страниц."

msgid "404 error database logging settings."
msgstr "Параметры ведения протоколов базы данных ошибок 404."

msgid "404 error database logs to keep."
msgstr "Сохраняемые протоколы базы данных ошибок 404."

msgid "Whether to log 'page not found' messages to the standard log or not."
msgstr "Указывает, следует ли регистрировать сообщения 'страница не найдена' в стандартном протоколе."

msgid "Redirect 404 operations"
msgstr "Операции перенаправления 404"

msgid "Resolved the path %path in the database. Please check the ignored list and save the settings."
msgstr "Путь %path обработан в базе данных. Проверьте список исключений и сохраните параметры."

msgid "Filter 404s"
msgstr "Фильтровать страницы 404"

msgid "Filter"
msgstr "Фильтр"

msgid "Reset"
msgstr "Сбросить"

msgid "Last accessed"
msgstr "Последний доступ"

msgid "Undefined @langcode"
msgstr "Не задан @langcode"

msgid "There are no 404 errors to fix."
msgstr "Нет ошибок 404 для исправления."

msgid "Ignore"
msgstr "Игнорировать"

msgid "The Redirect domain module allows users to redirect between domains."
msgstr "Модуль Перенаправление доменов позволяет пользователям настроить перенаправление между доменами."

msgid "Manage domain redirects"
msgstr "Управление перенаправлениями между доменами"

msgid "The domain redirect is accessed through <a href=\":domainlist\">Domain Redirects</a>. The user can add the domain redirects through the domain redirect table which consists of the domain from which it needs to be redirected, the sub path and the complete url destination to which it needs to be redirected. The module also supports the usage of a wildcard redirecting, thus many requests can be handled with one instance of domain redirect."
msgstr "Перенаправления между доменами перечислены в модуле <a href=\":domainlist\">Перенаправления доменов</a>. Пользователь может добавить перенаправления доменов с помощью таблицы перенаправлений доменов, которая содержит исходный домен, подпуть и полный целевой URL перенаправления. Кроме того, этот модуль поддерживает перенаправление с помощью символов подстановки - один экземпляр перенаправления домена может обрабатывать несколько запросов."

msgid "The domain redirect table consists of the domain from which it needs to be redirected, the sub path and the complete url destination to which it needs to be redirected."
msgstr "Таблица перенаправлений доменов содержит исходный домен, подпуть и полный целевой URL перенаправления."

msgid "Example Configuration"
msgstr "Пример конфигурации"

msgid "Example Redirects"
msgstr "Примеры перенаправлений"

msgid "Request: example.com/redirect => Response: redirected.com/example-path"
msgstr "Запрос: example.com/redirect => Ответ: redirected.com/example-path"

msgid "Request: foo.com/any-path => Response: bar.com"
msgstr "Запрос: foo.com/any-path => Ответ: bar.com"

msgid "Precedence"
msgstr "Очередность"

msgid "Top-down precedence is used. This means the first matching redirect that is found will be taken. For example, assume these redirect rules:"
msgstr "Применяется очередность по принципу сверху вниз. Это означает, что выполняется первое найденное перенаправление. Например, рассмотрим следующие правила перенаправления: "

msgid "foo.com/some/path => somedomain.com/path"
msgstr "foo.com/some/path => somedomain.com/path"

msgid "foo.com/* => wildcardredirect.com"
msgstr "foo.com/* => wildcardredirect.com"

msgid "foo.com/other/path => otherdomain.com/path"
msgstr "foo.com/other/path => otherdomain.com/path"

msgid "The following redirects would actually occur:"
msgstr "Следующие перенаправления будут выполнены:"

msgid "foo.com/other/path => wildcardredirect.com"
msgstr "foo.com/other/path => wildcardredirect.com"

msgid "Redirect Domain"
msgstr "Перенаправить домен"

msgid "Allows users to redirect between domains."
msgstr "Позволяет пользователям настроить перенаправление между доменами."

msgid "Domain redirects"
msgstr "Переадресации домена"

msgid "Redirect domains"
msgstr "Перенаправить домены"

msgid "Sub path"
msgstr "Путь"

msgid "Destination"
msgstr "Место назначения"

msgid "From domain"
msgstr "С домена"

msgid "Add another"
msgstr "Добавить еще"

msgid "Save"
msgstr "Сохранить"

msgid "No protocol should be included in the redirect domain."
msgstr "В домене перенаправления не следует указывать протокол."

msgid "The domain redirects have been saved."
msgstr "Перенаправления доменов сохранены."

msgid "Redirect ID"
msgstr "ID переадресации"

msgid "The redirect ID."
msgstr "ID переадресации."

msgid "UUID"
msgstr "UUID"

msgid "The record UUID."
msgstr "UUID записи."

msgid "Hash"
msgstr "Хэш"

msgid "The redirect hash."
msgstr "Хэш перенаправления."

msgid "Type"
msgstr "Тип"

msgid "The redirect type."
msgstr "Тип перенаправления."

msgid "User ID"
msgstr "ID Пользователя"

msgid "The user ID of the node author."
msgstr "ИД пользователя автора узла."

msgid "Enter an internal Drupal path or path alias to redirect (e.g. %example1 or %example2). Fragment anchors (e.g. %anchor) are <strong>not</strong> allowed."
msgstr "Введите внутренний путь Drupal или псевдоним пути для перенаправления (например %example1 или %example2). Метки фрагментов (например %anchor) <strong>не</strong> разрешены."

msgid "To"
msgstr "Кому"

msgid "The redirect language."
msgstr "Язык перенаправления."

msgid "Status code"
msgstr "Код состояния"

msgid "The redirect status code."
msgstr "Код состояния перенаправления."

msgid "Created"
msgstr "Создано"

msgid "The date when the redirect was created."
msgstr "Дата создания перенаправления."

msgid "Redirect loop identified at %path for redirect %rid"
msgstr "Цикл перенаправления обнаружен в %path для перенаправления %rid"

msgid "Are you sure you want to delete the URL redirect from %source to %redirect?"
msgstr "Действительно хотите удалить перенаправление с %source на %redirect?"

msgid "Delete"
msgstr "Удалить"

msgid "The redirect %redirect has been deleted."
msgstr "Перенаправление %redirect удалено."

msgid "Deleted @count redirects."
msgstr "Удалено @count перенаправлений."

msgid "Are you sure you want to delete this redirect?"
msgid_plural "Are you sure you want to delete these redirects?"
msgstr[0] "Вы действительно хотите удалить это перенаправление?"
msgstr[1] "Вы действительно хотите удалить эти перенаправления?"
msgstr[2] "Вы действительно хотите удалить эти перенаправления?"

msgid "Deleted 1 redirect."
msgid_plural "Deleted @count redirects."
msgstr[0] "Удалён @count перенаправление."
msgstr[1] "Удалено @count перенаправления."
msgstr[2] "Удалено @count перенаправлений."

msgid "Invalid redirect URL %url provided."
msgstr "Указан недопустимый URL перенаправления %url."

msgid "- All languages -"
msgstr "- Все языки -"

msgid "Redirect status"
msgstr "Состояние перенаправления"

msgid "You can find more information about HTTP redirect status codes at <a href=\"@status-codes\">@status-codes</a>."
msgstr "Дополнительная информация о кодах состояния перенаправлений HTTP приведена на странице <a href=\"@status-codes\">@status-codes</a>."

msgid "It is not allowed to create a redirect from the front page."
msgstr "Главную страницу нельзя указывать в качестве источника перенаправления."

msgid "The anchor fragments are not allowed."
msgstr "Фрагменты меток запрещены."

msgid "The url to redirect from should not start with a forward slash (/)."
msgstr "URL перенаправления должен начинаться с косой черты (/)."

msgid "You are attempting to redirect the page to itself. This will result in an infinite loop."
msgstr "Вы пытаетесь переадресовать страницу саму на себя. Это приведёт к бесконечному циклу."

msgid "The source path %source is already being redirected. Do you want to <a href=\"@edit-page\">edit the existing redirect</a>?"
msgstr "Для исходного пути %source уже создано перенаправление. <a href=\"@edit-page\">Изменить существующее перенаправление</a>?"

msgid "The redirect has been saved."
msgstr "Перенаправление было сохранено."

msgid "For example, given a redirect from %source to %redirect, if a user visits %sourcequery they would be redirected to %redirectquery. The query strings in the redirection will always take precedence over the current query string."
msgstr "Например, если настроено перенаправление из %source на %redirect, то при посещении %sourcequery пользователь будет перенаправлен на %redirectquery. Строки запросов в перенаправлении всегда обладают более высоким приоритетом по сравнению с текущей строкой запроса."

msgid "Global redirects"
msgstr "Глобальные перенаправления"

msgid "(formerly Global Redirect features)"
msgstr "(функции из Global Redirect)"

msgid "Enabling this will automatically redirect to the canonical URL of any page. That includes redirecting to an alias if existing, removing trailing slashes, ensure the language prefix is set and similar clean-up."
msgstr "Обеспечивает автоматическое перенаправление на канонический URL любой страницы, включая перенаправление с помощью псевдонима, удаление конечных символов косой черты, проверку наличия префикса языка и другую очистку."

msgid "Ignore redirections on admin paths."
msgstr "Игнорировать перенаправления на административных страницах."

msgid "Check access to the redirected page"
msgstr "Проверять доступ к перенаправляемой странице"

msgid "This helps to stop redirection on protected pages and avoids giving away <em>secret</em> URL's. <strong>By default this feature is disabled to avoid any unexpected behavior</strong>"
msgstr "Помогает запретить перенаправление на защищенные страницы и избежать раскрытия <em>секретных</em> URL. <strong>По умолчанию эта функция выключена, чтобы избежать непредвиденных результатов</strong>"

msgid "Delete redirect"
msgstr "Удалить перенаправление"

msgid "Redirect Source"
msgstr "Источник перенаправления"

msgid "Query"
msgstr "Запрос"

msgid "Redirect source"
msgstr "Источник перенаправления"

msgid "Stores a redirect source"
msgstr "Сохраняет источник перенаправления"

msgid "The source path %path is likely a valid path. It is preferred to <a href=\"@url-alias\">create URL aliases</a> for existing paths rather than redirects."
msgstr "Исходный путь %path скорее всего допустим. Для существующих путей рекомендуется <a href=\"@url-alias\">создать псевдонимы URL</a>, а не перенаправления."

msgid "The base source path %source is already being redirected. Do you want to <a href=\"@edit-page\">edit the existing redirect</a>?"
msgstr "Для базового исходного пути %source уже создано перенаправление. <a href=\"@edit-page\">Изменить существующее перенаправление</a>?"

