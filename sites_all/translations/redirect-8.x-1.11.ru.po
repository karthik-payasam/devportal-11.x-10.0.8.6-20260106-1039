msgid "Invalid number of redirects."
msgstr "Недопустимое число перенаправлений."

msgid "How many URL redirects would you like to generate?"
msgstr "Сколько переадресаций вы хотели бы создать?"

msgid "Delete all URL redirects before generating new URL redirects."
msgstr "Удалить все переадресации перед созданием новых."

msgid "Generate"
msgstr "Создать"

msgid "Deleted URL redirect @rid."
msgstr "Удалено перенаправление URL @rid."

msgid "An error occurred while processing @operation with arguments : @args"
msgstr "Возникла ошибка в процессе @operation с аргументами: @args"

msgid "One URL redirect created."
msgid_plural "@count URL redirects created."
msgstr[0] "Создано одно перенаправление URL."
msgstr[1] "Создано перенаправлений URL: @count."
msgstr[2] "Создано перенаправлений URL: @count."

msgid "About"
msgstr "Информация"

msgid "The Redirect module allows users to redirect from old URLs to new URLs.   For more information, see the <a href=\":online\">online documentation for Redirect</a>."
msgstr "Модуль Перенаправление позволяет пользователям настроить перенаправление из старых на новые URL.   См. <a href=\":online\">электронную документацию по модулю Перенаправление</a>."

msgid "Uses"
msgstr "Использование"

msgid "Redirect is accessed from three tabs that help you manage <a href=\":list\">URL Redirects</a>."
msgstr "Для управления <a href=\":list\">перенаправлениями URL</a> применяются три вкладки."

msgid "Manage URL Redirects"
msgstr "Управление перенаправлениями URL"

msgid "The <a href=\":redirect\">\"URL Redirects\"</a> page is used to setup and manage URL Redirects.  New redirects are created here using the <a href=\":add_form\">Add redirect</a> button which presents a form to simplify the creation of redirects . The URL redirects page provides a list of all redirects on the site and allows you to edit them."
msgstr "Страница <a href=\":redirect\">\"Перенаправления URL\"</a> предназначена для настройки перенаправлений URL и управления ими.  Новые перенаправления создаются здесь с помощью кнопки <a href=\":add_form\">Добавить перенаправление</a>, которая открывает форму, упрощающую создание перенаправлений. Страница перенаправлений URL содержит список всех перенаправлений на сайте и позволяет редактировать их."

msgid "Fix 404 pages"
msgstr "Исправление 404 страниц"

msgid "<a href=\":fix_404\">\"Fix 404 pages\"</a> lists all paths that have resulted in 404 errors and do not yet have any redirects assigned to them. This 404 (or Not Found) error message is an HTTP standard response code indicating that the client was able to communicate with a given server, but the server could not find what was requested."
msgstr "На странице <a href=\":fix_404\">\"Исправить страницы 404\"</a> перечислены все пути с ошибками 404, для которых еще не настроены перенаправления. Сообщение об ошибке 404 (Не найдено) представляет собой стандартный код ответа HTTP, который указывает, что клиент получил доступ к целевому серверу, однако серверу не удалось найти запрошенный ресурс."

msgid "404 (or Not Found) error message is an HTTP standard response code indicating that the client was able to communicate with a given server, but the server could not find what was requested. Please install the <a href=\":extend\">Redirect 404</a> submodule to be able to log all paths that have resulted in 404 errors."
msgstr "Сообщение об ошибке 404 (Не найдено) представляет собой стандартный код ответа HTTP, который указывает, что клиент получил доступ к целевому серверу, однако серверу не удалось найти запрошенный ресурс. Установите подмодуль <a href=\":extend\">Перенаправление 404</a>, чтобы регистрировать в протоколе все пути, вызвавшие ошибки 404."

msgid "Configure Global Redirects"
msgstr "Настроить глобальные перенаправления"

msgid "The <a href=\":settings\">\"Settings\"</a> page presents you with a number of means to adjust redirect settings."
msgstr "Страница <a href=\":settings\">\"Параметры\"</a> содержит набор параметров для настройки перенаправления."

msgid "Add URL redirect from this page to another location"
msgstr "Добавить перенаправление с этой страницы в другое место"

msgid "300 Multiple Choices"
msgstr "300 Множество Выборов"

msgid "301 Moved Permanently"
msgstr "301 Перемещёно Окончательно"

msgid "302 Found"
msgstr "302 Найдено"

msgid "303 See Other"
msgstr "303 Смотреть Другое"

msgid "304 Not Modified"
msgstr "304 Не Изменялось"

msgid "305 Use Proxy"
msgstr "305 Использовать Прокси"

msgid "307 Temporary Redirect"
msgstr "307 - Временно перемещено"

msgid "Language"
msgstr "Язык"

msgid "All languages"
msgstr "Все языки"

msgid "A redirect set for a specific language will always be used when requesting this page in that language, and takes precedence over redirects set for <em>All languages</em>."
msgstr "Установки перенаправлений на конкретный язык всегда будут использоваться при запросе страницы на этом языке, и имеют приоритет над установками перенаправлений на странице <em>Все языки</em>."

msgid "URL redirects"
msgstr "Перенаправления url-адресов"

msgid "Redirect module form elements"
msgstr "Форма модуля перенаправлений"

msgid "From"
msgstr "От"

msgid "Operations"
msgstr "Операции"

