msgstr "-- Любая -- "

msgid "-- Fixed -- "
msgstr "-- Фиксированная -- "

msgid "Which thread to run in when invoking with ?thread=N. Note: This setting only has an effect when cron is run through cron.php with an argument ?thread=N or through Drush with --options=thread=N."
msgstr "Нить, применяемая в случае вызова с аргументом ?thread=N. Примечание: этот параметр учитывается только в случае запуска cron с помощью cron.php с аргументом ?thread=N или с помощью Drush с аргументом --options=thread=N."

msgid "%title must be greater than 0"
msgstr "Значение %title должно быть больше 0"

msgid "Launched in thread @current_thread"
msgstr "Запущено в нити @current_thread"

msgid "Invalid thread available for starting launch thread"
msgstr "Недопустимая нить доступна для начальной нити "

msgid "Thread @thread is already running"
msgstr "Нить @thread уже запущена"

msgid "No free threads available for launching jobs"
msgstr "Нет свободных нитей для запуска заданий"

msgid "Serial"
msgstr "Последовательность"

msgid "Launches scheduled jobs in the same thread and runs them consecutively."
msgstr "Запускает запланированные задания в одной нити и последовательно выполняет их. "

msgid "Stores the last log entry (and only the last) in the cache."
msgstr "Сохраняет последнюю запись протокола (только последнюю) в кэше. "

msgid "Lock #@original_lid was already closed and logged. Creating a new log entry #@lid"
msgstr "Блокировка #@original_lid уже закрыта и зарегистрирована в протоколе. Создание новой записи протокола #@lid"

msgid "@count_entries log entries removed for @jobs_count jobs"
msgstr "Удалено записей протоколов: @count_entries, число заданий: @jobs_count"

msgid "Invalid cleanup method: @method"
msgstr "Недопустимый метод очистки: @method"

msgid "Stores logs in the database."
msgstr "Хранит протоколы в базе данных. "

msgid "Next scheduled run at @datetime"
msgstr "Следующий зарегистрированный запуск: @datetime"

msgid "Comma separated list of crontab rules."
msgstr "Список правил crontab (в качестве разделителя применяется запятая)."

msgid "Rule is invalid"
msgstr "Недопустимое правило"

msgid "Use crontab rules for scheduling jobs."
msgstr "Использовать правила crontab для планирования заданий. "

msgid "Every @interval"
msgstr "Каждые @interval"

msgid "Provides a set of predefined intervals for scheduling."
msgstr "Предлагает набор предопределенных интервалов для планирования. "

