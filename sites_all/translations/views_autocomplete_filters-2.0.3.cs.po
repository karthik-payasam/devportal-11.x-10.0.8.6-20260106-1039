msgid "Views Autocomplete Filters"
msgstr "Filtry automatického dokončování pohledů"

msgid "Use Autocomplete for string field filters."
msgstr "Použijte automatické dokončování pro filtry polí řetězce."

msgid "Views"
msgstr "Views"

msgid "Autocomplete for Combine fields filter"
msgstr "Automatické dokončování pro filtr kombinovaných polí"

msgid "Exposed"
msgstr "Vystaveno"

msgid "Use Autocomplete"
msgstr "Použít automatické dokončování"

msgid "Minimum number of characters to start filter"
msgstr "Minimální počet znaků ke spuštění filtru"

msgid "Maximum number of items in Autocomplete"
msgstr "Maximální počet položek v automatickém dokončování"

msgid "Field with autocomplete results"
msgstr "Pole s výsledky automatického dokončování"

msgid "Unformatted suggestion"
msgstr "Neformátovaný návrh"

msgid "Unformatted dropdown"
msgstr "Neformátovaná rozevírací nabídka"

msgid "Suggestions depend on other filter fields"
msgstr "Návrhy závisejí na jiných polích filtru"

msgid "Autocomplete for Search API fulltext search filter"
msgstr "Automatické dokončování pro filtr vyhledávání fulltextového rozhraní API hledání"

msgid "Autocomplete for Search API text field filter"
msgstr "Automatické dokončování pro filtr textového pole rozhraní API hledání"

msgid "Autocomplete for basic textfield filter"
msgstr "Automatické dokončování pro filtr základního textového pole"

msgid "Field for autocomplete filter %label is not set in view %view, display %display"
msgstr "Pole pro filtr automatického dokončování %label není nastaveno v pohledu %view, zobrazení %display"

msgid "Field for autocomplete filter %label not exists in view %view, display %display"
msgstr "Pole pro filtr automatického dokončování %label neexistuje v pohledu %view, zobrazení %display"

msgid "Use Autocomplete for this filter."
msgstr "Použijte automatické dokončování pro tento filtr."

msgid "Enter 0 for no limit."
msgstr "Zadejte 0 pro žádný limit."

msgid "Autocomplete suggestions will be filtered by other filter fields"
msgstr "Návrhy automatického dokončování budou filtrováno podle ostatních polí filtru"

msgid "The selected field will be used for drop-down results of the autocompletion. In most cases it should be the same field you use for the filter, and <em>must</em> be included in the field list for the view/display in order to appear here."
msgstr "Vybrané pole bude použito pro rozevírací výsledky automatického doplňování. Ve většině případů by se mělo jednat o stejné pole, které používáte pro filtr, a <em>musí</em> být zahrnuto v seznamu polí pro zobrazení/pohled, aby se zde objevilo."

msgid "Use unformatted data from database for dropdown list instead of field formatter result. Value will be printed as plain text."
msgstr "Použijte neformátovaná data z databáze pro rozevírací seznam místo výsledku formátovače pole. Hodnota bude vytištěna jako prostý text."

msgid "The same as above, but for suggestion (text appearing inside textfield when item is selected)."
msgstr "To samé, co je uvedeno výše, ale pro návrh (text obsažený v textovém poli, když je vybrána položka)."

msgid "Add some fields to view"
msgstr "Přidat některá pole do pohledu"

