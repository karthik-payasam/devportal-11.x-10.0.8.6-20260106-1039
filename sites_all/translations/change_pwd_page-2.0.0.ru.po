msgid "About"
msgstr "Информация"

msgid "The Password Separate Form module provides the separate password change form. By default it comes with user account page that little bit confusing for end users. This module would help to provide this form as a separate form to help end users, there is no need to change password fields every time if you are editing some other fields on user account page."
msgstr "Модуль Password Separate Form предлагает отдельную форму изменения пароля. По умолчанию отображается страница учетной записи пользователя, что может вызывать неудобства конечных пользователей. Этот модуль предоставляет отдельную форму, чтобы избежать изменения полей пароля каждый раз при редактировании других полей на странице учетной записи. "

msgid "Required if you want to change the %mail below. <a href=\":request_new_url\" title=\"Send password reset instructions via email.\">Reset your password</a>."
msgstr "Требуется для изменения %mail ниже. <a href=\":request_new_url\" title=\"Send password reset instructions via email.\">Сбросить пароль</a>."

msgid "Policy"
msgstr "Политика"

msgid "Status"
msgstr "Статус"

msgid "Constraint"
msgstr "Ограничение"

msgid "There are no constraints for the selected user roles"
msgstr "Для выбранных ролей пользователей отсутствуют ограничения"

msgid "Password Separate Form"
msgstr "Password Separate Form"

msgid "Provides a separate page containing a form for the current user to change their password."
msgstr "Предлагает отдельную страницу с формой для изменения пароля текущего пользователя. "

msgid "User Management"
msgstr "Управление пользователями"

msgid "Change password"
msgstr "Сменить пароль"

msgid "Change Password"
msgstr "Сменить пароль"

msgid "Reset password"
msgstr "Сброс пароля"

msgid "Another user (%other_user) is already logged into the site on this computer, but you tried to use a one-time link for user %resetting_user. Please <a href=\":logout\">log out</a> and try using the link again."
msgstr "Другой пользователь (%other_user) уже вошёл в систему на этом компьютере, но вы попытались использовать одноразовую ссылку для пользователя %resetting_user. <a href=\":logout\">выйдите из системы</a> и повторите попытку."

msgid "The one-time login link you clicked is invalid."
msgstr "Одноразовая ссылка входа, которую вы использовали, недействительна."

msgid "You have tried to use a one-time login link that has expired. Please request a new one using the form below."
msgstr "Вы попытались использовать одноразовую ссылку, срок действия которой уже истек. Пожалуйста запросите новую ссылку, используя форму ниже."

msgid "You have tried to use a one-time login link that has either been used or is no longer valid. Please request a new one using the form below."
msgstr "Вы пытаетесь воспользоваться одноразовой ссылкой, срок действия которой уже истёк. Для того, чтобы получить новую ссылку, воспользуйтесь функцией восстановления пароля."

msgid "To change the current user password, enter the new password in both fields."
msgstr "Для изменения текущего пароля, введите новый пароль в обоих полях."

msgid "Current password"
msgstr "Текущий пароль"

msgid "Required if you want to change the %pass below. <a href=\":request_new_url\" title=\"Send password reset instructions via email.\">Reset your password</a>."
msgstr "Требуется для изменения %pass ниже. <a href=\":request_new_url\" title=\"Send password reset instructions via email.\">Сбросить пароль</a>."

msgid "Password"
msgstr "Пароль"

msgid "Roles"
msgstr "Роли"

msgid "Submit"
msgstr "Отправить"

msgid "The current password you provided is incorrect."
msgstr "Указан неверный текущий пароль. "

msgid "Your password has been changed."
msgstr "Пароль изменен. "

msgid ""
"<p>This is a one-time login for %user_name and will expire on \n"
"%expiration_date.</p><p>Click on this button to log in to the site and change your password.</p>"
msgstr ""
"<p>Это однократный вход в систему для %user_name, действующий до \n"
"%expiration_date.</p><p>Нажмите кнопку, чтобы войти на сайт и изменить пароль. </p>"

msgid "<p>This is a one-time login for %user_name.</p><p>Click on this button to log in to the site and change your password.</p>"
msgstr "<p>Это ссылка для одноразового входа для %user_name.</p><p>Нажмите на эту ссылку для входа на сайт и изменения пароля</p>"

msgid "Set password"
msgstr "Установить пароль"

msgid "This login can be used only once."
msgstr "Вход с использованием данной ссылки может быть выполнен только один раз."

msgid "Log in"
msgstr "Войти"

msgid "You have just used your one-time login link. It is no longer necessary to use this link to log in. Please change your password."
msgstr "Вы только что использовали вашу ссылку одноразового входа. Она больше недействительна. Пожалуйста, введите ваш новый пароль."

msgid "User %name used one-time login link at time %timestamp."
msgstr "Пользователь %name использовал (%timestamp) одноразовую ссылку для входа на сайт."

