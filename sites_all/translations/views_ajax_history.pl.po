msgid "About"
msgstr "Informacje"

msgid "Enable bookmaking of AJAX views. Supports filters and paging."
msgstr "Włącz tworzenie zakładek widoków AJAX. Obsługuje filtry i stronicowanie."

msgid "Visit the <a href=\":project_link\">Views AJAX History project pages</a> on Drupal.org for more information."
msgstr "Aby uzyskać więcej informacji, odwiedź <a href=\":project_link\">strony projektu AJAX History</a> w serwisie Drupal.org."

msgid "Views AJAX History"
msgstr "Wyświetla historię AJAX"

msgid "Add bookmarking abilities to AJAX Views."
msgstr "Dodaj możliwości tworzenia zakładek do widoków AJAX."

msgid "Views"
msgstr "Widoki"

msgid "Enable history"
msgstr "Włącz historię"

msgid "AJAX history"
msgstr "Historia AJAX"

msgid "Enable Views AJAX history."
msgstr "Włącz historię AJAX widoków."

msgid "Enable the AJAX history feature for the current view."
msgstr "Włącz funkcję historii AJAX dla bieżącego widoku."

