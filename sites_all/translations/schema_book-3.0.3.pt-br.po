msgid "Schema.org Book"
msgstr "Livro do Schema.org"

msgid "Adds Schema.org/Book to the JSON LD array."
msgstr "Inclui Schema.org/Book na matriz JSON LD."

msgid "SEO"
msgstr "SEO"

msgid "author"
msgstr "autor"

msgid "@id"
msgstr "@id"

msgid "name"
msgstr "nome"

msgid "description"
msgstr "descrição"

msgid "sameAs"
msgstr "SameAs"

