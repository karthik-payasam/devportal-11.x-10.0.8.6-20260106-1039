msgid "Back To Top"
msgstr "上部に戻る"

msgid "Back To Top adds a button that hovers in the bottom of your screen and allow users to smoothly scroll up the page using jQuery."
msgstr "「上部に戻る」は、画面下部に固定表示され、ユーザーがスムーズにページをスクロールアップできるようにする、jQuery を使用したボタンを追加します。"

msgid "User interface"
msgstr "ユーザーインターフェース"

msgid "Back to Top"
msgstr "トップに戻る"

msgid "Administer Back To Top settings."
msgstr "「上部に戻る」設定を管理します。"

msgid "Back to top settings"
msgstr "「上部に戻る」設定"

msgid "Access Back to top settings"
msgstr "Back to top の設定"

msgid "Prevent on mobile and touch devices"
msgstr "モバイル・デバイスおよびタッチ・デバイスでの抑止"

msgid "Prevent on administration pages and node edit"
msgstr "管理ページおよびノード編集での抑止"

msgid "Prevent on front page"
msgstr "フロントページでの抑止"

msgid "Trigger"
msgstr "トリガー"

msgid "Placement"
msgstr "配置"

msgid "Button text"
msgstr "ボタンのテキスト"

msgid "Button type"
msgstr "ボタン・タイプ"

msgid "Background color"
msgstr "背景色"

