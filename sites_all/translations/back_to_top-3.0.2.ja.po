msgstr "中間中央"

msgid "Set the text of the Back To Top button"
msgstr "「上部に戻る」ボタンのテキストの設定"

msgid "Do you want Back To Top to use a PNG-24 image or a Text/Css button?"
msgstr "「上部に戻る」に PNG-24 イメージと Text/Css ボタンのどちらを使用しますか?"

msgid "Image (default)"
msgstr "イメージ (デフォルト)"

msgid "Text/Css"
