msgstr "テキストの色"

msgid "Back to top"
msgstr "トップに戻る"

msgid "Don´t show Back To Top-button on screen width up to 760px."
msgstr "760px までの画面幅で「トップに戻る」ボタンを表示しません。"

msgid "Do you want to prevent Back To Top on admin pages?"
msgstr "管理ページで「上部に戻る」を抑止しますか?"

msgid "Do you want to prevent Back To Top on front page?"
msgstr "フロントページで「上部に戻る」を抑止しますか?"

msgid "Set the number of pixel which trigger the Back To Top button default 100"
msgstr "「上部に戻る」ボタンをトリガーするピクセル数をデフォルトの 100 に設定します"

msgid "Where should the Back To Top button appear?"
msgstr "「上部に戻る」ボタンをどこに表示しますか?"

msgid "Bottom right"
msgstr "ボトム 右"

msgid "Bottom left"
msgstr "ボトム 左"

msgid "Bottom center"
msgstr "ボトム 中央"

msgid "Top right"
