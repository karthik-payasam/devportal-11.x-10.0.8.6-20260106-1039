msgid "OpenAPI"
msgstr "OpenAPI"

msgid "Connects Drupal to the OpenAPI Javascript Library"
msgstr "Koppelt Drupal aan de OpenAPI Javascript Library"

msgid "Available OpenAPI Documentation."
msgstr "Beschikbare OpenAPI-documentatie."

msgid "Access API Docs"
msgstr "Naar API Docs gaan"

msgid "Access documentation page for the REST API"
msgstr "Naar de documentatiepagina voor de REST-API gaan"

msgid "OpenAPI Schema Download"
msgstr "OpenAPI-schema downloaden"

msgid "OpenAPI Resources"
msgstr "OpenAPI-resources"

msgid "OpenAPI Documentation"
msgstr "OpenAPI-documentatie"

msgid "%label OpenApi Schema Download"
msgstr "OpenApi-schema %label downloaden"

msgid "The specifications provide the documentation on some of Drupal's apis following <a href=':openapi_spec'>OpenAPI (aka Swagger)</a> standards."
msgstr "De specificaties geven de documentatie over enkele van de API's van Drupal volgens de <a href=':openapi_spec'>OpenAPI (Swagger)</a>-standaarden."

msgid "These json files can be used in tools such as the <a href=\":swagger_editor\">Swagger Editor</a> to provide a more detailed version of the API documentation or <a href=\":swagger_codegen\">Swagger Codegen</a> to create an api client."
msgstr "Deze json-bestanden kunnen worden gebruikt in tools zoals <a href=\":swagger_editor\">Swagger Editor</a> om een meer gedetailleerde versie van de API-documentatie te maken of in <a href=\":swagger_codegen\">Swagger Codegen</a> voor het maken van een API-client."

msgid "Module"
msgstr "Module"

msgid "Specification"
msgstr "Specificatie"

msgid "Explore"
msgstr "Verkennen"

msgid "Please visit the <a href=':openapi_ui_link'>OpenAPI UI module</a> for information on these interfaces and to discover others."
msgstr "Ga naar <a href=':openapi_ui_link'>OpenAPI UI-module</a> voor informatie over deze en andere interfaces."

msgid "No UI plugins available"
msgstr "Geen UI-plugins beschikbaar"

msgid "There are no plugins available for exploring the OpenAPI documentation."
msgstr "Er zijn geen plugins beschikbaar voor het verkennen van de OpenAPI-documentatie."

msgid "You can install one of the below projects to view the API Specifications from with your site."
msgstr "U kunt een van de onderstaande projecten installeren om de API-specificaties vanuit uw site te bekijken."

msgid "View/Download"
msgstr "Bekijken/downloaden"

msgid "Explore with %interface"
msgstr "Verkennen met %interface"

msgid "No UI available."
msgstr "Geen UI beschikbaar."

msgid "No OpenApi generator plugins are currently available."
msgstr "Er zijn momenteel geen OpenApi-generatorplugins beschikbaar."

msgid "You must enable a REST or API module which supports OpenApi Downloads, such as the <a href=\":rest_link\">Core Rest</a> and <a href=\":jsonapi_link\">JSON:API</a> modules."
msgstr "U moet een REST-of API-module inschakelen die ondersteuning biedt voor OpenApi-downloads, zoals de modules <a href=\":rest_link\">Core Rest</a> en <a href=\":jsonapi_link\">JSON:API</a>."

msgid "%generator OpenApi Documentation"
msgstr "%generator OpenApi-documentatie"

