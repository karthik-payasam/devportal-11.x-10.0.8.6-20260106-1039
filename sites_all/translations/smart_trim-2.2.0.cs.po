msgid "About"
msgstr "Popis"

msgid "Smart Trim implements a new field formatter for text fields (text, text_long, and text_with_summary, if you want to get technical) that improves upon the \"Summary or Trimmed\" formatter."
msgstr "Inteligentní oříznutí implementuje nový formátovač textových polí (pokud chcete zacházet do technických detailů, tak text, text_long a text_with_summary), který je vylepšením formátovacího nástroje \"Souhrnný nebo oříznutý\"."

msgid "More"
msgstr "Více"

msgid "Read more about [node:title]"
msgstr "Přečtěte si více o [node:title]"

msgid "Smart Trim"
msgstr "Inteligentní oříznutí"

msgid "Provides a more robust alternative to \"summary or trimmed\" textfield format"
msgstr "Nabízí robustnější alternativu k \"souhrnnému nebo oříznutému\" formátu textového pole"

msgid "Fields"
msgstr "Pole"

msgid "Smart trim formatter settings"
msgstr "Nastavení formátovače inteligentního oříznutí"

msgid "Trim length"
msgstr "Délka oříznutí"

msgid "Trim units"
msgstr "Jednotky oříznutí"

msgid "Suffix"
msgstr "Suffix"

msgid "Wrap trimmed content"
msgstr "Zabalit oříznutý obsah"

msgid "Wrapped content class"
msgstr "Třída zabaleného obsahu"

msgid "More link configuration"
msgstr "Konfigurace odkazu Další"

msgid "Display more link"
msgstr "Zobrazit odkaz na další"

msgid "Open link in new window"
msgstr "Otevřít odkaz v novém okně"

msgid "More link only when content is trimmed"
msgstr "Odkazy Další pouze při oříznutí obsahu"

msgid "More link class"
msgstr "Třída odkazu na další"

msgid "More link text"
msgstr "Text odkazu \"více\""

msgid "More link aria-label value"
msgstr "Hodnota popisku aria-label odkazu Další"

msgid "Summary handler"
msgstr "Popisovač souhrnu"

msgid "Additional options"
msgstr "Další volby"

msgid "Strip HTML"
msgstr "Odstranit HTML"

msgid "Honor a zero trim length"
msgstr "Dodržet nulovou délku oříznutí"

msgid "Replace tokens before trimming"
msgstr "Nahradit tokeny před ořezáním"

msgid "Characters"
msgstr "Znaky"

msgid "Words"
msgstr "Slov"

msgid "Summary"
msgstr "Souhrn"

msgid "Use summary if present, and do not trim"
msgstr "Použít souhrn, pokud existuje, a neořezávat"

msgid "Use summary if present, honor trim settings"
msgstr "Použít souhrn, pokud existuje, dodržet nastavení oříznutí"

msgid "Do not use summary"
msgstr "Nepoužívat souhrn"

msgid "Wrap trimmed content?"
msgstr "Zabalit oříznutý obsah?"

msgid "Adds a wrapper div to trimmed content. This option is deprecated and will be removed in Smart Trim 3.0.0. Please override the smart-trim.html.twig template file to customize output."
msgstr "Přidá modul wrapper div k oříznutému obsahu. Tato volba je zamítnuta a bude odebrána v produktu Smart Trim 3.0.0. Chcete-li upravit výstup, přepište soubor šablony smart-trim.html.twig."

msgid "Wrapped content class."
msgstr "Třída zabaleného obsahu."

msgid "If wrapping, define the class name here."
msgstr "Pokud dojde k zabalení, definujte zde název třídy."

msgid "<em>More</em> link"
msgstr "Odkaz <em>Další</em>"

msgid "Display <em>More</em> link?"
msgstr "Zobrazit odkaz <em>Další</em>?"

msgid "Displays a link to the entity (if one exists)"
msgstr "Zobrazí odkaz na entitu (pokud existuje)"

msgid "Display <em>More</em> link only when content is trimmed?"
msgstr "Zobrazit odkaz <em>Další</em> pouze při oříznutí obsahu?"

msgid "Only display <em>More</em> link if content is actually trimmed."
msgstr "Zobrazit odkaz <em>Další</em> pouze v případě, že je obsah skutečně oříznutý."

msgid "Open <em>More</em> link in new window"
msgstr "Otevřít odkaz <em>Další</em> v novém okně"

msgid "<em>More</em> link text"
msgstr "Text odkazu <em>Další</em>"

msgid "If displaying <em>More</em> link, enter the text for the link. This field supports tokens."
msgstr "Při zobrazení odkazu <em>Další</em> zadejte text pro odkaz. Toto pole podporuje tokeny."

msgid "<em>More</em> link aria-label"
msgstr "Popisek aria-label odkazu <em>Další</em>"

msgid "If displaying <em>More</em> link, provide additional context for screen-reader users. In most cases, the aria-label value will be announced instead of the link text. This field supports tokens."
msgstr "Pokud se zobrazí odkaz <em>Další</em>, zadejte další kontext pro uživatele čtecího zařízení obrazovky. Ve většině případů bude místo textu odkazu oznámena hodnota popisku aria-label. Toto pole podporuje tokeny."

msgid "<em>More</em> link class"
msgstr "Třída odkazu <em>Další</em>"

msgid "If displaying <em>More</em> link, add a custom class for formatting."
msgstr "Při zobrazení odkazu <em>Další</em> přidejte vlastní třídu pro formátování."

msgid "words"
msgstr "slova"

msgid "characters"
msgstr "znaky"

msgid "Suffix: %suffix"
msgstr "Přípona: %suffix"

msgid "<em>More</em> link enabled, text: %text"
msgstr "Odkaz <em>Další</em> je povolen, text: %text"

msgid "Only display <em>More</em> link when trimmed"
msgstr "Zobrazit odkaz <em>Další</em> pouze při oříznutí"

msgid "<em>More</em> link aria-label: %label"
msgstr "Popisek aria-label odkazu <em>Další</em>: %label"

msgid "<em>More</em> link class: %class"
msgstr "Třída odkazu <em>Další</em>: %class"

msgid "Smart trimmed"
msgstr "Inteligentně oříznuto"

