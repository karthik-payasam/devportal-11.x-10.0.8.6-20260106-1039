msgid "Schema.org: Person"
msgstr "Schema.org: Person"

msgid "An additional name for a Person, can be used for a middle name."
msgstr "Dodatkowa nazwa osoby – może być używana na potrzeby drugiego imienia."

msgid "Physical address of the person."
msgstr "Fizyczny adres osoby."

msgid "An organization that this person is affiliated with. For example, a school/university, a club, or a team."
msgstr "Organizacja, z którą ta osoba jest powiązana. Na przykład szkoła/uniwersytet, klub lub zespół."

msgid "An alias for the person."
msgstr "Alias osoby."

msgid "birthDate"
msgstr "birthDate"

msgid "Date of birth of the person in ISO 8601 format, 2017-12-31."
msgstr "Data urodzenia osoby w formacie ISO 8601 (2017-12-31)."

msgid "The brand of the person."
msgstr "Marka osoby."

msgid "A description of the person."
msgstr "Opis osoby."

msgid "The email address of the person."
msgstr "Adres e-mail osoby."

msgid "familyName"
msgstr "familyName"

msgid "Family name. In the U.S., the last name of an Person. This can be used along with givenName instead of the name property."
msgstr "Nazwisko. W Stanach Zjednoczonych, nazwisko osoby. Tego atrybutu można używać razem z właściwością givenName zamiast z właściwością name."

msgid "Gender of the person."
msgstr "Płeć osoby."

msgid "givenName"
msgstr "givenName"

msgid "Given name. In the U.S., the first name of a Person. This can be used along with familyName instead of the name property."
msgstr "Pierwsze imię. W Stanach Zjednoczonych, imię osoby. Tego atrybutu można używać razem z właściwością familyName zamiast z właściwością name."

msgid "Globally unique id of the person, usually a url."
msgstr "Globalnie unikalny identyfikator osoby, zwykle adres URL."

msgid "The primary image for the person."
msgstr "Podstawowy obraz osoby."

msgid "jobTitle"
msgstr "jobTitle"

msgid "The job title of the person (for example, Financial Manager)."
msgstr "Nazwa stanowiska osoby (np. dyrektor finansowy)."

msgid "memberOf"
msgstr "memberOf"

msgid "An Organization (or ProgramMembership) to which this Person belongs."
msgstr "Organizacja (lub członkostwo w programie), do której należy ta osoba."

msgid "REQUIRED BY GOOGLE. The name of the person."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Nazwisko osoby."

msgid "REQUIRED BY GOOGLE. A single or an [array] of URLs for the person's official social media profile page(s)."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Adres URL lub tablica adresów URL oficjalnych stron profili społecznościowych danej osoby."

msgid "The telephone number of the person."
msgstr "Numer telefonu osoby."

msgid "REQUIRED. The type of person (fixed by standard)."
msgstr "WYMAGANE. Typ osoby (ustalony wg wartości standardowych)."

msgid "REQUIRED BY GOOGLE. The URL for the person's official website."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Adres URL oficjalnego serwisu WWW osoby."

msgid "worksFor"
msgstr "worksFor"

msgid "Organizations that the person works for."
msgstr "Organizacje, dla których pracuje dana osoba."

