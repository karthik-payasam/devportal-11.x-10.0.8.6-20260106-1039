msgid "Password Character Types Policy"
msgstr "Política de tipos de carácter de contraseña"

msgid "Minimum number of different character types the password must contain."
msgstr "El número mínimo de distintos tipos de carácter que debe contener la contraseña."

msgid "Security"
msgstr "Seguridad"

msgid "Character Types"
msgstr "Tipos de carácter"

msgid "Invalid plugin configuration."
msgstr "Configuración de plugin no válida."

msgid "Password must contain at least @types types of characters from the following character types: lowercase letters, uppercase letters, digits, special characters."
msgstr "La contraseña debe contener al menos @types tipos de caracteres de los tipos de carácter siguientes: letras minúsculas, letras mayúsculas, dígitos, caracteres especiales."

msgid "Minimum number of character types"
msgstr "Número mínimo de tipos de carácter"

msgid "Select the minimum number of character types which must be found in a password. The four supported character types are given as: lowercase letters, uppercase letters, digits, special characters."
msgstr "Seleccione el número mínimo de tipos de carácter que tiene que haber en una contraseña. Los cuatro tipos de carácter soportados se dan como: letras minúsculas, letras mayúsculas, dígitos, caracteres especiales."

msgid "The number of character types must be between 2 and 4."
msgstr "El número de tipos de carácter tiene que situarse entre 2 y 4."

msgid "Minimum password character types: @types"
msgstr "Mínimo de tipos de carácter de contraseña: @types"

msgid "Password character types"
msgstr "Tipos de carácter de contraseña"

msgid "Verifying that a password has a minimum number of character types."
msgstr "Verificando que una contraseña tiene un número mínimo de tipos de carácter."

msgid "Your password must have different character types."
msgstr "La contraseña ha de tener diferentes tipos de carácter."

