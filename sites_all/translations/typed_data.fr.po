msgid "Typed Data"
msgstr "Données typées "

msgid "Extends the core Typed Data API with new APIs and features."
msgstr "Etend l'API Typed Data de base avec de nouvelles API et de nouvelles fonctions. "

msgid "Missing arguments for filter %filter_id"
msgstr "Arguments manquants pour le filtre %filter_id"

msgid "Entity machine names:"
msgstr "Noms de machines d'entité :"

msgid "Global context variables:"
msgstr "Variables de contexte globales :"

msgid "Available TypedData data types:"
msgstr "Types de données TypedData disponibles :"

msgid "Text"
msgstr "Texte"

msgid "The count filter counts the number of characters in the input string."
msgstr "Le filtre de comptage compte le nombre de caractères dans la chaîne d'entrée."

msgid "Applies a default value if there is no value."
msgstr "Applique une valeur par défaut si aucune valeur n'est spécifiée."

msgid "Provides the URL of an entity."
msgstr "Fournit l'URL d'une entité."

msgid "Unkown date format %format given."
msgstr "Format de date inconnu fourni %format."

msgid "If a custom date format is supplied, 'custom' must be passed as date format."
msgstr "Si un format de date personnalisé est fourni, 'custom' doit être passé comme format de date."

msgid "If 'custom' is given as date type, a custom date formatting string must be provided; e.g., 'Y-m-d H:i:s'."
msgstr "Si 'custom' est donné comme type de date, un format de date personnalisé sous forme de chaîne de caractères doit être fourni ; par ex., 'Y-m-d H:i:s'."

msgid "Formats a date, using a configured date type or a custom date format string."
msgstr "Formate une date, en utilisant un type de date configuré ou un format de date personnalisé sous forme de chaîne de caractères."

msgid "The format_text filter passes the text through the given filter."
msgstr "Le filtre format_text transmet le texte via le filtre indiqué."

msgid "Converts a string to lower case."
msgstr "Convertit une chaîne en minuscules."

msgid "The replace filter replaces all occurrences of the text given in the first argument with the text given in the second argument."
msgstr "Le filtre de remplacement remplace toutes les occurrences du texte indiqué dans le premier argument par celui indiqué dans le second argument."

msgid "The striptags filter strips SGML/XML tags and replace adjacent whitespace by one space."
msgstr "Le filtre des balises de bande retire les balises SGML/XML et remplace le blanc adjacent par un espace."

msgid "The trim filter removes whitespace from both the beginning and the end of an input string."
msgstr "Le filtre de découpe supprime les blancs du début et de la fin d'une chaîne d'entrée."

msgid "The upper filter converts the entire input string to upper case."
msgstr "Le filtre supérieur convertit la totalité de la chaîne d'entrée en majuscules."

msgid "No widget exists for this data type."
msgstr "Il n'existe aucun widget pour ce type de données."

msgid "The field %field_label consists of the data type %data_type which cannot be input or a widget for this data type is not implemented yet."
msgstr "La zone %field_label est composée du type de données %data_type qui ne peut pas être saisi ou un widget pour ce type de données n'est pas encore implémenté."

msgid "Label"
msgstr "Libellé"

msgid "Broken widget"
msgstr "Widget endommagé"

msgid "A widget for everything that cannot be input or if a widget for a data type is not yet implemented."
msgstr "Widget pour tous les éléments qui ne peuvent pas être saisis ou si un widget pour le type de données n'est pas encore implémenté."

msgid "currently in daylight saving mode"
msgstr "actuellement en mode heure d'été"

msgid "not in daylight saving mode"
msgstr "pas en mode heure d'été"

msgid "Timezone : %timezone %daylight_saving."
msgstr "Fuseau horaire : %timezone %daylight_saving."

msgid "Start date"
msgstr "Date de début"

msgid "End date"
msgstr "Date de fin"

msgid "Description"
msgstr "Description"

msgid "The @title end date cannot be before the start date"
msgstr "La date de fin @title ne peut pas être située avant la date de début."

msgid "Datetime Range"
msgstr "Datetime Range"

msgid "A datetime range input widget, containing two datetime values, for the start and end of the range."
msgstr "Widget d'entrée de plage date/heure, contenant deux valeurs de date/heure, pour le début et la fin de la plage."

msgid "Datetime"
msgstr "Datetime"

msgid "A datetime input widget."
msgstr "Un widget d'entrée de date/heure."

msgid "Empty option label"
msgstr "Étiquette d'option vide"

msgid "Allows overriding the label of the empty option"
msgstr "Permet de remplacer le libellé de l'option vide"

msgid "Select"
msgstr "Sélectionner"

msgid "A simple select box."
msgstr "Case simple."

msgid "Placeholder value"
msgstr "Valeur de marque de réservation"

msgid "Input field size"
msgstr "Taille de zone de saisie"

msgid "Maximum text length"
msgstr "Longueur maximale du texte"

msgid "Text input"
msgstr "Saisie de texte"

msgid "A simple, one-line text input widget."
msgstr "Widget de saisie de texte simple, sur une ligne."

msgid "Number of rows in the text box"
msgstr "Nombre de lignes dans la zone de texte"

msgid "Number of columns in the text box"
msgstr "Nombre de colonnes dans la zone de texte"

msgid "Controls whether the text area is resizable"
msgstr "Contrôle si la zone de texte est redimensionnable"

msgid "Allowed values are \"none\", \"vertical\", \"horizontal\", or \"both\"."
msgstr "Les valeurs autorisées sont \"aucun\", \"vertical\", \"horizontal\" ou \"les deux\"."

msgid "Textarea"
msgstr "Zone de texte"

msgid "A multi-line text input widget."
msgstr "Widget de saisie de texte sur plusieurs lignes."

