msgid "VotingAPI tokens"
msgstr "Znaczniki votingAPI"

msgid "Dynamic Tokens for VotingAPI."
msgstr "Znaczniki dynamiczne dla interfejsu VotingAPI."

msgid "Vote count"
msgstr "Liczba głosów"

msgid "Number of votes."
msgstr "Liczba głosów."

msgid "Average Result"
msgstr "Średni wynik"

msgid "Average result of votes."
msgstr "Średni wynik głosowania."

msgid "Best Vote"
msgstr "Najlepszy głos"

msgid "Best Vote cast."
msgstr "Najlepszy oddany głos."

msgid "Worst Vote"
msgstr "Najgorszy głos"

msgid "Worst Vote cast."
msgstr "Najgorszy oddany głos."

msgid "About"
msgstr "Informacje"

msgid "This module enables tokens for all entity types that has <kbd>voting_api_field</kbd>."
msgstr "Ten moduł udostępnia znaczniki dla wszystkich typów jednostek z polem <kbd>voting_api_field</kbd>."

msgid "Usage"
msgstr "Sposób użycia"

msgid "Tokens are dynamic and you have to pass <emph>vote_type</emph> as the last parameter. Module defines four tokens:"
msgstr "Znaczniki są dynamiczne i trzeba przekazać pole <emph>vote_type</emph> jako ostatni parametr. Moduł definiuje cztery znaczniki:"

msgid "<ul><li>Vote count :: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"
msgstr "<ul><li>Liczba głosów: <code>[votingapi_ENTITY_TYPE_token:vote_count:VOTE_TYPE]</code></li>"

msgid "<li>Vote average :: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"
msgstr "<li>Średni wynik głosowania: <code>[votingapi_ENTITY_TYPE_token:vote_average:VOTE_TYPE]</code></li>"

msgid "<li>Best vote :: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"
msgstr "<li>Najlepszy głos: <code>[votingapi_ENTITY_TYPE_token:best_vote:VOTE_TYPE]</code></li>"

msgid "<li>Worst vote :: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"
msgstr "<li>Najgorszy głos: <code>[votingapi_ENTITY_TYPE_token:worst_vote:VOTE_TYPE]</code></li>"

msgid "Voting API Tokens"
msgstr "Tokeny modułu Voting API"

msgid "Token support for Voting API"
msgstr "Obsługa tokenów dla modułu Voting API"

msgid "Voting"
msgstr "Głosowanie"

