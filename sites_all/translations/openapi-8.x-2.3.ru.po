msgid "OpenAPI"
msgstr "OpenAPI"

msgid "Connects Drupal to the OpenAPI Javascript Library"
msgstr "Подключает Drupal к библиотеке Javascript OpenAPI"

msgid "Available OpenAPI Documentation."
msgstr "Доступная документация по OpenAPI."

msgid "Access API Docs"
msgstr "Документы API"

msgid "Access documentation page for the REST API"
msgstr "Страница документации по API REST"

msgid "OpenAPI Schema Download"
msgstr "Загрузка схемы OpenAPI"

msgid "OpenAPI Resources"
msgstr "Ресурсы OpenAPI"

msgid "OpenAPI Documentation"
msgstr "Документация OpenAPI"

msgid "%label OpenApi Schema Download"
msgstr "Загрузка схемы OpenApi %label"

msgid "The specifications provide the documentation on some of Drupal's apis following <a href=':openapi_spec'>OpenAPI (aka Swagger)</a> standards."
msgstr "Спецификации содержат информацию об API Drupal, соответствующих стандартам <a href=':openapi_spec'>OpenAPI (Swagger)</a>."

msgid "These json files can be used in tools such as the <a href=\":swagger_editor\">Swagger Editor</a> to provide a more detailed version of the API documentation or <a href=\":swagger_codegen\">Swagger Codegen</a> to create an api client."
msgstr "Эти файлы json можно использовать в таких инструментах, как <a href=\":swagger_editor\">Редактор Swagger</a> для предоставления более подробной версии документации по API и <a href=\":swagger_codegen\">Генератор кода Swagger</a> для создания клиента API."

msgid "Module"
msgstr "Модуль"

msgid "Specification"
msgstr "Спецификация"

msgid "Explore"
msgstr "Показать структуру"

msgid "Please visit the <a href=':openapi_ui_link'>OpenAPI UI module</a> for information on these interfaces and to discover others."
msgstr "Информация об этих и других интерфейсах доступна на странице <a href=':openapi_ui_link'>Модуль пользовательского интерфейса OpenAPI</a>."

msgid "No UI plugins available"
msgstr "Нет модулей пользовательского интерфейса"

msgid "There are no plugins available for exploring the OpenAPI documentation."
msgstr "Нет модулей для изучения документации OpenAPI."

msgid "You can install one of the below projects to view the API Specifications from with your site."
msgstr "Можно установить один из перечисленных ниже проектов для просмотра спецификаций API."

msgid "View/Download"
msgstr "Просмотр/загрузка"

msgid "Explore with %interface"
msgstr "Просмотр через %interface"

msgid "No UI available."
msgstr "Пользовательские интерфейсы недоступны."

msgid "No OpenApi generator plugins are currently available."
msgstr "В данный момент нет доступных модулей генератора OpenApi."

msgid "You must enable a REST or API module which supports OpenApi Downloads, such as the <a href=\":rest_link\">Core Rest</a> and <a href=\":jsonapi_link\">JSON:API</a> modules."
msgstr "Необходимо включить модуль REST или API, поддерживающий загрузки OpenApi, например модули <a href=\":rest_link\">Базовый модуль Rest</a> и <a href=\":jsonapi_link\">JSON:API</a>."

msgid "%generator OpenApi Documentation"
msgstr "Документация по %generator OpenApi"

