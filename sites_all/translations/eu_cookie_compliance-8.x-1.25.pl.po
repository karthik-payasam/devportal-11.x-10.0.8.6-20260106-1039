msgstr "Ukryj"

msgid "<h2>We use cookies on this site to enhance your user experience</h2><p>By clicking the Accept button, you agree to us doing so.</p>"
msgstr "<h2>Używamy plików cookie na tej stronie, aby usprawnić używanie tego serwisu</h2><p>Kliknięcie przycisku Akceptuj oznacza, że zgadzasz się na to.</p>"

msgid "<h2>We use cookies on this site to enhance your user experience</h2><p>By tapping the Accept button, you agree to us doing so.</p>"
msgstr "<h2>Używamy plików cookie na tej stronie, aby usprawnić używanie tego serwisu</h2><p>Dotknięcie przycisku Akceptuj oznacza, że zgadzasz się na to.</p>"

