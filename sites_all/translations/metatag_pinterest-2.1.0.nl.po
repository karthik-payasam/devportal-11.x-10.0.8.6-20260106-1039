msgid "Metatag: Pinterest"
msgstr "Metatag: Pinterest"

msgid "Provides support for Pinterest's custom meta tags."
msgstr "Biedt ondersteuning voor aangepaste metatags van Pinterest."

msgid "SEO"
msgstr "SEO"

msgid "Pinterest: Description"
msgstr "Pinterest: Beschrijving"

msgid "Pinterest: ID"
msgstr "Pinterest: ID"

msgid "Pinterest: Media"
msgstr "Pinterest: Medium"

msgid "Pinterest: No hover"
msgstr "Pinterest: Geen hover"

msgid "Pinterest: No pin"
msgstr "Pinterest: Niet vastzetten"

msgid "Pinterest: No search"
msgstr "Pinterest: Niet zoeken"

msgid "Pinterest: URL"
msgstr "Pinterest: URL"

msgid "Pinterest"
msgstr "Pinterest"

msgid "A set of meta tags used to control how the site's content is consumed by <a href='https://pinterest.com/'>Pinterest</a>."
msgstr "Een set metatags die bepalen hoe de content van de site wordt geconsumeerd door <a href='https://pinterest.com/'>Pinterest</a>."

msgid "Description"
msgstr "Beschrijving"

msgid "A one to two sentence description of the content."
msgstr "Een uit één of twee zinnen bestaande beschrijving van de content."

msgid "Id"
msgstr "ID"

msgid "The Canonical Pinterest object to pin."
msgstr "Het canonieke Pinterest-object dat moet worden vastgezet."

msgid "Media"
msgstr "Media"

msgid "The URL of media which should represent the content."
msgstr "De URL van het medium dat de content vertegenwoordigt."

msgid "No hover"
msgstr "Geen hover"

msgid "Do not show hovering Save or Search buttons, generated by the Pinterest browser extensions."
msgstr "De knoppen Save (Opslaan) en Search (Zoeken), die door de browserextensie van Pinterest worden gegenereerd, niet afbeelden op de voorgrond."

msgid "No pin"
msgstr "Niet vastzetten"

msgid "Do not pin anything from this page. When selected, this option will take precedence over all options below."
msgstr "Niets van deze pagina vastzetten. Als deze optie geselecteerd is, heeft deze optie voorrang op alle onderstaande opties."

msgid "No search"
msgstr "Niet zoeken"

msgid "Do not allow Pinterest visual search to happen from this page."
msgstr "Verhinderen dat er vanaf deze pagina visuele zoekopdrachten van Pinterest worden uitgevoerd."

msgid "URL"
msgstr "URL"

msgid "The URL which should represent the content."
msgstr "De URL die de content vertegenwoordigt."

