msgid "Noopener Filter"
msgstr "Noopener Filtresi"

msgid "Provides a filter to add rel=\"noopener\" to external links and links in the ckeditor."
msgstr "Ckeditor içindeki dış bağlantılara ve bağlantılara rel=\"noopener\" eklemek için bir süzgeç sağlar."

msgid "Noopener filter settings"
msgstr "Noopener süzgeci ayarları"

msgid "Change settings for noopener filter"
msgstr "Noopener süzgeci için ayarları değiştir"

msgid "Administer Noopener filter"
msgstr "Noopener süzgecini yönet"

msgid "Enables the ability to change the noopener filter settings."
msgstr "Noopener süzgeci ayarlarını değiştirme yeteneğini etkinleştirir."

msgid "Settings for Noopener filter"
msgstr "Noopener süzgeci için ayarlar"

msgid "Noopener"
msgstr "Noopener"

msgid "Filter links"
msgstr "Bağlantılara süzgeç uygula"

msgid "Filter links through alter link hook."
msgstr "Alter bağlantı kancasıyla bağlantılara süzgeç uygular."

msgid "Save"
msgstr "Kaydet"

msgid "Add noopener to all links"
msgstr "Tüm bağlantılara noopener ekle"

