msgid "Finished @num elements and @num_translations translations created successfully."
msgstr "Se han creado correctamente @num elementos y @num_translations traducciones."

msgid "Finished @num elements created successfully."
msgstr "Finalizado @num elementos creados satisfactoriamente."

msgid "Finished with an error."
msgstr "Terminó con un error."

msgid "Generate @label"
msgstr "Generar @label"

msgid "Generate"
msgstr "Generar"

msgid "Generate realistic items (content, users, menus, etc) to assist your site development and testing."
msgstr "Generar elementos realistas (contenido, usuarios, menús, etc.) como ayuda para el desarrollo y la prueba del sitio."

msgid "Devel generate"
msgstr "Generación de desarrollo"

msgid "Devel Generate"
msgstr "Devel Generate"

msgid "Generate test users, nodes, menus, taxonomy terms..."
msgstr "Generar usuarios de prueba, nodos, menús, términos de taxonomía..."

msgid "Development"
msgstr "Desarrollo"

msgid "Administer devel_generate"
msgstr "Administrar devel_generate"

msgid "Language"
msgstr "Idioma"

msgid "Select the primary language(s) for @items"
msgstr "Seleccione los idiomas primarios para @items"

msgid "Disabled - requires Language module"
msgstr "Inhabilitado: necesita el módulo Idioma"

msgid "Select the language(s) for translated @items"
msgstr "Seleccione los idiomas para los @items traducidos"

msgid "Translated @items will be created for each language selected."
msgstr "Se crearán @items traducidos para cada idioma seleccionado."

msgid "Disabled - requires Content Translation module."
msgstr "Inhabilitado: necesita el módulo Traducción del contenido."

msgid "@permission"
msgstr "@permission"

msgid "Failed to generate elements due to \"%error\"."
msgstr "No se han podido generar elementos debido a \"%error\"."

msgid "You do not have any content types that can be generated. <a href=\":create-type\">Go create a new content type</a>"
msgstr "No tiene ningún tipo de contenido que pueda generarse. <a href=\":create-type\">Cree un nuevo tipo de contenido</a>"

msgid "Hidden"
msgstr "Oculto"

msgid "Closed"
msgstr "Cerrado"

msgid "Open"
msgstr "abierto"

msgid "No comment fields"
msgstr "Sin campos de comentario"

msgid "Content type"
msgstr "Tipo de contenido"

msgid "Comments"
msgstr "Comentarios"

msgid "<strong>Delete all content</strong> in these content types before generating new content."
msgstr "<strong>Eliminar todo el contenido</strong> en estos tipos de contenido antes de generar nuevos contenidos."

msgid "How many nodes would you like to generate?"
msgstr "¿Cuantos nodos desea generar?"

msgid "Now"
msgstr "Ahora"

msgid "ago"
msgstr "hace"

msgid "How far back in time should the nodes be dated?"
msgstr "¿Cuán antiguos deberían ser los nodos?"

msgid "Node creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "Las fechas de creación de los nodos se distribuirán aleatoriamente en regresión desde la actualidad hasta la fecha seleccionada."

msgid "Maximum number of comments per node."
msgstr "El número máximo de comentarios por nodo."

msgid "You must also enable comments for the content types you are generating. Note that some nodes will randomly receive zero comments. Some will receive the max."
msgstr "También debe habilitar comentarios para los tipos de contenido que está generando. Tenga en cuenta que algunos nodos pueden recibir aleatoriamente cero comentarios. Algunos recibirán el máximo."

msgid "Maximum number of words in titles"
msgstr "El número máximo de palabras en los títulos"

msgid "Fields to leave empty"
msgstr "Campos que dejar vacíos"

msgid "Enter the field names as a comma-separated list. These will be skipped and have a default value in the generated content."
msgstr "Especifique los nombres de campo como una lista separada por comas. Se omitirán y tendrán un valor predeterminado en el contenido generado."

msgid "Base fields to populate"
msgstr "Campos base que rellenar"

msgid "Enter the field names as a comma-separated list. These will be populated."
msgstr "Especifique los nombres de campo como una lista separada por comas. Estos se rellenarán."

msgid "Prefix the title with the content type label."
msgstr "Ponga la etiqueta de tipo de contenido como prefijo del título."

msgid "This will not count against the maximum number of title words specified above."
msgstr "Esto no cuenta para el número máximo de palabras de título especificado más arriba."

msgid "Requires path.module"
msgstr "Necesita path.module"

msgid "Add an url alias for each node."
msgstr "Añadir un alias de URL para cada nodo."

msgid "Add statistics for each node (node_counter table)."
msgstr "Añadir estadísticas para cada nodo (tabla node_counter)."

msgid "User ID"
msgstr "ID de usuario"

msgid "Name"
msgstr "Nombre"

msgid "Role(s)"
msgstr "Rol(es)"

msgid "Users"
msgstr "Usuarios"

msgid "Select users for randomly assigning as authors of the generated content. Leave all unchecked to use a random selection of up to 50 users."
msgstr "Seleccione los usuarios para asignarlos aleatoriamente como autores del contenido generado. Deje todo sin seleccionar para utilizar una selección aleatoria de 50 usuarios como máximo."

msgid "Please select at least one content type"
msgstr "Seleccione al menos un tipo de contenido"

msgid "Generating Content"
msgstr "Generando contenido"

msgid "Deleted %count nodes."
msgstr "Eliminados los nodos %count."

msgid "Completed @feedback nodes (@rate nodes/min)"
msgstr "Se han completado @feedback nodos (@rate nodos/min)"

msgid "No content types available"
msgstr "No hay tipos de contenido disponibles"

msgid "To delete content, please provide the content types (--bundles)"
msgstr "Para suprimir el contenido proporcione los tipos de contenido (--bundles)"

msgid "One or more content types have been entered that don't exist on this site"
msgstr "Se han especificado uno o más tipos de contenido que no existen en este sitio."

msgid "Created 1 node"
msgid_plural "Created @count nodes"
msgstr[0] "Se ha creado un nodo"
msgstr[1] "Se han creado @count nodos"

msgid "Created 1 node translation"
msgid_plural "Created @count node translations"
msgstr[0] "Se ha creado una traducción de nodo"
msgstr[1] "Se han creado @count traducciones de nodos"

msgid "content"
msgstr "contenido"

msgid "Generate a given number of content. Optionally delete current content."
msgstr "Generar un determinado número de contenidos. Opcionalmente, borrar el contenido actual."

msgid "You do not have any media types that can be generated. <a href=\":url\">Go create a new media type</a>"
msgstr "No tiene ningún tipo de soporte que pueda generarse. <a href=\":url\">Cree un nuevo tipo de soporte</a>"

msgid "Media type"
msgstr "Tipo de soporte"

msgid "<strong>Delete all media</strong> in these types before generating new media."
msgstr "<strong>Elimine todo el soporte</strong> en estos tipos antes de generar nuevos soportes."

msgid "How many media items would you like to generate?"
msgstr "¿Cuántos elementos de soporte desea generar?"

msgid "How far back in time should the media be dated?"
msgstr "¿Cuán antiguos deberían ser los soportes?"

msgid "Media creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "Las fechas de creación de los soportes se distribuirán aleatoriamente en regresión desde la actualidad hasta la fecha seleccionada."

msgid "Maximum number of words in names"
msgstr "El número máximo de palabras en los nombres"

msgid "Set language on media"
msgstr "Establecer el idioma en los soportes"

msgid "Requires locale.module"
msgstr "Necesita locale.module"

msgid "Please select at least one media type"
msgstr "Seleccione al menos un tipo de soporte"

msgid "Generating media items"
msgstr "Generación de elementos de soporte"

msgid "Deleted %count media items."
msgstr "Suprimidos %rrecuento de elementos de soporte."

msgid "Completed !feedback media items (!rate media/min)"
msgstr "Se han completado !feedback elementos de soporte (!rate soportes/min)"

msgid "No media types available"
msgstr "No hay tipos de soporte disponibles"

msgid "media"
msgstr "soporte"

msgid "Generate a given number of media entities."
msgstr "Generar un número dado de entidades de soporte."

msgid "Create new menu(s)"
msgstr "Crear nuevo menú(s)"

msgid "Generate links for these menus"
msgstr "Generar enlaces para estos menús"

msgid "Number of new menus to create"
msgstr "Número de nuevos menús a crear"

msgid "Number of links to generate"
msgstr "Número de enlaces a generar"

msgid "Maximum length for menu titles and menu links"
msgstr "Longitud máxima de títulos de menú y enlaces de menú"

msgid "Text will be generated at random lengths up to this value. Enter a number between 2 and 128."
msgstr "Se generará texto de longitudes aleatorias hasta este valor. especifique un número entre 2 y 128."

msgid "Types of links to generate"
msgstr "Tipos de enlaces a generar"

msgid "Nodes"
msgstr "Nodos"

msgid "Front page"
msgstr "Página inicial"

msgid "External"
msgstr "Externo"

msgid "Maximum link depth"
msgstr "Profundidad máxima de enlace"

msgid "Maximum menu width"
msgstr "Anchura máxima de menú"

msgid "Limit the width of the generated menu's first level of links to a certain number of items."
msgstr "Limitar la anchura de primer nivel del menú generado de enlaces a un cierto número de elementos."

msgid "Delete existing custom generated menus and menu links before generating new ones."
msgstr "Eliminar los menús personalizados generados existentes y los enlaces de menú antes de generar otros nuevos."

msgid "Deleted @menus_deleted menu(s) and @links_deleted other link(s)."
msgstr "Se han suprimido @menus_deleted menú y @links_deleted otros enlaces."

msgid "Description of @name"
msgstr "Descripción de @name"

msgid "Description of @title."
msgstr "Descripción de @title."

msgid "Invalid number of menus"
msgstr "Número de menús no válido"

msgid "Invalid number of links"
msgstr "Número de enlaces no válido"

msgid "Invalid maximum link depth. Use a value between 1 and 9"
msgstr "Profundidad de enlaces máxima no válida. Utilice un valor entre 1 y 9"

msgid "Invalid maximum menu width. Use a positive numeric value."
msgstr "Ancho de menú máximo no válido. Utilice un valor numérico positivo."

msgid "Created the following 1 new menu: @menus"
msgid_plural "Created the following @count new menus: @menus"
msgstr[0] "Se ha creado el menú nuevo siguiente: @menus"
msgstr[1] "Se han creado los @count menús nuevos siguientes: @menus"

msgid "menus"
msgstr "menús"

msgid "Generate a given number of menus and menu links. Optionally delete current menus."
msgstr "Generar un número dado de menús y vínculos de menú. Opcionalmente, borrar los menús actuales."

msgid "Vocabularies"
msgstr "Vocabularios"

msgid "Restrict terms to these vocabularies."
msgstr "Restringir términos a estos vocabularios."

msgid "Number of terms"
msgstr "Número de términos"

msgid "Maximum number of characters in term names"
msgstr "Número máximo de caracteres en los nombres de términos"

msgid "Minimum depth for new terms in the vocabulary hierarchy"
msgstr "Profundidad mínima para términos nuevos en la jerarquía de vocabulario"

msgid "Enter a value from 1 to 20."
msgstr "Especifique un valor comprendido entre 1 y 20."

msgid "Maximum depth for new terms in the vocabulary hierarchy"
msgstr "Profundidad máxima para términos nuevos en la jerarquía de vocabulario"

msgid "Delete existing terms in specified vocabularies before generating new terms."
msgstr "Eliminar los términos existentes en vocabularios especificados antes de generar nuevos términos."

msgid "In vocabulary @vlabel: @termlist"
msgstr "En vocabulario @vlabel: @termlist"

msgid "In vocabulary @vlabel: No terms created"
msgstr "En vocabulario @vlabel: no se ha creado ningún término"

msgid "Minimum depth changed from @min_depth to 1 because all terms were deleted"
msgstr "La profundidad mínima ha cambiado de @min_depth a 1 porque se han suprimido todos los términos"

msgid "Please provide a vocabulary machine name (--bundles)."
msgstr "Proporcione un nombre de máquina de vocabulario (--bundles)."

msgid "Invalid vocabulary machine name: @name"
msgstr "Nombre de máquina de vocabulario no válido: @name"

msgid "Invalid number of terms: @num"
msgstr "Número de términos no válido: @num"

msgid "The depth values must be in the range 1 to 20 and min-depth cannot be larger than max-depth (values given: min-depth @min, max-depth @max)"
msgstr "Los valores de profundidad deben estar en el rango de 1 a 20 y la profundidad mínima no puede ser mayor que la profundidad máxima (valores dados: profundidad mínima @min, profundidad máxima @max)"

msgid "Created 1 new term"
msgid_plural "Created @count new terms"
msgstr[0] "Se ha creado un término nuevo"
msgstr[1] "Se han creado @count términos nuevos"

msgid "1 new term at level @level (@terms)"
msgid_plural "@count new terms at level @level (@terms)"
msgstr[0] "Un término nuevo en el nivel @level (@terms)"
msgstr[1] "@count términos nuevos en el nivel @level (@terms)"

msgid "Created 1 term translation"
msgid_plural "Created @count term translations"
msgstr[0] "Se ha creado una traducción de término"
msgstr[1] "Se han creado @count traducciones de término"

msgid "Deleted 1 existing term"
msgid_plural "Deleted @count existing terms"
msgstr[0] "Se ha suprimido un término existente"
msgstr[1] "Se han suprimido @count términos existentes"

msgid "terms"
msgstr "términos"

msgid "Generate a given number of terms. Optionally delete current terms."
msgstr "Generar un número dado de términos. Opcionalmente, borrar los términos actuales."

msgid "How many users would you like to generate?"
msgstr "¿Cuantos usuarios desea generar?"

msgid "Delete all users (except user id 1) before generating new users."
msgstr "Borrar todos los usuarios (excepto el usuario con id 1) antes de generar nuevos usuarios."

msgid "Which roles should the users receive?"
msgstr "¿Qué roles debería recibir el usuario?"

msgid "Users always receive the <em>authenticated user</em> role."
msgstr "Los usuarios siempre reciben el rol de <em>usuario autenticado</em>."

msgid "Password to be set"
msgstr "Contraseña que desea establecer"

msgid "Leave this field empty if you do not need to set a password"
msgstr "Deje este campo vacío si no necesita configurar una contraseña"

msgid "How old should user accounts be?"
msgstr "¿Qué edad deben tener las cuentas de usuario?"

msgid "User ages will be distributed randomly from the current time, back to the selected time."
msgstr "La antigüedad de los usuarios se debe distribuir aleatoriamente en regresión desde la actualidad hasta la fecha seleccionada."

msgid "@num_users created."
msgstr "@num_users creados."

msgid "1 user deleted"
msgid_plural "@count users deleted."
msgstr[0] "1 usuario eliminado"
msgstr[1] "@count usuarios eliminados."

msgid "1 user"
msgid_plural "@count users"
msgstr[0] "1 usuario"
msgstr[1] "@count usuarios"

msgid "users"
msgstr "Usuarios"

msgid "Generate a given number of users. Optionally delete current users."
msgstr "Generar un numero determinado de usuarios. Opcionalmente, borrar los usuarios actuales."

msgid "Number of vocabularies?"
msgstr "¿Cantidad de vocabularios?"

msgid "Maximum number of characters in vocabulary names"
msgstr "Número máximo de caracteres en los nombres de vocabularios"

msgid "Delete existing vocabularies before generating new ones."
msgstr "Eliminar vocabularios existentes antes de generar otros nuevos."

msgid "Deleted existing vocabularies."
msgstr "Eliminados los vocabularios existentes."

msgid "Created the following new vocabularies: @vocs"
msgstr "Creados los siguientes vocabularios nuevos: @vocs"

msgid "Invalid number of vocabularies: @num."
msgstr "Número de vocabularios no válido: @num."

msgid "vocabularies"
msgstr "vocabularios"

msgid "Generate a given number of vocabularies. Optionally delete current vocabularies."
msgstr "Generar un número dado de vocabularios. Opcionalmente, borrar los vocabularios actuales."

