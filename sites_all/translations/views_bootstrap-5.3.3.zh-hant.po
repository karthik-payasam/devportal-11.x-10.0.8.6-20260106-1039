msgstr ""
"Project-Id-Version: PROJECT VERSION\n"
"POT-Creation-Date: 2023-11-01 11:34+0000\n"
"PO-Revision-Date: 2023-11-01 11:34+0000\n"
"Last-Translator: NAME <EMAIL@ADDRESS>\n"
"Language-Team: LANGUAGE <EMAIL@ADDRESS>\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "@style style will not display without the \"@field\" setting."
msgstr "缺少 \"@field\" 設定，不會顯示 @style 樣式。"

msgid "About"
msgstr "關於"

msgid "The <a href=\":bootstrap\">Views Bootstrap module</a> adds styles to Views to output the results of a view as several common <a href=\":components\">Twitter Bootstrap</a> components."
msgstr "<a href=\":bootstrap\">「視圖 Bootstrap」模組</a>會將樣式新增至「視圖」，然後將視圖的結果輸出為數個一般 <a href=\":components\">Twitter Bootstrap</a> 元件。"

msgid "Uses"
msgstr "使用"

msgid "<a href=\":views\">Create a view</a> using one of the following styles:"
msgstr "使用下列其中一種樣式<a href=\":views\">建立視圖</a>："

msgid "<a href=\":docs\">Accordion</a>"
msgstr "<a href=\":docs\">折疊</a>"

msgid "<a href=\":docs\">Cards</a>"
msgstr "<a href=\":docs\">卡</a>"

msgid "<a href=\":docs\">Carousel</a>"
msgstr "<a href=\":docs\">輪播</a>"

msgid "<a href=\":docs\">Dropdown</a>"
msgstr "<a href=\":docs\">下拉</a>"

msgid "<a href=\":docs\">Grid</a>"
msgstr "<a href=\":docs\">網格</a>"

msgid "<a href=\":docs\">Thumbnails</a>"
msgstr "<a href=\":docs\">縮圖</a>"

msgid "<a href=\":docs\">Tables</a>"
msgstr "<a href=\":docs\">表格</a>"

msgid "<a href=\":docs\">Tabs</a>"
msgstr "<a href=\":docs\">標籤</a>"

msgid "<a href=\":docs\">Media object</a>"
msgstr "<a href=\":docs\">媒體物件</a>"

msgid "<a href=\":docs\">List group</a>"
msgstr "<a href=\":docs\">清單群組</a>"

msgid "Views Bootstrap"
msgstr "視圖 Bootstrap"

msgid "Views Twitter Bootstrap Components."
msgstr "視圖 Twitter Bootstrap 元件。"

msgid "Views"
msgstr "Views"

msgid "The Bootstrap accordion displays content in collapsible panels (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap 折疊會在可收合的畫面中顯示內容（<a href=\":docs\">請參閱說明文件</a>）。"

msgid "Panel title field"
msgstr "畫面標題欄位"

msgid "Select the field that will be used as the accordion panel titles."
msgstr "選取將作為折疊畫面標題的欄位。"

msgid "Label field"
msgstr "標籤欄位"

msgid "- None -"
msgstr "- 無 -"

msgid "Select the field that will be used as the label."
msgstr "選取將作為標籤的欄位。"

msgid "Collapse Options"
msgstr "收合選項"

msgid "All Items Closed"
msgstr "關閉所有項目"

msgid "First Item Open"
msgstr "開啟第一個項目"

msgid "All Items Open"
msgstr "開啟所有項目"

msgid "Default panel state for collapse behavior."
msgstr "收合行為的預設畫面狀態。"

msgid "Bootstrap Accordion"
msgstr "引導折疊"

msgid "Displays rows in a Bootstrap Accordion."
msgstr "在「引導折疊」中顯示列。"

msgid "Card title field"
msgstr "卡片標題欄位"

msgid "Select the field that will be used for the card title."
msgstr "選取將用於卡片標題的欄位。"

msgid "Card content field"
msgstr "卡片內容欄位"

msgid "Select the field that will be used for the card content."
msgstr "選取將用於卡片內容的欄位。"

msgid "Card image field"
msgstr "卡片影像欄位"

msgid "Select the field that will be used for the card image."
msgstr "選取將用於卡片影像的欄位。"

msgid "Custom card group class"
msgstr "自訂卡片群組類別"

msgid "Additional classes to provide on the card group. Separated by a space."
msgstr "要在卡片群組上提供的其他類別。 以空格區隔。"

msgid "Additional classes to provide on each card. Separated by a space."
msgstr "要在每張卡片上提供的其他類別。 以空格區隔。"

msgid "Bootstrap Cards"
msgstr "Bootstrap 卡片"

msgid "Displays rows in a Bootstrap Card Group layout"
msgstr "顯示「Bootstrap 卡片分組」佈置中的列"

msgid "The Bootstrap carousel displays content as a slideshow (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap 輪播會以投影片放映形式顯示內容（<a href=\":docs\">請參閱說明文件</a>）。"

msgid "<None>"
msgstr "<無>"

msgid "Interval"
msgstr "間隔"

msgid "The amount of time to delay between automatically cycling an item. If false, carousel will not automatically cycle."
msgstr "自動循環一個項目之間延遲的時間量。如果為 false，輪播不會自動循環。"

msgid "Show navigation"
msgstr "顯示導覽"

msgid "Show indicators"
msgstr "顯示指示器"

msgid "Pause on hover"
msgstr "將游標移至上方時暫停"

msgid "Pauses the cycling of the carousel on mouseenter and resumes the cycling of the carousel on mouseleave."
msgstr "mouseenter 時暫停循環輪播，mouseleave 時回復循環輪播。"

msgid "Wrap"
msgstr "換行"

msgid "The carousel should cycle continuously or have hard stops."
msgstr "輪播應該連續循環，或具有強迫停止。"

msgid "Columns"
msgstr "直欄"

msgid "The number of columns to include in the carousel."
msgstr "要包含在輪播中的欄數。"

msgid "Breakpoints"
msgstr "岔斷點"

msgid "The min-width breakpoint of the multicolumn carousel."
msgstr "多欄輪播的最小寬度岔斷點。"

msgid "Extra Small"
msgstr "特小"

msgid "Small"
msgstr "小"

msgid "Medium"
msgstr "中"

msgid "Large"
msgstr "大型"

msgid "Display"
msgstr "顯示"

msgid "Select by fields"
msgstr "依欄位選取"

msgid "Display fields as row content"
msgstr "將欄位顯示為列內容"

msgid "Displaying fields as row content will output the field rows as unformatted values within each carousel item."
msgstr "將欄位顯示為列內容，會將欄位列輸出為每一個輪播項目內未格式化的值。"

msgid "Image"
msgstr "圖片"

msgid "Title"
msgstr "標題"

msgid "Description"
msgstr "描述"

msgid "Bootstrap Carousel"
msgstr "引導輪播"

msgid "Displays rows in a Bootstrap Carousel."
msgstr "在「引導輪播」中顯示列。"

msgid "The Bootstrap dropdown style displays a list of links in a drop-down menu format (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap 下拉樣式會以下拉功能表格式顯示鏈結清單（<a href=\":docs\">請參閱說明文件</a>）。"

msgid "Button text"
msgstr "按鈕文字"

msgid "Text label for the button that is the drop-down toggle."
msgstr "下拉切換按鈕的文字標籤。"

msgid "Button class"
msgstr "按鈕類別"

msgid "Classes for the button that is the drop-down toggle."
msgstr "下拉切換按鈕的類別。"

msgid "Default"
msgstr "預設"

msgid "Primary"
msgstr "主要"

msgid "Success"
msgstr "成功"

msgid "Info"
msgstr "資訊"

msgid "Warning"
msgstr "警告"

msgid "Danger"
msgstr "危險"

msgid "Wrapper class"
msgstr "封套類別"

msgid "The class to provide on the wrapper, outside the list."
msgstr "要在清單以外提供於封套上的類別。"

msgid "List class"
msgstr "清單類別"

msgid "The class to provide on the list element itself."
msgstr "要在清單元素本身提供的類別。"

msgid "Bootstrap Dropdown"
msgstr "Bootstrap 下拉"

msgid "Displays rows in a Bootstrap Dropdown."
msgstr "在 Bootstrap 下拉中顯示列。"

msgid "The Bootstrap grid displays content in a responsive, mobile first fluid grid (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap 網格會在可回應的行動裝置優先流動網格中顯示內容（<a href=\":docs\">請參閱說明文件</a>）。"

msgid "Alignment"
msgstr "對齊"

msgid "Horizontal"
msgstr "橫向"

msgid "Vertical"
msgstr "垂直"

msgid ""
"Horizontal alignment will place items starting in the upper left and moving right.\n"
"      Vertical alignment will place items starting in the upper left and moving down."
msgstr ""
"水平對齊會從左上方開始向右放置項目。\n"
"      垂直對齊會從左上方開始向下放置項目。"

msgid "Default column classes"
msgstr "預設直欄類別"

msgid "Add the default views column classes like views-col, col-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "將 views-col、col-1 和 clearfix 之類的預設視圖直欄類別新增至輸出。 使用此選項可快速減少視圖依預設提供的標記量，但代價是 CSS 會因此而較難套用。"

msgid "Custom column class"
msgstr "自訂直欄類別"

msgid "Additional classes to provide on each column. Separated by a space."
msgstr "要在每一個直欄上提供的其他類別。 以空格區隔。"

msgid "You may use field tokens from as per the \"Replacement patterns\" used in \"Rewrite the output of this field\" for all fields."
msgstr "對於所有欄位，您可以根據「重新編寫此欄位的輸出」中使用的「取代型樣」來使用欄位記號。"

msgid "Default row classes"
msgstr "預設列類別"

msgid "Adds the default views row classes like views-row, row-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "將 views-row、row-1 和 clearfix 之類的預設視圖列類別新增至輸出。 使用此選項可快速減少視圖依預設提供的標記量，但代價是 CSS 會因此而較難套用。"

msgid "Custom row class"
msgstr "自訂列類別"

msgid "Additional classes to provide on each row. Separated by a space."
msgstr "要在每一列上提供的其他類別。 以空格區隔。"

msgid "Base number of columns"
msgstr "直欄基本數目"

msgid "all"
msgstr "全部"

msgid "Choose the number of columns that views will wrap in a single row. This will be reflected in the HTML structure rendered regardless of the device size. If selecting \"all\" then use the alternative template."
msgstr "選擇視圖要包裝在單一列中的直欄數。 這會反映在呈現的 HTML 結構中，而不考慮裝置大小。 如果選取「全部」，則使用替代範本。"

msgid "Number of columns (col-@size)"
msgstr "直欄數 (col-@size)"

msgid "This adds col-@size to the div."
msgstr "這會新增 col-@size 至 div。"

msgid "Bootstrap Grid"
msgstr "引導網格"

msgid "Displays rows in a Bootstrap Grid layout"
msgstr "在「引導網格」佈置中顯示列"

msgid "The Bootstrap list group displays content in an unordered list with list group classes (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap 清單群組會在具有清單群組類別的無序清單中顯示內容（<a href=\":docs\">請參閱說明文件</a>）。"

msgid "Set group field in panel heading"
msgstr "設定畫面標題中的群組欄位"

msgid "Title field"
msgstr "標題欄位"

msgid "Select the field that will be used as the title."
msgstr "選取要用作標題的欄位。"

msgid "Bootstrap List Group"
msgstr "引導清單群組"

msgid "Displays rows in a Bootstrap List Group."
msgstr "在「引導清單群組」中顯示列。"

msgid "The Bootstrap media object displays content with an image item lead with heading and text (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap 媒體物件會顯示含有影像項目的內容，並以標題和文字為開頭（<a href=\":docs\">請參閱說明文件</a>）。"

msgid "Heading field"
msgstr "標題欄位"

msgid "Select the field that will be used as the media object heading. Exclude this field from display to prevent duplication."
msgstr "選取要用作媒體物件標題的欄位。 請排除顯示此欄位，以免重複。"

msgid "Image field"
msgstr "影像欄位"

msgid "Select the field that will be used as the media object image. Exclude this field from display to prevent duplication."
msgstr "選取要用作媒體物件影像的欄位。 請排除顯示此欄位，以免重複。"

msgid "Body field"
msgstr "內文欄位"

msgid "All fields that are not excluded from display will be shown as the body."
msgstr "不排除顯示的所有欄位將顯示成內文。"

msgid "Image Alignment"
msgstr "影像對齊"

msgid "Left"
msgstr "左邊"

msgid "Right"
msgstr "右邊"

msgid "Middle"
msgstr "水平置中"

msgid "Align the media object image left or right."
msgstr "向左或向右對齊媒體物件影像。"

msgid "Bootstrap Media Object"
msgstr "引導媒體物件"

msgid "Displays rows in a Bootstrap Media Object."
msgstr "在「引導媒體物件」中顯示列。"

msgid "The Bootstrap panels displays content in a box with optional header and footer elements (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap 畫面會在具有選用標頭和標底元素的方框中顯示內容（<a href=\":docs\">請參閱說明文件</a>）。"

msgid "Contextual class"
msgstr "環境定義類別"

msgid "<a href=\":docs\">see Bootstrap documentation</a>"
msgstr "<a href=\":docs\">請參閱 Bootstrap 說明文件</a>"

msgid "Select the field that will be used as the panel heading titles."
msgstr "選取將作為畫面標頭標題的欄位。"

msgid "Panel footer field"
msgstr "畫面標底欄位"

msgid "Select the field that will be used as the panel footer."
msgstr "選取將作為畫面標底的欄位。"

msgid "Bootstrap Panels"
msgstr "Bootstrap 畫面"

msgid "Displays rows in a Bootstrap Panel."
msgstr "在 Bootstrap 畫面中顯示列。"

msgid "The Bootstrap tabs displays content with tab titles linked to dynamically displayed content (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap 標籤會顯示內容，且其標籤標題會鏈結至動態顯示的內容（<a href=\":docs\">請參閱說明文件</a>）。"

msgid "Tab field"
msgstr "欄標欄位"

msgid "Select the field that will be used as the tab."
msgstr "選取要用作欄標的欄位。"

msgid "Tab Type"
msgstr "欄標類型"

msgid "Tabs"
msgstr "頁籤"

msgid "Pills"
msgstr "膠囊"

msgid "List"
msgstr "清單"

msgid "Position of tabs"
msgstr "標籤的位置"

msgid "Tabs/pills on the top"
msgstr "標籤/藥丸位於頂端"

msgid "Tabs/pills on the left"
msgstr "標籤/藥丸位於左側"

msgid "Tabs/pills on the right"
msgstr "標籤/藥丸位於右側"

msgid "Tabs/pills on the bottom"
msgstr "標籤/藥丸位於底端"

msgid "Tabs/pills justified on the top"
msgstr "標籤/藥丸對齊頂端"

msgid "Tabs/pills stacked"
msgstr "標籤/藥丸堆疊"

msgid "Fade Effect"
msgstr "淡出效果"

msgid "Add a fade in effect when tabs clicked"
msgstr "當按一下標籤時，新增淡出效果"

msgid "Bootstrap Tabs"
msgstr "Bootstrap 標籤"

msgid "Displays rows in Bootstrap Tabs."
msgstr "在「引導欄標」中顯示列。"

msgid "The Bootstrap table style adds default Bootstrap table classes and optional classes (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap 表格樣式會新增預設 Bootstrap 表格類別和選用類別（<a href=\":docs\">請參閱說明文件</a>）。"

msgid "Responsive"
msgstr "響應式"

msgid "To make a table scroll horizontally on small devices."
msgstr "在小型裝置上讓表格水平捲動。"

msgid "Bootstrap styles"
msgstr "引導樣式"

msgid "Striped"
msgstr "條紋化"

msgid "Bordered"
msgstr "加上邊框"

msgid "Hover"
msgstr "移至"

msgid "Condensed"
msgstr "壓縮"

msgid "Caption for the table"
msgstr "表格的標題"

msgid "A title semantically associated with your table for increased accessibility."
msgstr "在語意上與您的表格相關聯以提高可存取性的標題。"

msgid "Table details"
msgstr "表格詳細資料"

msgid "Summary title"
msgstr "摘要標題"

msgid "Table description"
msgstr "表格說明"

msgid "Provide additional details about the table to increase accessibility."
msgstr "提供有關表格的其他詳細資料，以提高可存取性。"

msgid "Bootstrap Table"
msgstr "引導表格"

msgid "Displays rows in a Bootstrap table."
msgstr "在「引導表格」中顯示列。"

msgid "The Bootstrap thumbnails extends the grid display with the thumbnail component to showcase linked images (<a href=\":docs\">see documentation</a>)."
msgstr "Bootstrap 縮圖會以縮圖元件來擴充網格顯示畫面，以展示鏈結的影像（<a href=\":docs\">請參閱說明文件</a>）。"

msgid "Bootstrap Thumbnails"
msgstr "Bootstrap 縮圖"

msgid "Displays rows in a Bootstrap Grid layout with thumbnails"
msgstr "以縮圖在「Bootstrap 網格」佈置中顯示列"

msgid "Previous"
msgstr "前項"

msgid "Next"
msgstr "下一頁"

