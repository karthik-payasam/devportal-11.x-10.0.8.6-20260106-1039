msgid "About"
msgstr "Sobre"

msgid "DropzoneJS"
msgstr "DropzoneJS"

msgid "or"
msgstr "ou"

msgid "Select file"
msgid_plural "Select files"
msgstr[0] "Selecionar arquivo"
msgstr[1] "Selecionar arquivos"

msgid "Dropzone library missing"
msgstr "Biblioteca do Dropzone ausente"

msgid ""
"Dropzonejs requires the dropzone.min.js library.\n"
"        Download it (https://github.com/enyo/dropzone) and place it in the\n"
"        libraries folder (/libraries)"
msgstr ""
"O Dropzonejs requer a biblioteca dropzone.min.js.\n"
"        Faça download dela (https://github.com/enyo/dropzone) e coloque-a na\n"
"        pasta de bibliotecas (/libraries)"

msgid "dropzonejs"
msgstr "dropzonejs"

msgid "The Drupal integration for DropzoneJS."
msgstr "A integração do Drupal para DropzoneJS."

msgid "Media"
msgstr "Mídia"

msgid "Dropzone upload files"
msgstr "Arquivos de upload do Dropzone"

msgid "Allow uploading of files via dropzonejs."
msgstr "Permitir upload de arquivos por meio de dropzonejs."

msgid "DropzoneJS settings"
msgstr "Configurações do DropzoneJS"

msgid "Upload scheme"
msgstr "Esquema de upload"

msgid "Transliterate names of uploaded files"
msgstr "Transliterar nomes de arquivos transferidos por upload"

msgid "Upload timeout"
msgstr "Tempo limite de upload"

msgid "Drop files here to upload"
msgstr "Solte os arquivos aqui para enviar"

msgid "Your browser does not support drag'n'drop file uploads."
msgstr "Seu navegador não suporta uploads de arquivo por arrastar e soltar."

msgid "Please use the fallback form below to upload your files like in the olden days."
msgstr "Use o formulário de fallback abaixo para fazer upload de seus arquivos, como nos velhos tempos."

msgid "File is too big ({{filesize}}MiB). Max filesize: {{maxFilesize}}MiB."
msgstr "O arquivo é muito grande ({{filesize}}MiB). Tamanho máximo do arquivo: {{maxFilesize}}MiB."

msgid "You can't upload files of this type."
msgstr "Não é possível fazer upload de arquivos deste tipo."

msgid "Server responded with {{statusCode}} code."
msgstr "O servidor respondeu com o código {{statusCode}}."

msgid "Cancel upload"
msgstr "Cancelar upload"

msgid "Are you sure you want to cancel this upload?"
msgstr "Tem certeza de que deseja cancelar este upload?"

msgid "Remove file"
msgstr "Remover arquivo"

msgid "You can not upload any more files."
msgstr "Não é possível fazer upload de mais arquivos."

msgid "TB"
msgstr "TB"

msgid "GB"
msgstr "GB"

msgid "MB"
msgstr "MB"

msgid "KB"
msgstr "KB"

msgid "b"
msgstr "b"

msgid "DropzoneJS entity browser widget"
msgstr "Widget do navegador da entidade do DropzoneJS"

msgid "DropzoneJS Entity browser widget."
msgstr "Widget do navegador DropzoneJS Entity."

msgid "DropzoneJS widget configuration"
msgstr "Configuração do widget do DropzoneJS"

msgid "Submit button text"
msgstr "Texto do botão Enviar"

msgid "Automatically submit selection"
msgstr "Enviar automaticamente a seleção"

msgid "Upload location"
msgstr "Localização do arquivo carregado"

msgid "Dropzone drag-n-drop zone text"
msgstr "Texto da zona de arrastar e soltar do Dropzone"

msgid "Maximum size of files"
msgstr "Tamanho máximo de arquivos"

msgid "Allowed file extensions"
msgstr "Extensões de arquivo permitidas"

msgid "Use clientside resize"
msgstr "Usar o redimensionamento do lado do cliente"

msgid "Maximum width"
msgstr "Largura máxima"

msgid "Maximum height"
msgstr "Altura máxima"

msgid "Resize quality"
msgstr "Qualidade de redimensionamento"

msgid "Method used for resizing"
msgstr "Método usado para redimensionamento"

msgid "Method used for generating the thumbnail"
msgstr "Método usado para gerar a miniatura"

msgid "Media Entity DropzoneJS widget configuration"
msgstr "Configuração do widget Entidade de mídia DropzoneJS"

msgid "Media type"
msgstr "Tipo de mídia"

msgid "Media Entity DropzoneJS with edit widget configuration"
msgstr "Configuração do widget Entidade de mídia DropzoneJS com edição"

msgid "Form mode"
msgstr "Modo de formulário"

msgid "Drop files here to upload them"
msgstr "Solte os arquivos aqui para enviá-los"

msgid "File upload"
msgstr "Envio de arquivo"

msgid "Files could not be uploaded because the destination directory %destination is not configured correctly."
msgstr "Os arquivos não puderam ser transferidos por upload porque o diretório de destino %destination não está configurado corretamente."

msgid "Some files that you are trying to upload did not pass validation. Requirements are: max file %size, allowed extensions are %extensions"
msgstr "Alguns arquivos dos quais você está tentando fazer upload não foram aprovados na validação. Os requisitos são: no máximo %size de arquivo, as extensões permitidas são %extensions"

msgid "At least one valid file should be uploaded."
msgstr "Pelo menos um arquivo válido deve ser transferido por upload."

msgid "A space separated list of file extensions"
msgstr "Uma lista separada por espaço de extensões de arquivos"

msgid "Use client side resizing"
msgstr "Usar o redimensionamento do lado do cliente"

msgid "Requires droopzone version v4.4.0 or higher and the <a href=\"@exif\" target=\"_blank\">exif</a> library."
msgstr "Requer a versão v4.4.0 ou superior do droopzone e a biblioteca <a href=\"@exif\" target=\"_blank\">exif</a>."

msgid "Max width"
msgstr "Largura máxima"

msgid "Max height"
msgstr "Altura máxima"

msgid "Resize method"
msgstr "Método de redimensionamento"

msgid "Contain (scale)"
msgstr "Conter (escala)"

msgid "Crop"
msgstr "Recortar"

msgid "Thumbnail method"
msgstr "Método de miniatura"

msgid "Invalid extension list format."
msgstr "Formato de lista de extensões inválido."

msgid "Adds DropzoneJS upload integration."
msgstr "Inclui a integração de upload DropzoneJS."

msgid "Missing requirement: in order to use this widget you have to install Inline entity form module first"
msgstr "Requisito ausente: para usar este widget, você precisa instalar primeiramente o módulo sequencial de formulário da entidade"

msgid "Edit"
msgstr "Editar"

msgid "Media Entity DropzoneJS with edit"
msgstr "Entidade de mídia DropzoneJS com edição"

msgid "Adds DropzoneJS upload integration that saves Media entities and allows to edit them."
msgstr "Inclui a integração de upload DropzoneJS que salva entidades de Mídia e permite a edição das mesmas."

msgid "The type of media entity to create from the uploaded file(s)."
msgstr "O tipo de entidade de mídia para criar a partir dos arquivos transferidos por upload."

msgid "You must @create_media_type before using this widget."
msgstr "Deve-se @create_media_type antes de usar esse widget."

msgid "create a media type"
msgstr "criar um tipo de mídia"

msgid "Media Entity DropzoneJS"
msgstr "Entidade de mídia DropzoneJS"

msgid "Adds DropzoneJS upload integration that saves Media entities."
msgstr "Inclui a integração de upload DropzoneJS que salva entidades de Mídia."

msgid "For security reasons, your upload has been renamed to %filename."
msgstr "Por razões de segurança, o arquivo que você enviou foi renomeado para %filename."

msgid "The specified file %name could not be uploaded."
msgstr "O arquivo %name especificado não pôde ser enviado."

msgid "The file could not be uploaded because the destination %destination is invalid."
msgstr "O arquivo não pôde ser carregado pois o destino %destination é inválido."

msgid "File upload error. Could not move uploaded file."
msgstr "Erro ao enviar o arquivo. Não foi possível mover o arquivo que você enviou."

msgid "Upload error. Could not move uploaded file %file to destination %destination."
msgstr "Erro no envio. Não foi possível mover o arquivo %file para o destino %destination."

msgid "The file could not be saved because it exceeds the maximum allowed size for uploads."
msgstr "O arquivo não pôde ser salvo porque ele excede o tamanho máximo permitido para uploads."

msgid "The file could not be saved because the upload did not complete."
msgstr "O arquivo não pôde ser salvo porque o upload não foi concluído."

msgid "The file could not be saved. An unknown error has occurred."
msgstr "O arquivo não pôde ser salvo. Ocorreu um erro desconhecido."

msgid "There was a problem while processing the file named @name"
msgstr "Houve um problema ao processar o arquivo chamado @name"

msgid "You don't have sufficent permissions to use the DropzoneJS uploader. Contact your system administrator"
msgstr "Você não tem permissões suficientes para usar o carregador DropzoneJS. Entre em contato com o administrador do seu sistema"

msgid "A maximum of @count files can be uploaded."
msgstr "Um máximo de @count arquivos podem ser carregados."

msgid "Drop file here to upload it"
msgid_plural "Drop files here to upload them"
msgstr[0] "Solte o arquivo aqui para fazer upload dele"
msgstr[1] "Soltar arquivos aqui para upload"

