msgstr "Impostazioni di terze parti"

msgid "Crop settings"
msgstr "Impostazioni ritaglio"

msgid "Field storing image to be cropped"
msgstr "Campo che memorizza l'immagine da ritagliare"

msgid "Crop effect configuration"
msgstr "Configurazione effetto ritaglio"

msgid "Automatic crop provider"
msgstr "Provider ritaglio automatico"

msgid "Crop API settings"
msgstr "Impostazioni API ritaglio"

msgid "Indicates whether to flush image derivatives when a crop entity is change"
msgstr "Indica se scaricare i derivati dell'immagine quando un'entità del ritaglio è cambia"

msgid "Media entity crop"
msgstr "Ritaglia entità media"

msgid "Deprecated."
msgstr "Obsoleto."

