msgstr "Tipo di ritaglio."

msgid "Language code"
msgstr "Codice della lingua"

msgid "The node language code."
msgstr "Il codice lingua del nodo."

msgid "Entity ID"
msgstr "ID Entità"

msgid "ID of entity crop belongs to."
msgstr "ID a cui il ritaglio dell'entità appartiene."

msgid "Entity type"
msgstr "Tipo di entità"

msgid "The type of entity crop belongs to."
msgstr "Il tipo a cui il ritaglio dell'entità appartiene."

msgid "URI"
msgstr "URI"

msgid "The URI of the image crop belongs to."
msgstr "L'URI a cui il ritaglio dell'immagine appartiene."

