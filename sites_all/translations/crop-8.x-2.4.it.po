msgstr "@first, @second e @count altro"

msgid "No crop types available. <a href=\"@link\">Add crop type</a>."
msgstr "Nessun tipo di ritaglio disponibile. <a href=\"@link\">Aggiungi tipo di ritaglio</a>."

msgid "Entity provider @id not found."
msgstr "Provider entità @id non trovato."

