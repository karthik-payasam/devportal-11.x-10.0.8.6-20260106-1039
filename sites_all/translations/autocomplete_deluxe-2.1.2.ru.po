msgid "Autocomplete Deluxe"
msgstr "Автодополнение Deluxe"

msgid "Enhanced autocomplete using Jquery UI autocomplete."
msgstr "Расширенное автодополнение на основе автодополнения Jquery UI. "

msgid "User interface"
msgstr "Интерфейс пользователя"

msgid "None"
msgstr "Нет"

msgid "The entity '@term' will be added."
msgstr "Будет добавлена сущность '@term'. "

msgid "No terms could be found. Please type in order to add a new term."
msgstr "Терминов не найдено. Введите название, чтобы добавить новый."

msgid "No results found"
msgstr "Результаты не найдены"

msgid "Autocomplete Deluxe widget settings"
msgstr "Параметры виджета Autocomplete Deluxe"

msgid "Match Operator"
msgstr "Оператор сравнения"

msgid "Route Name"
msgstr "Название маршрута"

msgid "Size"
msgstr "Размер"

msgid "Selection Handler"
msgstr "Обработчик выбора"

msgid "Limit"
msgstr "Предел"

msgid "Min Length"
msgstr "Минимальная длина"

msgid "Delimiter"
msgstr "Разделитель"

msgid "Allow \"Not Found\" message"
msgstr "Разрешить сообщение \"Не найдено\""

msgid "\"Not Found\" Message"
msgstr "Сообщение \"Не найдено\""

msgid "Allow New Terms"
msgstr "Разрешить новые термины"

msgid "No Empty Message"
msgstr "Нет пустого сообщения"

msgid "Match operator"
msgstr "Оператор Match"

msgid "Specify the matcting operator."
msgstr "Задайте оператор сопоставления."

msgid "Limit of the output."
msgstr "Ограничение вывода. "

msgid "If set to zero no limit will be used"
msgstr "Если указано нулевое значение, ограничение не применяется"

msgid "Minimum length."
msgstr "Минимальная длина. "

msgid "The minimum length of characters to enter to open the suggestion list."
msgstr "Минимальное число символов, после ввода которых открывается список предложений. "

msgid "Delimiter."
msgstr "Разделитель."

msgid "A character which should be used beside the enter key, to separate terms."
msgstr "Символ, применяемый для разделения терминов, вместе с клавишей Enter. "

msgid "Show Term not found message"
msgstr "Показывать сообщение, если термин не найден"

msgid "If this is enabled, a message will be displayed when the term is not found."
msgstr "Позволяет разрешить выдачу сообщения о том, что термин не найден. "

msgid "Term not found message."
msgstr "Сообщение, когда термин не найден."

msgid "A message text which will be displayed, if the entered term was not found."
msgstr "Текст сообщения, отображаемого в том случае, если указанный термин не найден. "

msgid "Allow new terms"
msgstr "Разрешить новые термины"

msgid "Should it be allowed, that user enter new terms?"
msgstr "Следует ли разрешить пользователю вводить новые термины? "

msgid "Empty value message."
msgstr "Сообщение о пустом значении. "

msgid "A text message that will be displayed when the field is focused and it does not contain values."
msgstr "Текстовое сообщение, отображаемое в том случае, если в выбранном поле отсутствуют значения. "

msgid "Match operator: @match_operator"
msgstr "Оператор Match: @match_operator"

msgid "Limit: @limit"
msgstr "Ограничение: @limit"

msgid "Min length: @min_length"
msgstr "Минимальная длина: @min_length"

msgid "Delimiter: @delimiter"
msgstr "Ограничитель: @delimiter"

msgid "Allow Not Found message: @not_found_message_allow"
msgstr "Разрешить сообщение Не найдено: @not_found_message_allow"

msgid "Not Found message: @not_found_message"
msgstr "Сообщение Не найдено: @not_found_message"

msgid "Allow new terms: @new_terms"
msgstr "Разрешить новые термины: @new_terms"

msgid "Empty value message: @no_empty_message"
msgstr "Сообщение о пустом значении: @no_empty_message"

msgid "@not_found_message"
msgstr "@not_found_message"

msgid "@no_empty_message"
msgstr "@no_empty_message"

msgid "Starts with"
msgstr "Начинается с"

msgid "Contains"
msgstr "Содержит"

