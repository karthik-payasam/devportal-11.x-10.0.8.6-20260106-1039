msgid "Schema.org Book"
msgstr "Książka Schema.org"

msgid "Adds Schema.org/Book to the JSON LD array."
msgstr "Dodaje ścieżkę Schema.org/Book to tablicy JSON LD."

msgid "SEO"
msgstr "SEO"

msgid "author"
msgstr "autor"

msgid "@id"
msgstr "@id"

msgid "name"
msgstr "nazwa"

msgid "description"
msgstr "opis"

msgid "sameAs"
msgstr "sameAs"

msgid "@type"
msgstr "@type"

msgid "url"
msgstr "url"

msgid "workExample"
msgstr "workExample"

msgid "review"
msgstr "przegląd"

msgid "aggregateRating"
msgstr "aggregateRating"

msgid "image"
msgstr "obraz"

msgid "Schema.org: Book"
msgstr "Schema.org: Book"

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "Ogólna ocena na podstawie kolekcji recenzji lub ocen elementu."

msgid "REQUIRED BY GOOGLE. Author of the book."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Autor książki."

msgid "A description of the item."
msgstr "Opis elementu."

msgid "RECOMMENDED BY GOOGLE. Globally unique @id, usually a url, used to to link other properties to this object."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Unikalny globalnie identyfikator @id (zwykle adres URL) używany do łączenia innych właściwości z tym obiektem."

msgid "The primary image for this item."
msgstr "Podstawowy obraz tego elementu."

msgid "REQUIRED BY GOOGLE. The title of the book."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Tytuł książki."

msgid "Reviews of this item."
msgstr "Recenzje tego elementu."

msgid "RECOMMENDED BY GOOGLE. URL of a reference Web page that unambiguously indicates the item's identity. E.g. the URL of the item's Wikipedia page, Wikidata entry, or official website."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Adres URL strony WWW z informacjami dodatkowymi, która jednoznacznie wskazuje tożsamość elementu. Np. adres URL strony Wikipedii, wpisu w serwisie Wikidata lub oficjalnego serwisu WWW elementu."

msgid "REQUIRED. The type of this Book"
msgstr "WYMAGANE. Typ tej książki"

msgid "REQUIRED BY GOOGLE. URL to the page on your site about the book. The page may list all available editions."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Adres URL do strony w serwisie o książce. Na tej stronie mogą być wyświetlane wszystkie dostępne wydania."

msgid "REQUIRED BY GOOGLE. An example of the book."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Przykład książki."

