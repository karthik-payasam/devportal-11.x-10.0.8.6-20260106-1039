msgid "Password Characters of Type Policy"
msgstr "Politica Caratteri password di tipo"

msgid "Minimum characters of a particular type the password must contain."
msgstr "Numero minimo di caratteri di un particolare tipo che la password deve contenere."

msgid "Security"
msgstr "Sicurezza"

msgid "Number of characters"
msgstr "Numero di caratteri"

msgid "Character type"
msgstr "Tipo di carattere"

msgid "Uppercase"
msgstr "Maiuscolo"

msgid "Lowercase"
msgstr "Minuscolo"

msgid "Letter"
msgstr "Lettera"

msgid "Numeric"
msgstr "Numerico"

msgid "Special Character"
msgstr "Carattere speciale"

msgid "The number of characters must be a positive number."
msgstr "Il numero di caratteri deve essere un numero positivo."

msgid "Password must contain at least 1 uppercase character."
msgid_plural "Password must contain at least @count unique uppercase characters."
msgstr[0] "La password deve contenere almeno 1 carattere maiuscolo."
msgstr[1] "la password deve contenere almeno @count caratteri maiuscoli univoci."

msgid "Password must contain at least 1 lowercase character."
msgid_plural "Password must contain at least @count unique lowercase characters."
msgstr[0] "La password deve contenere almeno 1 carattere minuscolo."
msgstr[1] "La password deve contenere almeno @count caratteri minuscoli univoci."

msgid "Password must contain at least 1 letter character."
msgid_plural "Password must contain at least @count unique letter characters."
msgstr[0] "La password deve contenere almeno 1 carattere lettera."
msgstr[1] "La password deve contenere almeno @count caratteri lettera univoci."

msgid "Password must contain at least 1 special character."
msgid_plural "Password must contain at least @count unique special characters."
msgstr[0] "La password deve contenere almeno 1 carattere speciale."
msgstr[1] "La password deve contenere almeno @count caratteri speciali univoci."

msgid "Password must contain at least 1 numeric character."
msgid_plural "Password must contain at least @count unique numeric characters."
msgstr[0] "La password deve contenere almeno 1 carattere numerico."
msgstr[1] "La password deve contenere almeno @count caratteri numerici univoci."

msgid "Password character type"
msgstr "Tipo di carattere della password"

msgid "Verifying that a password has a specific number of characters"
msgstr "Verifica che la password contenga un numero specifico di caratteri"

msgid "The password does not contain a the correct number of certain characters."
msgstr "La password non contiene il numero corretto di determinati caratteri."

