msgid "This module manages language icons for multilingual sites:"
msgstr "Questo modulo gestisce le icone delle lingue nei siti multilingue."

msgid "Automatically adds icons to language links."
msgstr "Aggiunge le icone ai link di selezione della lingua."

msgid "Provides related theme functions."
msgstr "Fornisce le relative funzioni per i temi grafici."

msgid "For more information, please see <a href=\"@handbook\">the online handbook section</a>."
msgstr "Per maggiori informazioni leggere la <a href=\"@handbook\">sezione del manuale online</a>."

msgid "To enable multilingual support for specific content types go to <a href=\"@configure_content_types\">configure content types</a>."
msgstr "Per abilitare il supporto multilingue per determinati tipi di contenuto, usare la pagina <a href=\"@configure_content_types\">configurazione tipi di contenuto</a>."

msgid "Language Icons"
msgstr "Icone delle lingue"

msgid "Adds icons to language links."
msgstr "Aggiunge le icone ai link di selezione della lingua."

msgid "Multilingual"
msgstr "Multilingue"

msgid "Language icons"
msgstr "Icone delle lingue"

msgid "Configure the Language Icons module."
msgstr "Configurare il modulo delle icone delle lingue."

msgid "Icons"
msgstr "Icone"

msgid "Language Icons settings"
msgstr "Impostazioni delle icone delle lingue"

msgid "Show the icons on a node"
msgstr "Mostra le icone su un nodo"

msgid "Show the icons on the language switcher block"
msgstr "Mostra le icone sul blocco commutatore di lingua"

msgid "Add language icons"
msgstr "Aggiunta icone delle lingue"

msgid "Link types to add language icons."
msgstr "Tipi di link a cui aggiungere le icone della lingua:"

msgid "Node links"
msgstr "Link all'interno dei contenuti"

msgid "Language switcher block"
msgstr "Link contenuti nel blocco selezione lingua"

msgid "These options are currently disabled due to <a href=\":issue_url\">a bug</a> that cannot currently be resolved. They may be reintroduced at a later stage."
msgstr "Queste opzioni sono attualmente disabilitate a causa di <a href=\":issue_url\">un bug</a> che attualmente non può essere risolto. Esse possono essere reintrodotte successivamente."

msgid "Icon placement"
msgstr "Posizione icone"

msgid "Before link"
msgstr "Prima del link"

msgid "After link"
msgstr "Dopo il link"

msgid "Replace link"
msgstr "In sostituzione del link"

msgid "Where to display the icon, relative to the link title."
msgstr "Dove mostrare l'icona, relativamente al titolo del link."

msgid "Icons file path"
msgstr "Percorso file delle icone"

msgid "Path for language icons, relative to Drupal installation. \"*\" is a placeholder for language code."
msgstr "Percorso per le icone delle lingue, relativo all'installazione di Drupal. Il carattere \"*\" verrà sostituito con il codice della lingua."

msgid "Image size"
msgstr "Dimensioni dell'immagine"

msgid "Image size for language icons, in the form \"width x height\"."
msgstr "Dimensioni delle icone delle lingue, nel formato \"larghezza x altezza\"."

