msgid "No Content Security Policy headers are currently enabled."
msgstr "Obecnie nie są włączone żadne nagłówki strategii bezpieczeństwa treści."

msgid "Enable a header via <a href=\":csp-settings\">the Content Security Policy settings</a>."
msgstr "Włącz nagłówek za pomocą <a href=\":csp-settings\">ustawień strategii bezpieczeństwa treści</a>."

msgid "Enabling Content Security Policy in Security Kit is likely to cause policy conflicts."
msgstr "Włączenie strategii bezpieczeństwa treści w module Security Kit może powodować konflikty strategii."

msgid "Disable the Content Security Policy settings in <a href=\":seckit-settings\">Security Kit configuration</a>."
msgstr "Wyłącz ustawienia strategii bezpieczeństwa treści w <a href=\":seckit-settings\">konfiguracji modułu Security Kit</a>."

msgid "Content Security Policy"
msgstr "Strategia bezpieczeństwa treści"

msgid "Provide Content-Security-Policy headers"
msgstr "Udostępnij nagłówki strategii bezpieczeństwa treści"

msgid "Configure policy enforcement."
msgstr "Skonfiguruj wymuszanie strategii."

msgid "Administer Content Security Policy"
msgstr "Administrowanie strategią zabezpieczeń treści"

msgid "Content Security Policy Settings"
msgstr "Ustawienia strategii bezpieczeństwa treści"

msgid "Report-Only Policy"
msgstr "Strategia tylko do raportowania"

msgid "Enforce Policy"
msgstr "Wymuś strategię"

