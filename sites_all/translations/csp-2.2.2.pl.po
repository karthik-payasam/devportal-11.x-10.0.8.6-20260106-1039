"<pre>@data</pre>"

msgid "Policies"
msgstr "Strategie"

msgid "Report Only"
msgstr "Tylko zgłoś"

msgid "Enforced"
msgstr "Wymuszona"

msgid "Enable '@type'"
msgstr "Włącz typ @type"

msgid "Additional Sources"
msgstr "Dodatkowe źródła"

msgid "Additional domains or protocols to allow for this directive, separated by a space."
msgstr "Dodatkowe domeny lub protokoły umożliwiające zezwolenie na tę dyrektywę, rozdzielane spacjami."

msgid "Instead of child-src, nested browsing contexts and workers should use the frame-src and worker-src directives, respectively."
msgstr "Zagnieżdżone konteksty i procesy robocze przeglądania powinny używać odpowiednio elementów frame-src i worker-src zamiast elementu child-src."

msgid "Handler"
msgstr "Format"

msgid "Reset @policyType policy to default values"
msgstr "Zresetuj strategię @policyType do wartości domyślnych"

msgid "No policies are currently enabled."
msgstr "Obecnie nie są włączone żadne strategie."

msgid "%policy %directive has a hash source configured, which may block functionality that relies on inline code."
msgstr "%policy %directive ma skonfigurowane źródło mieszania, które może blokować funkcje zależne od kodu wstawianego."

msgid "%policy %directive is enabled without a fallback directive for non-supporting browsers."
msgstr "%policy %directive jest włączona bez dyrektywy fallback dla nieobsługiwanych przeglądarek."

msgid "<a href=\":docUrl\">Nonces must be a unique value for each request</a>, so cannot be set in configuration."
msgstr "<a href=\":docUrl\">Nonces musi być wartością unikalną dla każdego żądania</a>, dlatego nie może być ustawiona w konfiguracji."

msgid "Invalid domain or protocol provided."
msgstr "Podano niepoprawną domenę lub protokół."

msgid "Reporting Handler is required for enabled policies."
msgstr "Procedura obsługi raportowania jest wymagana dla włączonych strategii."

msgid "Reporting is disabled"
msgstr "Raportowanie jest wyłączone"

msgid "Your <a href=\":url\">Report-URI.com subdomain</a>."
msgstr "Używana <a href=\":url\">poddomena Report-URI.com</a>."

msgid "Enable Wizard"
msgstr "Włącz kreator"

msgid "Send reports to the <a href=\":url\">CSP Wizard</a> reporting address."
msgstr "Wyślij raporty pod adres raportowania <a href=\":url\">kreatora CSP</a>."

msgid "Reports will be sent to a ReportURI.com account."
msgstr "Raporty będą wysyłane na konto ReportURI.com."

msgid "Reports will be added to the site log."
msgstr "Raporty będą dodawane do dziennika serwisu."

msgid "The URI to send reports to."
msgstr "Identyfikator URI miejsca, do którego mają być wysyłane raporty."

msgid "Reports will be sent to a URI."
msgstr "Raporty będą wysyłane na identyfikator URI."

