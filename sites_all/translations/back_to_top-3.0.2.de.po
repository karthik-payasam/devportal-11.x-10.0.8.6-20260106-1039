msgid "Back To Top"
msgstr "Back To Top"

msgid "Back To Top adds a button that hovers in the bottom of your screen and allow users to smoothly scroll up the page using jQuery."
msgstr "Back To Top fügt einen Button hinzu, der am unteren Ende des Bildschirms schwebt und es Benutzern, mithilfe von jQuery, ermöglicht gleichmäßig wieder zum Anfang der Seite zu scrollen."

msgid "User interface"
msgstr "Benutzeroberfläche"

msgid "Back to Top"
msgstr "Zurück zum Seitenanfang"

msgid "Administer Back To Top settings."
msgstr "Back-To-Top-Einstellungen verwalten."

msgid "Back to top settings"
msgstr "Zurück-Nach-Oben-Einstellungen"

msgid "Access Back to top settings"
msgstr "Back-To-Top-Einstellungen aufrufen"

msgid "Prevent on mobile and touch devices"
msgstr "Auf mobilen- und Touchgeräten nicht anzeigen"

msgid "Prevent on administration pages and node edit"
msgstr "Nicht im Verwaltungsbereich oder auf Beitragsbearbeitungsseiten anzeigen"

msgid "Prevent on front page"
msgstr "Nicht auf der Startseite anzeigen"

msgid "Trigger"
msgstr "Auslösen"

msgid "Placement"
msgstr "Platzierung"

msgid "Button text"
msgstr "Button-Text"

msgid "Button type"
msgstr "Buttontyp"

msgid "Background color"
msgstr "Hintergrundfarbe"

msgid "Border color"
msgstr "Rahmenfarbe"

msgid "Hover color"
msgstr "Farbe beim Überfahren mit dem Mauszeiger"

msgid "Text color"
msgstr "Schriftfarbe"

msgid "Back to top"
msgstr "Zurück nach oben"

msgid "Don´t show Back To Top-button on screen width up to 760px."
msgstr "Schaltfläche 'Zurück zum Anfang' nicht bei einer Anzeigenbreite von bis zu 760px anzeigen."

msgid "Do you want to prevent Back To Top on admin pages?"
msgstr "Soll der „Zurück zum Seitenanfang“-Button im Verwaltungsbereich nicht angezeigt werden?"

msgid "Do you want to prevent Back To Top on front page?"
msgstr "Soll der „Zurück zum Seitenanfang“-Button nicht auf der Startseite angezeigt werden?"

msgid "Set the number of pixel which trigger the Back To Top button default 100"
msgstr "Festlegen der Pixelanzahl, die den „Zurück zum Seitenanfang“-Button auslösen soll. (standardmäßig 100 Pixel)"

msgid "Where should the Back To Top button appear?"
msgstr "Wo soll der „Zurück zum Seitenanfang“-Button platziert werden?"

msgid "Bottom right"
msgstr "Unten rechts"

msgid "Bottom left"
msgstr "Unten links"

msgid "Bottom center"
msgstr "Unten zentriert"

msgid "Top right"
msgstr "Oben rechts"

msgid "Top left"
msgstr "Oben links"

msgid "Top center"
msgstr "Oben zentriert"

msgid "Mid right"
msgstr "Mitte rechts"

msgid "Mid left"
msgstr "Mitte links"

msgid "Mid center"
msgstr "zentral in der Mitte"

msgid "Set the text of the Back To Top button"
msgstr "Den Text des Buttons „Zurück nach oben“ festlegen"

msgid "Do you want Back To Top to use a PNG-24 image or a Text/Css button?"
msgstr "Soll Back To Top ein PNG-24 Bild oder eine Text/CSS Schaltfläche verwenden?"

msgid "Image (default)"
msgstr "Bild (Standard)"

msgid "Text/Css"
msgstr "Text/CSS"

msgid "Text/Css button settings"
msgstr "Einstellungen für den Text/CSS-Button"

msgid "Button background color default #F7F7F7"
msgstr "Standard-Hintergrundfarbe des Buttons #F7F7F7"

msgid "Border color default #CCCCCC"
msgstr "Standard-Rahmenfarbe #CCCCCC"

msgid "Hover color default #EEEEEE"
msgstr "Standardfarbe beim Überfahren mit dem Mauszeiger #EEEEEE"

msgid "Text color default #333333"
msgstr "Standard-Schriftfarbe #333333"

