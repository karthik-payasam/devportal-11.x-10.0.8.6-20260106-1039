msgid "About"
msgstr "Acerca de"

msgid "Enables metatags for custom routes"
msgstr "Habilita metaetiquetas para rutas personalizadas"

msgid "Metatag Custom Routes (Paths)"
msgstr "Rutas personalizadas de metaetiquetas (vías de acceso)"

msgid "Allows assigning meta tags to be used on custom routes, equivalent to custom paths."
msgstr "Permite asignar metaetiquetas para utilizarlas en rutas personalizadas, equivalentes a las vías de acceso personalizadas."

msgid "SEO"
msgstr "SEO (optimizador del motor de búsqueda)"

msgid "Add meta tag for custom route"
msgstr "Añadir etiqueta meta para ruta personalizada"

msgid "Add custom metatag"
msgstr "Añadir metaetiqueta personalizada"

msgid "Route / Path"
msgstr "Ruta/Vía de acceso"

msgid "Enter the route (path) for this new configuration, starting with a leading slash.<br />Note: this must already exist as a path in Drupal."
msgstr "Especifique la ruta (vía de acceso) para esta nueva configuración, empezando por una barra inclinada inicial.<br />Nota: ya debe existir como vía de acceso en Drupal."

msgid "Submit"
msgstr "Enviar"

msgid "The path must begin with /"
msgstr "La vía de acceso debe empezar por /"

msgid "The admin routes should not have metatags."
msgstr "Las rutas de administración no deben tener metaetiquetas."

msgid "The entities routes metatags must be added by fields. @entity_type - @id"
msgstr "Las metaetiquetas de rutas de entidades se deben añadir por campos. @entity_type - @id"

msgid "There are already metatags created for this route."
msgstr "Ya hay metaetiquetas creadas para esta ruta."

msgid "The path does not exist as an internal Drupal route."
msgstr "La vía de acceso no existe como ruta de Drupal interna."

msgid "Created metatags for the path: @url. Internal route: @route."
msgstr "Se han creado metaetiquetas para la vía de acceso: @url. Ruta interna: @route."

msgid "The metatags could not be created for the path: @url."
msgstr "No se han podido crear metaetiquetas para la vía de acceso: @url."

