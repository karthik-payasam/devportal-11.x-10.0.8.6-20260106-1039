msgstr "Pubblicazione"

msgid "Enable scheduled publishing for %type @plural"
msgstr "Abilita pubblicazione pianificata per %type @plural"

msgid "Change %type creation time to match the scheduled publish time"
msgstr "Modifica l'ora di creazione di %type in modo che corrisponda all'ora di pubblicazione pianificata"

msgid "The entity type does not support the change of creation time."
msgstr "Il tipo di entità non supporta la modifica dell'ora di creazione."

msgid "Require scheduled publishing"
msgstr "Richiedi pubblicazione pianificata"

msgid "Create a new revision on publishing"
msgstr "Crea una nuova revisione al momento della pubblicazione."

msgid "Advanced options"
msgstr "Opzioni avanzate"

msgid "Action to be taken for publication dates in the past"
msgstr "Azione da intraprendere per le date di pubblicazione nel passato"

msgid "Display an error message - do not allow dates in the past"
msgstr "Visualizza un messaggio di errore - non consentire le date nel passato"

msgid "Publish the %type @singular immediately after saving"
msgstr "Pubblica %type @singular immediatamente dopo il salvataggio"

msgid "Schedule the %type @singular for publication on the next cron run"
msgstr "Pianificare la pubblicazione di %type @singular alla successiva esecuzione cron"

msgid "Change %type creation time to match the published time, for dates before the %type was created"
msgstr "Modificare l'ora di creazione di %type in modo che corrisponda all'ora di pubblicazione, per date precedenti alla creazione di %type"

msgid "The created time will only be altered when the scheduled publishing time is earlier than the existing creation time"
msgstr "L'ora di creazione verrà modificata solo quando l'ora di pubblicazione pianificata è precedente all'ora di creazione esistente"

msgid "Unpublishing"
msgstr "Annullamento della pubblicazione"

msgid "Enable scheduled unpublishing for %type @plural"
msgstr "Abilita annullamento della pubblicazione pianificato per %type @plural"

msgid "Require scheduled unpublishing"
msgstr "Richiedi annullamento della pubblicazione pianificato"

msgid "Create a new revision on unpublishing"
msgstr "Crea una nuova revisione all'annullamento della pubblicazione"

