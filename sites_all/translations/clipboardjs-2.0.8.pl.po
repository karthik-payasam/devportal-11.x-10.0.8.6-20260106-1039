msgid "Download and install clipboard.js library."
msgstr "Pobierz i zainstaluj bibliotekę clipboard.js."

msgid "Skip installation of @name to @path."
msgstr "Pomiń instalację komponentu @name w ścieżce @path."

msgid "Unable to download @url."
msgstr "Nie można pobrać @url."

msgid "The @name library has been downloaded to @path."
msgstr "Biblioteka @name została pobrana do ścieżki @path."

msgid "Unable to move @name library to @path."
msgstr "Nie można przenieść biblioteki @name do ścieżki @path."

msgid "About"
msgstr "O stronie"

msgid "Clipboard.js"
msgstr "Clipboard.js"

msgid "Click to copy"
msgstr "Kliknij, aby skopiować"

msgid "Copied!"
msgstr "Skopiowano!"

msgid "A modern approach to copy text to clipboard."
msgstr "Nowoczesne podejście do kopiowania tekstu do schowka."

msgid "Content display"
msgstr "Wyświetlanie zawartości"

msgid "Clipboard.js formatter settings"
msgstr "Ustawienia formatera clipboard.js"

msgid "Label"
msgstr "Etykieta"

msgid "Alert style"
msgstr "Styl alertu"

msgid "Alert text"
msgstr "Tekst alertu"

msgid "Clipboard.js Button formatter settings"
msgstr "Ustawienia formatera clipboard.js przycisku"

msgid "Clipboard.js Snippet formatter settings"
msgstr "Ustawienia formatera clipboard.js fragmentu kodu"

msgid "Clipboard.js Textarea formatter settings"
msgstr "Ustawienia formatera clipboard.js obszaru tekstowego"

msgid "Clipboard.js Textfield formatter settings"
msgstr "Ustawienia formatera clipboard.js pola tekstowego"

msgid "Copied."
msgstr "Skopiowano."

msgid "This device does not support HTML5 Clipboard Copying. Please copy manually."
msgstr "To urządzenie nie obsługuje kopiowania schowka HTML5. Skopiuj ręcznie."

msgid "Press ⌘-@key to @action"
msgstr "Naciśnij ⌘-@key, aby wykonać działanie @action"

msgid "Press Ctrl-@key to @action"
msgstr "Naciśnij Ctrl-@key, aby wykonać działanie @action"

msgid "The URL !url could not be downloaded."
msgstr "Nie powiodło się pobranie z adresu URL !url."

msgid "Downloading library..."
msgstr "Trwa pobieranie biblioteki..."

msgid "Clipboard"
msgstr "Schowek"

msgid "The label on the button or hovertip."
msgstr "Etykieta przycisku lub podpowiedź."

msgid "The alert style e.g. <em>Tooltip</em>, <em>Alert</em> or <em>None</em>."
msgstr "Styl alertu, np. <em>Podpowiedź</em>, <em>Alert</em> lub <em>Brak</em>."

msgid "The alert text, shown as tooltip or alert."
msgstr "Tekst alertu, który jest wyświetlany jako podpowiedź lub alert."

msgid "Label: @label"
msgstr "Etykieta: @label"

msgid "Alert style: @alert_style"
msgstr "Styl alertu: @alert_style"

msgid "Alert text: @alert_text"
msgstr "Tekst alertu: @alert_text"

msgid "Clipboard.js Button"
msgstr "Clipboard.js – przycisk"

msgid "Clipboard.js Snippet"
msgstr "Clipboard.js – fragment kodu"

msgid "Clipboard.js Textarea"
msgstr "Clipboard.js – obszar tekstowy"

msgid "Clipboard.js Textfield"
msgstr "Clipboard.js – pole tekstowe"

