msgid "Schema.org: Person"
msgstr "Schema.org: Kişi"

msgid "An additional name for a Person, can be used for a middle name."
msgstr "Bir Kişi için ek ad, ikinci ad olarak kullanılabilir."

msgid "Physical address of the person."
msgstr "Kişinin fiziksel adresi."

msgid "An organization that this person is affiliated with. For example, a school/university, a club, or a team."
msgstr "Bu kişinin ilişkili olduğu bir kuruluş. Örneğin bir okul/üniversite, kulüp veya ekip."

msgid "An alias for the person."
msgstr "Kişi için diğer ad."

msgid "birthDate"
msgstr "birthDate"

msgid "Date of birth of the person in ISO 8601 format, 2017-12-31."
msgstr "Kişinin ISO 8601 biçiminde doğum tarihi, 2017-12-31."

msgid "The brand of the person."
msgstr "Kişinin markası."

msgid "A description of the person."
msgstr "Kişinin açıklaması."

msgid "The email address of the person."
msgstr "Kişinin e-posta adresi."

msgid "familyName"
msgstr "familyName"

msgid "Family name. In the U.S., the last name of an Person. This can be used along with givenName instead of the name property."
msgstr "Soyad. ABD'de, Bir Kişinin soyadı. Ad özelliği yerine givenName ile birlikte kullanılabilir."

msgid "Gender of the person."
msgstr "Kişinin cinsiyeti."

msgid "givenName"
msgstr "givenName"

msgid "Given name. In the U.S., the first name of a Person. This can be used along with familyName instead of the name property."
msgstr "İlk ad. ABD'de, Bir Kişinin adı. Ad özelliği yerine familyName ile birlikte kullanılabilir."

msgid "Globally unique id of the person, usually a url."
msgstr "Kişinin genel olarak benzersiz tanıtıcısı, genellikle bir url'dir."

msgid "The primary image for the person."
msgstr "Kişi için birincil resim."

msgid "jobTitle"
msgstr "jobTitle"

msgid "The job title of the person (for example, Financial Manager)."
msgstr "Kişinin iş unvanı (örneğin, Finans Müdürü)."

msgid "memberOf"
msgstr "memberOf"

msgid "An Organization (or ProgramMembership) to which this Person belongs."
msgstr "Bu Kişinin ait olduğu bir Kuruluş (veya ProgramMembership)."

msgid "REQUIRED BY GOOGLE. The name of the person."
msgstr "GOOGLE İÇİN ZORUNLU. Kişinin adı."

msgid "REQUIRED BY GOOGLE. A single or an [array] of URLs for the person's official social media profile page(s)."
msgstr "GOOGLE İÇİN ZORUNLU. Kişinin resmi sosyal medya profil sayfası/sayfaları için tek veya URL [dizisi]."

msgid "The telephone number of the person."
msgstr "Kişinin telefon numarası."

msgid "REQUIRED. The type of person (fixed by standard)."
msgstr "ZORUNLU. Kişinin tipi (standart olarak sabit)."

msgid "REQUIRED BY GOOGLE. The URL for the person's official website."
msgstr "GOOGLE İÇİN ZORUNLU. Kişinin resmi web sitesinin URL adresi."

msgid "worksFor"
msgstr "worksFor"

msgid "Organizations that the person works for."
msgstr "Kişinin çalıştığı kuruluşlar."

