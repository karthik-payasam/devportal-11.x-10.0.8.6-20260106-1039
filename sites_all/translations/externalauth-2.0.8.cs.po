msgid "External Authentication Map"
msgstr "Externí ověřovací mapa"

msgid "Provider"
msgstr "Poskytovatel"

msgid "The name of the authentication provider providing the authname."
msgstr "Název poskytovatele ověřování poskytujícího název authname."

msgid "Authname"
msgstr "Authname"

msgid "Unique authentication name provided by authentication provider."
msgstr "Jedinečný název ověření poskytnutý poskytovatelem ověřování."

msgid "Drupal User ID"
msgstr "ID uživatele Drupal"

msgid "The user linked to the authname."
msgstr "Uživatel propojený se jménem autora."

msgid "Linked Drupal user"
msgstr "Propojený uživatel Drupal"

msgid "Link to delete @label entry"
msgstr "Odkaz pro odstranění položky @label"

msgid "Provide a link to delete the @label entry."
msgstr "Zadejte odkaz pro odstranění položky @label."

msgid "About"
msgstr "Popis"

msgid "Authenticates users using an external site / service and stores identification details."
msgstr "Ověřuje uživatele pomocí externího webu/služby a uloží identifikační údaje."

msgid "External Authentication"
msgstr "Externí ověřování"

msgid "Helper module to authenticate users using an external site / service and storing identification details"
msgstr "Pomocný modul pro ověření uživatelů pomocí externího webu/služby a uložení identifikačních podrobností"

msgid "User authentication"
msgstr "Ověření uživatele"

msgid "View external authentication data"
msgstr "Zobrazit externí data ověřování"

msgid "Delete external authentication data"
msgstr "Odstranit externí data ověřování"

msgid "Delete authmap entry"
msgstr "Odstranit položku authmap"

msgid "Authmap change (%old => %new) for user %name with uid %uid from provider %provider"
msgstr "Změna autorizační mapy (%old => %new) pro uživatele %name s identifikátorem uid %uid od poskytovatele %provider"

msgid "External registration of user %name from provider %provider and authname %authname"
msgstr "Externí registrace uživatele %name od poskytovatele %provider a authname %authname"

msgid "External login of user %name"
msgstr "Externí přihlášení uživatele %name"

msgid "Are you sure you want to delete the link between authentication name %id and Drupal user %user?"
msgstr "Jste si jisti, že chcete odstranit propojení mezi názvem ověření %id a uživatelem Drupal %user?"

msgid "No authmap record found for provider @provider / uid @uid."
msgstr "Nebyl nalezen žádný záznam authmap pro poskytovatele @provider / identifikátor uživatele @uid."

msgid "The link has been deleted."
msgstr "Propojení bylo odstraněno."

msgid "User’s users.uid."
msgstr "users.uid uživatele."

msgid "Unique authentication name."
msgstr "Jedinečný název ověření."

msgid "Module which is controlling the authentication."
msgstr "Modul, který řídí ověření."

msgid "delete"
msgstr "smazat"

msgid "Output the URL as text"
msgstr "Výstup adresy URL jako text"

msgid "Use absolute link (begins with \"http://\")"
msgstr "Použít absolutní odkaz (začínající „http://“)"

msgid "Enable this option to output an absolute link. Required if you want to use the path as a link destination."
msgstr "Zaškrtněte tuto volbu pro výstup absolutního odkazu. Povinné, chcete-li použít cestu jako cíl odkazu."

