msgstr "사용자 정의 경로 재지정 경로"

msgid "Redirect to this display"
msgstr "이 디스플레이로 경로 재지정"

msgid "Include query string parameters on redirect"
msgstr "경로 재지정 시 조회 문자열 매개변수 포함"

msgid "Data export output format"
msgstr "데이터 내보내기 출력 형식"

