msgstr "CSV 설정"

msgid "Delimiter"
msgstr "구분 기호"

msgid "Enclosure"
msgstr "격납장치"

msgid "Escape character"
msgstr "이스케이프 문자"

msgid "Strip HTML"
msgstr "HTML 삭제"

msgid "Trim whitespace"
msgstr "공백 자르기"

msgid "Encoding"
msgstr "인코딩"

msgid "Include unicode signature (BOM)"
msgstr "유니코드 서명(BOM) 포함"

msgid "Only use serializer->encode method"
msgstr "시리얼라이저->인코드 메소드만 사용"

msgid "XLS settings"
msgstr "XLS 설정"

msgid "Metadata"
msgstr "메타데이터"

msgid "Creator"
msgstr "작성자"

msgid "Last modified by"
msgstr "마지막 수정 날짜 "

msgid "Title"
msgstr "제목"

msgid "Description"
msgstr "설명"

msgid "Subject"
msgstr "제목"

msgid "Keywords"
msgstr "키워드"

msgid "Category"
msgstr "카테고리"

msgid "Manager"
msgstr "관리자"

msgid "Company"
msgstr "회사"

msgid "Exporting data..."
msgstr "데이터를 내보내는 중..."

msgid "@percentage% complete. Time elapsed: @elapsed"
msgstr "@percentage%이(가) 완료되었습니다. 경과 시간: @elapsed"

msgid "Export settings"
msgstr "내보내기 설정"

msgid "Method"
msgstr "메소드"

msgid "Change the way rows are processed."
msgstr "행이 처리되는 방법을 변경합니다."

msgid "Standard"
msgstr "표준"

msgid "Batch (size: @size)"
msgstr "일괄처리(크기: @size)"

msgid "The maximum amount of rows to export."
msgstr "내보낼 최대 행 수입니다."

msgid "@nr rows"
msgstr "@nr개 행"

msgid "no limit"
msgstr "한계 없음"

msgid "Multiple displays"
msgstr "여러 디스플레이"

msgid "None"
msgstr "없음"

msgid "Facet settings"
msgstr "패싯 설정"

msgid "Facet source"
msgstr "패싯 소스"

msgid "(@filename)"
msgstr "(@filename)"

msgid "(@export_format)"
msgstr "(@export_format)"

msgid "Batch"
msgstr "일괄처리"

msgid "Exports under one request. Best fit for small exports."
msgstr "한 번의 요청으로 내보냅니다. 소규모 내보내기에 가장 적합합니다."

msgid "Exports data in sequences. Should be used when large amount of data is exported (> 2000 rows)."
msgstr "순차적으로 데이터를 내보냅니다. 대량 데이터(> 2000개 행)를 내보낼 때 사용되어야 합니다."

msgid "The number of rows to process under a request."
msgstr "요청에서 처리할 행 수입니다."

msgid "The maximum amount of rows to export. 0 means unlimited."
msgstr "내보낼 최대 행 수입니다. 0은 무제한을 의미합니다."

msgid "File Storage/Download Settings"
msgstr "파일 스토리지/다운로드 설정"

msgid "Filename"
msgstr "파일명"

msgid "The filename that will be suggested to the browser for downloading purposes. You may include replacement patterns from the list below."
msgstr "다운로드 목적을 위해 브라우저에 제출될 파일 이름입니다. 아래 목록의 대체 패턴을 포함할 수도 있습니다. "

msgid "Store file in public files directory"
msgstr "공용 파일 디렉토리에 파일 저장"

msgid "Check this if you want to store the export files in the public:// files directory instead of the private:// files directory."
msgstr "private:// 파일 디렉토리 대신 public:// 파일 디렉토리에 내보내기 파일을 저장하려면 이를 선택하십시오."

msgid "<strong>The private:// file system is not configured so the exported files will be stored in the public:// files directory. Click <a href=\"@link\" target=\"_blank\">here</a> for instructions on configuring the private files in the settings.php file.</strong>"
msgstr "<strong>private:// 파일 시스템이 구성되지 않았으므로 내보낸 파일이 public:// 파일 디렉토리에 저장됩니다. settings.php 파일에 개인용 파일을 구성하는 방법에 대한 지시사항을 보려면 <a href=\"@link\" target=\"_blank\">여기</a>를 클릭하십시오.</strong>"

msgid "Check this if you want to download the file immediately after it is created. Does <strong>NOT</strong> work for JSON data exports."
msgstr "파일이 작성된 후 즉시 파일을 다운로드하려면 이를 선택하십시오. JSON 데이터 내보내기에는 작동하지 <strong>않습니다</strong>."

msgid "Check this if you want to configure a custom redirect path."
msgstr "사용자 정의 경로 재지정 경로를 구성하려면 이를 선택하십시오."

msgid "Select the display to redirect to after batch finishes. If None is selected the user will be redirected to the front page."
msgstr "일괄처리가 완료된 후 경로 재지정할 디스플레이를 선택하십시오. 없음을 선택하면 사용자가 프론트 페이지로 경로 재지정됩니다."

msgid "Enter custom path to redirect user after batch finishes."
msgstr "일괄처리가 완료된 후 사용자를 경로 재지정할 사용자 정의 경로를 입력하십시오."

msgid "Check this if you want to include query string parameters on redirect."
msgstr "경로 재지정 시 조회 문자열 매개변수를 포함하려는 경우 이를 선택하십시오."

msgid "Displays"
msgstr "디스플레이"

msgid "The data export icon will be available only to the selected displays."
msgstr "데이터 내보내기 아이콘은 선택된 디스플레이에만 사용 가능합니다. "

msgid "Choose the facet source used to alter data export. This should be the display that this data export is attached to."
msgstr "데이터 내보내기를 변경하는 데 사용되는 패싯 소스를 선택하십시오. 이는 이 데이터 내보내기가 첨부된 디스플레이여야 합니다."

msgid "Could not write to temporary output file for result export (@file). Check permissions."
msgstr "결과 내보내기에 대한 임시 출력 파일(@file)에 쓸 수 없습니다. 권한을 확인하십시오."

msgid "Export complete. Download the file <a download href=\":download_url\"  data-download-enabled=\"false\" id=\"vde-automatic-download\">here</a>."
msgstr "내보내기가 완료되었습니다. <a download href=\":download_url\"  data-download-enabled=\"false\" id=\"vde-automatic-download\">여기</a>에서 파일을 다운로드하십시오."

msgid "Export complete. Download the file <a download href=\":download_url\" data-download-enabled=\"true\" id=\"vde-automatic-download\">here</a> if file is not automatically downloaded."
msgstr "내보내기가 완료되었습니다. 파일이 자동으로 다운로드되지 않는 경우 <a download href=\":download_url\" data-download-enabled=\"true\" id=\"vde-automatic-download\">여기</a>에서 파일을 다운로드하십시오."

msgid "Export failed. Make sure the private file system is configured and check the error log."
msgstr "내보내기에 실패했습니다. 개인용 파일 시스템이 구성되었는지 확인하고 오류 로그를 확인하십시오."

msgid "Data export"
msgstr "데이터 내보내기"

msgid "Export the view results to a file. Can handle very large result sets."
msgstr "보기 결과를 파일에 내보냅니다. 매우 큰 결과 세트를 처리할 수 있습니다. "

msgid "Indicates the character used to delimit fields. Defaults to a comma (<code>,</code>). For tab-separation use <code>\\t</code> characters."
msgstr "필드를 구분하는 데 사용되는 문자를 나타냅니다. 기본적으로 쉼표(<code>,</code>)입니다. 탭 구분을 위해 <code>\\t</code> 문자를 사용합니다. "

msgid "Indicates the character used for field enclosure. Defaults to a double quote (<code>\"</code>)."
msgstr "필드 격납장치에 사용되는 문자를 나타냅니다. 기본적으로 큰따옴표(<code>\"</code>)입니다. "

msgid "Indicates the character used for escaping. Defaults to a backslash (<code>\\</code>)."
msgstr "이스케이프에 사용되는 문자를 나타냅니다. 기본적으로 백슬래시(<code>\\</code>)입니다. "

msgid "Strips HTML tags from CSV cell values."
msgstr "HTML 태그를 CSV 셀 값에서 삭제합니다. "

msgid "Trims whitespace from beginning and end of CSV cell values."
msgstr "CSV 셀 값의 시작과 끝에서 공백을 자릅니다. "

msgid "Determines the encoding used for CSV cell values."
msgstr "CSV 셀 값에 사용되는 인코딩을 판별합니다. "

msgid "UTF-8"
msgstr "UTF-8"

msgid "Include unicode signature (<a href=\"@bom\" target=\"_blank\">BOM</a>)."
msgstr "유니코드 서명(<a href=\"@bom\" target=\"_blank\">BOM</a>)을 포함합니다."

msgid "Only use Symfony serializer->encode method"
msgstr "Symfony 시리얼라이저->인코드 메소드만 사용"

msgid "Skips the symfony data normalize method when rendering data export to increase performance on large datasets. <strong>(Only use when not exporting nested data)</strong>"
msgstr "대형 데이터 세트에 대한 성능을 향상시키기 위해 데이터 내보내기 렌더링 시 Symfony 데이터 정규화 메소드를 건너뜁니다. <strong>(중첩 데이터를 내보내지 않는 경우에만 사용합니다.)</strong>"

msgid "Configurable row output for data exports."
msgstr "데이터 내보내기에 구성 가능한 행 출력입니다. "

msgid "Download @format"
msgstr "@format 다운로드"

