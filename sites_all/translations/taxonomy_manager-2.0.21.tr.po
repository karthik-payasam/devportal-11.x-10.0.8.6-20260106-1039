msgstr "Taksonomi yöneticisi"

msgid "Administer vocabularies with the Taxonomy Manager"
msgstr "Sözlükleri Taxonomy Manager (Sınıflandırma Yöneticisi) ile yönet."

msgid "Advanced settings for the Taxonomy Manager"
msgstr "Taxonomy Manager (Sınıflandırma Yöneticisi) için gelişmiş ayarlar."

msgid "Access taxonomy manager list"
msgstr "Taksonomi yöneticisi listesine erişim"

msgid "Access the taxonomy manager overview list page."
msgstr "Taksonomi yöneticisine genel bakış liste sayfasına erişin."

msgid "Sub Tree"
msgstr "Alt Ağaç"

msgid "Sub Tree Child Parents String"
msgstr "Alt Ağaç Alt-Üst Öğe Dizgisi"

msgid "Add terms"
msgstr "Terim ekle"

msgid "Delete terms"
msgstr "Terimleri sil"

msgid "Export terms"
msgstr "Terimleri dışa aktar"

msgid "Move terms"
msgstr "Terimleri taşı"

msgid "Settings"
msgstr "Ayarlar"

msgid "Add new vocabulary"
msgstr "Yeni sözlük ekle"

