msgid "Workbench"
msgstr "워크벤치"

msgid "My personal editorial workspace"
msgstr "내 개인용 편집 작업공간"

msgid "Your Workbench"
msgstr "사용자의 워크벤치"

msgid "Provides convenient dashboards and shortcuts for editors."
msgstr "편리한 대시보드 및 편집기의 단축 아이콘을 제공합니다. "

msgid "My Workbench"
msgstr "내 워크벤치"

msgid "Create content"
msgstr "콘텐츠 작성"

msgid "My edits"
msgstr "내 편집"

msgid "All recent content"
msgstr "전체 최근 콘텐츠"

msgid "Configure"
msgstr "구성하기"

msgid "Workbench configuration"
msgstr "워크벤치 구성"

msgid "Access My Workbench"
msgstr "내 워크벤치 사용하기"

msgid "Administer Workbench content settings"
msgstr "워크벤치 컨텐츠 설정 관리"

msgid "Workbench settings"
msgstr "워크벤치 설정"

msgid "Add content"
msgstr "콘텐츠 추가하기"

msgid "Overview block left."
msgstr "개요 블록 왼쪽. "

msgid "Overview block right."
msgstr "개요 블록 오른쪽"

msgid "Overview block main."
msgstr "개요 블록 기본. "

msgid "My edits main."
msgstr "내 편집 기본. "

msgid "All content main."
msgstr "내 컨텐츠 기본. "

msgid "Overview block left"
msgstr "개요 블록 왼쪽"

msgid "Overview block right"
msgstr "개요 블록 오른쪽 "

msgid "Overview block main"
msgstr "개요 블록 기본"

msgid "My edits main"
msgstr "내 편집 기본. "

msgid "All content main"
msgstr "내 컨텐츠 기본. "

msgid "Workbench provides three pages that can be configured. The overview \"My Workbench\" page has three content sections, while the \"My edits\" and \"All recent content\" pages have one. Select the View and display that you wish to use."
msgstr "워크벤치는 구성할 수 있는 세 개의 페이지를 제공합니다. 개요 \"내 워크벤치\" 페이지에는 세 개의 컨텐츠 섹션이 있는 반면, \"내 편집\" 및 \"모든 최신 컨텐츠\" 페이지에는 하나만 있습니다. 사용하려는 보기와 디스플레이를 선택합니다. "

msgid "Workbench information"
msgstr "워크벤치 정보"

