msgid "OpenAPI"
msgstr "OpenAPI"

msgid "Connects Drupal to the OpenAPI Javascript Library"
msgstr "Conecta Drupal con la biblioteca javascript de OpenAPI"

msgid "Available OpenAPI Documentation."
msgstr "Documentación de OpenAPI disponible "

msgid "Access API Docs"
msgstr "Acceder a documentos de API"

msgid "Access documentation page for the REST API"
msgstr "Acceder a la página de documentación de la API REST"

msgid "OpenAPI Schema Download"
msgstr "Descarga de Esquema de OpenAPI"

msgid "OpenAPI Resources"
msgstr "Recursos OpenAPI "

msgid "OpenAPI Documentation"
msgstr "Documentación de OpenAPI "

msgid "%label OpenApi Schema Download"
msgstr "Descarga de esquema de OpenApi %label"

msgid "The specifications provide the documentation on some of Drupal's apis following <a href=':openapi_spec'>OpenAPI (aka Swagger)</a> standards."
msgstr "Las especificaciones proporcionan la documentación sobre las API de Drupal que siguen los estándares <a href=':openapi_spec'>OpenAPI (conocido anteriormente como Swagger)</a>."

msgid "These json files can be used in tools such as the <a href=\":swagger_editor\">Swagger Editor</a> to provide a more detailed version of the API documentation or <a href=\":swagger_codegen\">Swagger Codegen</a> to create an api client."
msgstr "Estos archivos json se pueden utilizar en herramientas como, por ejemplo, el <a href=\":swagger_editor\">Editor Swagger</a> para proporcionar una versión más detallada de la documentación de API o <a href=\":swagger_codegen\">Swagger Codegen</a> para crear un cliente de API. "

msgid "Module"
msgstr "Módulo"

msgid "Specification"
msgstr "Especificación"

msgid "Explore"
msgstr "Explorar"

msgid "Please visit the <a href=':openapi_ui_link'>OpenAPI UI module</a> for information on these interfaces and to discover others."
msgstr "Visite el <a href=':openapi_ui_link'>módulo de IU OpenAPI</a> para obtener información sobre estas interfaces y para descubrir otras. "

msgid "No UI plugins available"
msgstr "No hay plug-ins de IU disponibles"

msgid "There are no plugins available for exploring the OpenAPI documentation."
msgstr "No hay ningún plug-ins disponible para explorar la documentación de OpenAPI. "

msgid "You can install one of the below projects to view the API Specifications from with your site."
msgstr "Puede instalar uno de los proyectos siguientes para ver las especificaciones de API desde el sitio. "

msgid "View/Download"
msgstr "Ver/Descargar"

msgid "Explore with %interface"
msgstr "Explorar con %interface"

msgid "No UI available."
msgstr "No hay ninguna IU disponible."

msgid "No OpenApi generator plugins are currently available."
msgstr "No hay plug-ins de generador de OpenApi disponibles actualmente."

msgid "You must enable a REST or API module which supports OpenApi Downloads, such as the <a href=\":rest_link\">Core Rest</a> and <a href=\":jsonapi_link\">JSON:API</a> modules."
msgstr "Debe habilitar un módulo REST o API que dé soporte a las descargas de OpenApi como, por ejemplo, los módulos <a href=\":rest_link\">Core Rest</a> y <a href=\":jsonapi_link\">JSON:API</a>. "

msgid "%generator OpenApi Documentation"
msgstr "Documentación de OpenApi %generator "

