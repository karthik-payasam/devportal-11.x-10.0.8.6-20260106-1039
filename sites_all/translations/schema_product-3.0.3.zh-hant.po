msgid "Schema.org Product"
msgstr "Schema.org 產品"

msgid "Adds Schema.org/Product to the JSON LD array. Creates Product."
msgstr "將 Schema.org/產品新增至 JSON LD 陣列。 建立產品。"

msgid "SEO"
msgstr "SEO"

msgid "description"
msgstr "說明"

