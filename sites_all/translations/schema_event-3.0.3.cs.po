msgid "Schema.org: Event"
msgstr "Schema.org: Událost"

msgid "The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "Celkové hodnocení založené na kolekci revizí nebo hodnocení položky."

msgid "RECOMMENDED BY GOOGLE. A description of the event."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Popis události."

msgid "The time when admission will commence."
msgstr "Čas, kdy bude zahájeno přijetí."

msgid "RECOMMENDED BY GOOGLE. Date and time when the event ends."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Datum a čas, kdy událost končí."

msgid "RECOMMENDED BY GOOGLE. The eventAttendanceMode of the event. Valid values are https://schema.org/OfflineEventAttendanceMode, https://schema.org/MixedEventAttendanceMode, or https://schema.org/OnlineEventAttendanceMode."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Režim eventAttendanceMode události. Platné hodnoty jsou https://schema.org/OfflineEventAttendanceMode, https://schema.org/MixedEventAttendanceMode nebo https://schema.org/OnlineEventAttendanceMode."

msgid "RECOMMENDED BY GOOGLE. The status of the event. Valid options are https://schema.org/EventCancelled, https://schema.org/EventMovedOnline, https://schema.org/EventPostponed, https://schema.org/EventRescheduled, or https://schema.org/EventScheduled."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Stav události. Platné volby jsou https://schema.org/EventCancelled, https://schema.org/EventMovedOnline, https://schema.org/EventPostponed, https://schema.org/EventRescheduled nebo https://schema.org/EventScheduled."

msgid "Globally unique id of the event, usually a url."
msgstr "Globálně jedinečné ID události, obvykle adresa URL."

msgid "RECOMMENDED BY GOOGLE. The primary image for this item."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Primární obrázek pro tuto položku."

msgid "REQUIRED BY GOOGLE. The location of the event."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Umístění události."

msgid "REQUIRED BY GOOGLE. The name of the event."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Název události."

msgid "RECOMMENDED BY GOOGLE. Offers associated with the event."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Nabídky přidružené k události."

msgid "RECOMMENDED BY GOOGLE. The organizer of the event."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Organizátor události."

msgid "RECOMMENDED BY GOOGLE. The performer on the event."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Vykonavatel události."

msgid "RECOMMENDED BY GOOGLE. The previousStartDate of the event."
msgstr "DOPORUČENO APLIKACÍ GOOGLE. Datum previousStartDate události."

msgid "Reviews of this event."
msgstr "Recenze této události."

msgid "REQUIRED BY GOOGLE. Date and time when the event starts."
msgstr "POŽADOVÁNO APLIKACÍ GOOGLE. Datum a čas, kdy se událost spustí."

msgid "REQUIRED. The type of event."
msgstr "POŽADOVÁNO. Typ události."

msgid "The URL of the event."
msgstr "Adresa URL události."

