msgid "About"
msgstr "Sobre"

msgid "View Password module will help the user to see what password they entered."
msgstr "O módulo View Passwor ajuda o usuário para ver qual senha ele digitou."

msgid "Show password"
msgstr "Mostrar senha"

msgid "Hide password"
msgstr "Ocultar senha"

msgid "View Password"
msgstr "View Password"

msgid "Allows the users to see the contents of the password fields on selected forms before submission."
msgstr "Permite que usuários vejam o conteúdo dos campos de senha em formulários selecionados antes do envio."

msgid "View Password Settings"
msgstr "Configurações do View Password"

msgid "Lets you see password for the selected forms."
msgstr "Apresente a senha nos formulários selecionados."

msgid "Administer View password"
msgstr "Administrar View password"

msgid "Configure the View password settings."
msgstr "Configure o View Password."

msgid "View password config"
msgstr "View password config"

msgid "Do not want to display the password for this forms."
msgstr "Não deseja apresentar senha para estes formulários."

msgid "Enter the form id(s) here."
msgstr "Digite aqui o(s) ID(s) do formulário."

msgid "<p>Please enter the form id(s) by separating it with a comma (<em>make sure there are no spaces between form ids</em>). For example, the usual form ids are <code>user_login_form</code> and <code>user_register_form</code>. .</p>"
msgstr "<p>Por favor digite o(s) ID(s) de formulário separando-os com uma vírgula (<em>tenha certeza que não existem espaços em branco entre os IDs dos formulários</em>). Por exemplo, os IDs de formulários comuns são <code>user_login_form</code> e <code>user_register_form</code>. .</p>"

msgid "Enter the form class here."
msgstr "Digite aqui a classe do formulário."

msgid "Please enter the icon span classes separated with a space."
msgstr "Por favor, digite as classes do ícone span, separando com um espaço."

