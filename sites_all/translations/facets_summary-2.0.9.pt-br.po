msgstr "Nenhum comportamento de resultados"

msgid "The text to show when there is no current search"
msgstr "O texto a ser mostrado quando não há uma procura atual"

msgid "Reset facets link"
msgstr "Reconfigurar link das máscaras"

msgid "The text to show for the reset link."
msgstr "O texto a ser mostrado para o link de reconfiguração."

msgid "Position of the reset link."
msgstr "Posição do link de reconfiguração."

msgid "Processor @id specifies a non-existing @class."
msgstr "O @id do processador especifica uma @class não existente."

msgid "Facet summary"
msgstr "Resumo da máscara"

msgid "Edit %label facets summary"
msgstr "Editar o resumo de máscaras %label"

msgid "Enabled facets"
msgstr "Máscaras ativadas"

msgid "Separator"
msgstr "Separador"

msgid "Show counts"
msgstr "Mostrar contagens"

msgid "Weight"
msgstr "Peso"

msgid "Select the facets to be shown in the summary block. You can reorder them."
msgstr "Selecione as máscaras a serem mostradas no bloco de resumo. É possível reordená-las."

msgid "Weight for @title"
msgstr "Peso para @title"

msgid "No facets found."
msgstr "Nenhuma máscara localizada."

