msgid "Metatag: Pinterest"
msgstr "Metatag: Pinterest"

msgid "Provides support for Pinterest's custom meta tags."
msgstr "Proporciona soporte para las metaetiquetas personalizadas de Pinterest's."

msgid "SEO"
msgstr "SEO (optimizador del motor de búsqueda)"

msgid "Pinterest: Description"
msgstr "Pinterest: Descripción"

msgid "Pinterest: ID"
msgstr "Pinterest: ID"

msgid "Pinterest: Media"
msgstr "Pinterest: Soporte"

msgid "Pinterest: No hover"
msgstr "Pinterest: No contextual"

msgid "Pinterest: No pin"
msgstr "Pinterest: No anclar"

msgid "Pinterest: No search"
msgstr "Pinterest: No buscar"

msgid "Pinterest: URL"
msgstr "Pinterest: URL"

msgid "Pinterest"
msgstr "Pinterest"

msgid "A set of meta tags used to control how the site's content is consumed by <a href='https://pinterest.com/'>Pinterest</a>."
msgstr "Un conjunto de metaetiquetas utilizadas para controlar cómo <a href='https://pinterest.com/'>Pinterest</a> consume el contenido del sitio."

msgid "Description"
msgstr "Descripción"

msgid "A one to two sentence description of the content."
msgstr "Descripción de una dos frases del contenido."

msgid "Id"
msgstr "ID"

msgid "The Canonical Pinterest object to pin."
msgstr "El objeto de Pinterest canónico que se va a anclar."

msgid "Media"
msgstr "Soporte"

msgid "The URL of media which should represent the content."
msgstr "El URL del soporte que debe representar el contenido."

msgid "No hover"
msgstr "No contextual"

msgid "Do not show hovering Save or Search buttons, generated by the Pinterest browser extensions."
msgstr "No mostrar los botones contextuales Guardar o Buscar generados por las extensiones de navegador de Pinterest."

msgid "No pin"
msgstr "No anclar"

msgid "Do not pin anything from this page. When selected, this option will take precedence over all options below."
msgstr "No anclar nada desde esta página. Cuando esta opción está seleccionada, tendrá preferencia sobre el resto de opciones que figuran a continuación."

msgid "No search"
msgstr "No buscar"

msgid "Do not allow Pinterest visual search to happen from this page."
msgstr "No permitir que se realice la búsqueda visual de Pinterest desde esta página."

msgid "URL"
msgstr "URL"

msgid "The URL which should represent the content."
msgstr "El URL que debe representar el contenido."

