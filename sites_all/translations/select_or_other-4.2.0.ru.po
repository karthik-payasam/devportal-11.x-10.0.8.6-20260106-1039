msgid "Select or other list widget display format settings"
msgstr "Параметры формата отображения виджета выбора или другого виджета списка"

msgid "Add entered values from the other field to the allowed values list"
msgstr "Добавить значения, указанные в другом поле, в список разрешенных значений"

msgid "- None -"
msgstr "- Не указано -"

msgid "Add entered values from the other field to the allowed values list."
msgstr "Добавить значения, указанные в другом поле, в список разрешенных значений. "

msgid "Select or Other"
msgstr "Выбрать или другое значение"

msgid "Sort options by value"
