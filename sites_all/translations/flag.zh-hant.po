msgstr "標示動作（標示或取消標示）"

msgid "Delete flagging entities"
msgstr "刪除旗標實體"

msgid "Flag filter"
msgstr "旗標過濾器"

msgid "Display options for flag relationship"
msgstr "旗標關係的顯示選項"

