msgid "Slick Extras"
msgstr "Extras de Slick"

msgid "Provides Slick carousel extras."
msgstr "Proporciona extras de carrusel Slick"

msgid "Slick"
msgstr "Slick"

msgid "Slick Development"
msgstr "Desarrollo de Slick"

msgid "Provides Slick carousel development."
msgstr "Proporciona desarrollo de carrusel Slick"

msgid "Configure the Slick development module settings."
msgstr "Configurar los parámetros del módulo de desarrollo Slick"

msgid "Development"
msgstr "Desarrollo"

msgid "Slick devel settings"
msgstr "Configuración del desarrollo Slick"

msgid "Enable development mode"
msgstr "Habilitar modo de desarrollo"

msgid "Use non-minified slick.load.js"
msgstr "Usar non-minified slick.load.js"

msgid "Disable module slick.load.js"
msgstr "Inhabilitar módulo slick.load.js"

msgid "Replace the slick.load.js with development version: slick.load.devel.js"
msgstr "Sustituir slick.load.js por versión de desarrollo: slick.load.devel.js"

msgid "Unless you are helping to develop the Slick module, all these are not needed to run Slick. Requires slick library 1.6.0 - 1.8.0 at most and slick module 2.10+."
msgstr ""

msgid "Load the development version of the Slick library. Only useful to test new features of the library. Leave it unchecked at production."
msgstr "Cargar versión de desarrollo de la biblioteca Slick. Solo es útil para probar nuevas funcionalidades de la biblioteca. Déjelo desmarcado en producción."

msgid "Replace slick.load.min.js with slick.load.js. Only useful to debug it."
msgstr "Sustituir slick.load.min.js por slick.load.js. Solo es útil para depurarla."

msgid "Slick will not run unless you initiliaze it yourself."
msgstr "Slick no ejecutará a menos que usted mismo lo inicialice."

msgid "Use slick.load.devel.js to debug the Slick without modifying slick.load.min.js."
msgstr "Use slick.load.devel.js para depurar Slick sin modificar slick.load.min.js."

msgid "Slick Example"
msgstr "Ejemplo Slick"

msgid "Provides Slick Carousel examples."
msgstr "Proporciona ejemplos de carrusel Slick."

msgid "Testimonial with thumbnail and description with slidesToShow 2."
msgstr "Testimonio con miniatura y descripción con slidesToShow 2."

msgid "Slick example skin"
msgstr "Máscara de ejemplo de Slick"

msgid "Adds 3d view with focal point at back, works best with 3 slidesToShow, and caption below."
msgstr "Añade una vista 3d con punto focal detrás, funciona mejor con 3 slidesToShow y título debajo."

msgid "Adds margins to the sides of slick-list revealing arrows."
msgstr "Añade márgenes a los lados de las flechas reveladoras de slick-list."

msgid "Carousel that has margins, alternative to centerMode."
msgstr "Carrusel que tiene márgenes, alternativo a centerMode."

msgid "Adds margins and split caption and image."
msgstr "Añade márgenes y título dividido e imagen."

msgid "Rounds the .slide__image, great for 3-5 visible-slides carousel."
msgstr "Redondea .slide__image, perfecto para un carrusel de 3-5 visible-slides."

msgid "Adds a vertical tabs like thumbnail navigation."
msgstr "Añade una pestaña vertical como navegación de miniaturas."

msgid "Slick extras skin"
msgstr "Máscara de extras de Slick"

