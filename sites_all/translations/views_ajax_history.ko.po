msgid "About"
msgstr "정보"

msgid "Enable bookmaking of AJAX views. Supports filters and paging."
msgstr "AJAX 보기의 서적 작성을 사용으로 설정합니다. 필터 및 페이징을 지원합니다."

msgid "Visit the <a href=\":project_link\">Views AJAX History project pages</a> on Drupal.org for more information."
msgstr "자세한 내용을 보려면 Drupal.org의 <a href=\":project_link\">보기 AJAX 히스토리 프로젝트 페이지</a>를 방문하십시오."

msgid "Views AJAX History"
msgstr "AJAX 히스토리 보기"

msgid "Add bookmarking abilities to AJAX Views."
msgstr "AJAX 보기에 책갈피 기능 추가. "

msgid "Views"
msgstr "보기"

msgid "Enable history"
msgstr "히스토리 사용"

msgid "AJAX history"
msgstr "AJAX 히스토리"

msgid "Enable Views AJAX history."
msgstr "보기 AJAX 히스토리를 사용으로 설정합니다."

msgid "Enable the AJAX history feature for the current view."
msgstr "현재 보기에 대한 AJAX 히스토리 기능을 사용으로 설정합니다."

