msgstr "Attributs du lien"

msgid "Default target"
msgstr "Attribut target par défaut "

msgid "Remove target attribute"
msgstr "Retirer l'attribut target "

msgid "Open in a new browser window or tab (_blank)"
msgstr "Ouvrir dans une nouvelle fenêtre ou un nouvel onglet de navigateur (_blank)"

msgid "Open in the current window (_self)"
msgstr "Ouvrir dans la fenêtre en cours (_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "Ouvrir dans le cadre situé au-dessus de celui dans lequel figure le lien (_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "Annuler tous les cadres et ouvrir dans une fenêtre de navigateur entière (_top)"

