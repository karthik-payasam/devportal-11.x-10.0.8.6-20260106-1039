msgid "Metatag: Google Plus"
msgstr "Metaznačka: Google Plus"

msgid "Provides support for Google's Plus meta tags. Deprecated, will be removed in Metatag 2.0.0."
msgstr "Poskytuje podporu pro metaznačky Google Plus. Zamítnuto, bude odebráno v Metatag 2.0.0."

msgid "SEO"
msgstr "SEO"

msgid "Google Plus: name"
msgstr "Google Plus: název"

msgid "Google Plus: image"
msgstr "Google Plus: obrázek"

msgid "Google Plus: description"
msgstr "Google Plus: popis"

msgid "Publisher URL"
msgstr "Adresa URL vydavatele"

msgid "Author"
msgstr "Autor"

msgid "Google Plus"
msgstr "Google Plus"

msgid "DEPRECATED, use Advanced-Author instead."
msgstr "Zamítnuto, použijte místo toho funkci Advanced-Author."

msgid "Description"
msgstr "Popis"

msgid "Content description less than 200 characters."
msgstr "Popis obsahu kratší 200 znaků."

msgid "Image"
msgstr "Obrázek"

msgid "The URL of an image which should represent the content. For best results use an image that is at least 1200 x 630 pixels in size, but at least 600 x 316 pixels is a recommended minimum. Supports PNG, JPEG and GIF formats."
msgstr "Adresa URL obrázku reprezentujícího obsah. Optimálně použijte obrázek, který má velikost nejméně 1200 x 630 pixelů. Doporučené minimum je 600 x 316 pixelů. Podporuje formáty PNG, JPEG a GIF."

msgid "Name"
msgstr "Název"

msgid "Content title."
msgstr "Název obsahu."

msgid "Used by some search engines to confirm publication of the content on a page. Should be the full URL for the publication's Google+ profile page."
msgstr "Používají některé vyhledávače pro potvrzení publikace obsahu na stránce. Musí jít o úplnou adresu URL stránky profilu Google+ publikace."

