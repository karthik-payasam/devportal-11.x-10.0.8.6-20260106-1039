msgid "Gravatar"
msgstr "Gravatar"

msgid "Adds Gravatar.com avatar generators for Avatar Kit."
msgstr "アバター・キット用の Gravatar.com アバター生成プログラムを追加します。"

msgid "Avatars"
msgstr "アバター"

msgid "Maximum content rating"
msgstr "最大コンテンツ・レーティング"

msgid "Gravatar generator"
msgstr "Gravatar 生成プログラム"

msgid "Type"
msgstr "タイプ"

msgid "Unrestricted"
msgstr "無制限"

msgid "G: suitable for display on all websites with any audience type."
msgstr "G: あらゆるタイプの対象者向けのすべての Web サイトでの表示に適しています。"

msgid "PG: may contain rude gestures, provocatively dressed individuals, the lesser swear words, or mild violence."
msgstr "PG: 感じの悪いしぐさ、刺激的な服装の人物、若干の罵り言葉、または軽い暴力が含まれている場合があります。"

msgid "R: may contain such things as harsh profanity, intense violence, nudity, or hard drug use."
msgstr "R: 強い罵り言葉、激しい暴力、ヌード、または強度の薬物使用などが含まれている場合があります。"

msgid "X: may contain hardcore sexual imagery or extremely disturbing violence."
msgstr "X: 露骨な性描写や非常に不愉快な暴力が含まれている場合があります。"

msgid "Maximum rating: @maximum_rating"
msgstr "最大レーティング: @maximum_rating"

msgid "Universal avatar uploaded to Gravatar.com"
msgstr "ユニバーサル・アバターが Gravatar.com にアップロードされました"

msgid "Identicon"
msgstr "Identicon"

msgid "Monster ID"
msgstr "Monster ID"

msgid "Wavatar"
msgstr "Wavatar"

msgid "8-bit style avatar"
msgstr "8 ビット・スタイル・アバター"

msgid "Missing Configuration"
msgstr "欠落している構成"

msgid "Type: @type"
msgstr "タイプ: @type"

msgid "Identicon, MonsterID, Retro, and Wavatar avatar generators."
msgstr "Identicon、MonsterID、Retro、および Wavatar アバター生成プログラム。"

