msgid "@style style will not display without the \"@field\" setting."
msgstr "Styl @style nie będzie wyświetlany bez ustawienia „@field”. "

msgid "About"
msgstr "O stronie"

msgid "The <a href=\":bootstrap\">Views Bootstrap module</a> adds styles to Views to output the results of a view as several common <a href=\":components\">Twitter Bootstrap</a> components."
msgstr "<a href=\":bootstrap\">Moduł Views Bootstrap</a> dodaje style do widoków, aby wyprowadzać wyniki widoku w postaci kilku wspólnych komponentów <a href=\":components\">Twitter Bootstrap</a>."

msgid "Uses"
msgstr "Używa"

msgid "<a href=\":views\">Create a view</a> using one of the following styles:"
msgstr "<a href=\":views\">Utwórz widok</a> przy użyciu jednego z następujących stylów:"

msgid "<a href=\":docs\">Accordion</a>"
msgstr "<a href=\":docs\">Element harmonijkowy</a>"

msgid "<a href=\":docs\">Cards</a>"
msgstr "<a href=\":docs\">Karty</a>"

msgid "<a href=\":docs\">Carousel</a>"
msgstr "<a href=\":docs\">Panel przewijany</a>"

msgid "<a href=\":docs\">Dropdown</a>"
msgstr "<a href=\":docs\">Lista rozwijana</a>"

msgid "<a href=\":docs\">Grid</a>"
msgstr "<a href=\":docs\">Siatka</a>"

msgid "<a href=\":docs\">Thumbnails</a>"
msgstr "<a href=\":docs\">Miniatury</a>"

msgid "<a href=\":docs\">Tables</a>"
msgstr "<a href=\":docs\">Tabele</a>"

msgid "<a href=\":docs\">Tabs</a>"
msgstr "<a href=\":docs\">Karty</a>"

msgid "<a href=\":docs\">Media object</a>"
msgstr "<a href=\":docs\">Obiekt multimedialny</a>"

msgid "<a href=\":docs\">List group</a>"
msgstr "<a href=\":docs\">Grupa list</a>"

msgid "Views Bootstrap"
msgstr "Views Bootstrap"

msgid "Views Twitter Bootstrap Components."
msgstr "Komponenty Twitter Bootstrap widoków."

msgid "Views"
msgstr "Widoki"

msgid "The Bootstrap accordion displays content in collapsible panels (<a href=\":docs\">see documentation</a>)."
msgstr "Harmonijka Bootstrap wyświetla treść w zwijalnych panelach (<a href=\":docs\">patrz dokumentacja</a>)."

msgid "Panel title field"
msgstr "Pole tytułu panelu"

msgid "Select the field that will be used as the accordion panel titles."
msgstr "Wybierz pole, które będzie używane jako tytuł panelu harmonijkowego."

msgid "Label field"
msgstr "Pole etykiety"

msgid "- None -"
msgstr "- Brak -"

msgid "Select the field that will be used as the label."
msgstr "Wybierz pole, które będzie używane jako etykieta."

msgid "Collapse Options"
msgstr "Opcje zwijania"

msgid "All Items Closed"
msgstr "Wszystkie elementy zamknięte"

msgid "First Item Open"
msgstr "Pierwszy element otwarty"

msgid "All Items Open"
msgstr "Wszystkie elementy otwarte"

msgid "Default panel state for collapse behavior."
msgstr "Domyślny stan panelu przy zwijaniu."

msgid "Bootstrap Accordion"
msgstr "Element harmonijkowy Bootstrap"

msgid "Displays rows in a Bootstrap Accordion."
msgstr "Służy do wyświetlania wierszy za pomocą komponentu Bootstrap Accordion (element harmonijkowy Bootstrap)."

msgid "Card title field"
msgstr "Pole tytułu karty"

msgid "Select the field that will be used for the card title."
msgstr "Wybierz pole, które będzie używane jako tytuł karty."

msgid "Card content field"
msgstr "Pole treści karty"

msgid "Select the field that will be used for the card content."
msgstr "Wybierz pole, które będzie używane na potrzeby treści karty."

msgid "Card image field"
msgstr "Pole obrazu karty"

msgid "Select the field that will be used for the card image."
msgstr "Wybierz pole, które będzie używane na potrzeby obrazu karty."

msgid "Custom card group class"
msgstr "Klasa grupy kart niestandardowych"

msgid "Additional classes to provide on the card group. Separated by a space."
msgstr "Dodatkowe klasy, które mają być dostępne w grupie kart. Rozdzielane spacjami."

msgid "Additional classes to provide on each card. Separated by a space."
msgstr "Dodatkowe klasy, które mają być dostępne na każdej karcie. Rozdzielane spacjami."

msgid "Bootstrap Cards"
msgstr "Karty programu startowego"

msgid "Displays rows in a Bootstrap Card Group layout"
msgstr "Wyświetla wiersze w układzie grupy kart startowych"

msgid "The Bootstrap carousel displays content as a slideshow (<a href=\":docs\">see documentation</a>)."
msgstr "Karuzela Bootstrap wyświetla treść jako pokaz slajdów (<a href=\":docs\">patrz dokumentacja</a>)."

msgid "<None>"
msgstr "<Brak>"

msgid "Interval"
msgstr "Interwał"

msgid "The amount of time to delay between automatically cycling an item. If false, carousel will not automatically cycle."
msgstr "Opóźnienie przy automatycznym przełączaniu pozycji. Jeśli jest ustawiona wartość Fałsz, panel przewijany nie będzie przełączał się automatycznie."

msgid "Show navigation"
msgstr "Pokaż nawigację"

msgid "Show indicators"
msgstr "Pokaż wskaźniki"

msgid "Pause on hover"
msgstr "Pouza po najechaniu myszką"

msgid "Pauses the cycling of the carousel on mouseenter and resumes the cycling of the carousel on mouseleave."
msgstr "Wstrzymuje przełączanie panelu przewijanego po zdarzeniu mouseenter i wznawia przełączanie panelu przewijanego po zdarzeniu mouseleave."

msgid "Wrap"
msgstr "Zawijaj"

msgid "The carousel should cycle continuously or have hard stops."
msgstr "Panel przewijany powinien się przełączać w sposób ciągły lub mieć zatrzymania twarde."

msgid "Columns"
msgstr "Kolumny"

msgid "The number of columns to include in the carousel."
msgstr "Liczba kolumn do uwzględnienia w karuzeli."

msgid "Breakpoints"
msgstr "Punkty zatrzymania"

msgid "The min-width breakpoint of the multicolumn carousel."
msgstr "Punkt zatrzymania minimalnej szerokości karuzeli wielokolumnowej."

msgid "Extra Small"
msgstr "Bardzo mały"

msgid "Small"
msgstr "Mały"

msgid "Medium"
msgstr "Średni"

msgid "Large"
msgstr "Duży"

msgid "Display"
msgstr "Prezentacja"

msgid "Select by fields"
msgstr "Wybierz według pól"

msgid "Display fields as row content"
msgstr "Wyświetl pola jako zawartość wiersza"

msgid "Displaying fields as row content will output the field rows as unformatted values within each carousel item."
msgstr "Wyświetlanie pól jako zawartości wierszy spowoduje utworzenie wierszy pól jako wartości niesformatowanych w obrębie każdej pozycji karuzeli."

msgid "Image"
msgstr "Obraz"

msgid "Title"
msgstr "Tytuł"

msgid "Description"
msgstr "Opis"

msgid "Bootstrap Carousel"
msgstr "Panel przewijany Bootstrap"

msgid "Displays rows in a Bootstrap Carousel."
msgstr "Służy do wyświetlania wierszy za pomocą komponentu Bootstrap Carousel (panel przewijany Bootstrap)."

msgid "The Bootstrap dropdown style displays a list of links in a drop-down menu format (<a href=\":docs\">see documentation</a>)."
msgstr "W stylu listy rozwijanej Bootstrap wyświetlana jest lista odsyłaczy w formacie rozwijanego menu (<a href=\":docs\">patrz dokumentacja</a>)."

msgid "Button text"
msgstr "Tekst przycisku"

msgid "Text label for the button that is the drop-down toggle."
msgstr "Etykieta tekstowa przycisku, który jest przełącznikiem listy rozwijanej."

msgid "Button class"
msgstr "Klasa przycisku"

msgid "Classes for the button that is the drop-down toggle."
msgstr "Klasy dla przycisku, który jest przełącznikiem listy rozwijanej."

msgid "Default"
msgstr "Domyślny"

msgid "Primary"
msgstr "Główny"

msgid "Success"
msgstr "Sukces"

msgid "Info"
msgstr "Informacja"

msgid "Warning"
msgstr "Ostrzeżenie"

msgid "Danger"
msgstr "Niebezpieczeństwo"

msgid "Wrapper class"
msgstr "Klasa elementu nadrzędnego"

msgid "The class to provide on the wrapper, outside the list."
msgstr "Klasa zastosowana dla elementu nadrzędnego dla listy."

msgid "List class"
msgstr "Klasa listy"

msgid "The class to provide on the list element itself."
msgstr "Klasa dostarczona na elemencie listy."

msgid "Bootstrap Dropdown"
msgstr "Lista rozwijana Bootstrap"

msgid "Displays rows in a Bootstrap Dropdown."
msgstr "Służy do wyświetlania wierszy na liście rozwijanej Bootstrap."

msgid "The Bootstrap grid displays content in a responsive, mobile first fluid grid (<a href=\":docs\">see documentation</a>)."
msgstr "Siatka Bootstrap wyświetla treść w reaktywnej siatce przeznaczonej przede wszystkim dla urządzeń mobilnych (<a href=\":docs\">patrz dokumentacja</a>)."

msgid "Alignment"
msgstr "Wyrównanie"

msgid "Horizontal"
msgstr "Poziomo"

msgid "Vertical"
msgstr "Pionowo"

msgid ""
"Horizontal alignment will place items starting in the upper left and moving right.\n"
"      Vertical alignment will place items starting in the upper left and moving down."
msgstr ""
"Wyrównanie w poziomie spowoduje umieszczenie pozycji, zaczynając od lewej górnej strony, a potem w prawo.\n"
"      Wyrównanie w pionie spowoduje rozpoczęcie rozmieszczania pozycji od lewego górnego rogu i kontynuowanie rozmieszczania pozycji w dół."

msgid "Default column classes"
msgstr "Domyślne klasy kolumny"

msgid "Add the default views column classes like views-col, col-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Dodaj domyślne klasy kolumn widoku, takie jak views-col, col-1 oraz clearfix do wyjścia. Możesz użyć tej opcji by szybko ograniczyć ilość znaczników, które widok domyślnie dostarcza, jednocześnie pamiętając że utrudni to dodawania styli CSS."

msgid "Custom column class"
msgstr "Własna klasa kolumny"

msgid "Additional classes to provide on each column. Separated by a space."
msgstr "Dodatkowe klasy do dołączenia do każdej z kolumn. Oddzielone spacją."

msgid "You may use field tokens from as per the \"Replacement patterns\" used in \"Rewrite the output of this field\" for all fields."
msgstr "Można używać wzorców podstawiania dla pól tak samo jak \"Wzorce podstawiania\" wykorzystywane w \"Modyfikuj wartość wyjściową pola\" dla wszystkich pól."

msgid "Default row classes"
msgstr "Domyślne klasy wiersza"

msgid "Adds the default views row classes like views-row, row-1 and clearfix to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS."
msgstr "Dodaje domyślne klasy wiersza, takie jak views-row, row-1 i clearfix, do danych wyściowych. Możesz skorzystać z tej opcji aby ograniczyć ilość znaczników HTML, które widok domyślnie dostarcza, kosztem utrudnienia formatowania za pomocą stylów CSS."

msgid "Custom row class"
msgstr "Własna klasa wiersza"

msgid "Additional classes to provide on each row. Separated by a space."
msgstr "Dodatkowe, oddzielone spacją klasy do dołączenia do każdego z wierszy."

msgid "Base number of columns"
msgstr "Podstawowa liczba kolumn"

msgid "all"
msgstr "wszystkie"

msgid "Choose the number of columns that views will wrap in a single row. This will be reflected in the HTML structure rendered regardless of the device size. If selecting \"all\" then use the alternative template."
msgstr "Wybierz liczbę kolumn, do której rzędy widoków będą zawijane. Ta opcja zostanie odzwierciedlona w generowanym kodzie HTML niezależnie od wielkości urządzenia. W przypadku wybrania opcji \"wszystko\" należy użyć szablonu alternatywnego."

msgid "Number of columns (col-@size)"
msgstr "Liczba kolumn (col-@size)"

msgid "This adds col-@size to the div."
msgstr "Powoduje dodanie elementu col-@size do znacznika div."

msgid "Bootstrap Grid"
msgstr "Siatka Bootstrap"

msgid "Displays rows in a Bootstrap Grid layout"
msgstr "Służy do wyświetlania wierszy w układzie Bootstrap Grid (siatka Bootstrap)."

msgid "The Bootstrap list group displays content in an unordered list with list group classes (<a href=\":docs\">see documentation</a>)."
msgstr "Lista pogrupowana Bootstrap wyświetla treść na nieuporządkowanej liście z klasami grup (<a href=\":docs\">patrz dokumentacja</a>)."

msgid "Set group field in panel heading"
msgstr "Ustaw pole grupy w nagłówku panelu"

msgid "Title field"
msgstr "Pole tytułu"

msgid "Select the field that will be used as the title."
msgstr "Wybierz pole, które będzie używane jako tytuł. "

msgid "Bootstrap List Group"
msgstr "Grupa list Bootstrap"

msgid "Displays rows in a Bootstrap List Group."
msgstr "Służy do wyświetlania wierszy za pomocą komponentu Bootstrap List Group (grupa list Bootstrap)."

msgid "The Bootstrap media object displays content with an image item lead with heading and text (<a href=\":docs\">see documentation</a>)."
msgstr "Obiekt multimedialny Bootstrap wyświetla treść z elementem obrazu poprzedzonym nagłówkiem i tekstem (<a href=\":docs\">patrz dokumentacja</a>)."

msgid "Heading field"
msgstr "Pole nagłówka"

msgid "Select the field that will be used as the media object heading. Exclude this field from display to prevent duplication."
msgstr "Wybierz pole, które będzie używane jako nagłówek obiektu multimedialnego. Wyklucz to pole z wyświetlania, aby zapobiec duplikowaniu informacji."

msgid "Image field"
msgstr "Pole obrazu"

msgid "Select the field that will be used as the media object image. Exclude this field from display to prevent duplication."
msgstr "Wybierz pole, które będzie używane jako obraz obiektu multimedialnego. Wyklucz to pole z wyświetlania, aby zapobiec duplikowaniu informacji."

msgid "Body field"
msgstr "Pole treści"

msgid "All fields that are not excluded from display will be shown as the body."
msgstr "Wszystkie pola, które nie są wykluczone z wyświetlania, będą wyświetlane jako treść."

msgid "Image Alignment"
msgstr "Wyrównanie obrazu"

msgid "Left"
msgstr "Lewo"

msgid "Right"
msgstr "Prawo"

msgid "Middle"
msgstr "Środek"

msgid "Align the media object image left or right."
msgstr "Wyrównaj obraz obiektu multimedialnego do lewej lub prawej strony."

msgid "Bootstrap Media Object"
msgstr "Obiekt multimedialny Bootstrap"

msgid "Displays rows in a Bootstrap Media Object."
msgstr "Służy do wyświetlania wierszy za pomocą komponentu Bootstrap Media Object (obiekt multimedialny Bootstrap)."

msgid "The Bootstrap panels displays content in a box with optional header and footer elements (<a href=\":docs\">see documentation</a>)."
msgstr "Panele Bootstrap wyświetlają treść w polu z opcjonalnymi elementami nagłówka i stopki (<a href=\":docs\">patrz dokumentacja</a>)."

msgid "Contextual class"
msgstr "Klasa kontekstowa"

msgid "<a href=\":docs\">see Bootstrap documentation</a>"
msgstr "<a href=\":docs\">patrz dokumentacja Bootstrap</a>"

msgid "Select the field that will be used as the panel heading titles."
msgstr "Wybierz pole, które będzie używane jako nagłówek panelu."

msgid "Panel footer field"
msgstr "Pole stopki panelu"

msgid "Select the field that will be used as the panel footer."
msgstr "Wybierz pole, które będzie używane jako stopka panelu."

msgid "Bootstrap Panels"
msgstr "Panele Bootstrap"

msgid "Displays rows in a Bootstrap Panel."
msgstr "Służy do wyświetlania wierszy na panelu Bootstrap."

msgid "The Bootstrap tabs displays content with tab titles linked to dynamically displayed content (<a href=\":docs\">see documentation</a>)."
msgstr "Karty Bootstrap wyświetlają treść jako tytuły kart połączone z dynamicznie wyświetlaną treścią (<a href=\":docs\">patrz dokumentacja</a>)."

msgid "Tab field"
msgstr "Pole karty"

msgid "Select the field that will be used as the tab."
msgstr "Wybierz pole, które będzie używane jako karta. "

msgid "Tab Type"
msgstr "Typ karty"

msgid "Tabs"
msgstr "Zakładki"

msgid "Pills"
msgstr "Kapsułki"

msgid "List"
msgstr "Lista"

msgid "Position of tabs"
msgstr "Pozycja kart"

msgid "Tabs/pills on the top"
msgstr "Karty/kapsułki na górze"

msgid "Tabs/pills on the left"
msgstr "Karty/kapsułki po lewej stronie"

msgid "Tabs/pills on the right"
msgstr "Karty/kapsułki po prawej stronie"

msgid "Tabs/pills on the bottom"
msgstr "Karty/kapsułki na dole"

msgid "Tabs/pills justified on the top"
msgstr "Karty/kapsułki wyrównane na górze"

msgid "Tabs/pills stacked"
msgstr "Karty/kapsułki ułożone w stos"

msgid "Fade Effect"
msgstr "Efekt pojawiania się"

msgid "Add a fade in effect when tabs clicked"
msgstr "Dodaj efekt pojawiania się po kliknięciu karty"

msgid "Bootstrap Tabs"
msgstr "Karty Bootstrap"

msgid "Displays rows in Bootstrap Tabs."
msgstr "Służy do wyświetlania wierszy za pomocą komponentu Bootstrap Tab (karta Bootstrap)."

msgid "The Bootstrap table style adds default Bootstrap table classes and optional classes (<a href=\":docs\">see documentation</a>)."
msgstr "Styl tabeli Bootstrap dodaje domyślne klasy i opcjonalne klasy tabel Bootstrap (<a href=\":docs\">patrz dokumentacja</a>)."

msgid "Responsive"
msgstr "Responsywny"

msgid "To make a table scroll horizontally on small devices."
msgstr "Służy do poziomego przewijania tabeli na małych urządzeniach."

msgid "Bootstrap styles"
msgstr "Style środowiska Bootstrap"

msgid "Striped"
msgstr "Paski"

msgid "Bordered"
msgstr "Krawędzie"

msgid "Hover"
msgstr "Wyróżnianie po wskazaniu myszą"

msgid "Condensed"
msgstr "Skondensowany"

msgid "Caption for the table"
msgstr "Tytuł tabeli"

msgid "A title semantically associated with your table for increased accessibility."
msgstr "Tytuł semantycznie powiązany z tabelą w celu zwiększenia dostępności."

msgid "Table details"
msgstr "Szczegóły tabeli"

msgid "Summary title"
msgstr "Tytuł podsumowania"

msgid "Table description"
msgstr "Opis tabeli"

msgid "Provide additional details about the table to increase accessibility."
msgstr "Podaj dodatkowe informacje na temat tabeli, aby zwiększyć dostępność."

msgid "Bootstrap Table"
msgstr "Tabela Bootstrap"

msgid "Displays rows in a Bootstrap table."
msgstr "Służy do wyświetlania wierszy za pomocą wtyczki Bootstrap Table (tabela Bootstrap)."

msgid "The Bootstrap thumbnails extends the grid display with the thumbnail component to showcase linked images (<a href=\":docs\">see documentation</a>)."
msgstr "Miniatury Bootstrap uzupełniają siatkę o miniatury prezentujące obrazy wskazane przez odsyłacze (<a href=\":docs\">patrz dokumentacja</a>)."

msgid "Bootstrap Thumbnails"
msgstr "Miniatury Bootstrap"

msgid "Displays rows in a Bootstrap Grid layout with thumbnails"
msgstr "Służy do wyświetlania wierszy w układzie siatki Bootstrap."

msgid "Previous"
msgstr "Poprzednie"

msgid "Next"
msgstr "Dalej"

