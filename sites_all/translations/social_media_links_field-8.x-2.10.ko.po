msgid "Social Media Links Field"
msgstr "소셜 미디어 링크 필드"

msgid "The module provides a field type to capture social media profiles."
msgstr "모듈은 소셜 미디어 프로파일을 캡처하기 위해 필드 유형을 제공합니다."

msgid "Platform"
msgstr "플랫폼"

msgid "Appearance"
msgstr "모양"

msgid "Orientation"
msgstr "방향"

msgid "vertical"
msgstr "수직"

msgid "horizontal"
msgstr "가로"

msgid "Show name"
msgstr "이름 표시"

msgid "Show the platform name next to the icon."
msgstr "아이콘 옆에 플랫폼 이름을 표시합니다."

msgid "Link attributes"
msgstr "링크 속성"

msgid "Default target"
msgstr "기본 대상"

msgid "Remove target attribute"
msgstr "대상 속성 제거"

msgid "Open in a new browser window or tab (_blank)"
msgstr "새 브라우저 창 또는 탭에서 열기(_blank)"

msgid "Open in the current window (_self)"
msgstr "현재 창에서 열기(_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "링크가 있는 프레임의 상위인 프레임에서 열기(_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "모든 프레임을 취소하고 전체 브라우저 창에서 열기(_top)"

msgid "Default rel"
msgstr "기본 rel"

msgid "Remove rel attribute"
msgstr "rel 속성 제거"

msgid "Set nofollow"
msgstr "nofollow 설정"

msgid "Orientation: @orientation"
msgstr "방향: @orientation"

msgid "Yes"
msgstr "예"

msgid "No"
msgstr "아니오"

msgid "Show name: @show_name"
msgstr "이름 표시: @show_name"

msgid "Default"
msgstr "기본값"

msgid "Value"
msgstr "값"

msgid "Platform Values"
msgstr "플랫폼 값"

msgid "Icon Style"
msgstr "아이콘 스타일"

msgid "Description"
msgstr "설명"

msgid "Weight"
msgstr "가중치"

msgid "Platforms"
msgstr "플랫폼"

msgid "The platforms that are allowed to be used in this field. Select none to allow all platforms."
msgstr "이 필드에서 사용이 허용된 플랫폼입니다. 모든 플랫폼을 허용하려면 없음을 선택하십시오."

msgid "The description is used for the title and WAI-ARIA attribute."
msgstr "제목 및 WAI-ARIA 속성에 사용되는 설명입니다."

msgid "Find / Follow us on %platform"
msgstr "%platform에서 찾기/따르기"

msgid "Weight for type @type"
msgstr "@type 유형의 가중치"

msgid "Handle links to social media profiles."
msgstr "소셜 미디어 프로파일에 대한 링크를 다룹니다."

msgid "List with all available platforms"
msgstr "사용 가능한 모든 플랫폼 나열"

msgid "One available platform (selectable)"
msgstr "하나의 사용 가능한 플랫폼(선택 가능)"

