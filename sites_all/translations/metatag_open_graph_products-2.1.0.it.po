msgid "About"
msgstr "Informazioni"

msgid "Provides additional Open Graph Protocol meta tags for describing products."
msgstr "Fornisce ulteriori metatag Open Graph Protocol per la descrizione dei prodotti."

msgid "Metatag: Open Graph Products"
msgstr "Metatag: Prodotti Open Graph"

msgid "SEO"
msgstr "SEO"

msgid "Open Graph Product: Price availability"
msgstr "Prodotto Open Graph: disponibilità del prezzo"

msgid "Open Graph Product: Product condition"
msgstr "Prodotto Open Graph: condizione del prodotto"

msgid "Open Graph Product: Price amount"
msgstr "Prodotto Open Graph: Importo"

msgid "Open Graph Product: Price currency"
msgstr "Prodotto Open Graph: Valuta del prezzo"

msgid "Open Graph Product: Retailer Item ID"
msgstr "Prodotto Open Graph: ID articolo rivenditore"

msgid "Open Graph - Products"
msgstr "Open Graph - Prodotti"

msgid "These <a href='https://ogp.me/'>Open Graph meta tags</a> are for describing products.<br><br>The Facebook <a href='https://developers.facebook.com/tools/debug/'>Sharing Debugger</a> lets you preview how your content will look when it's shared to Facebook and debug any issues with your Open Graph tags."
msgstr "Questi <a href='https://ogp.me/'>metatag Open Graph</a> sono per descrivere i prodotti.<br><br>Il <a href='https://developers.facebook.com/tools/debug/'>Sharing Debugger</a> di Facebook consente di visualizzare in anteprima l'aspetto del contenuto quando viene condiviso su Facebook ed eseguire il debug di eventuali problemi con i tag Open Graph."

msgid "Product availability"
msgstr "Disponibilità del prodotto"

msgid "The availability of the product."
msgstr "La disponibilità del prodotto."

msgid "Product condition"
msgstr "Condizione del prodotto"

msgid "The condition of the product."
msgstr "La condizione del prodotto."

msgid "Product price amount"
msgstr "Importo del prodotto"

msgid "The price amount of the product."
msgstr "L'importo del prodotto."

msgid "Product price currency"
msgstr "Valuta del prezzo del prodotto"

msgid "The price currency of the product."
msgstr "La valuta del prezzo del prodotto."

msgid "Retailer Item ID"
msgstr "ID articolo rivenditore"

msgid "The ID of the product as provided by the retailer."
msgstr "L'ID del prodotto come fornito dal rivenditore."

