msgid "Schema.org Book"
msgstr "Schema.org Kitabı"

msgid "Adds Schema.org/Book to the JSON LD array."
msgstr "Schema.org/Kitabı JSON LD dizisine ekler."

msgid "SEO"
msgstr "SEO"

msgid "author"
msgstr "yazar"

