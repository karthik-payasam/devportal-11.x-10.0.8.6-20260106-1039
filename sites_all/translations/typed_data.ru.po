msgid "Typed Data"
msgstr "Типизированные данные"

msgid "Extends the core Typed Data API with new APIs and features."
msgstr "Предлагает новые API и функции для расширения Typed Data API. "

msgid "Missing arguments for filter %filter_id"
msgstr "Отсутствуют аргументы для фильтра %filter_id "

msgid "Entity machine names:"
msgstr "Имена компьютеров объектов:"

msgid "Global context variables:"
msgstr "Глобальные переменные контекста:"

msgid "Available TypedData data types:"
msgstr "Доступные типы данных TypedData:"

msgid "Text"
msgstr "Текст"

msgid "The count filter counts the number of characters in the input string."
msgstr "Фильтр count подсчитывает число символов в строке ввода."

msgid "Applies a default value if there is no value."
msgstr "Применяет значение по умолчанию, если не указано значение."

msgid "Provides the URL of an entity."
msgstr "Предоставляет URL сущности."

msgid "Unkown date format %format given."
msgstr "Неизвестный формат даты %format. "

msgid "If a custom date format is supplied, 'custom' must be passed as date format."
msgstr "Если указан пользовательский формат даты, то в качестве формата даты необходимо передать значение 'custom'. "

msgid "If 'custom' is given as date type, a custom date formatting string must be provided; e.g., 'Y-m-d H:i:s'."
msgstr "Для формата даты 'custom' необходимо указать строку формата даты, такую как 'Y-m-d H:i:s'."

msgid "Formats a date, using a configured date type or a custom date format string."
msgstr "Форматирует дату с учетом настроенного типа даты или пользовательской строки формата даты. "

msgid "The format_text filter passes the text through the given filter."
msgstr "Фильтр format_text пропускает текст через заданный фильтр."

msgid "Converts a string to lower case."
msgstr "Преобразует строку в строку в нижнем регистре."

msgid "The striptags filter strips SGML/XML tags and replace adjacent whitespace by one space."
msgstr "Фильтр striptags вырезает теги SGML/XML и заменяет несколько расположенных рядом пробелов на один."

msgid "The trim filter removes whitespace from both the beginning and the end of an input string."
msgstr "Фильтр trim удаляет пробелы в начале и в конце строки ввода."

msgid "The upper filter converts the entire input string to upper case."
msgstr "Фильтр upper filter преобразует все символы строки ввода в заглавные."

msgid "No widget exists for this data type."
msgstr "Для этого типа данных нет виджета."

msgid "The field %field_label consists of the data type %data_type which cannot be input or a widget for this data type is not implemented yet."
msgstr "Поле %field_label состоит из типа данных %data_type, который не может быть использован в качестве входного, либо виджет для этого типа данных еще не реализован."

msgid "Label"
msgstr "Метка"

msgid "Broken widget"
msgstr "Неработающий виджет"

msgid "A widget for everything that cannot be input or if a widget for a data type is not yet implemented."
msgstr "Виджет для любого содержимого, которое не может быть входными данными, либо еще нереализованный виджет для типа данных."

msgid "currently in daylight saving mode"
msgstr "в режиме перехода на летнее время"

msgid "not in daylight saving mode"
msgstr "не в режиме перехода на летнее время"

msgid "Timezone : %timezone %daylight_saving."
msgstr "Часовой пояс: %timezone %daylight_saving."

msgid "Start date"
msgstr "Дата начала"

msgid "End date"
msgstr "Дата окончания"

msgid "Description"
msgstr "Описание"

msgid "The @title end date cannot be before the start date"
msgstr "Дата окончания \"@title\" не может быть раньше даты начала"

msgid "Datetime Range"
msgstr "Диапазон даты и времени"

msgid "A datetime range input widget, containing two datetime values, for the start and end of the range."
msgstr "Виджет ввода временного периода, содержащий два значения даты и времени: начальное и конечное."

msgid "Datetime"
msgstr "Дата"

msgid "A datetime input widget."
msgstr "Виджет ввода даты и времени."

msgid "Empty option label"
msgstr "Метка пустой опции"

msgid "Allows overriding the label of the empty option"
msgstr "Позволяет переопределить метку пустой опции"

msgid "Select"
msgstr "Выбрать"

msgid "A simple select box."
msgstr "Простой переключатель."

msgid "Placeholder value"
msgstr "Значение-заменитель"

msgid "Input field size"
msgstr "Размер поля ввода"

msgid "Maximum text length"
msgstr "Максимальная длина текста"

msgid "Text input"
msgstr "Поле ввода текста"

msgid "A simple, one-line text input widget."
msgstr "Простой однострочный виджет для ввода текста."

msgid "Number of rows in the text box"
msgstr "Число строк в текстовом поле"

msgid "Number of columns in the text box"
msgstr "Число столбцов в текстовом поле"

msgid "Controls whether the text area is resizable"
msgstr "Управляет возможностью изменения размера области текста"

msgid "Allowed values are \"none\", \"vertical\", \"horizontal\", or \"both\"."
msgstr "Разрешенные значения: \"нет\", \"по вертикали\", \"по горизонтали\", \"во всех направлениях\"."

msgid "Textarea"
msgstr "Текстовая область"

msgid "A multi-line text input widget."
msgstr "Многострочный виджет для ввода текста."

