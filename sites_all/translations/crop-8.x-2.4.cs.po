msgstr "Uživatelské ID autora aktuální revize."

msgid "Revision Log"
msgstr "Protokol revizí"

msgid "The log entry explaining the changes in this revision."
msgstr "Položka protokolu vysvětlující změny v této revizi."

msgid "Crop"
msgstr "Oříznout"

msgid "Are you sure you want to delete the crop type %type?"
msgstr "Opravdu chcete odstranit typ oříznutí %type?"

msgid "The crop type %name has been deleted."
msgstr "Typ oříznutí %name byl odstraněn."

msgid "Deleted crop type %name."
msgstr "Typ oříznutí %name byl odstraněn."

msgid "%type is used by 1 piece of content on your site. You can not remove this content type until you have removed all of the %type content."
msgid_plural "%type is used by @count pieces of content on your site. You may not remove %type until you have removed all of the %type content."
msgstr[0] "%type je používán jednou položkou obsahu na vašem webu. Tento typ obsahu nemůžete odebrat, dokud neodeberete veškerý obsah %type. "
msgstr[1] "%type je používán @count položkami obsahu na vašem webu. %type nemůžete odebrat, dokud neodeberete veškerý obsah %type."
msgstr[2] "%type je používán @count položkami obsahu na vašem webu. %type nemůžete odebrat, dokud neodeberete veškerý obsah %type."

msgid "Edit %label crop type"
msgstr "Upravit typ oříznutí %label"

msgid "The human-readable name of this crop type. This name must be unique."
msgstr "Název čitelný pro člověka pro tento typ oříznutí. Tento název musí být jedinečný."

msgid "A unique machine-readable name for this crop type. It must only contain lowercase letters, numbers, and underscores."
msgstr "Jedinečný název pro tento typ oříznutí, který je čitelný pro počítač. Smí obsahovat pouze malá písmena, číslice a podtržítka."

msgid "Describe this crop type."
msgstr "Popište tento typ oříznutí."

msgid "Set an aspect ratio <b>eg: 16:9</b> or leave this empty for arbitrary aspect ratio"
msgstr "Nastavte poměr stran <b>např.: 16 : 9</b>, nebo nechte toto nastavení prázdné, aby bylo možné použít libovolný poměr stran"

msgid "Soft limit"
msgstr "Měkký limit"

msgid "Define crop size soft limit. Warning will be displayed if crop smaller than that is selected."
msgstr "Definujte měkký limit velikosti oříznutí. Zobrazí se varování, bude-li oříznutí menší než vybraná hodnota."

msgid "Limit for width."
msgstr "Limit pro šířku."

msgid "Limit for height."
msgstr "Limit pro výšku."

msgid "Hard limit"
msgstr "Pevný limit"

msgid "Define crop size hard limit. User is not allowed to make a smaller selection than defined here."
msgstr "Definujte tvrdý limit velikosti oříznutí. Uživateli není dovoleno provést menší než zde definovaný výběr."

msgid "Limit for width"
msgstr "Limit pro šířku"

msgid "Save crop type"
msgstr "Uložit typ oříznutí"

msgid "Delete crop type"
msgstr "Odstranit typ oříznutí"

msgid "The crop type %name has been updated."
msgstr "Typ oříznutí %name byl aktualizován."

msgid "The crop type %name has been added."
msgstr "Typ oříznutí %name byl přidán."

msgid "View"
msgstr "Zobrazit"

msgid "Added crop type %name."
msgstr "Byl přidán typ oříznutí %name."

msgid "File"
msgstr "Soubor"

msgid "Provides crop integration for core files."
msgstr "Poskytuje integraci oříznutí pro soubory core."

msgid "Provides crop integration for media."
msgstr "Poskytuje integraci oříznutí pro média."

msgid "Crop type to be used for the image style."
msgstr "Typ oříznutí, který má být použit pro styl obrázku."

msgid "- Select a Provider -"
msgstr "- Vybrat poskytovatele -"

msgid "The name of automatic crop provider to use if crop is not set for an image."
msgstr "Název automatického poskytovatele oříznutí, který má být použit, není-li pro obrázek nastaveno oříznutí."

msgid "Manual image crop failed due to misconfigured crop type on %path."
msgstr "Ruční oříznutí obrázku se nezdařilo kvůli nesprávně nakonfigurovanému typu oříznutí v %path."

msgid "Manual image crop failed using the %toolkit toolkit on %path (%mimetype, %width x %height)"
msgstr "Ruční oříznutí obrázku se nezdařilo s použitím sady nástrojů %toolkit v %path (%mimetype, %width x %height)"

msgid "Manual crop"
msgstr "Ruční oříznutí"

msgid "Applies manually provided crop to the image."
msgstr "Provede ručně zadané oříznutí obrázku."

