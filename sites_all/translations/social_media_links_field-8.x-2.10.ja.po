msgid "Social Media Links Field"
msgstr "ソーシャル・メディア・リンク・フィールド"

msgid "The module provides a field type to capture social media profiles."
msgstr "このモジュールは、ソーシャル・メディア・プロファイルをキャプチャーするためのフィールド・タイプを提供します。"

msgid "Platform"
msgstr "プラットフォーム"

msgid "Appearance"
msgstr "外観"

msgid "Orientation"
msgstr "方向"

msgid "vertical"
msgstr "垂直 (vertical)"

msgid "horizontal"
msgstr "水平"

msgid "Show name"
msgstr "名前の表示"

msgid "Show the platform name next to the icon."
msgstr "アイコンの横にプラットフォーム名を表示します。"

msgid "Link attributes"
msgstr "リンク属性"

msgid "Default target"
msgstr "デフォルト・ターゲット"

msgid "Remove target attribute"
msgstr "ターゲット属性の削除"

msgid "Open in a new browser window or tab (_blank)"
msgstr "新しいブラウザー・ウィンドウまたはタブで開く (_blank)"

msgid "Open in the current window (_self)"
msgstr "現行ウィンドウで開く (_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "リンクが含まれているフレームより上位のフレームで開く (_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "すべてのフレームをキャンセルし、フル・ブラウザー・ウィンドウで開く (_top)"

msgid "Default rel"
msgstr "デフォルトの rel"

msgid "Remove rel attribute"
msgstr "rel 属性の削除"

msgid "Set nofollow"
msgstr "nofollow に設定"

msgid "Orientation: @orientation"
msgstr "方向: @orientation"

msgid "Yes"
msgstr "はい"

msgid "No"
msgstr "いいえ"

msgid "Show name: @show_name"
msgstr "名前の表示: @show_name"

msgid "Default"
msgstr "Default"

msgid "Value"
msgstr "値"

msgid "Platform Values"
msgstr "プラットフォーム値"

msgid "Icon Style"
msgstr "アイコン・スタイル"

msgid "Description"
msgstr "説明"

msgid "Weight"
msgstr "ウェイト"

msgid "Platforms"
msgstr "プラットフォーム"

msgid "The platforms that are allowed to be used in this field. Select none to allow all platforms."
msgstr "このフィールドで使用が許可されているプラットフォーム。 すべてのプラットフォームを許可するには、何も選択しません。"

msgid "The description is used for the title and WAI-ARIA attribute."
msgstr "この説明は、タイトルと WAI-ARIA 属性に使用されます。"

msgid "Find / Follow us on %platform"
msgstr "%platform で検索/フォロー"

msgid "Weight for type @type"
msgstr "タイプ @type の重み"

msgid "Handle links to social media profiles."
msgstr "ソーシャル・メディア・プロファイルへのリンクを処理します。"

msgid "List with all available platforms"
msgstr "使用可能なすべてのプラットフォームを含むリスト"

msgid "One available platform (selectable)"
msgstr "1 つの使用可能なプラットフォーム (選択可能)"

