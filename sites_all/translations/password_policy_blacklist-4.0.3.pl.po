msgid "Password Blacklist Policy"
msgstr "Strategia niedozwolonych haseł"

msgid "Create a blacklist of phrases that cannot be used in passwords."
msgstr "Utwórz listę niedozwolonych fraz, których nie można używać w hasłach."

msgid "Security"
msgstr "Zabezpieczenia"

msgid "Blacklist"
msgstr "Czarna lista"

msgid "Password"
msgstr "Hasło"

msgid "Match substrings"
msgstr "Dopasuj podłańcuchy"

msgid "There are restricted terms in your password. Please modify your password."
msgstr "To są terminy, które nie są dozwolone w haśle. Zmodyfikuj swoje hasło."

msgid "Your password is on the blacklist. Please choose a different password."
msgstr "Twoje hasło znajduje się na liście niedozwolonych. Wybierz inne hasło."

msgid "Also disallow passwords containing blacklisted passwords"
msgstr "Nie zezwalaj również na hasła zawierające hasła na liście niedozwolonych"

msgid "Blacklisted passwords"
msgstr "Niedozwolone hasła"

msgid "Password cannot be a member of this list, ignoring case. Enter one password per line."
msgstr "Hasło nie może być elementem tej listy, niezależnie od wielkości liter. Wpisz jedno hasło w wierszu."

msgid "Password must not contain any restricted words or phrases."
msgstr "Hasło nie może zawierać żadnych zastrzeżonych słów ani fraz."

msgid "Password must not be on the blacklist."
msgstr "Hasło nie może znajdować się na liście niedozwolonych."

msgid "Password Blacklist"
msgstr "Lista niedozwolonych haseł"

msgid "Password cannot match certain disallowed passwords"
msgstr "Hasło nie może być zgodne z niektórymi niedozwolonymi hasłami"

msgid "Your password contains restricted words or phrases."
msgstr "Hasło zawiera niedozwolone słowa lub frazy."

