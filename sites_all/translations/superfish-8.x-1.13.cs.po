msgid "None"
msgstr "Není"

msgid "Vertical"
msgstr "Svislý"

msgid "Horizontal"
msgstr "Vodorovný"

msgid "Diagonal"
msgstr "Diagonála"

msgid "About Superfish"
msgstr "O modulu Superfish"

msgid "<a href=\"@url_module\">Superfish module</a> integrates <a href=\"@url_library\">jQuery Superfish</a> plugin to your Drupal menu blocks. Please refer to the module <a href=\"@url_documentation\">documentation</a> for more information."
msgstr "<a href=\"@url_module\">Modul Superfish</a> integruje modul plug-in <a href=\"@url_library\">jQuery Superfish</a> do bloků nabídky Drupal. Další informace naleznete v <a href=\"@url_documentation\">dokumentaci</a> k modulu."

msgid "In order to use Superfish, go to the <a href=\"@block\">Block layout</a> page and use any of the \"Place block\" buttons to create a Superfish block."
msgstr "Chcete-li použít modul Superfish, přejděte na stránku <a href=\"@block\">Rozvržení bloku</a> a pomocí libovolného tlačítka \"Umístit blok\" vytvořte blok Superfish."

msgid "Superfish library is missing. Please refer to the <a href=\"@documentation\">plugin documentation</a> for how you can fix this issue; Once done, go to the <a href=\"@block\">Block layout</a> page and use any of the \"Place block\" buttons to create a Superfish block."
msgstr "Chybí knihovna Superfish. Informace o tom, jak tento problém opravit, naleznete v <a href=\"@documentation\">dokumentaci k modulu plug-in</a>. Po dokončení přejděte na stránku <a href=\"@block\">Rozvržení bloku</a> a pomocí libovolného tlačítka \"Umístit blok\" vytvořte blok Superfish."

msgid "If there was no Superfish block in the \"Place block\" form, go to the <a href=\"@performance\">Performance</a> page and clear the cache once."
msgstr "Pokud ve formuláři \"Umístit blok\" nebyl žádný blok Superfish, přejděte na stránku <a href=\"@performance\">Výkon</a> a vymažte mezipaměť."

msgid "Superfish library"
msgstr "Knihovna Superfish"

msgid "Inaccessible"
msgstr "Nedostupná"

msgid "Cannot access the Superfish library directory; perhaps because its permissions and/or ownership are not set up correctly."
msgstr "Nelze získat přístup k adresáři knihovny Superfish. Možná proto, že jeho oprávnění anebo vlastnictví nejsou správně nastaveny."

msgid "Unknown version"
msgstr "Neznámá verze"

msgid "Cannot determine the version of your Superfish library."
msgstr "Nelze určit verzi knihovny superfish."

msgid "Not supported"
msgstr "Nepodporováno"

msgid "The Superfish library requires an update. You can find the update instructions on :url."
msgstr "Knihovna Superfish vyžaduje aktualizaci. Pokyny k aktualizaci najdete na adrese :url."

msgid "Installed; at @location"
msgstr "Instalováno; na @location"

msgid "Not installed"
msgstr "Neinstalováno"

msgid "Please download the Superfish library from :url."
msgstr "Stáhněte si prosím knihovnu Superfish z adresy :url."

msgid "Superfish"
msgstr "Superfish"

msgid "Adds jQuery Superfish plugin to menu blocks."
msgstr "Přidá modul plug-in jQuery Superfish do bloků nabídky."

msgid "User interface"
msgstr "Uživatelské rozhraní"

msgid "Block settings"
msgstr "Nastavení bloku"

msgid "Default"
msgstr "Výchozí"

msgid "Horizontal (single row)"
msgstr "Vodorovný (jeden řádek)"

msgid "Menu type"
msgstr "Typ nabídky"

msgid "Horizontal (double row)"
msgstr "Vodorovný (dvojitý řádek)"

msgid "Vertical (stack)"
msgstr "Svislý (zásobník)"

msgid "Style"
msgstr "Styl"

msgid "Black"
msgstr "Černá"

msgid "Blue"
msgstr "Modrá"

msgid "Coffee"
msgstr "Káva"

msgid "White"
msgstr "Bílá"

msgid "Add arrows to parent menus"
msgstr "Přidat šipky do nadřízených nabídek"

msgid "Drop shadows"
msgstr "Umístit stíny"

msgid "jQuery Easing plugin is not installed."
msgstr "Modul plug-in jQuery Easing není nainstalován."

msgid "The plugin provides a handful number of animation effects, they can be used by uploading the 'jquery.easing.js' file to the libraries directory within the 'easing' directory (for example: libraries/easing/jquery.easing.js). Refresh this page after the plugin is uploaded, this will make more effects available in the above list."
msgstr "Modul plug-in poskytuje několik efektů animace, lze je použít odesláním souboru 'jquery.easing.js' do adresáře knihoven v adresáři 'easing' (například: libraries/easing/jquery.easing.js). Aktualizujte tuto stránku po odeslání modulu plug-in, tím bude ve výše uvedeném seznamu k dispozici více efektů."

msgid "Slide-in effect"
msgstr "Posuvný efekt"

msgid "Superfish plugins"
msgstr "Moduly plug-in Superfish"

msgid "Relocates sub-menus when they would otherwise appear outside the browser window area."
msgstr "Přemístí podnabídky, pokud by se jinak objevily mimo oblast okna prohlížeče."

msgid "enabled"
msgstr "povoleno"

msgid "jQuery Supposition"
msgstr "jQuery Supposition"

msgid "Prevents accidental firing of animations by waiting until the user's mouse slows down enough, hence determinig user's <em>intent</em>."
msgstr "Zabraňuje náhodnému spuštění animací tím, že čeká, až se myš uživatele dostatečně zpomalí, a tudíž určí <em>záměr</em> uživatele."

msgid "jQuery hoverIntent"
msgstr "jQuery hoverIntent"

msgid "<strong>sf-Touchscreen</strong> provides touchscreen compatibility."
msgstr "<strong>sf-Touchscreen</strong> poskytuje kompatibilitu s dotykovou obrazovkou."

msgid "The first click on a parent hyperlink shows its children and the second click opens the hyperlink."
msgstr "První klepnutí na nadřízený hypertextový odkaz zobrazí jeho podřízené prvky a druhé klepnutí otevře hypertextový odkaz."

msgid "sf-Touchscreen"
msgstr "sf-Touchscreen"

msgid "Disable"
msgstr "Zakázat"

msgid "Enable jQuery sf-Touchscreen plugin for this menu."
msgstr "Povolte modul plug-in jQuery sf-Touchscreen pro tuto nabídku."

msgid "Enable jQuery sf-Touchscreen plugin for this menu depending on the user's Web browser <strong>window width</strong>."
msgstr "Povolte modul plug-in jQuery sf-Touchscreen pro tuto nabídku v závislosti na <strong>šířce okna</strong> webového prohlížeče uživatele."

msgid "Enable jQuery sf-Touchscreen plugin for this menu depending on the user's Web browser <strong>user agent</strong>."
msgstr "Povolte modul plug-in jQuery sf-Touchscreen pro tuto nabídku v závislosti na <strong>agentovi uživatele</strong>webového prohlížeče uživatele."

msgid "Hiding the sub-menu on the second tap, adding cloned parent links to the top of sub-menus as well."
msgstr "Skrytí podnabídky při druhém klepnutí a přidání klonovaných nadřízených odkazů také do horní části podnabídek."

msgid "Using this plugin, the first click or tap will expand the sub-menu, here you can choose what a second click or tap should do."
msgstr "Při použití tohoto modulu plug-in první kliknutí nebo klepnutí rozbalí podnabídku, kde si můžete vybrat, co by mělo druhé kliknutí nebo klepnutí dělat."

msgid "Opening the parent menu item link on the second tap."
msgstr "Otevření odkazu na nadřízenou položku nabídky při druhém ťuknutí."

msgid "Hiding the sub-menu on the second tap."
msgstr "Skrytí podnabídky při druhém ťuknutí."

msgid "sf-Touchscreen will be enabled only if the width of user's Web browser window is smaller than the below value."
msgstr "sf-Touchscreen bude povolen pouze v případě, že je šířka okna webového prohlížeče uživatele menší než níže uvedená hodnota."

msgid "Please note that in most cases such a meta tag is necessary for this feature to work properly:"
msgstr "Vezměte prosím na vědomí, že ve většině případů je taková metaznačka nezbytná, aby tato funkce fungovala správně:"

msgid "Window width settings"
msgstr "Nastavení šířky okna"

msgid "Also known as \"Breakpoint\"."
msgstr "Také známé jako \"zarážka\"."

msgid "pixels"
msgstr "pixely"

msgid "User agent settings"
msgstr "Nastavení agenta uživatele"

msgid "Use the pre-defined list of the <strong>user agents</strong>."
msgstr "Použijte předdefinovaný seznam <strong>agentů uživatelů</strong>."

msgid "Recommended"
msgstr "Doporučeno"

msgid "Use the custom list of the <strong>user agents</strong>."
msgstr "Použijte vlastní seznam <strong>agentů uživatelů</strong>."

msgid "UA string of the current Web browser:"
msgstr "Řetězec agentů uživatelů aktuálního webového prohlížeče:"

msgid "Could be partial or complete. (Asterisk separated)"
msgstr "Může být částečný nebo úplný. (oddělené hvězdičkou)"

msgid "empty"
msgstr "prázdný"

msgid "Examples"
msgstr "Příklady"

msgid "Custom list of the user agents"
msgstr "Vlastní seznam agentů uživatelů"

msgid "Client-side (JavaScript)"
msgstr "Na straně klienta (JavaScript)"

msgid "<strong>User agent</strong> detection method"
msgstr "Metoda detekce <strong>agenta uživatele</strong>"

msgid "Server-side (PHP)"
msgstr "Na straně serveru (PHP)"

msgid "sf-Smallscreen"
msgstr "sf-Smallscreen"

msgid "<strong>sf-Smallscreen</strong> provides small-screen compatibility for your menus."
msgstr "<strong>sf-Smallscreen</strong> poskytuje kompatibilitu s malými obrazovkami pro vaše nabídky."

msgid "Enable jQuery sf-Smallscreen plugin for this menu depending on the user's Web browser <strong>window width</strong>."
msgstr "Povolte modul plug-in jQuery sf-Smallscreen pro tuto nabídku v závislosti na <strong>šířce okna</strong> webového prohlížeče uživatele."

msgid "Enable jQuery sf-Smallscreen plugin for this menu."
msgstr "Povolte modul plug-in jQuery sf-Smallscreen pro tuto nabídku."

msgid "Enable jQuery sf-Smallscreen plugin for this menu depending on the user's Web browser <strong>user agent</strong>."
msgstr "Povolte modul plug-in jQuery sf-Smallscreen pro tuto nabídku v závislosti na <strong>agentovi uživatele</strong>webového prohlížeče uživatele."

msgid "sf-Smallscreen will be enabled only if the width of user's Web browser window is smaller than the below value."
msgstr "sf-Smallscreen bude povolen pouze v případě, že je šířka okna webového prohlížeče uživatele menší než níže uvedená hodnota."

msgid "Convert the menu to an accordion menu."
msgstr "Převeďte nabídku na skládací nabídku."

msgid "Select a type"
msgstr "Vyberte typ"

msgid "Convert the menu to a &lt;select&gt; element."
msgstr "Převeďte nabídku na prvek &lt;select&gt;."

msgid "&lt;select&gt; settings"
msgstr "Nastavení &lt;select&gt;"

msgid "By default the first item in the &lt;select&gt; element will be the name of the parent menu or the title of this block, you can change this by setting a custom title."
msgstr "Standardně bude první položkou v prvku &lt;select&gt; název nadřízené nabídky nebo název tohoto bloku, můžete to změnit nastavením vlastního názvu."

msgid "Example"
msgstr "Příklad"

msgid "Main Menu"
msgstr "Hlavní nabídka"

msgid "&lt;select&gt; title"
msgstr "Název &lt;select&gt;"

msgid "Add <em>selected</em> attribute to the &lt;option&gt; element with the class <strong>active</strong> ."
msgstr "Přidejte <em>vybraný</em> atribut do prvku &lt;option&gt; se třídou <strong>active</strong>."

msgid "Makes pre-selected the item linked to the active page when the page loads."
msgstr "Při načtení stránky vytvoří předem vybranou položku propojenou s aktivní stránkou."

msgid "More"
msgstr "Více"

msgid "Copy the main &lt;ul&gt; classes to the &lt;select&gt;."
msgstr "Zkopírujte hlavní třídy &lt;ul&gt; do &lt;select&gt;."

msgid "disabled"
msgstr "zakázáno"

msgid "Comma separated"
msgstr "Oddělené čárkami"

msgid "Exclude these classes from the &lt;select&gt; element"
msgstr "Vyloučit tyto třídy z prvku &lt;select&gt;"

msgid "Copy the hyperlink classes to the &lt;option&gt; elements of the &lt;select&gt;."
msgstr "Zkopírujte třídy hypertextového odkazu do prvků &lt;option&gt; prvku &lt;select&gt;."

msgid "Exclude these classes from the &lt;option&gt; elements of the &lt;select&gt;"
msgstr "Vyloučit tyto třídy z prvků &lt;option&gt; prvku &lt;select&gt;"

msgid "Include these classes in the &lt;select&gt; element"
msgstr "Zahrnout tyto třídy do prvku &lt;select&gt;"

msgid "Include these classes in the &lt;option&gt; elements of the &lt;select&gt;"
msgstr "Zahrnout tyto třídy do prvků &lt;option&gt; prvku &lt;select&gt;"

msgid "Accordion settings"
msgstr "Nastavení skládací nabídky"

msgid "By default the caption of the accordion toggle switch will be the name of the parent menu or the title of this block, you can change this by setting a custom title."
msgstr "Standardně bude popiskem přepínače skládací nabídky název nadřízené nabídky nebo název tohoto bloku, můžete to změnit nastavením vlastního názvu."

msgid "Menu"
msgstr "Nabídka"

msgid "Accordion menu title"
msgstr "Název skládací nabídky"

msgid "Use parent menu items as buttons, add cloned parent links to sub-menus as well."
msgstr "Použijte položky nadřízené nabídky jako tlačítka, přidejte klonované nadřízené odkazy také do podnabídek."

msgid "Accordion button type"
msgstr "Typ tlačítka skládací nabídky"

msgid "Use parent menu items as buttons."
msgstr "Použijte položky nadřízené nabídky jako tlačítka."

msgid "Create new links next to parent menu item links and use them as buttons."
msgstr "Vytvořte nové odkazy vedle odkazů na položku nadřízené nabídky a použijte je jako tlačítka."

msgid "Supersubs"
msgstr "Supersubs"

msgid "<strong>Supersubs</strong> makes it possible to define custom widths for your menus."
msgstr "<strong>Supersubs</strong> umožňuje definovat vlastní šířky pro vaše nabídky."

msgid "Enable Supersubs for this menu."
msgstr "Povolte Supersubs pro tuto nabídku."

msgid "Minimum width for sub-menus, in <strong>em</strong> units."
msgstr "Minimální šířka podnabídek v jednotkách <strong>em</strong>."

msgid "Minimum width"
msgstr "Minimální šířka"

msgid "Maximum width for sub-menus, in <strong>em</strong> units."
msgstr "Maximální šířka pro podnabídky v jednotkách <strong>em</strong>."

msgid "Maximum width"
msgstr "Maximální šířka"

msgid "Please refer to the Superfish module documentation for how you should setup multi-column sub-menus."
msgstr "Informace o tom, jak nastavit vícesloupcové podnabídky, naleznete v dokumentaci k modulu Superfish."

msgid "Multi-column sub-menus"
msgstr "Vícesloupcové podnabídky"

msgid "Enable multi-column sub-menus."
msgstr "Povolte vícesloupcové podnabídky."

msgid "The depth of the first instance of multi-column sub-menus."
msgstr "Hloubka první instance vícesloupcových podnabídek."

msgid "Start from depth"
msgstr "Začít od hloubky"

msgid "The amount of sub-menu levels that will be included in the multi-column sub-menu."
msgstr "Množství úrovní podnabídky, které budou zahrnuty do vícesloupcové podnabídky."

msgid "Levels"
msgstr "Úrovně"

msgid "Advanced settings"
msgstr "Rozšířené nastavení"

msgid "The speed of the animation either in <strong>milliseconds</strong> or pre-defined values (<strong>slow, normal, fast</strong>)."
msgstr "Rychlost animace buď v <strong>milisekundách</strong>, nebo v předdefinovaných hodnotách (<strong>pomalá, normální, rychlá</strong>)."

msgid "Animation speed"
msgstr "Rychlost animace"

msgid "The delay in <strong>milliseconds</strong> that the mouse can remain outside a sub-menu without it closing."
msgstr "Prodleva v <strong>milisekundách</strong>, po kterou může myš zůstat mimo podnabídku, aniž by se zavřela."

msgid "Mouse delay"
msgstr "Prodleva myši"

msgid "The amount of sub-menu levels that remain open or are restored using the \".active-trail\" class."
msgstr "Množství úrovní podnabídky, které zůstávají otevřené, nebo jsou obnovené pomocí třídy \".active-trail\"."

msgid "Change this setting <strong>only and only</strong> if you are <strong>totally sure</strong> of what you are doing."
msgstr "Toto nastavení změňte <strong>pouze v případě</strong>, pokud jste si <strong>zcela jisti</strong> tím, co děláte."

msgid "Path levels"
msgstr "Úrovně cest"

msgid "Hyperlinks"
msgstr "Hypertextové odkazy"

msgid "By enabling this option, only parent menu items with <em>Expanded</em> option enabled will have their submenus appear."
msgstr "Povolením této volby se zobrazí pouze položky nadřízené nabídky s povolenou volbou <em>Rozbaleno</em>."

msgid "Take \"Expanded\" option into effect."
msgstr "Zplatněte volbu \"Rozbaleno\"."

msgid "Add cloned parent links to the top of sub-menus."
msgstr "Přidejte klonované nadřízené odkazy do horní části podnabídek."

msgid "Disable hyperlink descriptions (\"title\" attribute)"
msgstr "Zakázat popisy hypertextových odkazů (atribut \"title\")"

msgid "Insert hyperlink descriptions (\"title\" attribute) into hyperlink texts."
msgstr "Do textů hypertextového odkazu vložte popisy hypertextových odkazů (atribut \"title\")."

msgid "Add item depth classes to menu items and their hyperlinks."
msgstr "Přidejte třídy hloubky položek do položek nabídky a jejich hypertextových odkazů."

msgid "Custom classes"
msgstr "Vlastní třídy"

msgid "(Space separated, without dots)"
msgstr "(Oddělené mezerami, bez teček)"

msgid "For the main UL"
msgstr "Pro hlavní UL"

msgid "For the list items"
msgstr "Pro položky seznamu"

msgid "For the hyperlinks"
msgstr "Pro hypertextové odkazy"

msgid "Unacceptable value entered for the \"Animation speed\" option."
msgstr "Pro volbu \"Rychlost animace\" byla zadána nepřijatelná hodnota."

msgid "Unacceptable value entered for the \"Mouse delay\" option."
msgstr "Pro volbu \"Prodleva myši\" byla zadána nepřijatelná hodnota."

msgid "\"sfTouchscreen Breakpoint\" option cannot be empty."
msgstr "Volba \"Zarážka sfTouchscreen\" nemůže být prázdná."

msgid "Unacceptable value enterd for the \"sfTouchscreen Breakpoint\" option."
msgstr "Pro volbu \"Zarážka sfTouchscreen\" byla zadána nepřijatelná volba."

msgid "List of the touch-screen user agents cannot be empty."
msgstr "Seznam agentů uživatelů dotykových obrazovek nemůže být prázdný."

msgid "\"sfSmallscreen Breakpoint\" option cannot be empty."
msgstr "Volba \"Zarážka sfSmallscreen\" nemůže být prázdná."

msgid "Unacceptable value entered for the \"sfSmallscreen Breakpoint\" option."
msgstr "Pro volbu \"Zarážka sfSmallscreen\" byla zadána nepřijatelná volba."

msgid "List of the small-screen user agents cannot be empty."
msgstr "Seznam agentů uživatelů malých obrazovek nemůže být prázdný."

msgid "Unacceptable value entered for the \"Supersubs minimum width\" option."
msgstr "Pro volbu \"Minimální šířka Supersubs\" byla zadána nepřijatelná volba."

msgid "Unacceptable value entered for the \"Supersubs maximum width\" option."
msgstr "Pro volbu \"Maximální šířka Supersubs\" byla zadána nepřijatelná hodnota."

msgid "Supersubs \"maximum width\" has to be bigger than the \"minimum width\"."
msgstr "Supersubs \"maximální šířka\" musí být větší než \"minimální šířka\"."

msgid "Expand"
msgstr "Rozbalit"

msgid "Collapse"
msgstr "Sbalit"

