msgid "Metatag: Google Plus"
msgstr "메타 태그: Google Plus"

msgid "Provides support for Google's Plus meta tags. Deprecated, will be removed in Metatag 2.0.0."
msgstr "Google Plus 메타 태그에 대한 지원을 제공합니다. 더 이상 사용되지 않으며 Metatag 2.0.0에서 제거될 예정입니다."

msgid "SEO"
msgstr "SEO"

msgid "Google Plus: name"
msgstr "Google Plus: 이름"

msgid "Google Plus: image"
msgstr "Google Plus: 이미지"

msgid "Google Plus: description"
msgstr "Google Plus: 설명"

msgid "Publisher URL"
msgstr "공개자 URL"

msgid "Author"
msgstr "작성자"

msgid "Google Plus"
msgstr "Google Plus"

msgid "DEPRECATED, use Advanced-Author instead."
msgstr "더 이상 사용되지 않습니다. Advanced-Author를 대신 사용하십시오."

msgid "Description"
msgstr "설명"

msgid "Content description less than 200 characters."
msgstr "컨텐츠 설명이 200자 미만입니다."

msgid "Image"
msgstr "이미지"

msgid "The URL of an image which should represent the content. For best results use an image that is at least 1200 x 630 pixels in size, but at least 600 x 316 pixels is a recommended minimum. Supports PNG, JPEG and GIF formats."
msgstr "컨텐츠를 표시해야 하는 이미지의 URL입니다. 최상의 결과를 얻으려면 크기가 1200 x 630픽셀 이상인 이미지를 사용하십시오. 하지만 최소 권장 크기는 600 x 316픽셀 이상입니다. PNG, JPEG, GIF 형식을 지원합니다."

msgid "Name"
msgstr "이름"

msgid "Content title."
msgstr "컨텐츠 제목입니다."

msgid "Used by some search engines to confirm publication of the content on a page. Should be the full URL for the publication's Google+ profile page."
msgstr "일부 검색 엔진이 페이지에서 컨텐츠의 공개를 확인하는 데 사용됩니다. 공개 항목의 Google+ 프로파일 페이지에 대한 전체 URL이어야 합니다."

