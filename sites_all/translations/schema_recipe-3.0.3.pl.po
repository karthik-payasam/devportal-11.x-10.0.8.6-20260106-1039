msgid "RECOMMENDED BY GOOGLE. The overall rating, based on a collection of reviews or ratings, of the item."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Ogólna ocena na podstawie kolekcji recenzji lub ocen elementu."

msgid "RECOMMENDED BY GOOGLE. Author of the recipe."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Autor przepisu."

msgid "RECOMMENDED BY GOOGLE. Cook Time (The time it takes to actually cook the dish, in ISO 8601 duration format.)."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Czas gotowania (rzeczywisty czas gotowania w formacie zgodnym ze standardem ISO 8601)."

msgid "RECOMMENDED BY GOOGLE. Date the recipe was published."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Data opublikowania przepisu."

msgid "RECOMMENDED BY GOOGLE. A description of the item."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Opis elementu."

msgid "Globally unique id of the recipe, usually a url."
msgstr "Globalnie unikalny identyfikator przepisu, zwykle adres URL."

msgid "RECOMMENDED BY GOOGLE. The primary image for this item."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Podstawowy obraz tego elementu."

msgid "RECOMMENDED BY GOOGLE. Keywords of the recipe (comma separated). For example, 'winter apple pie, nutmeg crust'"
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Słowa kluczowe przepisu (oddzielone przecinkami). Na przykład „zimowa szarlotka jabłko ciasto, skórka z gałki muszkatołowej”"

msgid "REQUIRED BY GOOGLE. Name of the recipe."
msgstr "WYMAGANE PRZEZ SERWIS GOOGLE. Nazwa przepisu."

msgid "RECOMMENDED BY GOOGLE. The nutrition for this item."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Wartości odżywcze tego elementu."

msgid "RECOMMENDED BY GOOGLE. The length of time it takes to prepare the recipe for dish, in ISO 8601 format."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Czas potrzebny na przygotowanie dania wg przepisu (w formacie ISO 8601)."

msgid "RECOMMENDED BY GOOGLE. The category of the recipe—for example, appetizer, entree, etc."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Kategoria przepisu (np. przystawka lub danie główne)."

msgid "RECOMMENDED BY GOOGLE. The region associated with your recipe. For example, 'French Mediterranean', or 'American'."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Region powiązany z przepisem. Na przykład francusko-śródziemnomorski lub amerykański."

msgid "RECOMMENDED BY GOOGLE. A list of single ingredients used in the recipe, e.g. sugar, flour or garlic."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Wykaz pojedynczych składników użytych w przepisie (np. cukier, mąka lub czosnek)."

msgid "RECOMMENDED BY GOOGLE. Steps in making the recipe."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Kroki, które należy wykonać w celu zrealizowania przepisu."

msgid "RECOMMENDED BY GOOGLE. The quantity produced by the recipe (for example, number of people served, number of servings, etc)."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Ilość otrzymywana w wyniku zrealizowania przepisu (np. liczba obsługiwanych osób lub liczba porcji)."

msgid "RECOMMENDED BY GOOGLE. Reviews of this recipe."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Recenzje tego przepisu."

msgid "RECOMMENDED BY GOOGLE. Total Time (The total time required to perform instructions or a direction (including time to prepare the supplies), in ISO 8601 duration format."
msgstr "ZALECANE PRZEZ SERWIS GOOGLE. Łączny czas potrzebny na wykonanie instrukcji (w tym czas przygotowywania zapasów) w formacie czasu trwania ISO 8601."

msgid "REQUIRED. The type of recipe."
msgstr "WYMAGANE. Typ przepisu."

