msgid "DropzoneJS entity browser widget"
msgstr "DropzoneJS-Widget für Entitätsbrowser"

msgid "DropzoneJS Entity browser widget."
msgstr "DropzoneJS Entity-Browser-Widget."

msgid "Media"
msgstr "Medien"

msgid "DropzoneJS widget configuration"
msgstr "DropzoneJS-Widgetkonfiguration"

msgid "Submit button text"
msgstr "Text für Sendeschaltfläche"

msgid "Automatically submit selection"
msgstr "Auswahl automatisch übergeben"

msgid "Upload location"
msgstr "Uploadposition"

msgid "Dropzone drag-n-drop zone text"
msgstr "Dropzone - Text für Drag-and-Drop-Zone"

msgid "Maximum size of files"
msgstr "Maximale Größe der Dateien"

msgid "Allowed file extensions"
msgstr "Zulässige Dateierweiterungen"

msgid "Use clientside resize"
msgstr "Clientseitige Größenänderung verwenden"

msgid "Maximum width"
msgstr "Maximale Breite"

msgid "Maximum height"
msgstr "Maximale Höhe"

msgid "Resize quality"
msgstr "Größenänderungsqualität"

msgid "Method used for resizing"
msgstr "Für die Größenänderung verwendete Methode"

msgid "Method used for generating the thumbnail"
msgstr "Zum Generieren des Piktogramms verwendete Methode"

msgid "Media Entity DropzoneJS widget configuration"
msgstr "Konfiguration für Medienentitäts-DropzoneJS-Widget"

msgid "Media type"
msgstr "Medientyp"

msgid "Media Entity DropzoneJS with edit widget configuration"
msgstr "Konfiguration für Medienentitäts-DropzoneJS mit Bearbeitungswidget"

msgid "Form mode"
msgstr "Formularmodus"

msgid "Drop files here to upload them"
msgstr "Legen Sie Dateien hier ab, um sie hochzuladen"

msgid "File upload"
msgstr "Dateiupload"

msgid "Files could not be uploaded because the destination directory %destination is not configured correctly."
msgstr "Dateien konnten nicht hochgeladen werden, da das Zielverzeichnis %destination nicht richtig konfiguriert ist."

msgid "Some files that you are trying to upload did not pass validation. Requirements are: max file %size, allowed extensions are %extensions"
msgstr "Einige Dateien, die Sie hochladen möchten, haben die Validierung nicht bestanden. Anforderungen: max. Dateigröße %size, zulässige Erweiterungen sind %extensions"

msgid "At least one valid file should be uploaded."
msgstr "Mindestens eine gültige Datei sollte hochgeladen werden."

msgid "MB"
msgstr "MB"

msgid "A space separated list of file extensions"
msgstr "Eine durch Leerzeichen getrennte Liste mit Dateierweiterungen"

msgid "Use client side resizing"
msgstr "Clientseitige Größenänderung verwenden"

msgid "Requires droopzone version v4.4.0 or higher and the <a href=\"@exif\" target=\"_blank\">exif</a> library."
msgstr "Erfordert droopzone-Version 4.4.0 oder höher und die Bibliothek <a href=\"@exif\" target=\"_blank\">exif</a>."

msgid "Max width"
msgstr "Max. Breite"

msgid "Max height"
msgstr "Max. Höhe"

msgid "Resize method"
msgstr "Größenänderungsmethode"

msgid "Contain (scale)"
msgstr "Enthält (Skalierung)"

msgid "Crop"
msgstr "Zuschneiden"

msgid "Thumbnail method"
msgstr "Piktogrammmethode"

msgid "Invalid extension list format."
msgstr "Ungültiges Format für Erweiterungsliste."

msgid "DropzoneJS"
msgstr "DropzoneJS"

msgid "Adds DropzoneJS upload integration."
msgstr "Fügt DropzoneJS-Upload-Integration hinzu."

msgid "Missing requirement: in order to use this widget you have to install Inline entity form module first"
msgstr "Fehlende Anforderung: Für die Verwendung dieses Widgets müssen Sie zunächst das Formularmodul für Inline-Entitäten installieren"

msgid "Edit"
msgstr "Bearbeiten"

msgid "Media Entity DropzoneJS with edit"
msgstr "Medienentitäts-DropzoneJS mit Bearbeitung"

msgid "Adds DropzoneJS upload integration that saves Media entities and allows to edit them."
msgstr "Fügt DropzoneJS-Upload-Integration hinzu, um Medienentitäten zu speichern und ihre Bearbeitung zu ermöglichen."

msgid "The type of media entity to create from the uploaded file(s)."
msgstr "Der Typ der Medienentität, der aus den hochgeladenen Dateien erstellt werden soll."

msgid "You must @create_media_type before using this widget."
msgstr "Sie müssen @create_media_type ausführen, bevor Sie dieses Widget verwenden."

msgid "create a media type"
msgstr "Einen Medientyp erstellen"

msgid "Media Entity DropzoneJS"
msgstr "Medienentitäts-DropzoneJS"

msgid "Adds DropzoneJS upload integration that saves Media entities."
msgstr "Fügt DropzoneJS-Upload-Integration hinzu, um Medienentitäten zu speichern."

