msgid "Client-side Hierarchical Select"
msgstr "Hierarchický výběr na straně klienta"

msgid "A simple client-side hierarchical select widget for taxonomy terms."
msgstr "Jednoduchý hierarchický modul widget pro výběr na straně klienta pro výrazy taxonomie."

msgid "Widgets"
msgstr "Moduly widget"

msgid "CSHS field widget settings"
msgstr "Nastavení modulu widget pole CSHS"

msgid "Save lineage"
msgstr "Uložit původ"

msgid "Force selection of deepest level"
msgstr "Vynutit výběr nejhlubší úroveň"

msgid "Parent"
msgstr "Nadřízený prvek"

msgid "Labels per hierarchy-level"
msgstr "Popisky pro úroveň hierarchie"

msgid "Hierarchy depth"
msgstr "Hloubka hierarchie"

msgid "Required depth"
msgstr "Požadovaná hloubka"

msgid "The \"no selection\" label"
msgstr "Popisek \"bez výběru\""

msgid "Client-side Hierarchical Select: Menu Link"
msgstr "Hierarchický výběr na straně klienta: Odkaz nabídky"

msgid "A client-side hierarchical selection of parents for the menu link. Works for node and term forms (with \"taxonomy_menu_ui\" enabled)."
msgstr "Klientský hierarchický výběr nadřízených prvků pro odkaz nabídky. Pracuje pro formuláře uzlů a výrazů (s povoleno volbou \"taxonomy_menu_ui\")."

msgid "Deepest"
msgstr "Nejhlubší"

msgid "None"
msgstr "Není"

msgid "Yes"
msgstr "Ano"

msgid "No"
msgstr "Ne"

msgid "Parent: @parent"
msgstr "Nadřízený: @parent"

msgid "Force deepest: @force_deepest"
msgstr "Vynutit nejhlubší: @force_deepest"

msgid "Save lineage: @save_lineage"
msgstr "Uložit původ: @save_lineage"

msgid "Level labels: @level_labels"
msgstr "Popisky úrovně: @level_labels"

msgid "The \"no selection\" label: @none_label"
msgstr "Popisek \"bez výběru\": @none_label"

msgid "Select a parent term to use only a subtree of a vocabulary for this field."
msgstr "Vyberte nadřízený výraz, chcete-li pro toto pole použít pouze podstrom slovníku."

msgid "Force the deepest level selection"
msgstr "Vynutit výběr nejhlubší úrovně"

msgid "If checked the user will be forced to select terms from the deepest level."
msgstr "Je-li tato volba zaškrtnuta, bude uživatel nucen vybrat výrazy z nejhlubší úrovně."

msgid "Enter labels for each hierarchy-level separated by comma."
msgstr "Zadejte popisky pro jednotlivé úrovně hierarchie oddělené čárkou."

msgid "The label for an empty option."
msgstr "Štítek pro prázdnou volbu."

msgid "The hierarchy depth cannot be @actual because the selection list has @levels levels."
msgstr "Hloubka hierarchie nemůže být @actual, protože výběrový seznam má @levels úrovní."

msgid "The required depth cannot be greater than the hierarchy depth."
msgstr "Požadovaná hloubka nesmí být větší než hloubka hierarchie."

msgid "Format"
msgstr "Formát"

msgid "Specify a format for each field item by using tokens."
msgstr "Určete formát pro každou položku pole pomocí tokenů."

msgid "Clear Tokens"
msgstr "Vymazat tokeny"

msgid "Remove token from final text if no replacement value is generated"
msgstr "Odebrat token z finálního textu, pokud není generována žádná nahrazující hodnota"

msgid "Format: @format"
msgstr "Formát: @format"

msgid "Flexible hierarchy"
msgstr "Flexibilní hierarchie"

msgid "Allows to specify the output with tokens."
msgstr "Umožňuje určit výstup s tokeny."

msgid "Link to term page"
msgstr "Odkaz na stránku výrazu"

msgid "Reverse order view"
msgstr "Zobrazení obráceného pořadí"

msgid "Outputs hierarchy in reverse order (the deepest level first)."
msgstr "Vytvoří výstup hierarchie v obráceném pořadí (nejhlubší úroveň první)."

msgid "Linked to term page: @linked"
msgstr "Odkázaný na stránku výrazu: @linked"

msgid "Reverse order view: @reverse"
msgstr "Zobrazení obráceného pořadí: @reverse"

msgid "Separator"
msgstr "Oddělovač"

msgid "Specify a separator which will be placed in between the different hierarchy levels."
msgstr "Určete oddělovač, který bude umístěn mezi různými úrovněmi hierarchie."

msgid "Separator: @separator"
msgstr "Oddělovač: @separator"

msgid "Full hierarchy"
msgstr "Úplná hierarchie"

msgid "Display the full hierarchy of the taxonomy term."
msgstr "Zobrazte úplnou hierarchii výrazu taxonomie."

msgid "Sorting"
msgstr "Řazení"

msgid "Depth"
msgstr "Hloubka"

msgid "The maximum hierarchy depth. Use 0 to not limit or 1 to display just the root term (or the last if reverse order selected)."
msgstr "Maximální hloubka hierarchie. Pomocí hodnoty 0 se nepoužije žádné omezení a pomocí hodnoty 1 se zobrazí pouze kořenový výraz (nebo poslední výraz, pokud je vybráno obrácené pořadí)."

msgid "Last child"
msgstr "Poslední podřízený prvek"

msgid "Show only the root term and its deepest child."
msgstr "Zobrazit pouze kořenový výraz a jeho nejhlubší podřízený prvek."

msgid "Sorting: @value"
msgstr "Řazení: @value"

msgid "Depth: @value"
msgstr "Hloubka: @value"

msgid "Last child only"
msgstr "Pouze poslední podřízený prvek"

msgid "Unlimited"
msgstr "Neomezeno"

msgid "Hierarchy grouped by root"
msgstr "Hierarchie seskupená podle kořene"

msgid "Display the hierarchy of the taxonomy term grouped by root."
msgstr "Zobrazte hierarchii výrazu taxonomie seskupenou podle kořene."

msgid "Client-side hierarchical select"
msgstr "Hierarchický výběr na straně klienta"

msgid "An invalid vocabulary is selected. Please change it in the options."
msgstr "Je vybrán neplatný slovník. Změňte jej prosím ve volbách."

msgid "About"
msgstr "O programu"

msgid "Settings"
msgstr "Nastavení"

msgid "Multi-lingual"
msgstr "Vícejazyčný"

msgid "Supports multi-lingual terms localized with i18n_taxonomy module (Which is part of the i18n package)."
msgstr "Podporuje vícejazyčné výrazy lokalizované s modulem i18n_taxonomy (který je součástí balíku i18n)."
