msgid "Batch"
msgstr "Lote"

msgid "Exports under one request. Best fit for small exports."
msgstr "Exporta bajo una solicitud. Adecuado para pequeñas exportaciones."

msgid "Exports data in sequences. Should be used when large amount of data is exported (> 2000 rows)."
msgstr "Exporta datos en secuencias. Debe utilizarse cuando se exporta una gran cantidad de datos (> 2000 filas)."

msgid "The number of rows to process under a request."
msgstr "El número de filas a procesar bajo una solicitud."

msgid "The maximum amount of rows to export. 0 means unlimited."
msgstr "La cantidad máxima de filas a exportar. 0 significa ilimitado."

msgid "File Storage/Download Settings"
msgstr "Valores de almacenamiento/descarga de archivos"

msgid "Filename"
msgstr "Nombre de archivo"

msgid "The filename that will be suggested to the browser for downloading purposes. You may include replacement patterns from the list below."
msgstr "El nombre de archivo que se sugerirá al explorador para fines de descarga. Puede incluir patrones de reemplazo de la lista siguiente."

msgid "Store file in public files directory"
msgstr "Almacenar archivo en el directorio de archivos público"

msgid "Check this if you want to store the export files in the public:// files directory instead of the private:// files directory."
msgstr "Seleccione esta opción si desea almacenar los archivos de exportación en el directorio de archivos public:// en lugar de en el directorio de archivos private://."

msgid "<strong>The private:// file system is not configured so the exported files will be stored in the public:// files directory. Click <a href=\"@link\" target=\"_blank\">here</a> for instructions on configuring the private files in the settings.php file.</strong>"
msgstr "<strong>El sistema de archivos private:// no está configurado, por lo que los archivos exportados se almacenarán en el directorio de archivos public://. Pulse <a href=\"@link\" target=\"_blank\">aquí</a> para obtener instrucciones sobre cómo configurar los archivos privados en el archivo settings.php.</strong>"

msgid "Check this if you want to download the file immediately after it is created. Does <strong>NOT</strong> work for JSON data exports."
msgstr "Seleccione esta opción si desea descargar el archivo inmediatamente después de crearlo. <strong>NO</strong> funciona para las exportaciones de datos JSON."

msgid "Check this if you want to configure a custom redirect path."
msgstr "Seleccione esta opción si desea configurar una vía de acceso de redirección personalizada."

msgid "Select the display to redirect to after batch finishes. If None is selected the user will be redirected to the front page."
msgstr "Seleccione la pantalla para la redirección una vez finalizado el proceso por lotes. Si se selecciona Ninguna, se redirigirá al usuario a la primera página."

msgid "Enter custom path to redirect user after batch finishes."
msgstr "Especifique la vía de acceso personalizada para redirigir al usuario una vez finalizado el proceso por lotes."

msgid "Check this if you want to include query string parameters on redirect."
msgstr "Seleccione esta opción si desea incluir parámetros de serie de consulta en la redirección."

msgid "Displays"
msgstr "Presentaciones"

msgid "The data export icon will be available only to the selected displays."
msgstr "El icono de exportación de datos solo estará disponible en las pantallas seleccionadas."

msgid "Choose the facet source used to alter data export. This should be the display that this data export is attached to."
msgstr "Elija el origen de faceta utilizado para modificar la exportación de datos. Debe ser la pantalla a la que está conectada esta exportación de datos."

msgid "Could not write to temporary output file for result export (@file). Check permissions."
msgstr "No se pudo escribir en el archivo temporal de salida para la exportación de resultados (@file). Compruebe los permisos."

msgid "Export complete. Download the file <a download href=\":download_url\"  data-download-enabled=\"false\" id=\"vde-automatic-download\">here</a>."
msgstr "La exportación ha finalizado. Descargue el archivo <a download href=\":download_url\"  data-download-enabled=\"false\" id=\"vde-automatic-download\">aquí</a>."

msgid "Export complete. Download the file <a download href=\":download_url\" data-download-enabled=\"true\" id=\"vde-automatic-download\">here</a> if file is not automatically downloaded."
msgstr "La exportación ha finalizado. Descargue el archivo <a download href=\":download_url\"  data-download-enabled=\"false\" id=\"vde-automatic-download\">aquí</a> si no se ha descargado automáticamente."

msgid "Export failed. Make sure the private file system is configured and check the error log."
msgstr "La exportación ha fallado. Asegúrese de que el sistema de archivos privado está configurado y compruebe el registro de errores."

msgid "Data export"
msgstr "Exportación de datos"

msgid "Export the view results to a file. Can handle very large result sets."
msgstr "Exporta los resultados de la vista a un archivo. Puede manejar conjuntos muy grandes de resultados."

msgid "Indicates the character used to delimit fields. Defaults to a comma (<code>,</code>). For tab-separation use <code>\\t</code> characters."
msgstr "Indica el carácter utilizado para delimitar los campos. Toma el valor predeterminado de coma (<code>,</code>). Para representar una separación por tabulador, use los caracteres <code>\\t</code>."

msgid "Indicates the character used for field enclosure. Defaults to a double quote (<code>\"</code>)."
msgstr "Indica el carácter utilizado en un alojamiento de campo. Toma el valor predeterminado de dobles comillas (<code>\"</code>)."

msgid "Indicates the character used for escaping. Defaults to a backslash (<code>\\</code>)."
msgstr "Indica el carácter utilizado para escapar. Toma el valor predeterminado de barra inclinada invertida(<code>\\</code>)."

msgid "Strips HTML tags from CSV cell values."
msgstr "Elimina las etiquetas HTML de los valores de celda CSV."

msgid "Trims whitespace from beginning and end of CSV cell values."
msgstr "Recorta espacios iniciales y finales de los valores de celda CSV."

msgid "Determines the encoding used for CSV cell values."
msgstr "Determina la codificación utilizada en los valores de celda CSV."

msgid "UTF-8"
msgstr "UTF-8"

msgid "Include unicode signature (<a href=\"@bom\" target=\"_blank\">BOM</a>)."
msgstr "Incluir firma unicode (<a href=\"@bom\" target=\"_blank\">BOM</a>)."

msgid "Only use Symfony serializer->encode method"
msgstr "Utilizar solo serializador de Symfony->método de codificación"

msgid "Skips the symfony data normalize method when rendering data export to increase performance on large datasets. <strong>(Only use when not exporting nested data)</strong>"
msgstr "Omite el método de normalización de datos de Symfony al representar la exportación de datos para aumentar el rendimiento en conjuntos de datos grandes.<strong>(Sólo se utiliza cuando no se exportan datos anidados)</strong>"

msgid "Configurable row output for data exports."
msgstr "Salida de fila configurable en exportaciones de datos."

msgid "Download @format"
msgstr "Descargar @format"

