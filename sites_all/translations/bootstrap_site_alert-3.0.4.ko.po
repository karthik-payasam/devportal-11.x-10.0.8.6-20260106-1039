msgid "Bootstrap Site Alert"
msgstr "부트스트랩 사이트 경보"

msgid "This module is for rendering alerts site wide using the power of Bootstrap"
msgstr "이 모듈은 부트스트랩의 기능을 사용하여 사이트 전체에 경보를 렌더링하기 위한 것입니다."

msgid "Other"
msgstr "기타"

msgid "Bootstrap Site Alert Configuration"
msgstr "부트스트랩 사이트 경보 구성"

msgid "Configure the Bootstrap Site Wide Alert Settings"
msgstr "부트스트랩 사이트 전체 경보 설정 구성"

msgid "Administer Bootstrap Site Alert"
msgstr "부트스트랩 사이트 경보 관리"

msgid "View Bootstrap Site Alert"
msgstr "부트스트랩 사이트 경보 보기"

msgid "Settings"
msgstr "설정"

msgid ""
"<h3>Use this form to setup the bootstrap site alert(s).</h3>\n"
"                  <p>Make sure you select the checkbox if you want to turn the alerts on</p>"
msgstr ""
"<h3>부트스트랩 사이트 경보를 설정하려면 이 양식을 사용하십시오.</h3>\n"
"                  <p>이 경보를 사용하려면 선택란을 선택해야함</p>"

msgid "Select Bootstrap Version"
msgstr "부트스트랩 버전 선택"

msgid "3"
msgstr "3"

msgid "4"
msgstr "4"

msgid "- SELECT -"
msgstr "- 선택 -"

msgid "Save Bootstrap Version"
msgstr "부트스트랩 버전 저장"

msgid "Success"
msgstr "성공"

msgid "Info"
msgstr "정보"

msgid "Warning"
msgstr "경고"

msgid "Danger"
msgstr "위험"

msgid "Primary"
msgstr "1차"

msgid "Secondary"
msgstr "2차"

msgid "Light"
msgstr "밝게"

msgid "Dark"
msgstr "어둡게"

msgid "If Checked, Bootstrap Site Alert is Active."
msgstr "선택한 경우 부트스트랩 사이트 경보가 활성 상태가 됩니다."

msgid "Severity"
msgstr "심각성"

msgid "Make this alert dismissable?"
msgstr "이 경보를 거부하시겠습니까?"

msgid "Hide this alert on admin pages?"
msgstr "이 경보를 관리 페이지에서 숨깁니까?"

msgid "Only Show On Certain Pages?"
msgstr "특정 페이지에만 표시합니까?"

msgid "Path(s) to show on"
msgstr "표시할 경로"

msgid "Specify pages by using their paths. Enter one path per line. The '*' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page."
msgstr "경로를 사용하여 페이지를 지정합니다. 하나의 라인에 하나씩 경로를 입력하십시오. '*' 문자는 와일드카드입니다. 모든 사용자 페이지에 대한 경로 예: %user-wildcard . %front은(는) 프론트 페이지입니다."

msgid "Alert Message"
msgstr "경보 메시지"

msgid "Add Another Alert"
msgstr "다른 경보 추가"

msgid "Remove Last Alert"
msgstr "마지막 경보 제거"

msgid "Save Alert Message(s)"
msgstr "경보 메시지 저장"

