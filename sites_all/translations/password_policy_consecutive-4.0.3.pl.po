msgid "Password Consecutive Characters Policy"
msgstr "Strategia dotycząca kolejnych znaków w haśle"

msgid "Sets up a consecutive characters constraint for passwords."
msgstr "Konfiguruje ograniczenie dotyczące kolejnych znaków w hasłach."

msgid "Security"
msgstr "Zabezpieczenia"

msgid "Maximum consecutive character count"
msgstr "Maksymalna liczba kolejnych znaków"

msgid "Invalid plugin configuration."
msgstr "Niepoprawna konfiguracja wtyczki."

msgid "No consecutive identical characters are allowed."
msgstr "Kolejne identyczne znaki nie są dozwolone."

msgid "Password must have fewer than @max consecutive identical characters. This is case sensitive."
msgstr "Liczba kolejnych identycznych znaków w haśle musi być mniejsza niż @max. W znakach rozróżniana jest wielkość liter."

msgid "Consecutive identical characters fewer than: @max"
msgstr "Liczba kolejnych identycznych znaków jest mniejsza niż: @max"

msgid "Consecutive identical characters fewer than"
msgstr "Liczba kolejnych identycznych znaków jest mniejsza niż"

msgid "This many or more consecutive identical characters will not be allowed in the password."
msgstr "W haśle nie będzie dozwolona następująca liczba kolejnych identycznych znaków."

msgid "The number of consecutive identical characters must be higher than 1 otherwise all passwords will fail."
msgstr "Liczba kolejnych identycznych znaków musi być większa niż 1, gdyż w przeciwnym razie wszystkie hasła będą nieprawidłowe."

msgid "Consecutive characters"
msgstr "Kolejne znaki"

msgid "Verifying that a password has a maximum number of consecutive identical characters."
msgstr "Sprawdzanie, czy hasło zawiera maksymalną liczbę kolejnych identycznych znaków."

msgid "Your password has too many consecutive characters."
msgstr "Hasło zawiera zbyt wiele kolejnych znaków."

