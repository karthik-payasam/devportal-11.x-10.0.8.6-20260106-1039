msgid "Back To Top"
msgstr "Torna all'inizio"

msgid "Back To Top adds a button that hovers in the bottom of your screen and allow users to smoothly scroll up the page using jQuery."
msgstr "Torna all'inizio aggiunge un pulsante sensibile al passaggio del mouse nella parte inferiore dello schermo e che consente agli utenti di scorrere la pagina delicatamente, utilizzando jQuery. "

msgid "User interface"
msgstr "Interfaccia utente"

msgid "Back to Top"
msgstr "Torna in cima"

msgid "Administer Back To Top settings."
msgstr "Amministrare le impostazioni Torna all'inizio."

msgid "Back to top settings"
msgstr "Impostazioni di Torna all'inizio "

msgid "Access Back to top settings"
msgstr "Accesso alle impostazioni di Torna all'inizio"

msgid "Prevent on mobile and touch devices"
msgstr "Prevenire su dispositivi mobili e touch"

msgid "Prevent on administration pages and node edit"
msgstr "Modifica Previeni su nodi e pagine di amministrazione"

msgid "Prevent on front page"
msgstr "Previeni su prima pagina "

msgid "Trigger"
msgstr "Trigger"

msgid "Placement"
msgstr "Posizionamento"

msgid "Button text"
msgstr "Testo del bottone"

msgid "Button type"
msgstr "Tipo di pulsante"

msgid "Background color"
msgstr "Colore dello sfondo"

msgid "Border color"
msgstr "Colore margine"

msgid "Hover color"
msgstr "Colore al passaggio del mouse"

msgid "Text color"
msgstr "Colore del testo"

msgid "Back to top"
msgstr "Torna all'inizio"

msgid "Don´t show Back To Top-button on screen width up to 760px."
msgstr "Non mostrare il pulsante Torna all'inizio su schermi con larghezza fino a 760px."

msgid "Do you want to prevent Back To Top on admin pages?"
msgstr "Si desidera prevenire Torna all'inizio sulle pagine admin?"

msgid "Do you want to prevent Back To Top on front page?"
msgstr "Si desidera prevenire Torna all'inizio sulla prima pagina?"

msgid "Set the number of pixel which trigger the Back To Top button default 100"
msgstr "Imposta il numero di pixel che attiva il pulsante Torna all'inizio predefinito 100"

msgid "Where should the Back To Top button appear?"
msgstr "Dove deve apparire il pulsante Torna all'inizio?"

msgid "Bottom right"
msgstr "In basso a destra"

msgid "Bottom left"
msgstr "In basso a sinistra"

msgid "Bottom center"
msgstr "Centro in basso"

msgid "Top right"
msgstr "In alto a destra"

msgid "Top left"
msgstr "In alto a sinistra"

msgid "Top center"
msgstr "Centro in alto"

msgid "Mid right"
msgstr "A metà destra"

msgid "Mid left"
msgstr "A metà sinistra"

msgid "Mid center"
msgstr "Al centro"

msgid "Set the text of the Back To Top button"
msgstr "Imposta il testo del pulsante Torna all'inizio"

msgid "Do you want Back To Top to use a PNG-24 image or a Text/Css button?"
msgstr "Si desidera che Torna all'inizio utilizzi una immagine PNG-24 o un pulsante Testo/Css?"

msgid "Image (default)"
msgstr "Immagine (impostazione predefinita)"

msgid "Text/Css"
msgstr "Testo/Css"

msgid "Text/Css button settings"
msgstr "Impostazioni del pulsante Testo/Css"

msgid "Button background color default #F7F7F7"
msgstr "Colore sfondo pulsante predefinito #F7F7F7"

msgid "Border color default #CCCCCC"
msgstr "Colore margine predefinito #CCCCCC"

msgid "Hover color default #EEEEEE"
msgstr "Colore predefinito al passaggio del mouse #EEEEEE"

