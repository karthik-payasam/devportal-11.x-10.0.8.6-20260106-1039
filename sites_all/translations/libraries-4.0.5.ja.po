msgid "Lists registered library information."
msgstr "登録されたライブラリー情報をリストします。"

msgid ""
"Downloads a registered library into the libraries directory for the active site.\n"
"\n"
"See libraries-list for a list of registered libraries."
msgstr ""
"登録されたライブラリーをアクティブ・サイトのライブラリー・ディレクトリーにダウンロードします。\n"
"\n"
"登録されたライブラリーのリストについては、libraries-list を参照してください。"

msgid "Name"
msgstr "名前"

msgid "Status"
msgstr "状態"

msgid "Version"
msgstr "バージョン"

msgid "Variants"
msgstr "バリアント"

msgid "Dependencies"
msgstr "依存関係"

msgid "OK"
msgstr "OK"

msgid "Missing dependency: unzip. Install it before using this command."
msgstr "欠落している依存関係: unzip。このコマンドを使用する前にインストールしてください。"

msgid "Directory @path was created"
msgstr "ディレクトリー @path が作成されました"

msgid "A existing Colorbox plugin was overwritten at @path"
msgstr "既存の Colorbox プラグインが @path で上書きされました"

msgid "Colorbox plugin has been downloaded to @path"
msgstr "Colorbox プラグインが @path にダウンロードされました"

msgid "Drush was unable to download the Colorbox plugin to @path"
msgstr "Drush は、Colorbox プラグインを @path にダウンロードできませんでした"

msgid "The %dependency library, which the %library library depends on, is not installed."
msgstr "%library ライブラリーが依存する %dependency ライブラリーがインストールされていません。"

msgid "The version %dependency_version of the %dependency library is not compatible with the %library library."
msgstr "%dependency ライブラリのバージョン %dependency_version は %library と互換性がありません。"

msgid "The %library library could not be found."
msgstr "%library ライブラリが見つかりませんでした。"

msgid "The version of the %library library could not be detected."
msgstr "%library ライブラリのバージョンが検出できませんでした。"

msgid "The installed version %version of the %library library is not supported."
msgstr "インストールされたバージョン %version の %library ライブラリはサポートされていません。"

msgid "The %variant variant of the %library library could not be found."
msgstr "%library ライブラリーの %variant バリアントが見つかりませんでした。"

msgid "The following external libraries could not successfully be registered with Drupal core: @libs. See earlier log entries for more details. Once these issues are addressed please be sure to clear your Drupal library cache to ensure external library detection is run again."
msgstr "以下の外部ライブラリーは、Drupal コアに正常に登録できませんでした: @libs。詳しくは、前のログ・エントリーを参照してください。これらの問題に対処したら、外部ライブラリー検出が再度実行されるように、必ず Drupal ライブラリー・キャッシュをクリアしてください。"

msgid "Libraries"
msgstr "ライブラリ"

msgid "Allows version-dependent and shared usage of external libraries."
msgstr "外部ライブラリのバージョン依存と共有使用を許可します。"

msgid "Libraries API settings"
msgstr "ライブラリー API 設定"

msgid "Library definition settings"
msgstr "ライブラリー定義設定"

msgid "Local"
msgstr "ローカル"

msgid "Local path"
msgstr "ローカル・パス"

msgid "Enable remote fetching of library definitions"
msgstr "ライブラリー定義のリモート・フェッチの有効化"

msgid "A list of remote library registry URLs"
msgstr "リモート・ライブラリー・レジストリー URL のリスト"

msgid "The URL of a remote library registry"
msgstr "リモート・ライブラリー・レジストリーの URL"

msgid "URI locator configuration"
msgstr "URI ロケーター構成"

msgid "The locator URI"
msgstr "ロケーター URI"

msgid "Assets"
msgstr "アセット"

msgid "Provides access to asset library files."
msgstr "資産ライブラリー・ファイルへのアクセスを提供します。"

msgid "Library definitions"
msgstr "ライブラリー定義"

msgid "Provides access to library definition files."
msgstr "ライブラリー定義ファイルへのアクセスを提供します。"

msgid "PHP library files"
msgstr "PHP ライブラリー・ファイル"

msgid "Provides access to PHP library files."
msgstr "PHP ライブラリー・ファイルへのアクセスを提供します。"

