msgid "Advagg External Minification: PHP shell_exec"
msgstr "Externí minimalizace Advagg: PHP shell_exec"

msgid "PHP shell_exec is non-functional."
msgstr "PHP shell_exec není funkční."

msgid "Check php.ini for safemode or <a href=\"@link\" target=\"_blank\">disable_functions</a>."
msgstr "Zkontrolujte soubor php.ini pro bezpečný režim nebo <a href=\"@link\" target=\"_blank\">zakažte_funkce</a>."

msgid "Enabled"
msgstr "Povoleno"

msgid "AdvAgg External Minification"
msgstr "Externí minimalizace AdvAgg"

msgid "Minify Javascript and/or CSS with a command line minifier."
msgstr "Zmenšete Javascript anebo CSS pomocí minifieru příkazového řádku."

msgid "Advanced CSS/JS Aggregation"
msgstr "Rozšířená agregace CSS/JS"

msgid "External Minification"
msgstr "Externí minimalizace"

msgid "AdvAgg external minification settings."
msgstr "Nastavení externí minimalizace AdvAgg."

msgid "AdvAgg: External Minifiers"
msgstr "AdvAgg: Externí minifiery"

msgid "Settings"
msgstr "Nastavení"

msgid "Command line for external CSS minification."
msgstr "Příkazový řádek pro externí minimalizace CSS."

msgid "Whether to use the external CSS minifier if configured."
msgstr "Zda se má použít externí CSS Minifier, je-li nakonfigurovaný."

msgid "Command line for external JavaScript minification."
msgstr "Příkazový řádek pro externí minimalizace JavaScript."

msgid "Whether to use the external JS minifier if configured."
msgstr "Zda se má použít externí JS Minifier, je-li nakonfigurovaný."

msgid "CSS"
msgstr "CSS"

msgid "JavaScript"
msgstr "JavaScript"

msgid "Command Line"
msgstr "Příkazový řádek"

msgid "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = input file. <br /> {%IN_URL_ENC%} = url pointing to the input file that has been url encoded. <br /> {%OUT%} = output file. <br /><br />"
msgstr "{%CWD%} = \\Drupal::root(). <br /> {%IN%} = vstupní soubor. <br /> {%IN_URL_ENC%} = adresa URL ukazující na vstupní soubor, který byl zakódován adresou URL. <br /> {%OUT%} = výstupní soubor. <br /><br />"

msgid "Example using the <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"
msgstr "Příklad použití <a href=\"@link1\">Microsoft Ajax Minifier</a>. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "EPříklad použití <a href=\"@link1\">Google Closure Compiler</a>. <p><code>@code1</code></p>"

msgid "Example using curl to minify via the <a href=\"@link1\">Online Google Closure Compiler</a>. <p><code>@code1</code></p>"
msgstr "Příklad použití curl ke změnšení prostřednictvím <a href=\"@link1\">Online Google Closure Compiler</a>. <p><code>@code1</code></p>"

msgid "Example using the <a href=\"@link1\">YUI Compressor</a>. <p><code>@code1</code></p>"
msgstr "Příklad použití <a href=\"@link1\">YUI Compressor</a>. <p><code>@code1</code></p>"

msgid "Example using curl to minify via an online <a href=\"@link1\">CSS Minifier</a>. <p><code>@code1</code></p>"
msgstr "Příklad použití curl ke změnšení prostřednictvím online <a href=\"@link1\">CSS Minifier</a>. <p><code>@code1</code></p>"

msgid "Command to run"
msgstr "Příkaz určený ke spuštění"

msgid "Enable external @type minification"
msgstr "Povolit externí minimalizaci typu @type"

