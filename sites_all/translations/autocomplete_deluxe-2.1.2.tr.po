msgid "Autocomplete Deluxe"
msgstr "Otomatik Tamamlama Deluxe"

msgid "Enhanced autocomplete using Jquery UI autocomplete."
msgstr "Jquery UI otomatik tamamlamayı kullanan gelişmiş otomatik tamamlama."

msgid "User interface"
msgstr "Kullanıcı arayüzü"

msgid "None"
msgstr "Hiçbiri"

msgid "The entity '@term' will be added."
msgstr "'@term' varlığı eklenecek."

msgid "No terms could be found. Please type in order to add a new term."
msgstr "Terim bulunamadı. Lütfen yeni terim eklemek için yazın."

msgid "No results found"
msgstr "Sonuç bulunamadı"

msgid "Autocomplete Deluxe widget settings"
msgstr "Deluxe otomatik doldurma pencere bileşeni ayarları"

msgid "Match Operator"
msgstr "Eşleştirme İşleci"

msgid "Route Name"
msgstr "Yol Adı"

msgid "Size"
msgstr "Boyut"

msgid "Selection Handler"
msgstr "Seçim İşleyici"

msgid "Limit"
msgstr "Sınır"

msgid "Min Length"
msgstr "Min Uzunluk"

msgid "Delimiter"
msgstr "Ayırıcı"

msgid "Allow \"Not Found\" message"
msgstr "\"Bulunamadı\" iletisine izin ver"

msgid "\"Not Found\" Message"
msgstr "\"Bulunamadı\" İletisi"

msgid "Allow New Terms"
msgstr "Yeni Terimlere İzin Ver"

msgid "No Empty Message"
msgstr "Boş İleti Yok"

msgid "Match operator"
msgstr "Eşleştirme işleci"

msgid "Specify the matcting operator."
msgstr "Eşleştirme işlecini belirtin."

msgid "Limit of the output."
msgstr "Çıkışın sınırı."

msgid "If set to zero no limit will be used"
msgstr "Sıfır olarak ayarlanırsa sınır kullanılmaz"

msgid "Minimum length."
msgstr "Minimum uzunluk."

msgid "The minimum length of characters to enter to open the suggestion list."
msgstr "Öneri listesini açmak için girilecek minimum karakter uzunluğu."

msgid "Delimiter."
msgstr "Sınırlayıcı."

msgid "A character which should be used beside the enter key, to separate terms."
msgstr "Terimleri ayırmak için, Enter tuşunun yanı sıra kullanılacak karakter."

msgid "Show Term not found message"
msgstr "Terim bulunamadı iletisini göster"

msgid "If this is enabled, a message will be displayed when the term is not found."
msgstr "Bu etkinleştirilirse terim bulunamadığından bir ileti görüntülenir."

msgid "Term not found message."
msgstr "Terim bulunamadı iletisi."

msgid "A message text which will be displayed, if the entered term was not found."
msgstr "Girilen metin bulunamadıysa görüntülenecek bir ileti metni."

msgid "Allow new terms"
msgstr "Yeni terimlere izin ver"

msgid "Should it be allowed, that user enter new terms?"
msgstr "Kullanıcının yeni terimler girmesine izin verilmeli mi?"

msgid "Empty value message."
msgstr "Boş değer iletisi."

msgid "A text message that will be displayed when the field is focused and it does not contain values."
msgstr "Alan odaklandığında ve değer içermediğinde görüntülenecek bir metin iletisi."

msgid "Match operator: @match_operator"
msgstr "Eşleştirme işleci: @match_operator"

msgid "Limit: @limit"
msgstr "Sınır: @limit"

msgid "Min length: @min_length"
msgstr "Minimum uzunluk: @min_length"

msgid "Delimiter: @delimiter"
msgstr "Sınırlayıcı: @delimiter"

msgid "Allow Not Found message: @not_found_message_allow"
msgstr "Bulunamadı iletisine izin ver: @not_found_message_allow"

msgid "Not Found message: @not_found_message"
msgstr "Bulunamadı iletisi: @not_found_message"

msgid "Allow new terms: @new_terms"
msgstr "Yeni terimlere izin ver: @new_terms"

msgid "Empty value message: @no_empty_message"
msgstr "Boş değer iletisi: @no_empty_message"

msgid "@not_found_message"
msgstr "@not_found_message"

msgid "@no_empty_message"
msgstr "@no_empty_message"

msgid "Starts with"
msgstr "İle başlayan"

msgid "Contains"
msgstr "İçerir"

