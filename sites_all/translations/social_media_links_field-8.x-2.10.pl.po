msgid "Social Media Links Field"
msgstr "Pole odsyłaczy do mediów społecznościowych"

msgid "The module provides a field type to capture social media profiles."
msgstr "Moduł udostępnia typ pola do przechwytywania profili w mediach społecznościowych."

msgid "Platform"
msgstr "Platforma"

msgid "Appearance"
msgstr "Wygląd"

msgid "Orientation"
msgstr "Orientacja"

msgid "vertical"
msgstr "pionowa"

msgid "horizontal"
msgstr "pozioma"

msgid "Show name"
msgstr "Pokaż nazwę"

msgid "Show the platform name next to the icon."
msgstr "Pokaż nazwę platformy obok ikony."

msgid "Link attributes"
msgstr "Atrybuty odsyłacza"

msgid "Default target"
msgstr "Cel domyślny"

msgid "Remove target attribute"
msgstr "Usuń atrybut docelowy"

msgid "Open in a new browser window or tab (_blank)"
msgstr "Otwórz w nowym oknie przeglądarki lub na nowej karcie (_blank)"

msgid "Open in the current window (_self)"
msgstr "Otwórz w bieżącym oknie (_self)"

msgid "Open in the frame that is superior to the frame the link is in (_parent)"
msgstr "Otwórz w ramce, która jest nadrzędna względem ramki odsyłacza (_parent)"

msgid "Cancel all frames and open in full browser window (_top)"
msgstr "Anuluj wszystkie ramki i otwórz w pełnym oknie przeglądarki (_top)"

msgid "Default rel"
msgstr "Domyślny atrybut rel"

msgid "Remove rel attribute"
msgstr "Usuń atrybut rel"

msgid "Set nofollow"
msgstr "Ustaw wartość nofollow"

msgid "Orientation: @orientation"
msgstr "Orientacja: @orientation"

msgid "Yes"
msgstr "Tak"

msgid "No"
msgstr "Nie"

msgid "Show name: @show_name"
msgstr "Pokaż nazwę: @show_name"

msgid "Default"
msgstr "Domyślne"

msgid "Value"
msgstr "Wartość"

msgid "Platform Values"
msgstr "Wartości platformy"

msgid "Icon Style"
msgstr "Styl ikony"

msgid "Description"
msgstr "Opis"

msgid "Weight"
msgstr "Waga"

msgid "Platforms"
msgstr "Platformy"

msgid "The platforms that are allowed to be used in this field. Select none to allow all platforms."
msgstr "Platformy, które mogą być używane w tym polu. Wybierz opcję Brak, aby zezwolić na wszystkie platformy."

msgid "The description is used for the title and WAI-ARIA attribute."
msgstr "Opis jest używany w przypadku tytułu i atrybutu WAI-ARIA."

msgid "Find / Follow us on %platform"
msgstr "Znajdź nas / obserwuj na platformie %platform"

msgid "Weight for type @type"
msgstr "Waga typu @type"

msgid "Handle links to social media profiles."
msgstr "Obsługuj odsyłacze do profili w mediach społecznościowych."

msgid "List with all available platforms"
msgstr "Lista wszystkich dostępnych platform"

msgid "One available platform (selectable)"
msgstr "Jedna dostępna platforma (wybieralna)"

