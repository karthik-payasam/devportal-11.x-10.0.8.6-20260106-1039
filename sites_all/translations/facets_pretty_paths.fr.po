msgid "Pretty paths coder"
msgstr "Codeur de chemins automatiques"

msgid "Facets Pretty Paths"
msgstr "Chemins automatiques de facettes"

msgid "Pretty paths for Facets."
msgstr "Chemins automatiques pour les facettes."

msgid "Search"
msgstr "Rechercher"

msgid "Facet Pretty Paths third party settings on the Facet config"
msgstr "Paramètres tiers des chemins automatiques de facette sur la configuration de facette"

msgid "The coder plugin ID"
msgstr "ID de plug-in de codeur"

msgid "Home"
msgstr "Accueil"

msgid "Pretty paths"
msgstr "Chemins automatiques"

msgid "Pretty paths uses slashes as separator, e.g. /brand/drupal/color/blue"
msgstr "Les chemins automatiques utilisent des barres obliques comme séparateur, par exemple /brand/drupal/color/blue"

msgid "Default"
msgstr "Par défaut"

msgid "Use the raw value, no special processing is done, e.g. /color/<strong>2</strong>"
msgstr "Utilisez la valeur brute ; aucun traitement particulier n'est effectué, par exemple /color/<strong>2</strong>"

msgid "Node title + id"
msgstr "Titre du noeud + ID"

msgid "Use node title with entity id, e.g. /color/<strong>blue-2</strong>"
msgstr "Utilisez le titre du noeud avec l'ID d'entité, par exemple /color/<strong>blue-2</strong>"

msgid "Taxonomy term name + id"
msgstr "Nom du terme de taxonomie + ID"

msgid "Use term name with term id, e.g. /color/<strong>blue-2</strong>"
msgstr "Utilisez le nom du terme avec son ID, par exemple /color/<strong>blue-2</strong>"

