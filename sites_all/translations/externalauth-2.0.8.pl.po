msgid "External Authentication Map"
msgstr "Odwzorowanie uwierzytelniania zewnętrznego"

msgid "Provider"
msgstr "Usługodawca"

msgid "The name of the authentication provider providing the authname."
msgstr "Nazwa dostawcy uwierzytelniania udostępniającego nazwę uwierzytelniania."

msgid "Authname"
msgstr "Authname"

msgid "Unique authentication name provided by authentication provider."
msgstr "Unikalna nazwa uwierzytelniania udostępniana przez dostawcę uwierzytelniania."

msgid "Drupal User ID"
msgstr "ID użytkownika produktu Drupal"

msgid "The user linked to the authname."
msgstr "Użytkownik powiązany z nazwą authname."

msgid "Linked Drupal user"
msgstr "Powiązany użytkownik produktu Drupal"

msgid "Link to delete @label entry"
msgstr "Odsyłacz do usunięcia wpisu @label"

msgid "Provide a link to delete the @label entry."
msgstr "Podaj odsyłacz, aby usunąć pozycję @label."

msgid "About"
msgstr "O stronie"

msgid "Authenticates users using an external site / service and stores identification details."
msgstr "Uwierzytelnia użytkowników przy użyciu zewnętrznego serwisu&nbsp;/ zewnętrznej usługi i przechowuje szczegółowe informacje dotyczące identyfikacji."

msgid "External Authentication"
msgstr "Uwierzytelnianie zewnętrzne"

msgid "Helper module to authenticate users using an external site / service and storing identification details"
msgstr "Moduł pomocniczy służący do uwierzytelniania użytkowników przy użyciu zewnętrznego serwisu&nbsp;/ zewnętrznej usługi i przechowywania szczegółowych informacji identyfikacyjnych."

msgid "User authentication"
msgstr "Użyj uwierzytelniania"

msgid "View external authentication data"
msgstr "Wyświetl zewnętrzne dane uwierzytelniania"

msgid "Delete external authentication data"
msgstr "Usuń zewnętrzne dane uwierzytelniania"

msgid "Delete authmap entry"
msgstr "Usuń pozycję authmap"

msgid "Authmap change (%old => %new) for user %name with uid %uid from provider %provider"
msgstr "Zmiana authmap (%old => %new) dla użytkownika %name o uid %uid od dostawcy %provider"

msgid "External registration of user %name from provider %provider and authname %authname"
msgstr "Rejestracja zewnętrzna użytkownika %name o nazwie uwierzytelniania %authname od dostawcy %provider"

msgid "External login of user %name"
msgstr "Zewnętrzne dane logowania użytkownika %name"

msgid "Are you sure you want to delete the link between authentication name %id and Drupal user %user?"
msgstr "Czy na pewno chcesz usunąć powiązanie między nazwą uwierzytelniania %id, a użytkownikiem produktu Drupal %user?"

msgid "No authmap record found for provider @provider / uid @uid."
msgstr "Nie znaleziono rekordu authmap dla dostawcy @provider/identyfikatora @uid."

msgid "The link has been deleted."
msgstr "Powiązanie zostało usunięte."

msgid "User’s users.uid."
msgstr "Plik users.uid użytkownika."

msgid "Unique authentication name."
msgstr "Unikalna nazwa uwierzytelniania."

msgid "Module which is controlling the authentication."
msgstr "Moduł sterujący uwierzytelnianiem."

msgid "delete"
msgstr "usuń"

msgid "Output the URL as text"
msgstr "Wyświetl adres URL jako tekst"

msgid "Use absolute link (begins with \"http://\")"
msgstr "Używaj odnośników bezwzględnych (zaczynają się od \"http://\")"

msgid "Enable this option to output an absolute link. Required if you want to use the path as a link destination."
msgstr "Włącz tą opcję aby wypisywać odnośniki absolutne. Jest to wymagane w przypadku używania ścieżki jako miejsca docelowego."

