msgid "No destination directory provided."
msgstr "Nenhum diretório de destino fornecido."

msgid "About"
msgstr "Sobre"

msgid "Helper module to quickly import a list of terms with parent structure."
msgstr "Módulo auxiliar para importar rapidamente uma lista de termos com estrutura pai."

msgid "Term CSV Export/Import"
msgstr "Exportação/Importação CSV de Termo"

msgid "Import and Export Taxonomy terms as csv."
msgstr "Importar e Exportar termos de Taxonomia como CSV."

msgid "Taxonomy"
msgstr "Taxonomia"

msgid "Import and Export Taxonomy Terms as CSV"
msgstr "Importar e Exportar Termos de Taxonomia como CSV"

msgid "Term CSV Import"
msgstr "Importação CSV de Termo"

msgid "Term CSV Export"
msgstr "Exportação CSV de Termo"

msgid "Administer CSV Term Import"
msgstr "Administrar a Importação de Termo CSV"

msgid "Allows a user to import taxonomy terms."
msgstr "Permite que um usuário importe termos de taxonomia."

msgid "CSV Term Import"
msgstr "Importação de Termo CSV"

msgid "CSV Term Export"
msgstr "Exportação de Termo CSV"

msgid "The header keys were not included in the import."
msgstr "As chaves do cabeçalho não foram incluídas na importação."

msgid "Line with \"@part\" could not be parsed. Incorrect number of values: @count."
msgstr "A linha com \"@part\" não pôde ser analisada. Número incorreto de valores: @count."

msgid "The term @name has multiple matches. Ignoring."
msgstr "O termo @name possui múltiplas correspondências. Ignorando."

msgid "The term with id @id already exists and preserve existing terms is checked. No modification has been made."
msgstr "O termo com o ID @id já existe e os termos existentes preservados são verificados. Nenhuma modificação foi feita."

msgid "The Term ID already exists."
msgstr "O ID do Termo já existe."

msgid "More than 1 terms are named @name. Cannot distinguish by name. Try using id export/import."
msgstr "Mais de 1 termo é denominado @name. Não é possível distinguir por nome. Tente usar exportação/importação de ID."

msgid "The field data <em>@data</em> is not formatted correctly. Please use the export function."
msgstr "Os dados do campo <em>@data</em> não estão formatados corretamente. Use a função de exportação."

msgid "The field data <em>@data</em> could not be imported. Please add the appropriate fields to the vocabulary you are importing into."
msgstr "Os dados do campo <em>@data</em> não puderam ser importados. Inclua os campos apropriados no vocabulário no qual você está importando."

msgid "Imported @count terms."
msgstr "Importados @count termos."

msgid "Include Term Ids in export."
msgstr "Incluir IDs de Termo na exportação."

msgid "Include Term Headers in export."
msgstr "Incluir Cabeçalhos de Termo na exportação."

msgid "Include extra fields in export."
msgstr "Incluir campos extras na exportação."

msgid "Note that fields are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"
msgstr "Observe que os campos estão em sequência usando <a href=\"http://www.php.net/http_build_query\">http_build_query</a>"

msgid "Export"
msgstr "Exportar"

msgid "CSV Data"
msgstr "Dados CSV"

msgid "The formatted term data"
msgstr "Os dados do termo formatado"

msgid "Input"
msgstr "Input"

msgid "<p><strong>See CSV Export for an example.</strong></p><p>Enter in the form of: <pre>\"name,status,description,format,weight,parent_name,[any_additional_fields];</pre><pre>name,status,description,format,weight,parent_name[;parent_name1;parent_name2;...],[any_additional_fields]\"</pre> or <pre>\"tid,uuid,name,status,revision_id,description,format,weight,parent_name[;parent_name1;parent_name2;...],parent_tid[;parent_tid1;parent_tid2;...],[any_additional_fields];</pre><pre>tid,uuid,name,status,revision_id,description,format,weight,parent_name,parent_tid,[any_additional_fields]\"</pre> Note that <em>[any_additional_fields]</em> are optional and are stringified using <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>If you need to export from Drupal 7, you can import and modify the view d7exportview.txt found at the root directory of this project</p>"
msgstr "<p><strong>Consulte a Exportação CSV para obter um exemplo.</strong></p><p>Insira na forma de: <pre>\"name,status,description,format,weight,parent_name,[any_additional_fields];</pre><pre>name,status,description,format,weight,parent_name[;parent_name1;parent_name2;...],[any_additional_fields]\"</pre> ou <pre>\"tid,uuid,name,status,revision_id,description,format,weight,parent_name[;parent_name1;parent_name2;...],parent_tid[;parent_tid1;parent_tid2;...],[any_additional_fields];</pre><pre>tid,uuid,name,status,revision_id,description,format,weight,parent_name,parent_tid,[any_additional_fields]\"</pre> Observe que <em>[any_additional_fields]</em> são opcionais e estão em sequência usando <a href=\"http://www.php.net/http_build_query\">http_build_query</a>.</p><p>Se precisar exportar por meio do Drupal 7, será possível importar e modificar a visualização d7exportview.txt localizada no diretório raiz deste projeto</p>"

msgid "Preserve Vocabularies on existing terms."
msgstr "Preservar Vocabulários em termos existentes."

msgid "Preserve existing terms. This will prevent a term id collision if importing from another install."
msgstr "Preservar os termos existentes. Isso evitará uma colisão de ID de termo se estiver importando de outra instalação."

msgid "Next"
msgstr "Próximo"

msgid "Name"
msgstr "Nome"

msgid "Create New Vocabulary"
msgstr "Criar Novo Vocabulário"

msgid "Create Vocabulary"
msgstr "Criar Vocabulário"

msgid "Are you sure you want to copy @count_terms terms into the vocabulary @vocabulary@preserve_vocabularies?"
msgstr "Tem certeza de que deseja copiar os termos de @count_terms para o vocabulary @vocabulary@preserve_vocabularies?"

msgid "Import"
msgstr "Importar"

