msgstr "Schlüssel hinzufügen"

msgid "Edit key"
msgstr "Schlüssel bearbeiten"

msgid "Delete Key"
msgstr "Schlüssel löschen"

msgid "Key Configuration Overrides"
msgstr "Überschreibungen für Schlüsselkonfiguration"

