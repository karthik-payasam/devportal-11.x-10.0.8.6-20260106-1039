msgstr "Überschreibung für eine Schlüsselkonfiguration hinzufügen"

msgid "Delete Key Configuration Override"
msgstr "Überschreibung für Schlüsselkonfiguration löschen"

msgid "ID"
msgstr "ID"

msgid "Label"
msgstr "Beschriftung"

msgid "Description"
msgstr "Beschreibung"

