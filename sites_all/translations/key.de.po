msgid "File key provider settings updated."
msgstr "Einstellungen für Dateischlüsselprovider aktualisiert."

msgid "Key configuration overrides updated."
msgstr "Überschreibungen für Schlüsselkonfiguration aktualisiert."

msgid "Key"
msgstr "Schlüssel"

msgid "Provides the ability to manage site-wide keys."
msgstr "Ermöglicht die Verwaltung von Schlüsseln für die gesamte Website."

msgid "Security"
msgstr "Sicherheit"

msgid "Add Key"
msgstr "Schlüssel hinzufügen"

msgid "Add Override"
msgstr "Überschreibung hinzufügen"

msgid "Keys"
msgstr "Schlüssel"

msgid "Manage site-wide keys."
msgstr "Schlüssel für die gesamte Website verwalten."

msgid "Key Overrides"
msgstr "Schlüsselüberschreibungen"

msgid "Administer keys"
msgstr "Schlüssel verwalten"

msgid "Create, edit, and delete site-wide keys."
msgstr "Schlüssel für die gesamte Website erstellen, bearbeiten und löschen."

msgid "Administer key configuration overrides"
msgstr "Überschreibungen für Schlüsselkonfiguration verwalten"

