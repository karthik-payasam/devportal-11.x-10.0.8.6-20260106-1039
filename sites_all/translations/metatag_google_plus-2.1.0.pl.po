msgid "Metatag: Google Plus"
msgstr "Metaznacznik: Google Plus"

msgid "Provides support for Google's Plus meta tags. Deprecated, will be removed in Metatag 2.0.0."
msgstr "Udostępnia obsługę metaznaczników serwisu Google Plus. Nieaktualne, zostaną usunięte w Metatag 2.0.0."

msgid "SEO"
msgstr "SEO"

msgid "Google Plus: name"
msgstr "Google Plus: nazwa"

msgid "Google Plus: image"
msgstr "Google Plus: obraz"

msgid "Google Plus: description"
msgstr "Google Plus: opis"

msgid "Publisher URL"
msgstr "Adres URL publikatora"

msgid "Author"
msgstr "Autor"

msgid "Google Plus"
msgstr "Google Plus"

msgid "DEPRECATED, use Advanced-Author instead."
msgstr "NIEAKTUALNE, zamiast tego użyj opcji Advanced-Author."

msgid "Description"
msgstr "Opis"

msgid "Content description less than 200 characters."
msgstr "Opis treści krótszy niż 200 znaków."

msgid "Image"
msgstr "Obraz"

msgid "The URL of an image which should represent the content. For best results use an image that is at least 1200 x 630 pixels in size, but at least 600 x 316 pixels is a recommended minimum. Supports PNG, JPEG and GIF formats."
msgstr "Adres URL obrazu reprezentującego treść. W celu uzyskania najlepszych wyników należy użyć obrazu o wielkości co najmniej 1200 x 630 piksli, przy czym 600 x 316 piksli to zalecane minimum. Obsługiwane formaty to PNG, JPEG i GIF."

msgid "Name"
msgstr "Nazwa"

msgid "Content title."
msgstr "Tytuł treści."

msgid "Used by some search engines to confirm publication of the content on a page. Should be the full URL for the publication's Google+ profile page."
msgstr "Używany przez niektóre wyszukiwarki do potwierdzenia publikacji treści na stronie. Powinien to być pełny adres URL strony profilu Google+ dla publikacji."

