msgstr "Ankieta %poll usunięta."

msgid "Add new poll"
msgstr "Dodaj nową ankietę"

msgid "Edit @label"
msgstr "Edytuj @label"

msgid "A feed named %feed already exists. Enter a unique question."
msgstr "Kanał informacyjny o nazwie %feed już istnieje. Wprowadź unikalne pytanie."

msgid "The poll %poll has been updated."
msgstr "Ankieta %poll została zaktualizowana."

msgid "The poll %poll has been added."
msgstr "Ankieta %poll została dodana."

msgid "Poll %poll added."
msgstr "Ankieta %poll dodana."

msgid "Are you sure you want to delete all items from the feed %feed?"
msgstr "Czy na pewno usunąć wszystkie elementy z kanału %feed?"

msgid "Delete items"
msgstr "Usuń pozycje"

msgid "There are no settings yet."
msgstr "Nie ma jeszcze żadnych ustawień."

msgid "Vote"
msgstr "Głosuj"

msgid "Your vote for this poll has already been submitted."
msgstr "Twój głos w tej ankiecie został już wysłany. "

msgid "Choices"
msgstr "Wybory"

msgid "Cancel vote"
msgstr "Anuluj głos"

msgid "View poll"
msgstr "Wyświetl ankietę"

msgid "View results"
msgstr "Wyświetl wyniki"

msgid "@percentage%"
msgstr "@percentage%"

msgid "Your vote was cancelled."
msgstr "Twój głos został anulowany."

msgid "Your vote has been recorded."
msgstr "Twój głos został zapisany. "

msgid "Your vote could not be recorded because you did not select any of the choices."
msgstr "Nie wybrano żadnej z dostępnych odpowiedzi."

msgid "%user's vote in Poll #%poll deleted."
msgstr "Głos użytkownika %user w ankiecie #%poll został usunięty."

