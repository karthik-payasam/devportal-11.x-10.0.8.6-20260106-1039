msgid "About"
msgstr "Hakkında"

msgid "The Admin Toolbar Search module add a search option to the toolbar for site administrative tasks."
msgstr "Yönetici Araç Çubuğu Arama modülü, site yönetimiyle ilgili görevler için araç çubuğuna bir arama seçeneği ekler."

msgid "Search"
msgstr "Ara"

msgid "Admin Toolbar quick search"
msgstr "Yönetici Araç Çubuğu hızlı arama"

msgid "Admin Toolbar Search"
msgstr "Yönetici Araç Çubuğu Arama"

msgid "Provides search of Admin Toolbar items."
msgstr "Yönetici Araç Çubuğu öğelerinin aranmasını sağlar."

msgid "Administration"
msgstr "Yönetim"

msgid "Configure the Admin Toolbar Search module."
msgstr "Yönetim Araç Çubuğu Arama modülünü yapılandırın."

msgid "Use Admin Toolbar search"
msgstr "Yönetici Araç Çubuğu aramasını kullan"

msgid "Admin toolbar search settings"
msgstr "Yönetici araç çubuğu arama ayarları"

msgid "Admin Toolbar Search settings"
msgstr "Yönetici Araç Çubuğu Arama ayarları"

msgid "How the search input will be displayed"
msgstr "Arama girişinin nasıl görüntüleneceği"

msgid "@entity_type > @bundle"
msgstr "@entity_type > @bundle"

msgid "Edit"
msgstr "Düzenle"

msgid "Manage fields"
msgstr "Alanları yönet"

msgid "Manage form display"
msgstr "Form görünümünü yönet"

msgid "Manage display"
msgstr "Görünümü yönet"

msgid "Devel"
msgstr "Gelişt."

