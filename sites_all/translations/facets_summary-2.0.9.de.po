msgid "Facets summary (Experimental)"
msgstr "Facettenzusammenfassung (experimentell)"

msgid "Exposes a Facets block summary showing the current search."
msgstr "Stellt eine Facetten-Blockzusammenfassung bereit, in der die aktuelle Suche angezeigt wird."

msgid "Search"
msgstr "Suchen"

msgid "Add facet summary"
msgstr "Facettenzusammenfassung hinzufügen"

msgid "Edit facets summary"
msgstr "Facettenzusammenfassung bearbeiten"

msgid "Edit"
msgstr "Bearbeiten"

msgid "Facet Summary settings"
msgstr "Facettenzusammenfassungseinstellungen"

msgid "Facet"
msgstr "Facette"

msgid "ID"
msgstr "ID"

msgid "Name"
msgstr "Name"

msgid "Facet source id"
msgstr "Facettenquellen-ID"

msgid "Processor settings"
msgstr "Prozessoreinstellungen"

msgid "A processor"
msgstr "Ein Prozessor"

msgid "The plugin ID of the processor"
msgstr "Die Plug-in-ID des Prozessors"

msgid "The processors weight for this stage"
msgstr "Die Gewichtung des Prozessors für diese Stufe"

msgid "the weight"
msgstr "die Gewichtung"

msgid "Facets configuration"
msgstr "Facettenkonfiguration"

msgid "Is this facet enabled"
msgstr "Ist diese Facette aktiviert"

msgid "Label"
msgstr "Bezeichnung"

msgid "Results separator"
msgstr "Ergebnistrennzeichen"

msgid "Show count on items"
msgstr "Zähler für Elemente anzeigen"

msgid "Facet Weight"
msgstr "Facettengewichtung"

msgid "No results behavior"
msgstr "Kein Ergebnisverhalten"

msgid "The text to show when there is no current search"
msgstr "Der Text, der angezeigt werden soll, wenn keine aktuelle Suche vorhanden ist."

msgid "Reset facets link"
msgstr "Facettenzurücksetzungslink"

msgid "The text to show for the reset link."
msgstr "Der Text, der für den Zurücksetzungslink angezeigt werden soll."

msgid "Position of the reset link."
msgstr "Position des Zurücksetzungslinks."

msgid "Processor @id specifies a non-existing @class."
msgstr "Prozessor @id gibt eine nicht vorhandene @class an."

msgid "Facet summary"
msgstr "Facettenzusammenfassung"

msgid "Edit %label facets summary"
msgstr "Facettenzusammenfassung %label bearbeiten"

msgid "Enabled facets"
msgstr "Aktivierte Facetten"

msgid "Separator"
msgstr "Trennzeichen"

msgid "Show counts"
msgstr "Zähler anzeigen"

msgid "Weight"
msgstr "Gewichtung"

msgid "Select the facets to be shown in the summary block. You can reorder them."
msgstr "Wählen Sie die Facetten aus, die im Zusammenfassungsblock angezeigt werden sollen. Sie können sie neu sortieren."

msgid "Weight for @title"
msgstr "Gewichtung für @title"

msgid "No facets found."
msgstr "Keine Facetten gefunden."

msgid "Facets Summary settings"
msgstr "Facettenzusammenfassungseinstellungen"

msgid "%processor settings"
msgstr "Einstellungen für %processor"

msgid "Advanced settings"
msgstr "Erweiterte Einstellungen"

msgid "Processor order"
msgstr "Prozessorreihenfolge"

msgid "Weight for processor %title"
msgstr "Gewichtung für Prozessor %title"

msgid "Facets Summary %name has been updated."
msgstr "Facettenzusammenfassung %name wurde aktualisiert."

msgid "Add facets summary"
msgstr "Facettenzusammenfassung hinzufügen"

msgid "Facets settings for %label"
msgstr "Facetteneinstellungen für %label"

msgid "You currently have no facet sources defined. You should start by adding a facet source before creating facets."
msgstr "Es sind momentan keine Facettenquellen definiert. Sie sollten zunächst eine Facettenquelle hinzufügen, bevor Sie Facetten erstellen."

msgid "Facet source"
msgstr "Facettenquelle"

msgid "The source where this summary will be built from."
msgstr "Die Quelle, aus der diese Zusammenfassung erstellt wird."

msgid "The administrative name used for this summary."
msgstr "Der für diese Zusammenfassung verwendete Verwaltungsname."

msgid "Facet Summary %name has been created. Go to the <a href=\":block_overview\">Block overview page</a> to place the new block in the desired region."
msgstr "Facettenzusammenfassung %name wurde erstellt. Rufen Sie die Seite <a href=\":block_overview\">Blockübersichtsseite</a> auf, um den neuen Block in der gewünschten Region abzulegen."

msgid "Facet %name has been updated."
msgstr "Facette %name wurde aktualisiert."

msgid "Caching of view %view has been disabled."
msgstr "Das Zwischenspeichern der Ansicht %view wurde inaktiviert."

msgid "Facet Summary: :facet_summary"
msgstr "Facettenzusammenfassung: :facet_summary"

msgid "Facets Summary"
msgstr "Facettenzusammenfassung"

msgid "In preview"
msgstr "In Vorschau"

msgid "Hide Summary when Facet Source is not rendered"
msgstr "Zusammenfassung ausblenden, wenn die Facettenquelle nicht wiedergegeben wird"

msgid "When checked, this facet will only be rendered when the facet source is rendered. If you want to show facets on other pages too, you need to uncheck this setting."
msgstr "Wenn diese Option aktiviert ist, wird diese Facette nur dann wiedergegeben, wenn die Facettenquelle wiedergegeben wird. Wenn Sie Facetten auch auf anderen Seiten anzeigen möchten, müssen Sie diese Einstellung abwählen."

msgid "Reset"
msgstr "Zurücksetzen"

msgid "Reset facets link text"
msgstr "Text für Facettenzurücksetzungslink"

msgid "Show reset link before facets links"
msgstr "Zurücksetzungslink vor Facettenlinks anzeigen"

msgid "Show reset link after facets links"
msgstr "Zurücksetzungslink nach Facettenlinks anzeigen"

msgid "Show only reset link"
msgstr "Nur Zurücksetzungslink anzeigen"

msgid "Position"
msgstr "Position"

msgid "Set position of the link to display it before, after or instead of facets links."
msgstr "Legen Sie die Position des Links fest, um ihn vor, nach oder anstelle von Facettenlinks anzuzeigen."

msgid "Adds reset facets link."
msgstr "Fügt einen Facettenzurücksetzungslink hinzu."

msgid "When checked, this facet will add a link to reset enabled facets."
msgstr "Wenn diese Option aktiviert ist, fügt diese Facette einen Link zum Zurücksetzen aktivierter Facetten hinzu."

msgid "Show a summary of how many results were found"
msgstr "Eine Zusammenfassung davon anzeigen, wie viele Ergebnisse gefunden wurden"

msgid "When checked, this will show the amount of results found."
msgstr "Wenn diese Option aktiviert ist, wird die Anzahl gefundener Ergebnisse angezeigt."

msgid "Show a summary of all selected facets"
msgstr "Eine Zusammenfassung aller ausgewählten Facetten anzeigen"

msgid "When checked, this facet will show an imploded list of all selected facets."
msgstr "Wenn diese Option aktiviert ist, zeigt diese Facette eine implodierte Liste aller ausgewählten Facetten an."

msgid "Empty text"
msgstr "Leerer Text"

msgid "No results found."
msgstr "Keine Ergebnisse gefunden."

msgid "Show a text when there are no results"
msgstr "Einen Text anzeigen, wenn keine Ergebnisse vorhanden sind"

msgid "Show a text when there are no results, otherwise it will hide the block."
msgstr "Einen Text anzeigen, wenn keine Ergebnisse vorhanden sind. Andernfalls wird der Block ausgeblendet."

msgid "Build stage"
msgstr "Buildstufe"

msgid "1 result found"
msgid_plural "@count results found"
msgstr[0] "1 Ergebnis gefunden"
msgstr[1] "@count Ergebnisse gefunden"

