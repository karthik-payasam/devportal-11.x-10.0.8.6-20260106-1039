msgstr "Text, který se zobrazuje, nebyla-li vybrána určitá volba filtru"

msgid "Text format for the text_input_required field"
msgstr "Formát textu pro povinné vstupní textové pole"

msgid "BEF options"
msgstr "Volby BEF "

msgid "Filters"
msgstr "Filtry"

msgid "General BEF settings"
msgstr "Obecná nastavení BEF"

msgid "Auto-submit"
msgstr "Automaticky odeslat"

msgid "Exclude Textfield"
msgstr "Vyloučit textové pole"

