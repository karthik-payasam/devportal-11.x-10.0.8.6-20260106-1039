msgstr "De tag immutable toevoegen aan tekenreeksen voor Apache-cachebesturing."

msgid "JavaScript specific settings."
msgstr "Specifieke JavaScript-instellingen."

msgid "Do not change external to file if on same host for js."
msgstr "Wijzig extern niet in bestand indien op dezelfde host voor js."

msgid "Skip preprocess check on status page"
msgstr "Controle van voorverwerking overslaan op statuspagina"

