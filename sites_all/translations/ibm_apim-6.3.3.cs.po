msgstr "%theme je nyní výchozí motiv."

msgid "The %theme theme has been uninstalled."
msgstr "Motiv %theme byl odinstalován."

msgid "Only custom themes can be uninstalled. %theme is not a custom theme. If it is a Custom theme then it may still be active"
msgstr "Odinstalovat lze pouze vlastní motivy. %theme není vlastní motiv. Pokud se jedná o vlastní motiv, může být stále aktivní"

msgid "There was an error deleting the theme. Please contact your system administrator."
msgstr "Při odstraňování motivu došlo k chybě. Kontaktujte administrátora systému."

msgid "Unable to enable @extension, %config_names already exists in active configuration."
msgid_plural "Unable to enable @extension, %config_names already exist in active configuration."
msgstr[0] "Nelze povolit @extension, %config_names již existuje v aktivní konfiguraci."
