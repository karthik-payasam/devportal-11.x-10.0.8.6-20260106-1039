msgid "Finished @num elements and @num_translations translations created successfully."
msgstr "@num Elemente beendet und @num_translations Übersetzungen erfolgreich erstellt."

msgid "Finished @num elements created successfully."
msgstr "Erstellung von @num Elementen erfolgreich abgeschlossen."

msgid "Finished with an error."
msgstr "Mit einem Fehler beendet."

msgid "Generate @label"
msgstr "@label generieren"

msgid "Generate"
msgstr "Generieren"

msgid "Generate realistic items (content, users, menus, etc) to assist your site development and testing."
msgstr "Generieren Sie realistische Elemente (Inhalt, Benutzer, Menüs usw.), um Siteentwicklung und -test zu unterstützen."

msgid "Devel generate"
msgstr "Mit Devel generiert"

msgid "Devel Generate"
msgstr "Devel generieren"

msgid "Generate test users, nodes, menus, taxonomy terms..."
msgstr "Generieren von Testbenutzern, Knoten, Menüs, Taxonomiebegriffen..."

msgid "Development"
msgstr "Entwicklung"

msgid "Administer devel_generate"
msgstr "devel_generate verwalten"

msgid "Language"
msgstr "Sprache"

msgid "Select the primary language(s) for @items"
msgstr "Primäre Sprache(n) für @items auswählen"

msgid "Disabled - requires Language module"
msgstr "Inaktiviert - Sprachmodul erforderlich"

msgid "Select the language(s) for translated @items"
msgstr "Sprache(n) für übersetzte @items auswählen"

msgid "Translated @items will be created for each language selected."
msgstr "Übersetzte @items werden für jede ausgewählte Sprache erstellt."

msgid "Disabled - requires Content Translation module."
msgstr "Inaktiviert - Inhaltsübersetzungsmodul erforderlich."

msgid "@permission"
msgstr "@permission"

msgid "Failed to generate elements due to \"%error\"."
msgstr "Generieren von Elementen aufgrund von \"%error\" fehlgeschlagen."

msgid "You do not have any content types that can be generated. <a href=\":create-type\">Go create a new content type</a>"
msgstr "Sie verfügen über keine Inhaltstypen, die erstellt werden können. <a href=\":create-type\">Erstellen Sie einen neuen Inhaltstyp</a>"

msgid "Hidden"
msgstr "Ausgeblendet"

msgid "Closed"
msgstr "Geschlossen"

msgid "Open"
msgstr "Open"

msgid "No comment fields"
msgstr "Keine Kommentarfelder"

msgid "Content type"
msgstr "Inhaltstyp"

msgid "Comments"
msgstr "Kommentare"

msgid "<strong>Delete all content</strong> in these content types before generating new content."
msgstr "<strong>Löschen Sie alle Inhalte</strong> in diesen Inhaltstypen, bevor Sie neue Inhalte erstellen."

msgid "How many nodes would you like to generate?"
msgstr "Wie viele Knoten sollen erstellt werden?"

msgid "Now"
msgstr "Jetzt"

msgid "ago"
msgstr "vor"

msgid "How far back in time should the nodes be dated?"
msgstr "Wie weit in die Vergangenheit dürfen die Knoten datiert sein?"

msgid "Node creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "Die Daten der Knotenerstellung werden willkürlich vom aktuellen Zeitpunkt aus bis zurück zum ausgewählten Zeitpunkt verteilt."

msgid "Maximum number of comments per node."
msgstr "Maximale Anzahl der Kommentare pro Knoten."

msgid "You must also enable comments for the content types you are generating. Note that some nodes will randomly receive zero comments. Some will receive the max."
msgstr "Sie müssen auch Kommentare für die Inhaltstypen aktivieren, die Sie erstellen. Beachten Sie, dass einige Knoten willkürlich keine Kommentare erhalten. Einige erhalten die maximal mögliche Anzahl."

msgid "Maximum number of words in titles"
msgstr "Maximale Anzahl an Wörtern in Titeln"

msgid "Fields to leave empty"
msgstr "Felder, die leer bleiben sollen"

msgid "Enter the field names as a comma-separated list. These will be skipped and have a default value in the generated content."
msgstr "Geben Sie die Feldnamen als durch Kommas getrennte Liste ein. Diese werden übersprungen und haben einen Standardwert im generierten Inhalt."

msgid "Base fields to populate"
msgstr "Basisfelder zum Füllen"

msgid "Enter the field names as a comma-separated list. These will be populated."
msgstr "Geben Sie die Feldnamen als durch Kommas getrennte Liste ein. Diese werden gefüllt."

msgid "Prefix the title with the content type label."
msgstr "Stellen Sie dem Titel die Inhaltstypbezeichnung voran."

msgid "This will not count against the maximum number of title words specified above."
msgstr "Dies wird nicht zur oben festgelegten maximalen Anzahl an Titelwörtern hinzugezählt."

msgid "Requires path.module"
msgstr "Erfordert 'path.module'"

msgid "Add an url alias for each node."
msgstr "Fügen Sie einen URL-Aliasnamen für jeden Knoten hinzu."

msgid "Add statistics for each node (node_counter table)."
msgstr "Fügen Sie Statistikdaten für jeden Knoten hinzu (node_counter table)."

msgid "User ID"
msgstr "Benutzer-ID"

msgid "Name"
msgstr "Name"

msgid "Role(s)"
msgstr "Rolle(n)"

msgid "Users"
msgstr "Benutzer"

msgid "Select users for randomly assigning as authors of the generated content. Leave all unchecked to use a random selection of up to 50 users."
msgstr "Wählen Sie benutzer aus, um sie zufällig als Autoren des generierten Inhalts zuzuweisen. Lassen Sie alle unausgewählt, um eine Zufallsauswahl von bis zu 50 Benutzern zu verwenden."

msgid "Please select at least one content type"
msgstr "Wählen Sie mindestens einen Inhaltstyp aus"

msgid "Generating Content"
msgstr "Inhalt wird gerade erstellt"

msgid "Deleted %count nodes."
msgstr "%count Knoten gelöscht."

msgid "Completed @feedback nodes (@rate nodes/min)"
msgstr "@feedback-Knoten abgeschlossen (@rate Knoten/min)"

msgid "No content types available"
msgstr "Es sind keine Inhaltstypen vorhanden."

msgid "To delete content, please provide the content types (--bundles)"
msgstr "Geben Sie zum Löschen von Inhalt die Inhaltstypen an (--bundles)"

msgid "One or more content types have been entered that don't exist on this site"
msgstr "Es wurde mindestens ein Inhaltstyp eingegeben, der auf dieser Website nicht vorhanden ist"

msgid "Created 1 node"
msgid_plural "Created @count nodes"
msgstr[0] "1 Knoten erstellt"
msgstr[1] "@count Knoten erstellt"

msgid "Created 1 node translation"
msgid_plural "Created @count node translations"
msgstr[0] "1 Knotenübersetzung erstellt"
msgstr[1] "@count Knotenübersetzung erstellt"

msgid "content"
msgstr "content"

msgid "Generate a given number of content. Optionally delete current content."
msgstr "Erstellt eine bestimmte Anzahl an Inhalten. Löscht optional den aktuellen Inhalt."

msgid "You do not have any media types that can be generated. <a href=\":url\">Go create a new media type</a>"
msgstr "Sie verfügen über keine Medientypen, die erstellt werden können. <a href=\":url\">Erstellen Sie einen neuen Medientyp</a>"

msgid "Media type"
msgstr "Medientyp"

msgid "<strong>Delete all media</strong> in these types before generating new media."
msgstr "<strong>Löschen Sie alle Medien</strong> in diesen Typen, bevor Sie neue Medien erstellen."

msgid "How many media items would you like to generate?"
msgstr "Wie viele Medienelemente sollen erstellt werden?"

msgid "How far back in time should the media be dated?"
msgstr "Wie weit in die Vergangenheit dürfen die Medien datiert sein?"

msgid "Media creation dates will be distributed randomly from the current time, back to the selected time."
msgstr "Die Daten der Medienerstellung sind willkürlich zwischen dem aktuellen Zeitpunkt und dem ausgewählten Zeitpunkt in der Vergangenheit verteilt."

msgid "Maximum number of words in names"
msgstr "Maximale Anzahl an Wörtern in Namen"

msgid "Set language on media"
msgstr "Sprache für Medien festlegen"

msgid "Requires locale.module"
msgstr "Erfordert 'locale.module'"

msgid "Please select at least one media type"
msgstr "Wählen Sie mindestens einen Medientyp aus."

msgid "Generating media items"
msgstr "Medienelemente erstellen"

msgid "Deleted %count media items."
msgstr "%count Medienelemente wurden gelöscht."

msgid "Completed !feedback media items (!rate media/min)"
msgstr "!feedback Medienelemente abgeschlossen (!rate Medien/Min)"

msgid "No media types available"
msgstr "Keine Medientypen verfügbar"

msgid "1 media item created."
msgid_plural "Finished creating @count media items."
msgstr[0] "1 Medientyp erstellt."
msgstr[1] "Erstellung von @count Medientypen abgeschlossen."

msgid "media"
msgstr "Datenträger"

msgid "Generate a given number of media entities."
msgstr "Generiert eine bestimmte Anzahl von Medienentitäten."

msgid "Create new menu(s)"
msgstr "Neue Menüs erstellen"

msgid "Generate links for these menus"
msgstr "Links für folgende Menüs erstellen"

msgid "Number of new menus to create"
msgstr "Anzahl neuer Menüs, die erstellt werden sollen"

msgid "Number of links to generate"
msgstr "Anzahl der zu erstellenden Links"

msgid "Maximum length for menu titles and menu links"
msgstr "Maximale Länge für Menütitel und Menülinks"

msgid "Text will be generated at random lengths up to this value. Enter a number between 2 and 128."
msgstr "Der Text wird mit einer zufälligen Länge von maximal diesem Wert erstellt. Geben Sie eine Zahl zwischen 2 und 128 ein."

msgid "Types of links to generate"
msgstr "Zu erstellende Linktypen"

msgid "Nodes"
msgstr "Knoten"

msgid "Front page"
msgstr "Titelseite"

msgid "External"
msgstr "Extern"

msgid "Maximum link depth"
msgstr "Maximale Linktiefe"

msgid "Maximum menu width"
msgstr "Maximale Menübreite"

msgid "Limit the width of the generated menu's first level of links to a certain number of items."
msgstr "Die Breite der obersten Ebene des erstellten Menüs auf eine bestimmte Anzahl an Elementen begrenzen."

msgid "Delete existing custom generated menus and menu links before generating new ones."
msgstr "Vorhandene individuell erstellte Menüs und Menülinks löschen, bevor neue erstellt werden."

msgid "Deleted @menus_deleted menu(s) and @links_deleted other link(s)."
msgstr "@menus_deleted Menü(s) und @links_deleted weitere Links gelöscht."

msgid "Description of @name"
msgstr "Beschreibung von @name"

msgid "Description of @title."
msgstr "Beschreibung von @title."

msgid "Invalid number of menus"
msgstr "Ungültige Anzahl an Menüs"

msgid "Invalid number of links"
msgstr "Ungültige Anzahl an Links"

msgid "Invalid maximum link depth. Use a value between 1 and 9"
msgstr "Ungültige maximale Linktiefe. Verwenden Sie einen Wert zwischen 1 und 9"

msgid "Invalid maximum menu width. Use a positive numeric value."
msgstr "Ungültige maximale Menübreite. Geben Sie einen positiven numerischen Wert an."

msgid "Created the following 1 new menu: @menus"
msgid_plural "Created the following @count new menus: @menus"
msgstr[0] "Das folgende neue Menü wurde erstellt: @menus"
msgstr[1] "Die folgenden @count neuen Menüs wurden erstellt: @menus"

msgid "Created 1 new menu link."
msgid_plural "Created @count new menu links."
msgstr[0] "Es wurde ein neuer Menülink erstellt."
msgstr[1] "Es wurden @count neue Menülinks erstellt."

msgid "menus"
msgstr "Menüs"

msgid "Generate a given number of menus and menu links. Optionally delete current menus."
msgstr "Erstellt eine bestimmte Anzahl an Menüs und Menülinks. Löscht optional aktuelle Menüs."

msgid "Vocabularies"
msgstr "Vokabulare"

msgid "Restrict terms to these vocabularies."
msgstr "Begriffe auf diese Vokabulare beschränken."

msgid "Number of terms"
msgstr "Anzahl der Begriffe"

msgid "Maximum number of characters in term names"
msgstr "Maximale Anzahl an Zeichen in Begriffsnamen"

msgid "Minimum depth for new terms in the vocabulary hierarchy"
msgstr "Mindesttiefe für neue Begriffe in der Vokabularhierarchie"

msgid "Enter a value from 1 to 20."
msgstr "Geben Sie einen Wert von 1 bis 20 ein."

msgid "Maximum depth for new terms in the vocabulary hierarchy"
msgstr "Maximale Tiefe für neue Begriffe in der Vokabularhierarchie"

msgid "Delete existing terms in specified vocabularies before generating new terms."
msgstr "Löscht vorhandene Begriffe in vorhandenen Vokabularen, bevor neue Begriffe erstellt werden."

msgid "In vocabulary @vlabel: @termlist"
msgstr "Im Vokabular-@vlabel: @termlist"

msgid "In vocabulary @vlabel: No terms created"
msgstr "Im Vokabular-@vlabel: keine Begriffe erstellt"

msgid "Minimum depth changed from @min_depth to 1 because all terms were deleted"
msgstr "Mindesttiefe wurde von @min_depth in 1 geändert, da alle Begriffe gelöscht wurden"

msgid "Please provide a vocabulary machine name (--bundles)."
msgstr "Geben Sie einen Namen für Vokabularmaschine ein (--bundles)."

msgid "Invalid vocabulary machine name: @name"
msgstr "Ungültiger Name für die Vokabularmaschine: @name"

msgid "Invalid number of terms: @num"
msgstr "Ungültige Anzahl an Begriffen: @num"

msgid "The depth values must be in the range 1 to 20 and min-depth cannot be larger than max-depth (values given: min-depth @min, max-depth @max)"
msgstr "Die Tiefenwerte müssen im Bereich von 1 bis 20 liegen und die Mindesttiefe darf die maximale Tiefe nicht übersteigen (angegebene Werte: min-depth @min, max-depth @max)"

msgid "Created 1 new term"
msgid_plural "Created @count new terms"
msgstr[0] "1 neuer Begriff erstellt"
msgstr[1] "@count neue Begriffe erstellt"

msgid "1 new term at level @level (@terms)"
msgid_plural "@count new terms at level @level (@terms)"
msgstr[0] "1 neuer Begriff auf Ebene @level (@terms)"
msgstr[1] "@count neue Begriffe auf Ebene @level (@terms)"

msgid "Created 1 term translation"
msgid_plural "Created @count term translations"
msgstr[0] "1 Begriffsübersetzung erstellt"
msgstr[1] "@count Begriffsübersetzungen erstellt"

msgid "Deleted 1 existing term"
msgid_plural "Deleted @count existing terms"
msgstr[0] "1 vorhandener Begriff gelöscht"
msgstr[1] "@count vorhandene Begriffe gelöscht"

msgid "terms"
msgstr "Bedingungen"

msgid "Generate a given number of terms. Optionally delete current terms."
msgstr "Erstellt eine bestimmte Anzahl an Begriffen. Löscht optional aktuelle Begriffe."

msgid "How many users would you like to generate?"
msgstr "Wie viele Benutzer sollen erstellt werden?"

msgid "Delete all users (except user id 1) before generating new users."
msgstr "Alle Benutzer außer Benutzer-ID 1 löschen, bevor neue Benutzer erstellt werden."

msgid "Which roles should the users receive?"
msgstr "Welche Rollen sollen die Benutzer erhalten?"

msgid "Users always receive the <em>authenticated user</em> role."
msgstr "Benutzer erhalten immer die Rolle <em>authentifizierter Benutzer</em>."

msgid "Password to be set"
msgstr "Festzulegendes Kennwort"

msgid "Leave this field empty if you do not need to set a password"
msgstr "Lassen Sie dieses Feld leer, wenn Sie kein Kennwort festlegen müssen"

msgid "How old should user accounts be?"
msgstr "Wie alt dürfen Benutzeraccounts sein?"

msgid "User ages will be distributed randomly from the current time, back to the selected time."
msgstr "Das Alter der Benutzer wird willkürlich vom aktuellen Zeitpunkt aus bis zurück zum ausgewählten Zeitpunkt verteilt."

msgid "@num_users created."
msgstr "@num_users erstellt."

msgid "1 user deleted"
msgid_plural "@count users deleted."
msgstr[0] "1 Benutzer gelöscht."
msgstr[1] "@count Benutzer gelöscht."

msgid "1 user"
msgid_plural "@count users"
msgstr[0] "1 Benutzer"
msgstr[1] "@count Benutzer"

msgid "users"
msgstr "Benutzer"

msgid "Generate a given number of users. Optionally delete current users."
msgstr "Erstellt eine bestimmte Anzahl an Benutzern. Löscht optional aktuelle Benutzer."

msgid "Number of vocabularies?"
msgstr "Anzahl der Vokabulare?"

msgid "Maximum number of characters in vocabulary names"
msgstr "Maximale Anzahl an Zeichen in Vokabularnamen"

msgid "Delete existing vocabularies before generating new ones."
msgstr "Vorhandene Vokabulare löschen, bevor neue erstellt werden."

msgid "Deleted existing vocabularies."
msgstr "Vorhandene Vokabulare gelöscht."

msgid "Created the following new vocabularies: @vocs"
msgstr "Folgende neue Vokabulare erstellt: @vocs"

msgid "Invalid number of vocabularies: @num."
msgstr "Ungültige Anzahl an Vokabularen: @num."

msgid "vocabularies"
msgstr "Vokabulare"

msgid "Generate a given number of vocabularies. Optionally delete current vocabularies."
msgstr "Erstellt eine bestimmte Anzahl an Vokabularen. Löscht optional aktuelle Vokabulare."

