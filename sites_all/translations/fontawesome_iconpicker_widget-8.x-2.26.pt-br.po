msgid "Font Awesome IconPicker"
msgstr "Font Awesome IconPicker"

msgid "The fontIconPicker library is installed."
msgstr "A biblioteca fontIconPicker está instalada."

msgid "Not installed"
msgstr "Não instalado"

msgid "The fontIconPicker library could not be found. To use the Font Awesome Iconpicker, please verify that the fontIconPicker library is installed correctly. Please see the Font Awesome Iconpicker submodule README file for more details."
msgstr "A biblioteca fontIconPicker não pôde ser localizada. Para usar o Font Awesome Iconpicker, verifique se a biblioteca fontIconPicker está instalada corretamente. Consulte o arquivo leia-me do submódulo Font Awesome Iconpicker para obter mais detalhes."

msgid "Font Awesome Iconpicker Widget"
msgstr "Widget Font Awesome Iconpicker"

msgid "Provides an iconpicker widget for Font Awesome"
msgstr "Fornece um widget iconpicker para o Font Awesome"

msgid "IconPicker already present at @path. No download required."
msgstr "IconPicker já presente em @path. Nenhum download necessário."

msgid "Drush was unable to download the fontIconPicker library from @remote."
msgstr "O Drush não pôde fazer download da biblioteca fontIconPicker por meio de @remote."

msgid "Error: unable to download fontIconPicker library from @remote"
msgstr "Erro: não é possível fazer download da biblioteca fontIconPicker por meio de @remote"

msgid "fontIconPicker library has been successfully downloaded to @path."
msgstr "A biblioteca fontIconPicker foi transferida por download com êxito para @path."

msgid "Drush was unable to load the fontIconPicker) library"
msgstr "O Drush não pôde carregar a biblioteca fontIconPicker"

msgid "Icon Name"
msgstr "Nome do ícone"

msgid "Invalid icon"
msgstr "Ícone inválido"

