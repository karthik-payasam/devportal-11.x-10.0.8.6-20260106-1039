msgid "About"
msgstr "Информация"

msgid "DropzoneJS"
msgstr "DropzoneJS"

msgid "or"
msgstr "или"

msgid "Dropzone library missing"
msgstr "Отсутствует библиотека Dropzone"

msgid ""
"Dropzonejs requires the dropzone.min.js library.\n"
"        Download it (https://github.com/enyo/dropzone) and place it in the\n"
"        libraries folder (/libraries)"
msgstr ""
"Для Dropzonejs требуется библиотека dropzone.min.js.\n"
"        Загрузите ее (https://github.com/enyo/dropzone) и поместите в\n"
"        папку библиотек (/libraries)"

msgid "dropzonejs"
msgstr "dropzonejs"

msgid "The Drupal integration for DropzoneJS."
msgstr "Интеграция Drupal для DropzoneJS."

msgid "Media"
msgstr "Мультимедиа"

msgid "Dropzone upload files"
msgstr "Файлы передачи Dropzone"

msgid "Allow uploading of files via dropzonejs."
msgstr "Разрешить передачу файлов через dropzonejs."

msgid "DropzoneJS settings"
msgstr "Параметры DropzoneJS"

msgid "Upload scheme"
msgstr "Схема передачи"

msgid "Transliterate names of uploaded files"
msgstr "Перекодировать имена переданных файлов"

msgid "Upload timeout"
msgstr "Тайм-аут передачи"

msgid "Drop files here to upload"
msgstr "Перенесите сюда файлы для их передачи"

msgid "Your browser does not support drag'n'drop file uploads."
msgstr "Ваш браузер не поддерживает передачу файлов путем их переноса мышью."

msgid "Please use the fallback form below to upload your files like in the olden days."
msgstr "Используйте приведенную ниже форму для передачи файлов традиционным способом."

msgid "File is too big ({{filesize}}MiB). Max filesize: {{maxFilesize}}MiB."
msgstr "Слишком большой файл ({{filesize}} МиБ). Размер файла не должен превышать {{maxFilesize}} МиБ."

msgid "You can't upload files of this type."
msgstr "Нельзя передавать файлы этого типа."

msgid "Server responded with {{statusCode}} code."
msgstr "Сервер вернул код {{statusCode}}."

msgid "Cancel upload"
msgstr "Отменить передачу"

msgid "Are you sure you want to cancel this upload?"
msgstr "Вы действительно хотите отменить эту операцию передачи?"

msgid "Remove file"
msgstr "Удалить файл"

msgid "You can not upload any more files."
msgstr "Больше нельзя передать ни один файл."

msgid "TB"
msgstr "ТБ"

msgid "GB"
msgstr "ГБ"

msgid "MB"
msgstr "МБ"

msgid "KB"
msgstr "КБ"

msgid "b"
msgstr "b"

msgid "DropzoneJS entity browser widget"
msgstr "Виджет браузера сущностей DropzoneJS"

msgid "DropzoneJS Entity browser widget."
msgstr "Виджет браузера сущностей DropzoneJS."

msgid "DropzoneJS widget configuration"
msgstr "Конфигурация виджета DropzoneJS"

msgid "Submit button text"
msgstr "Текст кнопки отправки"

msgid "Automatically submit selection"
msgstr "Автоматически отправлять выбранное"

msgid "Upload location"
msgstr "Расположение для передачи"

msgid "Dropzone drag-n-drop zone text"
msgstr "Текст области размещения Dropzone"

msgid "Maximum size of files"
msgstr "Максимальный размер файлов"

msgid "Allowed file extensions"
msgstr "Допустимые расширения файлов"

msgid "Use clientside resize"
msgstr "Использовать изменение размера на стороне клиента"

msgid "Maximum width"
msgstr "Максимальная ширина"

msgid "Maximum height"
msgstr "Максимальная высота"

msgid "Resize quality"
msgstr "Качество изменения размера"

msgid "Method used for resizing"
msgstr "Метод, используемый для изменения размера"

msgid "Method used for generating the thumbnail"
msgstr "Метод, используемый для создания уменьшенной копии"

msgid "Media Entity DropzoneJS widget configuration"
msgstr "Конфигурация виджета медиасущности DropzoneJS"

msgid "Media type"
msgstr "Тип медиа"

msgid "Media Entity DropzoneJS with edit widget configuration"
msgstr "Медиасущность DropzoneJS с конфигурацией виджета редактирования"

msgid "Form mode"
msgstr "Режим формы"

msgid "Drop files here to upload them"
msgstr "Перетащите файлы сюда, чтобы загрузить их"

msgid "File upload"
msgstr "Закачать файл"

msgid "Files could not be uploaded because the destination directory %destination is not configured correctly."
msgstr "Не удалось передать файлы, так как неправильно настроен целевой каталог %destination."

msgid "Some files that you are trying to upload did not pass validation. Requirements are: max file %size, allowed extensions are %extensions"
msgstr "Некоторые из передаваемых файлов не прошли проверку. Требования: максимальный размер файла - %size, допустимые расширения - %extensions"

msgid "At least one valid file should be uploaded."
msgstr "Должен быть передан хотя бы один допустимый файл."

msgid "A space separated list of file extensions"
msgstr "Список расширений файлов через пробел"

msgid "Use client side resizing"
msgstr "Использовать изменение размера на стороне клиента"

msgid "Requires droopzone version v4.4.0 or higher and the <a href=\"@exif\" target=\"_blank\">exif</a> library."
msgstr "Требуется droopzone версии не ниже 4.4.0 и библиотека <a href=\"@exif\" target=\"_blank\">exif</a>."

msgid "Max width"
msgstr "Максимальная ширина"

msgid "Max height"
msgstr "Максимальная высота"

msgid "Resize method"
msgstr "Метод изменения размера"

msgid "Contain (scale)"
msgstr "Вместить (масштабировать)"

msgid "Crop"
msgstr "Обрезка"

msgid "Thumbnail method"
msgstr "Метод создания уменьшенной копии"

msgid "Invalid extension list format."
msgstr "Недопустимый формат списка расширений."

msgid "Adds DropzoneJS upload integration."
msgstr "Добавляет интеграцию передачи в DropzoneJS."

msgid "Missing requirement: in order to use this widget you have to install Inline entity form module first"
msgstr "Отсутствует требование: для использования этого виджета сначала необходимо установить модуль форм встроенных сущностей"

msgid "Edit"
msgstr "Редактировать"

msgid "Media Entity DropzoneJS with edit"
msgstr "Медиасущность DropzoneJS с редактированием"

msgid "Adds DropzoneJS upload integration that saves Media entities and allows to edit them."
msgstr "Добавляет интеграцию передачи на сервер DropzoneJS, которая сохраняет медиасущности и позволяет изменять их."

msgid "The type of media entity to create from the uploaded file(s)."
msgstr "Тип медиасущности, создаваемой из переданных файлов."

msgid "You must @create_media_type before using this widget."
msgstr "Перед тем как использовать этот виджет, необходимо @create_media_type."

msgid "create a media type"
msgstr "создать тип медиаобъекта"

msgid "Media Entity DropzoneJS"
msgstr "Медиасущность DropzoneJS "

msgid "Adds DropzoneJS upload integration that saves Media entities."
msgstr "Добавляет интеграцию передачи на сервер DropzoneJS, которая сохраняет медиасущности."

msgid "For security reasons, your upload has been renamed to %filename."
msgstr "Ваш файл был переименован в %filename из соображений безопасности."

msgid "The specified file %name could not be uploaded."
msgstr "Указанный файл %name не может быть загружен."

msgid "The file could not be uploaded because the destination %destination is invalid."
msgstr "Невозможно загрузить файл так как путь сохранения %destination некорректный."

msgid "File upload error. Could not move uploaded file."
msgstr "Ошибка закачки файла. Невозможно переместить закачанный файл."

msgid "Upload error. Could not move uploaded file %file to destination %destination."
msgstr "Ошибка закачки. Невозможно переместить загруженный файл %file в место назначения %destination."

msgid "The file could not be saved because it exceeds the maximum allowed size for uploads."
msgstr "Файл не удалось сохранить, так как его размер превышает максимально допустимый для передачи."

msgid "The file could not be saved because the upload did not complete."
msgstr "Файл не удалось сохранить, так как передача не выполнена."

msgid "The file could not be saved. An unknown error has occurred."
msgstr "Файл не удалось сохранить. Возникла непредвиденная ошибка."

msgid "There was a problem while processing the file named @name"
msgstr "Возникла неполадка при обработке файла с именем @name"

msgid "You don't have sufficent permissions to use the DropzoneJS uploader. Contact your system administrator"
msgstr "Недостаточно прав доступа для использования функции передачи DropzoneJS. Обратитесь за помощью к системному администратору."

msgid "A maximum of @count files can be uploaded."
msgstr "Максимум @count файлов могут быть загружены."

