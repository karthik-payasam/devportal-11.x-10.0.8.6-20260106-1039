msgid "Back To Top"
msgstr "回到頂端"

msgid "Back To Top adds a button that hovers in the bottom of your screen and allow users to smoothly scroll up the page using jQuery."
msgstr "「回到頂端」會新增一個在畫面底端浮動的按鈕，可讓使用者利用 jQuery 平滑地向上捲動頁面。"

msgid "User interface"
msgstr "使用者介面"

msgid "Back to Top"
msgstr "回到頂端"

msgid "Administer Back To Top settings."
msgstr "管理「回到頂端」設定。"

msgid "Back to top settings"
msgstr "「回到頂端」設定"

msgid "Access Back to top settings"
msgstr "存取「回到頂端」設定"

msgid "Prevent on mobile and touch devices"
msgstr "阻止出現在行動式裝置和觸控裝置上"

msgid "Prevent on administration pages and node edit"
msgstr "阻止出現在管理頁面和節點編輯頁面上"

msgid "Prevent on front page"
msgstr "阻止出現在首頁上"

msgid "Trigger"
msgstr "觸發器"

msgid "Placement"
msgstr "放置位置"

msgid "Button text"
msgstr "按鈕文字"

msgid "Button type"
msgstr "按鈕類型"

msgid "Background color"
msgstr "背景色彩"

msgid "Border color"
msgstr "邊框顏色"

msgid "Hover color"
msgstr "浮動說明顏色"

msgid "Text color"
msgstr "文字顏色"

msgid "Back to top"
msgstr "回到頂端"

msgid "Don´t show Back To Top-button on screen width up to 760px."
msgstr "請勿在螢幕寬度上顯示「回到頂端」按鈕，直到 760px。"

msgid "Do you want to prevent Back To Top on admin pages?"
msgstr "是否要阻止「回到頂端」出現在管理頁面上？"

msgid "Do you want to prevent Back To Top on front page?"
msgstr "是否要阻止「回到頂端」出現在首頁上？"

msgid "Set the number of pixel which trigger the Back To Top button default 100"
msgstr "設定用於觸發「回到頂端」按鈕的像素數目，預設值為 100"

msgid "Where should the Back To Top button appear?"
msgstr "「回到頂端」按鈕應出現的位置。"

msgid "Bottom right"
msgstr "右下"

msgid "Bottom left"
msgstr "左下"

msgid "Bottom center"
msgstr "底端中央"

msgid "Top right"
msgstr "右上"

msgid "Top left"
msgstr "左上"

msgid "Top center"
msgstr "頂端中央"

msgid "Mid right"
msgstr "中間偏右"

msgid "Mid left"
msgstr "中間偏左"

msgid "Mid center"
msgstr "正中央"

msgid "Set the text of the Back To Top button"
msgstr "設定「回到頂端」按鈕的文字"

msgid "Do you want Back To Top to use a PNG-24 image or a Text/Css button?"
msgstr "您希望「回到頂端」使用 PNG-24 影像或 Text/Css 按鈕？"

msgid "Image (default)"
msgstr "影像（預設值）"

msgid "Text/Css"
msgstr "Text/Css"

msgid "Text/Css button settings"
msgstr "Text/Css 按鈕設定"

msgid "Button background color default #F7F7F7"
msgstr "按鈕背景顏色，預設值為 #F7F7F7"

msgid "Border color default #CCCCCC"
msgstr "邊框顏色，預設值為 #CCCCCC"

msgid "Hover color default #EEEEEE"
msgstr "浮動說明顏色，預設值為 #EEEEEE"

msgid "Text color default #333333"
msgstr "文字顏色，預設值為 #333333"

