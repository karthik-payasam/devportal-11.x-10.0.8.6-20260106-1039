msgid "Allowlist skipping ban: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Divieto di ignorare l'elenco degli elementi consentiti: %ip per %type in errore in %form <br />Origine: %source <br /> Agent utente: %browser"

msgid "Banned: %ip for failing %type on %form <br />Source: %source <br /> User Agent: %browser"
msgstr "Bloccato: %ip per %type errato in %form <br />Origine: %source <br /> Agent utente: %browser"

msgid "Drupal Perimeter Defence"
msgstr "Drupal Perimeter Defence"

msgid "Immediately ban hackers when they try to scan the site."
msgstr "Blocca immediatamente gli hacker che provano ad eseguire la scansione del sito."

msgid "Perimeter defence settings"
msgstr "Impostazioni di difesa del perimetro"

msgid "Configure the settings for Drupal Perimeter Defence."
msgstr "Configurare le impostazioni per la Difesa del Perimetro Drupal."

msgid "Bypass Perimeter Defence ban rules"
msgstr "Ignora regole di divieto di Perimeter Defence"

msgid "Allow users to bypass the rules defined by Perimeter Defence module."
msgstr "Consente agli utenti di ignorare le regole definite dal modulo Perimeter Defence."

msgid "Perimeter settings"
msgstr "Impostazioni del perimetro"

msgid "Perimeter Settings"
msgstr "Impostazioni del perimetro"

msgid "A list of regex patterns"
msgstr "Un elenco di pattern regex"

msgid "A regex pattern"
msgstr "Un pattern regex"

msgid "Banned: %ip for requesting %pattern <br />Source: %source <br /> User Agent: %browser"
msgstr "Vietato: %ip per la richiesta di %pattern <br />Origine: %source <br /> Agent utente: %browser"

msgid "Perimeter will ban any user that generates \"404 - File not found\" for requesting any of the following url pattern"
msgstr "Il perimetro bloccherà qualsiasi utente che generi un errore \"404 - File non trovato\" durante la richiesta di uno qualsiasi dei seguenti url"

msgid "Ban URL patterns"
msgstr "Blocca pattern URL "

msgid "A list of regex patterns, each pattern on a separate line"
msgstr "Un elenco di pattern regex, ciascun pattern su una riga separata"

